  "steps": [
    {
      "section": "Kylling",
      "text": "Læg kyllingebryst, fond, gulerod, løg, laurbærblade og et nip salt og peber i en gryde. Lad det simre i 15 minutter."
    },
    {
      "section": "Kylling",
      "text": "Hæld 3 dl af kogevandet fra til saucen. Tag kyllingen op og skær den i tern."
    },
    {
      "section": "Sauce",
      "text": "Smelt smørret i en anden gryde. Pisk melet ud i smørret, så det bliver til en jævn bolle."
    },
    {
      "section": "Sauce",
      "text": "Tilsæt mælken lidt ad gangen, og pisk hele tiden, til saucen er glat."
    },
    {
      "section": "Sauce",
      "text": "Bring saucen i kog, og lad den koge i 1-2 minutter under omrøring. Smag til med salt og peber. Tynd den ud med kogevandet, til den har den konsistens, du vil have."
    },
    {
      "section": "Sauce",
      "text": "Lad aspargesene dryppe af, og vend dem sammen med kyllingen ned i saucen."
    },
    {
      "section": "Servering",
      "text": "Varm tarteletterne i ovnen, som det står på pakken."
    },
    {
      "section": "Servering",
      "text": "Fyld skallerne med den varme fyldning. Top med hakket persille, friskkværnet peber og et lille drys flagesalt."
    }
  ],
