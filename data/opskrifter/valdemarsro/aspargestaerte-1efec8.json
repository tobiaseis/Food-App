  "steps": [
    {
      "section": "Tærtedej",
      "text": "Bland begge slags mel med saltet, og smuldr smørret i, til det ligner grove krummer. Du kan også blende det i en foodprocessor."
    },
    {
      "section": "Tærtedej",
      "text": "Ælt dejen sammen med vandet, og lad den evt. hvile på køl i 30 minutter."
    },
    {
      "section": "Tærtedej",
      "text": "Tryk dejen ud i en smurt tærteform på 24 cm i diameter, og prik bunden med en gaffel."
    },
    {
      "section": "Tærtedej",
      "text": "Forbag bunden i 10 minutter ved 175 °C varmluft. Forvarm ovnen først."
    },
    {
      "section": "Fyld",
      "text": "Pisk æg, mælk, creme fraiche, begge sennepper, salt og peber sammen."
    },
    {
      "section": "Fyld",
      "text": "Knæk den seje, nederste ende af aspargesene af, og smid den ud."
    },
    {
      "section": "Fyld",
      "text": "Læg aspargesene i den forbagte tærtebund, og hæld æggeblandingen over. Fordel osten ovenpå."
    },
    {
      "section": "Fyld",
      "text": "Bag tærten i ca. 35 minutter ved 175 °C varmluft, til fyldet er stivnet."
    }
  ],
