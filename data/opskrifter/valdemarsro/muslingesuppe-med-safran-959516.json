  "steps": [
    {
      "section": "Persilleolie",
      "text": "Blend olie og persille, til olien er helt grøn og jævn. Stil den til side."
    },
    {
      "section": "Suppe",
      "text": "Skrub muslingerne under lidt koldt rindende vand, og lad dem ikke ligge i vand. Smid dem ud, hvis skallen er itu, eller hvis de er åbne og ikke lukker sig, når du banker dem let mod bordet."
    },
    {
      "section": "Suppe",
      "text": "Svits løg og hvidløg i olivenolie i en stor gryde, til løgene er bløde."
    },
    {
      "section": "Suppe",
      "text": "Kom muslinger, bouillon og hvidvin i gryden, og sæt låg på. Kog ved middelvarme i 5-8 minutter, til muslingerne er åbnet."
    },
    {
      "section": "Suppe",
      "text": "Si kogevandet fra over i en ren gryde. Læg muslingerne i en skål med låg, så de holder varmen."
    },
    {
      "section": "Suppe",
      "text": "Rør fennikel, gulerødder, fløde og safran i kogevandet, og lad det småkoge kort. Smag til med salt og peber."
    },
    {
      "section": "Suppe",
      "text": "Pil de fleste muslinger ud af skallerne. Gem nogle få med skal, så hver portion får 3 muslinger i skal."
    },
    {
      "section": "Suppe",
      "text": "Kom de pillede muslinger i suppen, og øs den op i dybe skåle. Top med muslinger i skal, persille, fennikeltop og et par dråber persilleolie."
    },
    {
      "section": "Til servering",
      "text": "Server med brød og smør. Kasser alle muslinger, der ikke har åbnet sig under kogningen."
    }
  ],
  "changes": []
