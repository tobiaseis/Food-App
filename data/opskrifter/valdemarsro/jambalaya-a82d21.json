  "steps": [
    {
      "section": null,
      "text": "Hæt olien i en gryde, og brun kylling og chorizo på alle sider."
    },
    {
      "section": null,
      "text": "Skru lidt ned for varmen. Rør løg, hvidløg, chiliflager, nellike og paprika i gryden, og lad løgene blive bløde."
    },
    {
      "section": null,
      "text": "Tilsæt timian, oregano, peberfrugt, bladselleri, tomatpuré, hakkede tomater og de rå ris. Steg det i et par minutter under omrøring."
    },
    {
      "section": null,
      "text": "Hæld fonden over, og bring det i kog. Læg låg på, og lad retten simre i 15 minutter."
    },
    {
      "section": null,
      "text": "Tag gryden af varmen, og lad den stå med låg på i 15 minutter, eller til risene er møre."
    },
    {
      "section": null,
      "text": "Vend rejerne i sammen med limesaft og limeskal. Smag til med salt, peber og tabasco."
    },
    {
      "section": null,
      "text": "Drys med persille og forårsløg. Server med limebåde og ekstra tabasco på bordet."
    }
  ],
