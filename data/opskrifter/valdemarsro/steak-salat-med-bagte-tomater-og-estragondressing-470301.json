  "steps": [
    {
      "section": "Bagte tomater",
      "text": "Varm ovnen op til 200 °C varmluft. Læg tomathalvdelene på en bageplade med snitfladen opad, og dryp med olivenolie. Krydr med salt og peber."
    },
    {
      "section": "Bagte tomater",
      "text": "Bag tomaterne i 25 minutter. Lad dem derefter hvile på bagepladen, til de kun er lune."
    },
    {
      "section": "Estragondressing",
      "text": "Bland estragon, løgpulver, sennep, citronskal, creme fraiche og mayonnaise i en skål. Smag til med salt, peber og lidt citronsaft."
    },
    {
      "section": "Estragondressing",
      "text": "Stil dressingen til side, så den kan trække, mens du laver resten."
    },
    {
      "section": "Steaks",
      "text": "Smelt smørret på en varm pande, til det holder op med at bruse. Krydr flanksteaken med salt og peber, og steg den 2-3 minutter på hver side."
    },
    {
      "section": "Steaks",
      "text": "Lad kødet hvile på et skærebræt i 5 minutter, og skær det så i skiver."
    },
    {
      "section": "Servering",
      "text": "Fordel krølsalat og rucola på tallerkenerne, og dryp med lidt dressing. Læg bagte tomater, agurk, rødløg og avocado ovenpå."
    },
    {
      "section": "Servering",
      "text": "Læg kødskiverne på salaten. Drys med salt, peber og estragon, og top med lidt mere dressing. Server med det samme."
    }
  ],
