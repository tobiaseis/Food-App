  "steps": [
    {
      "section": null,
      "text": "Bring letsaltet vand i kog i en gryde, og kog pastaen, som det står på pakken."
    },
    {
      "section": null,
      "text": "Varm smørret op på en pande ved høj varme, og brun kantarellerne til de får farve. Løft dem op af panden."
    },
    {
      "section": null,
      "text": "Hæld fløden på panden sammen med chorizoen, og lad det småkoge."
    },
    {
      "section": null,
      "text": "Vend pasta, kantareller og tomater i saucen på panden, så alt er varmt og dækket af fløde."
    },
    {
      "section": null,
      "text": "Server på tallerkener og drys med timian, peber og salt efter smag."
    }
