  "steps": [
    {
      "section": null,
      "text": "Læg kyllingen i en stor gryde sammen med bouillon, løg, gulerødder, kanel, nelliker, ingefær, hvidløg, riseddike og fiskesauce."
    },
    {
      "section": null,
      "text": "Bring det i kog, sæt låg på, og lad det simre i 2 timer."
    },
    {
      "section": null,
      "text": "Hæld indholdet gennem en finmasket sigte over en skål, så bouillonen opsamles. Pluk alt kødet af kyllingen og gem det. Smid grøntsager, krydderier og skelet ud."
    },
    {
      "section": null,
      "text": "Kom bouillonen tilbage i gryden med det plukkede kød, og lad den simre i 8-10 minutter."
    },
    {
      "section": null,
      "text": "Læg nudlerne i, og smag suppen til med sukker, mere fiskesauce og peber."
    },
    {
      "section": null,
      "text": "Sæt forårsløg, chili, bønnespirer, mynte, koriander, basilikum og lime frem i separate fade."
    },
    {
      "section": null,
      "text": "Øs den varme suppe op i skåle. Lad enhver tage toppings efter smag og presse lime over til sidst."
    }
  ],
  "changes": [
