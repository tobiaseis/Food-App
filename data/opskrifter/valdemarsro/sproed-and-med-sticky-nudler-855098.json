  "steps": [
    {
      "section": "Sprød and",
      "text": "Skær skindet af andebrystene. Drys det med salt, og læg det med skindsiden nedad på en pande med lidt olie ved lav til middel varme. Lad det stege i ro, mens du laver resten."
    },
    {
      "section": "Sprød and",
      "text": "Bank andekødet let fladt, så det steger hurtigere og bliver saftigt, uden at paneringen brænder på. Vend det først i hvedemel, så i det sammenpiskede æg og til sidst i pankorasp."
    },
    {
      "section": "Sprød and",
      "text": "Varm olien op på en pande, og steg det panerede kød i cirka 5 minutter på hver side."
    },
    {
      "section": "Sprød and",
      "text": "Vend andeskindet, og steg det kort på den anden side, til det er sprødt. Hak det groft."
    },
    {
      "section": "Sticky nudler",
      "text": "Rør sojasauce, hvidløg, brun farin, ingefær, riseddike, five spice, majsstivelse og grøntsagsfond sammen i en skål til en marinade."
    },
    {
      "section": "Sticky nudler",
      "text": "Varm sesamolien på en stor pande, og svits grønkål og pak choi, til de falder sammen. Hæld saucen over, og lad den simre ved middel varme."
    },
    {
      "section": "Sticky nudler",
      "text": "Kog nudlerne efter pakkens anvisning, men tag dem gerne op et minut før tid. Si dem, og vend dem med kålen og saucen på panden."
    },
    {
      "section": "Servering",
      "text": "Fordel nudlerne i skåle. Skær andekødet i skiver, og læg dem ovenpå. Top med andeskind, sesamfrø og forårsløg."
    }
  ],
  "changes": [
