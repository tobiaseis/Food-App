  "steps": [
    {
      "section": "Svinekæber",
      "text": "Start ca. 4 timer før servering. Parer kæberne, og tør dem med køkkenrulle."
    },
    {
      "section": "Svinekæber",
      "text": "Bland hvedemel med salt og peber, og vend kødet rundt i blandingen."
    },
    {
      "section": "Svinekæber",
      "text": "Steg baconen sprød på en varm pande med lidt olie. Lad den dryppe af på køkkenrulle, og hak den groft."
    },
    {
      "section": "Svinekæber",
      "text": "Hæld olie i en stor gryde, og varm den op. Smelt smørret, til det holder op med at boble, og brun kæberne godt på alle sider."
    },
    {
      "section": "Svinekæber",
      "text": "Sænk varmen lidt, og sauter løg og gulerødder sammen med kødet, til løgene er blanke og bløde."
    },
    {
      "section": "Svinekæber",
      "text": "Kom bacon, rødvin, timian, laurbærblade og bouillon i gryden. Bring det forsigtigt i kog."
    },
    {
      "section": "Svinekæber",
      "text": "Skru ned på lav varme, sæt låg på, og lad det simre i 3-3½ time."
    },
    {
      "section": "Svinekæber",
      "text": "Ca. 1 time før servering: Varm en pande op på høj varme med olie, og smelt lidt af smørret. Brun champignonerne, til de har fået en gyldenbrun skorpe."
    },
    {
      "section": "Svinekæber",
      "text": "Smelt sukker og resten af smørret på en anden pande, og lad det karamellisere. Vend perleløgene i karamellen i 15-30 minutter, til de er gyldne og karamelliserede."
    },
    {
      "section": "Svinekæber",
      "text": "Rør champignon og perleløg ud i gryden, og smag til med salt og peber. Anret med kartoffelmos og drys med persille."
    },
    {
      "section": "Kartoffelmos",
      "text": "Kog kartoflerne møre i usaltet vand. Varm mælken i en kasserolle til ca. 50 grader."
    },
    {
      "section": "Kartoffelmos",
      "text": "Mos de varme kartofler groft med smørret. Pisk dem derefter med håndmixer, og hæld den varme mælk i lidt ad gangen, til moset er cremet, luftigt og blødt."
    },
    {
      "section": "Kartoffelmos",
      "text": "Smag til med salt, peber og friskrevet muskatnød."
    }
  ],
