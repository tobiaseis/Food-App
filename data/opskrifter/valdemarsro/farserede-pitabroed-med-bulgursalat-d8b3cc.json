  "steps": [
    {
      "section": "Bulgursalat med citrondressing",
      "text": "Kog bulguren efter pakkens anvisning, og lad den køle lidt af."
    },
    {
      "section": "Bulgursalat med citrondressing",
      "text": "Pisk citronskal, citronsaft, olie, sukker og hvidløg sammen til en dressing. Smag til med salt og peber."
    },
    {
      "section": "Bulgursalat med citrondressing",
      "text": "Bland bulgur, tomater, agurk, rødløg, forårsløg og mynte i en skål, og vend dressingen i. Lad gerne salaten stå en halv times tid, så den får mere smag."
    },
    {
      "section": "Farserede pitabrød",
      "text": "Ælt kødet sammen med løg, hvidløg, persille og krydderier, og krydr med salt og peber."
    },
    {
      "section": "Farserede pitabrød",
      "text": "Del pitabrødene på midten, og put farsen i halvdelene. Pres dem flade, så farsen ligger i et tyndt, jævnt lag."
    },
    {
      "section": "Farserede pitabrød",
      "text": "Pensl pitabrødene med olie. Varm en pande op ved middelvarme, og steg brødene 4-5 minutter på hver side."
    },
    {
      "section": "Yoghurtdressing med lime",
      "text": "Rør yoghurt, limeskal, limesaft og koriander sammen, og smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Server de varme pitabrød med bulgursalat og yoghurtdressing."
    }
  ],
