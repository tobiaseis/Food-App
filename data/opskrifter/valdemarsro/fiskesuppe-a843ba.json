  "steps": [
    {
      "section": "Til fiskefonden",
      "text": "Læg alle fondens ingredienser i en stor gryde, og bring det i kog."
    },
    {
      "section": "Til fiskefonden",
      "text": "Fjern skummet med en ske, så snart det samler sig på overfladen. Ellers bliver fonden uklar."
    },
    {
      "section": "Til fiskefonden",
      "text": "Lad fonden simre i 20 minutter, og skum løbende af. Si den derefter gennem en finmasket si, og kassér fisk og grøntsager."
    },
    {
      "section": "Til fiskefonden",
      "text": "Fonden kan laves på forhånd. Den holder sig 2 dage i køleskabet eller 2 måneder i fryseren."
    },
    {
      "section": "Til suppen",
      "text": "Svits løg og hvidløg i lidt olie i en gryde ved middelvarme, til de er bløde."
    },
    {
      "section": "Til suppen",
      "text": "Hæld fiskefond og hvidvin i gryden, og varm det op, til det småkoger."
    },
    {
      "section": "Til suppen",
      "text": "Rør fløde, gulerod, squash, porre og peberfrugt i. Kom fisketerningerne i, og lad suppen simre i 2 minutter."
    },
    {
      "section": "Til suppen",
      "text": "Rør smørret i. Smag suppen til med citronsaft, citronskal, salt, peber og dild, og tilsæt evt. lidt mere fløde. Pynt med resten af dilden."
    }
  ],
