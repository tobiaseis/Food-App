  "steps": [
    {
      "section": null,
      "text": "Varm olie og smør op i en gryde. Svits løget i 5-7 minutter, til det er blødt."
    },
    {
      "section": null,
      "text": "Rør gulerod, squash, hvidløg, timian og rosmarin i gryden, og steg det hele under omrøring i cirka 1 minut."
    },
    {
      "section": null,
      "text": "Hæld hakkede tomater, soltørrede tomater, fond, linser, fløde og rødvin i, og rør rundt. Læg låg på, og lad sovsen simre på middel-lav varme i 30 minutter."
    },
    {
      "section": null,
      "text": "Krydr med salt og peber. Lad sovsen simre videre i 15-20 minutter, og smag til igen."
    },
    {
      "section": null,
      "text": "Kog pasta efter anvisningen på pakken. Anret med sovsen, og top med parmesan og basilikum."
    }
