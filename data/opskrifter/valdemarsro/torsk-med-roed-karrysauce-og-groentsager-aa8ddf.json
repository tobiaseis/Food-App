  "steps": [
    {
      "section": "Grøntsager",
      "text": "Forvarm ovnen til 200 °C varmluft og smør et ovnfast fad."
    },
    {
      "section": "Grøntsager",
      "text": "Rør karrypasta, ingefær og sojasauce ud i kokosmælken, så saucen er helt glat."
    },
    {
      "section": "Grøntsager",
      "text": "Læg gulerødder, squash og spidskål i fadet, hæld saucen over og vend det rundt. Bag i ca. 20 minutter."
    },
    {
      "section": "Fisk",
      "text": "Tør torskefileterne med køkkenrulle. Bland pankorasp og sesamfrø med salt og peber, og kryd fisken med blandingen."
    },
    {
      "section": "Fisk",
      "text": "Læg fisken oven på de forbagte grøntsager, og bag videre i 10-12 minutter, til torsken er netop gennemstegt."
    },
    {
      "section": "Ris og servering",
      "text": "Kog imens risene, som der står på pakken."
    },
    {
      "section": "Ris og servering",
      "text": "Server torsk og grøntsager i dybe tallerkener med ris. Top med koriander, sesamfrø, chiliflager og cashewnødder."
    }
  ],
