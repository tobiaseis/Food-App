  "steps": [
    {
      "section": null,
      "text": "Kog pastaen, som det står på pakken. Når den er næsten færdig, kommer du edamamebønnerne direkte fra frost i samme gryde."
    },
    {
      "section": null,
      "text": "Si pasta og bønner fra, når pastaen er al dente, og lad dem dryppe godt af."
    },
    {
      "section": null,
      "text": "Steg baconen sprød på en pande med lidt olie. Tag den op på køkkenrulle."
    },
    {
      "section": null,
      "text": "Brun kyllingen på alle sider i baconfedtet ved middelhøj varme. Krydr med salt og peber, og steg den videre i 6-8 minutter på hver side, til den er helt gennemstegt."
    },
    {
      "section": null,
      "text": "Skær kylling og bacon i tern, og bland dem med den afdryppede pasta og edamamebønnerne."
    },
    {
      "section": "Til dressingen",
      "text": "Rør alle ingredienserne til dressingen sammen i en skål. Smag til med mere salt, sukker eller karry, hvis det trænger."
    },
    {
      "section": "Servering",
      "text": "Vend avocado, spidskål, broccoli og rødløg i pastaen sammen med dressingen, og server."
    }
  ],
