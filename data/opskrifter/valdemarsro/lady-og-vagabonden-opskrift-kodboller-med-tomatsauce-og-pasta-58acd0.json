  "steps": [
    {
      "section": "Tomatsauce",
      "text": "Kom tomater, hvidløg, oregano, salt og peber i en gryde. Lad det simre ved svag varme i 20-30 minutter, til saucen er tyk og cremet."
    },
    {
      "section": "Tomatsauce",
      "text": "Har du travlt, så kog saucen ved kraftigere varme under omrøring i 7-10 minutter."
    },
    {
      "section": "Kødboller",
      "text": "Ælt oksekød, persille, parmesan, hvidløg og æg godt sammen. Form blandingen til små kødboller."
    },
    {
      "section": "Kødboller",
      "text": "Bring bouillonen i kog i en anden gryde. Læg kødbollerne ned i og kog dem 1 minut, og løft dem derefter op."
    },
    {
      "section": "Kødboller",
      "text": "Vend kødbollerne i den varme tomatsauce, og lad dem simre med i 5 minutter."
    },
    {
      "section": "Til servering",
      "text": "Kog spaghettien efter anvisningen på posen. Server med kødboller og sauce, og top med mozzarella og parmesan."
    }
  ],
