  "steps": [
    {
      "section": "Burgerboller",
      "text": "Rør vand og gær sammen i en skål, og bland derefter mel og salt i. Rør dejen godt."
    },
    {
      "section": "Burgerboller",
      "text": "Dæk skålen med film, og lad dejen stå på køkkenbordet i 10-12 timer."
    },
    {
      "section": "Burgerboller",
      "text": "Form dejen til boller, og lad dem hæve i 1 time."
    },
    {
      "section": "Burgerboller",
      "text": "Pensl bollerne med mælk, og strø sesamfrø over. Bag dem i forvarmet ovn ved 230 °C varmluft i 15-18 minutter."
    },
    {
      "section": "Guacamole",
      "text": "Kør løg, hvidløg og avocado i en minihakker, til massen er cremet."
    },
    {
      "section": "Guacamole",
      "text": "Smag til med spidskommen, citronsaft og salt."
    },
    {
      "section": "Kartoffelbåde",
      "text": "Skær kartoflerne i både. Læg dem i en pose sammen med paprika, salt og olie, og ryst posen, så de er dækket godt."
    },
    {
      "section": "Kartoffelbåde",
      "text": "Bag kartoffelbådene i forvarmet ovn ved 220 °C varmluft i 25-35 minutter."
    },
    {
      "section": "Burgere",
      "text": "Drys bøfferne med salt og peber, og steg dem i smør og olie på en varm pande eller på grillen."
    },
    {
      "section": "Burgere",
      "text": "Læg cheddar på bøfferne, så den smelter let."
    },
    {
      "section": "Burgere",
      "text": "Del bollerne, og byg burgerne med bøf, jalapeños, salat, tomatskiver, guacamole, mayonnaise og salsa."
    }
  ],
  "changes": [
    "Ølandshvede er erstattet med hvedemel, så den samlede melmængde er 300 g."
  ]
