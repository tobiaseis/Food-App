  "steps": [
    {
      "section": "Suppe",
      "text": "Varm olivenolien op i en gryde, og rør kartofler og porre rundt i den i nogle minutter."
    },
    {
      "section": "Suppe",
      "text": "Hæld bouillon i, og kom vaniljen ved. Sæt låg på, og lad suppen simre i 20 minutter, til kartoflerne er helt bløde."
    },
    {
      "section": "Suppe",
      "text": "Blend suppen glat sammen med fløden, til den bliver let og cremet. Tynd den ud med lidt ekstra bouillon, hvis den er for tyk."
    },
    {
      "section": "Suppe",
      "text": "Krydr med salt og peber, og pres appelsinsaft i efter smag."
    },
    {
      "section": "Toppings",
      "text": "Brun rugbrødsternene og græskarkernerne i separate portioner smør på panden. Steg baconen sprød."
    },
    {
      "section": "Toppings",
      "text": "Øs suppen op i skåle, og top med rugbrød, græskarkerner, bacon og frisk timian. Drop baconen, hvis retten skal være vegetarisk."
    }
