  "steps": [
    {
      "section": "Syltede rødløg",
      "text": "Rør eddike og sukker sammen i en skål, til sukkeret er opløst."
    },
    {
      "section": "Syltede rødløg",
      "text": "Læg løgskiverne i væden, og lad dem stå i mindst 30 minutter."
    },
    {
      "section": "Biksemad",
      "text": "Svits det hakkede løg i olivenolie på en pande, til det er blødt."
    },
    {
      "section": "Biksemad",
      "text": "Kom kartoffeltern og halvdelen af smørret på panden. Steg dem, til de får en sprød skorpe, og vend dem ofte."
    },
    {
      "section": "Biksemad",
      "text": "Krydr med salt, peber og sojasauce, når kartoflerne er færdige."
    },
    {
      "section": "Biksemad",
      "text": "Brun oksekødet hurtigt af i resten af smørret på en anden pande, og krydr med salt og peber. Midten må gerne være rosa."
    },
    {
      "section": "Biksemad",
      "text": "Tag begge pander af varmen, og vend kødet i kartoflerne."
    },
    {
      "section": "Til servering",
      "text": "Steg æggene som spejlæg på en pande."
    },
    {
      "section": "Til servering",
      "text": "Fordel biksemaden på fire tallerkener, og læg et spejlæg på hver."
    },
    {
      "section": "Til servering",
      "text": "Top med bearnaise, syltede rødløg og syltede rødbeder."
    },
    {
      "section": "Til servering",
      "text": "Drys rigeligt med persille og lidt friskkværnet peber."
    }
  ],
  "changes": [
