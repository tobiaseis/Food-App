  "steps": [
    {
      "section": "Sprød kylling",
      "text": "Bank kyllingebrysterne flade. Så steges de hurtigere og bliver saftige, uden at panérningen brænder på."
    },
    {
      "section": "Sprød kylling",
      "text": "Pisk æggene i en dyb tallerken, og hæld panko i en anden. Bland hvedemel med paprika, salt og peber, og vend kyllingen i blandingen. Vend den derefter i æg og til sidst i panko."
    },
    {
      "section": "Sprød kylling",
      "text": "Varm olie op i en pande ved middelvarme. Steg kyllingen i ca. 6 minutter på hver side, til den er gylden og sprød. Kontrollér, at den er gennemstegt."
    },
    {
      "section": "Avocadomos",
      "text": "Mos avocadoen groft i en dyb tallerken. Smag til med citronsaft, citronskal, spidskommen, salt og peber."
    },
    {
      "section": "Saml burgerne",
      "text": "Varm burgerbollerne i ovnen eller i brødristeren, og smør dem med mayonnaise."
    },
    {
      "section": "Saml burgerne",
      "text": "Læg salat i bunden af hver bolle, og top med kylling, avocadomos og skiver af agurk. Læg låget på og server."
    }
  ],
