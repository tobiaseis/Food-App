  "steps": [
    {
      "section": "Pizzadej",
      "text": "Rør gæren ud i vandet i en skål. Tilsæt hvedemel, olivenolie og salt."
    },
    {
      "section": "Pizzadej",
      "text": "Ælt dejen i røremaskine i 10 minutter på middelhastighed, til den er glat, smidig og blød."
    },
    {
      "section": "Pizzadej",
      "text": "Kom dejen i en skål, der er smurt med olivenolie, og vend den, så den er dækket af olie."
    },
    {
      "section": "Pizzadej",
      "text": "Dæk skålen til, og lad dejen hæve på køkkenbordet i 30 minutter. Sæt den derefter i køleskabet i 10-24 timer."
    },
    {
      "section": "Fyld",
      "text": "Varm olien på en pande, og svits løg og hvidløg, til løget er blødt."
    },
    {
      "section": "Fyld",
      "text": "Skru op for varmen, og brun oksekødet godt, mens du rører hele tiden."
    },
    {
      "section": "Fyld",
      "text": "Tilsæt hakkede tomater, tomatpuré og oregano. Krydr med salt og peber, og lad det simre, til saucen er kogt lidt ind."
    },
    {
      "section": "Fyld",
      "text": "Stil fyldet i køleskabet, til det er helt koldt."
    },
    {
      "section": "Samling og bagning",
      "text": "Sæt bagestålet i ovnen, og varm den op til højeste temperatur en time før bagning."
    },
    {
      "section": "Samling og bagning",
      "text": "Drys køkkenbordet med mel. Del dejen i fire lige store stykker, og form hvert af dem til en rund plade på ca. 25 cm."
    },
    {
      "section": "Samling og bagning",
      "text": "Læg pladerne på bagepapir, to på hvert stykke. Fordel det kolde fyld, mozzarella og basilikum på den ene halvdel af hver plade."
    },
    {
      "section": "Samling og bagning",
      "text": "Fold den anden halvdel hen over fyldet, og pres og fold kanten hele vejen rundt, så calzonen lukker tæt."
    },
    {
      "section": "Samling og bagning",
      "text": "Skru ovnen ned på 210 °C varmluft. Skub bagepapiret med calzonerne ind på det varme stål, og bag dem i ca. 15 minutter, til de er sprøde og gyldne."
    }
  ],
  "changes": []
