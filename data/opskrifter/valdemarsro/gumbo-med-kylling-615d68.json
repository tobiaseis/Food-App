  "steps": [
    {
      "section": null,
      "text": "Del kyllingen i to og skær den i bryst, vinger og overlår. Gnid skindet med salt."
    },
    {
      "section": null,
      "text": "Varm olivenolien i en pande, og steg chorizoen i et par minutter. Læg den på en tallerken."
    },
    {
      "section": null,
      "text": "Brun kyllingestykkerne i fedtet fra chorizoen, til skindet får farve og bliver sprødt. De skal ikke være færdigstegte. Læg dem over på en tallerken."
    },
    {
      "section": null,
      "text": "Varm rapsolien i en ren gryde ved lav til middel varme, og rør melet i. Rør hele tiden i 15-25 minutter, til blandingen er nøddebrun – et sted mellem en mandel og en hasselnød. Bliv ved gryden, for blandingen brænder let på, og så må du begynde forfra."
    },
    {
      "section": null,
      "text": "Kom peberfrugt, selleri, hvidløg og løg i gryden, og rør rundt i nogle minutter."
    },
    {
      "section": null,
      "text": "Rør tomater, alle krydderierne, laurbærblade, bouillon og chorizo i. Læg kyllingen ned i gryden, og lad det simre i mindst 1 time, gerne længere, til kødet falder fra benene."
    },
    {
      "section": null,
      "text": "Tag kyllingen op, og øs fedtet af overfladen. Pluk kødet af benene, og vend det tilbage i gryden."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber. Anret gumboen med ris og drys med persille."
    }
  ],
  "changes": [
    "Cayenne peber hedder nu cayennepeber."
  ]
}
