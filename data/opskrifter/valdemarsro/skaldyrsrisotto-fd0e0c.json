  "steps": [
    {
      "section": "Risotto",
      "text": "Varm smør og olie i en bred pande. Svits skalotteløg og hvidløg, til de er bløde og klare."
    },
    {
      "section": "Risotto",
      "text": "Rør risene med i cirka 1 minut. Hæld hvidvin og halvdelen af fiskefonden i, rør rundt og læg låg på."
    },
    {
      "section": "Risotto",
      "text": "Rør jævnligt i panden. Når væsken er optaget, så hæld resten af fonden i lidt ad gangen, til risene er møre og al dente."
    },
    {
      "section": "Risotto",
      "text": "Smag til med salt og peber."
    },
    {
      "section": "Skaldyr",
      "text": "Pil jomfruhummere og rejer. Gem et par stykker med skal til pynt."
    },
    {
      "section": "Skaldyr",
      "text": "Skrub muslingerne under koldt rindende vand med en blød børste, og lad dem ikke ligge i vand. Bank hver musling let mod bordet: De friske lukker sig igen. Kassér dem, der forbliver åbne."
    },
    {
      "section": "Skaldyr",
      "text": "Lad muslingerne dryppe af på et tørt viskestykke."
    },
    {
      "section": "Skaldyr",
      "text": "Smelt smørret i en gryde. Svits skalotteløg, hvidløg og fennikel i cirka 1 minut."
    },
    {
      "section": "Skaldyr",
      "text": "Skru til maksimal varme og hæld hvidvinen i. Kom muslingerne i og sæt låg på. Skru lidt ned, så det stadig simrer."
    },
    {
      "section": "Skaldyr",
      "text": "Damp muslingerne i 5-7 minutter, til de har åbnet sig."
    },
    {
      "section": "Skaldyr",
      "text": "Vend rejer og jomfruhummere i gryden og rør kort rundt over varmen."
    },
    {
      "section": "Servering",
      "text": "Vend skaldyrene sammen med risottoen. Anret i dybe tallerkener og top med dild og fintrevet citronskal."
    }
  ],
