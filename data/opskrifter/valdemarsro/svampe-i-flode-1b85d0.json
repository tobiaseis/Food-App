  "steps": [
    {
      "section": null,
      "text": "Varm smørret op på en pande, og steg champignonerne af på høj varme, mens du rører rundt. Fortsæt, til de er brunede og har fået en fin gylden skorpe."
    },
    {
      "section": null,
      "text": "Sænk varmen, og tilsæt løget. Svits det, til det er blødt."
    },
    {
      "section": null,
      "text": "Strø timian over, og hæld fløden i. Lad det småkoge, til saucen er lidt tykkere. Krydr med salt og peber."
    },
    {
      "section": null,
      "text": "Anret svampene på brødskiverne. Top med persille og en smule ekstra peber og salt."
    }
  ],
