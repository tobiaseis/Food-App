  "steps": [
    {
      "section": "Fyldet",
      "text": "Varm olien op i en gryde, og svits løget, til det er blødt."
    },
    {
      "section": "Fyldet",
      "text": "Skru op for varmen, og kom oksekødet i. Rør hele tiden, og brun kødet hurtigt."
    },
    {
      "section": "Fyldet",
      "text": "Rør gulerødder, squash, peberfrugt, hvidløg, alle krydderierne og de hakkede tomater i. Kog uden låg i 5 minutter."
    },
    {
      "section": "Fyldet",
      "text": "Vend bønner og majs i, og lad fyldet blive varmt hele vejen igennem. Smag til med salt og peber."
    },
    {
      "section": "Samling og bagning",
      "text": "Tænd ovnen på 175 °C varmluft. Smør et ovnfast fad."
    },
    {
      "section": "Samling og bagning",
      "text": "Fordel fyldet på tortillaerne, og rul dem stramt sammen. Læg dem i fadet med samlingen nedad."
    },
    {
      "section": "Samling og bagning",
      "text": "Strø cheddar ud over, og bag enchiladasene i ca. 15 minutter, til osten er smeltet."
    },
    {
      "section": "Servering",
      "text": "Hak koriander eller persille, og stræk den ud over retten. Dryp sriracha på til sidst."
    }
  ],
