  "steps": [
    {
      "section": null,
      "text": "Steg baconen sprød på en pande. Tag den op, og lad den dryppe af. Skær den derefter i små stykker."
    },
    {
      "section": null,
      "text": "Drys koteletterne med salt og peber. Smelt smørret på panden, og brun koteletterne i ca. ½-1 minut på hver side. Læg dem til side."
    },
    {
      "section": null,
      "text": "Steg champignon, timian og løg på panden ved høj varme. Tilsæt lidt mere smør, hvis panden bliver tør."
    },
    {
      "section": null,
      "text": "Rør hvidløg og begge slags paprika i, og steg et øjeblik. Tilsæt bacon, hakkede tomater og fløde, og lad saucen simre i 10 minutter."
    },
    {
      "section": null,
      "text": "Smag saucen til med salt og peber. Forvarm ovnen til 175 °C."
    },
    {
      "section": null,
      "text": "Læg koteletterne i et smurt ovnfast fad, og hæld saucen over. Bag i 15-20 minutter, til koteletterne er gennemstegte. Tiden afhænger af, hvor tykke de er."
    },
    {
      "section": null,
      "text": "Server med ris, og drys med frisk timian."
    }
  ],
