  "steps": [
    {
      "section": null,
      "text": "Varm en pande over middelvarme, og smelt halvdelen af smørret, til det bruser. Steg halloumien, til den er sprød og gyldenbrun, og stil den til side."
    },
    {
      "section": null,
      "text": "Smelt det resterende smør på panden. Svits løg og alle krydderierne, til løgene er bløde, og det dufter fantastisk."
    },
    {
      "section": null,
      "text": "Rør hvidløg, ingefær, tomater, tomatpuré, yoghurt og fløde i. Lad saucen simre uden låg i 10 minutter."
    },
    {
      "section": null,
      "text": "Vend butterbeans og den stegte halloumi i saucen. Smag til med peber og eventuelt lidt salt, og lad det simre i 5 minutter mere."
    },
    {
      "section": null,
      "text": "Server i skåle med ris og butter halloumi. Top med en klat smør og hakket koriander."
    }
  ],
