  "steps": [
    {
      "section": "Kebab",
      "text": "Skær svinekoteletterne i mundrette tern, og læg dem i en skål."
    },
    {
      "section": "Kebab",
      "text": "Rør olie, citronsaft, tørret mynte, oregano, hvidløg, salt og peber sammen til en marinade. Vend kødet rundt i den."
    },
    {
      "section": "Kebab",
      "text": "Dæk skålen til, og sæt den i køleskabet i et par timer – gerne hele dagen."
    },
    {
      "section": "Kebab",
      "text": "Træk kødet på grillspyd. Grill dem over høj varme, eller steg kødet med marinaden på en meget varm pande."
    },
    {
      "section": "Fladbrød",
      "text": "Bland vand og olie i en skål. Rør begge slags mel og saltet i, og ælt dejen grundigt sammen."
    },
    {
      "section": "Fladbrød",
      "text": "Lad dejen hvile i ca. en halv time."
    },
    {
      "section": "Fladbrød",
      "text": "Del dejen i 10 lige store stykker, og form dem til kugler. Rul dem meget tynde på et bord, der er smurt med olivenolie i stedet for mel."
    },
    {
      "section": "Fladbrød",
      "text": "Bag fladbrødene et ad gangen på en tør pande ved middelhøj varme."
    },
    {
      "section": "Tzatziki",
      "text": "Kom agurken i en skål, og drys den med salt. Vend rundt, og lad den stå i ca. 15 minutter."
    },
    {
      "section": "Tzatziki",
      "text": "Pres væsken ud af agurken, evt. i en sigte, så den dræner godt."
    },
    {
      "section": "Tzatziki",
      "text": "Rør agurk, hvidløg og yoghurt sammen, og smag til med peber."
    },
    {
      "section": "Til servering",
      "text": "Fyld fladbrødene med kødet, tzatziki og friske mynteblade, og rul dem sammen."
    }
  ],
  "changes": [
    "Koteletter er blevet til svinekoteletter."
  ]
