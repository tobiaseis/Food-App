  "steps": [
    {
      "section": null,
      "text": "Varm olien i en gryde, og svits løg og hvidløg, til løgene er blanke og bløde."
    },
    {
      "section": null,
      "text": "Kom risene i gryden, og rør rundt i cirka 1 minut, så de bliver dækket af olie."
    },
    {
      "section": null,
      "text": "Slå hvidvinen ud over, og rør, til risene har optaget den. Skru derefter ned på middel-lav varme."
    },
    {
      "section": null,
      "text": "Blend flåede tomater, tomatpuré, fond og timian til en glat væske."
    },
    {
      "section": null,
      "text": "Tilsæt væsken til risene i små portioner. Vent hver gang, til risene har suget det meste op, før du hælder mere i. Fortsæt, til risene er næsten møre med en lille bid."
    },
    {
      "section": null,
      "text": "Rør soltørrede tomater og parmesan i. Smag til med citronskal, salt og peber. Risottoen skal være cremet og let flydende."
    },
    {
      "section": "Til servering",
      "text": "Anret risottoen med burrata, en skefuld pesto, ekstra parmesan og friske basilikumblade."
    }
  ],
