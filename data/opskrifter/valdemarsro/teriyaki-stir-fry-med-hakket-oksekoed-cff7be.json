  "steps": [
    {
      "section": "Marinaden",
      "text": "Rør alle ingredienserne til marinaden sammen i en skål, så majsstivelsen opløses helt og der ikke er klumper."
    },
    {
      "section": "Wokken",
      "text": "Hæt olien op i en wok eller stor sauterpande over høj varme, og brun det hakkede oksekød. Tag kødet op på en tallerken."
    },
    {
      "section": "Wokken",
      "text": "Steg champignonerne af på samme pande over høj varme, til de er gyldne og har fået en stegeskorpe."
    },
    {
      "section": "Wokken",
      "text": "Sænk til middel varme. Kom kødet tilbage i wokken sammen med løg, spidskål, peberfrugt, broccoli og sukkerærter. Rør konstant, og varm grøntsagerne igennem i 3-4 minutter."
    },
    {
      "section": "Nudler",
      "text": "Kog nudlerne, mens grøntsagerne steger, som det står på pakken. Si vandet fra, og læg nudlerne op i dybe skåle."
    },
    {
      "section": "Samling",
      "text": "Hæld marinaden i wokken, skru op for varmen, og rør rundt i 1-2 minutter, til saucen er tyknet og dækker det hele."
    },
    {
      "section": "Samling",
      "text": "Hæld straks wokretten over nudlerne, og drys med sesamfrø."
    }
  ],
