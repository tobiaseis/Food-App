  "steps": [
    {
      "section": "Spinatfyld",
      "text": "Svits løgene i olivenolie på en pande, til de er bløde og stadig lyse."
    },
    {
      "section": "Spinatfyld",
      "text": "Kom den frosne spinat på panden, og varm den, til den er helt optøet. Rør flødeost i, og krydr med salt og peber."
    },
    {
      "section": "Kylling i krydret tomatsauce",
      "text": "Hæld olie på en varm pande, og brun kyllingetern på alle sider over høj varme. Læg dem over på en tallerken."
    },
    {
      "section": "Kylling i krydret tomatsauce",
      "text": "Sænk til middelvarme. Svits løg, hvidløg og gulerødder på samme pande."
    },
    {
      "section": "Kylling i krydret tomatsauce",
      "text": "Tilsæt squash, de tørrede krydderurter, tomatpuré, hakkede tomater og fond. Lad saucen simre i ca. 15 minutter, til den er kogt lidt ind."
    },
    {
      "section": "Kylling i krydret tomatsauce",
      "text": "Sluk for varmen, og vend de brunede kyllingetern i saucen."
    },
    {
      "section": "Mornaysauce",
      "text": "Smelt smørret i en gryde, og pisk melet i, så det danner en klump."
    },
    {
      "section": "Mornaysauce",
      "text": "Hæld mælken i en tynd stråle, mens du pisker, til saucen er jævn og tyk nok til at kunne hældes."
    },
    {
      "section": "Mornaysauce",
      "text": "Pisk osten i, til den er smeltet, og smag til med muskatnød, salt og peber."
    },
    {
      "section": "Til lasagnen",
      "text": "Varm ovnen op til 220 °C varmluft."
    },
    {
      "section": "Til lasagnen",
      "text": "Byg lasagnen i lag af tomatsauce med kylling, spinatfyld, mornaysauce og lasagneplader. Slut med et lag mornaysauce øverst."
    },
    {
      "section": "Til lasagnen",
      "text": "Bag lasagnen i 12-15 minutter. Drys med frisk oregano, inden den serveres."
    }
  ],
