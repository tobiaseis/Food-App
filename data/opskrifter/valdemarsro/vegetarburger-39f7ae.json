  "steps": [
    {
      "section": "Rødbedebøffer",
      "text": "Bland rødbeder, havregryn, hvedemel, løg, hvidløg, æg og sennep i en skål. Rør det godt sammen og smag til med salt og peber."
    },
    {
      "section": "Rødbedebøffer",
      "text": "Er blandingen for våd eller for tør, så tilsæt lidt mere havregryn eller mel, til den er nem at forme."
    },
    {
      "section": "Rødbedebøffer",
      "text": "Tænd ovnen på 200 °C varmluft. Form fire bøffer, og læg dem på en bradepande med bagepapir. Dryp olie over."
    },
    {
      "section": "Rødbedebøffer",
      "text": "Bag bøfferne i cirka 10 minutter, vend dem, og bag dem i 5 minutter mere. Læg en skive ost på hver, og bag 1 minut, til osten lige er smeltet."
    },
    {
      "section": "Til burgerne",
      "text": "Del bollerne og varm dem kort i ovnen. Smør dem med mayonnaise."
    },
    {
      "section": "Til burgerne",
      "text": "Læg salat, avocado, rødløg, agurk og en rødbedebøf i hver bolle, og luk burgeren."
    }
  ],
  "changes": []
