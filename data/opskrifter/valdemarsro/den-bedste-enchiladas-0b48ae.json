  "steps": [
    {
      "section": "Enchiladasauce",
      "text": "Varm en tør gryde op på høj varme, og rist alle krydderierne, mens du rører, til de begynder at dufte."
    },
    {
      "section": "Enchiladasauce",
      "text": "Tag gryden af varmen. Tilsæt olien og løget, og sæt den tilbage på middelvarme, til løget er blødt."
    },
    {
      "section": "Enchiladasauce",
      "text": "Rør melet ud i løgene, og hæld bouillonen i lidt ad gangen. Pisk, til saucen er helt glat."
    },
    {
      "section": "Enchiladasauce",
      "text": "Tilsæt de hakkede tomater, og lad saucen simre uden låg i 10-15 minutter. Smag til med salt og peber, og tilsæt mere cayennepeber, hvis den skal være stærkere."
    },
    {
      "section": "Pulled chicken",
      "text": "Læg kyllingebrystene i en gryde sammen med hvidløg, bouillon og en del af tomatsaucen. Bring det i kog, og skru ned, så det kun lige simrer."
    },
    {
      "section": "Pulled chicken",
      "text": "Læg låg på, og lad kyllingen simre i 30 minutter, til den er mør."
    },
    {
      "section": "Pulled chicken",
      "text": "Træk kødet i tråde med to gafler, og vend det rundt i den sauce, det har simret i."
    },
    {
      "section": "Samling",
      "text": "Tænd ovnen på 180 °C varmluft."
    },
    {
      "section": "Samling",
      "text": "Pensl hver tortilla med enchiladasauce. Fordel bønner, halvdelen af majsen og pulled chicken på dem, og drys med lidt ost."
    },
    {
      "section": "Samling",
      "text": "Rul tortillaerne sammen, og læg dem med samlingen nedad i et ovnfast fad."
    },
    {
      "section": "Samling",
      "text": "Hæld et rigeligt lag sauce over, og strø resten af majsen og osten ovenpå."
    },
    {
      "section": "Samling",
      "text": "Bag enchiladasene midt i ovnen i 15-18 minutter."
    },
    {
      "section": "Samling",
      "text": "Hak persillen, og strø den over lige før servering."
    }
  ],
