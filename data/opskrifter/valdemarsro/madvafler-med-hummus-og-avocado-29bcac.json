  "steps": [
    {
      "section": "Hummus",
      "text": "Blend tahin og citronsaft i en blender eller foodprocessor i cirka 1 minut."
    },
    {
      "section": "Hummus",
      "text": "Tilsæt resten af hummusens ingredienser, og kør i endnu et minut. En isterning gør hummussen ekstra cremet. Er den for tyk, så tilsæt lidt koldt vand."
    },
    {
      "section": "Hummus",
      "text": "Smag til med citron, olie, salt og peber."
    },
    {
      "section": "Vafler",
      "text": "Pisk de to slags mel og bagepulver sammen i en skål."
    },
    {
      "section": "Vafler",
      "text": "Skyl spinaten godt. Blend den med æg, mælk og det afmålte mel, til dejen er helt glat. Lad dejen hvile i 15 minutter, så den tykner lidt. Smag til med salt og peber."
    },
    {
      "section": "Vafler",
      "text": "Pensl vaffeljernet med lidt olie eller smør, og bag vaflerne, til de er gyldne og færdigbagte."
    },
    {
      "section": "Halloumi og rugbrødskrummer",
      "text": "Steg halloumien på en pande med lidt olie eller smør. Vend skiverne, så begge sider bliver gyldne og sprøde. Tag dem af panden."
    },
    {
      "section": "Halloumi og rugbrødskrummer",
      "text": "Pulsér rugbrødet i en minihakker, til det er smuldret fint."
    },
    {
      "section": "Halloumi og rugbrødskrummer",
      "text": "Rist krummerne i smør på samme pande, og rør ofte. Krydr med fennikelfrø og flagesalt."
    },
    {
      "section": "Til servering",
      "text": "Anret vaflerne med hummus, avocado og halloumi. Drys med rugbrødskrummer, og top med rucola og timian."
    }
  ],
