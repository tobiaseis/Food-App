  "steps": [
    {
      "section": "Vafler",
      "text": "Har du falafelfarsen klar i forvejen, kan du fryse den i portioner til to vafler ad gangen."
    },
    {
      "section": "Vafler",
      "text": "Pensl eller smør vaffeljernet med olivenolie (kokosolie går også). Fordel falafelfarsen i jernet."
    },
    {
      "section": "Vafler",
      "text": "Luk jernet, og bag vaflerne, til indikatoren skifter til grøn, eller til de er gyldne og sprøde."
    },
    {
      "section": "Tahinsauce",
      "text": "Pres saften fra citronen. Pisk tahin, citronsaft og koldt vand sammen, og smag til med salt og peber."
    },
    {
      "section": "Servering",
      "text": "Smør creme fraiche på vaflerne. Læg rucola, avocado, agurk og tomat ovenpå."
    },
    {
      "section": "Servering",
      "text": "Dryp med tahinsauce og sriracha, og drys med hakket koriander."
    }
  ],
