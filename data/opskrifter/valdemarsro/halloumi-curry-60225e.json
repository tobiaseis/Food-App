  "steps": [
    {
      "section": null,
      "text": "Steg halloumien i olie i en gryde ved middelhøj varme, til tern har fået gylden skorpe på. Læg dem over på en tallerken."
    },
    {
      "section": null,
      "text": "Skru lidt ned for varmen, og svits løget i samme gryde, til det er blødt."
    },
    {
      "section": null,
      "text": "Rør hvidløg, ingefær, nellike, kardemomme, chiliflager og karry i gryden. Lad det varme i et par minutter, til krydderierne dufter."
    },
    {
      "section": null,
      "text": "Hæld de hakkede tomater i, og lad det komme i kog. Lad curryen simre ved lav varme i 10 minutter, og kog imens risene."
    },
    {
      "section": null,
      "text": "Rør fløde og spinat ned i saucen. Krydr med salt, peber og limesaft, og kom limeskallen i."
    },
    {
      "section": null,
      "text": "Vend halloumien tilbage i gryden, og lad den blive gennemvarm."
    },
    {
      "section": "Til servering",
      "text": "Anret risene i dybe tallerkener med curryen ovenpå. Læg en lille klump smør øverst, så den smelter ud i saucen."
    },
    {
      "section": "Til servering",
      "text": "Strø koriander og sesamfrø over, og server med naan."
    }
  ],
  "changes": []
