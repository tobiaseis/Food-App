  "steps": [
    {
      "section": "Timiankartofler",
      "text": "Varm ovnen op til 200 °C."
    },
    {
      "section": "Timiankartofler",
      "text": "Skrub eller skræl kartoflerne, og del dem i store både. Vend dem med olie, timian og flagesalt."
    },
    {
      "section": "Timiankartofler",
      "text": "Fordel kartoflerne på en bageplade med bagepapir, og bag dem i 30-40 minutter, til de er gyldne og sprøde."
    },
    {
      "section": "Kødspyd",
      "text": "Læg lammekød, æg, hvidløg, rødløg, feta, soltørrede tomater, timianblade, salt og peber i en skål. Pisk det sammen med en håndmixer i 1-2 minutter."
    },
    {
      "section": "Kødspyd",
      "text": "Rul farsen til kugler. Brun dem på en varm pande i olie og smør, til de er gennemstegte."
    },
    {
      "section": "Kødspyd",
      "text": "Træk kuglerne på spyd lige før servering. Du kan også grille dem på spyd."
    },
    {
      "section": "Græsk salat",
      "text": "Rør olie, sukker, citronskal, citronsaft, salt, peber og oregano sammen, til sukkeret har opløst sig."
    },
    {
      "section": "Græsk salat",
      "text": "Kom tomater, agurk og rødløg i en stor skål, og vend dem med dressingen."
    },
    {
      "section": "Græsk salat",
      "text": "Smuldr fetaen ovenpå, og strø oliven og lidt ekstra oregano over."
    }
  ],
