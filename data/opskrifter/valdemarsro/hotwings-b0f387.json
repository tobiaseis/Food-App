  "steps": [
    {
      "section": "Kyllingevinger",
      "text": "Skær vingerne over i leddet. Smid vingespidserne ud, eller læg dem i fryseren til en senere kyllingefond."
    },
    {
      "section": "Kyllingevinger",
      "text": "Rør mel, begge slags paprika, cayennepeber, løgpulver, salt og peber sammen i en stor skål."
    },
    {
      "section": "Kyllingevinger",
      "text": "Tør vingerne af med køkkenrulle, og vend dem i krydderblandingen. Lad dem hvile et par minutter eller gerne længere."
    },
    {
      "section": "Kyllingevinger",
      "text": "Vend vingerne let rundt i olien, eller dryp olien henover dem."
    },
    {
      "section": "Kyllingevinger",
      "text": "Grillvarianten: læg vingerne på en varm grill, og vend dem ofte, mens du holder øje med dem. Røgspåner til sidst giver ekstra røget smag."
    },
    {
      "section": "Kyllingevinger",
      "text": "Ovnvarianten: læg vingerne på bagepapir, og bag dem i 15-20 minutter ved 225 °C i en forvarmet ovn, til de er gennemstegte. Vend dem et par gange undervejs."
    },
    {
      "section": "Barbecuesauce",
      "text": "Put alle ingredienserne til saucen i en gryde, og pisk dem sammen. Varm det langsomt op, til det koger."
    },
    {
      "section": "Barbecuesauce",
      "text": "Lad saucen simre i 5 minutter, og smag den til."
    },
    {
      "section": "Barbecuesauce",
      "text": "Lad saucen køle en smule af. Vend de færdigstegte vinger rundt i den, og server straks."
    }
  ],
  "changes": [
    "Æblecidereddike er skiftet til æbleeddike.",
    "Koncentreret tomatpuré er skiftet til tomatpuré."
