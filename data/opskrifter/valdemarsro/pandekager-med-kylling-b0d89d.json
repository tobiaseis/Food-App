  "steps": [
    {
      "section": "Pandekager",
      "text": "Pisk æg, mælk og salt sammen, og rør begge slags mel i, til dejen er glat."
    },
    {
      "section": "Pandekager",
      "text": "Varm en pande med lidt smør eller olie. Fordel en lille øse dej i et meget tyndt lag, og steg pandekagerne én ad gangen på begge sider, til de er lysebrune."
    },
    {
      "section": "Karrydressing",
      "text": "Rør alle ingredienserne til dressingen sammen, og smag den godt til med salt og peber."
    },
    {
      "section": "Fyld",
      "text": "Steg baconen sprød på en pande. Tag den op, og læg den på en tallerken."
    },
    {
      "section": "Fyld",
      "text": "Kom olie i baconfedtet på panden, og læg kyllingestrimlerne i. Krydr med paprika, salt og peber, og steg dem, til de er gennemstegte. Tag panden af varmen, og lad kyllingen blive lun på panden."
    },
    {
      "section": "Til servering",
      "text": "Anret pandekagerne med dressing, rucola, spinat, agurk, avocado, bacon og kylling."
    }
  ],
  "changes": [
    "Rucola og baby spinat er skrevet som rucola og spinat, som de hedder i supermarkedet."
  ]
