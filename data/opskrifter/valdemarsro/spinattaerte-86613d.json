  "steps": [
    {
      "section": "Tærtedej",
      "text": "Bland begge slags mel med saltet. Smuldr smørret ud i melet med fingrene, eller kør det i en foodprocessor."
    },
    {
      "section": "Tærtedej",
      "text": "Tilsæt vandet og æltes sammen til en dej. Lad den gerne hvile på køl i 30 minutter."
    },
    {
      "section": "Tærtedej",
      "text": "Tryk dejen ud i en smurt tærteform på 24 cm, og prik bunden over med en gaffel."
    },
    {
      "section": "Tærtedej",
      "text": "Forbag bunden i 10 minutter i en forvarmet ovn ved 175 °C varmluft."
    },
    {
      "section": "Fyld",
      "text": "Pres vandet fra den optøede spinat. Rør spinaten sammen med æg, hytteost, creme fraiche og muskatnød i en skål, og smag til med salt og peber."
    },
    {
      "section": "Fyld",
      "text": "Hæld fyldet i den forbagte bund. Riv eller skær mozzarellaen i stykker, læg den ovenpå, og strø pinjekerner over."
    },
    {
      "section": "Fyld",
      "text": "Bag tærten ved 175 °C varmluft i cirka 30-35 minutter, til fyldet er stivnet."
    }
  ],
