  "steps": [
    {
      "section": "Kartoffelblinis",
      "text": "Mos de kolde kartofler, og bland dem med creme fraiche og æggeblommer."
    },
    {
      "section": "Kartoffelblinis",
      "text": "Bland hvedemel og bagepulver med salt og peber, og rør det ned i kartoffelmassen."
    },
    {
      "section": "Kartoffelblinis",
      "text": "Pisk æggehviderne til stive toppe, og vend dem forsigtigt ind i dejen."
    },
    {
      "section": "Kartoffelblinis",
      "text": "Varm smørret op på en stor pande eller blinispande ved middelvarme. Sæt 12 små klatter dej på panden, og steg dem gyldne på begge sider."
    },
    {
      "section": "Røget laksemousse",
      "text": "Mos laksen med mayonnaise og creme fraiche med en gaffel, til det er en cremet mousse."
    },
    {
      "section": "Røget laksemousse",
      "text": "Rør purløg i moussen, og smag den til med citronsaft, citronskal, salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Læg moussen på blinisene, og pynt med dild og eventuelt stenbiderrogn."
    }
  ],
