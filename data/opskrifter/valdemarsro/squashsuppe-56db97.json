  "steps": [
    {
      "section": "Saltede mandler",
      "text": "Varm ovnen op til 150 °C. Rør vand, røget paprika og salt sammen i en skål, og vend mandlerne i blandingen."
    },
    {
      "section": "Saltede mandler",
      "text": "Læg mandlerne på en bageplade med bagepapir, og bag dem i 15 minutter, til vandet er fordampet, og de er tørre og sprøde. Hak dem groft."
    },
    {
      "section": "Suppe",
      "text": "Svits løg og hvidløg i olie i en gryde, til løgene er blødt op. Tilsæt squash, og steg med i et par minutter."
    },
    {
      "section": "Suppe",
      "text": "Rør sød paprika og en del af basilikummen i, og hæld fonden over. Lad suppen koge ved svag varme i ca. 15 minutter."
    },
    {
      "section": "Suppe",
      "text": "Blend suppen med fløden, og smag til med salt og peber."
    },
    {
      "section": "Basilikumolie",
      "text": "Blend halvdelen af den friske basilikum med olien, til du har en grøn urteolie."
    },
    {
      "section": "Basilikumolie",
      "text": "Øs suppen op i dybe tallerkener. Top med de hakkede mandler, basilikumolien og resten af basilikummen."
    }
  ],
