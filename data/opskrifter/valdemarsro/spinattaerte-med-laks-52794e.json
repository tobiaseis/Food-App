  "steps": [
    {
      "section": "Tærtedej",
      "text": "Bland hørfrø, begge slags mel og salt og peber i en skål. Smuldr smørret i, og tilsæt vand lidt ad gangen, til dejen hænger sammen."
    },
    {
      "section": "Tærtedej",
      "text": "Smør en tærteform, og pres dejen jævnt ud i bunden og op ad kanten."
    },
    {
      "section": "Tærtedej",
      "text": "Forbag bunden i forvarmet ovn ved 175 °C varmluft i 10 minutter."
    },
    {
      "section": "Fyld",
      "text": "Varm spinaten op i en gryde ved lav varme, til den er tøet. Lad den koge kort op, og smag den til med muskatnød, salt og peber."
    },
    {
      "section": "Fyld",
      "text": "Pisk æg og mælk sammen, og hæld blandingen over den forbagte bund."
    },
    {
      "section": "Fyld",
      "text": "Læg spinat og lakseterninger ovenpå."
    },
    {
      "section": "Fyld",
      "text": "Bag tærten ved 175 °C varmluft i 30 minutter, indtil æggemassen er fast."
    },
    {
      "section": "Fyld",
      "text": "Server med en grøn salat."
    }
  ],
