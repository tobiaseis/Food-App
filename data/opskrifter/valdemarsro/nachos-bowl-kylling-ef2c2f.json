  "steps": [
    {
      "section": "Tortillaskåle",
      "text": "Varm ovnen op til 175 °C varmluft. Smør tortillaerne med olie på begge sider, og pres dem ned i små ovnfaste skåle, så de får en skålform."
    },
    {
      "section": "Tortillaskåle",
      "text": "Bag skålene i 8-10 minutter, til de har fået en let gylden farve. Lad dem stå i formene, til de er kolde og sprøde."
    },
    {
      "section": "Kyllingefyld",
      "text": "Varm olivenolien i en gryde ved middelvarme. Svits løg og hvidløg under omrøring, til de er bløde."
    },
    {
      "section": "Kyllingefyld",
      "text": "Kom kyllingen i, og brun den godt. Rør squash, krydderier, tomatpuré, hakkede tomater og majs i, og bring det i kog."
    },
    {
      "section": "Kyllingefyld",
      "text": "Lad fyldet simre uden låg i 20 minutter. Krydr med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Smelt smørret på en pande, og rist majsen, til den bliver let sprød."
    },
    {
      "section": "Til servering",
      "text": "Fyld tortillaskålene med kyllingefyldet. Top med avocado, ristet majs og cheddar, og server med limebåde til at presse over."
    }
  ],
