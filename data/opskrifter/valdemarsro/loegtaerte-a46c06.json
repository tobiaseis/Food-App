  "steps": [
    {
      "section": "Tærtebund",
      "text": "Bland begge slags mel med saltet. Smuldr smørret i melet med fingrene, eller kør det i en foodprocessor."
    },
    {
      "section": "Tærtebund",
      "text": "Saml dejen med vandet. Lad den gerne hvile på køl i 30 minutter."
    },
    {
      "section": "Tærtebund",
      "text": "Smør en tærteform på 27 cm i diameter. Pres dejen ud i formen, og stik huller i bunden med en gaffel."
    },
    {
      "section": "Tærtebund",
      "text": "Forbag bunden i 10 minutter ved 175 °C varmluft i en forvarmet ovn."
    },
    {
      "section": "Fyld",
      "text": "Svits løgene i olivenolien på en stor pande, til de er bløde."
    },
    {
      "section": "Fyld",
      "text": "Rør honningen i, og lad løgene karamellisere under omrøring."
    },
    {
      "section": "Fyld",
      "text": "Kom pinjekerner, muskatnød og timian på panden, og krydr med salt og peber. Tag panden af varmen."
    },
    {
      "section": "Fyld",
      "text": "Rør æg, creme fraiche og gruyère sammen. Vend løgblandingen i."
    },
    {
      "section": "Fyld",
      "text": "Hæld fyldet i den forbagte bund. Bag tærten i ca. 35 minutter ved 175 °C varmluft, til æggemassen er stivnet."
    }
  ],
