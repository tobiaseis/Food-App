  "steps": [
    {
      "section": "Sesamkylling",
      "text": "Kog risene, så de er klar til servering. Følg anvisningen på pakken."
    },
    {
      "section": "Sesamkylling",
      "text": "Rør tahin, sojasauce, eddike, fond, majsstivelse, det pressede hvidløg, ingefær, farin og de 40 g sesamfrø sammen til en sauce."
    },
    {
      "section": "Sesamkylling",
      "text": "Hæld sesamolien på en pande ved middel varme, og steg kyllingen, til den er brunet på alle sider."
    },
    {
      "section": "Sesamkylling",
      "text": "Kom saucen på panden, og lad det koge op. Lad retten simre i 6-8 minutter, til kyllingen er mør."
    },
    {
      "section": "Ris og grøntsager",
      "text": "Varm lidt olie på en anden pande. Steg porre og hvidløg, til porrerne er bløde."
    },
    {
      "section": "Ris og grøntsager",
      "text": "Vend spinaten i, og rør rundt, til den er varm og faldet sammen."
    },
    {
      "section": "Ingefæryoghurt",
      "text": "Bland yoghurt og sriracha, og smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Fordel ris, sesamkylling og grøntsager i dybe skåle. Top med forårsløg og de 15 g sesamfrø, og slut af med en klat ingefæryoghurt."
    }
  ],
