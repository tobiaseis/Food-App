  "steps": [
    {
      "section": "Bagt blomkål og kikærter",
      "text": "Forvarm ovnen til 200 °C varmluft. Læg bagepapir på en bageplade."
    },
    {
      "section": "Bagt blomkål og kikærter",
      "text": "Rør paprika, hvidløg og olivenolie sammen, og krydr med salt og peber."
    },
    {
      "section": "Bagt blomkål og kikærter",
      "text": "Fordel blomkål og kikærter på bagepladen, og vend dem grundigt med krydderiblandingen. Bag i 20 minutter."
    },
    {
      "section": "Croutoner",
      "text": "Opvarm en pande, og tilsæt brødtern, olie og hvidløg. Rør konstant, til brødet er let ristet og sprødt."
    },
    {
      "section": "Croutoner",
      "text": "Krydr med salt og peber, og tag panden af varmen."
    },
    {
      "section": "Tahinvinaigrette",
      "text": "Pisk citronsaft, citronskal, honning, sennep og tahin sammen, til dressingen er cremet og glat. Smag til med mere honning, sennep, salt og peber."
    },
    {
      "section": "Salat",
      "text": "Vend rucola og spinat med halvdelen af dressingen, og læg dem i en stor skål sammen med den bagte blomkål og kikærterne."
    },
    {
      "section": "Salat",
      "text": "Top med agurk, avocado, feta og croutoner. Strø basilikum, persille og purløg over, og server resten af dressingen ved siden af."
    }
  ],
