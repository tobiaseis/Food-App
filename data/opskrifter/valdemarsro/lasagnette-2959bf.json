  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en gryde, og svits løg og hvidløg, til løgene er bløde."
    },
    {
      "section": null,
      "text": "Sæt varmen op, og brun kødet godt, mens du rører hele tiden. Skru derefter varmen ned."
    },
    {
      "section": null,
      "text": "Pisk majsstivelsen ud i mælken. Kom det i gryden sammen med gulerødder, selleri, tomater, tomatpuré, bouillon og de tørrede krydderurter."
    },
    {
      "section": null,
      "text": "Lad saucen simre uden låg i 5 minutter. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Vend pastaen i saucen, og rør godt rundt i cirka 1 minut. Hæld det hele i et smurt ovnfast fad."
    },
    {
      "section": null,
      "text": "Pil mozzarellaen i mindre stykker, og fordel dem over fadet."
    },
    {
      "section": null,
      "text": "Bag i forvarmet ovn ved 175 °C varmluft i ca. 25 minutter, til pastaen er mør, men stadig har lidt bid."
    },
    {
      "section": null,
      "text": "Riv parmesan over lige før servering."
    }
  ],
