  "steps": [
    {
      "section": "Kyllingen",
      "text": "Læg kyllingebrysterne i en gryde, og hæld vand og bouillon over. Kog dem i cirka 15 minutter, til de er møre."
    },
    {
      "section": "Kyllingen",
      "text": "Løft kødet op af gryden, og stil det til side. Gem kogevandet til saucen. Skær kødet i skiver eller tern."
    },
    {
      "section": "Ris",
      "text": "Skyl risene grundigt i en sigte. Kog dem med vand, salt og kardemomme, som det står på pakken."
    },
    {
      "section": "Karrysaucen",
      "text": "Varm olien i en gryde, og svits løg, hvidløg og alle krydderierne et par minutter, til løgene er blanke og bløde."
    },
    {
      "section": "Karrysaucen",
      "text": "Tilsæt det revne æble, mælken og kogevandet. Lad saucen simre i nogle minutter."
    },
    {
      "section": "Karrysaucen",
      "text": "Ryst majsstivelsen sammen med mælken til jævning i et glas med låg. Rør det ned i saucen, og lad den koge op, til den bliver tyk og glat."
    },
    {
      "section": "Karrysaucen",
      "text": "Rund af med fløde, salt og peber. Kom kyllingen i saucen, og varm den helt igennem."
    },
    {
      "section": "Tilbehør",
      "text": "Anret æble, banan, mango, kokosmel, rosiner og persille i hver sin lille skål."
    },
    {
      "section": "Tilbehør",
      "text": "Sæt karry, ris og tilbehør på bordet, så hver gæst selv kan fylde sin tallerken."
    }
  ],
