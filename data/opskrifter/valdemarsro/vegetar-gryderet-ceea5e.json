  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en gryde ved middel varme. Svits løg og hvidløg sammen med alle krydderierne, til løgene er blevet bløde."
    },
    {
      "section": null,
      "text": "Tilsæt linser, kartofler, fond, hakkede tomater og kokosmælk. Læg låg på og lad det simre i 15 minutter."
    },
    {
      "section": null,
      "text": "Kom squash, blomkål og kikærter i gryden, og lad det simre videre i 10 minutter. Smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Anret gryderetten i dybe tallerkener sammen med risene. Top med yoghurt, hampefrø, koriander og chiliflager efter smag."
    }
  ],
