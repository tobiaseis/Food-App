  "steps": [
    {
      "section": "Kartoffelbåde",
      "text": "Forvarm ovnen til 200 °C varmluft."
    },
    {
      "section": "Kartoffelbåde",
      "text": "Del kartoflerne i både, og vend dem med olie, salt og paprika."
    },
    {
      "section": "Kartoffelbåde",
      "text": "Bag bådene i 30-35 minutter, til de er gyldne og sprøde. Rør rundt i dem et par gange undervejs."
    },
    {
      "section": "Fiskefrikadeller",
      "text": "Blend løg og squash i en foodprocessor, til det er hakket helt fint."
    },
    {
      "section": "Fiskefrikadeller",
      "text": "Kom fisk, æg, dild, mel og fløde i, og smag til med salt og peber. Pulsér kort, til farsen hænger sammen og har en konsistens, du kan lide."
    },
    {
      "section": "Fiskefrikadeller",
      "text": "Lad farsen hvile på køl i cirka en halv time."
    },
    {
      "section": "Fiskefrikadeller",
      "text": "Varm smør og olie op på panden ved middelvarme. Form frikadeller af farsen, og steg dem gyldne og sprøde på begge sider, til de er helt gennemstegte."
    },
    {
      "section": "Remoulade",
      "text": "Rør alle ingredienser sammen, og smag remouladen til."
    },
    {
      "section": "Råkostsalat",
      "text": "Rør citronsaft og honning sammen, og vend de revne æbler i blandingen."
    },
    {
      "section": "Råkostsalat",
      "text": "Bland gulerødder, solsikkekerner og rosiner i, og server med det samme."
    }
  ],
