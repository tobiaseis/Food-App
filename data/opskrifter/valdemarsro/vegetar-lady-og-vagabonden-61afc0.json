  "steps": [
    {
      "section": "Tomatsauce",
      "text": "Steg løg og hvidløg i smør i en gryde, til løgene er bløde."
    },
    {
      "section": "Tomatsauce",
      "text": "Rør tomater, timian, tomatpuré, eddike og soltørrede tomater i gryden, og smag til med salt og peber. Lad saucen simre uden låg, mens du laver resten."
    },
    {
      "section": "Tomatsauce",
      "text": "Blend saucen med en stavblender, hvis du vil have den helt glat."
    },
    {
      "section": "Quinoa- og linseboller",
      "text": "Skyl quinoa og linser i en sigte under koldt vand. Kom dem i en gryde med bouillon, bring det i kog, og læg låg på. Lad det simre i 20 minutter, til linserne næsten er møre."
    },
    {
      "section": "Quinoa- og linseboller",
      "text": "Varm ovnen op til 175 °C."
    },
    {
      "section": "Quinoa- og linseboller",
      "text": "Vend quinoa og linser sammen med champignon, æg, rødløg, hvidløg, persille, spidskommen, timian, oregano og feta i en skål. Smag til med salt og peber."
    },
    {
      "section": "Quinoa- og linseboller",
      "text": "Rul farsen til små boller, og læg dem på en bageplade med bagepapir. Bag dem i 25-30 minutter."
    },
    {
      "section": "Til servering",
      "text": "Kog spaghettien al dente, som det står på pakken."
    },
    {
      "section": "Til servering",
      "text": "Anret spaghetti med boller og varm tomatsauce. Top med rigeligt parmesan og frisk timian."
    }
  ],
