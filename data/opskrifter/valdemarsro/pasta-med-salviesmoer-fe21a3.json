  "steps": [
    {
      "section": null,
      "text": "Varm en gryde op ved middelvarme, og lad smørret smelte i den."
    },
    {
      "section": null,
      "text": "Læg salvieblade i det smeltede smør, og lad dem simre ved svag varme, indtil køkkenet dufter tydeligt af salvie. Tag derefter gryden af varmen."
    },
    {
      "section": null,
      "text": "Kog pastaen mør, men med lidt bid, i rigeligt letsaltet vand. Hæld vandet fra."
    },
    {
      "section": null,
      "text": "Vend den afdryppede pasta i salviesmørret, og fordel den på tallerkener."
    },
    {
      "section": null,
      "text": "Top med revet parmesan, friskkværnet peber, lidt salt og nogle ekstra salvieblade."
