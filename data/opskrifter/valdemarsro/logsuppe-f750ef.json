  "steps": [
    {
      "section": null,
      "text": "Varm olien i en gryde ved middelvarme. Svits løg og hvidløg, til løgene er bløde."
    },
    {
      "section": null,
      "text": "Drys sukkeret over, og rør løbende, til løgene karamelliserer og får en mørkere farve."
    },
    {
      "section": null,
      "text": "Tilsæt chili, timian, fond og balsamico. Bring suppen i kog, og lad den simre svagt i 20 minutter."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber, og tilsæt evt. lidt mere balsamico."
    },
    {
      "section": "Hvidløgsostebrød",
      "text": "Varm ovnen op til 175 °C varmluft og beklæd en bageplade med bagepapir."
    },
    {
      "section": "Hvidløgsostebrød",
      "text": "Gnid den ene side af hver brødskive med de overskårne hvidløg. Læg skiverne på bagepladen, og top dem med mozzarella."
    },
    {
      "section": "Hvidløgsostebrød",
      "text": "Bag brødene i cirka 10 minutter, til osten er smeltet."
    },
    {
      "section": null,
      "text": "Øs suppen op i skåle, og server de varme ostebrød ved siden af."
    }
  ],
