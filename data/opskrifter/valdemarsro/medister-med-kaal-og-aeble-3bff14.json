  "steps": [
    {
      "section": null,
      "text": "Brun medisterpølsen på en pande med lidt olie ved lav til middel varme. Den skal stege i cirka 15 minutter på hver side, til den er helt gennemstegt."
    },
    {
      "section": null,
      "text": "Varm smør, olivenolie, rosmarin og salvie op i en bred sauterpande."
    },
    {
      "section": null,
      "text": "Rør løgskiverne rundt i panden, til de er blevet bløde."
    },
    {
      "section": null,
      "text": "Tilsæt rødkålen, og vend den rundt, til den er faldet sammen."
    },
    {
      "section": null,
      "text": "Kom æblebåde og æblejuice i panden, læg låg på, og lad det simre på lav varme i 5 minutter."
    },
    {
      "section": null,
      "text": "Smag til med æblecidereddike, salt og peber. Server med medisteren og rugbrødet."
    }
  ],
