  "steps": [
    {
      "section": "Kartoffelfad",
      "text": "Varm lidt af olien på en pande, og svits porrerne, til de er lidt bløde, men uden at brune."
    },
    {
      "section": "Kartoffelfad",
      "text": "Tilsæt soltørrede tomater, squash, rosmarin, spinat, fond og fløde. Vend det rundt, til spinaten er faldet sammen, og lad det småkoge i 5 minutter. Smag til med salt og peber."
    },
    {
      "section": "Kartoffelfad",
      "text": "Smør et ovnfast fad med resten af olien. Fordel kartoflerne og grøntsagsblandingen i skiftende lag, så det øverste lag er kartofler."
    },
    {
      "section": "Kartoffelfad",
      "text": "Sæt fadet i ovnen ved 180 °C varmluft i ca. 25 minutter, mens du laver baconrullerne."
    },
    {
      "section": "Baconruller",
      "text": "Ælt hakket svinekød, løg, soltørrede tomater, timian, æg, fløde og hvedemel sammen med salt og peber til en ensartet fars."
    },
    {
      "section": "Baconruller",
      "text": "Form farsen til små aflange ruller, ca. 2 pr. person. Skær baconskiverne over på midten, og læg to halve stykker side om side. Placer en farsrulle på og rul baconen om den."
    },
    {
      "section": "Baconruller",
      "text": "Tag fadet ud af ovnen, og læg baconrullerne ovenpå. Bag videre i 30-45 minutter, til kartoflerne er møre, og rullerne er gennemstegte."
    },
    {
      "section": "Baconruller",
      "text": "Hak oregano eller persille, og drys over retten ved servering."
    }
  ],
