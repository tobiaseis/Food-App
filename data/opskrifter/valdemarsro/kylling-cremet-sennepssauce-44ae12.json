  "steps": [
    {
      "section": "Ris",
      "text": "Kog risene efter anvisningen på emballagen, og hold dem lune."
    },
    {
      "section": "Kylling og sauce",
      "text": "Bland hvedemel med salt og peber, og rul kyllingestykkerne grundigt i blandingen."
    },
    {
      "section": "Kylling og sauce",
      "text": "Varm smør og olie op på en pande ved middelvarme. Brun kyllingen i 3-4 minutter på hver side, til den er gylden. Læg den på en tallerken, og dæk med en omvendt skål."
    },
    {
      "section": "Kylling og sauce",
      "text": "Tør panden af med køkkenrulle, og steg baconskiverne sprøde. Tilsæt lidt ekstra olie, hvis der er brug for det. Tag baconen op på køkkenrulle."
    },
    {
      "section": "Kylling og sauce",
      "text": "Svits løg og hvidløg i baconfedtet, til de er bløde."
    },
    {
      "section": "Kylling og sauce",
      "text": "Hæld hvidvinen på panden, og lad den bruse af. Pisk majsstivelsen ud i fløden, og tilsæt den sammen med fond og begge slags sennep. Lad saucen koge op under omrøring, og smag til med estragon, salt og peber."
    },
    {
      "section": "Kylling og sauce",
      "text": "Smuldr baconen, og kom den i saucen sammen med kyllingen. Lad kyllingen simre færdig i saucen."
    },
    {
      "section": "Haricots verts",
      "text": "Bring letsaltet vand i kog i en gryde, og kog bønnerne i 2-3 minutter. Si dem fra, og skyl straks med iskoldt vand, så de ikke koger videre. Lad dem dryppe godt af."
    },
    {
      "section": "Haricots verts",
      "text": "Vend bønnerne med olie, salt, peber, en smule citronsaft og revet citronskal. Drys med hampefrø."
    },
    {
      "section": null,
      "text": "Server kyllingen i saucen med ris og de lune bønner."
    }
  ],
  "changes": []
