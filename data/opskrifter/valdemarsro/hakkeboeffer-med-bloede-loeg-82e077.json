  "steps": [
    {
      "section": null,
      "text": "Lav agurkesalaten først. Kog kartoflerne, mens resten af retten laves, og gem noget af kogevandet til saucen."
    },
    {
      "section": "Bløde løg og svampe",
      "text": "Varm en pande op med olien og halvdelen af smørret. Brun svampene og timianen ved høj varme under omrøring, til de får lidt farve. Læg dem over på en tallerken."
    },
    {
      "section": "Bløde løg og svampe",
      "text": "Skru ned til middelvarme. Smelt resten af smørret på panden, og svits løgringene, til de er bløde. Dryp med balsamico, og stil løgene til side sammen med svampene."
    },
    {
      "section": "Hakkebøffer",
      "text": "Form farsen til 4 lige store bøffer, og krydr dem med salt og peber. Steg dem 2-3 minutter på hver side på samme pande som svampene og løgene. Tag dem af panden."
    },
    {
      "section": "Sauce",
      "text": "Hæld fond og kartoffelvand på panden. Skrab alt det brune fra bunden med en træspatel, så det koger ud i saucen, og rør godt rundt."
    },
    {
      "section": "Sauce",
      "text": "Smag til med fløde, worcestershiresauce og eventuelt mere peber. Tyk saucen med majsstivelsen, og rør lidt i ad gangen. Lad den koge godt igennem, og tilsæt eventuelt lidt sovsekulør efter smag."
    },
    {
      "section": null,
      "text": "Læg bøfferne tilbage i saucen, og top med løg og svampe. Server med agurkesalat og kartofler."
    }
  ],
