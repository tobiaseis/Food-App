  "steps": [
    {
      "section": "Pizzadej",
      "text": "Opløs gæren i vandet. Tilsæt hvedemel, olie og salt, og rør i nogle minutter, til dejen er glat og smidig."
    },
    {
      "section": "Pizzadej",
      "text": "Kom durummelet i lidt ad gangen, og ælt dejen grundigt igennem. Har du en røremaskine, kan den køre i 10-15 minutter."
    },
    {
      "section": "Pizzadej",
      "text": "Stil dejen til hævning i køleskabet i op til 18 timer."
    },
    {
      "section": "Kødboller",
      "text": "Bland alle ingredienserne til kødbollerne i en skål, og form farsen til små boller."
    },
    {
      "section": "Kødboller",
      "text": "Brun bollerne i få minutter i olie på en varm pande. Vend dem ofte."
    },
    {
      "section": "Pizzaen",
      "text": "Tænd ovnen på 250 °C, gerne med en pizzasten indeni."
    },
    {
      "section": "Pizzaen",
      "text": "Del dejen i to, og form to runde pizzabunde. Smør passata ud over dem, og top med mozzarella, kødboller og rødløgsringe."
    },
    {
      "section": "Pizzaen",
      "text": "Bag pizzaerne i 10-12 minutter, til bunden er sprød."
    },
    {
      "section": "Pizzaen",
      "text": "Strø timian over, før pizzaerne serveres."
    }
  ],
  "changes": [
    "Frisk mozzarella er skiftet til mozzarella.",
