  "steps": [
    {
      "section": "Sauce",
      "text": "Varm olien op på en stor pande, og blødgør løgene i den."
    },
    {
      "section": "Sauce",
      "text": "Tilsæt soltørrede tomater, hvidløg og chorizo. Rør rundt, til chorizoen er begyndt at smelte ud i panden."
    },
    {
      "section": "Sauce",
      "text": "Hæld hakkede tomater, fløde og sukker på panden, og bring det i et let kog. Smag til med salt og peber, og lad saucen simre på middel-lav varme."
    },
    {
      "section": "Pasta",
      "text": "Kog pastaen i let saltet vand, til den mangler 1-2 minutter i at være al dente. Tag et glas af kogevandet fra, inden du hælder vandet af."
    },
    {
      "section": "Pasta",
      "text": "Kom den varme pasta over i saucen, og vend det hele godt. Løsn saucen med lidt af kogevandet, til konsistensen passer."
    },
    {
      "section": "Pasta",
      "text": "Vend spinat og basilikum i, så de lige falder sammen."
    },
    {
      "section": "Servering",
      "text": "Anret pastaen på tallerkener med en halv burrata til hver. Top med parmesan, rucola og basilikumblade."
    }
  ],
  "changes": [
    "Nduja er erstattet med chorizo."
  ]
}
