  "steps": [
    {
      "section": "Krydret blomkål",
      "text": "Forvarm ovnen til 200 °C varmluft og klæd en bageplade med bagepapir."
    },
    {
      "section": "Krydret blomkål",
      "text": "Kom blomkålsbuketterne i en skål og vend dem først rundt i olien. Tilsæt begge slags paprika samt salt og peber, og vend igen, så krydderierne dækker jævnt."
    },
    {
      "section": "Krydret blomkål",
      "text": "Fordel blomkålen på bagepladen og bag den i 20-22 minutter."
    },
    {
      "section": "Mangosalsa",
      "text": "Bland mango, tomat, forårsløg, agurk og chili i en skål sammen med den hakkede koriander."
    },
    {
      "section": "Mangosalsa",
      "text": "Smag salsaen til med limesaft, limeskal, salt og peber."
    },
    {
      "section": "Server",
      "text": "Varm tortillaerne på en tør, varm pande eller i ovnen."
    },
    {
      "section": "Server",
      "text": "Fyld tortillaerne med blomkål, mangosalsa, spinat og avocado. Top med koriander og ristede sesamfrø, og server med limebåde til at presse over."
    }
  ],
