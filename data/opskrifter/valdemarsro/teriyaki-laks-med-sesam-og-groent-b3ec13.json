  "steps": [
    {
      "section": "Teriyakilaks",
      "text": "Sæt ovnen på 175 °C varmluft. Kog risene efter vejledningen på pakken."
    },
    {
      "section": "Teriyakilaks",
      "text": "Bland teriyakisauce, sojasauce, hvidløg, brun farin, ingefær, riseddike og sesamolie til en marinade."
    },
    {
      "section": "Teriyakilaks",
      "text": "Vend lakseternene og sesamfrøene i marinaden, og læg dem på en bageplade med bagepapir. Bag i ovnen i 7-10 minutter, til laksen er færdig."
    },
    {
      "section": "Stegt asiatisk kål",
      "text": "Pisk grøntsagsfond, karrypasta, sojasauce, hvidløg og ingefær sammen i en skål til en jævn sauce."
    },
    {
      "section": "Stegt asiatisk kål",
      "text": "Varm olien på en pande ved middelvarme. Steg gulerødder, spidskål og pak choi, til kålen er faldet sammen."
    },
    {
      "section": "Stegt asiatisk kål",
      "text": "Hæld saucen over grøntsagerne, og vend det hele godt. Smag til med et skvæt limesaft."
    },
    {
      "section": "Til servering",
      "text": "Anret laks, ris og grøntsager. Strø sesamfrø og hakket koriander eller persille over, og server med limebåde."
    }
  ],
