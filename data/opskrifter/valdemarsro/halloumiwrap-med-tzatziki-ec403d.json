  "steps": [
    {
      "section": "Syltede rødløg",
      "text": "Læg rødløgsringene i et rent, skoldet glas med låg."
    },
    {
      "section": "Syltede rødløg",
      "text": "Bring eddike, vand, sukker og peber i kog i en gryde, og rør, til sukkeret er opløst. Tilsæt evt. andre krydderier."
    },
    {
      "section": "Syltede rødløg",
      "text": "Hæld den varme lage over løgene, sæt låg på, og stil glasset koldt."
    },
    {
      "section": "Tzatziki",
      "text": "Del agurkerne på langs, og skrab kernehuset ud med en ske. Riv dem groft."
    },
    {
      "section": "Tzatziki",
      "text": "Vend den revne agurk med lidt salt, og lad den stå i 5-10 minutter. Hæld den derefter i en sigte, og pres alt vandet godt ud."
    },
    {
      "section": "Tzatziki",
      "text": "Bland agurken i yoghurten med hvidløg og olivenolie. Smag til med salt og peber."
    },
    {
      "section": "Servering",
      "text": "Skær halloumien i skiver. Skær tomater og agurk i passende stykker."
    },
    {
      "section": "Servering",
      "text": "Varm olien på en pande, og steg halloumien på begge sider, til den er gylden og sprød."
    },
    {
      "section": "Servering",
      "text": "Smør tzatziki på fladbrødene, og fordel tomat, agurk, rucola, syltede rødløg, oliven og halloumi ovenpå. Rul eller fold sammen."
    }
  ],
