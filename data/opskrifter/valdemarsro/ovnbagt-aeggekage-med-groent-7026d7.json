  "steps": [
    {
      "section": null,
      "text": "Smør et ovnfast fad. Læg broccoli, porre, spinat, kartofler og soltørrede tomater i fadet, og vend det sammen."
    },
    {
      "section": null,
      "text": "Pisk æg, creme fraiche og timian godt sammen i en skål. Krydr med salt og peber, og hæld blandingen over grøntsagerne."
    },
    {
      "section": null,
      "text": "Bag æggekagen midt i ovnen ved 175 °C varmluft i 30-45 minutter, til æggemassen er stivnet. Forvarm ovnen først."
    },
    {
      "section": null,
      "text": "Drys med purløg, og server æggekagen med rugbrød."
    }
  ],
