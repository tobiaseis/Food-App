  "steps": [
    {
      "section": "Pizzadej",
      "text": "Rør gæren ud i det stuetempererede vand i en skål."
    },
    {
      "section": "Pizzadej",
      "text": "Tilsæt en tredjedel af melet sammen med olien og saltet, og rør til en jævn masse. Rør resten af melet i lidt ad gangen."
    },
    {
      "section": "Pizzadej",
      "text": "Vend dejen ud på et meldrysset bord, og ælt den med hænderne, til den er smidig."
    },
    {
      "section": "Pizzadej",
      "text": "Pensl en ren skål med olie, læg dejen deri, og vend den, så den er olieret hele vejen rundt. Lad den hæve i 45 minutter ved stuetemperatur, og stil den derefter på køl til næste dag."
    },
    {
      "section": "Bolo",
      "text": "Brun baconen i olien i en tykbundet gryde ved middel varme. Løft den op, lad den dryppe af på køkkenrulle, og hak den fint."
    },
    {
      "section": "Bolo",
      "text": "Svits løg, hvidløg, timian og rosmarin i baconfedtet under omrøring, til løgene er møre."
    },
    {
      "section": "Bolo",
      "text": "Skru op for varmen, og brun det hakkede oksekød godt."
    },
    {
      "section": "Bolo",
      "text": "Hæld fond, soltørrede tomater, balsamico og hakkede tomater i gryden sammen med den hakkede bacon. Læg låg på, og lad det simre ved lav varme i cirka en time. Rør jævnligt."
    },
    {
      "section": "Bolo",
      "text": "Tag låget af, og lad saucen koge ind, til den er cremet og fyldig. Smag til med salt og peber. Stil den på køl til næste dag."
    },
    {
      "section": "Bagning",
      "text": "Næste dag: Varm ovnen op til 250 °C (over-/undervarme eller grill) med et bagestål på en rist."
    },
    {
      "section": "Bagning",
      "text": "Del dejen på et meldrysset bord, og form den til runde pizzaer."
    },
    {
      "section": "Bagning",
      "text": "Fordel bolo og mozzarella i store stykker over bundene. Bag pizzaerne på bagestålet i cirka 6-10 minutter, til bunden er sprød."
    },
    {
      "section": "Bagning",
      "text": "Riv parmesan over, og drys med frisk timian lige før servering."
    }
  ],
  "changes": [
    "Grøntsagsbouillon er skrevet som grøntsagsfond.",
    "Bagestål er bevaret, da der ikke er en nær erstatning."
  ]
