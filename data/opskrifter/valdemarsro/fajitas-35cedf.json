  "steps": [
    {
      "section": "Marinade",
      "text": "Bland limesaft, sukker, olie, krydderier og peber til en marinade."
    },
    {
      "section": "Marinade",
      "text": "Vend kylling, peberfrugt og løg i marinaden. Lad det trække i mindst 30 minutter, gerne helt op til et døgn."
    },
    {
      "section": "Fajitas",
      "text": "Hæld overskydende marinade fra og smid den ud."
    },
    {
      "section": "Fajitas",
      "text": "Sæt en pande på høj varme, til den er meget varm. Tilsæt olie, og læg de halve lime med snitfladen nedad på panden."
    },
    {
      "section": "Fajitas",
      "text": "Steg kylling, peberfrugt og løg i små portioner, så panden holder varmen og intet brænder på."
    },
    {
      "section": "Fajitas",
      "text": "Vend det hele hele tiden. Steg et par minutter, til kyllingen er gennemstegt, og grøntsagerne stadig er faste. Smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Anret fajitas med tortillas, avocado, koriander og sriracha. Pres saften fra de grillede lime ud over."
    }
