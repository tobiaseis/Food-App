  "steps": [
    {
      "section": "Kartoffelvafler",
      "text": "Vend de revne kartofler med lidt salt i en skål, og lad dem stå i 10 minutter."
    },
    {
      "section": "Kartoffelvafler",
      "text": "Hæld kartoflerne i en sigte, og pres så meget væske ud som muligt."
    },
    {
      "section": "Kartoffelvafler",
      "text": "Bland kartoflerne med løg, æg, hvedemel, rasp, ost, salt og peber i skålen."
    },
    {
      "section": "Kartoffelvafler",
      "text": "Pensl vaffeljernet med lidt af olien, og bag én vaffel ad gangen, til den er sprød og gyldden."
    },
    {
      "section": "Kartoffelvafler",
      "text": "Læg de færdige vafler på en rist, eller hold dem varme i ovnen, mens resten bages."
    },
    {
      "section": "Ovnbagte grøntsager",
      "text": "Forvarm ovnen til 200 °C varmluft, og smør et ovnfast fad."
    },
    {
      "section": "Ovnbagte grøntsager",
      "text": "Læg squash og aubergine i fadet. Rør olivenolie, hvidløg, rosmarin, salt og peber sammen, og vend det med grøntsagerne."
    },
    {
      "section": "Ovnbagte grøntsager",
      "text": "Bag grøntsagerne i 20-25 minutter."
    },
    {
      "section": "Servering",
      "text": "Anret de varme vafler med grøntsagerne og burrata. Dryp med olivenolie, og top med pinjekerner, persille, salt og peber."
    }
  ],
