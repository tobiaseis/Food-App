  "steps": [
    {
      "section": null,
      "text": "Varm en pande op med noget af olivenolien, og drys med salt. Brun brødskiverne i nogle minutter på hver side, til de er gyldne og sprøde."
    },
    {
      "section": null,
      "text": "Tag brødet af panden, og smør det med hvidløg, mens det er varmt. Lad det køle lidt af, og skær det derefter i tern på ca. 2 x 2 cm."
    },
    {
      "section": null,
      "text": "Læg brødterningerne i en stor skål sammen med agurk, tomater, peberfrugt, rødløg, sumak, persille og mynte."
    },
    {
      "section": null,
      "text": "Hæld resten af olivenolien over, og vend det hele godt. Smag til med citronsaft, citronskal, salt og peber."
    }
  ],
