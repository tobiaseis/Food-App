  "steps": [
    {
      "section": null,
      "text": "Varm en stor pande op, og lad smørret smelte, til det bruser."
    },
    {
      "section": null,
      "text": "Brun champignon og kantareller på panden, til de får en gylden skorpe."
    },
    {
      "section": null,
      "text": "Sænk varmen til middel. Put løg, hvidløg, timian og rosmarin på panden, og rør rundt, til løgene er møre."
    },
    {
      "section": null,
      "text": "Slå hvidvin og fond over svampene, og lad det simre ved lav varme i 10 minutter."
    },
    {
      "section": null,
      "text": "Kog pastaen i mellemtiden, så den er mør. Følg tiden på pakken."
    },
    {
      "section": null,
      "text": "Rør fløde, halvdelen af parmesanen og valnødderne ned i svampene, og lad saucen blive varm hele vejen igennem. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Vend pastaen i saucen. Server straks med resten af parmesanen og peber over."
    }
  ],
