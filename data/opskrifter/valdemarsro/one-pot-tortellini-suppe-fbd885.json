  "steps": [
    {
      "section": null,
      "text": "Varm olien i en stor gryde ved høj varme. Steg squashternene, til de har fået en gylden skorpe."
    },
    {
      "section": null,
      "text": "Sænk varmen, og svits løget, til det er blødt. Rør hvidløg, soltørrede tomater, spinat, basilikum og chiliflager i og lad det blive varmt igennem."
    },
    {
      "section": null,
      "text": "Hæld fond, hakkede tomater og fløde i gryden, og bring det i kog."
    },
    {
      "section": null,
      "text": "Kom tortellinien i, og lad suppen simre, så længe pakken angiver."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber, og rør parmesan i."
    },
    {
      "section": null,
      "text": "Øs suppen op i skåle. Pluk mozzarellaen i stykker, og fordel den over sammen med basilikumblade. Server med brød."
    }
  ],
