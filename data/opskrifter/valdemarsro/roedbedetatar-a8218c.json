  "steps": [
    {
      "section": "Rødbedetatar",
      "text": "Forvarm ovnen til 225 °C varmluft. Skrub de hele rødbeder rene og dup dem tørre."
    },
    {
      "section": "Rødbedetatar",
      "text": "Fordel lidt af saltet i et ovnfast fad, og læg rødbederne ovenpå. Dæk dem med det resterende salt."
    },
    {
      "section": "Rødbedetatar",
      "text": "Bag rødbederne i cirka 1 time, til de er møre."
    },
    {
      "section": "Rødbedetatar",
      "text": "Fjern skrællen fra de bagte rødbeder. Hak dem groft sammen med kapers og rødløg i en foodprocessor."
    },
    {
      "section": "Rødbedetatar",
      "text": "Kom blandingen i en skål, og smag til med eddike og peber. Vend de rå rødbedetern i, og smag igen."
    },
    {
      "section": "Peberrodscreme",
      "text": "Rør flødeost, creme fraiche og peberrod sammen til en jævn creme. Smag til med salt og peber."
    },
    {
      "section": "Anretning",
      "text": "Sæt en kagering på hver tallerken. Fyld først avocadoen i ringen, og tryk den flad."
    },
    {
      "section": "Anretning",
      "text": "Læg rødbedetataren ovenpå, og løft ringen af."
    },
    {
      "section": "Anretning",
      "text": "Top med en klat peberrodscreme og lidt hakket persille."
    }
  ],
  "changes": [
    "Kørvel er skiftet til persille."
  ]
