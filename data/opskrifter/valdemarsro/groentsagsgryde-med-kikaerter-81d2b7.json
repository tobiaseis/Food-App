  "steps": [
    {
      "section": null,
      "text": "Rist alle krydderierne i en varm, tør gryde under omrøring, til de dufter kraftigt."
    },
    {
      "section": null,
      "text": "Sænk varmen. Tilsæt olie, rødløg og hvidløg, og svits, til løgene er bløde."
    },
    {
      "section": null,
      "text": "Kom butternut squash, gulerødder, hakkede tomater og fond i gryden. Læg låg på, og lad det simre ved lav varme i 10 minutter."
    },
    {
      "section": null,
      "text": "Tilsæt broccoli og squash, og simre videre i 10 minutter."
    },
    {
      "section": null,
      "text": "Vend kikærterne i, og varm dem igennem. Smag til med citronsaft, salt og peber."
    },
    {
      "section": null,
      "text": "Anret i dybe tallerkener med creme fraiche og persille. Kog ris til, hvis I er ekstra sultne."
    }
  ],
