  "steps": [
    {
      "section": "Forberedelse",
      "text": "Pisk olie, eddike, røget paprika, salt og peber sammen til marinade."
    },
    {
      "section": "Forberedelse",
      "text": "Skær grøntsagerne som angivet i ingredienslisten, og pensl dem alle med marinaden."
    },
    {
      "section": "Indirekte varme",
      "text": "Læg majskolberne og det hele hvidløg i kanten af grillen, væk fra kullene, hvor der er lavest temperatur."
    },
    {
      "section": "Indirekte varme",
      "text": "Lad dem ligge i 30 minutter, til de er møre helt ind i midten."
    },
    {
      "section": "Direkte varme",
      "text": "Læg tomater, squash, peberfrugt, løg, aubergine, asparges og fennikel direkte over varmen, når majs og hvidløg er næsten færdige."
    },
    {
      "section": "Direkte varme",
      "text": "Grill grøntsagerne 3-5 minutter på hver side, til de har fået grillstriber og er let møre, men stadig har bid."
    }
  ],
