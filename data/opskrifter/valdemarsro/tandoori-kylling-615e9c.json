  "steps": [
    {
      "section": "Marinade",
      "text": "Pisk alle krydderierne sammen med yoghurt, citronsaft, olivenolie, hvidløg og tomatpuré i en skål."
    },
    {
      "section": "Kylling",
      "text": "Gnid kyllingelårene grundigt ind i marinaden. Løft skindet, og smør også marinade ind under det."
    },
    {
      "section": "Kylling",
      "text": "Stil kyllingen køligt og lad den marinere i 2-3 timer, eller lad den stå natten over."
    },
    {
      "section": "Kylling",
      "text": "Smør et ovnfast fad. Læg kyllingen i fadet med al marinaden, og bag den i 40-45 minutter ved 175 °C varmluft."
    },
    {
      "section": "Yoghurtdressing",
      "text": "Rør græsk yoghurt sammen med de hakkede krydderurter og hvidløg. Smag til med salt og peber."
    },
    {
      "section": "Tilbehør",
      "text": "Kog risene, som der står på posen."
    },
    {
      "section": "Tilbehør",
      "text": "Bring letsaltet vand i kog i en kasserolle. Kog broccolien med låg på i 1 minut, og hæld vandet fra."
    },
    {
      "section": null,
      "text": "Anret kyllingelårene med ris og broccoli. Server med yoghurtdressing, limebåde og korianderblade."
    }
  ],
  "changes": []
