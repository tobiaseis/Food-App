  "steps": [
    {
      "section": "Pastadej",
      "text": "Bland begge slags mel med saltet på en bordplade, og lav en lille brønd midt i melet."
    },
    {
      "section": "Pastadej",
      "text": "Slå æggene ud i brønden og tilsæt olien. Pisk dem forsigtigt sammen med en gaffel, så melet langsomt trækkes ind."
    },
    {
      "section": "Pastadej",
      "text": "Ælt dejen, til den er helt glat og elastisk. Er æggene små, kan der være brug for lidt ekstra mel."
    },
    {
      "section": "Pastadej",
      "text": "Læg dejen i en tæt beholder, og lad den hvile i køleskabet i mindst en time – gerne natten over."
    },
    {
      "section": "Fyld",
      "text": "Steg kantarellerne i smørret på en varm pande. Tag nogle få til side som pynt, og hak resten fint."
    },
    {
      "section": "Fyld",
      "text": "Rør de hakkede kantareller sammen med ricotta, persille, hvidløg og valnødder, til fyldet er ensartet. Smag til med salt og peber."
    },
    {
      "section": "Samling",
      "text": "Rul dejen tyndt ud med en pastamaskine eller en kagerulle på et meldrysset bord."
    },
    {
      "section": "Samling",
      "text": "Stik runde eller firkantede plader ud. Læg en tsk fyld midt på halvdelen af pladerne, og dæk med en ny plade."
    },
    {
      "section": "Samling",
      "text": "Tryk kanterne godt sammen med en gaffel eller en ravioliudstikker."
    },
    {
      "section": "Samling",
      "text": "Kog raviolierne i rigeligt saltet vand i 3 1/2 minut, og løft dem op med en hulske, så vandet løber fra."
    },
    {
      "section": "Gorgonzolasauce",
      "text": "Svits løget i olien i en gryde, til det er blødt."
    },
    {
      "section": "Gorgonzolasauce",
      "text": "Hæld fløden i, tilsæt gorgonzolaen, og rør, til osten er smeltet. Krydr med peber."
    },
    {
      "section": "Til servering",
      "text": "Anret de varme ravioli på tallerkener med saucen. Top med rucola, persille og de kantareller, du gemte."
    }
  ],
