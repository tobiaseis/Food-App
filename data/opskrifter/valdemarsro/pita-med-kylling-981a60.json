  "steps": [
    {
      "section": "Krydret kylling",
      "text": "Bland citronsaft og citronskal med begge slags paprika, hvidløg, olivenolie, salt og peber i en skål."
    },
    {
      "section": "Krydret kylling",
      "text": "Vend kyllingen i marinaden, og lad den stå og trække, mens du laver dressingen og skærer grøntsagerne."
    },
    {
      "section": "Parmesandressing",
      "text": "Rør creme fraiche, mayonnaise og parmesan sammen. Smag til med pesto, citronsaft, citronskal, salt og peber."
    },
    {
      "section": "Krydret kylling",
      "text": "Varm en pande op til middel varme med lidt olie, og steg kyllingen, til den er mør og gennemstegt."
    },
    {
      "section": "Servering",
      "text": "Varm pitabrødene i ovnen eller i brødristeren."
    },
    {
      "section": "Servering",
      "text": "Fyld pitabrødene med salat, rucola, tomat og agurk. Top med kyllingen og parmesandressingen."
    }
