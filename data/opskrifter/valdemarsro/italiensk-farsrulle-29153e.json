  "steps": [
    {
      "section": "Farsen",
      "text": "Kom alle ingredienserne til farsen i en skål, og ælt dem godt sammen i et par minutter."
    },
    {
      "section": "Farsen",
      "text": "Hæld en del af pankoraspen til rullen ud på et stykke bagepapir, og bred farsen ud i et fladt lag oven på."
    },
    {
      "section": "Fyld",
      "text": "Bland løg, hvidløg, soltørrede tomater, parmesan, oregano, rosmarin og citronskal i en skål. Smuldr blandingen godt ud."
    },
    {
      "section": "Samling",
      "text": "Drys fyldet over farsen, men lad en kant på cirka 5 cm være fri langs den ene side. Læg mozzarellaen ovenpå."
    },
    {
      "section": "Samling",
      "text": "Rul farsen sammen ved hjælp af bagepapiret, så den frie kant ender nederst som afslutning."
    },
    {
      "section": "Samling",
      "text": "Pensl rullen med lidt pisket æg, og drys resten af pankoraspen over. Tryk den let ind i farsen, så rullen får en pæn form."
    },
    {
      "section": "Bagning",
      "text": "Bag rullen midt i ovnen ved 180 °C varmluft i cirka 1 time. Ovnen skal være forvarmet."
    }
  ],
