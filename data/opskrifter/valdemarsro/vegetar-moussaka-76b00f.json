  "steps": [
    {
      "section": "Tomatsauce",
      "text": "Svits løg og hvidløg i olie i en gryde ved middelvarme, til løgene er blødt op."
    },
    {
      "section": "Tomatsauce",
      "text": "Hæld champignon i og brun dem ved høj varme, mens du rører rundt."
    },
    {
      "section": "Tomatsauce",
      "text": "Tilsæt hakkede tomater, soltørrede tomater, oregano, rosmarin, spidskommen og kanel. Rør rundt og lad saucen småkoge uden låg ved svag varme, til den er reduceret en smule. Smag til med salt og peber."
    },
    {
      "section": "Mornaysauce",
      "text": "Smelt smørret i en anden gryde ved lav varme. Pisk melet ned i smørret og tilsæt derefter mælken lidt ad gangen under konstant piskning."
    },
    {
      "section": "Mornaysauce",
      "text": "Bring saucen i kog og pisk, til den er glat og uden klumper. Tilsæt lidt ekstra mælk, hvis den bliver for tyk."
    },
    {
      "section": "Mornaysauce",
      "text": "Rør mozzarella i, til den er smeltet. Smag til med muskatnød, salt og peber."
    },
    {
      "section": "Samling",
      "text": "Forvarm ovnen til 180 °C varmluft. Steg aubergineskiverne i lidt olie på en pande, til de er bløde."
    },
    {
      "section": "Samling",
      "text": "Smør et ovnfast fad på 24 x 30 cm og dæk bunden med lidt mornaysauce."
    },
    {
      "section": "Samling",
      "text": "Læg tomatsauce, squash, aubergine og kartoffelskiver i skiftevise lag, så der bliver to lag i alt. Slut med resten af mornaysaucen øverst."
    },
    {
      "section": "Samling",
      "text": "Bag retten i ovnen i 30-45 minutter, til grøntsagerne er møre."
    }
  ],
  "changes": []
