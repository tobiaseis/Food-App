  "steps": [
    {
      "section": "BBQ-laks",
      "text": "Forvarm ovnen til 175 °C varmluft. Smør et ovnfast fad med smør."
    },
    {
      "section": "BBQ-laks",
      "text": "Fordel bønnerne i fadet, og strø sesamfrøene over. Læg laksen ovenpå."
    },
    {
      "section": "BBQ-laks",
      "text": "Rør olivenolie, honning, barbecuesauce, røget paprika, timian og det presssede hvidløg sammen til en glasur, og smag til med salt og peber. Pensl den over laksen."
    },
    {
      "section": "BBQ-laks",
      "text": "Bag fadet midt i ovnen i 12-15 minutter, til laksen er mør."
    },
    {
      "section": "Hvidløgsris med spinat",
      "text": "Varm olien i en gryde ved middel-lav varme, og svits hvidløget, til det dufter."
    },
    {
      "section": "Hvidløgsris med spinat",
      "text": "Tilsæt ris, vand og salt, og rør rundt. Sæt låg på, og bring langsomt i kog."
    },
    {
      "section": "Hvidløgsris med spinat",
      "text": "Lad risene koge under låg ved svag varme i 10 minutter. Tag gryden af varmen, og lad den stå med låg på i 10 minutter mere."
    },
    {
      "section": "Hvidløgsris med spinat",
      "text": "Vend spinaten i risene lige før servering."
    },
    {
      "section": null,
      "text": "Anret risene på tallerkener med bønner og laks ovenpå."
    }
  ],
