  "steps": [
    {
      "section": null,
      "text": "Kom lammekød, løg, hvidløg, mælk, fløde, æg, havregryn, timian, rosmarin og soltørrede tomater i en stor skål. Krydr med salt og peber, og pisk massen med håndmikser i 1-2 minutter."
    },
    {
      "section": null,
      "text": "Smuldr fetaen ud over farsen, og vend den sammen med olivenerne."
    },
    {
      "section": null,
      "text": "Tænd ovnen på 180 °C varmluft. Smør et ovnfast fad."
    },
    {
      "section": null,
      "text": "Form farsen som et aflangt brød, og læg det midt i fadet."
    },
    {
      "section": null,
      "text": "Vend kartoflerne i olie og salt, og læg dem langs begge sider af farsbrødet. De kan støtte brødet, så det holder formen."
    },
    {
      "section": null,
      "text": "Bag i ca. 45 minutter. Vend gerne kartoflerne et par gange undervejs."
    },
    {
      "section": null,
      "text": "Drys med frisk timian, inden retten serveres."
    }
  ],
  "changes": [
    "Finvalset havregryn er skiftet til almindelige havregryn."
  ]
