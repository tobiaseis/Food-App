  "steps": [
    {
      "section": "Stroganoff",
      "text": "Tør kyllinget。ernene let af med køkkenrulle."
    },
    {
      "section": "Stroganoff",
      "text": "Bland paprika, hvedemel, salt og peber, og vend kyllingen rundt i blandingen."
    },
    {
      "section": "Stroganoff",
      "text": "Brun baconen i en gryde med lidt olie ved middelvarme. Tag den op og lad den dryppe af på køkkenrulle."
    },
    {
      "section": "Stroganoff",
      "text": "Sæt varmen op, og brun champignonerne i baconfedtet, mens du rører. Tilsæt mere olie, hvis der er brug for det."
    },
    {
      "section": "Stroganoff",
      "text": "Kom kyllingen i gryden, når champignonerne har fået farve, og brun den på alle sider."
    },
    {
      "section": "Stroganoff",
      "text": "Tilsæt løg, tomatpuré, laurbærblade og baconen i mindre stykker. Hæld halvdelen af fonden over."
    },
    {
      "section": "Stroganoff",
      "text": "Læg låg på, og lad retten simre i 15 minutter. Hæld lidt mere fond i, hvis saucen bliver for tyk."
    },
    {
      "section": "Stroganoff",
      "text": "Rør fløden i til sidst, og smag til med salt og peber."
    },
    {
      "section": "Kartoffelmos",
      "text": "Kog kartoflerne møre i vand uden salt."
    },
    {
      "section": "Kartoffelmos",
      "text": "Mos dem med smørret, og pisk dem derefter med elpisker på laveste hastighed."
    },
    {
      "section": "Kartoffelmos",
      "text": "Hæld mælken i lidt ad gangen, til mosen er cremet og blød. Smag til med salt, peber og muskatnød."
    },
    {
      "section": "Kartoffelmos",
      "text": "Anret stroganoffen med kartoffelmos og drys med persille."
    }
  ],
