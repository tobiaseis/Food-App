  "steps": [
    {
      "section": null,
      "text": "Varm en tør gryde op, og rist kardemomme, spidskommen, koriander og lidt peber, til det dufter krydret."
    },
    {
      "section": null,
      "text": "Sæt varmen ned. Kom olie, kartofler, gulerødder, sødkartoffel, rødløg, chili, hvidløg og ingefær i gryden, og rør rundt i nogle minutter."
    },
    {
      "section": null,
      "text": "Hæld kokosmælken i, og rør det hele sammen. Læg låg på, og lad det simre ved svag varme i 20 minutter, til rodfrugterne er møre."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Anret med spinat, cashewnødder og creme fraiche. Server evt. med brød til."
    }
  ],
