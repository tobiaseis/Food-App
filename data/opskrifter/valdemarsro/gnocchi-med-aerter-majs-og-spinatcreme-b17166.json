  "steps": [
    {
      "section": null,
      "text": "Varm en stor pande op, og smelt smørret, til det er holdt op med at boble."
    },
    {
      "section": null,
      "text": "Steg gnocchi og majs, til de er gyldne og sprøde. Rør ofte undervejs. Tag gnocchi af panden og stil dem på en tallerken."
    },
    {
      "section": null,
      "text": "Blend bouillon og spinat, til spinaten er helt fin. Hæld blandingen på panden, og tilsæt flødeost, ost og hvidløg. Rør, til osten er smeltet, og saucen simrer."
    },
    {
      "section": null,
      "text": "Kom ærterne i, og varm dem godt igennem. Smag til med salt, peber, citronskal og en smule citronsaft."
    },
    {
      "section": null,
      "text": "Kom gnocchi tilbage på panden, og vend dem i saucen. Server med det sidste ost drysset over."
    }
  ],
