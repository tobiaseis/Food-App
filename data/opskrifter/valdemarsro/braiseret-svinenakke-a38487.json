  "steps": [
    {
      "section": "Braiseret nakkefilet",
      "text": "Smelt smørret i en gryde, og brun nakkefileten på alle sider. Læg den over på en tallerken."
    },
    {
      "section": "Braiseret nakkefilet",
      "text": "Svits løg, gulerødder, porre, hvidløg og peberkorn i samme gryde ved middelvarme, til løgene er bløde."
    },
    {
      "section": "Braiseret nakkefilet",
      "text": "Læg kødet tilbage i gryden, og kom laurbærblade, rosmarin, timian, æblemost og øl i. Læg låg på, og lad det simre ved lav varme i 1½-2 timer."
    },
    {
      "section": "Kartoffelmos",
      "text": "Kog kartoflerne møre i usaltet vand. Varm mælken i en kasserolle til cirka 50 °C."
    },
    {
      "section": "Kartoffelmos",
      "text": "Mos de varme kartofler groft sammen med smørret. Pisk dem derefter med håndmixer, og hæld imens mælken i lidt ad gangen, til moset er cremet, luftigt og blødt. Smag til med salt, peber og muskatnød."
    },
    {
      "section": "Til sidst i gryden",
      "text": "Løft kødet op, og si saucen over i en skål. Kassér grøntsagerne og krydderurterne fra braiseringen."
    },
    {
      "section": "Til sidst i gryden",
      "text": "Kom kød og sauce tilbage i gryden med de små gulerodstern og porreringene. Lad det simre i 10 minutter, og rør æble og smør i. Smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Anret kødet med sauce og kartoffelmos. Drys med frisk timian og persille."
    }
  ],
