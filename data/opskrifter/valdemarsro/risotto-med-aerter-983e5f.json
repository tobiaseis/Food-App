  "steps": [
    {
      "section": null,
      "text": "Pil ærterne ud af bælgene, mens risottoen koger."
    },
    {
      "section": null,
      "text": "Varm olie og smør op i en gryde. Svits løg og hvidløg, til løgene er bløde."
    },
    {
      "section": null,
      "text": "Tilsæt risene, hvidvinen og et par dl af fonden. Rør, til væden er trukket ind i risene."
    },
    {
      "section": null,
      "text": "Hæld resten af fonden i lidt ad gangen, og rør løbende, indtil risene er møre."
    },
    {
      "section": null,
      "text": "Rør parmesan, mynte, basilikum, revet citronskal og citronsaft i risottoen. Smag til med salt og peber, og tilsæt eventuelt mere citronsaft."
    },
    {
      "section": null,
      "text": "Tag gryden af varmen, og vend ærterne i."
    },
    {
      "section": null,
      "text": "Anret på tallerkener med ærtespirer, nogle af de friske ærter og lidt mynte ovenpå."
    }
  ],
