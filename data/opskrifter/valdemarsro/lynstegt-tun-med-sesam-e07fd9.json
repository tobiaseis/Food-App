  "steps": [
    {
      "section": null,
      "text": "Lad tunen ligge på køkkenbordet i 10 minutter, hvis den er frossen, så den tør lidt op."
    },
    {
      "section": null,
      "text": "Bland hvidløg, ingefær, teriyakisauce, fiskesauce, limesaft og sukker til en marinade. Lad den stå og trække, mens tunen steges."
    },
    {
      "section": null,
      "text": "Varm sesamolien op i en pande ved høj varme. Brun tunen i 1 ½ minut på hver side, og vend den, så alle fire sider får farve."
    },
    {
      "section": null,
      "text": "Tag tunen op på et skærebræt, og krydr med peber og salt. Lad den hvile i 30 sekunder."
    },
    {
      "section": null,
      "text": "Skær tunen i tynde skiver, og læg dem på et fad med rucola."
    },
    {
      "section": null,
      "text": "Hæld marinaden over, og strø purløg og sesamfrø ovenpå."
    }
