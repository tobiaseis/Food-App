  "steps": [
    {
      "section": "Croutoner",
      "text": "Skær rugbrødet i små tern, og bland dem med hvidløg, timian, salt og peber."
    },
    {
      "section": "Croutoner",
      "text": "Rist ternene sprøde på en varm pande i smeltet smør eller olie, og rør tit rundt. Du kan også blande dem med olie og bage dem i forvarmet ovn ved 175 °C varmluft i 15 minutter, til de er sprøde."
    },
    {
      "section": "Tuncreme og salat",
      "text": "Blend tun, creme fraiche og kapers i en foodprocessor til en glat creme."
    },
    {
      "section": "Tuncreme og salat",
      "text": "Vend cremen sammen med butterbeans. Læg feldsalat og rucola på et fad, og top med bønneblandingen."
    },
    {
      "section": "Tuncreme og salat",
      "text": "Fordel croutoner og kapersbær over salaten, og krydr til sidst med lidt salt og peber."
    }
