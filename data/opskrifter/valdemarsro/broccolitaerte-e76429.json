  "steps": [
    {
      "section": "Tærtedej",
      "text": "Bland begge slags mel med saltet i en skål. Smuldr det kolde smør i melet med fingrene, eller kør det i en foodprocessor."
    },
    {
      "section": "Tærtedej",
      "text": "Tilsæt vandet og æltes sammen til en dej. Lad den helst hvile på køl i 30 minutter."
    },
    {
      "section": "Tærtedej",
      "text": "Tryk dejen ud i en smurt tærteform på 24 cm i diameter. Prik bunden med en gaffel."
    },
    {
      "section": "Tærtedej",
      "text": "Forbag bunden midt i en forvarmet ovn ved 175 °C varmluft i 10 minutter."
    },
    {
      "section": "Tærtefyld",
      "text": "Steg baconen sprød på en pande. Tag den af varmen, lad den køle af, og hak den groft."
    },
    {
      "section": "Tærtefyld",
      "text": "Pisk æggene med creme fraiche og fløde, og krydr med salt og peber."
    },
    {
      "section": "Tærtefyld",
      "text": "Vend broccoli, bacon og ost i æggeblandingen. Hæld det i den forbagte bund."
    },
    {
      "section": "Tærtefyld",
      "text": "Bag tærten ved 175 °C varmluft i ca. 35 minutter, til den er fast og gylden. Pluk timianbladene og drys dem over inden servering."
    }
  ],
