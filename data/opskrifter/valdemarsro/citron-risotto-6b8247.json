  "steps": [
    {
      "section": "Risotto",
      "text": "Svits løg og hvidløg i en gryde, til løgene er blanke og bløde."
    },
    {
      "section": "Risotto",
      "text": "Vend risene med i gryden, og rør rundt, så de er dækket af fedtstoffet. Hæld hvidvinen over, og rør, til den er trukket helt ind."
    },
    {
      "section": "Risotto",
      "text": "Tilsæt bouillonen lidt ad gangen, og rør løbende. Fortsæt, til al bouillonen er optaget, og risene er møre."
    },
    {
      "section": "Risotto",
      "text": "Rør parmesan i risottoen. Smag til med citronskal, nogle få dråber citronsaft, salt og peber."
    },
    {
      "section": "Jomfruhummer",
      "text": "Bring vandet i kog i en stor gryde. Når det koger, kommer du citronsaft og citronskal, dild, cayennepeber, salt og peber i."
    },
    {
      "section": "Jomfruhummer",
      "text": "Læg hummerne i det varme vand. Hold vandet på 90 grader, og kontrollér med et termometer, så det ikke kommer i kog igen."
    },
    {
      "section": "Jomfruhummer",
      "text": "Hummerne er færdige, når de flyder op til overfladen. De skal højst have 1-2 minutter i vandet. Løft dem op med det samme, og lad dem dryppe af."
    },
    {
      "section": "Jomfruhummer",
      "text": "Skal hummerne vente, før de kommer på bordet, så tag dem op i samme øjeblik, de når overfladen, og stil dem væk fra varmen."
    },
    {
      "section": "Servering",
      "text": "Anret risottoen med de varme jomfruhummere, og drys med dild."
    }
  ],
