  "steps": [
    {
      "section": "Tærtedej",
      "text": "Bland de to slags mel med saltet. Smuldr det kolde smør i melet med fingrene, eller kør det sammen i en foodprocessor."
    },
    {
      "section": "Tærtedej",
      "text": "Tilsæt vandet og æltes sammen til en dej. Lad den helst hvile på køl i 30 minutter."
    },
    {
      "section": "Tærtedej",
      "text": "Tryk dejen ud i en smurt tærteform på 24 cm, så den dækker bund og kanter. Prik bunden med en gaffel."
    },
    {
      "section": "Tærtedej",
      "text": "Forvarm ovnen til 175 °C varmluft. Forbag bunden i 10 minutter."
    },
    {
      "section": "Fyld",
      "text": "Fordel porre, jordskokker, blomkål og spinat i den forbagte bund."
    },
    {
      "section": "Fyld",
      "text": "Pisk æg, hytteost og creme fraiche sammen i en skål med muskatnød, salt og peber. Hæld blandingen over grøntsagerne og drys med feta."
    },
    {
      "section": "Fyld",
      "text": "Bag tærten ved 175 °C varmluft i cirka 30-35 minutter, til æggemassen er stivnet."
    }
  ],
