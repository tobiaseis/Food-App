  "steps": [
    {
      "section": "Tærtedej",
      "text": "Bland de to slags mel med saltet i en skål. Smuldr smørret ud i melet med fingrene."
    },
    {
      "section": "Tærtedej",
      "text": "Æl dejen sammen med vandet, og stil den afdækket på køl i 30 minutter."
    },
    {
      "section": "Tærtedej",
      "text": "Rul dejen ud, og læg den i en smurt tærteform. Tryk den ind til kanten."
    },
    {
      "section": "Tærtedej",
      "text": "Prik bunden med en gaffel. Forbag den i en forvarmet ovn ved 175 °C varmluft i 10 minutter."
    },
    {
      "section": "Fyld",
      "text": "Steg baconen på en pande, til den er sprød. Tag den af panden."
    },
    {
      "section": "Fyld",
      "text": "Vend porrerne rundt i baconfedtet ved middelvarme, til de er møre. Har du ikke fedt nok, så brug olivenolie."
    },
    {
      "section": "Fyld",
      "text": "Rør æg, mælk, muskatnød og peber sammen i en skål, og vend bacon og porrer i. Smag til med salt."
    },
    {
      "section": "Fyld",
      "text": "Hæld fyldet i den forbagte tærtebund."
    },
    {
      "section": "Fyld",
      "text": "Bag tærten i ovnen ved 175 °C varmluft i cirka 25-30 minutter, til æggemassen er stivnet."
    }
