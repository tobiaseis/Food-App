  "steps": [
    {
      "section": "Bulgur og kylling",
      "text": "Kog bulgur, som der står på pakken."
    },
    {
      "section": "Bulgur og kylling",
      "text": "Pisk ægget i en dyb tallerken. Bland pankorasp med salt og peber i en anden."
    },
    {
      "section": "Bulgur og kylling",
      "text": "Vend hver kyllingefilet i ægget og derefter i rasp, så den er dækket hele vejen rundt."
    },
    {
      "section": "Bulgur og kylling",
      "text": "Varm olien op på en pande ved middelvarme. Steg filetterne 4-5 minutter på hver side, til de er helt gennemstegte. Skær dem i skiver."
    },
    {
      "section": "Dressing",
      "text": "Rør alle ingredienserne til dressingen sammen, og smag den til med salt og peber."
    },
    {
      "section": "Salat",
      "text": "Kom broccolibuketterne i en gryde med kogende vand. Læg låg på, og lad dem koge i 2 minutter, så de er lidt møre, men stadig har bid."
    },
    {
      "section": "Salat",
      "text": "Tilsæt edamamebønnerne, rør rundt, og lad dem stå i 1 minut. Si vandet fra."
    },
    {
      "section": "Salat",
      "text": "Vend broccoli, edamamebønner og bulgur med dressingen. Bland spinat, rucola og rødløg i."
    },
    {
      "section": "Salat",
      "text": "Anret salaten på tallerkener, og læg den sprøde kylling ovenpå."
    }
  ],
