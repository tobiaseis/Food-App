  "steps": [
    {
      "section": null,
      "text": "Rør majsstivelsen ud i fløden, og stil det til side."
    },
    {
      "section": null,
      "text": "Varm en pande godt op, og hæld olie på. Steg champignonskiverne ved høj varme under omrøring, til de er pænt brunede."
    },
    {
      "section": null,
      "text": "Sænk til middelvarme. Kom smør, de blandede svampe og løget på panden, og svits under omrøring, til løget er blødt."
    },
    {
      "section": null,
      "text": "Tilsæt squash, bouillon og fløde med majsstivelse. Lad det simre, til saucen er reduceret lidt og cremet. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Fyld de lune tarteletter med svampesaucen. Pynt med persille og friskkværnet peber."
