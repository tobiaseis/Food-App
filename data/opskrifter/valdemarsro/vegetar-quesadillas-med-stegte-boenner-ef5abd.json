  "steps": [
    {
      "section": null,
      "text": "Varm olien i en gryde, og svits løget, til det er blødt."
    },
    {
      "section": null,
      "text": "Rør hvidløg, chiliflager, spidskommen, oregano, sorte bønner og hakkede tomater i gryden, og lad det gennemvarme under omrøring i et par minutter."
    },
    {
      "section": null,
      "text": "Lad blandingen simre og koge lidt ind. Blend den kort med stavblender, så bønnerne bliver groft moste. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Smør bønnemosen ud på den ene halvdel af hver tortilla. Top med cheddar, spinat og koriander, og fold tortillaen sammen."
    },
    {
      "section": null,
      "text": "Varm lidt olie på en pande, og steg quesadillaerne gyldne og sprøde i 2-3 minutter på hver side. Server med det samme."
    }
  ],
