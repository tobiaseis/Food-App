  "steps": [
    {
      "section": null,
      "text": "Rist alle de stødte krydderier i en tør gryde ved god varme, indtil de dufter kraftigt."
    },
    {
      "section": null,
      "text": "Sænk varmen lidt. Tilsæt olien, løg, hvidløg og ingefær, og svits, til løgene er blændet."
    },
    {
      "section": null,
      "text": "Skyl linserne i en sigte, og kom dem i gryden med fond, hakkede tomater og kokosmælk."
    },
    {
      "section": null,
      "text": "Læg låg på, og lad gryden simre i 30 minutter. Rør i den en gang imellem."
    },
    {
      "section": null,
      "text": "Bland kikærter, squash og peberfrugt i, og lad det koge med i ca. 10 minutter, til alt er varmt og grøntsagerne er møre."
    },
    {
      "section": null,
      "text": "Krydr med salt og peber."
    },
    {
      "section": null,
      "text": "Kog risene efter anvisningen på pakken."
    },
    {
      "section": null,
      "text": "Anret gryden over risene, og drys med persille."
    }
  ],
