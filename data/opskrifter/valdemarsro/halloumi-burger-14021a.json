  "steps": [
    {
      "section": "Rødløgene",
      "text": "Varm olien i en gryde over middel varme, og lad smørret smelte og boble af. Skru lidt ned, og rør løgringene rundt i fedtstoffet i et par minutter."
    },
    {
      "section": "Rødløgene",
      "text": "Læg låg på, og lad løgene simre svagt ved lav varme i 10-15 minutter, til de er bløde, søde og let karamelliserede, men ikke brune. Krydr med timian, salt og peber."
    },
    {
      "section": "Chilimayo",
      "text": "Rør mayonnaise og sriracha sammen, og smag til med salt og peber."
    },
    {
      "section": "Burgerne",
      "text": "Varm burgerbollerne igennem i ovnen eller på grillen."
    },
    {
      "section": "Burgerne",
      "text": "Skær halloumien i skiver, og steg dem i olie på en pande, til de har fået en flot gylden skorpe."
    },
    {
      "section": "Burgerne",
      "text": "Smør bollerne med chilimayo. Læg avocado, salat, basilikum, de bløde rødløg, agurk og halloumi i, og luk burgeren."
    }
  ],
