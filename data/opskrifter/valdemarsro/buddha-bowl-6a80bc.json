  "steps": [
    {
      "section": null,
      "text": "Sæt risene over og kog dem efter anvisningen på pakken. Forbered kikærter, dressing og grøntsager, mens de koger."
    },
    {
      "section": "Ristede kikærter",
      "text": "Dræn kikærterne og vend dem med olivenolie, røget paprika og flagesalt. Fordel dem på en plade med bagepapir."
    },
    {
      "section": "Ristede kikærter",
      "text": "Bag kikærterne midt i en forvarmet ovn ved 175 °C varmluft i 20-25 minutter. Vend dem et par gange undervejs."
    },
    {
      "section": "Bagte grøntsager",
      "text": "Vend sødkartoffel, squash, cherrytomater og rødløg med olivenolie og salt. Læg dem på en bageplade med bagepapir."
    },
    {
      "section": "Bagte grøntsager",
      "text": "Bag grøntsagerne i en forvarmet ovn ved 175 °C varmluft i 20-25 minutter."
    },
    {
      "section": null,
      "text": "Læg edamamebønnerne i en skål, og dæk dem med kogende vand. Lad dem stå et øjeblik, og hæld vandet fra."
    },
    {
      "section": "Tahindressing",
      "text": "Rør tahin, hvidløg, citronsaft og spidskommen sammen i en skål med salt og peber. Tilsæt vandet lidt ad gangen, og rør, til dressingen er ensartet og tyndtflydende."
    },
    {
      "section": null,
      "text": "Fordel de bagte grøntsager, edamamebønner, sorte bønner, ris, avocado, rucola og ristede kikærter i fire skåle."
    },
    {
      "section": null,
      "text": "Læg en skefuld hummus midt i hver skål. Drys med sesamfrø og mynte, og server tahindressingen ved siden af."
    }
  ],
  "changes": []
