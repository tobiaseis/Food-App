  "steps": [
    {
      "section": null,
      "text": "Varm olien i en gryde ved middelvarme. Svits løg og hvidløg, indtil løgene er bløde."
    },
    {
      "section": null,
      "text": "Kom rugkerner, hvidvin og halvdelen af fonden i gryden, og rør rundt. Læg låg på, og lad det simre ved middel-lav varme i 15 minutter."
    },
    {
      "section": null,
      "text": "Hæld den resterende fond i, og rør igen. Lad kernerne trække al væden til sig."
    },
    {
      "section": null,
      "text": "Smelt smørret på en varm pande, til det bruser. Brun champignonerne ved høj varme, til de har fået en flot gylden skorpe."
    },
    {
      "section": null,
      "text": "Kom kantareller og græskarkerner på panden, og steg dem et minuts tid. Smag til med lidt salt, og tag panden af varmen."
    },
    {
      "section": null,
      "text": "Vend parmesan og halvdelen af svampene i rugotton, og smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Anret i dybe tallerkener. Top med resten af svampene og græskarkernerne, og drys med persille."
    }
  ],
