  "steps": [
    {
      "section": "Dressing",
      "text": "Læg hytteost, avocado, citronskal, dild og purløg i en blender. Tilsæt kun lidt citronsaft i starten."
    },
    {
      "section": "Dressing",
      "text": "Blend, til dressingen er helt glat og cremet. Smag til med salt, peber og mere citronsaft."
    },
    {
      "section": "Salat",
      "text": "Kog perlebyggen som angivet på posen. Hæld den i en sigte, og lad den køle helt af."
    },
    {
      "section": "Salat",
      "text": "Bland rucola, feldsalat, agurk og byg i en skål, og anret på et fad eller på tallerkener."
    },
    {
      "section": "Anretning",
      "text": "Del makrellen i passende stykker, og læg dem på salaten. Hæld dressingen ud over."
    },
    {
      "section": "Anretning",
      "text": "Strø hampefrø, salt og peber over, og server med brødet ved siden af."
    }
