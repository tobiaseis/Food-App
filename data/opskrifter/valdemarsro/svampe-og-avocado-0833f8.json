  "steps": [
    {
      "section": "Svampe",
      "text": "Varm en pande godt op. Steg svampene i smørret under konstant omrøring, til de er brunede og har fået en fin skorpe."
    },
    {
      "section": "Svampe",
      "text": "Hæld fløden på panden, og lad den koge ind og bruse af. Tag panden af varmen, og smag til med salt og peber."
    },
    {
      "section": "Avocadomos",
      "text": "Mos avocadoerne groft med en gaffel. Smag til med citronsaft, paprika, salt og peber."
    },
    {
      "section": "Pocherede æg",
      "text": "Bring en gryde vand i kog. Slå imens hvert æg ud i en lille skål."
    },
    {
      "section": "Pocherede æg",
      "text": "Skru ned for varmen, og rør eddiken i vandet. Lav en hvirvel med en ske eller en piskeris, så der opstår et hul midt i gryden."
    },
    {
      "section": "Pocherede æg",
      "text": "Lad et æg glide ned i midten af hvirvlen, og skru op for varmen igen. Pochér ægget i ca. 2 minutter, og løft det op med en hulske. Gentag med de øvrige æg."
    },
    {
      "section": "Til servering",
      "text": "Smør avocadomos på det ristede brød, og læg svampe og et pocheret æg ovenpå. Strø med persille, og krydr med lidt salt og peber."
    }
  ],
