  "steps": [
    {
      "section": "Kødsauce",
      "text": "Svits løg og hvidløg i olivenolien i en stor gryde, til løgene er bløde."
    },
    {
      "section": "Kødsauce",
      "text": "Tilsæt hakkekødet, og brun det ved høj varme."
    },
    {
      "section": "Kødsauce",
      "text": "Sænk varmen, og kom de resterende ingredienser til saucen i gryden."
    },
    {
      "section": "Kødsauce",
      "text": "Lad saucen simre med låg i 2-6 timer – jo længere, jo bedre. Smag den undervejs til med mere krydderi, tomatpuré, hakkede tomater, salt og peber."
    },
    {
      "section": "Kødsauce",
      "text": "Bliver saucen for tør, så tilsæt lidt grøntsagsfond. Vent dog til den har simret cirka en time, for grøntsagerne afgiver selv meget væde."
    },
    {
      "section": "Mornaysauce",
      "text": "Smelt smørret i en gryde, og pisk melet i, til det samler sig til en klump."
    },
    {
      "section": "Mornaysauce",
      "text": "Pisk mælken i lidt ad gangen, til saucen har en jævn, cremet konsistens."
    },
    {
      "section": "Mornaysauce",
      "text": "Smag til med muskatnød, salt og peber."
    },
    {
      "section": "Samling",
      "text": "Forvarm ovnen til 175 °C varmluft. Smør et ovnfast fad."
    },
    {
      "section": "Samling",
      "text": "Hæld et lag mornaysauce i bunden af fadet. Læg derefter kødsauce og lasagneplader i skiftevis lag, og slut med kødsauce."
    },
    {
      "section": "Samling",
      "text": "Dæk med et lag mornaysauce, og fordel mozzarellaskiverne ovenpå."
    },
    {
      "section": "Samling",
      "text": "Bag lasagnen i 20-25 minutter, til pladerne er møre, men stadig har lidt bid."
    }
  ],
  "changes": [
