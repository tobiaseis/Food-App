  "steps": [
    {
      "section": "Tomatsalsa",
      "text": "Rør tomater, sukker, hvidløg, skalotteløg, basilikum og olivenolie sammen, og smag til med salt og peber. Lad gerne salsaen stå cirka 30 minutter, så smagene når at trække."
    },
    {
      "section": "Tomatsalsa",
      "text": "Tryk en gaffel et par gange ned i blandingen, så tomaterne giver saft, og den ligner en salsa mere end en tomatsalat."
    },
    {
      "section": "Guacamole",
      "text": "Mos avocadoerne med en gaffel. Rør dem sammen med de øvrige ingredienser til guacamolen, og blend med stavblender, til den er glat og cremet."
    },
    {
      "section": "Guacamole",
      "text": "Vil du have en grovere guacamole, så hak alle ingredienserne helt fint og rør dem sammen i en skål i stedet."
    },
    {
      "section": "Guacamole",
      "text": "Smag til med salt, peber, cayennepeber og citronsaft. Stil den gerne på køl i 30 minutter inden servering."
    },
    {
      "section": "Taquitos",
      "text": "Steg oksekødet på en varm pande med lidt af olien under jævnlig omrøring, til det er gennemstegt."
    },
    {
      "section": "Taquitos",
      "text": "Kom majs, løg, oregano, paprika og jalapenos på panden. Skru ned til middelvarme, og lad det simre et par minutter."
    },
    {
      "section": "Taquitos",
      "text": "Tag panden af varmen. Rør flødeost og tomatpuré grundigt ind i fyldet, og smag til med salt og peber."
    },
    {
      "section": "Taquitos",
      "text": "Varm tortillaerne på en pande, til de er bløde og smidige. Gnid dem med olie på begge sider."
    },
    {
      "section": "Taquitos",
      "text": "Fordel fyld og revet cheddar i en stribe midt på hver tortilla. Fold enderne ind, og rul tortillaen stramt sammen."
    },
    {
      "section": "Taquitos",
      "text": "Læg rullerne med samlingen nedad på en bageplade med bagepapir."
    },
    {
      "section": "Taquitos",
      "text": "Bag dem i forvarmet ovn ved 225 °C varmluft i 5-7 minutter. Vend dem en halv omgang, og bag yderligere 5 minutter, til osten er smeltet, og rullerne er sprøde. Server med salsa og guacamole."
    }
  ],
