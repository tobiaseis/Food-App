  "steps": [
    {
      "section": "Dressing",
      "text": "Bland alle dressingens ingredienser, og stil den til side i cirka en halv time, så smagene kan blande sig."
    },
    {
      "section": "Kylling",
      "text": "Brug en skarp kniv til at lave små snit i skindet på kyllingen. Krydr med salt og peber."
    },
    {
      "section": "Kylling",
      "text": "Læg kyllingen med skindsiden nedad på en pande, og steg den ved lav til middelvarme i 30 minutter, til skindet er sprødt."
    },
    {
      "section": "Kylling",
      "text": "Vend kyllingen, og steg den cirka 5 minutter på den anden side, til den er gennemstegt. Skær den i strimler."
    },
    {
      "section": "Salat",
      "text": "Kom salatblanding, rødløg og rucola i en stor skål. Vend det med dressingen sammen med mynte, koriander og den skivede chili."
    },
    {
      "section": "Servering",
      "text": "Læg den lune kylling ovenpå salaten. Top med sesamfrø og friskkværnet peber, og server med det samme."
    }
