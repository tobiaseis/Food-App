  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en gryde, og svits løget, indtil det er blødt."
    },
    {
      "section": null,
      "text": "Skyl bygkernerne i en sigte. Kom dem i gryden sammen med hvidvinen, halvdelen af kyllingefonden og al grøntsagsfonden."
    },
    {
      "section": null,
      "text": "Bring det i kog under omrøring. Lad det så småkoge, til bygget har optaget næsten al væsken."
    },
    {
      "section": null,
      "text": "Hæld resten af væsken i lidt ad gangen, og rør jævnligt. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Tag gryden af varmen, når bygget er mørt, men stadig har lidt bid."
    },
    {
      "section": null,
      "text": "Pluk den røgede laks i store stykker, og vend den i risottoen sammen med parmesan."
    },
    {
      "section": null,
      "text": "Hak persillen, og strø den over lige før servering."
    }
  ],
