  "steps": [
    {
      "section": "Ris med ingefær",
      "text": "Varm sesamolie og ingefær i en gryde ved lav varme, til det begynder at dufte. Ingefæren må ikke få farve."
    },
    {
      "section": "Ris med ingefær",
      "text": "Hæld vand, ris og salt i gryden, og rør rundt. Sæt låg på, og bring det langsomt i kog."
    },
    {
      "section": "Ris med ingefær",
      "text": "Lad risene simre under låg ved svag varme i 10 minutter. Tag gryden af varmen, og lad risene trække med låg på i yderligere 10 minutter."
    },
    {
      "section": "Mørbrad med lime og ingefær",
      "text": "Bland ingefær og limesaft til en jævn marinade. Vend kødet i marinaden, og lad det stå køligt i mindst 30 minutter eller natten over."
    },
    {
      "section": "Mørbrad med lime og ingefær",
      "text": "Hæld olie på en varm pande, og brun kødet ved høj varme, mens du rører rundt. Sænk til medium-lav varme, og steg kødet færdigt."
    },
    {
      "section": "Mørbrad med lime og ingefær",
      "text": "Kom squash og pak choi på panden, og lad dem blive varme."
    },
    {
      "section": "Mørbrad med lime og ingefær",
      "text": "Bland hoisinsauce og hvidløg, og hæld blandingen over kødet og grøntsagerne på panden."
    },
    {
      "section": "Til servering",
      "text": "Fordel risene på tallerkener, og læg kød, grøntsager og sauce fra panden ovenpå. Drys med koriander, sesamfrø og peanuts, og server med limekvarte til at presse over."
    }
  ],
  "changes": [
