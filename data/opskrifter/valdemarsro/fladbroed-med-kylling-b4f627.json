  "steps": [
    {
      "section": "Haydari",
      "text": "Sæt ovnen på 175 °C. Del peberfrugten på langs, og skær stilk og kerner væk."
    },
    {
      "section": "Haydari",
      "text": "Læg halvdelene med skindsiden opad på en bageplade med bagepapir. Bag dem i ca. 20 minutter, til skindet er mørkt. Hold øje med dem – det går langsomt i starten og så pludselig hurtigt."
    },
    {
      "section": "Haydari",
      "text": "Tag peberfrugten ud, og læg den, mens den stadig er godt lun, i en frysepose. Luk posen, og lad den hvile i ca. en halv time. Træk derefter skindet af."
    },
    {
      "section": "Haydari",
      "text": "Blend peberfrugten med feta, persille, begge slags paprika, cayennepeber og hvidløg, til det er cremet. Smag til, og tilsæt lidt olivenolie, hvis der er brug for det."
    },
    {
      "section": "Kyllingeboller",
      "text": "Ælt hakket kylling sammen med forårsløg, koriander, ingefær, hvidløg, salt og peber."
    },
    {
      "section": "Kyllingeboller",
      "text": "Rul farsen til små boller. Brun dem i olie på en pande i 7-8 minutter, og vend dem ofte, så de bliver runde."
    },
    {
      "section": "Kyllingeboller",
      "text": "Kontrollér, at bollerne er gennemstegte. Drys brun farin og sesamfrø på panden, og vend bollerne rundt, til de er blanke og glaserede."
    },
    {
      "section": "Til servering",
      "text": "Smør haydari ud på fladbrødene. Læg kyllingeboller, salat, agurk og avocado ovenpå, og pynt med mynte og persille."
    }
  ],
