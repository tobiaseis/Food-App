  "steps": [
    {
      "section": "Kokosris",
      "text": "Varm sesamolie og ingefær op i en gryde ved lav varme, til det dufter let. Ingefæren må ikke blive brun."
    },
    {
      "section": "Kokosris",
      "text": "Hæld kokosmælk og vand i gryden, og rør ris og salt i. Læg låg på, og varm langsomt op til det småkoger."
    },
    {
      "section": "Kokosris",
      "text": "Lad risen simre under låg ved svag varme i 10 minutter. Tag gryden af varmen, og lad risen trække under låg i 10 minutter mere."
    },
    {
      "section": "Fiskekager",
      "text": "Ælt alle ingredienser til fiskekagerne sammen i en stor skål, til farsen er fast og ensartet."
    },
    {
      "section": "Fiskekager",
      "text": "Form farsen til små kager. Steg dem i olie på en varm pande ved middelvarme i 5 minutter på hver side, til de er sprøde og gennemstegte."
    },
    {
      "section": "Hvidløgstegte grøntsager",
      "text": "Steg gulerødder og squash i olie ved middelhøj varme i nogle minutter, til squashen får en gylden skorpe."
    },
    {
      "section": "Hvidløgstegte grøntsager",
      "text": "Tilsæt pak choi og hvidløg, og rør rundt i ca. 1 minut. Krydr med soja og peber."
    },
    {
      "section": "Asiatisk mayo",
      "text": "Rør mayonnaisen sammen med fiskesauce og lidt hvidløg og ingefær. Smag til med limeskal og peber."
    },
    {
      "section": "Servering",
      "text": "Anret ris, grøntsager og fiskekager på tallerkener med mayonnaisen ved siden af. Strø sesamfrø og persille over."
    }
  ],
