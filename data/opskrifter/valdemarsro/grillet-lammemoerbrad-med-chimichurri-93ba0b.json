  "steps": [
    {
      "section": "Chimichurri",
      "text": "Bland hvidløg, chiliflager, oregano, persille, mynte, citronskal og en smule citronsaft i en skål."
    },
    {
      "section": "Chimichurri",
      "text": "Rør olien i, til saucen har en god konsistens. Smag til med mere citronsaft, salt og peber."
    },
    {
      "section": "Lammet",
      "text": "Få grillen rigtig varm, og pensl risten let med olie."
    },
    {
      "section": "Lammet",
      "text": "Krydr mørbradene med salt og peber, og pensl dem med en smule af chimichurrien."
    },
    {
      "section": "Lammet",
      "text": "Grill kødet ca. 3 minutter på hver side, til det har fået pæne grillstriber."
    },
    {
      "section": "Lammet",
      "text": "Lad mørbradene hvile i 10 minutter, og skær dem derefter i tynde skiver."
    },
    {
      "section": "Lammet",
      "text": "Læg skiverne på et fad, og hæld resten af chimichurrien over lige før servering."
    }
  ],
