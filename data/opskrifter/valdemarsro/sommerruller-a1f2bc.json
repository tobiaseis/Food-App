  "steps": [
    {
      "section": "Peanutdip",
      "text": "Pisk alle ingredienserne til dippen sammen. Tynd den ud med lidt ekstra kokosmælk, hvis den er for tyk, og smag den til."
    },
    {
      "section": "Fyld",
      "text": "Skær halloumien i skiver og derefter i stave. Brun dem i olie på en pande, til de er gyldne og sprøde."
    },
    {
      "section": "Fyld",
      "text": "Skyl og snit de øvrige grøntsager, urter og bær, så de er klar til at lægge i."
    },
    {
      "section": "Rulning",
      "text": "Fyld et stort fad med vand. Dyp ét rispapir ad gangen, til det er blødt, og læg det fladt på bordet."
    },
    {
      "section": "Rulning",
      "text": "Læg grøntsager, bær og halloumi i en stribe midt på papiret. Slå siderne ind over fyldet, og rul det stramt sammen."
    },
    {
      "section": "Rulning",
      "text": "Gentag med resten af papirerne."
    },
    {
      "section": "Servering",
      "text": "Anret ruller og peanutdip sammen. Server eventuelt overskydende grønt ved siden af."
    }
  ],
