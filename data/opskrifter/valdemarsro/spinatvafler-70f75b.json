  "steps": [
    {
      "section": null,
      "text": "Bland begge slags mel og bagepulver i en skål."
    },
    {
      "section": null,
      "text": "Skyl spinaten omhyggeligt. Kom den i en blender med æg, mælk, salt, peber og melblandingen."
    },
    {
      "section": null,
      "text": "Blend, til dejen er glat og tyndtflydende. Lad den helst stå 15-30 minutter, så melet suger væde og dejen bliver lidt tykkere."
    },
    {
      "section": null,
      "text": "Smør vaffeljernet let. Bag vaflerne, til de er gyldne og helt færdige i midten."
