  "steps": [
    {
      "section": null,
      "text": "Skyl speltkernerne i en sigte, og kom dem i en gryde med hvidvinen og halvdelen af grøntsagsfonden."
    },
    {
      "section": null,
      "text": "Bring det i kog under omrøring, og skru ned, så det simrer. Rør jævnligt, og hæld mere fond på, efterhånden som væsken forsvinder."
    },
    {
      "section": null,
      "text": "Smag på kernerne. Når de er møre, men stadig har lidt bid, tag da gryden af varmen."
    },
    {
      "section": null,
      "text": "Rør den friskrevne parmesan i. Smag til med citronsaft, noget af den fintrevne citronskal, salt og peber."
    },
    {
      "section": null,
      "text": "Vend to tredjedele af ærterne i."
    },
    {
      "section": null,
      "text": "Server toppet med de resterende ærter, parmesanflagerne og resten af citronskallen."
    }
  ],
  "changes": [
    "Friske ærter er byttet ud med ærter uden angivelse af frisk er bevaret som i kilden."
