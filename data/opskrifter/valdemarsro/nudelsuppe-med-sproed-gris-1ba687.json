  "steps": [
    {
      "section": "Chili-ingefærolie",
      "text": "Læg sesamolie, hvidløg, ingefær, chili og peber i en gryde. Opvarm det stille og roligt, til det lige akkurat simrer. Hvidløget må ikke blive brunt."
    },
    {
      "section": "Chili-ingefærolie",
      "text": "Lad olien trække på middel varme i 3-4 minutter. Tag gryden af varmen, og lad olien køle helt ned. Hæld den derefter i en lille skål."
    },
    {
      "section": "Sprød gris",
      "text": "Hæld sesamolien på en stor pande, og varm den op på den højeste varme. Rør svinekødet rundt i panden sammen med five spice og lidt peber, til det er godt brunet."
    },
    {
      "section": "Sprød gris",
      "text": "Tilsæt brun farin og sojasauce. Fortsæt med at stege, til kødet er karamelliseret og sprødt."
    },
    {
      "section": "Nudelsuppe",
      "text": "Bring fond, hvidløg, ingefær og fiskesauce i kog i en gryde."
    },
    {
      "section": "Nudelsuppe",
      "text": "Kom broccoli, spinat og nudler i gryden. Lad det koge, til nudlerne er helt møre."
    },
    {
      "section": "Servering",
      "text": "Øs suppen op i skåle med både nudler og grønt. Læg det sprøde svinekød ovenpå, og drys med chili-ingefærolie efter smag. Slut af med forårsløg og sesamfrø."
    }
  ],
  "changes": [
    "Sichuanpeber er skiftet til sort peber.",
    "Chiliflager er skiftet til chili."
  ]
}
