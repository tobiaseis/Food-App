  "steps": [
    {
      "section": "Enchiladasauce",
      "text": "Varm alle krydderierne i en tør gryde, til de dufter. Tilsæt olie, hvidløg og løg, og svits, til løgene er bløde."
    },
    {
      "section": "Enchiladasauce",
      "text": "Rør melet ind, og hæld bouillon og hakkede tomater i. Lad saucen simre uden låg i 15 minutter, og smag den til med salt og peber."
    },
    {
      "section": "Fyld",
      "text": "Varm olien i en gryde, og svits hvidløg og løg, til løgene er blødt. Kom squash, tomater, spidskommen og koriander i, og lad det simre uden låg i 15 minutter, til det er kogt lidt ind."
    },
    {
      "section": "Fyld",
      "text": "Vend begge slags bønner i, og varm dem godt igennem."
    },
    {
      "section": "Fyld",
      "text": "Steg majsen i lidt af smørret på en pande, til den er sprød og har fået farve."
    },
    {
      "section": "Samling",
      "text": "Tænd ovnen på 175 °C varmluft, og smør et ovnfast fad med resten af smørret."
    },
    {
      "section": "Samling",
      "text": "Fordel lidt sauce på hver tortilla, og læg bønnefyld, majs og ost ovenpå. Rul tortillaerne sammen, og læg dem side om side i fadet."
    },
    {
      "section": "Samling",
      "text": "Hæld resten af saucen over, og drys med mere ost. Fordel eventuelt overskydende fyld og majs langs siderne af fadet."
    },
    {
      "section": "Samling",
      "text": "Bag enchiladasene i ca. 18 minutter. Drys med koriander, før de kommer på bordet."
    }
  ],
  "changes": []
}
