  "steps": [
    {
      "section": "Ovnbagte grøntsager",
      "text": "Forvarm ovnen til 200 °C varmluft. Beklæd to bradepander med bagepapir."
    },
    {
      "section": "Ovnbagte grøntsager",
      "text": "Bland oregano, timian, rosmarin, hvidløg, salt og peber med olivenolien i en skål."
    },
    {
      "section": "Ovnbagte grøntsager",
      "text": "Læg kartoflerne på den ene bradepande. Læg aubergine, rødløg og halloumi på den anden. Hæld krydderiolien over begge pander, og vend det hele godt rundt."
    },
    {
      "section": "Ovnbagte grøntsager",
      "text": "Bag i 30 minutter med kartoflerne øverst i ovnen. Vend grøntsagerne et par gange undervejs. Tag panden med aubergine og halloumi ud, når halloumien er sprød og auberginen mør."
    },
    {
      "section": "Fetacreme",
      "text": "Kom fetaen i en minihakker sammen med et par spiseskefulde af yoghurten, og kør, til osten er helt glat."
    },
    {
      "section": "Fetacreme",
      "text": "Tilsæt den øvrige yoghurt, citronsaft, citronskal, hvidløg og peber. Kør igen, til cremen er luftig og jævn. Smag til med salt."
    },
    {
      "section": "Til anretning",
      "text": "Vend indholdet fra de to bradepander sammen, og læg det på et stort fad med tomater og rucola."
    },
    {
      "section": "Til anretning",
      "text": "Sæt fetacremen på i klatter, og drys med oliven og persille."
    }
  ],
  "changes": []
}
