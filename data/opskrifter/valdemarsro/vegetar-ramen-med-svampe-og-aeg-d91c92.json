  "steps": [
    {
      "section": "Nudler og æg",
      "text": "Kog nudlerne i letsaltet vand, men tag dem op et minut før tiden på pakken. Si dem og skyl dem under koldt vand, så de ikke klistrer sammen."
    },
    {
      "section": "Nudler og æg",
      "text": "Læg æggene i kogende vand i 7 minutter, så blommen bliver blød. Afkøl dem under koldt vand, og pil dem."
    },
    {
      "section": "Svampe",
      "text": "Rist sesamfrøene på en tør pande, og stil dem til side."
    },
    {
      "section": "Svampe",
      "text": "Skru op for varmen på panden, og tilsæt lidt olie. Steg champignon, til de er gyldenbrune og har fået en flot skorpe. Kom shiitake på, vend rundt, og skru ned til middelvarme."
    },
    {
      "section": "Bouillon",
      "text": "Bring fond, tomater, ingefær og hvidløg i kog i en gryde. Tag gryden af varmen, rør misoen ud i bouillonen, og smag til med sojasauce."
    },
    {
      "section": "Anretning",
      "text": "Del nudler, svampe, spinat, pak choi, gulerødder, forårsløg og koriander ud i fire skåle. Hæld den varme misobouillon over."
    },
    {
      "section": "Anretning",
      "text": "Halvér æggene, og læg dem i skålene. Drys med chiliflager og sesamfrø, og server med limebåde til at presse over."
    }
  ],
