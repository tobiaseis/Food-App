  "steps": [
    {
      "section": "Dej",
      "text": "Opløs gæren i det lunkne vand i en skål."
    },
    {
      "section": "Dej",
      "text": "Tilsæt olie, salt og hvedemel, og rør sammen. Rør durummelet i lidt ad gangen, til dejen er smidig og kan æltes."
    },
    {
      "section": "Dej",
      "text": "Læg dejen i en skål med lidt olivenolie, og vend den rundt. Lad den hæve i 1 time."
    },
    {
      "section": "Dej",
      "text": "Del dejen i lige store stykker, og form dem til små pizzabunde. Læg dem på bagepapir."
    },
    {
      "section": "Topping",
      "text": "Knæk den seje ende af aspargesene, og smid den ud. Skær resten i mindre stykker."
    },
    {
      "section": "Topping",
      "text": "Fordel asparges og smuldret gedeost over pizzaerne. Dryp med olivenolie, og drys med flagesalt."
    },
    {
      "section": "Bagning",
      "text": "Sæt en bageplade i ovnen, og forvarm til 250 °C."
    },
    {
      "section": "Bagning",
      "text": "Løft bagepapiret med pizzaerne over på den varme plade. Bag dem i 10-12 minutter."
    },
    {
      "section": "Bagning",
      "text": "Strø frisk timian over de færdige pizzaer."
    }
  ],
