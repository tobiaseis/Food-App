  "steps": [
    {
      "section": null,
      "text": "Læg den revne squash i en sigte, og pres så meget væde ud af den som muligt."
    },
    {
      "section": null,
      "text": "Rør squash sammen med æg, mel, løg, ost, hvidløg, spidskommen, salt og peber i en skål, til det er en ensartet farsmasse."
    },
    {
      "section": null,
      "text": "Stil farsen på køl i 30 minutter. Forvarm imens ovnen til 190 °C varmluft."
    },
    {
      "section": null,
      "text": "Form farsen til 8 deller, og læg dem på en bageplade med bagepapir. Pensl dem med olie."
    },
    {
      "section": null,
      "text": "Bag dellerne i ca. 25 minutter, og vend dem undervejs, når halvdelen af tiden er gået."
    }
  ],
