  "steps": [
    {
      "section": "Kødsauce",
      "text": "Smelt smørret i en gryde, og svits løgene, til de er blødt."
    },
    {
      "section": "Kødsauce",
      "text": "Sæt varmen op, og brun kødet godt, til det er gennemstegt."
    },
    {
      "section": "Kødsauce",
      "text": "Sænk varmen, og rør gulerod, selleri, hvidløg, tomatpuré, rødvin, worcestershiresauce, fond, timian, rosmarin, salt og peber i gryden."
    },
    {
      "section": "Kødsauce",
      "text": "Bring saucen i kog, og lad den simre uden låg i 10 minutter."
    },
    {
      "section": "Kartoffelmos",
      "text": "Kog kartoflerne møre i rigeligt vand uden salt."
    },
    {
      "section": "Kartoffelmos",
      "text": "Hæld vandet fra, og kom kartoflerne i en stor skål med smørret. Pisk med håndmixer, til moset er cremet og luftigt."
    },
    {
      "section": "Kartoffelmos",
      "text": "Rør fløde og parmesan i, og smag til med salt og peber."
    },
    {
      "section": "Samling og bagning",
      "text": "Varm ovnen op til 180 °C varmluft."
    },
    {
      "section": "Samling og bagning",
      "text": "Smør et ovnfast fad, og fyld kødsaucen i. Læg kartoffelmosen ovenpå som et låg, og glat den med en spatel. Træk en gaffel henover for at lave et mønster."
    },
    {
      "section": "Samling og bagning",
      "text": "Strø rasp og lidt ekstra parmesan over, og bag retten i 30-45 minutter."
    },
    {
      "section": "Samling og bagning",
      "text": "Server med persille strøet ovenpå."
    }
  ],
