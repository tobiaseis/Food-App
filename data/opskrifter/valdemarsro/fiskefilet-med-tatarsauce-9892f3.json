  "steps": [
    {
      "section": "Kartoffelbåde",
      "text": "Varm ovnen op til 200 °C varmluft. Beklæd en bradepande med bagepapir."
    },
    {
      "section": "Kartoffelbåde",
      "text": "Vend kartoffelbådene med olivenolie og flagesalt, og læg dem udover bradepanden."
    },
    {
      "section": "Kartoffelbåde",
      "text": "Bag kartoflerne i cirka 30 minutter, og vend dem et par gange undervejs."
    },
    {
      "section": "Tatarsauce",
      "text": "Bland alle ingredienserne til saucen i en skål, og smag den til med salt og peber."
    },
    {
      "section": "Fisk",
      "text": "Pisk æggene i en dyb tallerken. Bland begge slags mel med salt og peber på en anden tallerken."
    },
    {
      "section": "Fisk",
      "text": "Vend fiskefileterne først i æg og så i melblandingen, så de er dækket hele vejen rundt."
    },
    {
      "section": "Fisk",
      "text": "Varm smør og olivenolie på en pande ved middel varme. Steg fileterne i cirka 4-5 minutter på hver side, til de er gyldenbrune."
    },
    {
      "section": "Til servering",
      "text": "Anret fisken med kartoffelbåde, tatarsauce, agurkestave og citronbåde."
    }
  ],
