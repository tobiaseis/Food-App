  "steps": [
    {
      "section": "Marinade og dip",
      "text": "Bland marinadens ingredienser i en skål."
    },
    {
      "section": "Marinade og dip",
      "text": "Pisk dippens ingredienser sammen i en anden skål, og stil den på køl til servering."
    },
    {
      "section": "Spyd",
      "text": "Læg grillspydene i blød i vand i 2-3 timer, så de ikke brænder på grillen."
    },
    {
      "section": "Spyd",
      "text": "Kog majs og kartofler i let saltet vand, til de næsten er møre."
    },
    {
      "section": "Spyd",
      "text": "Træk squash, peberfrugt, tomater, rødløg, kartofler og halloumi på spydene."
    },
    {
      "section": "Grill",
      "text": "Pensl spyddene med marinaden og grill dem 5-7 minutter på hver side. Vend dem ofte, og pas på, at de ikke brænder på."
    },
    {
      "section": "Grill",
      "text": "Server spyddene med hakket mynte over og tahindippen ved siden af."
    }
  ],
