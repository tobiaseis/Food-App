  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 175 °C varmluft. Smør et ovnfast fad, og læg tomaterne i."
    },
    {
      "section": null,
      "text": "Vend tomaterne med hvidløg, olivenolie, rosmarin, hvidvin, salt og peber. Bag dem i ca. 20 minutter."
    },
    {
      "section": null,
      "text": "Rør kapers ned i fadet, og bag videre i 10 minutter. Kog pastaen i letsaltet vand i samme tid, til den er mør."
    },
    {
      "section": null,
      "text": "Tag fadet ud af ovnen. Tilsæt lidt af pastavandet og halvdelen af parmesanen, og rør det sammen."
    },
    {
      "section": null,
      "text": "Si pastaen, og vend den med tomaterne i fadet. Smag til med salt, peber og citronskal, og tilsæt evt. et par dråber citronsaft."
    },
    {
      "section": null,
      "text": "Anret pastaen på tallerkener med rucola og oliven. Top med resten af parmesanen."
    }
  ],
