  "steps": [
    {
      "section": "Dressing",
      "text": "Pisk alle ingredienserne til dressingen sammen i en skål. Lad den stå og trække, mens du laver resten."
    },
    {
      "section": "Salat",
      "text": "Læg salatblanding, forårsløg, agurk og de hakkede urter på et stort fad."
    },
    {
      "section": "Bøf",
      "text": "Varm en grillpande op ved høj varme med smør og olie. Steg bøffen i 2-3 minutter på hver side."
    },
    {
      "section": "Bøf",
      "text": "Flyt bøffen til et skærebræt og lad den hvile i 4-5 minutter. Smag til med salt og peber, og skær den i tynde skiver."
    },
    {
      "section": "Servering",
      "text": "Hæld dressingen over salaten og vend det hele godt. Læg kødskiverne ovenpå, og pynt med peanuts, chiliringe og friske urter."
    }
  ],
  "changes": [
    "Thaibasilikum er skiftet til almindelig basilikum.",
