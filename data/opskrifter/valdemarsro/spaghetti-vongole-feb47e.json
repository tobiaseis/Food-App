  "steps": [
    {
      "section": null,
      "text": "Skrub muslingerne og skyl dem under koldt rindende vand. Bank dem let mod bordet, og smid alle med knækkede skaller eller dem, der ikke lukker sig, ud."
    },
    {
      "section": null,
      "text": "Kog spaghettien al dente efter anvisningen på pakken."
    },
    {
      "section": null,
      "text": "Varm olivenolien i en bred pande ved middelvarme, og svits hvidløg og chili i 1-2 minutter."
    },
    {
      "section": null,
      "text": "Kom muslinger og hvidvin i panden, læg låg på, og lad det simre i 5 minutter."
    },
    {
      "section": null,
      "text": "Riv skallen af citronen, og pres saften fra den ene halvdel."
    },
    {
      "section": null,
      "text": "Løft den kogte pasta over i panden. Tilsæt smør, persille, citronskal og citronsaft, og vend det hele godt. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Server med det samme. Smid de muslinger ud, der ikke har åbnet sig under tilberedningen. Det passer godt med brød, salat og et glas hvidvin."
    }
  ],
