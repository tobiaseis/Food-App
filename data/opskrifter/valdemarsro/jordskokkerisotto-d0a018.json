  "steps": [
    {
      "section": "Jordskokkechips",
      "text": "Skræl jordskokkerne, og hobl dem i tynde skiver på et mandolinjern."
    },
    {
      "section": "Jordskokkechips",
      "text": "Hæld olien i en gryde, og opvarm den til 180 °C."
    },
    {
      "section": "Jordskokkechips",
      "text": "Steg skiverne i små portioner, til de er gyldne og sprøde. Fisk dem op med en hulske, og lad dem løbe af på køkkenrulle. Drys straks med flagesalt."
    },
    {
      "section": "Risotto",
      "text": "Varm olivenolien i en gryde på middel-lav varme. Svits jordskokketerninger, løg, hvidløg og tørret timian i 5-6 minutter, til alt er blødt. Grøntsagerne må ikke blive brune."
    },
    {
      "section": "Risotto",
      "text": "Kom risene i gryden, og rør rundt, så de er dækket af olie. Hæld vinen i, og rør, til den er trukket ind."
    },
    {
      "section": "Risotto",
      "text": "Tilsæt fonden lidt ad gangen under omrøring. Fortsæt, til risene er næsten møre, og risottoen er cremet."
    },
    {
      "section": "Risotto",
      "text": "Rør parmesanen i. Smag til med citronskal, en smule citronsaft, salt og peber."
    },
    {
      "section": "Servering",
      "text": "Anret risottoen med jordskokkechips, revet parmesan og frisk timian."
    }
  ],
