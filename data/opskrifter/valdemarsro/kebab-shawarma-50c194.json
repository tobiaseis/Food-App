  "steps": [
    {
      "section": "Kødet og marinaden",
      "text": "Skær lammekødet i små strimler og mundrette stykker."
    },
    {
      "section": "Kødet og marinaden",
      "text": "Bland yoghurt, hvidløg, alle krydderierne, citronskal, citronsaft, salt og peber i en stor skål."
    },
    {
      "section": "Kødet og marinaden",
      "text": "Vend kødet i marinaden, så det er dækket hele vejen rundt. Sæt låg eller film på, og stil skålen i køleskabet i 12-24 timer."
    },
    {
      "section": "Stegning",
      "text": "Løft kødet op af skålen med en hulske, og smid resten af marinaden ud."
    },
    {
      "section": "Stegning",
      "text": "Varm lidt olie på en stor pande. Steg kødet i flere små omgange, så panden ikke fyldes: for meget kød ad gangen giver væde, og så koger det i stedet for at brune."
    },
    {
      "section": "Til servering",
      "text": "Fyld pitabrødene med det varme kød, agurk, tomater, rødløg, mynte og persille, mens kødet stadig damper."
    }
  ],
