  "steps": [
    {
      "section": null,
      "text": "Forvarm ovnen til 175 °C varmluft. Smør et ovnfast fad."
    },
    {
      "section": null,
      "text": "Læg gnocchi, rødløg og tomater i fadet."
    },
    {
      "section": null,
      "text": "Bland soltørrede tomater, hvidløg, rosmarin og timian med olivenolie i en skål, og smag til med salt og peber. Hæld blandingen over fadets indhold, og vend alt godt rundt."
    },
    {
      "section": null,
      "text": "Fordel pinjekerner og den smuldrede ost ovenpå."
    },
    {
      "section": null,
      "text": "Bag fadet midt i ovnen i ca. 30 minutter."
    },
    {
      "section": null,
      "text": "Læg rucola, basilikum og burrata på det varme fad, og server med det samme."
    }
  ],
