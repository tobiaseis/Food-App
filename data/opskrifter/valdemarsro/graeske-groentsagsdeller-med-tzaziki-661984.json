  "steps": [
    {
      "section": "Tzatziki",
      "text": "Del agurkerne på langs, og skrab kernerne ud med en ske. Riv dem groft."
    },
    {
      "section": "Tzatziki",
      "text": "Vend agurken med salt, og lad den stå i 5-10 minutter. Hæld den i en sigte, og pres så meget væde ud som muligt."
    },
    {
      "section": "Tzatziki",
      "text": "Rør agurken i yoghurten. Smag til med hvidløg, olivenolie, salt og peber, og stil tzatzikien på køl."
    },
    {
      "section": "Græske kartofler",
      "text": "Skær kartoflerne over på midten. Vend dem med halvdelen af olien og lidt salt, og læg dem på en bageplade med bagepapir."
    },
    {
      "section": "Græske kartofler",
      "text": "Bag kartoflerne ved 175 °C i cirka 10 minutter. Tag dem ud, og vend dem med resten af olien, lidt mere salt, timian og rosmarin. Bag dem igen i yderligere 15 minutter, til de er møre og gyldne."
    },
    {
      "section": "Grøntsagsdeller",
      "text": "Bland æg, hvedemel og spidskål i en skål. Tilsæt timian, soltørrede tomater og hvidløg, og rør det godt sammen. Lad farsen hvile i 15 minutter, og rør den igen."
    },
    {
      "section": "Grøntsagsdeller",
      "text": "Hak kikærterne groft i en foodprocessor eller minihakker. Vend dem i farsen sammen med halloumien, og smag til med salt og peber."
    },
    {
      "section": "Grøntsagsdeller",
      "text": "Sæt spiseskefulde af farsen på en bageplade med bagepapir. Smør hænderne med lidt olie, og form dellerne runde."
    },
    {
      "section": "Grøntsagsdeller",
      "text": "Bag dellerne sammen med kartoflerne ved 175 °C varmluft i cirka 15 minutter i alt. Vend dem efter cirka 10 minutter."
    },
    {
      "section": "Halloumisalat",
      "text": "Skær halloumien i skiver. Steg dem i olie på en pande, eller pensl dem med olie og grill dem, til de er gyldne og sprøde i kanten."
    },
    {
      "section": "Halloumisalat",
      "text": "Bryd den stegte halloumi i grove stykker. Vend den med tomater og rucola, og drys med peber og timian."
    },
    {
      "section": "Servering",
      "text": "Anret tzatzikien på tallerkener, og læg grøntsagsdellerne ovenpå. Server tomatsalaten og kartoflerne ved siden af."
    }
  ],
