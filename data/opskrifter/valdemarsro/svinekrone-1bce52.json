  "steps": [
    {
      "section": null,
      "text": "Indsmør et ovnfast fad rigeligt med smør."
    },
    {
      "section": null,
      "text": "Gnid svinekronen med salt, peber og tørret timian, og læg den i fadet. Stil fadet i en kold ovn."
    },
    {
      "section": null,
      "text": "Indstil ovnen på 150 °C, og steg kronen i ca. 45 minutter."
    },
    {
      "section": null,
      "text": "Rør sennep og honning sammen. Pensl kronen med blandingen 2-3 gange i løbet af de næste 10-20 minutter."
    },
    {
      "section": null,
      "text": "Tag stegen ud, og lad den hvile i 5-10 minutter. Del den derefter i 4 koteletter."
    },
    {
      "section": null,
      "text": "Drys med frisk timian, og server med ovnbagte kartofler, salat og godt brød."
    }
  ],
