  "steps": [
    {
      "section": "Aubergine",
      "text": "Varm ovnen op til 225 °C varmluft. Klæd en bradepande med bagepapir."
    },
    {
      "section": "Aubergine",
      "text": "Læg auberginestykkerne på bradepanden og pensl dem generøst med olivenolie. De trækker meget olie, og det gør dem kun bedre."
    },
    {
      "section": "Aubergine",
      "text": "Bag dem i 20 minutter. Du kan også grille dem, til de er gyldne."
    },
    {
      "section": "Tahindressing",
      "text": "Rør tahin, citronsaft, olivenolie og spidskommen sammen i en skål. Tilsæt koriander, hvis du bruger den."
    },
    {
      "section": "Tahindressing",
      "text": "Tilsæt koldt vand lidt ad gangen, til dressingen er tynd nok til at dryppe. Smag til med salt og peber."
    },
    {
      "section": "Anretning",
      "text": "Anret auberginerne på et fad og dryp dressingen over. Top med granatæblekerner, pistacienødder og mynte."
    }
  ],
