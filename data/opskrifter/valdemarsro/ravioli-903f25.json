  "steps": [
    {
      "section": "Pastadej",
      "text": "Bland begge slags mel med saltet i en stor skål, og lav en fordybning midt i melet."
    },
    {
      "section": "Pastadej",
      "text": "Slå æggene ud i fordybningen, og pisk dem løst med en gaffel. Når melet begynder at trække æggene til sig, hældes olivenolien i, og du fortsætter med at piske."
    },
    {
      "section": "Pastadej",
      "text": "Ælt dejen glat med hænderne, når gaflen ikke længere slår til. Læg den i en skål, og lad den hvile i køleskabet i ca. 1 time."
    },
    {
      "section": "Fyld",
      "text": "Hak laks og spinat fint. Rør dem sammen med ricotta og hvidløg, og smag til med salt og peber."
    },
    {
      "section": "Ravioli",
      "text": "Rul dejen tyndt ud på et meldrysset bord. Udstik cirkler med et glas."
    },
    {
      "section": "Ravioli",
      "text": "Læg lidt fyld på midten af hver cirkel, fold den sammen, og luk kanten ved at presse en gaffel langs den."
    },
    {
      "section": "Ravioli",
      "text": "Kog raviolierne i letsaltet vand med en smule olie i ca. 3-3½ minut."
    }
  ],
