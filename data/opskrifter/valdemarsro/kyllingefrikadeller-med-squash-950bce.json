  "steps": [
    {
      "section": null,
      "text": "Bland kylling, squash, hvidløg, soltørrede tomater, timian, salt og peber i en skål. Lad farsen trække i 30 minutter."
    },
    {
      "section": null,
      "text": "Form farsen til frikadeller."
    },
    {
      "section": "På panden",
      "text": "Smelt smør på en pande og steg frikadellerne, til de er færdige hele vejen igennem."
    },
    {
      "section": "I ovnen",
      "text": "Alternativt: Læg frikadellerne på en bageplade og bag dem ved 175 °C varmluft i 15-20 minutter, til de er gyldne og gennemstegte. Vend dem gerne en enkelt gang undervejs."
    }
