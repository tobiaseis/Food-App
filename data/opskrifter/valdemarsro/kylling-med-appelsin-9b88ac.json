  "steps": [
    {
      "section": null,
      "text": "Varm olien på en pande, og brun kyllingelårene godt på alle sider. Krydr med salt og peber."
    },
    {
      "section": null,
      "text": "Læg lårene i en stegeso eller støbejernsgryde. Tilsæt kærnemælk, appelsinskiver, kanel, kardemomme, tranebær, rosmarin og hvidløg."
    },
    {
      "section": null,
      "text": "Sæt gryden med låg i en forvarmet ovn ved 175 °C i 45 minutter."
    },
    {
      "section": null,
      "text": "Tag låget af, og bag videre i 15-20 minutter, til skindet er sprødt."
    },
    {
      "section": null,
      "text": "Kog risene, og server dem til kyllingen."
    }
  ],
