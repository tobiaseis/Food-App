  "steps": [
    {
      "section": "Rødbedebøffer",
      "text": "Forvarm ovnen til 200 °C varmluft."
    },
    {
      "section": "Rødbedebøffer",
      "text": "Bland rødbeder, havregryn, hvedemel, løg, hvidløg, æg og sennep i en skål. Krydr med salt og peber."
    },
    {
      "section": "Rødbedebøffer",
      "text": "Mærk efter, om farsen kan formes. Er den for våd, så tilsæt lidt mere havregryn eller hvedemel. Er den for tør, så rør lidt længere."
    },
    {
      "section": "Rødbedebøffer",
      "text": "Form fire bøffer, og placér dem på en bageplade med bagepapir. Dryp med olivenolie, og bag dem i cirka 5 minutter."
    },
    {
      "section": "Rødbedebøffer",
      "text": "Tag pladen ud, og læg hver bøf oven på en brødskive. Sæt den tilbage i ovnen, og bag i yderligere 10 minutter."
    },
    {
      "section": "Pocherede æg",
      "text": "Slå hvert æg ud i en lille skål hver for sig. Bring en gryde vand i kog."
    },
    {
      "section": "Pocherede æg",
      "text": "Hæld eddike i det kogende vand, og træk gryden til side. Rør vandet rundt med en ske eller et piskeris, så der opstår en hvirvel med et hul i midten."
    },
    {
      "section": "Pocherede æg",
      "text": "Lad et æg glide ned i midten af hvirvlen, og stil gryden tilbage på varmen. Lad ægget simre i cirka 3 minutter, løft det op med en hulske, og læg det på en tallerken. Gentag med de øvrige æg."
    },
    {
      "section": "Til servering",
      "text": "Læg et pocheret æg på hver pariserbøf, og drys med purløg, salt og peber. Server med peberrod, rødløg, kapersbær og cornichoner ved siden af."
    }
  ],
