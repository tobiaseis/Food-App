  "steps": [
    {
      "section": "Tærtedej",
      "text": "Bland de to slags mel med saltet, og smuldr smørret i melet med fingrene. Du kan også køre det i en foodprocessor."
    },
    {
      "section": "Tærtedej",
      "text": "Tilsæt vandet, og samle dejen. Lad den gerne hvile på køl i 30 minutter."
    },
    {
      "section": "Tærtedej",
      "text": "Tryk dejen ud i en smurt tærteform på ca. 24 cm i diameter, og prik bunden med en gaffel."
    },
    {
      "section": "Tærtedej",
      "text": "Forbag bunden i 10 minutter i en forvarmet ovn ved 175 °C varmluft."
    },
    {
      "section": "Fyld",
      "text": "Pisk æg, creme fraiche og flødeost sammen i en skål, og smag til med salt og peber."
    },
    {
      "section": "Fyld",
      "text": "Vend broccoli og laks i æggeblandingen."
    },
    {
      "section": "Bagning",
      "text": "Hæld fyldet i den forbagte bund, og bag tærten ved 175 °C varmluft i ca. 30-35 minutter, til æggemassen er stivnet."
    }
