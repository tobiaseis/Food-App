  "steps": [
    {
      "section": "Vafler",
      "text": "Læg de 225 g græskartern i en gryde, og hæld vand over, så de er dækket. Kog dem møre, og si vandet fra."
    },
    {
      "section": "Vafler",
      "text": "Kom de kogte græskartern i en blender sammen med resten af vaffelingredienserne, bortset fra smørret. Blend til dejen er helt glat."
    },
    {
      "section": "Vafler",
      "text": "Smør vaffeljernet let med smør. Bag vaflerne én ad gangen i 3-4 minutter, til de er sprøde, gyldne og bagt igennem."
    },
    {
      "section": "Bagte grøntsager",
      "text": "Tænd ovnen på 180 °C varmluft. Fordel kikærter, gulerødder, græsktern og løg på en bradepande med bagepapir."
    },
    {
      "section": "Bagte grøntsager",
      "text": "Drys med rosmarin, salt og peber, og tilsæt olien. Vend det hele rundt, og bag i ca. 15 minutter."
    },
    {
      "section": "Dip",
      "text": "Rør yoghurt, hvidløg, begge slags sennep og honning sammen. Smag til med salt og peber, og justér evt. med lidt mere honning eller sennep."
    },
    {
      "section": "Servering",
      "text": "Anret de varme vafler med bagte grøntsager og kikærter. Top med dippen, græskarkerner, æbletern og hakket persille."
    }
  ],
