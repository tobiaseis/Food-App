  "steps": [
    {
      "section": "Syltede sennepsfrø",
      "text": "Put alle ingredienserne til sennepsfrøene i en gryde, og bring det i kog. Sænk varmen, læg låg på, og lad det simre ved svag varme i 10-15 minutter."
    },
    {
      "section": "Syltede sennepsfrø",
      "text": "Hæld frøene i et skoldet glas, og stil dem på køl, til de er kolde."
    },
    {
      "section": "Peberrodscreme",
      "text": "Rør creme fraiche, mayonnaise og peberrod sammen i en skål. Smag til med citronskal, salt og peber."
    },
    {
      "section": "Rørt tatar",
      "text": "Rør oksekød, æggeblommer, estragon, kapers, cornichoner og skalotteløg sammen i en stor skål. Smag til med sennep, salt og peber."
    },
    {
      "section": "Servering",
      "text": "Læg salat på tallerkenerne, og anret tatar, urter, sennepsfrø og peberrodscreme ovenpå. Drys med chips, ekstra urter og flagesalt, og server straks."
    }
  ],
