  "steps": [
    {
      "section": "Mangosalsa",
      "text": "Bland mango, tomat, agurk, forårsløg og chili med den hakkede koriander. Smag salsaen til med limesaft, limeskal, salt og peber."
    },
    {
      "section": "Torsk",
      "text": "Varm ovnen op til 175 °C varmluft. Blend rasp, citronskal, mynte, salt og peber i en minihakker, til blandingen er fin."
    },
    {
      "section": "Torsk",
      "text": "Tør torskestykkerne med køkkenrulle, læg dem i et ovnfast fad, og dæk dem med raspblandingen. Bag dem i 16-18 minutter, og tjek, at fisken er gennemstegt."
    },
    {
      "section": "Til servering",
      "text": "Varm tortillaerne på en tør pande eller i ovnen. Fyld dem med fisk, mangosalsa, spinat og avocado, og top med koriander."
    }
  ],
