  "steps": [
    {
      "section": null,
      "text": "Varm en pande op med lidt olie, og steg baconternene sprøde. Læg dem over på køkkenrulle."
    },
    {
      "section": null,
      "text": "Drys kyllingebrysterne med salt og peber. Steg dem på samme pande i baconfedtet ved middelvarme i cirka 25 minutter, til de er helt gennemstegte. Tilsæt lidt smør og olivenolie, hvis panden bliver tør."
    },
    {
      "section": null,
      "text": "Tag kyllingen af panden, og lad den køle af. Skær den i tern eller tynde skiver."
    },
    {
      "section": "Til dressingen",
      "text": "Rør creme fraiche, mayonnaise, karry, honning og eddike sammen i en skål. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Sæt lidt af bacon, æble, rødløg, dild og purløg til side som pynt."
    },
    {
      "section": null,
      "text": "Vend salat, rucola, kylling og resten af bacon, æble, rødløg og krydderurter med dressingen i en stor skål."
    },
    {
      "section": null,
      "text": "Læg salaten på et fad, og top med den pynt, du lagde til side. Server straks."
    }
  ],
