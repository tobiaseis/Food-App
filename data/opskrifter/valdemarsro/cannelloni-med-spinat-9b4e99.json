  "steps": [
    {
      "section": "Tomatsauce",
      "text": "Svits løg og hvidløg i olie i en gryde, til løgene er bløde."
    },
    {
      "section": "Tomatsauce",
      "text": "Tilsæt hakkede tomater og timian, og lad saucen simre i 15-30 minutter, mens du laver fyldet."
    },
    {
      "section": "Tomatsauce",
      "text": "Smag til med eddike, sukker, salt og peber."
    },
    {
      "section": "Spinat- og ricottafyld",
      "text": "Varm en pande med lidt olivenolie op ved middelvarme. Rist pinjekernerne let, og kom derefter spinaten på panden."
    },
    {
      "section": "Spinat- og ricottafyld",
      "text": "Rør af og til, til spinaten er faldet sammen. Tag panden af varmen, og vend ricotta og æg ind i spinaten. Krydr med salt, peber og muskatnød."
    },
    {
      "section": "Til samling",
      "text": "Tænd ovnen på 175 °C. Smør et ovnfast fad, og fordel halvdelen af tomatsaucen i bunden."
    },
    {
      "section": "Til samling",
      "text": "Skær lasagnepladerne i otte firkanter på ca. 10 x 10 cm. Læg fyld på hver firkant, rul dem sammen til rør, og læg dem side om side i fadet."
    },
    {
      "section": "Til samling",
      "text": "Hæld resten af saucen over, og top med mozzarella og basilikum."
    },
    {
      "section": "Til samling",
      "text": "Bag i den forvarmede ovn i 20 minutter, til pastaen er mør. Server med parmesan og friskhakket basilikum."
    }
  ],
