  "steps": [
    {
      "section": "Vietnamesisk kylling",
      "text": "Bland sojasauce, fiskesauce, sukker, limesaft og sesamolie til en marinade. Vend kyllingetern i marinaden og lad dem trække i mindst 15 minutter – gerne natten over i køleskabet."
    },
    {
      "section": "Vietnamesisk kylling",
      "text": "Løft kyllingen op af skålen, men gem marinaden. Varm olie op på en meget varm pande og brun kyllingen under omrøring, til den får en pæn skorpe."
    },
    {
      "section": "Vietnamesisk kylling",
      "text": "Hæld marinaden på panden og steg, til kyllingen er helt gennemstegt."
    },
    {
      "section": "Syltede gulerødder",
      "text": "Kog vand, riseddike og sukker kort op i en gryde, indtil sukkeret er opløst. Tag gryden af varmen."
    },
    {
      "section": "Syltede gulerødder",
      "text": "Læg gulerødderne i den varme lage, fyld dem på glas med låg og stil dem i køleskabet, mens du laver resten."
    },
    {
      "section": "Ris med ingefær og hvidløg",
      "text": "Varm olivenolie, ingefær og hvidløg op i en gryde ved lav varme. Lad det simre, til det dufter, men uden at det brunes."
    },
    {
      "section": "Ris med ingefær og hvidløg",
      "text": "Kom basmatiris, vand og salt i gryden og rør rundt. Sæt låg på og bring langsomt i kog."
    },
    {
      "section": "Ris med ingefær og hvidløg",
      "text": "Lad risene koge under låg ved svag varme i 10 minutter. Tag gryden af varmen og lad den stå med låg på i 10 minutter mere."
    },
    {
      "section": "Asiatisk mayo-dressing",
      "text": "Rør mayonnaise sammen med fiskesauce, hvidløg og ingefær. Smag til med limeskal og friskkværnet peber."
    },
    {
      "section": "Til anretning",
      "text": "Fordel risene i skåle og læg kylling, syltede gulerødder, spidskål, agurk og avocado ovenpå."
    },
    {
      "section": "Til anretning",
      "text": "Top med dressingen og drys med koriander, chiliflager og sesamfrø."
    }
  ],
  "changes": []
}
