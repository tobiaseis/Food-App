  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 190 °C varmluft, og beklæd en bradepande med bagepapir."
    },
    {
      "section": null,
      "text": "Blend løg og hvidløg i en minihakker eller foodprocessor, til det er fint."
    },
    {
      "section": null,
      "text": "Tilsæt majsen, og pulsér kort. Majsen skal kun hakkes groft, så der stadig er mange hele korn."
    },
    {
      "section": null,
      "text": "Vend resten af ingredienserne i, og rør det hele til en ensartet fars."
    },
    {
      "section": null,
      "text": "Form farsen til 10 deller, og læg dem på bagepapiret. Pensl dem med olie."
    },
    {
      "section": null,
      "text": "Bag dellerne i ca. 25 minutter, og vend dem undervejs efter halv tid."
    }
