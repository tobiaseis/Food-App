  "steps": [
    {
      "section": null,
      "text": "Varm olien i en gryde, og blød løg og hvidløg op, til løgene er møre."
    },
    {
      "section": null,
      "text": "Kom risene i gryden, og vend dem rundt, så de er dækket af olie."
    },
    {
      "section": null,
      "text": "Hæld 1 dl fond i, og rør, til risene har sugget det til sig. Fortsæt med lidt fond ad gangen, til al fonden er brugt, og risene er møre. Brug mere fond, hvis risene stadig er faste."
    },
    {
      "section": null,
      "text": "Varm en pande helt op, og brun champignonerne i smørret i 2 minutter."
    },
    {
      "section": null,
      "text": "Vend champignonerne og den friskrevne parmesan i risottoen, og smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Anret med ekstra parmesan og hakket persille."
    }
  ],
