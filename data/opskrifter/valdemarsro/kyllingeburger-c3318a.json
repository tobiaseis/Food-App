  "steps": [
    {
      "section": "Bøffer",
      "text": "Kom kyllingekødet i en stor skål sammen med alle ingredienserne til bøfferne, og rør det godt sammen."
    },
    {
      "section": "Bøffer",
      "text": "Sæt farsen i køleskabet i cirka en halv time."
    },
    {
      "section": "Stegning",
      "text": "Form farsen til fire bøffer."
    },
    {
      "section": "Stegning",
      "text": "Varm smør og olie op på en pande ved middel varme, og steg bøfferne, til de er gennemstegte."
    },
    {
      "section": "Dressing",
      "text": "Rør mayonnaise og sennep sammen til en dressing."
    },
    {
      "section": "Til servering",
      "text": "Smør dressingen på bollerne, og læg salat, bøf, agurk, mango og æble i."
    }
