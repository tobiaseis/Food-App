  "steps": [
    {
      "section": null,
      "text": "Varm olie og smør op i en pande på høj varme. Brun champignonerne, og vend dem ofte, indtil de får en gylden skorpe."
    },
    {
      "section": null,
      "text": "Sænk til middelvarme. Kom de øvrige svampe, løg og hvidløg på panden, og svits, indtil løgene er møre."
    },
    {
      "section": null,
      "text": "Bland begge slags paprika med mel i en skål, og sigt blandingen ud over panden."
    },
    {
      "section": null,
      "text": "Tilsæt tomatpuré, fond og fløde. Lad det simre i 10 minutter."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber. Anret med de kogte ris og drys med persille."
    }
  ],
