  "steps": [
    {
      "section": "Köttbullar",
      "text": "Rør raspen ud i mælken i en skål, og lad den svulme i 10 minutter."
    },
    {
      "section": "Köttbullar",
      "text": "Bland løg, svinekød, hvedemel, æg, bacon og allehånde i en anden skål. Smag til med salt og peber, og ælt det godt sammen. Vend rasp-blandingen i, og lad farsen hvile i 30 minutter, så smagene trænger igennem."
    },
    {
      "section": "Köttbullar",
      "text": "Væd hænderne i koldt vand, og rul farsen til små kugler med en teske som mål – vandet gør dem pæne og runde."
    },
    {
      "section": "Köttbullar",
      "text": "Brun kuglerne i smør på en pande ved middelvarme, og vend dem ofte, til de er gennemstegte. Tag dem af panden, men gem fedtet."
    },
    {
      "section": "Sauce",
      "text": "Smelt smørret i en lille gryde sammen med stegefedtet fra panden. Pisk hvedemelet i, så det bliver til en jævn smøre."
    },
    {
      "section": "Sauce",
      "text": "Hæld sødmælken i lidt ad gangen under konstant piskning, og varm saucen op, til den koger. Rør fløde og oksefond i, og smag til med salt, peber og ribsgele."
    },
    {
      "section": "Kartoffelmos",
      "text": "Kog kartoflerne møre i usaltet vand, og hæld vandet fra."
    },
    {
      "section": "Kartoffelmos",
      "text": "Mos kartoflerne med smørret, og pisk dem med håndmixer. Tilsæt den lune mælk lidt ad gangen, til mosen er cremet og blød. Smag til med salt, peber og muskatnød."
    },
    {
      "section": null,
      "text": "Server kødbollerne med mos og sauce."
    }
  ],
