  "steps": [
    {
      "section": "Fiskefileter",
      "text": "Skyl fisken under koldt vand, og tør den godt med køkkenrulle."
    },
    {
      "section": "Fiskefileter",
      "text": "Bland rasp, dild, citronskal, salt og peber i en dyb tallerken."
    },
    {
      "section": "Fiskefileter",
      "text": "Drys fileterne let med hvedemel. Dyp dem i det piskede æg, og pres dem derefter ned i raspblandingen, så de dækkes hele vejen rundt."
    },
    {
      "section": "Fiskefileter",
      "text": "Varm smør og olivenolie på en pande, til smørret bruser. Steg fileterne gyldne og sprøde i 5-7 minutter på hver side."
    },
    {
      "section": "Urtedressing",
      "text": "Pisk creme fraiche og mayonnaise sammen, til massen er luftig."
    },
    {
      "section": "Urtedressing",
      "text": "Vend de hakkede krydderurter i, og smag til med citronskal, salt og peber."
    },
    {
      "section": "Samling",
      "text": "Del burgerbollerne, og læg salat, agurk, fiskefilet og rejer i lag. Top med lidt frisk dild og en god klat dressing. Server med citronbåde."
    }
  ],
