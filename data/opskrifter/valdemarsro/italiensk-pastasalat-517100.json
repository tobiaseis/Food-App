  "steps": [
    {
      "section": "Pestodressing",
      "text": "Læg basilikum, hvidløg, parmesan, de ristede pinjekerner og citronskallen på et skærebræt, og hak det hele meget fint, til det er ensartet."
    },
    {
      "section": "Pestodressing",
      "text": "Kom blandingen i en skål, og rør citronsaft, sukker og olivenolie i. Smag til med salt og peber."
    },
    {
      "section": "Pastasalat",
      "text": "Kog tortellinien i en gryde, som det står på pakken. Skyl den i koldt vand, så den holder op med at koge, og vend den med halvdelen af dressingen."
    },
    {
      "section": "Pastasalat",
      "text": "Læg tomater og rødløg i en stor skål, og top med den vendte tortellini."
    },
    {
      "section": "Pastasalat",
      "text": "Fordel oliven og burrata ovenpå, og pynt med basilikum og pinjekerner. Dryp til sidst resten af dressingen over."
    }
  ],
