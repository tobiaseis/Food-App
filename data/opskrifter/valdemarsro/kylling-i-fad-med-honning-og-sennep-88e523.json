  "steps": [
    {
      "section": null,
      "text": "Rør honning, sennep, citronskal og citronsaft sammen. Hak eller pluk bladene fra halvdelen af rosmarinen og tilsæt dem."
    },
    {
      "section": null,
      "text": "Vend kyllingen i marinaden, og drys med salt og peber."
    },
    {
      "section": null,
      "text": "Stil kyllingen på køl i mindst en halv time. Den må gerne stå længere."
    },
    {
      "section": null,
      "text": "Varm ovnen op til 175 °C varmluft. Fedt et ovnfast fad ind med smør."
    },
    {
      "section": null,
      "text": "Læg kyllingen i fadet, og bag den i cirka 30 minutter, til den er gennemstegt."
    },
    {
      "section": null,
      "text": "Pynt med resten af rosmarinen, og server."
    }
  ],
