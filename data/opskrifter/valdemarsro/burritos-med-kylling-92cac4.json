  "steps": [
    {
      "section": "Kyllingefyld",
      "text": "Varm olien op på en pande ved høj varme, og brun kyllingen under omrøring."
    },
    {
      "section": "Kyllingefyld",
      "text": "Tilsæt spidskommen, begge slags paprika og oregano, og rør godt rundt."
    },
    {
      "section": "Kyllingefyld",
      "text": "Tag panden af varmen. Rør flødeost og sorte bønner i, så alt blandes med kyllingen, og smag til med salt og peber."
    },
    {
      "section": "Burritos",
      "text": "Varm tortillaerne på en tør pande, til de er bløde og smidige. Gnid dem med olie på begge sider."
    },
    {
      "section": "Burritos",
      "text": "Læg en stribe majs, avocado og cheddar ned ad midten af hver tortilla, og top med 4-5 spsk af kyllingefyldet."
    },
    {
      "section": "Burritos",
      "text": "Fold siderne ind over fyldet, og rul tortillaen stramt sammen. Gør det samme med resten."
    },
    {
      "section": "Burritos",
      "text": "Læg burritoerne med samlingen nedad på en bradepande med bagepapir. Bag dem midt i ovnen ved 200 °C i ca. 15 minutter, til de er sprøde og gyldne."
    },
    {
      "section": "Til servering",
      "text": "Kog risene efter anvisningen på pakken."
    },
    {
      "section": "Til servering",
      "text": "Mos den sidste avocado, men kun halvdelen af den, med creme fraiche og saft fra limefrugterne. Smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Skær burritoerne over på midten, så hver person får halvanden. Server med ris og avocadodressing, og drys med chiliflager og koriander."
    }
  ],
