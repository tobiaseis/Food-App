  "steps": [
    {
      "section": null,
      "text": "Forvarm ovnen til 175 °C varmluft. Del torsken i fire lige store stykker, og drys dem med salt og peber."
    },
    {
      "section": null,
      "text": "Læg filodejsarkene frem, og pensl dem med det smeltede smør. Anbring ét stykke torsk midt på hvert ark."
    },
    {
      "section": null,
      "text": "Fordel pesto ud over fiskestykkerne, og top dem med æbletern og pinjekerner."
    },
    {
      "section": null,
      "text": "Slå dejen omkring fisken som en kuvert, så der dannes en lukket pakke. Læg pakkerne på en bageplade med bagepapir."
    },
    {
      "section": null,
      "text": "Bag pakkerne i ovnen i 20-25 minutter, til dejen er gylden og sprød."
    }
  ],
