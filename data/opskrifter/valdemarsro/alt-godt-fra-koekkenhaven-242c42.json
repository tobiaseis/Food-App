  "steps": [
    {
      "section": "Bagte grøntsager",
      "text": "Forvarm ovnen til 175 °C varmluft og beklæd en bageplade med bagepapir."
    },
    {
      "section": "Bagte grøntsager",
      "text": "Vend gulerødder, fennikel og radiser rundt i olie, røget paprika, salt og peber, og læg dem på bagepladen."
    },
    {
      "section": "Bagte grøntsager",
      "text": "Bag grøntsagerne i 20 minutter."
    },
    {
      "section": "Ristede boghvedekerner",
      "text": "Skyl boghvedekernerne grundigt i en sigte, og lad vandet løbe fra."
    },
    {
      "section": "Ristede boghvedekerner",
      "text": "Rist dem på en stor, tør pande ved middelhøj varme, mens du rører hele tiden, til de er gyldne og sprøde."
    },
    {
      "section": "Ovntørrede tomater",
      "text": "Sænk ovnen til 100 °C. Beklæd en bradepande med bagepapir."
    },
    {
      "section": "Ovntørrede tomater",
      "text": "Læg tomatkvartene på papiret med snitfladen opad, og drys dem med salt."
    },
    {
      "section": "Ovntørrede tomater",
      "text": "Pensl med olivenolie, og fordel rosmarinkviste ovenpå."
    },
    {
      "section": "Ovntørrede tomater",
      "text": "Bag tomaterne i 4-5 timer."
    },
    {
      "section": "Butterbeanhummus",
      "text": "Blend alle ingredienserne til hummussen i en foodprocessor, til den er en tyk, glat creme."
    },
    {
      "section": "Butterbeanhummus",
      "text": "Smør hummussen ud på et fad, og læg de bagte grøntsager og tomaterne ovenpå."
    },
    {
      "section": "Butterbeanhummus",
      "text": "Top med de ristede boghvedekerner og mynten."
    }
  ],
