  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en gryde ved middel varme. Svits løg og hvidløg, til de er blødt og klart."
    },
    {
      "section": null,
      "text": "Blend de hakkede tomater helt kort med en stavblender. Hæld dem i gryden sammen med fløden."
    },
    {
      "section": null,
      "text": "Lad saucen simre uden låg i 15-20 minutter."
    },
    {
      "section": null,
      "text": "Kog imens pastaen, som det står på pakken, og si vandet fra."
    },
    {
      "section": null,
      "text": "Hak halvdelen af basilikumbladene fint, og rør dem i saucen. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Vend den kogte pasta rundt i saucen, og vend til sidst laksestrimlerne i."
    },
    {
      "section": null,
      "text": "Servér i en stor skål med de resterende basilikumblade drysset over."
    }
  ],
