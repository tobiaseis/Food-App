  "steps": [
    {
      "section": "Urtedressing",
      "text": "Bland creme fraiche og mayonnaise med dild og purløg. Smag til med salt, peber og lidt citronskal."
    },
    {
      "section": "Spinatvafler",
      "text": "Bland hvedemel, fuldkornshvedemel og bagepulver i en skål."
    },
    {
      "section": "Spinatvafler",
      "text": "Skyl spinaten. Kom den i en blender sammen med æg, mælk, smør, salt, peber, citronskal og lidt citronsaft og blend, til dejen er helt glat. Hæld det tørre mel i blenderen og kør den kort igen, til dejen er jævn."
    },
    {
      "section": "Spinatvafler",
      "text": "Lad dejen hvile i cirka 15 minutter, så den tykner lidt."
    },
    {
      "section": "Spinatvafler",
      "text": "Smør vaffeljernet let med olie eller smør. Bag vaflerne gyldne og helt færdige."
    },
    {
      "section": "Servering",
      "text": "Knæk den seje ende af aspargesne. Brun lidt smør på en varm pande, og vend aspargesne hurtigt i smørret i højst 1 minut."
    },
    {
      "section": "Servering",
      "text": "Læg rucola på vaflerne, og top med asparges, avocado, rejer, hampefrø og dild. Server med urtedressingen."
    }
  ],
  "changes": []
