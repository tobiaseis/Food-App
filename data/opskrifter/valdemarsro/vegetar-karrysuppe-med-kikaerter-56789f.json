  "steps": [
    {
      "section": "Suppen",
      "text": "Varm en stor gryde op på middelvarme. Rist karry og spidskommen under omrøring i cirka et minut, til det dufter."
    },
    {
      "section": "Suppen",
      "text": "Tilsæt olie, løg, hvidløg og porre, og svits, til løgene er bløde."
    },
    {
      "section": "Suppen",
      "text": "Kom broccoli, kikærter, peberfrugt og fond i gryden. Pisk majsstivelsen ud i fløden, og rør det i suppen."
    },
    {
      "section": "Suppen",
      "text": "Bring suppen i kog, og lad den koge et par minutter, mens du rører. Sænk varmen, og kom tomaterne i. Læg låg på, så suppen holder varmen."
    },
    {
      "section": "Til servering",
      "text": "Kog risene efter anvisningen på pakken."
    },
    {
      "section": "Til servering",
      "text": "Steg halloumien i olie på en pande, til skiverne er gyldne og har fået en flot skorpe."
    },
    {
      "section": "Til servering",
      "text": "Smag suppen til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Anret suppen i dybe tallerkener med ris og halloumi. Drys med chiliflager og persille."
    }
  ],
