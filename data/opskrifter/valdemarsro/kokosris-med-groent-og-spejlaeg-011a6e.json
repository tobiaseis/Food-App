  "steps": [
    {
      "section": "Syltede gulerødder",
      "text": "Hav gulerødderne i lange, tynde bånd med en skræller."
    },
    {
      "section": "Syltede gulerødder",
      "text": "Bring vand, riseddike, sukker og chiliflager i kog i en gryde, og rør, til sukkeret er opløst."
    },
    {
      "section": "Syltede gulerødder",
      "text": "Tag gryden af blusset, og læg gulerodsbåndene i den varme lage. Fyld dem over på glas med låg, og stil dem i køleskabet, mens du laver resten."
    },
    {
      "section": "Kokosris",
      "text": "Varm sesamolie, sesamfrø og ingefær i en gryde ved lav varme, til det begynder at dufte. Ingefæren må ikke brune."
    },
    {
      "section": "Kokosris",
      "text": "Hæld vand, kokosmælk, ris og salt i, og rør rundt. Sæt låg på, og lad det langsomt nå kogepunktet."
    },
    {
      "section": "Kokosris",
      "text": "Lad risen simre under låg ved svag varme i 10 minutter. Træk gryden til side, og lad risen trække med låg på i yderligere 10 minutter."
    },
    {
      "section": "Grøntsager og spejlæg",
      "text": "Svits løg og hvidløg i lidt af sesamolien på en pande ved middelvarme, til løgene er blødt. Vend spinaten i, og rør, til den falder sammen."
    },
    {
      "section": "Grøntsager og spejlæg",
      "text": "Læg spinaten over på en tallerken, og drys sojasauce over."
    },
    {
      "section": "Grøntsager og spejlæg",
      "text": "Gør panden rigtig varm med resten af sesamolien, og slå æggene ud på den. Steg dem, til hviden er stivnet og kanten er sprød, mens blommen stadig er flydende."
    },
    {
      "section": "Dressing",
      "text": "Pisk mayonnaise, creme fraiche og sriracha sammen i en skål, og krydr med salt og peber."
    },
    {
      "section": "Til anretning",
      "text": "Anret risen på tallerkener, og læg spinat, syltede gulerødder og spejlæg ovenpå."
    },
    {
      "section": "Til anretning",
      "text": "Strø sesamfrø, chiliflager og persille over. Server dressingen ved siden af, så hver kan hælde over efter behag."
    }
  ],
