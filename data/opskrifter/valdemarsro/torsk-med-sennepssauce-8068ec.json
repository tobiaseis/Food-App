  "steps": [
    {
      "section": "Tilbehør",
      "text": "Kog kartoflerne i let saltet vand, til de er møre. Læg bacon, æg, rødbeder og peberrod frem i hver sin lille skål."
    },
    {
      "section": "Torsk",
      "text": "Tænd ovnen på 175 °C varmluft. Del torsken i otte stykker, eller lad den ligge som ét stykke, og læg den i et ovnfast fad."
    },
    {
      "section": "Torsk",
      "text": "Fordel små klatter af smørret over fisken, og drys med salt og peber."
    },
    {
      "section": "Torsk",
      "text": "Bag fisken i 10-12 minutter. Kig til den efter 10 minutter – den er færdig, når den lige er mør."
    },
    {
      "section": "Sennepssauce",
      "text": "Smelt resten af smørret i en gryde, og rør melet ud i det til en jævn bolle."
    },
    {
      "section": "Sennepssauce",
      "text": "Pisk mælk og hvidvin i lidt ad gangen. Lad saucen koge op, til den er cremet."
    },
    {
      "section": "Sennepssauce",
      "text": "Rør sennep i, og smag til med honning, citronsaft, citronskal, salt og peber. Tilsæt mere sennep, hvis du vil have mere smag."
    },
    {
      "section": "Servering",
      "text": "Anret den varme torsk med de lune kartofler, saucen og tilbehøret. Slut af med et let drys dild."
    }
  ],
  "changes": []
