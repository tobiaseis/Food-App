  "steps": [
    {
      "section": "Estragonsmør",
      "text": "Hak estragonen helt fint. Rør den sammen med smør, citronsaft og hvidløg, og smag til med citronskal, salt og peber."
    },
    {
      "section": "Estragonsmør",
      "text": "Kom smørret i en skål, og stil det på køl i mindst 1 time, før det skal serveres."
    },
    {
      "section": "Kartofler",
      "text": "Varm ovnen op til 200 °C. Skrub kartoflerne grundigt, og tør dem godt."
    },
    {
      "section": "Kartofler",
      "text": "Vend kartoflerne i olie og salt, og bag dem i 25-35 minutter, til de er møre."
    },
    {
      "section": "Entrecote",
      "text": "Tag bøfferne ud af køleskabet ca. 45 minutter før grillning, så de når stuetemperatur."
    },
    {
      "section": "Entrecote",
      "text": "Pensl bøfferne med lidt olivenolie, og læg dem på den varme grill over direkte varme. Grill dem ca. 2 minutter på hver side."
    },
    {
      "section": "Entrecote",
      "text": "Er bøfferne meget tykke, eller skal de være mere end medium, så flyt dem over på indirekte varme i 1-2 minutter pr. side."
    },
    {
      "section": "Entrecote",
      "text": "Smag bøfferne til med flagesalt og friskkværnet peber, og server dem med en skefuld estragonsmør."
    },
    {
      "section": "Salat",
      "text": "Knæk den hårde ende af aspargesene. Steg dem i 30 sekunder i smør på en varm pande."
    },
    {
      "section": "Salat",
      "text": "Vend asparges med salat og oliven, og smag til med salt og peber. Drys med parmesan."
    }
  ],
