  "steps": [
    {
      "section": "Til dressingen",
      "text": "Rør alle ingredienserne til dressingen sammen, og smag til med salt og peber."
    },
    {
      "section": "Croutoner",
      "text": "Gnid brødskiverne med hvidløgsfeddet på begge sider, og smør dem på begge sider. Skær dem i firkanter."
    },
    {
      "section": "Croutoner",
      "text": "Rist firkanterne på en pande, til de er sprøde hele vejen rundt. Drys med flagesalt, og stil dem til side."
    },
    {
      "section": "Krydret kød med cheddar",
      "text": "Svits løgene i olien på en pande, til de er bløde."
    },
    {
      "section": "Krydret kød med cheddar",
      "text": "Tilsæt oksekødet, og brun det godt ved høj varme, mens du rører rundt. Krydr med røget paprika, spidskommen, salt og peber, og smag til."
    },
    {
      "section": "Krydret kød med cheddar",
      "text": "Strø cheddaren over kødet, og lad den smelte uden omrøring. Tag panden af varmen."
    },
    {
      "section": "Anretning",
      "text": "Læg salat, rucola, tomat, cornichoner, agurk og rødløg på tallerkener. Top med det krydrede kød og den smeltede ost, og afslut med dressing og croutoner."
    }
  ],
