  "steps": [
    {
      "section": null,
      "text": "Varm olivenolien i en gryde ved middelvarme. Svits løg og hvidløg, til de er møre."
    },
    {
      "section": null,
      "text": "Bland mel med safran, koriander, kanel, nellike, spidskommen, salt og peber. Vend kyllingen i halvdelen af blandingen."
    },
    {
      "section": null,
      "text": "Brun kyllingen på alle sider i gryden. Læg den over på en tallerken."
    },
    {
      "section": null,
      "text": "Rør resten af melblandingen ud i løgene. Tilsæt tomater, fond, dadler og abrikoser, og rør det hele godt sammen."
    },
    {
      "section": null,
      "text": "Læg kyllingen tilbage i gryden med skindsiden opad. Strø mandler, kikærter og citronskal over, og pres citronsaften ud over."
    },
    {
      "section": null,
      "text": "Sæt låg på og stil gryden i en kold ovn. Tænd for 150 °C, og lad retten simre i 2 timer."
    },
    {
      "section": null,
      "text": "Smag saucen til med salt og peber. Server med ris og drys med hakket koriander og mynte."
    }
  ],
  "changes": []
