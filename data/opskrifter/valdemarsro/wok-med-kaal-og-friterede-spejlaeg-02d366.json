  "steps": [
    {
      "section": "Woksaucen",
      "text": "Rør alle ingredienserne til woksaucen sammen."
    },
    {
      "section": "Woksaucen",
      "text": "Kom kål, løg og gulerødder i en stor skål, og vend dem med saucen."
    },
    {
      "section": "Spejlæg",
      "text": "Varm wokken eller en pande op ved høj varme med olie, til den er brandvarm."
    },
    {
      "section": "Spejlæg",
      "text": "Slå æggene ud i olien, og steg dem ved høj varme, til hviden er sprød i bunden, og blommen stadig er blød. Læg dem på en tallerken."
    },
    {
      "section": "Wokken",
      "text": "Tilsæt lidt mere olie i den varme wok. Kom grøntsagerne med sauce i, og rør dem hurtigt rundt i cirka 1 minut, til kålen falder sammen og er mør."
    },
    {
      "section": "Servering",
      "text": "Anret woken på tallerkener, og læg de sprøde spejlæg ovenpå. Drys med salt, peber, chiliflager, forårsløg og sesamfrø."
    }
  ],
