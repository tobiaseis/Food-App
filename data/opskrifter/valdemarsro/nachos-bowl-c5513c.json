  "steps": [
    {
      "section": "Tortillaskåle",
      "text": "Forvarm ovnen til 175 °C varmluft. Klæd en bageplade med bagepapir, og vend små ovnfaste skåle om på den."
    },
    {
      "section": "Tortillaskåle",
      "text": "Smør tortillaerne med olivenolie på begge sider, hvis det er nødvendigt, og læg dem over skålene, så de former sig som skåle."
    },
    {
      "section": "Tortillaskåle",
      "text": "Bag dem i 8-10 minutter, til de er let gyldne."
    },
    {
      "section": "Tortillaskåle",
      "text": "Lad skålene køle af på formene, så de bliver sprøde."
    },
    {
      "section": "Bønnefyld",
      "text": "Svits løg i olivenolie i en gryde ved middelvarme, og rør ofte, til de er møre."
    },
    {
      "section": "Bønnefyld",
      "text": "Kom hvidløg, squash, gulerødder, krydderier, tomatpuré og hakkede tomater i gryden, og bring det i kog."
    },
    {
      "section": "Bønnefyld",
      "text": "Lad det simre uden låg i 15 minutter."
    },
    {
      "section": "Bønnefyld",
      "text": "Rør kidneybønnerne i, og lad det koge op igen. Smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Smelt smørret på en lille pande. Rist majsen ved høj varme, til den får en smule farve."
    },
    {
      "section": "Til servering",
      "text": "Fyld tortillaskålene med bønnefyldet. Top med avocado, majs og cheddar, og pres lidt lime over."
    }
  ],
