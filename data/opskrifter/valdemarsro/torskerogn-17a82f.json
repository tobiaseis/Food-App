  "steps": [
    {
      "section": "Til kogningen",
      "text": "Svøb rognen i bagepapir, og surr køkkensnor om pakken, så den holder sammen."
    },
    {
      "section": "Til kogningen",
      "text": "Kom pakken i en gryde, og dæk med koldt vand. Tilsæt salt, løg, laurbærblade, eddike, timian og peber."
    },
    {
      "section": "Til kogningen",
      "text": "Bring vandet i kog, og skru så ned, så det lige netop simrer. Læg låg på, og lad rognen simre i 25 minutter – længere tid, hvis rognen er stor."
    },
    {
      "section": "Til kogningen",
      "text": "Tag gryden af varmen, og lad rognen køle af i lagen."
    },
    {
      "section": "Til stegningen",
      "text": "Rognen kan spises kold, som den er. Vil du have den sprød, så skær den i skiver, og vend dem i hvedemel blandet med salt og peber."
    },
    {
      "section": "Til stegningen",
      "text": "Varm smør og olie op på en pande, og steg skiverne gyldne og sprøde på begge sider."
    },
    {
      "section": "Til servering",
      "text": "Anret rognen på rugbrød med remoulade og citronbåde. Top med dild, og smag til med salt og peber."
    }
  ],
  "changes": []
