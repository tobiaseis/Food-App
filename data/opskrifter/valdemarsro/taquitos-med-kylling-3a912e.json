  "steps": [
    {
      "section": "Ananassalsa",
      "text": "Bland ananas, avocado, mynte og basilikum i en skål. Tilsæt limesaft, limeskal og chili, og smag til med salt og peber."
    },
    {
      "section": "Avocadocreme",
      "text": "Blend avocado, creme fraiche, citronsaft og citronskal i en minihakker, til det er en glat dip. Krydr med chiliflager, salt og peber, og kør den igen, så alt er blandet."
    },
    {
      "section": "Taquitos",
      "text": "Varm en pande op med lidt af olivenolien, og steg hakkekødet under omrøring, til det er gennemstegt."
    },
    {
      "section": "Taquitos",
      "text": "Kom løg, oregano, begge slags paprika, spidskommen og jalapeños i panden. Skru ned på middelvarme, og lad det simre et par minutter."
    },
    {
      "section": "Taquitos",
      "text": "Rør majsstivelsen ud i de hakkede tomater, og hæld det på panden. Lad fyldet simre under omrøring i et par minutter, til det er tyknet."
    },
    {
      "section": "Taquitos",
      "text": "Varm tortillaerne på en tør pande, til de er bløde og smidige. Pensl dem med olivenolie på begge sider. Forvarm ovnen til 225 °C varmluft."
    },
    {
      "section": "Taquitos",
      "text": "Læg en stribe kyllingefyld og ost ned ad midten af hver tortilla. Fold siderne ind, og rul dem stramt. Læg dem med samlingen nedad på en bageplade med bagepapir."
    },
    {
      "section": "Taquitos",
      "text": "Bag taquitos i 5-7 minutter. Vend dem, og bag dem 5 minutter mere, til osten er smeltet, og de er sprøde."
    },
    {
      "section": "Taquitos",
      "text": "Server de varme taquitos med ananassalsa og avocadocreme."
    }
  ],
  "changes": [
    "Hakket kylling er skiftet til hakket kyllingekød.",
    "Tortillapandekager er skiftet til tortillas."
  ]
