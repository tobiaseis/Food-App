  "steps": [
    {
      "section": null,
      "text": "Varm olien i en gryde på middellav varme. Svits løg og hvidløg i 5-6 minutter, til løgene er blanke og bløde."
    },
    {
      "section": null,
      "text": "Kom risene i gryden og rør rundt, til alle kornene er dækket af olie. Hæld hvidvinen over og rør, til risene har optaget den."
    },
    {
      "section": null,
      "text": "Tilsæt fonden lidt ad gangen, og rør løbende. Fortsæt, til risene er lige akkurat møre, og risottoen er cremet."
    },
    {
      "section": null,
      "text": "Knæk de træede ender af aspargesene og smid dem ud. Knæk resten i stykker på 3-4 cm."
    },
    {
      "section": null,
      "text": "Smelt smørret på en pande, til det holder op med at boble. Steg aspargesene hurtigt i ca. 1 minut ved høj varme, og tag dem af varmen. Gem lidt til pynt."
    },
    {
      "section": null,
      "text": "Vend den første portion parmesan, de stegte asparges og persillen ned i risottoen. Smag til med citronskal, lidt citronsaft, salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Anret risottoen og top med resten af parmesan, de reserverede asparges og et drys persille."
    }
  ],
  "changes": []
