  "steps": [
    {
      "section": "Kylling med lime og ingefær",
      "text": "Riv skallen af de to lime og gem den til senere. Pres limerne, og rør saften sammen med ingefær, sojasauce og honning til en jævn marinade."
    },
    {
      "section": "Kylling med lime og ingefær",
      "text": "Vend kyllingetern i marinaden, og lad dem stå køligt i mindst 30 minutter – gerne natten over."
    },
    {
      "section": "Kylling med lime og ingefær",
      "text": "Varm sesamolien op på en pande ved høj varme, og brun kyllingen under omrøring. Sænk til middel varme, og steg, til kyllingen er gennemstegt. Læg den på en tallerken, og lad den køle til stuetemperatur."
    },
    {
      "section": "Mango- og avocadosalsa",
      "text": "Kom mango, avocado, koriander og basilikum i en skål, og mas det let med en gaffel. Salsaen skal være grov med hele stykker frugt, men også lidt smattet."
    },
    {
      "section": "Mango- og avocadosalsa",
      "text": "Smag til med limesaft og limeskal fra den anden lime, chili, salt og peber."
    },
    {
      "section": "Til rullerne",
      "text": "Fyld et stort fad med vand. Dyp et rispapir i vandet, til det er blødt, og læg det på bordet."
    },
    {
      "section": "Til rullerne",
      "text": "Læg en stribe kylling, salsa, gulerod, agurk og forårsløg midt på papiret, og drys med lidt chili og limeskal. Fold siderne ind over fyldet, og rul det stramt sammen. Gentag med resten af rispapiret."
    },
    {
      "section": "Til servering",
      "text": "Server rullerne med hoisinsauce og sød chilisauce. Det, der er til overs af salsa og grønt, kan stå ved siden af som tilbehør."
    }
  ],
