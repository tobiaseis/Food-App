  "steps": [
    {
      "section": "Marinade",
      "text": "Fjern citrongræsstilkens yderste blade, og skær begge ender af. Snit resten af stilken helt fint."
    },
    {
      "section": "Marinade",
      "text": "Rør citrongræs, hvidløg, ingefær, sriracha, honning og den første portion sesamolie sammen i en skål. Vend rejerne i marinaden."
    },
    {
      "section": "Wok",
      "text": "Varm en wok eller stor pande op. Rist rejerne i cirka 1 minut, mens du rører rundt."
    },
    {
      "section": "Wok",
      "text": "Tilsæt smør, salt og peber, og steg videre, til rejerne er lyserøde og har fået en let stegeskorpe. Læg dem over på en tallerken."
    },
    {
      "section": "Wok",
      "text": "Hæld den resterende olie på wokken. Steg broccoli, spinat, gulerødder og cashewnødder i et par minutter."
    },
    {
      "section": "Til servering",
      "text": "Anret risene i dybe skåle, og fordel grøntsager og rejer ovenpå."
    },
    {
      "section": "Til servering",
      "text": "Strø basilikum, forårsløg og chiliflager over, og server med limebåde til at presse over."
    }
  ],
  "changes": []
