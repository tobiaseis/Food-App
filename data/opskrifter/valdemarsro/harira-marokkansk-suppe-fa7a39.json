  "steps": [
    {
      "section": "Ristede kikærter",
      "text": "Forvarm ovnen til 175 °C varmluft. Fordel en del af de drænede kikærter på en bageplade med bagepapir, og vend dem med olivenolie, røget paprika og flagesalt."
    },
    {
      "section": "Ristede kikærter",
      "text": "Bag kikærterne i 20-25 minutter, og rør rundt i dem et par gange undervejs. Stil dem til side."
    },
    {
      "section": "Suppe",
      "text": "Rist spidskommen og koriander i en tør, varm gryde, mens du rører, til krydderierne dufter."
    },
    {
      "section": "Suppe",
      "text": "Sænk varmen, og tilsæt olie, løg og hvidløg. Svits under omrøring, til løgene er bløde."
    },
    {
      "section": "Suppe",
      "text": "Kom bladselleri, tomatpuré, hakkede tomater, squash, gurkemeje, ingefær, chili, begge slags paprika, safran, fond, resten af kikærterne og linserne i gryden."
    },
    {
      "section": "Suppe",
      "text": "Bring suppen i kog under omrøring. Læg låg på, skru ned, og lad den simre i 20-25 minutter."
    },
    {
      "section": "Suppe",
      "text": "Smag suppen til med citronsaft, salt og peber. Server den varm med de ristede kikærter, mynte og persille ovenpå."
    }
  ],
  "changes": [
    "Grøntsagsbouillon er skiftet til grøntsagsfond.",
    "Frisk chili er skrevet som rød chili i stk."
  ]
