  "steps": [
    {
      "section": null,
      "text": "Varm ovnen op til 175 °C varmluft. Læg bagepapir på en bageplade, og læg laksen på."
    },
    {
      "section": null,
      "text": "Krydr laksen med salt og peber, og bag den i 10 minutter. Strø mandlerne over, og bag den i cirka 5 minutter mere, til den næsten er gennemstegt."
    },
    {
      "section": null,
      "text": "Kog pastaen, mens laksen bager. Følg tiden på pakken."
    },
    {
      "section": null,
      "text": "Varm olivenolien op på en pande, og svits løg og hvidløg, til de er bløde og klare."
    },
    {
      "section": null,
      "text": "Hæld fløden på panden, og lad den boble og koge lidt ind."
    },
    {
      "section": null,
      "text": "Træk skindet af laksen, og læg fisken i saucen. Lad det simre cirka et minut, til laksen er færdig. Smag til med salt, peber og basilikum."
    },
    {
      "section": null,
      "text": "Vend den varme pasta med en del af saucen. Anret på tallerkener, og top med resten af saucen og laksen."
    }
  ],
