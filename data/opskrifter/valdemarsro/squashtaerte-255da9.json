  "steps": [
    {
      "section": "Tærtedej",
      "text": "Bland begge slags mel med saltet. Smuldr smørret i, til det ligner grove krummer – det kan også gøres i en foodprocessor."
    },
    {
      "section": "Tærtedej",
      "text": "Tilsæt vandet, og sæt dejen sammen til en klump. Lad den helst hvile på køl i 15 minutter."
    },
    {
      "section": "Tærtedej",
      "text": "Tryk dejen ud i en smurt tærteform på ca. 27 cm i diameter, og prik bunden med en gaffel."
    },
    {
      "section": "Tærtedej",
      "text": "Forbag bunden i 10 minutter i ovnen, som er forvarmet til 175 °C varmluft."
    },
    {
      "section": "Fyld",
      "text": "Pisk æg, mælk, parmesan, hytteost, muskatnød, salt og peber sammen med et piskeris. Vend porreskiverne i."
    },
    {
      "section": "Fyld",
      "text": "Hæld fyldet i den forbagte bund. Læg squashskiverne ovenpå, og drys med parmesan."
    },
    {
      "section": "Fyld",
      "text": "Bag tærten i 30-40 minutter ved 175 °C varmluft, til fyldet er stivnet."
    }
  ],
