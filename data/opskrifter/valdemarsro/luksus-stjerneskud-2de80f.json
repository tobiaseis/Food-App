  "steps": [
    {
      "section": "Dressing",
      "text": "Bland creme fraiche, mayonnaise og tomatpuré. Krydr med salt, peber, citronsaft og paprika. Den røgede paprika giver ekstra smag."
    },
    {
      "section": "Dampet fisk",
      "text": "Varm ovnen op til 175 °C varmluft. Krydr fire af fileterne med salt og peber, og rul dem op."
    },
    {
      "section": "Dampet fisk",
      "text": "Læg rullerne i et smurt ovnfast fad, og hæld hvidvinen over. Læg en ovnfast tallerken over fadet, og bag i 10-15 minutter."
    },
    {
      "section": "Stegt fisk",
      "text": "Tør de øvrige fileter med køkkenrulle, og vend dem i melet. Pisk ægget i en dyb tallerken, og bland rasp med salt og peber på en anden."
    },
    {
      "section": "Stegt fisk",
      "text": "Dyp fileterne først i æg og så i rasp. Steg dem gyldne i smør og olie på en pande."
    },
    {
      "section": "Asparges",
      "text": "Skræl de hvide asparges med en tyndskræller, og skær de trævlede ender af. Kog dem i 3 minutter i letsaltet vand med peber og en citronbåd."
    },
    {
      "section": "Asparges",
      "text": "Bryd de hårde ender af de grønne asparges. Smelt lidt smør på en varm pande, og steg aspargesene i 1-2 minutter. Smag til med salt og peber."
    },
    {
      "section": "Asparges",
      "text": "Skær alle aspargesene i passende stykker."
    },
    {
      "section": "Anretning",
      "text": "Smør brødet, og læg salat på. Fordel dampet og stegt fisk, rejer, asparges og stenbiderrogn ovenpå."
    },
    {
      "section": "Anretning",
      "text": "Top med dressing, dild, agurk og citronbåde. Drys med flagesalt og friskkværnet peber."
    }
  ],
