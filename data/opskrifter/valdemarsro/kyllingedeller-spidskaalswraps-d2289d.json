  "steps": [
    {
      "section": "Frikadeller",
      "text": "Bland kylling, æg, havregryn, squash, æble, hvidløg, soltørrede tomater, timian, salt og peber grundigt i en skål."
    },
    {
      "section": "Frikadeller",
      "text": "Lad farsen hvile på køl i cirka en halv time."
    },
    {
      "section": "Frikadeller",
      "text": "Form farsen til små frikadeller."
    },
    {
      "section": "Frikadeller",
      "text": "Brun frikadellerne på en pande i olie og smør, cirka 5 minutter på hver side, til de er helt gennemstegte."
    },
    {
      "section": "Frikadeller",
      "text": "Vil du hellere bruge ovnen: Pensl frikadellerne med lidt olie og bag dem cirka 20 minutter ved 180 °C varmluft i en forvarmet ovn. Vend dem et par gange undervejs."
    },
    {
      "section": "Dilddressing",
      "text": "Rør creme fraiche, dild og sennep sammen, og smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Læg salat, frikadeller, agurk, rødløg og krydderurter i spidskålsbladene."
    },
    {
      "section": "Til servering",
      "text": "Top med dilddressingen."
    }
  ],
