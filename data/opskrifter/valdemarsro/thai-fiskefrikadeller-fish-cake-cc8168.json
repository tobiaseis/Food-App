  "steps": [
    {
      "section": "Dip",
      "text": "Bland alle ingredienserne til dippen i en skål. Rør rundt et par gange, så sukkeret opløses, og lad dippen stå fremme og trække, mens du laver frikadellerne."
    },
    {
      "section": "Fiskefrikadeller",
      "text": "Læg alt til frikadellerne i en blender eller foodprocessor, bortset fra bønnerne og forårsløgene."
    },
    {
      "section": "Fiskefrikadeller",
      "text": "Kør farsen, til den hænger sammen, men stadig er lidt grov og ikke helt glat."
    },
    {
      "section": "Fiskefrikadeller",
      "text": "Vend de hakkede bønner og forårsløg i farsen med en ske."
    },
    {
      "section": "Fiskefrikadeller",
      "text": "Form farsen til frikadeller. Varm olie på en pande, og steg frikadellerne i 5-7 minutter på hver side."
    },
    {
      "section": "Fiskefrikadeller",
      "text": "Server frikadellerne med dippen."
    }
  ],
