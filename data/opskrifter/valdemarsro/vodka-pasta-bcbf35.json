  "steps": [
    {
      "section": null,
      "text": "Varm olien i en pande ved middelvarme, og blød løgene op i den."
    },
    {
      "section": null,
      "text": "Skru op på høj varme, hæld vodkaen på, og lad den koge væk i ca. et halvt minut. Hold øje med panden, så den ikke bliver tør."
    },
    {
      "section": null,
      "text": "Mos de flåede tomater i en dyb tallerken, og rør tomatpuréen ud i dem. Kom blandingen på panden, skru ned på middelvarme, og lad den simre, til tomaterne er koget lidt ind og er blevet cremede."
    },
    {
      "section": null,
      "text": "Kog imens pastaen i let saltet vand, til den er mør."
    },
    {
      "section": null,
      "text": "Rør fløden i saucen, og lad den koge op igen."
    },
    {
      "section": null,
      "text": "Smag saucen til med salt, peber og den første parmesan. Vend den kogte pasta i saucen."
    },
    {
      "section": null,
      "text": "Anret på tallerkener, og drys med den resterende parmesan og persille."
    }
