  "steps": [
    {
      "section": "Bønnebøffer",
      "text": "Blend bønnerne kort i en foodprocessor, til de er groft hakkede."
    },
    {
      "section": "Bønnebøffer",
      "text": "Vend bønnerne sammen med æg, spidskommen, persille, koriander, cayennepeber, hvidløg, løg og hvedemel. Smag til med salt og peber."
    },
    {
      "section": "Bønnebøffer",
      "text": "Form blandingen til fire bøffer."
    },
    {
      "section": "Bønnebøffer",
      "text": "Varm olie og smør på en pande. Steg bøfferne 2-3 minutter på første side, til de har fået en fast skorpe og kan vendes uden at gå i stykker."
    },
    {
      "section": "Bønnebøffer",
      "text": "Vend bøfferne, læg en skive cheddar på hver, og steg dem færdige."
    },
    {
      "section": "Burgerne",
      "text": "Steg portobellosvampene kort ved høj varme på en grillpande eller på grillen. Pensl dem med olie og vend dem, så begge sider får farve."
    },
    {
      "section": "Burgerne",
      "text": "Læg en svamp som bund, og top med bønnebøf, salat, tomat, agurk, avocado, ketchup, mayonnaise og rødløg. Slut med endnu en svamp som låg."
    }
  ],
  "changes": []
