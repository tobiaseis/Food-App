  "steps": [
    {
      "section": "Chiligryden",
      "text": "Varm olien op i en gryde, og svits løg og hvidløg, til de er møre."
    },
    {
      "section": "Chiligryden",
      "text": "Rør spidskommen, koriander og chiliflager ned i løgene, og lad dem vågne i et minut, til det dufter."
    },
    {
      "section": "Chiligryden",
      "text": "Brun oksekødet i gryden. Hæld hakkede tomater, soltørrede tomater og bouillon over, og kom squash og gulerødder i."
    },
    {
      "section": "Chiligryden",
      "text": "Sæt låg på, og lad chiliens simre i cirka 30 minutter."
    },
    {
      "section": "Græskarrene",
      "text": "Sæt ovnen på 175 °C varmluft. Skrub græskarrene, del dem på midten, og skrab kernerne ud."
    },
    {
      "section": "Græskarrene",
      "text": "Læg græskarhalvdelene på en bageplade med bagepapir, og forbag dem i 25 minutter."
    },
    {
      "section": "Samling",
      "text": "Vend bønnerne i chiliens, og smag til med chokolade, salt og peber."
    },
    {
      "section": "Samling",
      "text": "Fordel chiliens i de forbagte græskar, og top med revet cheddar."
    },
    {
      "section": "Samling",
      "text": "Bag græskarrene færdige i ovnen ved 175 °C varmluft i 15-20 minutter. Server med frisk koriander over."
    }
  ],
