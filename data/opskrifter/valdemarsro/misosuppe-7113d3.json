  "steps": [
    {
      "section": "Suppen",
      "text": "Rør miso, ingefær og limesaft sammen i en gryde, til massen er helt glat."
    },
    {
      "section": "Suppen",
      "text": "Lad det kogende vand køle af til ca. 90 grader, og rør det ud i misoblandingen."
    },
    {
      "section": "Suppen",
      "text": "Rør bouillonen i. Hold suppen varm på svag varme ved ca. 90 grader – den må ikke koge."
    },
    {
      "section": "Fyld",
      "text": "Varm en pande op ved høj varme med olien. Steg svampene, til de er gyldenbrune og har fået en flot skorpe."
    },
    {
      "section": "Fyld",
      "text": "Kog nudlerne efter pakkens anvisning. Er edamamebønnerne frosne, skal de tøes op med kogende vand over dem."
    },
    {
      "section": "Fyld",
      "text": "Fordel nudler, edamamebønner, svampe, forårsløg, spirer og spinat i skåle. Hæld den varme suppe over, og server med det samme."
    }
