  "steps": [
    {
      "section": "Pizzadej",
      "text": "Rør gæren ud i det lunkne vand i en skål."
    },
    {
      "section": "Pizzadej",
      "text": "Tilsæt halvdelen af melet sammen med olien og saltet, og rør, til det er jævnt. Rør resten af melet i lidt ad gangen."
    },
    {
      "section": "Pizzadej",
      "text": "Vend dejen ud på et meldrysset bord, og ælt den med hænderne, til den er smidig."
    },
    {
      "section": "Pizzadej",
      "text": "Skyl skålen, og gnid den ind med olie. Læg dejen i, og vend den rundt, så den får olie hele vejen rundt. Olien gør dejen let at arbejde med og giver en sprødere bund."
    },
    {
      "section": "Pizzadej",
      "text": "Lad dejen hæve under låg eller klædet i 45-60 minutter. Den kan også koldhæve i køleskabet natten over."
    },
    {
      "section": "Pizzasauce",
      "text": "Blend alle ingredienserne til sauceholdig, jævn masse. Du skal bruge 1-2 spsk pr. pizza. Resten kan fryses i små portioner."
    },
    {
      "section": "Topping",
      "text": "Læg parmaskinken på en bageplade med bagepapir, og bag den ved 200 °C i 7-10 minutter, til den er sprød."
    },
    {
      "section": "Topping",
      "text": "Skru derefter ovnen til den højeste temperatur, og sæt en bageplade, et bagestål eller en pizzasten på øverste rille, så den varmer op."
    },
    {
      "section": "Topping",
      "text": "Dryp mozzarellaen af, dup den tør med køkkenrulle, og skær den i mindre stykker."
    },
    {
      "section": "Topping",
      "text": "Del dejen i to, og form to runde pizzabunde på et meldrysset bord. Smør saucen ud over dem."
    },
    {
      "section": "Topping",
      "text": "Læg et tyndt lag skinke, mozzarella, gorgonzola og æbleskiver på hver pizza."
    },
    {
      "section": "Topping",
      "text": "Skift ovnen til grill, og bag pizzaerne i 4-5 minutter. Hold øje med dem undervejs."
    },
    {
      "section": "Topping",
      "text": "Top med rucola, og server straks."
    }
  ],
  "changes": [
    "Koncentreret tomatpuré er ændret til almindelig tomatpuré."
