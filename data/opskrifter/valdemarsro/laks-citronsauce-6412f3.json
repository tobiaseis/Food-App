  "steps": [
    {
      "section": "Laks",
      "text": "Forvarm ovnen til 175 °C varmluft. Klæd et ovnfast fad med bagepapir, og læg laksen i fadet."
    },
    {
      "section": "Laks",
      "text": "Krydr laksen med salt og peber, og strø citronskal og hvidløg over. Bag den i 16-18 minutter."
    },
    {
      "section": "Kapers og citronsauce",
      "text": "Smelt smørret i en gryde ved middel varme. Svits hvidløget under omrøring, til det dufter, men uden at det får farve."
    },
    {
      "section": "Kapers og citronsauce",
      "text": "Sænk varmen, og rør citronsaft, citronskal og kapers i. Smag til med salt og peber. Lad saucen trække, mens laksen bager, og pastaen koger al dente."
    },
    {
      "section": "Kapers og citronsauce",
      "text": "Skru op til middel varme, og rør yoghurten i. Bliv ved med at røre, og lad saucen ikke koge, da den ellers skiller. Den skal kun være glat og lun."
    },
    {
      "section": "Til servering",
      "text": "Vend den kogte pasta med et par spsk af saucen. Anret på tallerkener, og læg laks og resten af saucen ovenpå."
    },
    {
      "section": "Til servering",
      "text": "Top med peber, kapers og hakket persille."
    }
  ],
  "changes": [
    "Bredbladet persille er skiftet til fladbladet persille."
  ]
}
