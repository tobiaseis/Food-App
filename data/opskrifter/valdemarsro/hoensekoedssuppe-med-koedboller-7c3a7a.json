  "steps": [
    {
      "section": "Suppen",
      "text": "Anbring suppehønen i en stor gryde, og fyld med koldt vand, til den lige er dækket."
    },
    {
      "section": "Suppen",
      "text": "Bring vandet i kog, og øs skummet af løbende. Fortsæt, til skummet ikke kommer igen, og vandet er klart."
    },
    {
      "section": "Suppen",
      "text": "Tilsæt salt, og skum en gang til, når der kommer nye urenheder."
    },
    {
      "section": "Suppen",
      "text": "Kom gulerødder, porre, pastinak, bladselleri, hvidløg, løg, persille, laurbærblade, timian og peber i gryden. Fyld om nødvendigt mere vand på, så alt er dækket."
    },
    {
      "section": "Suppen",
      "text": "Læg låg på, og lad suppen simre ved lav varme i 3-4 timer, til hønen er helt mør."
    },
    {
      "section": "Suppen",
      "text": "Sigt suppen over i en skål, og fjern fedt og urenheder fra overfladen. Tag hønekødet af benene, hvis du vil have det med i suppen."
    },
    {
      "section": "Kødboller",
      "text": "Rør hakket svinekød, æg, løg, mel og mælk sammen til en jævn farce med en håndmixer."
    },
    {
      "section": "Kødboller",
      "text": "Form små boller af farcen med en teske. Kog dem i 5-7 minutter i den tynde grøntsagsfond."
    },
    {
      "section": "Til servering",
      "text": "Hæld den sigtede suppe i en ren gryde, og kom kødboller, de fine gulerodstern og porreringene i."
    },
    {
      "section": "Til servering",
      "text": "Varm suppen op, til den næsten koger. Server straks."
    }
  ],
  "changes": []
