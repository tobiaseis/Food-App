  "steps": [
    {
      "section": null,
      "text": "Varm olien op på en pande, og steg baconen sprød. Læg den over på køkkenrulle."
    },
    {
      "section": null,
      "text": "Drys kyllingen med salt og peber. Brun den på samme pande i lidt smør og baconfedtet, og kom den derefter sammen med baconen i et smurt ovnfast fad."
    },
    {
      "section": null,
      "text": "Sæt ovnen på 175 °C."
    },
    {
      "section": null,
      "text": "Svits løg, hvidløg og porre på panden ved middelvarme, indtil løgene er møre."
    },
    {
      "section": null,
      "text": "Rør hakkede tomater, tomatpuré, peberfrugt, tørret timian, flødeost og fløde i panden. Smag saucen til med salt og peber."
    },
    {
      "section": null,
      "text": "Hæld saucen over kyllingen i fadet, og bag det midt i ovnen i 20 minutter."
    },
    {
      "section": null,
      "text": "Hak persille og frisk timian, og drys rigeligt over retten lige før servering. Server med de kogte ris."
    }
  ],
