  "steps": [
    {
      "section": null,
      "text": "Rør kyllingekød, løg, æg, hvedemel og mælk sammen i en skål. Krydr med salt og peber, og rør, til farsen er helt ensartet."
    },
    {
      "section": null,
      "text": "Dæk skålen til og stil farsen på køl i 30 minutter."
    },
    {
      "section": null,
      "text": "Hæld olien på en pande, og varm den op. Kom smørret på, og lad det smelte og skumme, til boblerne lægger sig."
    },
    {
      "section": null,
      "text": "Brug en ske til at forme frikadellerne, og læg dem på panden. Steg dem 5-6 minutter på hver side, til de er gyldne og helt gennemstegte."
    }
