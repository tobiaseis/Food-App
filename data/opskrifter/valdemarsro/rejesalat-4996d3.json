  "steps": [
    {
      "section": "Dilddressing",
      "text": "Rør creme fraiche, mayonnaise, dild og citronsaft sammen til en jævn dressing."
    },
    {
      "section": "Dilddressing",
      "text": "Vend to tredjedele af rejerne i dressingen, og gem resten til drys."
    },
    {
      "section": "Salat",
      "text": "Bræk den trævlede nederste del af aspargesene af."
    },
    {
      "section": "Salat",
      "text": "Smelt smørret på en varm pande, og steg aspargesene hurtigt i cirka 1 minut. Tag dem af varmen."
    },
    {
      "section": "Salat",
      "text": "Læg spinat og feldsalat på et stort fad. Fordel kartofler, asparges, avocado og rødløg ovenpå."
    },
    {
      "section": "Salat",
      "text": "Kom rejerne i dressing på salaten med en ske. Top med de resterende rejer, dild, salt og peber."
    }
