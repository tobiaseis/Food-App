  "steps": [
    {
      "section": "Asiatisk dressing",
      "text": "Rør alle ingredienserne til dressingen sammen, og smag den til. Lad den stå og trække, mens du laver resten af salaten."
    },
    {
      "section": "Salat",
      "text": "Kog nudlerne som anvist på pakken. Si dem, og skyl dem grundigt i koldt vand."
    },
    {
      "section": "Salat",
      "text": "Vend nudlerne med halvdelen af spidskålen, halvdelen af gulerødderne og et par skefulde af dressingen."
    },
    {
      "section": "Salat",
      "text": "Læg nudelblandingen på et fad, og top med resten af spidskålen og gulerødderne samt mangoen. Hæld den resterende dressing ovenpå."
    },
    {
      "section": "Salat",
      "text": "Server salaten med koriander, mynte, forårsløg, peanuts og chili drysset over."
    }
  ],
