  "steps": [
    {
      "section": "Sød/sur chilidressing",
      "text": "Rør sukkeret ud i limesaften, til det er opløst. Tilsæt fiskesauce, hvidløg og chili."
    },
    {
      "section": "Sød/sur chilidressing",
      "text": "Smag dressingen til, og tilsæt lidt mere fiskesauce eller sukker, hvis den skal være sødere eller saltere."
    },
    {
      "section": "Nudelsalat",
      "text": "Kog nudlerne som angivet på pakken. Si dem, og skyl dem under koldt vand, så de ikke klistrer."
    },
    {
      "section": "Nudelsalat",
      "text": "Vend nudler, rødkål, spidskål og gulerødder med dressingen i en stor skål. Lad salaten stå og trække, mens du laver fiskekagerne."
    },
    {
      "section": "Asiatiske fiskekager",
      "text": "Ælt alle ingredienserne til fiskekagerne sammen i en stor skål, til farsen er fast og ensartet."
    },
    {
      "section": "Asiatiske fiskekager",
      "text": "Form farsen til fiskekager. Varm olie op på en pande ved middelvarme, og steg kagerne 5 minutter på hver side, til de er sprøde og gennemstegte."
    },
    {
      "section": "Til servering",
      "text": "Fordel nudelsalaten i skåle eller på tallerkener, og læg fiskekagerne ovenpå. Drys med peanuts, kokosflager, mynte og koriander."
    }
  ],
