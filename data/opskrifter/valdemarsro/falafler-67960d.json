  "steps": [
    {
      "section": "Falafler",
      "text": "Læg kikærterne i rigeligt koldt vand og lad dem trække i 12-24 timer. Skift gerne vandet en eller to gange. Skyl dem grundigt bagefter."
    },
    {
      "section": "Falafler",
      "text": "Blend kikærter, persille, hvidløg, løg, koriander, spidskommen, salt, peber, kartofler, æg, rasp, chili og citronsaft i en foodprocessor, til farsen er jævn."
    },
    {
      "section": "Falafler",
      "text": "Virker farsen for våd, så rør lidt groft mel eller ekstra rasp i, og lad den hvile et øjeblik."
    },
    {
      "section": "Falafler",
      "text": "Hold en ske i hånden og form farsen til runde falafler. Varm olien op i en gryde til 175-180 °C."
    },
    {
      "section": "Falafler",
      "text": "Kog falaflerne i små portioner, til de er gyldne og sprøde. Løft dem op med en hulske og lad dem dryppe af på køkkenrulle."
    },
    {
      "section": "Dressing",
      "text": "Rør cremefraiche med citronskal, saft fra citronen og salt efter smag."
    },
    {
      "section": "Til servering",
      "text": "Fyld pitabrødene med falafler, tomat, agurk, salat og dressing. Drys med flagesalt og server med citronsaft. Falaflerne er også gode alene som varme snacks."
    }
  ],
  "changes": [
