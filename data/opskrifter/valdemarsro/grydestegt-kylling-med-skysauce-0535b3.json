  "steps": [
    {
      "section": "Grydestegt kylling",
      "text": "Gør kyllingen ren og gnid den ind med salt og peber udvendigt. Put persillen ind i kyllingen."
    },
    {
      "section": "Grydestegt kylling",
      "text": "Varm smørret i en stegegryde ved middelhøj varme. Brun kyllingen pænt på alle sider i ca. 10 minutter."
    },
    {
      "section": "Grydestegt kylling",
      "text": "Hæld vandet i gryden og krydr med lidt salt og peber. Sæt låg på og lad kyllingen simre i 45-55 minutter. Vend den et par gange undervejs."
    },
    {
      "section": "Grydestegt kylling",
      "text": "Lav imens de øvrige retter. Kontrollér til sidst, at kyllingen er helt gennemstegt, før du løfter den op af gryden."
    },
    {
      "section": "Skysauce",
      "text": "Fjern skum og urenheder fra stegesky­en og hæld den over i en lille kasserolle. Læg kyllingen tilbage i gryden med låg, så den holder sig varm."
    },
    {
      "section": "Skysauce",
      "text": "Bring stegeskyen i kog. Rør hvedemelet ud med lidt koldt vand til en jævning, og pisk den ned i den kogende stegesky."
    },
    {
      "section": "Skysauce",
      "text": "Lad saucen koge godt igennem. Rør fløde og kulør i, og smag til med salt og peber."
    },
    {
      "section": "Syltede agurker",
      "text": "Rør sukker og salt ud i det kogende vand, til sukkeret er opløst. Lad det køle lidt af, og tilsæt derefter eddike, peberkorn og dild."
    },
    {
      "section": "Syltede agurker",
      "text": "Hyvl eller skær agurken i helt tynde skiver og læg dem i et rent, skoldet glas. Hæld lagen over, og lad det stå og trække i mindst 30 minutter."
    },
    {
      "section": "Rabarberkompot",
      "text": "Bland rabarber, vaniljesukker og sukker i en gryde. Lad det stå uden varme i en halv time, så der trækker saft."
    },
    {
      "section": "Rabarberkompot",
      "text": "Varm op under omrøring, til det koger. Lad det simre i 5-10 minutter, og tag gryden af varmen, så snart rabarberen er mør – den må ikke blive til mos."
    },
    {
      "section": "Salat med mormordressing",
      "text": "Rør citronsaft og sukker sammen, til sukkeret er væk. Tilsæt fløden og rør, til dressingen tykner lidt. Smag til med salt og peber, så den er både sød og syrlig."
    },
    {
      "section": "Salat med mormordressing",
      "text": "Pil salaten i stykker og vend den med dressingen lige før servering."
    },
    {
      "section": "Kogte nye kartofler",
      "text": "Skrub kartoflerne og læg dem i en gryde med koldt vand tilsat lidt salt. Bring i kog, sæt låg på og kog i 6-8 minutter, afhængigt af størrelsen."
    },
    {
      "section": "Kogte nye kartofler",
      "text": "Tag gryden af varmen og lad kartoflerne trække under låg i 5-8 minutter. Stik i en kartoffel for at tjekke, at den er mør, og hæld vandet fra."
    },
    {
      "section": "Kogte nye kartofler",
      "text": "Lad kartoflerne ligge lunt i gryden under låg, og drys dem med persille lige før servering."
    },
    {
      "section": "Servering",
      "text": "Anret kyllingen med kartofler, syltet agurk, rabarberkompot, salat og skysauce."
    }
  ],
