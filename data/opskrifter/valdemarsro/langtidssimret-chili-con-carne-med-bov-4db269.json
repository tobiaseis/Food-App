  "steps": [
    {
      "section": null,
      "text": "Del kødet i tykke skiver, fx 3-4 skiver af en bov på cirka 800 g."
    },
    {
      "section": null,
      "text": "Varm olien i en støbejernsgryde over høj varme, og brun kødet godt på alle sider. Læg det over på en tallerken, og sænk varmen."
    },
    {
      "section": null,
      "text": "Rør løg, hvidløg, spidskommen, kanel, koriander og chiliflager i gryden, og svits det i nogle minutter, til løgene er blanke og bløde."
    },
    {
      "section": null,
      "text": "Læg kødet tilbage i gryden, og hæld hakkede tomater, soltørrede tomater og bouillon i. Sæt låg på, og bring det i kog. Skru derefter helt ned, så det kun simrer ganske svagt."
    },
    {
      "section": null,
      "text": "Lad gryden simre med låg i 3-4 timer, til kødet er smørmørt."
    },
    {
      "section": null,
      "text": "Løft kødet op, og pluk det i trævler med to gafler. Kom det tilbage i gryden, og rør det rundt."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber, og tilsæt evt. mere chili. Rør bønnerne i, og lad chilien blive godt varm i 5 minutter."
    },
    {
      "section": null,
      "text": "Tag gryden af varmen. Rør halvdelen af chokoladen i, smag til, og tilsæt resten efter behov. Smag til igen."
    },
    {
      "section": "Servering",
      "text": "Kog riset efter pakkens anvisning. Server chilien med ris, nachos, creme fraiche, koriander og hakket chili. Gratiner evt. med revet cheddar."
    }
  ],
  "changes": []
