  "steps": [
    {
      "section": "Til blinis",
      "text": "Bring ½ liter vand i kog i en gryde. Blancher spinaten i vandet i 30 sekunder."
    },
    {
      "section": "Til blinis",
      "text": "Hæld spinaten i en sigte, og pres vandet grundigt ud. Lad den køle lidt, og hak den fint."
    },
    {
      "section": "Til blinis",
      "text": "Opløs gæren i mælken i en skål. Pisk både mel, salt og æggeblommer i, og vend derefter spinaten ned i dejen."
    },
    {
      "section": "Til blinis",
      "text": "Dæk skålen med et rent viskestykke, og lad dejen hæve ved stuetemperatur i cirka 30 minutter."
    },
    {
      "section": "Til blinis",
      "text": "Pisk æggehvierne til stive toppe, og vend dem forsigtigt ind i dejen."
    },
    {
      "section": "Til blinis",
      "text": "Smelt smørret på en pande ved medium varme. Læg små klatter dej på med en spiseske."
    },
    {
      "section": "Til blinis",
      "text": "Steg blinisene, til undersiden er gylden. Vend dem, og steg dem færdige på den anden side."
    },
    {
      "section": "Til servering",
      "text": "Læg blinis på et fad. Top med creme fraiche, stenbiderrogn, rødløg og dild."
    }
  ],
  "changes": [
    "Grahamsmel og boghvedemel er beholdt, da de kan købes i danske supermarkeder."
