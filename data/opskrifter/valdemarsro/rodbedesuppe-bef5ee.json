  "steps": [
    {
      "section": "Croutoner",
      "text": "Skær brødet i tern, og vend dem med olivenolie, flagesalt og timian."
    },
    {
      "section": "Croutoner",
      "text": "Rist ternene sprøde på en pande under hyppig omrøring. Du kan også bage dem i ovnen ved 175 °C varmluft i 15 minutter."
    },
    {
      "section": "Suppe",
      "text": "Varm olivenolien op i en gryde ved middelvarme. Sauter løg, hvidløg, kartofler og rødbeder under omrøring i 2 minutter."
    },
    {
      "section": "Suppe",
      "text": "Hæld bouillon i, og rør koriander og ingefær ned i. Læg låg på, og lad suppen simre i 25 minutter."
    },
    {
      "section": "Suppe",
      "text": "Blend suppen helt glat og cremet. Smag til med salt og peber, og tilsæt evt. mere ingefær."
    },
    {
      "section": "Til servering",
      "text": "Anret suppen i skåle med cremefraiche, persille og de sprøde croutoner ovenpå."
    }
  ],
