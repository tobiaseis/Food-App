  "steps": [
    {
      "section": "Pizzadej",
      "text": "Opløs gæren i vandet i en skål."
    },
    {
      "section": "Pizzadej",
      "text": "Tilsæt hvedemel, olivenolie til dejen og salt. Ælt, til dejen er glat og smidig – gerne 10 minutter i røremaskine på lav hastighed."
    },
    {
      "section": "Pizzadej",
      "text": "Form dejen til en kugle, og lad den hvile på køkkenbordet i 30 minutter, så den hæver."
    },
    {
      "section": "Pizzadej",
      "text": "Del dejen i pizzakugler, og læg dem med god afstand i et fad, der er smurt med olie. Dæk med husholdningsfilm, og stil fadet i køleskabet natten over."
    },
    {
      "section": "Topping",
      "text": "Sæt en pizzasten eller et bagestål i ovnen, og varm den op til 250-280 °C i god tid før bagning."
    },
    {
      "section": "Topping",
      "text": "Læg kartoffelskiverne i en skål med koldt vand tilsat lidt salt, og lad dem trække i 30 minutter. Si vandet fra, og dup skiverne tørre."
    },
    {
      "section": "Topping",
      "text": "Strø mel på bordet, og træk kuglerne ud til pizzabunde. Dæk dem med et tyndt lag kartoffelskiver, og fordel mozzarellaen ovenpå. Pynt med nogle rosmarinkviste."
    },
    {
      "section": "Topping",
      "text": "Bag pizzaerne én ad gangen i 10-12 minutter ved 250-280 °C."
    },
    {
      "section": "Topping",
      "text": "Dryp olivenolie over den varme pizza, og krydr til sidst med salt og friskkværnet peber."
    }
  ],
