  "steps": [
    {
      "section": null,
      "text": "Bring rigeligt let saltet vand i kog i en stor gryde, og kog pastaen, så den er al dente."
    },
    {
      "section": null,
      "text": "Varm olien op på en pande, mens pastaen koger. Steg rejer, hvidløg og chili, til rejerne er færdige. Rå tigerrejer er færdige, når de er lyserøde."
    },
    {
      "section": null,
      "text": "Hæld hvidvinen på panden, og skru ned for varmen."
    },
    {
      "section": null,
      "text": "Si pastaen fra, når den stadig har bid. Vend den varme pasta rundt med rejerne på panden."
    },
    {
      "section": null,
      "text": "Rids citronskallen over, og smag til med salt og friskkværnet peber."
    },
    {
      "section": null,
      "text": "Anret på tallerkener, og drys med persille."
    }
  ],
