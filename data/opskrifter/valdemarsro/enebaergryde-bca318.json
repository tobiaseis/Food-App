  "steps": [
    {
      "section": "Gryden",
      "text": "Varm en bred pande op ved høj varme, og brun champignonerne i en del af smørret, til de har fået farve."
    },
    {
      "section": "Gryden",
      "text": "Sænk varmen lidt, og svits løg og porre med, til de er bløde. Hæld det over i en skål og stil det til side."
    },
    {
      "section": "Gryden",
      "text": "Stød enebær og nåle fra rosmarinstilken i en morter til et fint pulver. Bland det med melet og lidt salt på en tallerken."
    },
    {
      "section": "Gryden",
      "text": "Vend skinketernene rundt i krydderblandingen, så de er dækket af mel hele vejen rundt."
    },
    {
      "section": "Gryden",
      "text": "Smelt det resterende smør i panden ved middelvarme, og brun skinketernene på alle sider, mens du rører. Mel kan sætte sig i bunden, det er helt i orden."
    },
    {
      "section": "Gryden",
      "text": "Hæld mælk og fløde i, og skrab bunden fri med en træske, indtil melet har løsnet sig."
    },
    {
      "section": "Gryden",
      "text": "Bring det i kog, og rør creme fraiche og de brunede grøntsager i. Lad gryden simre i 45 minutter."
    },
    {
      "section": "Gryden",
      "text": "Smag til med salt og peber, og tilsæt evt. lidt mere fløde."
    },
    {
      "section": "Kartoffelmos",
      "text": "Skræl kartoflerne og kog dem møre i rigeligt usaltet vand. Hæld vandet fra."
    },
    {
      "section": "Kartoffelmos",
      "text": "Pisk kartoflerne med en håndmikser sammen med smørret skåret i små tern, til moset er luftigt. Pisk mælken i, til konsistensen er passende."
    },
    {
      "section": "Kartoffelmos",
      "text": "Smag til med salt, peber og muskatnød."
    },
    {
      "section": "Til servering",
      "text": "Anret gryden med kartoffelmos ved siden af, og strø hasselnødder og hakket rosmarin over."
    }
  ],
