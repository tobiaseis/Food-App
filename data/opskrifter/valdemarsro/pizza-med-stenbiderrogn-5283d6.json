  "steps": [
    {
      "section": "Pizzadej",
      "text": "Rør gæren ud i vandet i en stor skål. Tilsæt halvdelen af melet sammen med olie og salt, og rør til en jævn masse."
    },
    {
      "section": "Pizzadej",
      "text": "Rør resten af melet i lidt ad gangen. Vend dejen ud på et meldrysset bord, og ælt den med hænderne, til den er smidig."
    },
    {
      "section": "Pizzadej",
      "text": "Skyl skålen, og gnid den ind med olie. Læg dejen i og vend den rundt, så den er helt dækket – olien gør dejen let at arbejde med og skorpen sprødere."
    },
    {
      "section": "Pizzadej",
      "text": "Lad dejen hæve på bordet i 45 minutter. Stil den derefter i køleskabet i mindst 10 timer eller natten over."
    },
    {
      "section": "Bagning og topping",
      "text": "Sæt en bageplade, et bagestål eller en pizzasten i øverste ovnrille, og varm ovnen op på den højeste temperatur."
    },
    {
      "section": "Bagning og topping",
      "text": "Del dejen i to på et meldrysset bord, og form hver halvdel til en rund bund."
    },
    {
      "section": "Bagning og topping",
      "text": "Smør halvdelen af creme fraichen ud på bundene. Læg kartoffelskiverne ovenpå, og krydr med flagesalt og peber."
    },
    {
      "section": "Bagning og topping",
      "text": "Bag pizzaerne, til de er sprøde. Stil dem på en rist i cirka 5 minutter, så de køler lidt."
    },
    {
      "section": "Bagning og topping",
      "text": "Hak dilden fint. Rør den resterende creme fraiche med citronskal, salt, peber og halvdelen af dilden, og smag til med citronsaft."
    },
    {
      "section": "Bagning og topping",
      "text": "Fordel stenbiderrogn, den krydrede creme fraiche og rødløg på pizzaerne. Slut af med karse og resten af dilden."
    }
  ],
