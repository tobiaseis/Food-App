  "steps": [
    {
      "section": "Tomatsauce",
      "text": "Svits løget i olie i en sauterpande, til det er blødt."
    },
    {
      "section": "Tomatsauce",
      "text": "Rør hvidløg, oregano og hakkede tomater i. Lad saucen simre svagt uden låg, mens du laver resten. Smag til med salt og peber."
    },
    {
      "section": "Spinatfyld",
      "text": "Svits løg og hvidløg i olivenolie på en pande, til de er bløde uden at få farve. Kom den frosne spinat på, og varm den, til den er helt tøet."
    },
    {
      "section": "Spinatfyld",
      "text": "Rør fløde, basilikum og muskatnød i, og krydr med salt og peber."
    },
    {
      "section": "Mornaysauce",
      "text": "Smelt smørret i en gryde, og pisk melet ud i det, så det bliver en jævn bolle."
    },
    {
      "section": "Mornaysauce",
      "text": "Tilsæt mælken lidt ad gangen under piskning, og bring saucen op til kogepunktet."
    },
    {
      "section": "Mornaysauce",
      "text": "Tag gryden af varmen, og rør mozzarellaen i, til den er smeltet. Smag til med muskatnød, salt og peber."
    },
    {
      "section": "Samling og bagning",
      "text": "Tænd ovnen på 175 °C varmluft. Smør et ovnfast fad."
    },
    {
      "section": "Samling og bagning",
      "text": "Byg lasagnen i lag af mornaysauce, spinat, tomatsauce, fisk og lasagneplader. Fordel laks, torsk og rejer i fiskelagene."
    },
    {
      "section": "Samling og bagning",
      "text": "Slut med et lag mornaysauce, og strø parmesan og rasp ovenpå."
    },
    {
      "section": "Samling og bagning",
      "text": "Bag lasagnen i ca. 30 minutter, til pladerne er møre."
    }
  ],
