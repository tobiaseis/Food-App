  "steps": [
    {
      "section": "Dressing",
      "text": "Bland creme fraiche, purløg, sukker og sennep i en skål. Krydr med salt og peber, og smag til. Sæt dressingen på køl, så smagene når at sætte sig, mens du laver pitaerne."
    },
    {
      "section": "Frikadellepita",
      "text": "Forvarm ovnen til 200 °C varmluft."
    },
    {
      "section": "Frikadellepita",
      "text": "Ælt svinekød, hvedemel, havregryn, mælk, æg, løg, hvidløg og timian til en farsmasse. Smag til med salt og peber. Lad farsen hvile i mindst 15 minutter – gerne længere."
    },
    {
      "section": "Frikadellepita",
      "text": "Smør farsen ud i pitabrødene, og pres dem flade, så farsen ligger i et jævnt, tyndt lag hele vejen rundt."
    },
    {
      "section": "Frikadellepita",
      "text": "Pensl pitabrødene med olivenolie, og læg dem på en bageplade. Bag dem i cirka 12-15 minutter, til brødet er sprødt, og farsen er gennemstegt."
    },
    {
      "section": "Frikadellepita",
      "text": "Server pitaerne lune med dressingen og det tilbehør, du har lyst til."
    }
  ],
  "changes": []
