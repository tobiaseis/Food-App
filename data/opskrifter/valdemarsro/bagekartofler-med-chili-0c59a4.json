  "steps": [
    {
      "section": "Kartofler",
      "text": "Varm ovnen op til 175 °C varmluft. Skrub kartoflerne grundigt."
    },
    {
      "section": "Kartofler",
      "text": "Prik kartoflerne et par gange med en gaffel, og vend dem i olien. Bag dem i cirka 1 time, til de er møre."
    },
    {
      "section": "Chilifyld",
      "text": "Svits løg og hvidløg i olien i en gryde, sammen med alle krydderierne, til løgene er blanke og bløde."
    },
    {
      "section": "Chilifyld",
      "text": "Rør tomater og squash i gryden, og lad det simre i 10 minutter."
    },
    {
      "section": "Chilifyld",
      "text": "Kom bønnerne i, og varm dem igennem. Smag til med salt og peber."
    },
    {
      "section": "Servering",
      "text": "Skær et kryds i hver bagt kartoffel, og fyld dem med det varme chilifyld."
    },
    {
      "section": "Servering",
      "text": "Læg creme fraiche og avocado ovenpå. Drys med rød chili og hakkede krydderurter."
    }
  ],
