  "steps": [
    {
      "section": null,
      "text": "Varm ovnen op til 200 °C varmluft. Smør et ovnfast fad."
    },
    {
      "section": null,
      "text": "Svits løget i olivenolie på en stor pande, til det er blødt."
    },
    {
      "section": null,
      "text": "Tilsæt flødeost og bouillon, og rør, til saucen er helt glat. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Kom spinat og spidskål på panden, og vend rundt, til de er faldet lidt sammen."
    },
    {
      "section": null,
      "text": "Hæld blandingen i fadet, og bland squashen i. Bag i cirka 10 minutter."
    },
    {
      "section": null,
      "text": "Læg laksen oven på grøntsagerne, og bag videre i 14-16 minutter, til den er mør."
    },
    {
      "section": null,
      "text": "Kog risene, mens retten er i ovnen, som angivet på pakken."
    },
    {
      "section": null,
      "text": "Server laks og grøntsager sammen med risene."
    }
  ],
