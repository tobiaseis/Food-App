  "steps": [
    {
      "section": "Hvidløgsris med persille",
      "text": "Varm olien i en gryde ved middel-lav varme. Svits hvidløget, til det begynder at dufte."
    },
    {
      "section": "Hvidløgsris med persille",
      "text": "Hæld vand, ris og salt i gryden, og rør rundt. Sæt låg på, og bring langsomt i kog."
    },
    {
      "section": "Hvidløgsris med persille",
      "text": "Lad risene simre ved svag varme i 10 minutter. Tag gryden af varmen, og lad den stå med låg på i 10 minutter mere."
    },
    {
      "section": "Hvidløgsris med persille",
      "text": "Vend persillen i risene lige før servering."
    },
    {
      "section": "Krydret blomkål",
      "text": "Tænd ovnen på 180 °C varmluft."
    },
    {
      "section": "Krydret blomkål",
      "text": "Bland blomkål og kikærter med olie, og vend dem rundt i alle krydderierne. Smag til med salt og peber."
    },
    {
      "section": "Krydret blomkål",
      "text": "Læg det på en bradepande sammen med løg og hvidløg. Bag i 15-20 minutter, til blomkålen er mør og saftig."
    },
    {
      "section": "Ingefær- og limedressing",
      "text": "Rør mayonnaise og creme fraiche sammen med hvidløg og ingefær. Smag til med limeskal, limesaft, salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Rist sesamfrøene på en tør, varm pande."
    },
    {
      "section": "Til servering",
      "text": "Fordel risene i dybe tallerkener. Læg spinat, mango og den bagte blomkål med kikærter ovenpå, og hæld dressingen over."
    },
    {
      "section": "Til servering",
      "text": "Strø sesamfrø, forårsløg, chiliflager og persille over til sidst."
    }
  ],
