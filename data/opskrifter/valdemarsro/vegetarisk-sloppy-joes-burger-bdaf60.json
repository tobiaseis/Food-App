  "steps": [
    {
      "section": "Linsefyld",
      "text": "Varm olie og smør op i en bred gryde eller sautépande. Svits løget ved middelvarme i 5-7 minutter, til det er blødt."
    },
    {
      "section": "Linsefyld",
      "text": "Tilsæt squash, gulerod, hvidløg, timian, rosmarin og røget paprika. Rør rundt og steg i cirka 1 minut."
    },
    {
      "section": "Linsefyld",
      "text": "Rør majsstivelsen ud i fløden. Hæld tomater, fond, linser og fløde-blandingen i gryden, og rør det hele godt sammen."
    },
    {
      "section": "Linsefyld",
      "text": "Læg låg på, og lad fyldet simre ved middel-lav varme i 30 minutter."
    },
    {
      "section": "Linsefyld",
      "text": "Rør barbecuesauce og sennep i, og smag til med salt og peber. Simre videre uden låg i 15-20 minutter. Rør engang imellem, og pas på, at det ikke koger helt tørt – der skal stadig være lidt damp fra væden."
    },
    {
      "section": "Linsefyld",
      "text": "Læg cheddarskiverne ovenpå, og lad dem smelte."
    },
    {
      "section": "Servering",
      "text": "Varm burgerbollerne. Fyld dem med linseblandingen og ost, og top med syltede agurker."
    },
    {
      "section": "Servering",
      "text": "Strø persille over, og server med det samme."
    }
  ],
