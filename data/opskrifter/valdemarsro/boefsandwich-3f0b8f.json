  "steps": [
    {
      "section": "Bløde løg",
      "text": "Smelt smør og sukker på en pande, og lad løgringene stege ved middelvarme, til de er møre."
    },
    {
      "section": "Bløde løg",
      "text": "Tilsæt balsamico, rør rundt, og stil løgene til side. Behold panden til næste trin."
    },
    {
      "section": "Hakkebøffer",
      "text": "Del kødet i 4 lige store portioner, og form dem til bøffer. Krydr med salt og peber."
    },
    {
      "section": "Hakkebøffer",
      "text": "Brun smør på samme pande, og steg bøfferne i 2 minutter på hver side. Tag dem af panden og stil dem til side."
    },
    {
      "section": "Sauce",
      "text": "Hæld bouillon på panden, og skrab alt det brunede fra bunden med en spatel, så det koger ud i væsken."
    },
    {
      "section": "Sauce",
      "text": "Tilsæt fløde, worcestershiresauce, lidt ketchup og sennep. Smag til med mere peber, hvis det trænger."
    },
    {
      "section": "Sauce",
      "text": "Rør majsstivelsen ud i vand, og tilsæt den under omrøring, til saucen tykner. Farv med kulør efter smag, og lad den koge godt igennem."
    },
    {
      "section": "Sauce",
      "text": "Læg bøfferne tilbage i saucen, så de varmes igennem."
    },
    {
      "section": "Til sandwichen",
      "text": "Del bollerne, og smør begge halvdele med remoulade og ketchup."
    },
    {
      "section": "Til sandwichen",
      "text": "Fordel rødløg, syltede agurker og syltede rødbeder på underdelene. Læg en bøf med sauce ovenpå, og top med de bløde løg og de ristede løg."
    },
    {
      "section": "Til sandwichen",
      "text": "Læg overdelen på, og server evt. ekstra sauce ved siden af."
    }
  ],
