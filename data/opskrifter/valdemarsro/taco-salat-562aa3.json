  "steps": [
    {
      "section": "Dressing",
      "text": "Rør creme fraiche, hvidløg, spidskommen samt limeskal og -saft sammen. Smag til med salt og peber, og stil dressingen på køl, så den når at trække, mens du laver resten."
    },
    {
      "section": "Kylling og majs",
      "text": "Vend kyllingen med koriander, spidskommen, limesaft, paprika, salt og peber."
    },
    {
      "section": "Kylling og majs",
      "text": "Varm olie og smør op på en pande, og steg kyllingen hurtigt, til den næsten er gennemstegt."
    },
    {
      "section": "Kylling og majs",
      "text": "Kom majsene på panden, og steg videre, til kyllingen er færdig, og majsene er sprøde."
    },
    {
      "section": "Salat",
      "text": "Vend salat, avocado, rødløg, koriander, tomater, agurk og chili med dressingen. Fordel salaten på tallerkener eller i skåle."
    },
    {
      "section": "Salat",
      "text": "Top med kylling og majs, og drys med knust nachos og revet cheddar."
    }
  ],
