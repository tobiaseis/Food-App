  "steps": [
    {
      "section": "Bøfferne",
      "text": "Ælt oksekødet sammen med æg, de hakkede kapers, salt og peber."
    },
    {
      "section": "Bøfferne",
      "text": "Del farsen i fire lige store dele. Læg en del oven på hver brødskive, og tryk den godt fast."
    },
    {
      "section": "Bøfferne",
      "text": "Træk lidt af farsen ud over brødets kant, og pres den tæt ind mod kanten hele vejen rundt. Så sidder farsen fast og trækker sig ikke sammen under stegningen."
    },
    {
      "section": "Bøfferne",
      "text": "Rids overfladen af bøfferne med en skarp kniv."
    },
    {
      "section": "Stegning",
      "text": "Hæld olien på panden, og tilsæt smørret. Lad det smelte og boble, til det holder op med at bruse."
    },
    {
      "section": "Stegning",
      "text": "Læg bøfferne på panden med kødsiden nedad, og steg dem 5-6 minutter ved middelvarme."
    },
    {
      "section": "Stegning",
      "text": "Vend dem, og steg brødsiden i ca. 2 minutter, til brødet er gyldent og sprødt."
    },
    {
      "section": "Stegning",
      "text": "Vend bøfferne igen, og steg kødsiden 1 minut mere."
    },
    {
      "section": "Servering",
      "text": "Anret bøfferne på tallerkener med rødløg, æggeblomme, rødbeder, kapers og peberrod. Smag til med salt og peber."
    }
  ],
