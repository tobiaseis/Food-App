  "steps": [
    {
      "section": "Sauce",
      "text": "Rist spidskommen, chiliflager og koriander i en tør gryde under omrøring, til det begynder at dufte."
    },
    {
      "section": "Sauce",
      "text": "Sænk varmen. Tilsæt sød og røget paprika, løg, hvidløg og olivenolie, og svits ved middel varme, til løgene er bløde."
    },
    {
      "section": "Sauce",
      "text": "Skru op for varmen, og brun soltørrede tomater og oksekød godt i gryden."
    },
    {
      "section": "Sauce",
      "text": "Sænk varmen igen, og rør oregano, bladselleri, squash, hakkede tomater, fond, salt og peber i. Sæt låg på, og lad saucen simre i 30 minutter."
    },
    {
      "section": "Sauce",
      "text": "Smag saucen til. Rør kidneybønner, jalapenos og halvdelen af majsen i."
    },
    {
      "section": "Samling",
      "text": "Smør et ovnfast fad. Læg sauce, lasagneplader og revet cheddar i lag, til alt er brugt."
    },
    {
      "section": "Samling",
      "text": "Top med resten af majsen og noget cheddar."
    },
    {
      "section": "Samling",
      "text": "Forvarm ovnen til 175 °C varmluft. Bag lasagnen i 30 minutter, eller til pladerne er møre."
    },
    {
      "section": "Til servering",
      "text": "Server lasagnen med resten af cheddaren, nachos, avocado, lime, jalapenos og koriander."
    }
  ],
  "changes": []
