  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en gryde ved middelvarme. Svits løg og hvidløg, til løgene er bløde."
    },
    {
      "section": null,
      "text": "Tilsæt de soltørrede tomater og oksekødet. Skru op for varmen og brun kødet, mens du rører rundt."
    },
    {
      "section": null,
      "text": "Kom gulerødder, bladselleri, squash, hakkede tomater, fond, jalapeños og alle krydderierne i gryden. Lad suppen simre i 15 minutter."
    },
    {
      "section": null,
      "text": "Rør bønnerne i, og varm dem godt igennem. Smag til med salt og peber."
    },
    {
      "section": "Servering",
      "text": "Rør halvdelen af osten i suppen. Server straks i dybe tallerkener."
    },
    {
      "section": "Servering",
      "text": "Top med resten af osten, creme fraiche, syltede jalapeños og koriander. Server med nachos og limebåde ved siden af."
    }
  ],
