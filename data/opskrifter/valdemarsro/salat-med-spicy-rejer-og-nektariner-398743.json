  "steps": [
    {
      "section": "Vinaigrette",
      "text": "Blend alle ingredienserne til vinaigretten, indtil den er helt glat. Smag den til, og tynd den evt. ud med lidt ekstra olie eller limesaft."
    },
    {
      "section": "Rejer",
      "text": "Vend rejerne med olie, røget paprika, spidskommen og cayennepeber i en skål. Krydr med salt og peber."
    },
    {
      "section": "Rejer",
      "text": "Hæt olie op i en stor pande ved middelhøj varme. Steg rejerne i portioner, til de er lyserøde og gennemstegte."
    },
    {
      "section": "Samling",
      "text": "Vend romainesalat og rucola med halvdelen af vinaigretten, og læg det i en stor skål. Fordel nektarin og feta ovenpå."
    },
    {
      "section": "Samling",
      "text": "Læg avocado og de varme rejer øverst. Strø sesamfrø og lidt basilikum over, og server resten af vinaigretten ved siden af."
    }
  ],
