  "steps": [
    {
      "section": "Bønnefritter",
      "text": "Tænd ovnen på 190 °C varmluft. Pisk mayonnaise og æg sammen i en skål (gem lidt af ægget til laksefarsen), og vend bønnerne rundt i blandingen."
    },
    {
      "section": "Bønnefritter",
      "text": "Bland panko, røget paprika og salt i en anden skål (gem lidt panko til farsen). Rul de æggede bønner i raspblandingen, til de er dækket hele vejen rundt."
    },
    {
      "section": "Bønnefritter",
      "text": "Læg bønnerne på en bradepande med bagepapir. Bag dem i ca. 30 minutter, til de er sprøde, og vend dem et par gange undervejs."
    },
    {
      "section": "Laksebøffer",
      "text": "Rør karrypasta, sojasauce og honning glat i en stor skål. Tilsæt laks, det ægget, forårsløg, sesamfrø, koriander og resten af raspen, og rør farsen godt igennem."
    },
    {
      "section": "Laksebøffer",
      "text": "Form farsen til 4 faste bøffer. Varm sesamolien op på en pande ved middel varme, og steg bøfferne i 2-3 minutter på hver side. Vend dem varsomt, så de holder sammen."
    },
    {
      "section": "Asiatisk ingefærdressing",
      "text": "Rør mayonnaise, creme fraiche, fiskesauce, hvidløg og ingefær sammen. Smag til med limeskal og peber."
    },
    {
      "section": "Burgeren",
      "text": "Rist burgerbollerne, og smør begge halvdele med dressing. Læg rucola på underbollen, og top med laksebøf og avocado. Læg overbollen på."
    },
    {
      "section": "Burgeren",
      "text": "Server med kartofler og resten af dressingen til at dyppe i."
    }
  ],
