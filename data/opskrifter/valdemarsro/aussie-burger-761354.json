  "steps": [
    {
      "section": "Bøffer",
      "text": "Bland oksekødet med hvidløg, worcestershiresauce, marmelade og røget paprika i en skål. Krydr med salt og peber, og form blandingen til fire bøffer."
    },
    {
      "section": "Bøffer",
      "text": "Varm grillen eller en grillpande op. Steg bøfferne 4-5 minutter på første side, og vend dem derefter."
    },
    {
      "section": "Bøffer",
      "text": "Læg en skive cheddar på hver bøf, så den når at smelte, mens den anden side bliver færdig i 4-5 minutter."
    },
    {
      "section": "Bøffer",
      "text": "Grill ananasskiverne ved siden af, til de er varme og møre."
    },
    {
      "section": "Til burgeren",
      "text": "Steg baconen sprød på en pande, og læg den på køkkenrulle."
    },
    {
      "section": "Til burgeren",
      "text": "Svits løgringene i baconfedtet sammen med smørret, til de er bløde."
    },
    {
      "section": "Til burgeren",
      "text": "Steg til sidst æggene som spejlæg på den meget varme pande."
    },
    {
      "section": "Til burgeren",
      "text": "Smør bollerne med mayonnaise. Byg burgerne med rødbeder, rucola, bøf med ost, bacon, ananas, løg og spejlæg."
    }
  ],
