  "steps": [
    {
      "section": "Bunden",
      "text": "Forvarm ovnen til 175 °C varmluft. Smør en tærteform."
    },
    {
      "section": "Bunden",
      "text": "Bland hørfrø, rugmel, hvedemel og salt i en skål. Smuldr smørret ud i de tørre ingredienser."
    },
    {
      "section": "Bunden",
      "text": "Rør ægget og en del af olien ind i blandingen. Tilsæt resten af olien lidt efter lidt, hvis dejen er for tør."
    },
    {
      "section": "Bunden",
      "text": "Tryk dejen jævnt ud i formen, så den dækker bund og kanter. Forbag bunden i 10 minutter."
    },
    {
      "section": "Fyldet",
      "text": "Steg baconen på en pande, til den er sprød og næsten færdig."
    },
    {
      "section": "Fyldet",
      "text": "Pisk æggene med mælken. Rør bacon, muskatnød og peber i, og smag til med salt."
    },
    {
      "section": "Fyldet",
      "text": "Hæld fyldet over den forbagte bund. Bag tærten i ovnen i 20-25 minutter, til æggemassen er stivnet."
    }
  ],
