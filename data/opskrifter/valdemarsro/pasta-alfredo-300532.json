  "steps": [
    {
      "section": null,
      "text": "Bring en stor gryde med rigeligt letsaltet vand i kog, og læg pastaen i. Lad den koge, til den er al dente."
    },
    {
      "section": null,
      "text": "Øs kogevand op fra gryden, før du hælder resten af vandet fra pastaen."
    },
    {
      "section": null,
      "text": "Varm smørret op på en pande, og svits hvidløget i få sekunder."
    },
    {
      "section": null,
      "text": "Hæld fløden og det afmålte kogevand på panden, og rør parmesanen i. Rør, til osten er smeltet og saucen er jævn."
    },
    {
      "section": null,
      "text": "Kom den afdryppede pasta i saucen, og vend den godt rundt. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Fordel pastaen på tallerkener, og drys med timian."
    }
  ],
