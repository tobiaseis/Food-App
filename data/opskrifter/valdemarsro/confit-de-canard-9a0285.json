  "steps": [
    {
      "section": "Dagen før",
      "text": "Knus salt, peber, salvie, rosmarin, timian, citronskal, hvidløg og sukker i en morter til en duftende krydderiblanding."
    },
    {
      "section": "Dagen før",
      "text": "Gnid andelårene ind i blandingen. Læg dem i en skål med låg, og lad dem trække i køleskabet natten over."
    },
    {
      "section": "Dagen efter",
      "text": "Tør krydderiblandingen af andelårene."
    },
    {
      "section": "Dagen efter",
      "text": "Smelt andefedtet i en gryde ved lav varme. Læg andelårene i, så fedtet dækker dem helt."
    },
    {
      "section": "Dagen efter",
      "text": "Læg låg på, og lad andelårene simre ved svag varme i 3-4 timer. Fedtet må ikke koge, for så bliver kødet friteret og sprødt i stedet for smørmørt."
    },
    {
      "section": "Dagen efter",
      "text": "Kig til andelårene efter et par timer. Er kødet helt mørt, er de klar. Ellers får de lidt længere tid."
    },
    {
      "section": "Dagen efter",
      "text": "Løft andelårene op af gryden."
    },
    {
      "section": "Opbevaring",
      "text": "Skold en skål med kogende vand, og tør den godt. Læg andelårene i skålen."
    },
    {
      "section": "Opbevaring",
      "text": "Si fedtet fra gryden, så grumset bliver fjernet. Hæld det rene, hvide fedt over andelårene, til de er helt dækket."
    },
    {
      "section": "Servering",
      "text": "Steg andelårene sprøde på en pande i andefedtet. Du kan også lægge dem på en bradepande med bagepapir, drysse skindet med flagesalt og bage dem i forvarmet ovn ved 225 °C varmluft i cirka 10-15 minutter, til skindet er sprødt."
    }
  ],
