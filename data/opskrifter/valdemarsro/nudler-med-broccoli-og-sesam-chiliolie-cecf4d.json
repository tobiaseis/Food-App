  "steps": [
    {
      "section": "Sesam-chiliolie",
      "text": "Kom sesamolie, hvidløg, sesamfrø og chiliflager i en lille pande. Lad det simre ved middelvarme, til sesamfrø og hvidløg har fået lidt farve."
    },
    {
      "section": "Sesam-chiliolie",
      "text": "Tag panden af varmen, og rør ingefæren i."
    },
    {
      "section": "Nudler og grønt",
      "text": "Kog nudlerne som angivet på pakken. Et minut før de er færdige, lægges broccoli, edamamebønner og spinat i gryden."
    },
    {
      "section": "Nudler og grønt",
      "text": "Sæt låg på, og kog det sidste minut."
    },
    {
      "section": "Nudler og grønt",
      "text": "Si vandet fra, og kom nudler og grønt tilbage i gryden. Vend dem med al sesam-chiliolien."
    },
    {
      "section": "Til servering",
      "text": "Fordel i skåle, og dryp med et par dråber sojasauce. Drys med forårsløg og koriander, og server med limebåde til at presse over."
    }
  ],
