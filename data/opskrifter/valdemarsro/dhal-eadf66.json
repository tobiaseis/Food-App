  "steps": [
    {
      "section": "Dhal",
      "text": "Varm olien op i en stor gryde ved middelvarme. Rør hvidløg og ingefær rundt i cirka 1 minut."
    },
    {
      "section": "Dhal",
      "text": "Kom karry, spidskommen, koriander, kardemomme og chiliflager i gryden, og svits det under omrøring i cirka 1 minut."
    },
    {
      "section": "Dhal",
      "text": "Skyl linserne i en sigte. Kom dem i gryden sammen med bouillonen og de hakkede tomater."
    },
    {
      "section": "Dhal",
      "text": "Læg låg på, og lad dhalen simre i 30-45 minutter. Rør jævnligt, og hæld lidt mere bouillon i, hvis den bliver for tyk."
    },
    {
      "section": "Dhal",
      "text": "Smag til med salt. Hæld dhalen op i dybe skåle, og top med koriander."
    },
    {
      "section": "Raita",
      "text": "Rør alle ingredienserne til raitaen sammen, og smag til med salt og peber. Stil den på køl, til den skal serveres sammen med dhalen."
    }
  ],
