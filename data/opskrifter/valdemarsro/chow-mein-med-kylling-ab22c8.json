  "steps": [
    {
      "section": "Sauce og nudler",
      "text": "Rør saucens ingredienser sammen i en skål og stil den til side."
    },
    {
      "section": "Sauce og nudler",
      "text": "Kog nudlerne, så de er lige knap møre. Hæld det kogende vand fra med det samme, og fyld gryden med iskoldt vand. Så holder nudlerne op med at koge og klistrer ikke sammen. Lad dem dryppe af."
    },
    {
      "section": "Wok",
      "text": "Varm olien op i en stor wok eller pande. Steg champignonerne, til de har fået en flot skorpe, og tag dem eventuelt op."
    },
    {
      "section": "Wok",
      "text": "Brun kyllingestrimlerne, skru ned for varmen, og svits løgene, til de er bløde."
    },
    {
      "section": "Wok",
      "text": "Kom ingefær, hvidløg, spidskål og broccoli i woken, og vend det hele, til spidskålen er faldet sammen og mør."
    },
    {
      "section": "Wok",
      "text": "Kom champignonerne tilbage i woken sammen med gulerødder, edamamebønner og nudler. Vend i 1-2 minutter, hæld saucen over, og vend rundt."
    },
    {
      "section": "Servering",
      "text": "Anret i dybe skåle, og drys med sesamfrø og forårsløg."
    }
  ],
