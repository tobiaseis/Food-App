  "steps": [
    {
      "section": "Kokosris",
      "text": "Varm olien og ingefæren op i en gryde ved lav varme, til det begynder at dufte. Ingefæren må ikke blive brun."
    },
    {
      "section": "Kokosris",
      "text": "Hæld vand, kokosmælk og ris i gryden, og krydr med salt. Rør rundt, sæt låg på, og bring det langsomt i kog."
    },
    {
      "section": "Kokosris",
      "text": "Lad risen simre under låg ved svag varme i 10 minutter. Tag gryden af blusset, og lad risen trække med låg på i 10 minutter mere."
    },
    {
      "section": "Kokosris",
      "text": "Vend den hakkede spinat i risen lige før servering."
    },
    {
      "section": "Syltede gulerødder",
      "text": "Skær gulerødderne i lange bånd med en skræller."
    },
    {
      "section": "Syltede gulerødder",
      "text": "Bring vand, sukker og riseddike i kog i en lille gryde, til sukkeret er opløst. Tag gryden af varmen."
    },
    {
      "section": "Syltede gulerødder",
      "text": "Læg gulerødderne i den varme lage, og fyld dem på glas. Sæt låg på, og stil dem køligt, mens du laver resten."
    },
    {
      "section": "Krydrede kikærter",
      "text": "Forvarm ovnen til 200 °C. Fordel kikærterne på en bageplade med bagepapir, og rist dem i 5 minutter."
    },
    {
      "section": "Krydrede kikærter",
      "text": "Bland sukker, teriyakisauce, limesaft og olie i en skål, og vend kikærterne rundt heri."
    },
    {
      "section": "Krydrede kikærter",
      "text": "Bag kikærterne i yderligere 20-30 minutter, og vend dem et par gange undervejs."
    },
    {
      "section": "Asiatisk mayodressing",
      "text": "Rør mayonnaise, fiskesauce, hvidløg og ingefær sammen. Smag til med limeskal og peber."
    },
    {
      "section": "Servering",
      "text": "Anret risen i dybe tallerkener sammen med babyspinat, kikærter, de afdryppede gulerødder, avocado, agurk og forårsløg."
    },
    {
      "section": "Servering",
      "text": "Top med dressingen, koriander, sesamfrø og chiliflager."
    }
  ],
