  "steps": [
    {
      "section": "Kartoffelbåde",
      "text": "Tænd ovnen på 200 °C."
    },
    {
      "section": "Kartoffelbåde",
      "text": "Rør kartoffelbådene sammen med olie og salt, og fordel dem på en bageplade."
    },
    {
      "section": "Kartoffelbåde",
      "text": "Bag dem i 25-30 minutter, til de er gyldne og sprøde."
    },
    {
      "section": "Fiskefingre",
      "text": "Bland rasp, citronskal, persille, salt og peber i en skål."
    },
    {
      "section": "Fiskefingre",
      "text": "Slå æggene ud i en dyb tallerken, og pisk dem løse med en gaffel."
    },
    {
      "section": "Fiskefingre",
      "text": "Skær fisken i tykke strimler. Blande de to slags mel med salt og peber, og rul fiskestykkerne i blandingen."
    },
    {
      "section": "Fiskefingre",
      "text": "Træk stykkerne et ad gangen gennem æg og derefter gennem raspblandingen."
    },
    {
      "section": "Fiskefingre",
      "text": "Læg fiskefingrene på en bageplade med bagepapir. Bag dem ved 200 °C varmluft i ca. 20 minutter."
    },
    {
      "section": "Til servering",
      "text": "Anret fiskefingrene med kartoffelbådene, remoulade, agurkestave og citronbåde, som man kan presse over."
    }
  ],
