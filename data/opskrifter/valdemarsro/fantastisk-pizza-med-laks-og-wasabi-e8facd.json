  "steps": [
    {
      "section": "Pizzadej",
      "text": "Rør gæren ud i det lunkne vand i en stor skål."
    },
    {
      "section": "Pizzadej",
      "text": "Tilsæt halvdelen af melet sammen med olien og saltet, og rør, til det er helt glat. Tilsæt derefter resten af melet lidt ad gangen, mens du rører."
    },
    {
      "section": "Pizzadej",
      "text": "Strø mel på bordet, og ælt dejen med hænderne, til den er smidig."
    },
    {
      "section": "Pizzadej",
      "text": "Skyl skålen, og gnid den ind med olie. Læg dejen i, og vend den, så hele overfladen er olieret – det gør den let at arbejde med og skorpen sprødere."
    },
    {
      "section": "Pizzadej",
      "text": "Stil dejen i køleskabet til næste dag."
    },
    {
      "section": "Bagning",
      "text": "Tænd ovnen på den højeste temperatur, og sæt bageplade, bagestål eller pizzasten ind øverst, så den kan blive varm."
    },
    {
      "section": "Bagning",
      "text": "Strø mel på bordet, del dejen i to, og form to runde bunde med hænderne."
    },
    {
      "section": "Bagning",
      "text": "Bag bundene uden fyld, til de er sprøde. Stil dem på en rist, så de kan køle lidt af."
    },
    {
      "section": "Topping",
      "text": "Rør wasabi ud i flødeosten, og smag til. Cremen må gerne give et lille bid, men den skal ikke være for stærk."
    },
    {
      "section": "Topping",
      "text": "Smør cremen ud på de afkølede bunde, så osten ikke smelter. Læg laksen ovenpå, og krydr med salt og rigeligt peber."
    },
    {
      "section": "Topping",
      "text": "Top med masser af rucola. Pres citronsaft over, og riv lidt citronskal ovenpå til sidst."
    }
  ],
