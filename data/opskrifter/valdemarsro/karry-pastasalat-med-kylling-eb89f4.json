  "steps": [
    {
      "section": "Karrydressing",
      "text": "Rør alle ingredienserne til dressingen sammen. Smag til med salt, peber, citronskal, sennep, sukker og eventuelt mere karry."
    },
    {
      "section": "Salaten",
      "text": "Kog pasta efter anvisningen på pakken. Si vandet fra, og skyl straks pastaen i koldt vand, så den holder op med at koge og køler af."
    },
    {
      "section": "Salaten",
      "text": "Steg bacon sprødt på en pande med lidt olie. Lad det dryppe af på køkkenrulle, og hak det groft."
    },
    {
      "section": "Salaten",
      "text": "Vend kyllingetern i hvedemel, salt og peber. Tilsæt lidt mere olie på baconpanden, og steg kyllingen under konstant omrøring i 4-6 minutter, til den er gennemstegt. Tag den af panden, og lad den køle lidt af."
    },
    {
      "section": "Salaten",
      "text": "Kog haricots verts direkte fra frost i letsaltet vand i 2 minutter. Hæld dem i en sigte, og skyl straks med iskoldt vand."
    },
    {
      "section": "Salaten",
      "text": "Bland pasta, bacon, kylling, haricots verts, ærter og majs i en stor skål. Vend dressingen i, så alt er dækket."
    }
  ],
  "changes": [
    "Pastaskruer er skrevet som pasta (skruer).",
