  "steps": [
    {
      "section": "Raviolidej",
      "text": "Sigt durummel og salt ned i en stor skål, og tryk en hule i midten. Hæld æg og olivenolie i hulen."
    },
    {
      "section": "Raviolidej",
      "text": "Pisk æggene med en gaffel, og rør gradvist melet ind fra kanten, til du kan samle det til en smidig dej."
    },
    {
      "section": "Raviolidej",
      "text": "Æl dejen godt igennem, og lad den hvile på køl i 30 minutter."
    },
    {
      "section": "Fyld",
      "text": "Rist hasselnødderne på en tør, varm pande, mens du rører rundt, til skallens hinder revner. Gnid hinderne af med et viskestykke, og hak nødderne fint."
    },
    {
      "section": "Fyld",
      "text": "Tør panden ren, og steg løg, hvidløg og champignon i smør, til løgene er blødt op. Rør hasselnødderne i, og smag til med salt og peber."
    },
    {
      "section": "Fyld",
      "text": "Tag lidt af fyldet fra til saucen, og bland ricotta i resten."
    },
    {
      "section": "Samling",
      "text": "Rul dejen tyndt ud på et meldrysset bord, og stik cirkler ud med et glas eller en udstikker."
    },
    {
      "section": "Samling",
      "text": "Læg en teskefuld fyld midt på halvdelen af cirklerne. Pensl kanterne med sammenpisket æg, læg de øvrige cirkler ovenpå, og luk helt rundt ved at presse kanten sammen med en gaffel."
    },
    {
      "section": "Rosmarinsauce",
      "text": "Smelt smørret ved svag varme. Tilsæt hvidløg, rosmarin og fond, og lad saucen trække ved helt lav varme i ca. 15 minutter."
    },
    {
      "section": "Rosmarinsauce",
      "text": "Rør det fyld, du har sat til side, i saucen, og lad den koge hurtigt igennem. Smag til med salt og peber."
    },
    {
      "section": "Kogning og anretning",
      "text": "Bring en stor gryde vand i kog med lidt salt og olie. Kog raviolierne i 3-4 minutter, til de flyder op til overfladen."
    },
    {
      "section": "Kogning og anretning",
      "text": "Løft raviolierne op, og anret dem i dybe tallerkener med saucen. Top med basilikum, parmesan og friskkværnet peber."
    }
  ],
