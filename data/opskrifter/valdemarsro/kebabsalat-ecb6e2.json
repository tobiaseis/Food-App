  "steps": [
    {
      "section": "Kebab",
      "text": "Bland alle krydderierne i en skål. Vend kødskiverne i krydderblandingen, så de er dækket hele vejen rundt."
    },
    {
      "section": "Kebab",
      "text": "Varm olien op på en pande, så den er rigtig varm. Steg kødet kort på alle sider, og tag det straks af panden, så det ikke bliver sejt."
    },
    {
      "section": "Hvidløgsdressing",
      "text": "Rør alle ingredienserne til dressingen sammen, og smag til med salt og peber."
    },
    {
      "section": "Servering",
      "text": "Fordel salat, agurk, rødløg og tomater på tallerkener, og læg det varme kød ovenpå. Hæld dressingen over, og drys med persille."
    }
  ],
