  "steps": [
    {
      "section": null,
      "text": "Varm olie og smør op i en stor gryde. Svits løg og hvidløg, indtil løgene er blevet bløde."
    },
    {
      "section": null,
      "text": "Kom mel, spidskommen, oregano, halvdelen af chilien og lidt salt i en skål. Vend kødstykkerne i blandingen, så de er helt dækket."
    },
    {
      "section": null,
      "text": "Sænk varmen til middel, og kom kødet i gryden. Rør det godt sammen med løgene."
    },
    {
      "section": null,
      "text": "Hæld bouillon og hakkede tomater i. Rør, mens det varmes op til kogepunktet."
    },
    {
      "section": null,
      "text": "Skru ned på lav varme, og sæt låg på. Lad retten simre i 2 timer, og rør i den med jævne mellemrum."
    },
    {
      "section": null,
      "text": "Når kødet er mørt, kommer kartofler og gulerødder i gryden. Lad det simre videre, til kartoflerne er møre."
    },
    {
      "section": null,
      "text": "Krydr med salt og peber. Tilsæt resten af chilien, hvis du vil have mere styrke."
    }
  ],
  "changes": []
