  "steps": [
    {
      "section": "Marinade",
      "text": "Varm smørret op i en gryde, og svits løg og hvidløg, til de er blanke."
    },
    {
      "section": "Marinade",
      "text": "Rør alle de øvrige ingredienser til marinaden i gryden. Lad den simre uden låg i 30 minutter."
    },
    {
      "section": "Spareribs",
      "text": "Træk hinden af på undersiden af ribbenene, og læg kødet i et stort fad."
    },
    {
      "section": "Spareribs",
      "text": "Smør marinaden ud over ribbenene, så alle sider er dækket. Gem lidt marinade til penslingen til sidst."
    },
    {
      "section": "Spareribs",
      "text": "Dæk fadet med folie, og stil det på køl i mindst 10 timer – gerne natten over."
    },
    {
      "section": "Grillning",
      "text": "Grill ribbenene under låg ved indirekte varme ved ca. 150 °C i 2-3 timer."
    },
    {
      "section": "Grillning",
      "text": "Tilfør gerne røg mod slutningen af tiden med røgsmuld. Det kan også springes over."
    },
    {
      "section": "Grillning",
      "text": "Tag ribbenene af grillen, og pensl dem med den marinade, du har gemt."
    }
  ],
