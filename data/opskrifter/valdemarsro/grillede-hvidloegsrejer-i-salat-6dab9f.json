  "steps": [
    {
      "section": "Rejer og nektariner",
      "text": "Vend rejerne i en skål med olie, hvidløg, paprika, honning, salt og peber. Lad dem marinere i mindst 15 minutter – gerne længere."
    },
    {
      "section": "Rejer og nektariner",
      "text": "Træk rejerne på grillspyd. Grill dem på begge sider, til de er helt gennemstegte."
    },
    {
      "section": "Rejer og nektariner",
      "text": "Læg nektarinbådene på grillen, og grill dem, til de har fine striber."
    },
    {
      "section": "Hvidløgsbrød",
      "text": "Gnid brødskiverne med hvidløget, og pensl dem med olie. Grill dem på begge sider, til de er sprøde."
    },
    {
      "section": "Dressing",
      "text": "Rør sennep, hyldeblomstsaft og eddike sammen til en dressing. Vend den med spinat og rucola i en stor skål."
    },
    {
      "section": "Salat",
      "text": "Anret salaten med rejer, nektariner og avocado. Smuldr brødet i krummer, og drys dem over sammen med basilikum, pinjekerner, flagesalt og peber."
    }
  ],
