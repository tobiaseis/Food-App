  "steps": [
    {
      "section": "Dressing",
      "text": "Bland alle ingredienserne til dressingen i en skål, indtil den er jævn og lidt tynd. Smag til med salt og peber, og stil den til side."
    },
    {
      "section": "Salat",
      "text": "Vend kyllingen med barbecuesaucen i en skål, og lad den trække, mens du laver resten."
    },
    {
      "section": "Salat",
      "text": "Kog pastaen efter anvisningen på posen, og lad den dryppe af."
    },
    {
      "section": "Salat",
      "text": "Steg baconen sprød på en stor pande. Tag den af panden, og hak den groft. Lad fedtet blive tilbage."
    },
    {
      "section": "Salat",
      "text": "Tilsæt lidt olie til baconfedtet, og steg kyllingen ved middelvarme under omrøring, til den er gennemstegt."
    },
    {
      "section": "Salat",
      "text": "Vend pastaen i en stor skål med halvdelen af dressingen og baconen. Vend derefter kylling, tomater, agurk, majs, cheddar, rucola, avocado og basilikum i."
    },
    {
      "section": "Salat",
      "text": "Drys med chiliflager, salt og peber. Server med resten af dressingen ved siden af."
    }
  ],
