  "steps": [
    {
      "section": "Kylling og croutoner",
      "text": "Tænd ovnen på 180 °C varmluft. Smør et ovnfast fad."
    },
    {
      "section": "Kylling og croutoner",
      "text": "Vend kyllingen med mel, salt og peber, og læg den i fadet. Bag den i 20 minutter."
    },
    {
      "section": "Kylling og croutoner",
      "text": "Smør brødskiverne med smørret på begge sider, og skær dem i tern. Fordel dem på en bageplade med bagepapir, og rist dem i ovnen i 5 minutter."
    },
    {
      "section": "Pasta",
      "text": "Kog pastaen, mens kyllingen og croutonerne er i ovnen, som det står på pakken. Si den, og skyl den straks i iskoldt vand, så den holder op med at koge."
    },
    {
      "section": "Pasta",
      "text": "Lad kyllingen køle af, og skær den i mindre tern."
    },
    {
      "section": "Cæsardressing",
      "text": "Rør ansjos, worcestershiresauce, parmesan, hvidløg og citronsaft til en jævn, tyk creme. Bland mayonnaise og creme fraiche i, og smag til med salt og peber."
    },
    {
      "section": "Samling",
      "text": "Vend den kolde pasta med dressingen i en stor skål, og vend derefter salaten i."
    },
    {
      "section": "Samling",
      "text": "Top med kylling og croutoner, og drys med friskrevet parmesan."
    }
  ],
