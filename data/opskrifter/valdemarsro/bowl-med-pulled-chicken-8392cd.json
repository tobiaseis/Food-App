  "steps": [
    {
      "section": "Pulled chicken",
      "text": "Bland paprika, spidskommen, brun farin, hvidløg og sriracha til en marinade, og krydr med salt og peber."
    },
    {
      "section": "Pulled chicken",
      "text": "Vend kyllingebrysterne i marinaden, så de er dækket hele vejen rundt. Læg dem i en lufttæt beholder, og lad dem trække på køl i mindst 30 minutter – gerne til næste dag."
    },
    {
      "section": "Pulled chicken",
      "text": "Forvarm ovnen til 125 °C. Smør bunden og siderne af en støbejernsgryde med smørret, og læg kyllingen i."
    },
    {
      "section": "Pulled chicken",
      "text": "Hæld fonden over, sæt låg på, og lad gryden stå i ovnen i 3 timer."
    },
    {
      "section": "Pulled chicken",
      "text": "Løft kyllingen op af gryden, og pluk den i fine strimler med to gafler."
    },
    {
      "section": "Guacamole",
      "text": "Mos avocadoerne med en gaffel. Kom dem sammen med de øvrige ingredienser til guacamolen i et blenderglas, og blend med stavblender, til massen er blød og cremet."
    },
    {
      "section": "Guacamole",
      "text": "Vil du have en grovere guacamole, så hak alt helt fint og rør det sammen i en skål i stedet."
    },
    {
      "section": "Guacamole",
      "text": "Smag til med salt, peber, chili og citronsaft. Lad gerne guacamolen hvile 30 minutter på køl."
    },
    {
      "section": "Ananassalsa",
      "text": "Vend ananas, mynte og chili sammen i en skål. Smag til med limesaft, limeskal, salt og peber."
    },
    {
      "section": "Servering",
      "text": "Fordel rucola i skåle, og top med ananassalsa, pulled chicken og guacamole. Læg nachos ved siden af, og drys med chiliflager."
    }
  ],
  "changes": [
    "Sriracha chilisauce er skrevet som sriracha.",
    "Grøntsagsbouillon er skrevet som grøntsagsfond."
