  "steps": [
    {
      "section": "Tilbehør",
      "text": "Kog kartoflerne møre i letsaltet vand. Si vandet fra, og læg låg på gryden, så kartoflerne holder varmen."
    },
    {
      "section": "Tilbehør",
      "text": "Brun spidskålen på en varm grillpande med smørret, til den har fået striber og er mør. Krydr med salt og peber."
    },
    {
      "section": "Fisk og sauce",
      "text": "Del fisken i passende stykker. Varm smør og olie op på en pande ved middel til høj varme, og steg fisken med skindsiden nedad, til skindet er sprødt. Vend stykkerne, og steg dem 1 minut på den anden side. Læg fisken på en tallerken."
    },
    {
      "section": "Fisk og sauce",
      "text": "Svits løget blødt i samme pande. Hæld hvidvinen på, og lad den koge op og bruse af."
    },
    {
      "section": "Fisk og sauce",
      "text": "Rør bouillon og fløde i, og lad saucen simre i 5 minutter. Læg fisken tilbage i panden, og lad den trække med i et par minutter, til den er mør."
    },
    {
      "section": "Fisk og sauce",
      "text": "Vend dild i saucen. Smag til med lidt revet citronskal, nogle dråber citronsaft, salt og peber."
    },
    {
      "section": "Fisk og sauce",
      "text": "Anret fisken med sauce, kartofler og spidskål."
    }
  ],
