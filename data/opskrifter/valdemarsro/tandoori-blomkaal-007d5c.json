  "steps": [
    {
      "section": null,
      "text": "Forvarm ovnen til 180 °C varmluft. Smør et stort ovnfast fad."
    },
    {
      "section": null,
      "text": "Læg blomkål og kikærter i fadet. Pensl med det smeltede smør, og krydr med salt og peber. Bag i 10 minutter."
    },
    {
      "section": null,
      "text": "Kog risene efter anvisningen på posen, mens blomkålen bager."
    },
    {
      "section": "Tandoori-marinade",
      "text": "Pisk yoghurt, kardemomme, kanel, nellike, spidskommen, koriander, paprika, gurkemeje, sukker, ingefær, hvidløg, tomatpuré og majsstivelse sammen. Smag til med salt og peber. Rør til sidst kokosmælken i, og smag igen til med salt og peber."
    },
    {
      "section": null,
      "text": "Tag fadet ud af ovnen, og hæld marinaden over blomkål og kikærter. Bag i yderligere 20 minutter."
    },
    {
      "section": "Servering",
      "text": "Anret blomkål og kikærter ved siden af risene. Top med cashewnødder, koriander og chiliflager."
    }
  ],
