  "steps": [
    {
      "section": "Fiskestykker",
      "text": "Varm ovnen op til 175 °C varmluft. Del torskefiletten i strimler på ca. 2 cm i tykkelsen."
    },
    {
      "section": "Fiskestykker",
      "text": "Bland rasp med citronskal, persille, salt og peber på en tallerken."
    },
    {
      "section": "Fiskestykker",
      "text": "Pisk æggene let med en gaffel i en dyb tallerken. Bland fuldkornsmelet med salt og peber på en anden tallerken."
    },
    {
      "section": "Fiskestykker",
      "text": "Rul fiskestykkerne i melblandingen, træk dem gennem ægget, og tryk dem ned i raspblandingen, så de er dækket hele vejen rundt."
    },
    {
      "section": "Fiskestykker",
      "text": "Læg stykkerne på en bageplade med bagepapir. Bag dem i 17-20 minutter."
    },
    {
      "section": "Tatarsauce",
      "text": "Rør alt til saucen sammen i en skål. Smag den til med salt, peber og evt. mere citron."
    },
    {
      "section": "Til servering",
      "text": "Læg et fiskestykke i hvert hotdogbrød. Hæld tatarsauce over, og drys med agurketern og dild eller ærtespirer."
    },
    {
      "section": "Til servering",
      "text": "Server resten af saucen som dip, f.eks. til rå grøntsager."
    }
  ],
  "changes": [
    "Hotdogbrød beholdes som hotdogbrød, da det kan købes i danske supermarkeder."
  ]
}
