  "steps": [
    {
      "section": null,
      "text": "Sæt pastaen over i kogende vand, og følg tiden på pakken."
    },
    {
      "section": null,
      "text": "Læg de frosne edamamebønner i gryden, når der er ca. 1 minut tilbage af kogetiden, så pastaen stadig har lidt bid."
    },
    {
      "section": null,
      "text": "Si pasta og bønner fra, og lad dem dryppe godt af."
    },
    {
      "section": null,
      "text": "Kom det hele i en stor skål, og rør flødeost og laks ind."
    },
    {
      "section": null,
      "text": "Hak dild og persille, og vend dem i."
    },
    {
      "section": null,
      "text": "Smag til med citronskal, citronsaft, salt og peber."
