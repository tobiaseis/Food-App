  "steps": [
    {
      "section": "Til chilifyldet",
      "text": "Varm krydderierne tørt op i en pande, til de dufter."
    },
    {
      "section": "Til chilifyldet",
      "text": "Tilsæt olie, hvidløg og løg, og svits det, til løget er blødt."
    },
    {
      "section": "Til chilifyldet",
      "text": "Kom squash og hakkede tomater i panden. Lad det simre i 15 minutter."
    },
    {
      "section": "Til chilifyldet",
      "text": "Rør kidneybønnerne i, og smag fyldet til med salt og peber. Du kan i stedet bruge rester af chili con carne som fyld."
    },
    {
      "section": "Til quesadillas",
      "text": "Smør fyldet ud på halvdelen af tortillaerne. Drys cheddar og majs over."
    },
    {
      "section": "Til quesadillas",
      "text": "Læg de resterende tortillas ovenpå som låg."
    },
    {
      "section": "Til quesadillas",
      "text": "Bag quesadillaerne i ovnen i 10 minutter ved 200 °C varmluft. Du kan også brune dem på en varm, tør pande, til de er gyldne på begge sider."
    }
  ],
