  "steps": [
    {
      "section": "Gyros",
      "text": "Bland hvidløg og alle krydderier i en skål (uden salt og peber). Vend kødet i blandingen, og lad det trække i køleskabet i mindst 2 timer – gerne op til et døgn."
    },
    {
      "section": "Gyros",
      "text": "Varm en pande op, til den ryger. Steg kødet i olien under konstant omrøring, til det er helt gennemstegt. Krydr med salt og peber."
    },
    {
      "section": "Tzatziki",
      "text": "Skær agurken over på langs, og skrab kernerne ud med en ske. Riv den groft."
    },
    {
      "section": "Tzatziki",
      "text": "Vend den revne agurk med salt, og lad den stå i 5-10 minutter. Hæld den i en sigte, og pres og vrid vandet grundigt ud."
    },
    {
      "section": "Tzatziki",
      "text": "Rør agurken i yoghurten. Smag til med hvidløg, olivenolie, salt og peber."
    },
    {
      "section": "Servering",
      "text": "Smør tzatziki på fladbrødene. Fyld dem med gyros, salat, tomat, agurk og rødløg, og drys med persille."
    }
  ],
  "changes": []
