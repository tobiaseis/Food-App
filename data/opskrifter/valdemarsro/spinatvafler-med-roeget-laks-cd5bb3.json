  "steps": [
    {
      "section": "Spinatvafler",
      "text": "Bland begge slags hvedemel med bagepulveret i en skål."
    },
    {
      "section": "Spinatvafler",
      "text": "Skyl spinaten godt. Kom den i en blender sammen med æg, mælk, smør, salt og peber, og blend til en glat, tynd dej."
    },
    {
      "section": "Spinatvafler",
      "text": "Hæld melblandingen i blenderen og kør igen, til dejen er ensartet. Lad dejen hvile i ca. 15 minutter, så melet kan trække lidt væde og dejen tykner."
    },
    {
      "section": "Spinatvafler",
      "text": "Smør vaffeljernet let med olie eller smør. Bag vaflerne, til de er gyldne og helt gennembagte."
    },
    {
      "section": "Dildcreme",
      "text": "Rør creme fraiche med dild. Smag til med et skvæt citronsaft, lidt citronskal, salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Læg babyspinat, koldrøget laks, avocado og agurk på hver vaffel. Top med dildcreme og hampefrø, og drys med salt og peber."
    }
  ],
