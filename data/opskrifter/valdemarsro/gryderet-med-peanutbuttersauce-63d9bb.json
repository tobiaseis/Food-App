  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en gryde ved middelvarme, og blød løget i den, til det er mørt."
    },
    {
      "section": null,
      "text": "Skru op for varmen, og brun oksekødet godt på alle sider."
    },
    {
      "section": null,
      "text": "Pisk peanutbutteren sammen med det kolde vand, og hæld blandingen i gryden."
    },
    {
      "section": null,
      "text": "Kom tomatpuré, fond, cayennepeber, paprika og laurbærblade i, og krydr med salt og peber. Rør rundt."
    },
    {
      "section": null,
      "text": "Læg låg på, og lad gryden simre i 1½–2 timer. Rør af og til."
    },
    {
      "section": null,
      "text": "Fjern laurbærbladene, når kødet er helt mørt."
    },
    {
      "section": null,
      "text": "Server med ris eller kartoffelmos, en grøn salat og friske krydderurter drysset over."
    }
  ],
