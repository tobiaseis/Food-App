  "steps": [
    {
      "section": "Kartofler",
      "text": "Skær kartoflerne over på midten. Kog dem i letsaltet vand, til de er møre, og si vandet fra."
    },
    {
      "section": "Kylling",
      "text": "Varm ovnen op til 200 °C varmluft og beklæd en bageplade med bagepapir. Læg kyllingen på pladen."
    },
    {
      "section": "Kylling",
      "text": "Bland hvidløg, røget paprika, olie, salt og peber til en marinade, og smør den ud over kyllingen. Svøb derefter hver bryst i parmaskinke."
    },
    {
      "section": "Kylling",
      "text": "Bag kyllingen i 20 minutter, til den er helt gennemstegt."
    },
    {
      "section": "Saltede mandler",
      "text": "Sænk ovnen til 150 °C, eller brug en ovn for sig selv. Rør flagesalt ud i vandet, og vend mandlerne i blandingen."
    },
    {
      "section": "Saltede mandler",
      "text": "Fordel mandlerne på en plade med bagepapir. Bag dem i 15 minutter, til vandet er fordampet, og de er tørre og sprøde. Hak dem groft."
    },
    {
      "section": "Croutoner",
      "text": "Varm en pande op, og kom brødterninger, olie og hvidløg på. Rør konstant, til brødet er let ristet og sprødt."
    },
    {
      "section": "Croutoner",
      "text": "Drys med lidt flagesalt og peber, og tag panden af varmen."
    },
    {
      "section": "Dressing",
      "text": "Pisk olie, sennep, hyldeblomstsaft og eddike sammen. Smag til med salt og peber."
    },
    {
      "section": "Samling",
      "text": "Vend rucola og feldsalat med et par skefulde dressing i en stor skål."
    },
    {
      "section": "Samling",
      "text": "Skær kyllingen i skiver. Læg den sammen med kartofler og avocado ovenpå salaten, og strø croutoner og mandler over. Afslut med basilikum."
    }
  ],
