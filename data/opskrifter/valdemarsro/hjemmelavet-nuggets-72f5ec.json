  "steps": [
    {
      "section": null,
      "text": "Del kyllingen i mundrette bidder, og vend dem med kærnemælk og hvidløg i en skål."
    },
    {
      "section": null,
      "text": "Lad kyllingen marinere i køleskabet i mindst 30 minutter. Den kan stå op til 1 døgn."
    },
    {
      "section": null,
      "text": "Si ikke bidderne, men lad den overskydende marinade dryppe fra. Kødet må gerne være fugtigt."
    },
    {
      "section": null,
      "text": "Rør rasp, paprika, salt og peber sammen i en skål."
    },
    {
      "section": null,
      "text": "Vend hver bid først i æg og bagefter i raspblandingen."
    },
    {
      "section": null,
      "text": "Stil bidderne på et fad med et lag rasp i bunden. Har du tid, så dæk fadet med film og lad nuggets hvile i køleskabet i et par timer – så bliver de ekstra sprøde."
    },
    {
      "section": null,
      "text": "Forvarm ovnen til 180 °C varmluft."
    },
    {
      "section": null,
      "text": "Pensl nuggets med lidt olie, hvis du vil, og læg dem på en bageplade."
    },
    {
      "section": null,
      "text": "Bag dem i cirka 25 minutter, til panering er gylden og sprød, og kyllingen er helt gennemstegt."
    }
  ],
