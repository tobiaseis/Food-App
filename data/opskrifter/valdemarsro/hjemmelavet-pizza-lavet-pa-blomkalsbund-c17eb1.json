  "steps": [
    {
      "section": "Bunden",
      "text": "Tænd ovnen på 220 °C varmluft. Læg bagepapir på bageplader."
    },
    {
      "section": "Bunden",
      "text": "Rør alle ingredienserne til bunden sammen i en skål."
    },
    {
      "section": "Bunden",
      "text": "Fordel massen i et tyndt lag på bagepapiret, og glat den ud med hænderne. Opskriften giver bunde nok til halvanden bageplade."
    },
    {
      "section": "Bunden",
      "text": "Forbag bundene i 20 minutter, til de netop er sprøde."
    },
    {
      "section": "Tomatsauce",
      "text": "Kog hakkede tomater og oregano ind i en gryde, mens bundene bager. Saucen skal være cremet og ikke vandet."
    },
    {
      "section": "Samling",
      "text": "Skru ovnen ned på 190 °C varmluft."
    },
    {
      "section": "Samling",
      "text": "Smør et tyndt lag tomatsauce på de forbagte bunde. Læg mozzarella og tomatskiver ovenpå."
    },
    {
      "section": "Samling",
      "text": "Bag pizzaerne færdige i 16-18 minutter."
    },
    {
      "section": "Samling",
      "text": "Drys med persille, inden de serveres."
    }
  ],
