  "steps": [
    {
      "section": "Langtidssimret lam",
      "text": "Skær senerne af lammekødet, og duk kødet tørt med køkkenrulle."
    },
    {
      "section": "Langtidssimret lam",
      "text": "Smelt smørret i en gryde, og brun kødet på alle sider. Læg det på en tallerken."
    },
    {
      "section": "Langtidssimret lam",
      "text": "Svits løg, gulerødder og bladselleri i samme gryde ved middelvarme, til løgene er blanke og bløde."
    },
    {
      "section": "Langtidssimret lam",
      "text": "Kom kødet tilbage i gryden sammen med hvidvin, fond, rosmarin, timian, salt og peber."
    },
    {
      "section": "Langtidssimret lam",
      "text": "Læg låg på, og bring det langsomt i kog. Skum af et par gange, og skru så ned på lav varme. Lad retten simre under låg i 2½ time, til kødet er mørt og falder fra hinanden."
    },
    {
      "section": "Orzo",
      "text": "Løft kødet op. Si grøntsagerne fra, så du har både grøntsager og væske."
    },
    {
      "section": "Orzo",
      "text": "Hæld halvdelen af væsken i en gryde med orzo, og bring det i kog under omrøring. Lad det simre, til orzoen er mør, og tilsæt mere af væsken undervejs efter behov."
    },
    {
      "section": "Orzo",
      "text": "Bland persille og citronskal i en skål."
    },
    {
      "section": "Orzo",
      "text": "Rør de sigtede grøntsager ned i den kogte orzo, og smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Fordel orzoen i dybe tallerkener. Pluk kødet i stykker, og læg det ovenpå."
    },
    {
      "section": "Til servering",
      "text": "Strø persille- og citronblandingen, parmesan og lidt peber over."
    }
  ],
  "title": "Cremet orzo med langtidssimret lam",
  "intro": "Mørt lam, der simrer i hvidvin og grøntsager, serveres på cremet orzo med citron, persille og parmesan.",
