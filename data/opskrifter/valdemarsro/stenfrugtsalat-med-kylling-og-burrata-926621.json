  "steps": [
    {
      "section": "Timiankylling",
      "text": "Tænd ovnen på 200 °C varmluft. Gnid kyllingebrystet med salt, peber, citronskal og timian."
    },
    {
      "section": "Timiankylling",
      "text": "Læg kyllingen i et smurt ovnfast fad, og fordel smørret ovenpå. Steg i ovnen i ca. 20 minutter, til kødet er helt igennem."
    },
    {
      "section": "Croutoner",
      "text": "Skær brødet i små tern, og vend dem rundt i olivenolie, salt og peber."
    },
    {
      "section": "Croutoner",
      "text": "Bag ternene ved 200 °C varmluft i 10-12 minutter, til de er sprøde."
    },
    {
      "section": "Hyldeblomstdressing",
      "text": "Pisk sennep, hyldeblomstsaft, eddike og en smule olivenolie sammen. Juster smagen, til du er tilfreds."
    },
    {
      "section": "Salat",
      "text": "Læg fersken, abrikoser og tomater på et stort fad, og top med rucola."
    },
    {
      "section": "Salat",
      "text": "Skær kyllingen i skiver, og læg dem over salaten. Strø croutoner og pinjekerner ovenpå, og dryp med dressingen."
    },
    {
      "section": "Salat",
      "text": "Giv hver portion en halv burrata og lidt basilikumblade."
    }
  ],
