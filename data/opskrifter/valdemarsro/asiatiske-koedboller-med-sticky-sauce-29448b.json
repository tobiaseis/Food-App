  "steps": [
    {
      "section": "Kødboller",
      "text": "Bland kyllingekød med forårsløg, koriander, ingefær, hvidløg, chili, salt og peber. Smag til med chilien, og udelad den, hvis du ikke vil have det for stærkt."
    },
    {
      "section": "Kødboller",
      "text": "Rul farsen til små boller. Brun dem i olie på en pande i 7-8 minutter, og vend dem ofte, så de holder formen."
    },
    {
      "section": "Kødboller",
      "text": "Skær en bolle over for at se, om den er gennemstegt. Læg derefter bollerne på en tallerken."
    },
    {
      "section": "Sticky sauce",
      "text": "Hæld alle saucens ingredienser på en ren pande. Bring det i kog under omrøring, og lad det reducere, til saucen er lidt tykkere."
    },
    {
      "section": "Sticky sauce",
      "text": "Læg bollerne tilbage i saucen og vend dem rundt. Skru ned på lav varme, og lad dem simre, til saucen klæber til dem."
    },
    {
      "section": "Til servering",
      "text": "Anret bollerne og strø ristede sesamfrø og hakket forårsløg over."
    }
  ],
