  "steps": [
    {
      "section": "Kartoffelvafler",
      "text": "Vend de revne kartofler med lidt salt i en skål, og lad dem stå i cirka et kvarter, så de afgiver væske."
    },
    {
      "section": "Kartoffelvafler",
      "text": "Hæld kartoflerne i en sigte, og pres så meget væde ud af dem som muligt."
    },
    {
      "section": "Kartoffelvafler",
      "text": "Bland de afdryppede kartofler med de øvrige ingredienser til vaflerne i en skål, til det hænger godt sammen."
    },
    {
      "section": "Kartoffelvafler",
      "text": "Smør vaffeljernet med lidt olie, og bag vaflerne én ad gangen, til de er gyldne og sprøde. Stil dem på en rist eller i ovnen, så de holder sig lune, mens du bager resten."
    },
    {
      "section": "Pico de gallo",
      "text": "Vend alle ingredienserne til pico de gallo sammen i en stor skål. Brug kun halvdelen af chilien i starten."
    },
    {
      "section": "Pico de gallo",
      "text": "Smag til med resten af chilien, mere limesaft og limeskal samt salt og peber."
    },
    {
      "section": "Limedressing",
      "text": "Rør creme fraiche og mayonnaise sammen, og smag til med limeskal, en smule limesaft, salt og peber."
    },
    {
      "section": "Servering",
      "text": "Anret de varme vafler med pico de gallo, avocadoskiver og limedressing. Dryp med koriander og chiliflager til sidst."
    }
  ],
