  "steps": [
    {
      "section": "Ovnbagte kartofler",
      "text": "Forvarm ovnen til 220 °C varmluft."
    },
    {
      "section": "Ovnbagte kartofler",
      "text": "Vend kartoffelkvartene i olie og salt, og fordel dem på en bageplade. Bag dem i cirka 30 minutter, til de er sprøde. Rør rundt i dem et par gange undervejs."
    },
    {
      "section": "Kylling i svampesauce",
      "text": "Krydr kyllingebrysterne med salt og peber på begge sider."
    },
    {
      "section": "Kylling i svampesauce",
      "text": "Varm smør og olie på en pande. Steg kyllingen først på skindsiden, til skindet er gyldent og sprødt, og brun den derefter kort på de øvrige sider. Læg kyllingen på en tallerken."
    },
    {
      "section": "Kylling i svampesauce",
      "text": "Sæt panden på høj varme igen, og tilsæt lidt mere fedtstof, hvis der er brug for det. Steg champignon og kantareller under konstant omrøring. Når champignonerne er gyldne, skal du skrue lidt ned for varmen."
    },
    {
      "section": "Kylling i svampesauce",
      "text": "Kom løg, hvidløg, timian og rosmarin på panden, og rør rundt, til løgene er bløde."
    },
    {
      "section": "Kylling i svampesauce",
      "text": "Pisk majsstivelsen ud i den kolde bouillon. Hæld blandingen på panden sammen med fløde og hvidvin, og rør det godt sammen. Læg kyllingen tilbage i saucen."
    },
    {
      "section": "Kylling i svampesauce",
      "text": "Lad retten simre ved svag varme i 15-20 minutter, til kyllingen er gennemstegt. Smag saucen til med citronskal, citronsaft, salt og peber."
    },
    {
      "section": "Kylling i svampesauce",
      "text": "Drys med persille, og server med de ovnbagte kartofler."
    }
  ],
