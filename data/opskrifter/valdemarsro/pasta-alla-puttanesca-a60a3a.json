  "steps": [
    {
      "section": null,
      "text": "Kog spaghettien al dente, mens saucen laves."
    },
    {
      "section": null,
      "text": "Varm olien op på en stor pande ved middelvarme. Rør hvidløg og chili rundt i den varme olie et øjeblik."
    },
    {
      "section": null,
      "text": "Tilsæt oliven, kapers, ansjoser, soltørrede tomater og røget paprika. Steg det hele i 5 minutter."
    },
    {
      "section": null,
      "text": "Kom tomater og tomatpuré på panden, og lad det blive godt varmt hele vejen igennem."
    },
    {
      "section": null,
      "text": "Krydr saucen med citronskal, salt og peber."
    },
    {
      "section": null,
      "text": "Vend den nykogte spaghetti i saucen. Server med persille og lidt friskkværnet peber ovenpå."
    }
  ],
