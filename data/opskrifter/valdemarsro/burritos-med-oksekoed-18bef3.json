  "steps": [
    {
      "section": "Burritos",
      "text": "Varm olivenolien op på en pande, og brun oksekødet, mens du rører rundt."
    },
    {
      "section": "Burritos",
      "text": "Rør hvidløg, sriracha, røget paprika, spidskommen og oregano ned i kødet."
    },
    {
      "section": "Burritos",
      "text": "Tag panden af varmen. Vend tomatpuré, flødeost og sorte bønner i, og smag til med salt og peber."
    },
    {
      "section": "Burritos",
      "text": "Del tomaterne på midten, og skrab kernerne ud. Gem kernerne til salsaen, og skær tomatkødet i tern."
    },
    {
      "section": "Burritos",
      "text": "Opvarm tortillaerne en ad gangen på en tør pande, til de er bløde og lette at folde. Pensl eller gnid begge sider med lidt olie."
    },
    {
      "section": "Burritos",
      "text": "Læg en stribe avocado, tomat, jalapeños og cheddar ned ad midten af hver tortilla, og top med kødfyldet."
    },
    {
      "section": "Burritos",
      "text": "Fold siderne ind over fyldet, og rul tortillaen stramt sammen. Læg burritoen med samlingen nedad, og gør det samme med resten."
    },
    {
      "section": "Burritos",
      "text": "Kom lidt revet cheddar på en pande ved middelvarme, og læg en burrito med samlingen nedad oven på osten. Steg den i 1-2 minutter, til osten er sprød og gyldenbrun."
    },
    {
      "section": "Burritos",
      "text": "Vend burritoen, og steg den på den anden side i 1½-2 minutter."
    },
    {
      "section": "Mangosalsa",
      "text": "Bland mango, avocado, tomatkernerne, koriander og basilikum i en skål."
    },
    {
      "section": "Mangosalsa",
      "text": "Smag til med limesaft, limeskal, salt og peber."
    },
    {
      "section": null,
      "text": "Anret de varme, sprøde burritos med mangosalsa og creme fraiche ved siden af."
    }
  ],
