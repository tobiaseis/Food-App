  "steps": [
    {
      "section": null,
      "text": "Varm olien op på en stor pande, og brun oksekødet, mens du rører rundt i det."
    },
    {
      "section": null,
      "text": "Kom løg, hvidløg, begge slags paprika, karry, spidskål og gulerødder på panden. Rør det hele godt sammen, og sæt varmen ned til middel."
    },
    {
      "section": null,
      "text": "Rør tomatpuré, majsstivelse, fløde og bouillon sammen i en lille skål, og hæld blandingen over grøntsagerne og kødet."
    },
    {
      "section": null,
      "text": "Lad retten simre, til saucen er tyknet lidt. Smag til med eddike, salt og peber."
    },
    {
      "section": null,
      "text": "Drys med persille og hampefrø, og server straks."
    }
  ],
