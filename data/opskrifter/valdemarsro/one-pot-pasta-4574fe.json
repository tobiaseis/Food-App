  "steps": [
    {
      "section": null,
      "text": "Læg spaghetti, hakkede tomater, basilikumblade til gryden, løg, hvidløg, cherrytomater, squash, oregano, chorizo, fond, olivenolie og chili i en stor gryde. Krydr med salt og peber."
    },
    {
      "section": null,
      "text": "Bring gryden i kog og rør godt rundt. Skru derefter ned for varmen."
    },
    {
      "section": null,
      "text": "Læg låg på og lad retten simre i 10-12 minutter, til spaghettien er al dente."
    },
    {
      "section": "Til servering",
      "text": "Anret i dybe tallerkener og top med parmesan og basilikum."
    }
