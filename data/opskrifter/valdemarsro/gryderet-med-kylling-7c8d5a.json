  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en stor gryde ved middelvarme, og lad smørret smelte og bruse af."
    },
    {
      "section": null,
      "text": "Steg champignonerne ved høj varme, til de har fået en flot skorpe. Læg dem over på en tallerken."
    },
    {
      "section": null,
      "text": "Svits løg, hvidløg, chorizo og soltørrede tomater i den samme gryde, til løget er blødt."
    },
    {
      "section": null,
      "text": "Tilsæt squash og aubergine, og steg dem, til de er møre."
    },
    {
      "section": null,
      "text": "Rør begge slags paprika, oregano, timian og spidskommen i. Hæld bouillon og hakkede tomater i, og bring det i kog."
    },
    {
      "section": null,
      "text": "Læg kyllingebrysterne og de stegte champignoner i gryden, og tryk dem ned under grøntsagerne. Læg låg på, og lad det simre i 20-30 minutter, til kyllingen er helt mør."
    },
    {
      "section": null,
      "text": "Løft kyllingen op, og pil den i strimler med to gafler, eller skær den i små tern."
    },
    {
      "section": null,
      "text": "Kom kyllingen tilbage i gryden. Rør fløden i, og smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Anret gryderetten med de kogte ris, og strø persille over."
    }
  ],
  "changes": []
