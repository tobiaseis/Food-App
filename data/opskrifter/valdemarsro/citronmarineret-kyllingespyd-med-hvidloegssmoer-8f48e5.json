  "steps": [
    {
      "section": "Citronmarineret kylling",
      "text": "Rør olie, citronsaft, citronskal, timian og halvdelen af hvidløget sammen til en jævn marinade. Smag til med salt og peber."
    },
    {
      "section": "Citronmarineret kylling",
      "text": "Vend kyllingestrimlerne i marinaden. Dæk skålen til, og lad kødet trække i køleskabet i mindst 1 time – gerne længere."
    },
    {
      "section": "Hvidløgssmør",
      "text": "Smelt smørret i en gryde ved lav til middel varme. Rør persille og resten af hvidløget i, og krydr med salt og peber. Smag til med citronskal."
    },
    {
      "section": "Spyd",
      "text": "Træk kyllingestrimlerne på grillspyd i tætte folder som en harmonika, og pres kødet godt sammen."
    },
    {
      "section": "Spyd",
      "text": "Varm en pande eller grill op til middelhøj varme, og pensl med lidt olie. Steg spyddene 4-5 minutter på hver side, til kyllingen er helt gennemstegt."
    },
    {
      "section": "Til servering",
      "text": "Pensl de varme spyd med noget af hvidløgssmørret, og drys med parmesan og persille. Hæld resten af smørret over, og server straks."
    }
  ],
