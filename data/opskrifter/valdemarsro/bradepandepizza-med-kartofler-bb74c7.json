  "steps": [
    {
      "section": "Dej",
      "text": "Rør gæren ud i vandet i en skål. Tilsæt olien og fuldkornsmelet, og rør det til en lind dej."
    },
    {
      "section": "Dej",
      "text": "Tilsæt hvedemelet lidt ad gangen, og ælt dejen i 10 minutter, gerne i røremaskine. Rør saltet i til sidst."
    },
    {
      "section": "Dej",
      "text": "Læg dejen i en ren skål, dæk den til, og lad den hæve på køkkenbordet i 1 time."
    },
    {
      "section": "Dej",
      "text": "Træk dejen ud, så den passer til en stor bradepande, og læg den over på bagepapir i bradepanden. Lad den hæve i 45 minutter."
    },
    {
      "section": "Pizza",
      "text": "Lad mozzarellaen dryppe godt af. Skær den i skiver, og tør dem let med køkkenrulle."
    },
    {
      "section": "Pizza",
      "text": "Smør creme fraichen forsigtigt ud over dejen. Fordel kartoffelskiver, rødløg, oliven og mozzarella ovenpå. Krydr med salt og peber, og dryp med olivenolie."
    },
    {
      "section": "Pizza",
      "text": "Bag pizzaen i en forvarmet ovn ved 180 °C varmluft i 25-30 minutter."
    },
    {
      "section": "Hvidløgsolie",
      "text": "Bland olivenolie, presset hvidløg og hakkede krydderurter. Dryp olien over den bagte pizza, inden den serveres."
    }
  ],
  "changes": []
