  "steps": [
    {
      "section": null,
      "text": "Forvarm ovnen til 175 °C varmluft. Pensl tortillaerne med lidt olie, og form dem som skåle i små ovnfaste forme."
    },
    {
      "section": null,
      "text": "Bag skålene i 8-10 minutter, til de er let gyldne. Lad dem køle af i formene, så bliver de sprøde."
    },
    {
      "section": null,
      "text": "Varm olivenolien i en gryde ved middelvarme. Rør løg og hvidløg rundt, til de er møre."
    },
    {
      "section": null,
      "text": "Kom oksekød og chorizo i gryden, og brun det godt."
    },
    {
      "section": null,
      "text": "Tilsæt squash, krydderier, tomatpuré og hakkede tomater. Bring det i kog, og lad fyldet simre uden låg i 20 minutter."
    },
    {
      "section": null,
      "text": "Smag fyldet til med salt og peber."
    },
    {
      "section": null,
      "text": "Varm smørret på en pande, og rist majsen, til den er næsten sprød."
    },
    {
      "section": null,
      "text": "Fyld tortillaskålene med kødfyldet. Top med avocado, majs og cheddar, og server med limebåde at presse over."
    }
  ],
