  "steps": [
    {
      "section": null,
      "text": "Kog nudlerne i letsaltet vand, som det står på pakken. Kom edamamebønnerne i det sidste minut, og si derefter det hele fra."
    },
    {
      "section": null,
      "text": "Varm olien op i en wok eller stor pande. Rør karrypasta, ingefær og hvidløg rundt, til det begynder at dufte."
    },
    {
      "section": null,
      "text": "Pisk kokosmælk, sojasauce og peanutbutter ned i panden, og rør, til saucen er jævn."
    },
    {
      "section": null,
      "text": "Kom broccoli, gulerødder og spinat i woken. Varm det igennem, til spinaten er faldet sammen."
    },
    {
      "section": null,
      "text": "Vend nudler og edamamebønner i, så alt er dækket af saucen. Smag til med peber, limesaft og evt. lidt mere sojasauce."
    },
    {
      "section": "Spejlæg",
      "text": "Varm olivenolien op på en pande ved kraftig varme. Slå æggene ud, og steg dem, til hviden er fast og kanten er sprød, mens blommen stadig er flydende."
    },
    {
      "section": "Servering",
      "text": "Anret woken i dybe tallerkener. Top med spejlæg, peanuts, sesamfrø, chiliflager og koriander."
    }
  ],
