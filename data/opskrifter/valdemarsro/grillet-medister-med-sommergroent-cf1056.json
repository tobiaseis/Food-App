  "steps": [
    {
      "section": "Sommergrønt",
      "text": "Skrub kartoflerne, og kog dem møre i letsaltet vand."
    },
    {
      "section": "Sommergrønt",
      "text": "Kom spidskål og ærter i gryden ca. 1 minut, før kartoflerne er færdige. Sæt låg på, og si alt fra efter 1 minut. Kålen skal kun lige falde sammen, og ærterne skal blot have et hurtigt opkog."
    },
    {
      "section": "Sommergrønt",
      "text": "Lad det køle af i en skål, og drys med noget af persillen."
    },
    {
      "section": "Dressing",
      "text": "Rør creme fraiche, mayonnaise, sennep, sukker, purløg og resten af persillen sammen. Smag til med salt og peber."
    },
    {
      "section": "Dressing",
      "text": "Vend dressingen med de afkølede kartofler, kål og ærter."
    },
    {
      "section": "Grillet medister",
      "text": "Læg medisteren på grillen ved indirekte varme, og hold temperaturen på 180-200 °C. Grill pølsen i 10 minutter på hver side."
    },
    {
      "section": "Grillet medister",
      "text": "Anret medisteren på tallerkener sammen med salaten."
    }
  ],
