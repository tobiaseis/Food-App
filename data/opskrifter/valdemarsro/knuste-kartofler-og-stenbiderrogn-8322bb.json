  "steps": [
    {
      "section": null,
      "text": "Kog kartoflerne møre i letsaltet vand."
    },
    {
      "section": null,
      "text": "Rør creme fraiche med halvdelen af purløg og dild, citronskal og en smule citronsaft. Vend en del af rognen forsigtigt i, og smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Si vandet fra, og læg kartoflerne på et stort fad. Tryk dem let itu med en ske, og vend dem med smør, salt og peber."
    },
    {
      "section": null,
      "text": "Læg salat og rødløg på fire tallerkener, og fordel de lune kartofler ovenpå."
    },
    {
      "section": null,
      "text": "Top med skefulde af rognecremen og resten af rognen. Drys med resten af dild og purløg samt friskkværnet peber."
    }
  ],
