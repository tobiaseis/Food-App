  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en gryde ved middelvarme. Svits løg, hvidløg og gulerødder, til løgene er bløde."
    },
    {
      "section": null,
      "text": "Tilsæt karry, spidskommen, gurkemeje og hakket oksekød. Skru op for varmen, og brun kødet godt, mens du rører hele tiden."
    },
    {
      "section": null,
      "text": "Skru ned til middelvarme, og rør squash og peberfrugt i gryden."
    },
    {
      "section": null,
      "text": "Skyl risene grundigt i en sigte. Rør dem ned i gryden, og hæld fonden over."
    },
    {
      "section": null,
      "text": "Bring det i kog under omrøring. Skru ned, læg låg på, og lad retten simre i 15 minutter."
    },
    {
      "section": null,
      "text": "Vend majs og ærter i, og varm retten godt igennem. Tag gryden af varmen, og lad den stå med låg på, til risene er møre."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber. Drys med persille, og server."
    }
  ],
