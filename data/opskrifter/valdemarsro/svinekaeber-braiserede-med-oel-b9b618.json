  "steps": [
    {
      "section": "Braiserede svinekæber",
      "text": "Skær senerne af svinekæberne, og tør kødet godt med køkkenrulle."
    },
    {
      "section": "Braiserede svinekæber",
      "text": "Varm smørret i en gryde, og brun kæberne på alle sider. Tag dem op på en tallerken."
    },
    {
      "section": "Braiserede svinekæber",
      "text": "Svits løg, gulerødder og porre i samme gryde ved middelvarme, til løgene er blanke og bløde."
    },
    {
      "section": "Braiserede svinekæber",
      "text": "Kom kødet tilbage i gryden sammen med øl, tomatpuré, laurbærblade, rosmarin og timian. Krydr med salt og peber."
    },
    {
      "section": "Braiserede svinekæber",
      "text": "Læg låg på, og lad retten simre svagt ved lav varme i 2 timer."
    },
    {
      "section": "Braiserede svinekæber",
      "text": "Rør fonden og majsstivelsen sammen, og rør blandingen ned i gryden. Lad det simre videre i 15 minutter."
    },
    {
      "section": "Braiserede svinekæber",
      "text": "Fisk laurbærbladene op, og smag til med salt og peber."
    },
    {
      "section": "Kartoffelmos",
      "text": "Kog kartoflerne møre i usaltet vand. Varm mælken i en lille kasserolle til ca. 50 °C."
    },
    {
      "section": "Kartoffelmos",
      "text": "Mos de varme kartofler groft sammen med smørret. Pisk dem derefter med håndmixer på laveste hastighed, mens du hælder den varme mælk i lidt ad gangen, til moset er cremet, luftigt og blødt."
    },
    {
      "section": "Kartoffelmos",
      "text": "Smag til med salt, peber og friskrevet muskatnød."
    },
    {
      "section": "Hasselnøddedrys",
      "text": "Hak hasselnødder, persille og citronskal sammen, til det er helt fint."
    },
    {
      "section": "Hasselnøddedrys",
      "text": "Anret kæberne med kartoffelmos, og drys med hasselnøddeblandingen."
    }
  ],
