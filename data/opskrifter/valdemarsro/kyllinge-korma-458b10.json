  "steps": [
    {
      "section": "Marinade",
      "text": "Start dagen før. Rør garam masala, chiliflager, gurkemeje, hvidløg, ingefær, limesaft og yoghurt sammen til en marinade."
    },
    {
      "section": "Marinade",
      "text": "Vend kyllingen i marinaden, til alle tern er dækket. Sæt den på køl i 12-24 timer."
    },
    {
      "section": "Færdiggørelse",
      "text": "Varm kokosolien op i en gryde eller dyb pande, og svits rødløgene, til de er bløde."
    },
    {
      "section": "Færdiggørelse",
      "text": "Tilsæt kyllingen med al marinaden, og brun den under jævnlig omrøring. Rør tomatpuré og kokosmælk i."
    },
    {
      "section": "Færdiggørelse",
      "text": "Læg låg på, og lad retten simre i 30 minutter. Kog imens risene efter anvisningen på posen."
    },
    {
      "section": "Færdiggørelse",
      "text": "Hak mandlerne groft, og rør dem i lige før servering. Smag til med salt og peber."
    },
    {
      "section": "Færdiggørelse",
      "text": "Anret kormaen i dybe tallerkener med ris ved siden af. Hak koriander groft, og drys over."
    }
  ],
