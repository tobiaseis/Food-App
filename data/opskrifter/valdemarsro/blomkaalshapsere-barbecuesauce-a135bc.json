  "steps": [
    {
      "section": "Blomkål",
      "text": "Tænd ovnen på 180 °C varmluft. Beklæd en bradepande med bagepapir."
    },
    {
      "section": "Blomkål",
      "text": "Skær blomkålen i store buketter, og tør dem grundigt med køkkenrulle."
    },
    {
      "section": "Blomkål",
      "text": "Pisk hvedemel, røget paprika og salt sammen med vandet til en tyktflydende dej. Tilsæt lidt mere vand, hvis den er for tør."
    },
    {
      "section": "Blomkål",
      "text": "Vend buketterne i dejen, og fordel dem på bradepanden, så de ikke rører hinanden. Bag dem i 15-20 minutter."
    },
    {
      "section": "Sticky barbecuesauce",
      "text": "Rør sojasauce, hvidløg, lønnesirup, tomatpuré, ingefær, eddike og vand sammen i en skål. Sigt majsstivelsen ned i, og pisk, til saucen er glat."
    },
    {
      "section": "Sticky barbecuesauce",
      "text": "Hæld saucen i en pande ved middelvarme. Når den er varm, lægger du de bagte buketter i og vender dem forsigtigt."
    },
    {
      "section": "Sticky barbecuesauce",
      "text": "Lad det simre ved svag varme i 5-6 minutter, og vend af og til, til saucen klæber til blomkålen."
    },
    {
      "section": "Til servering",
      "text": "Strø sesamfrø og persille over, og server med en dip ved siden af."
    }
  ],
  "changes": [
    "Ahornsirup er skiftet til lønnesirup.",
    "Æblecidereddike er skiftet til almindelig eddike (æblecidereddike)."
  ]
