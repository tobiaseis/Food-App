  "steps": [
    {
      "section": "Bagt feta",
      "text": "Varm ovnen op til 220 grader varmluft. Læg fetaen til servering på en bradepande med bagepapir, og dryp med lønnesirup og olie. Bag, til kanterne er gyldne."
    },
    {
      "section": "Rösti",
      "text": "Pres væden ud af de revne kartofler og den revne squash. Rør dem sammen med spinat, æg, feta, mel og hvidløg i en skål, og krydr med salt og peber."
    },
    {
      "section": "Rösti",
      "text": "Del dejen i fire. Varm olie op på en pande, og steg én rösti ad gangen, til undersiden er gylden. Vend den, og steg færdig på den anden side. Gentag med resten."
    },
    {
      "section": "Til servering",
      "text": "Læg edamamebønnerne i en skål, og dæk dem med kogende vand. Lad dem stå et øjeblik, og hæld vandet fra."
    },
    {
      "section": "Til servering",
      "text": "Mos avocadoen med citronsaft og citronskal, og smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Læg rösti på tallerkener, og top med rucola, edamamebønner og avocadomos. Smuldr den bagte feta ovenpå, og drys med karse."
    }
  ],
