  "steps": [
    {
      "section": "Dej",
      "text": "Rør gæren ud i vandet i en stor skål. Tilsæt hvedemel, olivenolie og salt."
    },
    {
      "section": "Dej",
      "text": "Ælt dejen i røremaskinen ved middelhastighed i 10 minutter, til den er glat, blød og smidig."
    },
    {
      "section": "Dej",
      "text": "Smør en skål med olivenolie, læg dejen i og vend den rundt, så den er helt dækket af olie."
    },
    {
      "section": "Dej",
      "text": "Dæk skålen og lad dejen hæve på køkkenbordet i 30 minutter. Sæt den derefter i køleskabet i 10-24 timer."
    },
    {
      "section": "Tomatsauce",
      "text": "Mix tomater, tomatpuré, hvidløg, basilikum og oregano jævnt sammen. Smag til med salt og peber."
    },
    {
      "section": "Bagning",
      "text": "Sæt ovnen på dens højeste temperatur en time før bagning, og lad bagestål eller bageplade varme med."
    },
    {
      "section": "Bagning",
      "text": "Mel køkkenbordet let og skær dejen over i to lige store stykker. Rul hvert stykke ud til en firkant på 30×30 cm."
    },
    {
      "section": "Bagning",
      "text": "Smør tomatsauce ud på begge firkanter, og top med mozzarella, rødløg, oliven og presset hvidløg. Lad en kant på ca. 2 cm langs den ene side være fri."
    },
    {
      "section": "Bagning",
      "text": "Rul hver firkant sammen til en rulle, og klem samlingen sammen på den frie kant. Læg rullerne med samlingen nedad på bagepapir."
    },
    {
      "section": "Bagning",
      "text": "Sænk ovnen til 200 °C varmluft. Skub rullerne med papiret ind på den varme plade, og bag dem i ca. 15 minutter, til de er gyldne og sprøde."
    }
  ],
  "changes": [
    "Flagesalt er skiftet til almindeligt salt."
  ]
}
