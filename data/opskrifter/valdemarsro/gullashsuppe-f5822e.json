  "steps": [
    {
      "section": null,
      "text": "Varm en stor gryde op, og rist baconen, til den er næsten sprød. Løft den op på køkkenrulle, så fedtet kan løbe af."
    },
    {
      "section": null,
      "text": "Hæld olivenolien i gryden til baconfedtet. Svits løg, hvidløg, selleri og gulerødder et par minutter ved middelvarme."
    },
    {
      "section": null,
      "text": "Kom oksekødet i gryden, og brun det på alle sider."
    },
    {
      "section": null,
      "text": "Drys spidskommen, paprika, salt og peber over, og læg baconen tilbage. Rør rundt i cirka et minut."
    },
    {
      "section": null,
      "text": "Hæld bouillon, tomatpuré og hakkede tomater i. Læg låg på, og lad suppen simre i 2-3 timer."
    },
    {
      "section": null,
      "text": "Tilsæt kartofler og peberfrugt, og kog suppen videre i 20 minutter, til kartoflerne er møre. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Anret suppen i skåle med en klat creme fraiche, og strø purløg og persille over."
    }
  ],
  "changes": []
