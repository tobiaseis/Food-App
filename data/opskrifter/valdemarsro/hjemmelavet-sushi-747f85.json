  "steps": [
    {
      "section": "Ris",
      "text": "Kog risen efter pakkens anvisning et par timer, før sushien skal rulles."
    },
    {
      "section": "Ris",
      "text": "Vend sukker, salt og eddike forsigtigt ind i risen, mens den stadig er lun."
    },
    {
      "section": "Ris",
      "text": "Lad risen køle af til stuetemperatur. Den må ikke være kold fra køleskabet."
    },
    {
      "section": "Rul sushien",
      "text": "Læg et noriark på en bambusmåtte. Fordel en portion ris udover arket, og tryk den let flad med fingrene. Lad en kant på ca. 2 cm tættest på dig og 3 cm længst væk være helt fri for ris."
    },
    {
      "section": "Rul sushien",
      "text": "Læg salat, laks, flødeost og purløg i en stribe midt på risen."
    },
    {
      "section": "Rul sushien",
      "text": "Rul sushien stramt sammen ved hjælp af måtten. Skær rullen i stykker med en rigtig skarp kniv."
    },
    {
      "section": "Rul sushien",
      "text": "Gentag med de øvrige ark. Server med wasabi, sojasauce og syltet ingefær."
    }
  ],
