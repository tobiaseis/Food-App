  "steps": [
    {
      "section": "Grøntsagsdeller",
      "text": "Rør æg, hvedemel og spidskål sammen i en skål. Tilsæt timian, soltørrede tomater og hvidløg, og rør det hele godt igennem. Lad farsen hvile i 15 minutter, og rør den igennem igen."
    },
    {
      "section": "Grøntsagsdeller",
      "text": "Hak kikærterne groft i en foodprocessor eller minihakker. Smuldr halloumien fint, og vend begge dele i farsen. Smag til med salt og peber."
    },
    {
      "section": "Grøntsagsdeller",
      "text": "Varm olien op på en pande. Læg små portioner fars på panden med en spiseske, og steg dem i ca. 5 minutter, til de er så faste, at de kan vendes. Steg dem derefter færdige på den anden side."
    },
    {
      "section": "Tzatziki",
      "text": "Del agurkerne på langs, og skrab kernerne ud med en ske. Riv dem groft, og vend dem med lidt salt. Lad dem trække i 5-10 minutter."
    },
    {
      "section": "Tzatziki",
      "text": "Hæld agurken i en sigte, og pres alt vandet fra med hænderne. Rør den derefter i yoghurten, og smag til med hvidløg, salt, peber og olivenolie."
    },
    {
      "section": "Ris med citron og persille",
      "text": "Kom vand, ris og salt i en gryde, og rør rundt. Læg låg på, og bring langsomt i kog. Kog under låg ved svag varme i 10 minutter."
    },
    {
      "section": "Ris med citron og persille",
      "text": "Tag gryden af varmen, og lad risen hvile under låg i 10 minutter. Vend citronskal og persille i, inden den skal serveres."
    },
    {
      "section": "Servering",
      "text": "Skær halloumien i skiver på ca. 0,5 cm, og pensl dem med olie. Grill dem på en grillpande, almindelig pande eller grill ved middelvarme, til de er gyldne og sprøde på begge sider."
    },
    {
      "section": "Servering",
      "text": "Anret ris, grøntsagsdeller, tomater, agurk, peberfrugt og rødløg i skåle. Top med tzatziki og grillet halloumi, og fordel oliven og feta over."
    }
  ],
