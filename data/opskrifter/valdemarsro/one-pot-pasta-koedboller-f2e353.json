  "steps": [
    {
      "section": null,
      "text": "Pil skindet af medisterpølsen, og rul farsen til små boller."
    },
    {
      "section": null,
      "text": "Pensl bunden af en stor gryde med olie. Kom bollerne, pastaen og alle de øvrige ingredienser undtagen parmesan og rucola i gryden."
    },
    {
      "section": null,
      "text": "Bring det i kog, og tjek at pastaen er helt dækket af væske. Sæt låg på, og lad det simre i 10-15 minutter, til spaghettien er mør, men stadig har lidt bid."
    },
    {
      "section": null,
      "text": "Anret med parmesan og rucola ovenpå."
    }
