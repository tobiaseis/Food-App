  "steps": [
    {
      "section": "Syltede gulerødder",
      "text": "Bring vand, sukker og riseddike i kog i en gryde, og lad det koge, til sukkeret er opløst. Tag gryden af varmen."
    },
    {
      "section": "Syltede gulerødder",
      "text": "Vend gulerødderne i den varme lage, og fordel dem på glas. Sæt låg på, og stil glassene i køleskabet, mens du laver resten."
    },
    {
      "section": "Asiatisk mayo",
      "text": "Rør mayonnaisen sammen med fiskesauce, hvidløg og ingefær. Smag til med limeskal og peber."
    },
    {
      "section": "Kylling og servering",
      "text": "Varm ovnen op til 225 °C. Læg kyllingebrysterne på en bageplade med bagepapir, og krydr med salt og peber."
    },
    {
      "section": "Kylling og servering",
      "text": "Bag kyllingen i ca. 18-20 minutter, til skindet er sprødt, og kødet er helt gennemstegt."
    },
    {
      "section": "Kylling og servering",
      "text": "Skær kyllingen i skiver. Smør flutene med mayoen, og fyld dem med kylling, gulerødder, agurk, koriander og chiliflager."
    }
  ],
