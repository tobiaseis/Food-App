  "steps": [
    {
      "section": "Boller",
      "text": "Kør kikærter, blomkål og feta i en foodprocessor, til blandingen er grofthakket."
    },
    {
      "section": "Boller",
      "text": "Vend blandingen i en skål med æg, hvidløg og rasp, og smag til med salt og peber. Rør, til farsen er fast og ensartet."
    },
    {
      "section": "Boller",
      "text": "Pensl en æbleskivepande med olivenolie, og varm den op. Form farsen til boller, og steg dem i panden, til de er runde og har en gyldenbrun skorpe."
    },
    {
      "section": "Karrysauce",
      "text": "Rist karryen i en tør gryde, til den dufter. Tilsæt sesamolie, squash, gulerødder, løg, hvidløg, æble og gurkemeje, og rør rundt i et par minutter."
    },
    {
      "section": "Karrysauce",
      "text": "Hæld kokosmælken i, læg låg på, og lad saucen simre i ca. 15 minutter, til gulerødderne er møre."
    },
    {
      "section": "Karrysauce",
      "text": "Blend saucen glat og cremet. Tynd den ud med bouillon, til den har den rigtige konsistens, og smag til med sojasauce og peber."
    },
    {
      "section": "Karrysauce",
      "text": "Læg bollerne i saucen."
    },
    {
      "section": "Til servering",
      "text": "Anret ris og boller i karrysauce på tallerkener. Top med mango chutney, chiliflager og persille."
    }
  ],
  "changes": []
}
