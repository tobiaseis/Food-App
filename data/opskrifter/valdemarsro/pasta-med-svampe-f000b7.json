  "steps": [
    {
      "section": null,
      "text": "Varm smør eller olie op på en pande, og svits løget, til det er blødt."
    },
    {
      "section": null,
      "text": "Skru op på maksimal varme, og brun svampene under jævnlig omrøring."
    },
    {
      "section": null,
      "text": "Skru ned igen, hæld fløden på, og krydr med salt og peber."
    },
    {
      "section": null,
      "text": "Kog pasta, så den følger anvisningen på pakken, og lad den dryppe af."
    },
    {
      "section": null,
      "text": "Vend pasta og svampesauce sammen, og top med masser af hakket persille og parmesan."
