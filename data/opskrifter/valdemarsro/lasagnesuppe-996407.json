  "steps": [
    {
      "section": null,
      "text": "Hæld olien i en gryde, og svits løg og hvidløg ved middel varme, til løgene er bløde."
    },
    {
      "section": null,
      "text": "Sæt varmen op, og brun oksekødet godt, mens du rører rundt."
    },
    {
      "section": null,
      "text": "Tilsæt gulerødder, bladselleri, squash, hakkede tomater, tomatpuré og bouillon."
    },
    {
      "section": null,
      "text": "Lad suppen småkoge i 15-30 minutter."
    },
    {
      "section": null,
      "text": "Læg lasagnepladerne i én ad gangen med lidt afstand, så de ikke klistrer sammen. Kog dem 10 minutter, eller til de er helt møre."
    },
    {
      "section": null,
      "text": "Krydr med salt og peber. Tynd suppen med lidt mere bouillon, hvis du vil have den tyndere."
    },
    {
      "section": "Til servering",
      "text": "Øs suppen op i dybe tallerkener. Rør mozzarella ned i hver portion, og top med parmesan og timianblade."
    }
