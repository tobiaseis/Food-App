  "steps": [
    {
      "section": "Hummus",
      "text": "Blend tahin og citronsaft i en foodprocessor i cirka et minut."
    },
    {
      "section": "Hummus",
      "text": "Kom resten af hummusens ingredienser i og kør igen i cirka et minut. Tilsæt lidt mere koldt vand, hvis du vil have den cremet."
    },
    {
      "section": "Hummus",
      "text": "Smag til med citron, olie, salt og peber."
    },
    {
      "section": "Stegt aubergine",
      "text": "Skær auberginerne i tynde skiver. Gnid dem ind i det pressede hvidløg, pensl dem med olivenolie, og krydr med salt og peber."
    },
    {
      "section": "Stegt aubergine",
      "text": "Steg skiverne i olie på en pande, til de er gyldne og møre. Rør til sidst de hakkede soltørrede tomater og pinjekernerne i."
    },
    {
      "section": "Fyld pitabrødene",
      "text": "Varm pitabrødene i ovnen eller i brødristeren."
    },
    {
      "section": "Fyld pitabrødene",
      "text": "Fyld dem med hummus, rucola og aubergineblandingen. Smuldr feta over, og drys med persille."
    }
  ],
