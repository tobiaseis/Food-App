  "steps": [
    {
      "section": "Fyld",
      "text": "Skær en dyb lomme ind fra siden af hvert kyllingebryst med en spids, skarp kniv. Pas på ikke at skære helt igennem."
    },
    {
      "section": "Fyld",
      "text": "Rør flødeost, chorizo, soltørrede tomater og persille sammen i en skål."
    },
    {
      "section": "Fyld",
      "text": "Kom fyldet i lommerne, og luk åbningen med en kødnål eller tandstikker."
    },
    {
      "section": "Panering",
      "text": "Bland mel med salt og peber. Vend kyllingen i melet, træk den gennem det sammenpiskede æg, og rul den til sidst i rasp."
    },
    {
      "section": "Bagning",
      "text": "Forvarm ovnen til 200 °C varmluft. Læg kyllingen på en bageplade, og bag den i ca. 20 minutter, til panden er sprød og kødet er gennemstegt."
    }
  ],
