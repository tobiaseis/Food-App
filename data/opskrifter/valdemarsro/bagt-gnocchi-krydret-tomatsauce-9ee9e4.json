  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en sauterpande ved middelvarme, og blød løget i den."
    },
    {
      "section": null,
      "text": "Rør hvidløg, soltørrede tomater, basilikum, fennikelfrø, rosmarin og squash i panden. Hæld bouillon og hakkede tomater over, og bring det i kog."
    },
    {
      "section": null,
      "text": "Lad saucen simre uden låg i 10 minutter, så den koger lidt ind."
    },
    {
      "section": null,
      "text": "Tag panden af varmen. Rør ricotta ind, og vend gnocchien forsigtigt i. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Forvarm ovnen til 180 °C varmluft. Kom blandingen i et smurt ovnfast fad."
    },
    {
      "section": null,
      "text": "Pluk mozzarellaen i små stykker, og læg dem over gnocchien. Drys med den første parmesan."
    },
    {
      "section": null,
      "text": "Bag retten i 15-20 minutter, til osten er smeltet og begynder at tage farve."
    },
    {
      "section": null,
      "text": "Server med resten af parmesanen og lidt frisk basilikum drysset over."
    }
  ],
