  "steps": [
    {
      "section": "Suppe",
      "text": "Varm olien i en gryde ved middelvarme. Svits løg, hvidløg og porre, til de er bløde."
    },
    {
      "section": "Suppe",
      "text": "Rør paprika, spidskommen og karry i, og steg et par minutter under omrøring."
    },
    {
      "section": "Suppe",
      "text": "Kom kartofler og gulerødder i gryden, og hæld derefter tomater, tomatpuré, tørret timian og fond i. Lad det simre i 15-20 minutter."
    },
    {
      "section": "Suppe",
      "text": "Blend suppen glat i en kraftig blender, og smag den til med fløde, salt og peber."
    },
    {
      "section": "Suppe",
      "text": "Hæld suppen tilbage i gryden, og kog nudlerne med i et par minutter, til de er møre."
    },
    {
      "section": "Ostebrød",
      "text": "Forvarm ovnen til 200 °C. Gnid brødskiverne med den halve hvidløgsfed, og læg mozzarella ovenpå."
    },
    {
      "section": "Ostebrød",
      "text": "Anret skiverne på en bageplade med bagepapir, og bag dem, til osten er smeltet. Drys med timianblade."
    },
    {
      "section": "Til servering",
      "text": "Øs den varme suppe op i dybe tallerkener, og top med en klat creme fraiche og timianblade. Server med de varme ostebrød."
    }
  ],
