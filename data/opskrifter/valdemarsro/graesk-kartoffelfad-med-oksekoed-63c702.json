  "steps": [
    {
      "section": "Kartoffelfad",
      "text": "Tænd ovnen på 220 °C varmluft. Smør et ovnfast fad."
    },
    {
      "section": "Kartoffelfad",
      "text": "Bland kartofler, peberfrugt, rødløg, soltørrede tomater, timian, rosmarin, olie og flagesalt i fadet, så alt er dækket. Bag i cirka 30 minutter."
    },
    {
      "section": "Oksekød",
      "text": "Mens fadet er i ovnen, steg løget i lidt olivenolie ved middelvarme, til det er blødt. Tilsæt hvidløg og steg med et kort øjeblik."
    },
    {
      "section": "Oksekød",
      "text": "Skru op for varmen, og brun hakkekødet godt, mens du rører hele tiden. Skru ned til middelvarme igen."
    },
    {
      "section": "Oksekød",
      "text": "Kom oregano, timian og hakkede tomater i panden. Smag til med salt og peber, og lad det simre i 5 minutter, til det er kogt lidt ind."
    },
    {
      "section": "Samling",
      "text": "Tag fadet ud af ovnen. Fordel kødsovsen over grøntsagerne, og drys med feta, pinjekerner og oliven."
    },
    {
      "section": "Samling",
      "text": "Sæt fadet tilbage i ovnen i cirka 20 minutter, til kartoflerne er møre. Drys med persille."
    },
    {
      "section": "Tzatziki",
      "text": "Del agurkerne på langs, og skrab kernerne ud med en ske. Riv dem groft, vend dem med salt, og lad dem stå i 5-10 minutter."
    },
    {
      "section": "Tzatziki",
      "text": "Hæld agurken i en sigte, og pres alt væde fra med hænderne. Rør den i yoghurten, og smag til med hvidløg, salt, peber og olivenolie."
    },
    {
      "section": "Tzatziki",
      "text": "Server kartoffelfadet med tzatzikien ved siden af."
    }
  ],
