  "steps": [
    {
      "section": null,
      "text": "Del kyllingebrystet i mundrette stykker. Varm kokosolie op i en gryde eller dyb sauterpande, og steg kyllingen hurtigt. Læg den over på en tallerken."
    },
    {
      "section": null,
      "text": "Brun champignon i samme gryde ved høj varme."
    },
    {
      "section": null,
      "text": "Tilsæt løg, hvidløg, revet ingefær, gurkemeje, ingefærskiverne, kaffirlimeblade og den hakkede chili. Rør rundt, og hæld grøntsagsfonden i."
    },
    {
      "section": null,
      "text": "Sænk varmen, og kom kyllingen tilbage i gryden. Rør citrongræs, kokosmælk og fiskesauce i."
    },
    {
      "section": null,
      "text": "Lad suppen simre i 10-12 minutter. Kog nudlerne efter anvisningen på pakken i mellemtiden."
    },
    {
      "section": null,
      "text": "Kom tomater og peberfrugt i suppen de sidste 5 minutter. Smag til med limesaft, lidt mere fiskesauce og sukker."
    },
    {
      "section": null,
      "text": "Fordel nudlerne i skåle, og øs suppen over. Drys med koriander og chiliringe."
    }
  ],
  "changes": [
    "Galangarod er erstattet af ingefær.",
    "Fishsauce hedder fiskesauce."
  ]
}
