  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en gryde på middelhøj varme, og svits løgene, til de er bløde."
    },
    {
      "section": null,
      "text": "Rør hvidløg, krydderier og gulerødder i gryden, og lad det stege cirka 1 minut."
    },
    {
      "section": null,
      "text": "Hæld det meste af fonden i – start med ca. 1,3 liter, og gem resten til at justere tykkelsen."
    },
    {
      "section": null,
      "text": "Lad suppen simre, til gulerødderne er helt møre."
    },
    {
      "section": null,
      "text": "Hæld kokosmælken i, og blend suppen, til den er cremet og luftig."
    },
    {
      "section": null,
      "text": "Tynd efter behov ud med den resterende fond, til suppen har den tykkelse, du kan lide. Smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Øs suppen op, og dryp lidt kokosmælk over. Top med hakket persille."
    }
  ],
