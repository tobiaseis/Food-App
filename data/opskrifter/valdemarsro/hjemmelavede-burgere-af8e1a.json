  "steps": [
    {
      "section": "Olivenboller",
      "text": "Rør vand og gær ud i en skål. Bland olie, hørfrø, oliven, salt og fuldkornshvedemel i."
    },
    {
      "section": "Olivenboller",
      "text": "Tilsæt hvedemelet lidt ad gangen, til dejen kan æltes på et bord. Den skal være blød og smidig og må gerne klæbe en anelse."
    },
    {
      "section": "Olivenboller",
      "text": "Lad dejen hæve i skålen i 30 minutter."
    },
    {
      "section": "Olivenboller",
      "text": "Slå dejen sammen, del den i 10 stykker og form dem til boller. Læg dem på en bageplade med bagepapir, og lad dem hæve i 1½ time."
    },
    {
      "section": "Olivenboller",
      "text": "Varm ovnen op til 250 °C varmluft. Pensl bollerne med olie og drys flagesalt over."
    },
    {
      "section": "Olivenboller",
      "text": "Sæt bollerne i ovnen, og skru straks ned til 200 °C varmluft. Bag dem i 15-18 minutter, og lad dem køle af på en rist. Overskydende boller kan fryses."
    },
    {
      "section": "Bøffer",
      "text": "Ælt alle ingredienserne til bøfferne grundigt sammen i en skål."
    },
    {
      "section": "Bøffer",
      "text": "Form 4 bøffer, og tryk dem flade."
    },
    {
      "section": "Bøffer",
      "text": "Steg bøfferne i smør ved middel varme i 4-5 minutter på hver side. Læg ost og sprød bacon på lige før de er færdige."
    },
    {
      "section": "Til burgerne",
      "text": "Del bollerne, og byg burgerne med bøf, ost, bacon, salat, tomat, agurk, rødløgsringe, mayonnaise og ketchup."
    }
  ],
