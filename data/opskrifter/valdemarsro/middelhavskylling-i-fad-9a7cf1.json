  "steps": [
    {
      "section": "Kartofler og kylling",
      "text": "Tænd ovnen på 180 °C varmluft."
    },
    {
      "section": "Kartofler og kylling",
      "text": "Bland kartoflerne med olie, halvdelen af urterne, lidt revet citronskal, salt og peber. Læg dem i et ovnfast fad."
    },
    {
      "section": "Kartofler og kylling",
      "text": "Bag kartoflerne i 25 minutter, og rør rundt i dem et par gange."
    },
    {
      "section": "Kartofler og kylling",
      "text": "Gnid kyllingestykkerne ind i olie, resten af urterne, lidt citronskal, salt og peber. Læg dem ned til kartoflerne."
    },
    {
      "section": "Kartofler og kylling",
      "text": "Kom tomater, oliven og feta i fadet. Bag retten videre i 25-30 minutter, til kyllingen er helt gennemstegt."
    },
    {
      "section": "Tzatziki",
      "text": "Del agurkerne på langs, og skrab kernerne ud med en ske. Riv dem groft."
    },
    {
      "section": "Tzatziki",
      "text": "Vend agurken med salt, og lad den stå i 5-10 minutter. Hæld den i en sigte, og pres alt vandet fra med hænderne."
    },
    {
      "section": "Tzatziki",
      "text": "Rør agurken i yoghurten. Smag til med hvidløg, salt, peber og olivenolie."
    },
    {
      "section": "Salat",
      "text": "Vend rucolaen med lidt citronsaft, olie, salt og peber."
    },
    {
      "section": "Salat",
      "text": "Anret kyllingen med salaten og tzatzikien ved siden af."
    }
  ],
