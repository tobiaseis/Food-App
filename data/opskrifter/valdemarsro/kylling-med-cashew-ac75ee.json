  "steps": [
    {
      "section": null,
      "text": "Varm en tør pande op, og rist cashewnødderne, til de netop får en let farve. De må ikke blive mørke. Hæld dem over i en skål."
    },
    {
      "section": null,
      "text": "Svits løgene i lidt olie på panden, til de er blødt. Kom kyllingen i, og vend den rundt, til den er brunet på alle sider."
    },
    {
      "section": null,
      "text": "Rør hvidløg, ingefær, fiskesauce, sojasauce, fond, farin og majsstivelse sammen i en skål."
    },
    {
      "section": null,
      "text": "Hæld saucen over kyllingen, og tilsæt broccoli og det meste af cashewnødderne. Gem lidt til pynt. Rør, mens det varmer op, og lad det så simre i 10-15 minutter, til kyllingen er helt gennemstegt."
    },
    {
      "section": null,
      "text": "Smag til med peber, limesaft og skallen fra en halv lime. Gem den anden halvdel af limen til servering."
    },
    {
      "section": null,
      "text": "Anret risene i skåle, og top med kyllingen. Strø forårsløg og de sidste cashewnødder over, og stil limen frem, så man kan presse den ud over retten."
    }
  ],
