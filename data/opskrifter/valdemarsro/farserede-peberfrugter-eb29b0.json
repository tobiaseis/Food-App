  "steps": [
    {
      "section": null,
      "text": "Varm en tør pande op og rist pinjekernerne, til de er lysegyldne."
    },
    {
      "section": null,
      "text": "Læg dem over i en stor skål med lammekød, løg, hvidløg, fløde, æg, timian, chiliflager, spidskommen, salt og peber. Bland det grundigt – farsen skal være ret blød."
    },
    {
      "section": null,
      "text": "Halvér peberfrugterne på langs og fjern kernehuset."
    },
    {
      "section": null,
      "text": "Fordel farsen i peberfrugthalvdelene og stil dem i et indsmurt ovnfast fad. Hæld fonden ned i fadet."
    },
    {
      "section": null,
      "text": "Bag i forvarmet ovn ved 175 °C varmluft i 20 minutter."
    },
    {
      "section": null,
      "text": "Tag fadet ud, strø fetaen over, og dryp med olivenolie. Bag i yderligere 10 minutter."
    },
    {
      "section": null,
      "text": "Server med hakket persille drysset over."
    }
  ],
