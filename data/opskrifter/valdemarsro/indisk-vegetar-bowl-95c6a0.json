  "steps": [
    {
      "section": "Blomkål og kikærter",
      "text": "Pisk æg, mayonnaise og halvdelen af paprikaen sammen i en skål, til blandingen er ensartet. Bland pankorasp med salt og peber i en anden skål."
    },
    {
      "section": "Blomkål og kikærter",
      "text": "Vend blomkålsbuketterne først i æggeblandingen og så i raspen. Læg dem på en bageplade med bagepapir."
    },
    {
      "section": "Blomkål og kikærter",
      "text": "Bag blomkålen i ovnen ved 200 °C varmluft i ca. 10 minutter. Forvarm ovnen først."
    },
    {
      "section": "Blomkål og kikærter",
      "text": "Vend kikærterne i olie og dernæst i resten af paprikaen. Læg dem på pladen ved siden af blomkålen, og læg de 3 fed hvidløg til yoghurten med."
    },
    {
      "section": "Blomkål og kikærter",
      "text": "Bag videre i ca. 20 minutter, til blomkålen er sprød udenpå og mør indeni."
    },
    {
      "section": "Rispilaf",
      "text": "Varm smørret op på en pande ved middelvarme. Svits løg, ingefær, hvidløg, spidskommen og garam masala, til det dufter, og løgene er bløde."
    },
    {
      "section": "Rispilaf",
      "text": "Rør risene med i et par minutter. Hæld fonden over, læg låg på, og lad det simre ved svag varme i 10 minutter."
    },
    {
      "section": "Rispilaf",
      "text": "Tag panden af varmen, og lad risene stå under låg i 10 minutter mere. Vend persillen i til sidst."
    },
    {
      "section": "Ananassalsa",
      "text": "Bland ananas, mynte og koriander i en skål. Smag til med limesaft, limeskal, chili, salt og peber."
    },
    {
      "section": "Hvidløgsyoghurt",
      "text": "Pres de bagte hvidløg ud af skallen, og mos dem med en gaffel i en lille skål. Rør yoghurten i, og smag til med salt og peber."
    },
    {
      "section": "Servering",
      "text": "Fordel rispilafen i skåle. Læg blomkål og kikærter ovenpå, og top med ananassalsa og hvidløgsyoghurt."
    }
  ],
