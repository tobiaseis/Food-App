  "steps": [
    {
      "section": "Pico de gallo",
      "text": "Bland tomater, rødløg, hvidløg, koriander og limeskal og -saft fra de to limefrugter i en stor skål. Tilsæt kun halvdelen af chilien til at begynde med."
    },
    {
      "section": "Pico de gallo",
      "text": "Smag til med salt, peber og efter behov mere chili, limesaft og limeskal."
    },
    {
      "section": "Halloumi",
      "text": "Vend halloumistavene først i hvedemel, så i sammenpisket æg og til sidst i pankorasp. Lad dem hvile på en tallerken et par minutter, så panaden hæfter."
    },
    {
      "section": "Halloumi",
      "text": "Varm olien i en pande, og steg stavene på alle sider, til de er gyldne og sprøde."
    },
    {
      "section": "Servering",
      "text": "Lun hotdogbrødene i ovnen. Mos imens avocadoen med lidt limesaft og -skal, salt og peber."
    },
    {
      "section": "Servering",
      "text": "Fordel avocadocremen i brødene, og læg halloumistave i. Top med pico de gallo og jalapeños, og drys med groft hakket koriander."
    }
  ],
