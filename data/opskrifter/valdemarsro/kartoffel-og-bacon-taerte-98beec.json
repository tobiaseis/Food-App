  "steps": [
    {
      "section": "Tærtebund",
      "text": "Rør begge slags mel sammen med salt. Smuldr smørret i melet med fingrene, eller kør det i en foodprocessor."
    },
    {
      "section": "Tærtebund",
      "text": "Tilsæt vand og æltes til en dej. Lad den helst hvile på køl i 30 minutter."
    },
    {
      "section": "Tærtebund",
      "text": "Tryk dejen ud i en smurt tærteform på ca. 24 cm, og prik bunden med en gaffel."
    },
    {
      "section": "Tærtebund",
      "text": "Forbag bunden i 10 minutter i ovnen ved 175 °C varmluft. Forvarm ovnen først."
    },
    {
      "section": "Fyld",
      "text": "Bring letsaltet vand i kog i en gryde, og kog kartoffeltern i 3 minutter. De skal ikke være møre."
    },
    {
      "section": "Fyld",
      "text": "Si kartoflerne fra, og lad dem dampe af og køle lidt i sigten."
    },
    {
      "section": "Fyld",
      "text": "Pisk æg, mælk, creme fraiche, sennep, muskatnød, timian og peber sammen i en skål, til massen er jævn."
    },
    {
      "section": "Fyld",
      "text": "Vend kartofler, løg og bacon i æggemassen."
    },
    {
      "section": "Fyld",
      "text": "Hæld fyldet i den forbagte bund, og bag tærten i 40 minutter ved 175 °C varmluft."
    }
  ],
