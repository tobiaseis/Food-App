  "steps": [
    {
      "section": "Peanutbutterdressing",
      "text": "Læg hvidløget i en skål, og hæld det kogende vand over. Lad det stå i 5 minutter."
    },
    {
      "section": "Peanutbutterdressing",
      "text": "Tilsæt sukker, chiliflager og peanutbutter, og pisk det sammen, til dressingen er cremet og glat."
    },
    {
      "section": "Peanutbutterdressing",
      "text": "Rør limesaft, limeskal, sesamolie og ingefær i, og smag til med lidt af sojaen."
    },
    {
      "section": "Salat",
      "text": "Kog nudlerne som anvist på posen. Hæld vandet fra, og skyl dem straks i iskoldt vand, så de stopper med at koge og ikke klistrer."
    },
    {
      "section": "Salat",
      "text": "Vend nudlerne med sesamolien og halvdelen af sojaen."
    },
    {
      "section": "Salat",
      "text": "Masser grønkålen med resten af sojaen i en skål."
    },
    {
      "section": "Salat",
      "text": "Læg edamamebønnerne i en skål, og dæk dem med kogende vand. Lad dem stå i 1-2 minutter, og si dem derefter."
    },
    {
      "section": "Salat",
      "text": "Fordel grønkål, rødkål, edamamebønner, rødløg og spinat på et stort fad eller i en stor skål. Læg nudler og dressing ovenpå."
    },
    {
      "section": "Salat",
      "text": "Pynt med avocado og mango, og strø koriander, sesamfrø, peanuts og lidt chiliflager over lige før servering."
    }
  ],
