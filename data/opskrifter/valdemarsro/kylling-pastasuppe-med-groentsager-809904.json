  "steps": [
    {
      "section": null,
      "text": "Varm olien i en gryde ved middelvarme. Svits løg, hvidløg og bladselleri, til de er bløde."
    },
    {
      "section": null,
      "text": "Skru op på højeste varme. Kom squash, soltørrede tomater og kyllingetern i gryden, og rør rundt, til kyllingen har fået farve."
    },
    {
      "section": null,
      "text": "Rør rosmarin, fennikelfrø, oregano, paprika og tomatpuré ned i gryden. Hæld hønsefond, grøntsagsfond og hakkede tomater i, og bring det i kog."
    },
    {
      "section": null,
      "text": "Kom pastaen i, og lad suppen simre i 10-15 minutter, til pastaen er næsten helt mør."
    },
    {
      "section": null,
      "text": "Tilsæt broccoli og fløde. Smag til med salt og peber, bring i kog igen, og tag straks gryden af varmen."
    },
    {
      "section": null,
      "text": "Øs suppen op i dybe tallerkener. Top med parmesan og frisk oregano."
    }
  ],
  "changes": []
