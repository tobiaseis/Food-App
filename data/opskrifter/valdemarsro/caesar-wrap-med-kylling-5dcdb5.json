  "steps": [
    {
      "section": "Kylling",
      "text": "Varm ovnen op til 180 °C varmluft og smør et ovnfast fad."
    },
    {
      "section": "Kylling",
      "text": "Vend kyllingen i hvedemel, salt og peber, og læg den i fadet. Bag den i 15-20 minutter, til den er helt gennemstegt."
    },
    {
      "section": "Croutoner",
      "text": "Smør brødet med smør på begge sider, og skær det i tern."
    },
    {
      "section": "Croutoner",
      "text": "Fordel ternene på en bageplade med bagepapir, og rist dem i ovnen i 5 minutter."
    },
    {
      "section": "Cæsardressing",
      "text": "Rør ansjos, worcestershiresauce, parmesan, hvidløg og citronsaft til en tyk, jævn creme."
    },
    {
      "section": "Cæsardressing",
      "text": "Bland mayonnaise og creme fraiche i, og smag dressingen til med salt og peber."
    },
    {
      "section": "Servering",
      "text": "Skær kyllingen i skiver. Varm tortillaerne på en pande, til de er bløde og lune."
    },
    {
      "section": "Servering",
      "text": "Fyld tortillaerne med salat, kylling, croutoner og dressing. Drys med frisk parmesan."
    }
  ],
