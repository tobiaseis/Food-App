  "steps": [
    {
      "section": "Suppen",
      "text": "Vend tomater, peberfrugt, løg og hvidløg med olivenolie, salt og peber."
    },
    {
      "section": "Suppen",
      "text": "På grill: Læg grøntsagerne på en grillbakke og grill dem, til de er helt møre. Vend dem et par gange undervejs."
    },
    {
      "section": "Suppen",
      "text": "I ovn: Fordel grøntsagerne på en bradepande med bagepapir og bag dem ved 180 °C varmluft i 30-35 minutter, til de er møre."
    },
    {
      "section": "Suppen",
      "text": "Kom de grillede eller bagte grøntsager i en blender sammen med fonden og timianen. Blend glat."
    },
    {
      "section": "Suppen",
      "text": "Tilsæt fløden til sidst og blend igen, så suppen bliver cremet og fyldig."
    },
    {
      "section": "Ristede kikærter",
      "text": "Dræn kikærterne og vend dem i olie og røget paprika. Rist dem på en pande eller i ovnen, til de er sprøde."
    },
    {
      "section": "Til servering",
      "text": "Hæld suppen i dybe tallerkener. Top med creme fraiche, persille, karse og de ristede kikærter."
    }
  ],
