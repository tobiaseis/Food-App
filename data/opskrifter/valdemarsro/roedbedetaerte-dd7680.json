  "steps": [
    {
      "section": "Tærtebund",
      "text": "Bland begge slags mel med fennikelfrø og salt. Smuldr smørret ud i melblandingen med fingrene, eller kør det i en foodprocessor."
    },
    {
      "section": "Tærtebund",
      "text": "Tilsæt vandet, og saml det til en dej. Lad den gerne hvile på køl i 30 minutter."
    },
    {
      "section": "Tærtebund",
      "text": "Tænd ovnen på 175 °C varmluft. Tryk dejen ud i en smurt tærteform på 27 cm og prik bunden med en gaffel."
    },
    {
      "section": "Tærtebund",
      "text": "Forbag bunden i 10 minutter."
    },
    {
      "section": "Fyld",
      "text": "Pisk æg, creme fraiche, honning, rosmarin, fennikelfrø, salt og peber godt sammen i en skål."
    },
    {
      "section": "Fyld",
      "text": "Vend rødbeder, rødløg, feta og valnødder i æggemassen."
    },
    {
      "section": "Fyld",
      "text": "Hæld fyldet i den forbagte bund, og bag tærten ved 175 °C varmluft i cirka 35 minutter, til æggemassen er stivnet."
    },
    {
      "section": "Til pynt",
      "text": "Drys tærten med de hakkede valnødder og timianbladene."
    }
  ],
  "changes": [
    "Akaciehonning er skiftet til almindelig honning."
  ]
}
