  "steps": [
    {
      "section": "Kikærtebøffer",
      "text": "Kør kikærter, æg, løg, hvidløg, krydderier, rugmel, olie, salt og peber i en foodprocessor eller minihakker, til farsen er jævn."
    },
    {
      "section": "Kikærtebøffer",
      "text": "Stil farsen på køl og lad den hvile i 30 minutter."
    },
    {
      "section": "Kikærtebøffer",
      "text": "Hæld rasp på en tallerken. Smør hænderne med olie, og del farsen i 4 lige store stykker."
    },
    {
      "section": "Kikærtebøffer",
      "text": "Form hvert stykke til en kugle, og tryk den flad i raspen. Vend den, så begge sider er dækket, og så bøffen er rund og jævn."
    },
    {
      "section": "Kikærtebøffer",
      "text": "Læg bøfferne på en bageplade med bagepapir, og pensl dem med olie."
    },
    {
      "section": "Kikærtebøffer",
      "text": "Bag dem midt i ovnen ved 190 °C varmluft i 25-30 minutter, til kanterne er gyldne og sprøde. Forvarm ovnen først."
    },
    {
      "section": "Til servering",
      "text": "Varm burgerbollerne, og smør dem med mayonnaise."
    },
    {
      "section": "Til servering",
      "text": "Mos avocadoen med en gaffel."
    },
    {
      "section": "Til servering",
      "text": "Byg burgerne med salat, tomat, agurk, løg, persille, kikærtebøf og avocadomos."
    }
  ],
