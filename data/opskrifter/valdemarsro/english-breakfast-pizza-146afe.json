  "steps": [
    {
      "section": "Pizzadej",
      "text": "Rør gæren ud i det lunkne vand i en stor skål. (Vil du koldhæve dejen natten over, så brug kun 5 g gær i stedet.)"
    },
    {
      "section": "Pizzadej",
      "text": "Tilsæt olien, saltet og halvdelen af melet, og rør, til det er jævnt. Rør resten af melet i lidt ad gangen."
    },
    {
      "section": "Pizzadej",
      "text": "Vend dejen ud på et meldrysset bord, og ælt den med hænderne, til den er smidig."
    },
    {
      "section": "Pizzadej",
      "text": "Skyl skålen, og gnid den ind med olie. Læg dejen i, og vend den, så den får olie hele vejen rundt. Det gør den let at arbejde med og giver en sprød bund."
    },
    {
      "section": "Pizzadej",
      "text": "Lad dejen hæve i 45-60 minutter, eller sæt den i køleskabet natten over."
    },
    {
      "section": "Pizzasauce",
      "text": "Blend alle ingredienserne til sauce, til den er helt jævn. Regn med 1-2 spsk til hver pizza. Resten kan fryses i små portioner."
    },
    {
      "section": "Topping",
      "text": "Drys bordet med mel, og del dejen i to. Form to runde bunde med hænderne, og smør dem med sauce."
    },
    {
      "section": "Topping",
      "text": "Fordel mozzarella og tomater over bunden, og slå æggene ud ovenpå. Drys med bacon."
    },
    {
      "section": "Topping",
      "text": "Grill pizzaerne i 7-10 minutter, eller bag dem i ovnen ved 250 °C i 12-15 minutter."
    },
    {
      "section": "Topping",
      "text": "Tjek, at bunden er sprød. Server med persille, peber og lidt groft salt."
    }
  ],
