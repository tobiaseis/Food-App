  "steps": [
    {
      "section": "Bøf Stroganoff",
      "text": "Tør kødstrimlerne let af med køkkenrulle. Bland paprika, hvedemel, salt og peber, og vend kødet rundt i blandingen."
    },
    {
      "section": "Bøf Stroganoff",
      "text": "Steg baconskiverne sprøde i en tykbundet gryde på middelvarme. Tag dem op, og skær dem i tern, når de er afkølet lidt."
    },
    {
      "section": "Bøf Stroganoff",
      "text": "Skru lidt op for varmen, og tilsæt en smule ekstra olivenolie til baconfedtet. Rist champignon og løg, til løgene er bløde og gyldne, og svampene er sprøde og saftige. Stil dem på en tallerken."
    },
    {
      "section": "Bøf Stroganoff",
      "text": "Brun kødet på alle sider i gryden med olivenolie og smør. Kom tomatpuré, løg, bacon, champignon og laurbærblade i, og hæld en del af kalvefonden over."
    },
    {
      "section": "Bøf Stroganoff",
      "text": "Læg låg på, og lad retten simre ca. 1 time. Hæld mere fond i, hvis gryden bliver tør. Retten er klar, når kødet er mørt – tiden afhænger af udskæringen."
    },
    {
      "section": "Bøf Stroganoff",
      "text": "Rør fløden i, og smag til med salt og peber. Drys med persille."
    },
    {
      "section": "Kartoffelmos",
      "text": "Kog kartoflerne møre i usaltet vand, og hæld vandet fra."
    },
    {
      "section": "Kartoffelmos",
      "text": "Mos kartoflerne sammen med smørret, og pisk dem derefter med en elpisker."
    },
    {
      "section": "Kartoffelmos",
      "text": "Pisk mælken i lidt ad gangen, til mosen er cremet og blød. Smag til med salt, peber og muskatnød."
    },
    {
      "section": "Kartoffelmos",
      "text": "Server kødet med mosen, og top med persille og lidt muskatnød."
    }
  ],
