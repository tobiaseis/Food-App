  "steps": [
    {
      "section": null,
      "text": "Kog pastaen i rigeligt vand, som det står på pakken."
    },
    {
      "section": null,
      "text": "Når pastaen er al dente, kommer de frosne edamamebønner direkte op i kogevandet. Si det hele fra med det samme, og lad det dryppe godt af."
    },
    {
      "section": null,
      "text": "Rist pinjekernerne på en tør pande, mens du rører rundt, til de har fået en gyldenbrun farve."
    },
    {
      "section": null,
      "text": "Bland pasta og edamamebønner med pesto og soltørrede tomater i en stor skål."
    },
    {
      "section": null,
      "text": "Vend rucola, avocado, feta og parmesan forsigtigt ned i salaten."
    },
    {
      "section": null,
      "text": "Server salaten i et fad eller i skåle, og strø de ristede pinjekerner over."
    }
