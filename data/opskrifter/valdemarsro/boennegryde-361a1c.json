  "steps": [
    {
      "section": "Gryde",
      "text": "Rist alle krydderierne i en tør gryde under omrøring, til det dufter kraftigt."
    },
    {
      "section": "Gryde",
      "text": "Sænk varmen. Tilsæt olie, løg, hvidløg og ingefær, og svits, til løgene er blødt."
    },
    {
      "section": "Gryde",
      "text": "Rør squash, bladselleri, hakkede tomater og fond i. Læg låg på, og lad det simre i mindst 30 minutter – gerne en hel time."
    },
    {
      "section": "Gryde",
      "text": "Vend kidneybønner, peberfrugt og majs i, og lad gryden blive gennemvarm i 5 minutter."
    },
    {
      "section": "Gryde",
      "text": "Rør chokoladen i, og smag til med salt og peber."
    },
    {
      "section": "Toppings",
      "text": "Anret creme fraiche, koriander, nachos, rødløg, ristet majs og avocado i små skåle, og sæt dem på bordet ved siden af gryden, så alle kan tage selv."
    }
  ],
