  "steps": [
    {
      "section": "Mangosalsa",
      "text": "Kom mango, avocado, koriander og basilikum i en skål."
    },
    {
      "section": "Mangosalsa",
      "text": "Tilsæt limeskal og limesaft, chili, salt og peber, og vend det hele forsigtigt."
    },
    {
      "section": "Pico de gallo",
      "text": "Bland alle ingredienserne i en stor skål, men brug kun halvdelen af chilien til at begynde med."
    },
    {
      "section": "Pico de gallo",
      "text": "Smag til og justér med mere chili, limesaft, limeskal, salt og peber."
    },
    {
      "section": "Torsk",
      "text": "Drys torsken med de tørre krydderier samt salt og peber, og tryk dem let ind i fisken."
    },
    {
      "section": "Torsk",
      "text": "Dyp fisken først i pisket æg og derefter i panko, så den er dækket hele vejen rundt."
    },
    {
      "section": "Torsk",
      "text": "Varm olie og smør op på en pande. Steg torsken på alle sider, til panerin er sprød, og fisken netop er gennemstegt."
    },
    {
      "section": "Torsk",
      "text": "Anret torsken med pico de gallo og mangosalsa ved siden af."
    }
  ],
  "changes": []
