  "steps": [
    {
      "section": "Tzatziki",
      "text": "Bland den revne agurk med salt, og lad den dryppe af i en sigte i 30 minutter. Pres derefter vandet ud af agurken."
    },
    {
      "section": "Tzatziki",
      "text": "Rør agurken sammen med yoghurt og hvidløg. Stil tzatzikien på køl, til burgerne skal samles."
    },
    {
      "section": "Lammebøffer",
      "text": "Ælt lammekød, æg, feta, oregano, rosmarin og olivenolie godt sammen i en skål. Krydr med salt og peber."
    },
    {
      "section": "Lammebøffer",
      "text": "Form farsen til fire bøffer. Steg dem på en varm pande i smør eller olie, til de er gennemstegte."
    },
    {
      "section": "Til servering",
      "text": "Skær rødløget i tynde skiver. Byg burgerne med bund, salat, lammebøf, rigeligt tzatziki og rødløg, og læg toppen på."
    }
  ],
