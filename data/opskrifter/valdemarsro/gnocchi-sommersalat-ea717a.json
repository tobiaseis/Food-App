  "steps": [
    {
      "section": null,
      "text": "Grill majskolberne, til de er møre og har fået grillstriber. Pensl dem med smør, mens de er varme, og drys med salt. Lad dem køle lidt af, og skær så kernerne af kolben."
    },
    {
      "section": null,
      "text": "Rist pinjekernerne på en tør pande, til de er let gyldne. Læg dem på en tallerken."
    },
    {
      "section": null,
      "text": "Kom gnocchi og kikærter på panden sammen med olie og smør. Steg ved middelhøj varme under jævnlig omrøring, til begge dele er gyldne og har fået skorpe. Krydr med salt og peber."
    },
    {
      "section": "Til dressingen",
      "text": "Rør creme fraiche sammen med basilikum, hvidløg, citronskal og et pift citronsaft. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Vend rucolaen med et par skefulde af dressingen. Bland den i en skål med tomater, majs, kikærter, gnocchi og avocado."
    },
    {
      "section": null,
      "text": "Top med pinjekerner og basilikum lige inden servering. Server resten af dressingen ved siden af."
    }
  ],
  "changes": []
