  "steps": [
    {
      "section": "Tomatsauce",
      "text": "Varm lidt olivenolie op i en gryde, og svits løgene, til de er bløde."
    },
    {
      "section": "Tomatsauce",
      "text": "Kom hvidløg, squash, hakkede tomater, soltørrede tomater, bouillon, timian og basilikum i gryden. Lad saucen simre uden låg i 30 minutter."
    },
    {
      "section": "Tomatsauce",
      "text": "Smag saucen til med salt og peber."
    },
    {
      "section": "Malfatti",
      "text": "Læg den frosne spinat i en gryde med kogende vand, og lad den simre i ca. 1 minut, til den er tøet op. Hæld den i en sigte, lad vandet løbe af, og hak spinaten fint."
    },
    {
      "section": "Malfatti",
      "text": "Rør ricotta, parmesan, æg, hvedemel og muskatnød sammen i en skål med salt og peber, til dejen er glat. Vend den hakkede spinat i dejen."
    },
    {
      "section": "Malfatti",
      "text": "Rul dejen til små kugler. Bring vand i en gryde til lige under kogepunktet, og skru ned til middelvarme, så vandet knap nok simrer."
    },
    {
      "section": "Malfatti",
      "text": "Læg kuglerne i vandet, og lad dem simre nogle få minutter, til de flyder op. Løft dem op med en hulske."
    },
    {
      "section": "Til servering",
      "text": "Anret malfatti i tomatsaucen, og drys generøst med parmesan og frisk basilikum."
    }
  ],
  "changes": []
