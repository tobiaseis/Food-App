  "steps": [
    {
      "section": "Tomatsauce",
      "text": "Put alle ingredienserne til saucen i en gryde, og bring den i kog under omrøring. Lad den simre uden låg, mens du laver dejen."
    },
    {
      "section": "Tærtedej",
      "text": "Bland begge slags mel med saltet, og smuldr smørret ud i melet. Du kan også køre det i en foodprocessor."
    },
    {
      "section": "Tærtedej",
      "text": "Tilsæt vandet, og samle dejen. Lad den gerne hvile på køl i 30 minutter."
    },
    {
      "section": "Tærtedej",
      "text": "Tryk dejen ud i en smurt tærteform, og prik bunden med en gaffel. Forbag den i 10 minutter i ovnen ved 175 °C varmluft, som du har forvarmet."
    },
    {
      "section": "Samling",
      "text": "Hæld tomatsaucen i den forbagte bund. Læg skiverne af aubergine, squash, tomat og peberfrugt ovenpå, og drys med parmesan."
    },
    {
      "section": "Samling",
      "text": "Bag tærten i 30-35 minutter ved 175 °C varmluft i en forvarmet ovn."
    },
    {
      "section": "Til servering",
      "text": "Server tærten med en dryp olivenolie og frisk timian drysset ovenpå."
    }
  ],
  "changes": []
