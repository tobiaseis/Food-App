  "steps": [
    {
      "section": "Bønnefyld",
      "text": "Varm olien i en pande ved middelvarme, og steg løget, til det er blødt. Rør spidskommen, paprika, koriander, oregano og hvidløg i, så krydderierne dækker løget."
    },
    {
      "section": "Bønnefyld",
      "text": "Hæld bønner og hakkede tomater på panden, og bring det i kog. Lad saucen simre uden låg, til den er tyk, og rør af og til."
    },
    {
      "section": "Bønnefyld",
      "text": "Tag panden af varmen. Mos en del af bønnerne groft med bagsiden af en ske, og rør flødeosten i. Smag til med salt og peber."
    },
    {
      "section": "Burritos",
      "text": "Tænd ovnen på 200 °C. Varm tortillaerne på en tør pande, til de er bløde og smidige, og gnid begge sider af hver tortilla med lidt olie."
    },
    {
      "section": "Burritos",
      "text": "Læg en stribe majs, peberfrugt, avocado og cheddar ned ad midten af hver tortilla. Top med 4-5 spiseskefulde af bønnefyldet."
    },
    {
      "section": "Burritos",
      "text": "Fold siderne ind over fyldet, og rul tortillaen stramt sammen. Læg burritoerne med samlingen nedad på en bradepande med bagepapir."
    },
    {
      "section": "Burritos",
      "text": "Bag burritoerne i ca. 15 minutter, til de er gyldne og sprøde."
    },
    {
      "section": "Hvidløgsris",
      "text": "Varm olie og hvidløg i en gryde ved lav til middel varme, til det begynder at dufte."
    },
    {
      "section": "Hvidløgsris",
      "text": "Tilsæt vand, ris og salt, og rør rundt. Sæt låg på, og bring langsomt i kog. Lad risene koge under låg ved svag varme i 10 minutter."
    },
    {
      "section": "Hvidløgsris",
      "text": "Træk gryden af varmen, og lad risene stå med låg på i 10 minutter mere. Vend koriander i lige før servering."
    },
    {
      "section": "Limedressing",
      "text": "Rør creme fraiche sammen med limesaft og -skal, og smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Server de sprøde burritos med hvidløgsris og limedressing."
    }
  ],
