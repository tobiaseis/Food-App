  "steps": [
    {
      "section": "Marinade",
      "text": "Rist kardemomme, kanel, nellike, koriander, spidskommen, fennikelfrø og peber på en tør pande, til det dufter."
    },
    {
      "section": "Marinade",
      "text": "Kom de ristede krydderier i en blender sammen med chili, ingefær, hvidløg, sennepsfrø, paprika, gurkemeje, sukker og eddike. Kør det til en tyk pasta."
    },
    {
      "section": "Marinade",
      "text": "Rør kyllingetern og marinade sammen. Stil det tildækket på køl i 12-24 timer."
    },
    {
      "section": "Tilberedning",
      "text": "Varm olien op i en gryde ved middelvarme, og svits løgene, til de er bløde."
    },
    {
      "section": "Tilberedning",
      "text": "Tilsæt den marinerede kylling, og skru lidt ned for varmen. Lad det blive godt varmt hele vejen igennem."
    },
    {
      "section": "Tilberedning",
      "text": "Rør fond og tomatpuré ned i gryden. Læg låg på, og lad retten simre i cirka 20 minutter, til kyllingen er mør. Smag til med salt."
    },
    {
      "section": "Servering",
      "text": "Server med kogt basmatiris og drys med hakket koriander eller persille. Godt brød passer fint ved siden af."
    }
  ],
  "changes": []
