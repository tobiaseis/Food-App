  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en stor gryde ved middelvarme. Svits løg og hvidløg, til løgene er møre, men uden at de brunes."
    },
    {
      "section": null,
      "text": "Kom pølserne og paprikaen i gryden, og rør rundt et par minutter."
    },
    {
      "section": null,
      "text": "Sænk varmen lidt. Rør tomatpuré, ketchup og chili i, så alt blandes godt."
    },
    {
      "section": null,
      "text": "Tilsæt kartoflerne og mælken, og lad retten simre i 3-4 minutter."
    },
    {
      "section": null,
      "text": "Hæld fløden i under omrøring. Smag til med eddike, salt og peber."
    },
    {
      "section": null,
      "text": "Lad retten blive gennemvarm, mens du rører. Server med rigeligt purløg på toppen."
    }
  ],
