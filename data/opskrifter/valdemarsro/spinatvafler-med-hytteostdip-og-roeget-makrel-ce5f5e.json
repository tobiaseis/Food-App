  "steps": [
    {
      "section": "Hytteostdip",
      "text": "Kom hytteost, avocado, hvidløg, salt og peber i en høj skål, og kør det cremet med stavblenderen."
    },
    {
      "section": "Hytteostdip",
      "text": "Tilsæt purløg og persille, og blend kort. Stil dippen på køl, mens vaflerne laves."
    },
    {
      "section": "Spinatvafler",
      "text": "Pisk hvedemel, fuldkornshvedemel og bagepulver sammen i en skål."
    },
    {
      "section": "Spinatvafler",
      "text": "Skyl spinaten grundigt. Kom den i en blender med æg, mælk og melblandingen."
    },
    {
      "section": "Spinatvafler",
      "text": "Kør dejen helt glat og tyndtflydende. Lad den gerne trække i 15 minutter, så den tykner lidt."
    },
    {
      "section": "Spinatvafler",
      "text": "Smør vaffeljernet let med smør eller olie. Bag vaflerne, til de er gyldne og færdigbagte."
    },
    {
      "section": "Servering",
      "text": "Læg hytteostdip, avocado, agurk, rødløg, makrel og rucola oven på vaflerne. Pres lidt citronsaft over."
    }
