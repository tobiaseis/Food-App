  "steps": [
    {
      "section": null,
      "text": "Varm olie op i en stor sauterpande, og brun kyllingen hurtigt under omrøring."
    },
    {
      "section": null,
      "text": "Sænk varmen, og svits løg og hvidløg sammen med kyllingen, til løget er blødt."
    },
    {
      "section": null,
      "text": "Kom squash, selleri og broccoli i panden, og rør rundt."
    },
    {
      "section": null,
      "text": "Kog pastaen i let saltet vand, til der mangler 2-3 minutter i, at den er færdig. Si den over en skål, så du gemmer kogevandet."
    },
    {
      "section": null,
      "text": "Hæld 2 dl af kogevandet i panden med kylling og grønt. Lad det komme i kog, og lad det så simre i 5 minutter, mens du laver ostesaucen."
    },
    {
      "section": "Ostesauce",
      "text": "Smelt smørret i en gryde, og pisk melet ud i det. Pisk mælken i lidt ad gangen."
    },
    {
      "section": "Ostesauce",
      "text": "Rør mozzarella og parmesan i, til saucen er cremet og glat. Smag til med salt og peber, og tag gryden af varmen."
    },
    {
      "section": null,
      "text": "Vend den afdryppede pasta i panden med kylling og grønt. Tilsæt cherrytomater, spinat og basilikum, og smag til med salt og peber."
    },
    {
      "section": "Samling og bagning",
      "text": "Varm ovnen op til 190 °C varmluft. Smør et ovnfast fad."
    },
    {
      "section": "Samling og bagning",
      "text": "Læg pastablandingen og ostesaucen i lag i fadet."
    },
    {
      "section": "Samling og bagning",
      "text": "Bland rasp og parmesan til toppingen, og drys det ud over retten. Bag i ovnen i 15 minutter."
    }
  ],
  "changes": []
