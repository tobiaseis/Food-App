  "steps": [
    {
      "section": "Pesto",
      "text": "Blend spinat, basilikum, parmesan, pinjekerner, hvidløg og olivenolie, til pestoen er grøn og cremet."
    },
    {
      "section": "Pesto",
      "text": "Smag pestoen til med citronskal, salt, peber og en smule citronsaft."
    },
    {
      "section": "Pasta",
      "text": "Kog pastaen al dente efter anvisningen på pakken. Gem 2 dl af kogevandet, og si resten fra."
    },
    {
      "section": "Pasta",
      "text": "Kom pastaen tilbage i gryden, og vend pestoen i ved lav varme. Tilsæt kogevand lidt ad gangen, til saucen er cremet og dækker pastaen."
    },
    {
      "section": "Pasta",
      "text": "Smag til igen med salt, peber og citron."
    },
    {
      "section": "Servering",
      "text": "Anret på tallerkener, og drys med parmesan, pinjekerner og basilikumblade."
    }
