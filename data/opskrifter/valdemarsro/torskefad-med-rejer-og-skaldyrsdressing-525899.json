  "steps": [
    {
      "section": "Kogt torsk",
      "text": "Bring vand, løg, eddike, laurbærblade, salt og peber i kog i en gryde. Skru ned, så væsken kun lige bevæger sig på overfladen."
    },
    {
      "section": "Kogt torsk",
      "text": "Del torsken i passende stykker, og læg dem i den varme lage. Skru lidt op, læg låg på, og lad fisken småkoge i ca. 3 minutter."
    },
    {
      "section": "Kogt torsk",
      "text": "Tag gryden af varmen, og lad torsken trække i laget i 10 minutter. Løft den derefter op, og stil den på køl, til den er kold."
    },
    {
      "section": "Skaldyrsdressing",
      "text": "Rør creme fraiche sammen med sukker, tomatpuré, ketchup, citronskal, lidt citronsaft og paprika. Smag til med salt og peber."
    },
    {
      "section": "Skaldyrsdressing",
      "text": "Pisk fløden luftig, og vend den forsigtigt ned i dressingen."
    },
    {
      "section": "Anretning",
      "text": "Læg feldsalaten på et stort fad. Læg den kolde torsk i portionsstykker ovenpå, og fordel æggekvarte, rejer i små grupper og dressing imellem."
    },
    {
      "section": "Anretning",
      "text": "Top med dild og karse, og læg stenbiderrogn på til sidst. Drys med peber og flagesalt."
    },
    {
      "section": "Anretning",
      "text": "Server med citronbåde og skiver af flute."
    }
  ],
  "changes": [
    "Æblecidereddike er skiftet til eddike.",
    "Koncentreret tomatpuré er beholdt som tomatpuré.",
    "Feldsalat er skiftet til salat."
  ]
