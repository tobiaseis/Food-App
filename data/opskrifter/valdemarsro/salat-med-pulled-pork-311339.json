  "steps": [
    {
      "section": "Syltede rødløg",
      "text": "Bring eddike, vand og sukker i kog i en gryde, og rør, til sukkeret er opløst."
    },
    {
      "section": "Syltede rødløg",
      "text": "Læg rødløgene i, og tag gryden af varmen. Lad løgene trække i 5 minutter, og løft dem derefter op af lagen."
    },
    {
      "section": "Chilidressing",
      "text": "Rør creme fraiche, sriracha og mayonnaise sammen. Smag til med salt og peber."
    },
    {
      "section": "Pulled pork",
      "text": "Opvarm pulled pork på en pande med lidt olie, eller sæt den i ovnen ved 250 °C varmluft i ca. 5 minutter. Den må gerne blive lidt sprød i kanterne."
    },
    {
      "section": "Anretning",
      "text": "Fordel salat og spidskål på tallerkener. Læg pulled pork, syltede rødløg og avocado ovenpå."
    },
    {
      "section": "Anretning",
      "text": "Hæld dressingen over, og tilsæt chili efter smag. Strø koriander eller persille over, og server med limebåde."
    }
