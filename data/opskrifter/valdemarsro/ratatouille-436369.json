  "steps": [
    {
      "section": "Tomatsauce",
      "text": "Smelt smørret i en gryde ved middelvarme. Svits løg og hvidløg, indtil løgene er møre."
    },
    {
      "section": "Tomatsauce",
      "text": "Kom de hakkede tomater, tomatpuré, soltørrede tomater, timian og oregano i gryden. Krydr med salt og peber, og lad saucen simre i 20 minutter."
    },
    {
      "section": "Tomatsauce",
      "text": "Smag saucen af med æblecidereddike og sukker, som får tomatsmagen til at træde frem. Justér med salt og peber."
    },
    {
      "section": "Ratatouille",
      "text": "Forvarm ovnen til 175 °C varmluft."
    },
    {
      "section": "Ratatouille",
      "text": "Smør et ovnfast fad godt ind med smør, og fordel tomatsaucen over bunden."
    },
    {
      "section": "Ratatouille",
      "text": "Læg skiverne af squash, peberfrugt, aubergine, rødløg og tomat skiftevis oven på saucen. Lav en cirkel i et rundt fad eller rækker på langs i et firkantet."
    },
    {
      "section": "Ratatouille",
      "text": "Bag i ovnen i 30-40 minutter. Pynt med basilikum, og server."
    }
  ],
  "changes": []
