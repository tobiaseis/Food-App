  "steps": [
    {
      "section": "Sprøde kikærter",
      "text": "Forvarm ovnen til 175 °C varmluft. Dup de skyllede kikærter tørre med et rent viskestykke."
    },
    {
      "section": "Sprøde kikærter",
      "text": "Rør kikærterne rundt med olien, og tilsæt derefter paprika og salt."
    },
    {
      "section": "Sprøde kikærter",
      "text": "Bred dem ud på en bageplade med bagepapir, og bag dem i 20-25 minutter, til de er sprøde. Rør evt. rundt en eller to gange undervejs."
    },
    {
      "section": "Hvidløgsbagt grønt",
      "text": "Bland tomater, peberfrugt, spinat og squash med olie, salt, peber, hvidløg og rosmarin."
    },
    {
      "section": "Hvidløgsbagt grønt",
      "text": "Læg grøntsagerne i en bradepande med bagepapir, og bag dem i 20 minutter ved 175 °C varmluft."
    },
    {
      "section": "Ris med citron og persille",
      "text": "Put vand, ris og salt i en gryde, og rør godt rundt. Sæt låg på, og varm langsomt op, til det koger."
    },
    {
      "section": "Ris med citron og persille",
      "text": "Lad risen simre under låg på svag varme i 10 minutter. Tag gryden af varmen, og lad risen trække under låg i 10 minutter mere."
    },
    {
      "section": "Ris med citron og persille",
      "text": "Rør citronskal og persille i risen lige før servering."
    },
    {
      "section": "Hvidløgsyoghurt",
      "text": "Mos hvidløget med en gaffel i en lille skål, og rør yoghurten i. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Fordel ris, spinat, de bagte grøntsager og kikærterne i dybe tallerkener eller skåle. Top med en klat hvidløgsyoghurt og lidt persille."
    }
  ],
