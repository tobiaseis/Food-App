  "steps": [
    {
      "section": "Tilbehør",
      "text": "Kog risene, som der står på posen."
    },
    {
      "section": "Tilbehør",
      "text": "Bring letsaltet vand i kog i en lille kasserolle, og læg bønner og broccoli i. Læg låg på, og kog i højst 2 minutter."
    },
    {
      "section": "Tilbehør",
      "text": "Si vandet fra, og lad grøntsagerne stå lune i gryden med låg på."
    },
    {
      "section": "Sauce",
      "text": "Smelt smørret i en gryde. Pisk melet ned i det, til det former en klump."
    },
    {
      "section": "Sauce",
      "text": "Hæld fonden i under hurtig piskning, og lad saucen koge op, mens du rører."
    },
    {
      "section": "Sauce",
      "text": "Rør fløde, tomatpuré, hvidløg, løg, paprika, cayennepeber og brun farin i. Smag til med mere farin, salt og peber."
    },
    {
      "section": "Kylling",
      "text": "Vend kyllingestrimlerne med paprika, salt og peber."
    },
    {
      "section": "Kylling",
      "text": "Varm smør og olie op på en pande, og brun kyllingen på høj varme."
    },
    {
      "section": "Kylling",
      "text": "Sænk varmen, og hæld saucen over kødet. Lad det simre i 10 minutter, til kyllingen er gennemstegt."
    },
    {
      "section": "Servering",
      "text": "Anret kyllingen med ris, broccoli og bønner. Strø persille over."
    }
  ],
