  "steps": [
    {
      "section": "Suppe",
      "text": "Varm olien op i en stor gryde ved middel varme. Svits løg, hvidløg, gulerødder, butternut squash, bladselleri, salvie, rosmarin og timian i 5-10 minutter."
    },
    {
      "section": "Suppe",
      "text": "Hæld fonden over, og krydr med salt, peber og paprika. Lad suppen simre i 20 minutter."
    },
    {
      "section": "Suppe",
      "text": "Blend suppen helt glat og cremet. Smag til med citronsaft og citronskal, og tilsæt mere salt og peber efter behov."
    },
    {
      "section": "Til servering",
      "text": "Øs suppen op i skåle. Top med en klat creme fraiche, og drys med græskarkerner, hasselnødder og persille."
    }
  ],
