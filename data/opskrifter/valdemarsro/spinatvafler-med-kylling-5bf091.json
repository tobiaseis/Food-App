  "steps": [
    {
      "section": "Spinatvafler",
      "text": "Bland begge slags mel og bagepulver i en skål."
    },
    {
      "section": "Spinatvafler",
      "text": "Skyl spinaten grundigt. Kom den i en blender sammen med æg, mælk, salt og peber, og blend til en helt glat dej."
    },
    {
      "section": "Spinatvafler",
      "text": "Rør melblandingen ned i dejen, eller blend den med. Lad dejen hvile i 15 minutter, så den bliver lidt tykkere."
    },
    {
      "section": "Spinatvafler",
      "text": "Smør vaffeljernet let med olie eller smør. Bag vaflerne, til de er gyldne og helt færdige."
    },
    {
      "section": "Karrydressing",
      "text": "Rør alle ingredienserne til dressingen sammen, og smag til med salt og peber."
    },
    {
      "section": "Kylling og bacon",
      "text": "Steg baconen sprød på en pande med olien. Læg den på køkkenrulle, og lad fedtet blive på panden."
    },
    {
      "section": "Kylling og bacon",
      "text": "Krydr kyllingen med salt og peber. Steg den i baconfedtet på middelhøj varme i 4-5 minutter under omrøring, til den er gennemstegt."
    },
    {
      "section": "Til servering",
      "text": "Anret vaflerne med rucola, kylling, bacon, avocado, rødløg, agurk og æble. Top med karrydressing, pesto og basilikum."
    }
  ],
