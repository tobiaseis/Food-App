  "steps": [
    {
      "section": "Kartoffelfritter",
      "text": "Varm ovnen op til 175 °C varmluft. Skrub kartoflerne og skær dem i stave."
    },
    {
      "section": "Kartoffelfritter",
      "text": "Vend staverne med olie og salt på en bageplade. Bag dem i 35-40 minutter, til de er sprøde, og vend dem et par gange undervejs."
    },
    {
      "section": "Salat og vinaigrette",
      "text": "Pisk alle ingredienserne til vinaigretten sammen, og smag den til. Læg salaten i en skål, og hæld dressingen over lige før servering."
    },
    {
      "section": "Tatar",
      "text": "Kom kødet i en skål. Rør æggeblommerne, estragon, kapers, cornichoner, worcestershiresauce og tabasco ind i det."
    },
    {
      "section": "Tatar",
      "text": "Smag til med salt, peber, 1 tsk af dijonsennepen og halvdelen af både peberrod og skalotteløg."
    },
    {
      "section": "Tatar",
      "text": "Rør godt, og smag igen. Tilsæt resten af sennep, peberrod og skalotteløg og eventuelt mere salt og peber, til smagen passer dig."
    },
    {
      "section": "Tatar",
      "text": "Del tataren i fire. Form hver portion med en kniv på en tallerken, læg en rå æggeblomme på toppen, og drys med estragon."
    },
    {
      "section": "Tatar",
      "text": "Server med fritterne, mayonnaise eller aioli og salaten."
    }
  ],
