  "steps": [
    {
      "section": null,
      "text": "Steg baconen sprød i en bred stegepande eller gryde, og læg den derefter på køkkenrulle."
    },
    {
      "section": null,
      "text": "Hæld lidt olie i samme pande, og sæt varmen op. Brun champignon og kylling ved høj varme, mens du rører rundt."
    },
    {
      "section": null,
      "text": "Skru helt ned for varmen, og rør løg og hvidløg i panden. Svits, til løgene er bløde."
    },
    {
      "section": null,
      "text": "Snit baconen i mindre stykker. Kom den i panden sammen med squash, pølser, begge slags paprika og oregano, og rør godt rundt."
    },
    {
      "section": null,
      "text": "Pisk hvedemel ud i fonden, og hæld det i panden. Tilsæt tomatpuré og hakkede tomater, og rør det hele godt sammen."
    },
    {
      "section": null,
      "text": "Læg låg på, og lad retten simre i 15 minutter. Kog risene i mellemtiden."
    },
    {
      "section": null,
      "text": "Vend peberfrugten i retten, og smag til med fløde, salt og peber."
    },
    {
      "section": null,
      "text": "Anret gryderetten med ris, og drys persille over."
    }
  ],
