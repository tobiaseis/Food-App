  "steps": [
    {
      "section": "Skipperlabskovs",
      "text": "Varm en dyb pande eller gryde op, og lad smørret smelte. Brun oksekødet på alle sider."
    },
    {
      "section": "Skipperlabskovs",
      "text": "Kom løg, peberkorn, laurbærblade og fond i panden. Lad det simre i cirka 45 minutter."
    },
    {
      "section": "Skipperlabskovs",
      "text": "Put kartoflerne i, og lad dem koge med, til de er møre og begynder at gå i stykker."
    },
    {
      "section": "Skipperlabskovs",
      "text": "Rør eddike og den grove sennep ned i retten, og smag til med salt og peber."
    },
    {
      "section": "Ovnbagte rødbeder",
      "text": "Vend rødbedestavene med olie, salt og peber. Bag dem ved 175 °C varmluft i 25 minutter, så de stadig har lidt bid."
    },
    {
      "section": "Til servering",
      "text": "Anret labskovsen, og drys purløg over. Server de bagte rødbeder ved siden af sammen med rå rødbede i julienne og den grove sennep."
    }
  ],
