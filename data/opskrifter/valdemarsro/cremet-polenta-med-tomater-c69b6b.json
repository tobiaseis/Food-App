  "steps": [
    {
      "section": "Ovnbagte tomater",
      "text": "Forvarm ovnen til 150 °C."
    },
    {
      "section": "Ovnbagte tomater",
      "text": "Anbring tomaterne på stilk i et lille ovnfast fad med bagepapir. Top med hvidløg, timian, rosmarin, olivenolie, salt og peber, og bag i ca. 45 minutter."
    },
    {
      "section": "Ovnbagte tomater",
      "text": "Hæld saften og olien fra fadet i en skål. Pres det bagte hvidløg ud af skallen, og rør det ud i saften, til det er blandet godt."
    },
    {
      "section": "Cremet polenta",
      "text": "Bring vand og mælk i kog i en gryde."
    },
    {
      "section": "Cremet polenta",
      "text": "Pisk polentaen ned i, og lad den komme i kog igen. Sænk varmen, sæt låg på, og lad den simre, til den er mør og cremet."
    },
    {
      "section": "Cremet polenta",
      "text": "Vend smør og parmesan ned i polentaen. Smag til med salt, peber og citronskal."
    },
    {
      "section": "Servering",
      "text": "Læg polentaen på tallerkener, og sæt tomaterne ved siden af. Dryp med hvidløgs- og tomatsaften, og slut af med parmesanflager og hakket persille."
    }
  ],
