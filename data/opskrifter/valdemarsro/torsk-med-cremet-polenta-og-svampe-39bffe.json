  "steps": [
    {
      "section": "Cremet polenta",
      "text": "Bring vand og mælk i kog i en gryde. Pisk polentaen ned i væsken, og lad det koge op igen."
    },
    {
      "section": "Cremet polenta",
      "text": "Sæt varmen på laveste niveau, og læg låg på. Lad polentaen simre, til den er mør og cremet."
    },
    {
      "section": "Cremet polenta",
      "text": "Vend smør og parmesan ind. Smag til med salt, peber og citronskal."
    },
    {
      "section": "Svampe",
      "text": "Varm en pande op, og brun champignon, salvie og rødløg i smørret, til svampene er flot gyldne."
    },
    {
      "section": "Torsk",
      "text": "Varm olien på en anden pande, og læg fisken på med skindsiden nedad. Steg i ca. 5-6 minutter."
    },
    {
      "section": "Torsk",
      "text": "Tilsæt smør på panden, og krydr fisken med salt og peber. Vend den, og steg 30 sekunder mere."
    },
    {
      "section": "Servering",
      "text": "Fordel polentaen på tallerkener, og læg torsk og svampe ovenpå. Top med parmesan og rucola."
    }
  ],
  "changes": [
    "Polenta majsmel hedder blot polenta."
