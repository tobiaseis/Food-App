  "steps": [
    {
      "section": "Linsekarry",
      "text": "Varm karryen på en tør pande ved middel varme, til den dufter."
    },
    {
      "section": "Linsekarry",
      "text": "Tilsæt olie, hvidløg, løg og ingefær. Rør rundt og steg, til løget er blødt."
    },
    {
      "section": "Linsekarry",
      "text": "Kom linser, squash, tomater og kokosmælk i gryden, og rør det sammen."
    },
    {
      "section": "Linsekarry",
      "text": "Lad retten simre med låg på i 30-40 minutter, til linserne er møre. Smag til med salt og peber."
    },
    {
      "section": "Ris",
      "text": "Varm olie, ingefær og hvidløg i en gryde ved lav varme, til det lugter svagt af ingefær. Det må ikke brune."
    },
    {
      "section": "Ris",
      "text": "Hæld vand, ris og salt i gryden, og rør godt. Sæt låg på, og bring langsomt i kog."
    },
    {
      "section": "Ris",
      "text": "Kog ved svag varme med låg på i 10 minutter. Tag gryden af varmen, og lad risene trække med låg på i 10 minutter mere."
    },
    {
      "section": "Korianderdressing",
      "text": "Rør yoghurt, koriander, citronskal og lidt citronsaft sammen. Krydr med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Anret risene i dybe tallerkener, og hæld linsekarryen over. Top med dressing og chiliflager."
    }
  ],
