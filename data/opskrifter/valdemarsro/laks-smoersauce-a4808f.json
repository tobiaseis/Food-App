  "steps": [
    {
      "section": null,
      "text": "Forvarm ovnen til 175 °C varmluft. Læg bagepapir på et ovnfad."
    },
    {
      "section": null,
      "text": "Læg laksen på fadet, og drys med salt og peber. Bag den i 12-15 minutter, til den lige er gennemstegt. Hold øje med den, så den ikke bliver tør."
    },
    {
      "section": "Smørsauce",
      "text": "Varm olien på en pande ved middelvarme. Svits hvidløget, til det er blødt."
    },
    {
      "section": "Smørsauce",
      "text": "Kom kapers, fond, lidt citronskal og citronsaft på panden. Lad saucen simre, til den er reduceret en smule."
    },
    {
      "section": "Smørsauce",
      "text": "Pisk smørret i saucen, og tag panden af varmen."
    },
    {
      "section": null,
      "text": "Læg laksen på et fad, og hæld saucen over. Strø persille eller oregano ovenpå."
    }
  ],
