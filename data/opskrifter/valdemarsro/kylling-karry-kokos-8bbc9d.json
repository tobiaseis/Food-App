  "steps": [
    {
      "section": null,
      "text": "Varm karryen på en tør pande ved middelvarme, til den dufter."
    },
    {
      "section": null,
      "text": "Tilsæt olie og kylling, og brun kødet på alle sider."
    },
    {
      "section": null,
      "text": "Kom peberfrugt, tomat, bønner og kokosmælk på panden. Lad retten simre i 10-15 minutter, til kyllingen er helt gennemstegt."
    },
    {
      "section": null,
      "text": "Smag til med limesaft, limeskal, salt og peber."
    },
    {
      "section": null,
      "text": "Server med den kogte ris og drys med cashewnødder og persille."
    }
