  "steps": [
    {
      "section": "Mangodressing",
      "text": "Kom mango, hvidløg, ingefær, røget paprika, chiliflager, fiskesauce samt skal og saft fra limen i en blender, og kør det helt glat."
    },
    {
      "section": "Mangodressing",
      "text": "Hæld massen i en skål, og rør creme fraiche og mayonnaise i. Smag dressingen til."
    },
    {
      "section": "Pankopaneret kylling",
      "text": "Pisk æggene i en dyb tallerken, og hæld panko i en anden."
    },
    {
      "section": "Pankopaneret kylling",
      "text": "Vend kyllingen i hvedemel blandet med paprika, salt og peber. Træk den derefter gennem æggene, og pres den til sidst ned i panko, så den er dækket hele vejen rundt."
    },
    {
      "section": "Pankopaneret kylling",
      "text": "Varm olie op på en pande ved middelvarme, og steg kyllingen i ca. 6 minutter på hver side, til panéringen er sprød og gyldne. Kontrollér, at kødet er gennemstegt."
    },
    {
      "section": "Servering",
      "text": "Læg spidskål og grønkål i en skål sammen med et par spiseskeer dressing. Ælt kålen med hænderne i 1-2 minutter, til den er blevet blødere og mør."
    },
    {
      "section": "Servering",
      "text": "Kom kålen i en stor skål, og læg rødkålen ved siden af. Hæld dressing over, og top med avocado og kyllingen skåret i skiver."
    },
    {
      "section": "Servering",
      "text": "Strø cashewnødder og persille over, og krydr med salt og peber."
    }
  ],
