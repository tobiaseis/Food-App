  "steps": [
    {
      "section": "Pankorejer",
      "text": "Rør hvidløg, ingefær, fiskesauce, limesaft, limeskal og olie sammen til en jævn marinade."
    },
    {
      "section": "Pankorejer",
      "text": "Tør rejerne grundigt med køkkenrulle, og vend dem i marinaden. Lad dem stå køligt i mindst 1 time – gerne natten over."
    },
    {
      "section": "Pankorejer",
      "text": "Forvarm ovnen til 190 °C varmluft. Sæt to skåle frem: ægget i den ene og pankoraspen i den anden."
    },
    {
      "section": "Pankorejer",
      "text": "Træk rejerne gennem ægget og derefter gennem raspen, så de er dækket hele vejen rundt. Læg dem på en bageplade med bagepapir."
    },
    {
      "section": "Pankorejer",
      "text": "Bag rejerne i ovnen i ca. 12-15 minutter, til de er gyldne."
    },
    {
      "section": "Ananassalsa med avocado",
      "text": "Bland ananas, avocado, mynte og basilikum i en skål."
    },
    {
      "section": "Ananassalsa med avocado",
      "text": "Krydr med limesaft, limeskal, chili, salt og peber, og vend det forsigtigt sammen."
    },
    {
      "section": "Forårsruller",
      "text": "Fyld et stort fad med vand. Læg et ark rispapir i vandet, til det er blødt, og løft det op på et bræt eller bordet."
    },
    {
      "section": "Forårsruller",
      "text": "Fordel rejer, salsa, mynte, gulerødder, bønnespirer, agurk og forårsløg i en stribe midt på arket."
    },
    {
      "section": "Forårsruller",
      "text": "Slå siderne ind over fyldet, og rul arket stramt sammen. Gentag med resten af rispapiret."
    },
    {
      "section": "Forårsruller",
      "text": "Server rullerne med sød chilisauce. Hvis der er grøntsager eller salsa tilovers, kan de stå ved siden af som tilbehør."
    }
  ],
