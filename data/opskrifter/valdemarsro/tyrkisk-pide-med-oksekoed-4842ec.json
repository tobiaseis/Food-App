  "steps": [
    {
      "section": "Dej",
      "text": "Udrør gæren i vandet i en stor skål. Tilsæt hvedemel, olivenolie og salt."
    },
    {
      "section": "Dej",
      "text": "Ælt dejen i røremaskinen ved middelhastighed i 10 minutter, til den er glat, blød og smidig."
    },
    {
      "section": "Dej",
      "text": "Kom dejen i en skål, der er smurt med olivenolie, og vend den rundt, så den får olie hele vejen rundt."
    },
    {
      "section": "Dej",
      "text": "Dæk skålen til, og lad dejen hvile på køkkenbordet i 30 minutter. Stil den derefter i køleskabet i 10-24 timer."
    },
    {
      "section": "Fyld",
      "text": "Steg løgene i olie i en gryde, til de er bløde."
    },
    {
      "section": "Fyld",
      "text": "Skru op for varmen, og brun oksekødet hurtigt, mens du rører hele tiden."
    },
    {
      "section": "Fyld",
      "text": "Rør hvidløg, spidskommen, koriander, begge slags paprika og tomatpuré i. Smag til med salt og peber."
    },
    {
      "section": "Fyld",
      "text": "Stil fyldet i køleskabet, så det køler hurtigt af."
    },
    {
      "section": "Form pideerne",
      "text": "Sæt bagestålet i ovnen, og tænd for den højeste temperatur en time, før du skal bage."
    },
    {
      "section": "Form pideerne",
      "text": "Drys køkkenbordet med mel. Del dejen i lige så mange stykker, som der er portioner."
    },
    {
      "section": "Form pideerne",
      "text": "Tryk hvert stykke ud til en aflang oval. Fold kanten ind hele vejen rundt, så den bliver lidt tykkere, og sno enderne til spidser."
    },
    {
      "section": "Form pideerne",
      "text": "Læg pideerne på bagepapir, to på hvert stykke."
    },
    {
      "section": "Form pideerne",
      "text": "Fordel kødfyldet i midten af pideerne, og læg mozzarellaen i mindre stykker ovenpå."
    },
    {
      "section": "Bagning",
      "text": "Sænk ovnen til 210 grader varmluft. Skub bagepapiret med pideerne ind på det varme bagestål."
    },
    {
      "section": "Bagning",
      "text": "Bag i cirka 13-15 minutter, til brødet er sprødt og gyldent."
    },
    {
      "section": "Dressing",
      "text": "Rør creme fraiche, purløg og hvidløg sammen. Smag til med salt og peber."
    },
    {
      "section": "Dressing",
      "text": "Dryp dressingen i striber over de nybagte pide, og top med hakket persille."
    }
  ],
