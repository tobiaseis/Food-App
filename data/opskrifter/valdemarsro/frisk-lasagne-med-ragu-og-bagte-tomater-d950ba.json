  "steps": [
    {
      "section": "Ragu",
      "text": "Skær oksekødet i tykke skiver. Varm olie op i en støbejernsgryde over høj varme, og brun kødet godt på alle sider. Læg det over på en tallerken, og skru ned for varmen."
    },
    {
      "section": "Ragu",
      "text": "Steg baconen sprød i samme gryde. Tag den op, og hak den fint."
    },
    {
      "section": "Ragu",
      "text": "Svits løgene ved middelvarme, til de er bløde. Rør hvidløg, selleri og gulerødder i, og svits det yderligere ét minut."
    },
    {
      "section": "Ragu",
      "text": "Kom kød, bacon, rødvin, oksefond, soltørrede tomater, hakkede tomater, laurbærblade og timian i gryden. Bring det i kog under låg, og sænk derefter varmen, så det kun simrer svagt."
    },
    {
      "section": "Ragu",
      "text": "Lad ragun simre i 3-4 timer, til kødet er mørt og falder fra hinanden. Lav de bagte tomater i mellemtiden."
    },
    {
      "section": "Bagte tomater",
      "text": "Fordel cherrytomater og timian i et smurt ovnfast fad. Vend dem med olie, salt og peber, og bag dem ved 225 °C varmluft i 25-30 minutter."
    },
    {
      "section": "Ragu",
      "text": "Fisk laurbærbladene op, og smid dem ud. Tag kødet op, og pil det i trævler med to gafler. Kom det tilbage i gryden, og smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Kog lasagnepladerne al dente i letsaltet vand efter anvisningen på pakken."
    },
    {
      "section": "Til servering",
      "text": "Anret lasagnepladerne på tallerkener med folder, og læg varm ragu, bagte tomater og parmesan imellem. Top med burrata og basilikum."
    }
  ],
  "changes": [
    "Soltørrede tomater i olie bevares som soltørrede tomater.",
