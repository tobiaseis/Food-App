  "steps": [
    {
      "section": "Tærtedej",
      "text": "Bland begge slags mel med saltet i en skål. Smuldr smørret i melet, til det ligner grove krummer. Det kan også gøres i en foodprocessor."
    },
    {
      "section": "Tærtedej",
      "text": "Tilsæt vandet og æl dejen sammen til en klump. Lad den helst hvile på køl i 30 minutter."
    },
    {
      "section": "Tærtedej",
      "text": "Tryk dejen ud i en smurt tærteform på 24 cm i diameter, og prik bunden med en gaffel."
    },
    {
      "section": "Tærtedej",
      "text": "Forvarm ovnen til 175 °C varmluft. Forbag tærtebunden i 10 minutter."
    },
    {
      "section": "Fyld",
      "text": "Pisk æg, ricotta og timian (eller oregano) sammen i en skål, og smag til med salt og peber."
    },
    {
      "section": "Fyld",
      "text": "Hæld æggeblandingen i den forbagte tærtebund. Læg tomaterne ned i fyldet, smuldr fetaen ovenpå, og drys til sidst med oliven."
    },
    {
      "section": "Fyld",
      "text": "Bag tærten ved 175 °C varmluft i cirka 30-35 minutter, til æggemassen er stivnet."
    }
  ],
