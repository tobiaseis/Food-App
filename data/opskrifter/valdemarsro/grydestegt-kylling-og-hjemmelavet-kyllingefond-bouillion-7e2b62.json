  "steps": [
    {
      "section": "Kylling og grøntsager",
      "text": "Skyl kyllingen og gnid den ind i rigeligt salt. Fyld den med persille og hvidløg."
    },
    {
      "section": "Kylling og grøntsager",
      "text": "Varm smør og olie op i en stor gryde, og brun kyllingen godt på alle sider."
    },
    {
      "section": "Kylling og grøntsager",
      "text": "Kom grøntsagerne, vand, salt, peber, krydderurter og citron eller eddike i gryden."
    },
    {
      "section": "Kylling og grøntsager",
      "text": "Sæt låg på, og lad det simre ved svag varme i 2 timer."
    },
    {
      "section": "Kylling og grøntsager",
      "text": "Løft kyllingen op. Si grøntsagerne fra, og hæld suppevandet i en ren gryde."
    },
    {
      "section": "Kylling og grøntsager",
      "text": "Pil kødet af, mens kyllingen stadig er lun – så går det lettest."
    },
    {
      "section": "Fond",
      "text": "Læg skroget, de store ben og det kød, der sidder tæt på dem, i suppevandet."
    },
    {
      "section": "Fond",
      "text": "Tilføj gulerødder, bladselleri samt timian og persille."
    },
    {
      "section": "Fond",
      "text": "Lad fonden simre i et par timer, og si den derefter igen."
    },
    {
      "section": "Fond",
      "text": "Fyld fonden på beholdere. Den kan fryses og bruges til supper og saucer eller overalt, hvor opskriften kræver kyllingefond eller bouillon."
    }
  ],
