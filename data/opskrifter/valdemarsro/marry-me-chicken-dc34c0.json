  "steps": [
    {
      "section": null,
      "text": "Tør kyllingebrysterne med køkkenrulle. Bland hvedemel med salt og peber, og vend kyllingen i blandingen, så den er dækket hele vejen rundt."
    },
    {
      "section": null,
      "text": "Varm olien i en sauterpande ved middelhøj varme, og lad smørret smelte og bruse af. Steg kyllingen i 2 minutter på hver side, til den har fået farve og en fin skorpe. Læg den på en tallerken."
    },
    {
      "section": null,
      "text": "Sænk til middelvarme. Svits soltørrede tomater, løg og hvidløg på samme pande i et par minutter, til løgene er bløde."
    },
    {
      "section": null,
      "text": "Tilsæt oregano, timian, rosmarin, bouillon, fløde og tomatpuré, og rør det godt sammen."
    },
    {
      "section": null,
      "text": "Læg kyllingen tilbage i panden, og lad den simre i saucen i 10-15 minutter, til kødet er gennemstegt."
    },
    {
      "section": null,
      "text": "Kog pastaen efter anvisningen på pakken, mens kyllingen simrer."
    },
    {
      "section": null,
      "text": "Rør parmesan og basilikum i saucen, og smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Server kyllingen med saucen og den nykogte pasta."
    }
  ],
