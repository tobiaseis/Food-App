  "steps": [
    {
      "section": null,
      "text": "Forvarm ovnen til 175 °C varmluft. Smør et ovnfast fad."
    },
    {
      "section": null,
      "text": "Vend kyllingetern med salt, peber og paprika, og læg dem i fadet. Bag dem i 10 minutter."
    },
    {
      "section": null,
      "text": "Pisk fløden til blød, luftig skum, og vend chilipastaen i."
    },
    {
      "section": null,
      "text": "Kog risene, så længe kyllingen bager. Følg anvisningen på pakken."
    },
    {
      "section": null,
      "text": "Tag fadet ud af ovnen. Læg bananskiverne over kyllingen, og smør chilifløden ovenpå."
    },
    {
      "section": null,
      "text": "Skru op på 210 °C varmluft, og sæt fadet ind igen i 15 minutter, til overfladen er gylden."
    },
    {
      "section": null,
      "text": "Brun baconskiverne sprøde i olien på en pande. Hak dem derefter i mindre stykker."
    },
    {
      "section": null,
      "text": "Strø bacon, peanuts og persille over retten. Anret med ris og salat ved siden af."
    }
