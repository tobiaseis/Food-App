  "steps": [
    {
      "section": "Kylling og tomater",
      "text": "Forvarm ovnen til 225 °C. Klæd et ovnfast fad med bagepapir."
    },
    {
      "section": "Kylling og tomater",
      "text": "Læg kyllingebrysterne i fadet og krydr dem med tørret timian, salt og peber. Fordel tomathalvdelene rundt om kyllingen."
    },
    {
      "section": "Kylling og tomater",
      "text": "Bag i 20-25 minutter, til skindet er sprødt, og kyllingen er gennemstegt."
    },
    {
      "section": "Risotto",
      "text": "Varm olien op i en gryde og svits løg og hvidløg, til løgene er bløde."
    },
    {
      "section": "Risotto",
      "text": "Skru op for varmen, tilsæt risene og rør rundt i ca. ½ minut, så de er dækket af olie."
    },
    {
      "section": "Risotto",
      "text": "Hæld hvidvinen i og lad den koge helt ind. Tilsæt straks begge slags fond, og skru ned, så det kun simrer let."
    },
    {
      "section": "Risotto",
      "text": "Læg låg på og lad risottoen simre i ca. 30 minutter, til risene lige er møre. Tilsæt lidt mere fond, hvis den bliver for tør."
    },
    {
      "section": "Risotto",
      "text": "Vend parmesan og frisk timian i, og smag til med salt og peber."
    },
    {
      "section": "Servering",
      "text": "Skær kyllingen i skiver. Anret risottoen med kylling og tomater, og top med lidt ekstra friskrevet parmesan."
    }
  ],
