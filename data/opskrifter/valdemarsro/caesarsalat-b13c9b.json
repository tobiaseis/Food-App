  "steps": [
    {
      "section": null,
      "text": "Rids kyllingens skindside med en skarp kniv, og krydr med salt og peber."
    },
    {
      "section": null,
      "text": "Læg smør og olivenolie på en kold pande, og placer kyllingebrysterne med skindsiden nedad. Steg dem langsomt ved middelvarme i 20 minutter."
    },
    {
      "section": null,
      "text": "Lav dressing og croutoner, mens kyllingen steger."
    },
    {
      "section": null,
      "text": "Vend kyllingen, og skru lidt op for varmen. Steg den i 4-5 minutter på den anden side."
    },
    {
      "section": "Til dressingen",
      "text": "Blend alle ingredienserne til dressingen, og smag den til med citronsaft, salt og peber."
    },
    {
      "section": "Til croutonerne",
      "text": "Smør brødskiverne på begge sider, og rist dem gyldne på en pande. Skær dem derefter i tern."
    },
    {
      "section": null,
      "text": "Fordel salaten på fire tallerkener. Skær kyllingen i skiver, og læg dem ovenpå. Top med dressing, parmesan og croutoner."
    }
