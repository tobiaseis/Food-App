  "steps": [
    {
      "section": "Kartofler",
      "text": "Skrub kartoflerne, og læg dem i en gryde med letsaltet vand. Bring vandet i kog, og lad kartoflerne koge i 15 minutter."
    },
    {
      "section": "Kartofler",
      "text": "Hæld vandet fra, og sæt låg på gryden, så kartoflerne trækker videre."
    },
    {
      "section": "Kryddersmør",
      "text": "Rør smørret sammen med citronskal, dild, persille, salt og peber."
    },
    {
      "section": "Bagt torsk i pakker",
      "text": "Tænd ovnen på 175 °C varmluft. Skær torsken i fire lige store stykker."
    },
    {
      "section": "Bagt torsk i pakker",
      "text": "Læg fennikel på fire stykker bagepapir, og anbring et stykke torsk ovenpå hver. Smør halvdelen af kryddersmørret over fisken, og gem resten til kartoflerne."
    },
    {
      "section": "Bagt torsk i pakker",
      "text": "Læg gulerødder og asparges øverst. Fold papiret op omkring fisken, og dryp 1-2 spsk hvidvin over hver pakke. Bind dem sammen med madlavningssnor."
    },
    {
      "section": "Bagt torsk i pakker",
      "text": "Stil pakkerne i et ovnfast fad, og bag dem i ca. 12-14 minutter. Lad dem hvile i 5 minutter før servering."
    },
    {
      "section": "Kartofler",
      "text": "Kom resten af kryddersmørret i gryden med de varme kartofler, og vend dem, til smørret er smeltet og dækker dem. Server med ekstra persille samt salt og peber."
    }
  ],
