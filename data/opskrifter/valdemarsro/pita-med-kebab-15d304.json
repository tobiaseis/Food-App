  "steps": [
    {
      "section": "Kebab",
      "text": "Bland alle krydderierne i en skål, og vend kødet i blandingen, så det er dækket hele vejen rundt."
    },
    {
      "section": "Kebab",
      "text": "Varm olien op på en pande. Brun kødet hurtigt på alle sider, og tag det straks af panden."
    },
    {
      "section": "Hvidløgsdressing",
      "text": "Rør alle ingredienserne til dressingen sammen, og smag den til med salt og peber."
    },
    {
      "section": "Servering",
      "text": "Varm pitabrødene, og smør dem indvendigt med dressing."
    },
    {
      "section": "Servering",
      "text": "Fyld pitabrødene med kød, salat, agurk, rødløg og tomater. Top med lidt ekstra dressing og hakket persille."
    }
