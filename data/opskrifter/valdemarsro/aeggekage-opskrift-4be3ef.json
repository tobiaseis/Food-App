  "steps": [
    {
      "section": null,
      "text": "Brug en pande, der kan komme i ovnen. Steg baconen sprød på den ved middelvarme."
    },
    {
      "section": null,
      "text": "Løft baconen op på køkkenrulle, så fedtet kan sive fra. Lad lidt fedt blive tilbage i panden."
    },
    {
      "section": null,
      "text": "Forvarm ovnen til 180 °C."
    },
    {
      "section": null,
      "text": "Pisk æg og mælk sammen i en skål, og smag til med salt og peber. Vend de halve kartofler ned i æggeblandingen."
    },
    {
      "section": null,
      "text": "Hæld det hele i panden, og læg tomatskiverne ovenpå. Steg ved lav til middel varme i 10 minutter."
    },
    {
      "section": null,
      "text": "Sæt panden i ovnen i 10-15 minutter, til æggekagen er helt stivnet. Drys med lidt salt og peber til sidst."
    },
    {
      "section": null,
      "text": "Anret æggekagen med den sprøde bacon, rigeligt purløg og rugbrød ved siden af."
    }
  ],
  "changes": [
    "Babykartofler er byttet til nye kartofler."
