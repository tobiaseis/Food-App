  "steps": [
    {
      "section": "Marinade",
      "text": "Rør yoghurt, hvidløg, ingefær, garam masala, gurkemeje, chiliflager, nellike, limesaft og salt sammen i en skål."
    },
    {
      "section": "Marinade",
      "text": "Skær kyllingen i strimler på ca. 1 cm i tykkelsen og vend dem i marinaden. Dæk skålen til og stil den i køleskabet i mindst 1 time – gerne længere."
    },
    {
      "section": "Marinade",
      "text": "Forvarm ovnen til 240 °C. Læg kylling og marinade i et ovnfast fad og bag det i 15 minutter."
    },
    {
      "section": "Sauce",
      "text": "Kog risene efter anvisningen, mens kyllingen bager, og gør resten af tilbehøret klar."
    },
    {
      "section": "Sauce",
      "text": "Svits løgene i olie i en gryde ved middelvarme, til de er bløde. Rør undervejs."
    },
    {
      "section": "Sauce",
      "text": "Tilsæt hvidløg, ingefær, gurkemeje, mandler, tomatpuré og vand. Bring det i kog og lad saucen simre i 5 minutter."
    },
    {
      "section": "Sauce",
      "text": "Tag kyllingen ud af ovnen og rør den ned i saucen sammen med marinaden fra fadet. Varm det hele godt igennem under omrøring."
    },
    {
      "section": "Sauce",
      "text": "Rør fløden i efter smag. Er saucen for tyk, så tynd den med lidt vand eller bouillon. Smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Server med ris og drys med de grofthakkede mandler og koriander."
    }
  ],
