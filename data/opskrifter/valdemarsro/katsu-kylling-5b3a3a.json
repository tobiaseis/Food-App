  "steps": [
    {
      "section": "Karrysauce",
      "text": "Varm karryen op i en tør gryde, til den begynder at dufte."
    },
    {
      "section": "Karrysauce",
      "text": "Kom sesamolie, squash, gulerødder, løg, hvidløg, æble og gurkemeje i gryden, og rør rundt i et par minutter."
    },
    {
      "section": "Karrysauce",
      "text": "Hæld kokosmælken i, læg låg på, og lad det simre i ca. 15 minutter, til gulerødderne er møre."
    },
    {
      "section": "Karrysauce",
      "text": "Blend saucen helt glat og cremet. Tynd den evt. ud med lidt hønsebouillon, og smag til med sojasauce og peber."
    },
    {
      "section": "Sprød kylling",
      "text": "Bank kyllingebrysterne lidt flade, så de steges hurtigere og bliver saftige, uden at panaden bliver for mørk."
    },
    {
      "section": "Sprød kylling",
      "text": "Pisk æggene i en dyb tallerken, og hæld pankoraspen på en anden."
    },
    {
      "section": "Sprød kylling",
      "text": "Drys kyllingen med hvedemel, salt og peber. Vend den først i æg og derefter i pankorasp."
    },
    {
      "section": "Sprød kylling",
      "text": "Varm sesamolien op på en pande ved middelvarme, og steg kyllingen i ca. 6 minutter på hver side, til den er sprød og gylden. Kontrollér, at den er gennemstegt."
    },
    {
      "section": "Til servering",
      "text": "Kom spidskålen i en skål med et nip salt, og ælt den med hænderne i ca. 1 minut, til den bliver mør."
    },
    {
      "section": "Til servering",
      "text": "Server kyllingen med karrysaucen, ris og spidskål. Top med forårsløg, sesamfrø og chiliflager."
    }
  ],
