  "steps": [
    {
      "section": "Tzatziki",
      "text": "Vend den revne agurk med salt, og lad den stå i 5 minutter. Pres vandet fra agurken."
    },
    {
      "section": "Tzatziki",
      "text": "Rør agurken sammen med hvidløg, yoghurt og peber."
    },
    {
      "section": "Fyld",
      "text": "Varm olien i en pande, og brun de søde kartofler, til de er sprøde og gyldne."
    },
    {
      "section": "Fyld",
      "text": "Kom spinat, peberfrugt, hvidløg og soltørrede tomater på panden, og varm det godt igennem."
    },
    {
      "section": "Fyld",
      "text": "Tag panden af varmen, og vend cherrytomaterne i."
    },
    {
      "section": "Omelet",
      "text": "Pisk æg og mælk sammen med salt og peber med en gaffel."
    },
    {
      "section": "Omelet",
      "text": "Hæld æggemassen på en pande med olie, og lad omeletten stivne ved svag varme i 3-4 minutter."
    },
    {
      "section": "Servering",
      "text": "Læg fyldet på halvdelen af omeletten, og fold den anden halvdel over."
    },
    {
      "section": "Servering",
      "text": "Top med basilikum, oliven, pinjekerner, feta og tzatziki."
    }
  ],
