  "steps": [
    {
      "section": "Vinaigrette",
      "text": "Pisk eddike, honning, sennep og olivenolie sammen. Smag til med salt og peber."
    },
    {
      "section": "Brødcirkler",
      "text": "Forvarm ovnen til 180 °C varmluft. Udstik små runde cirkler af brødskiverne, i alt 16, og kom lidt gedeost på hver."
    },
    {
      "section": "Brødcirkler",
      "text": "Læg cirklerne på en bageplade med bagepapir, og bag dem i ovnen i 10 minutter."
    },
    {
      "section": "Valnødder",
      "text": "Ryst valnødderne på en tør, varm pande i nogle minutter, til de er ristede."
    },
    {
      "section": "Servering",
      "text": "Læg salaten på et stort fad eller på fire tallerkener, og hæld vinaigrette over."
    },
    {
      "section": "Servering",
      "text": "Placer de varme brødcirkler ovenpå. Drys med honning, blåbær og valnødder, og krydr med salt og friskkværnet peber."
    }
  ],
  "changes": [
    "Akaciehonning er skiftet til almindelig honning."
