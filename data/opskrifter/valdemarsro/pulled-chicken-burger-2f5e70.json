  "steps": [
    {
      "section": "Pulled chicken",
      "text": "Bland begge slags paprika, spidskommen, brun farin, hvidløg og sriracha med salt og peber til en marinade."
    },
    {
      "section": "Pulled chicken",
      "text": "Vend kyllingebrysterne i marinaden, så de er dækket hele vejen rundt. Læg dem i en lufttæt beholder og stil dem på køl i mindst 30 minutter – gerne natten over."
    },
    {
      "section": "Pulled chicken",
      "text": "Forvarm ovnen til 125 °C. Smør bunden og siderne af en støbejernsgryde med smørret, og læg kyllingen i."
    },
    {
      "section": "Pulled chicken",
      "text": "Hæld grøntsagsfonden i, sæt låg på, og sæt gryden i ovnen i 3 timer."
    },
    {
      "section": "Pulled chicken",
      "text": "Løft kødet op af gryden, og pluk det i fine strimler med to gafler."
    },
    {
      "section": "Coleslaw",
      "text": "Rør creme fraiche, mayonnaise, sennep, eddike, sukker og spidskommen sammen med salt og peber. Smag dressingen til."
    },
    {
      "section": "Coleslaw",
      "text": "Vend kål og gulerødder med dressingen i en stor skål. Lad coleslawen stå på køl i cirka 1 time, før den skal spises."
    },
    {
      "section": "Til servering",
      "text": "Varm burgerbollerne, og smør dem med barbecuesauce. Fyld dem med pulled chicken, coleslaw og rucola."
    }
  ],
  "changes": [
    "Sriracha chilisauce er skiftet til sriracha.",
    "Æblecidereddike er skrevet som eddike."
  ]
}
