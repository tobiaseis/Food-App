  "steps": [
    {
      "section": null,
      "text": "Rist krydderierne (spidskommen, kanel, koriander, røget paprika og chiliflager) på en tør, dyb pande eller i en gryde under omrøring i et par minutter, til de dufter kraftigt."
    },
    {
      "section": null,
      "text": "Sænk varmen lidt. Hæld olien på, og rør løg og hvidløg rundt, til løgene er møre."
    },
    {
      "section": null,
      "text": "Kom squash, aubergine, bladselleri, hakkede tomater, soltørrede tomater og fond i. Læg låg på, og lad det simre i 30 minutter."
    },
    {
      "section": null,
      "text": "Rør bønnerne i, og lad dem blive godt varme i 5 minutter."
    },
    {
      "section": null,
      "text": "Tag panden af varmen. Rør først halvdelen af chokoladen i, og smag derefter til med resten af chokoladen, salt, peber og eventuelt mere chili, hvis retten skal være skarpere."
    },
    {
      "section": "Til servering",
      "text": "Kog risene efter anvisningen på posen. Anret chilien med ris, nachos, cremefraiche, cheddar, rød chili og koriander, og pres lime over."
    }
  ],
  "changes": [
    "Soltørrede tomater i olie, grøntsagsbouillon og chiliflager er beholdt som i kilden, bortset fra at bouillon hedder grøntsagsfond."
