  "steps": [
    {
      "section": "Marineret kylling",
      "text": "Rør bagepulver, sojasauce, riseddike og majsstivelse sammen i en skål. Vend kyllingen i marinaden, og lad den stå, mens du gør resten klar."
    },
    {
      "section": "Kung Pao-sauce",
      "text": "Pisk alle ingredienserne til saucen sammen, til den er helt glat."
    },
    {
      "section": "Til retten",
      "text": "Rist sichuanpeberen på en tør pande, og knus den fint i en morter."
    },
    {
      "section": "Til retten",
      "text": "Varm sesamolien op på panden. Rist hvidløg, ingefær, den knuste sichuanpeber og chiliflager under omrøring, til det dufter kraftigt."
    },
    {
      "section": "Til retten",
      "text": "Kom kyllingen med al marinaden på panden, og brun den hurtigt ved høj varme."
    },
    {
      "section": "Til retten",
      "text": "Hæld saucen over, og lad det simre, til kyllingen er mør. Vend peberfrugt og halvdelen af forårsløgene i."
    },
    {
      "section": "Til servering",
      "text": "Fordel risene i skåle, og læg kyllingen ovenpå. Drys med resten af forårsløgene og peanuts."
    }
  ],
