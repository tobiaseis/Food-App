  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en gryde, og svits løget, til det er blødt."
    },
    {
      "section": null,
      "text": "Rør hvidløg, soltørrede tomater, basilikum, squash og chiliflager i gryden. Hæld bouillon, hakkede tomater og fløde ved, og bring det i kog."
    },
    {
      "section": null,
      "text": "Vend tortellini i saucen, og smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Hæld det hele i et smurt ovnfast fad. Pluk mozzarellaen i mindre stykker, og læg dem ovenpå. Drys med parmesan og rasp."
    },
    {
      "section": null,
      "text": "Gratinér midt i ovnen ved 180 °C varmluft i ca. 20 minutter. Ovnen skal være forvarmet."
    }
  ],
