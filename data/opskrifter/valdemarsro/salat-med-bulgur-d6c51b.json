  "steps": [
    {
      "section": "Bulgur",
      "text": "Hæld bulgur, vand og fond i en gryde, og bring det i kog. Kog under låg i 5-8 minutter."
    },
    {
      "section": "Bulgur",
      "text": "Tag gryden af varmen, og lad bulguren trække i 10-15 minutter."
    },
    {
      "section": "Dressing",
      "text": "Pisk olie, citronsaft og citronskal sammen med hvidløg, ingefær og sirup. Smag til med salt og peber."
    },
    {
      "section": "Til salaten",
      "text": "Rist pinjekernerne på en varm, tør pande, mens du rører hele tiden. Tag dem af, så snart de får lidt farve."
    },
    {
      "section": "Til salaten",
      "text": "Vend bulguren grundigt med dressingen, og læg den på et fad eller i en stor skål."
    },
    {
      "section": "Til salaten",
      "text": "Top med persille, mynte, syltede rødløg, abrikoser og dadler, og drys til sidst de ristede pinjekerner over."
    }
  ],
