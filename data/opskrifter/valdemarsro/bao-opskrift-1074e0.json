  "steps": [
    {
      "section": "Kød",
      "text": "Rør alle ingredienserne til marinaden sammen, og vend kødstrimlerne rundt i den. Lad dem trække i mindst 2 timer, gerne op til et døgn."
    },
    {
      "section": "Dej",
      "text": "Opløs gæren i vandet. Tilsæt sukker, det smeltede smør, salt og halvdelen af melet, og rør det godt sammen."
    },
    {
      "section": "Dej",
      "text": "Ælt resten af melet i lidt ad gangen, til dejen er glat og smidig."
    },
    {
      "section": "Dej",
      "text": "Lad dejen hæve på køl natten over, eller 2 timer ved stuetemperatur."
    },
    {
      "section": "Form",
      "text": "Del dejen i otte lige store stykker, og rul hvert stykke ud til en rund, flad skive."
    },
    {
      "section": "Form",
      "text": "Pensl den ene side af skiverne med olie, og fold dem sammen, så den olierede side vender indad. Lad dem hæve i 30 minutter."
    },
    {
      "section": "Damp",
      "text": "Sæt en bambusdamper over en gryde med kogende vand. Klip et stykke bagepapir til bunden, og prik mange huller i det."
    },
    {
      "section": "Damp",
      "text": "Læg et par boller ad gangen i damperen, og damp dem i 20-25 minutter."
    },
    {
      "section": "Damp",
      "text": "Har du ingen damper, så brug en sigte over gryden. Læg bagepapir med mange huller i, og sæt låg på."
    },
    {
      "section": "Server",
      "text": "Steg kødet hurtigt på en varm pande, til det er mørt og gennemstegt."
    },
    {
      "section": "Server",
      "text": "Fyld bollerne med kød, grøntsager, koriander, sesamfrø og chiliflager. Top med sriracha og server."
    }
  ],
  "changes": [
    "Fishsauce er skrevet som fiskesauce.",
    "Hoisin sauce er skrevet som hoisinsauce."
  ]
}
