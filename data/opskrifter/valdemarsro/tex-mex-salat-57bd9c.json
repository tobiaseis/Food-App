  "steps": [
    {
      "section": "Majs",
      "text": "Læg majskolberne i en gryde med letsaltet vand, og lad dem koge i 25 minutter."
    },
    {
      "section": "Bønnemix",
      "text": "Varm olien i en lille gryde, og svits løg og hvidløg under omrøring."
    },
    {
      "section": "Bønnemix",
      "text": "Rør krydderierne i, og vent til de dufter. Hæld de hakkede tomater i, og lad det simre uden låg i 20 minutter, til væsken er kogt væk."
    },
    {
      "section": "Bønnemix",
      "text": "Kom bønnerne i, og lad dem simre med i 2-3 minutter. Mos blandingen groft med en stavblender."
    },
    {
      "section": "Guacamole",
      "text": "Skræl avocadoerne, og fjern stenen. Blend dem cremede med rødløg, limesaft, salt og peber."
    },
    {
      "section": "Salat og tilbehør",
      "text": "Brug ventetiden til at snitte grøntsagerne og hakke koriander."
    },
    {
      "section": "Anretning",
      "text": "Fordel salat, grøntsager, majs, bønnemix, guacamole og nachos i små portioner på hver tallerken."
    },
    {
      "section": "Anretning",
      "text": "Strø osten over bønnemixen og koriander over det hele. Sæt en klat creme fraiche midt på tallerkenen, og server."
    }
  ],
