  "steps": [
    {
      "section": null,
      "text": "Skyl og skrub græskaret, og del det på midten. Skrab kernerne ud med en ske, og skær græskaret med skræl i grove tern."
    },
    {
      "section": null,
      "text": "Varm olien i en gryde ved middelvarme. Rør græskar, løg, hvidløg, gulerødder, kartofler, chili, spidskommen og ingefær rundt i 1-2 minutter."
    },
    {
      "section": null,
      "text": "Hæld fonden over, så den dækker cirka to tredjedele af grøntsagerne. Hellere for lidt end for meget – du kan altid tynde suppen ud senere."
    },
    {
      "section": null,
      "text": "Sæt låg på, og lad suppen simre i 15-18 minutter, til grøntsagerne er møre."
    },
    {
      "section": null,
      "text": "Blend suppen helt glat. Rør saft fra ½ citron og fløden i, og blend igen. Smag til med salt og peber."
    },
    {
      "section": "Topping",
      "text": "Rist græskarkernerne i smør på en pande ved middelvarme under omrøring, til de begynder at poppe. Tag dem af panden, og drys dem med lidt salt."
    },
    {
      "section": "Topping",
      "text": "Pres saften af den anden halve citron, og rør den sammen med honningen. Vend æbleternene i blandingen."
    },
    {
      "section": "Topping",
      "text": "Server suppen med græskarkerner, timian, æbletern og yoghurt, og afslut med friskkværnet peber."
    }
  ],
  "changes": [
