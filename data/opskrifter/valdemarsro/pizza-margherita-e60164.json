  "steps": [
    {
      "section": "Til dejen",
      "text": "Rør gæren ud i det kolde vand. Tilsæt durummel, så salt og olie, og rør dejen glat og ensartet."
    },
    {
      "section": "Til dejen",
      "text": "Ælt hvedemel i lidt ad gangen, og ælt dejen grundigt igennem. Brug gerne røremaskine og lad den køre i 10-15 minutter."
    },
    {
      "section": "Til dejen",
      "text": "Sæt dejen i køleskabet til hævning i mindst 6 timer. Den kan med fordel stå 12-18 timer."
    },
    {
      "section": "Til tomatsaucen",
      "text": "Svits løg og hvidløg i olie i en gryde."
    },
    {
      "section": "Til tomatsaucen",
      "text": "Tilsæt de hakkede tomater, og krydr med salt og peber. Lad saucen simre i 30 minutter."
    },
    {
      "section": "Til pizzaen",
      "text": "Sæt ovnen på 250 °C, og lad gerne en bageplade af sten varme med."
    },
    {
      "section": "Til pizzaen",
      "text": "Del dejen i lige så mange stykker, som der skal bruges pizzaer, og træk eller rul dem ud."
    },
    {
      "section": "Til pizzaen",
      "text": "Bred tomatsauce ud over bundene, og læg mozzarellaskiver ovenpå."
    },
    {
      "section": "Til pizzaen",
      "text": "Bag pizzaerne i 10-12 minutter, til bunden er sprød."
    },
    {
      "section": "Til pizzaen",
      "text": "Drys med friske basilikumblade, inden pizzaerne serveres."
    }
  ],
  "changes": [
    "Tipo 00-mel er erstattet med hvedemel."
