  "steps": [
    {
      "section": "Kødboller",
      "text": "Bland alle ingredienserne til kødbollerne grundigt i en skål. Stil farsen køligt i cirka en halv time, så smagene kan sætte sig."
    },
    {
      "section": "Kødboller",
      "text": "Form farsen til kødboller. Varm olien på en pande, og brun bollerne hurtigt, til de får en fin skorpe. De skal ikke være gennemstegte, for de bliver færdige i ovnen."
    },
    {
      "section": "Tomatsauce",
      "text": "Svits løg og hvidløg i olivenolie i en stor gryde ved middelvarme, til løgene er blødt."
    },
    {
      "section": "Tomatsauce",
      "text": "Hæld hakkede tomater og soltørrede tomater i gryden, og rør rundt. Bring det i kog, og lad saucen simre på lav varme i 20 minutter."
    },
    {
      "section": "Tomatsauce",
      "text": "Smag saucen til med sukker, salt og peber."
    },
    {
      "section": "Til bagning og servering",
      "text": "Forvarm ovnen til 200 °C varmluft. Kom saucen og kødbollerne i et smurt ovnfast fad, og strø mozzarella ovenpå."
    },
    {
      "section": "Til bagning og servering",
      "text": "Bag fadet i ovnen i 15 minutter."
    },
    {
      "section": "Til bagning og servering",
      "text": "Kog spaghetti efter anvisningen på pakken."
    },
    {
      "section": "Til bagning og servering",
      "text": "Tag fadet ud, og top med pesto og parmesan. Pynt med basilikum, og server med spaghetti."
    }
  ],
