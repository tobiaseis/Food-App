  "steps": [
    {
      "section": "Hvidløgsris med persille",
      "text": "Varm olie og hvidløg op i en gryde ved middellav varme, til hvidløgen lige begynder at dufte."
    },
    {
      "section": "Hvidløgsris med persille",
      "text": "Hæld vand, ris og salt i gryden, og rør rundt. Sæt låg på, og lad det langsomt komme i kog."
    },
    {
      "section": "Hvidløgsris med persille",
      "text": "Skru ned på svag varme, og lad risen koge under låg i 10 minutter. Tag gryden af varmen, og lad risen trække under låg i 10 minutter mere."
    },
    {
      "section": "Hvidløgsris med persille",
      "text": "Vend persillen i risen lige før servering."
    },
    {
      "section": "Syltede gulerødder",
      "text": "Bring vand, eddike og sukker i kog i en gryde, og lad det koge, til sukkeret er opløst. Tag gryden af varmen."
    },
    {
      "section": "Syltede gulerødder",
      "text": "Læg gulerødderne i den varme lage, og hæld dem over på glas. Sæt låg på, og stil dem i køleskabet, mens du laver resten."
    },
    {
      "section": "Sprød hvidløgskylling med ingefær",
      "text": "Tør kyllingebrysterne grundigt med køkkenrulle. Skær med en lang, tynd kniv en dyb lomme i den tykkeste ende af hvert bryst."
    },
    {
      "section": "Sprød hvidløgskylling med ingefær",
      "text": "Bland hvidløg, ingefær og smør til en ensartet masse, og fyld den i lommerne. Tryk åbningerne sammen."
    },
    {
      "section": "Sprød hvidløgskylling med ingefær",
      "text": "Rør hvedemel med salt og peber. Vend kyllingen i melet, så den er helt dækket, og træk den derefter gennem det sammenpiskede æg og til sidst gennem pankoraspen."
    },
    {
      "section": "Sprød hvidløgskylling med ingefær",
      "text": "Varm olie op på en pande ved middelvarme. Steg kyllingen i 5 minutter på hver side, og tjek, at den er gennemstegt, før du tager den af."
    },
    {
      "section": "Asiatisk dressing",
      "text": "Pisk mayonnaise, cremefraiche, fiskesauce og hvidløg sammen. Smag til med limeskal og peber."
    },
    {
      "section": "Servering",
      "text": "Rist sesamfrøene på en tør, varm pande."
    },
    {
      "section": "Servering",
      "text": "Fordel risen i dybe tallerkener, og læg spinat, kylling og afdryppede syltede gulerødder ovenpå. Top med dressing, sesamfrø og chiliflager, og server med limebåde."
    }
  ],
