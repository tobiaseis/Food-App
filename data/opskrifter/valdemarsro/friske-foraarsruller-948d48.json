  "steps": [
    {
      "section": "Marinade",
      "text": "Bland alle ingredienserne til marinaden i en skål, og vend kødstrimlerne rundt i den."
    },
    {
      "section": "Marinade",
      "text": "Lad kødet marinere i mindst 30 minutter. Det kan stå op til et døgn."
    },
    {
      "section": "Hoisindip",
      "text": "Kog hoisinsauce, vand og sukker op i en lille gryde under omrøring. Lad det simre i 1 minut."
    },
    {
      "section": "Hoisindip",
      "text": "Hæld dippen i en skål, og top med de hakkede peanuts."
    },
    {
      "section": "Rullerne",
      "text": "Steg kødstrimlerne hurtigt af på en varm pande med olien."
    },
    {
      "section": "Rullerne",
      "text": "Fyld et stort fad med vand. Læg et ark rispapir i vandet, til det er blødt, og løft det op på et skærebræt."
    },
    {
      "section": "Rullerne",
      "text": "Læg lidt kød, salat, krydderurter, nektarin, peanuts og chili i en stribe midt på arket."
    },
    {
      "section": "Rullerne",
      "text": "Fold siderne ind over fyldet, og rul arket stramt sammen. Gentag med resten af rispapiret."
    },
    {
      "section": "Rullerne",
      "text": "Anret rullerne med hoisindippen ved siden af."
    }
  ],
