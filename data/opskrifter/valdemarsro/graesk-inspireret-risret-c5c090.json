  "steps": [
    {
      "section": "Til grøntsagsdellerne",
      "text": "Pisk æggene sammen med hvedemel i en skål. Vend spidskål, timian, soltørrede tomater og hvidløg i, og krydr med salt og peber. Lad farsen hvile i 15 minutter, og rør den igennem igen."
    },
    {
      "section": "Til grøntsagsdellerne",
      "text": "Hak kikærterne groft i en foodprocessor eller minihakker. Vend dem i farsen sammen med halloumien, som du smuldrer fint."
    },
    {
      "section": "Til grøntsagsdellerne",
      "text": "Smør lidt olie på hænderne, så farsen ikke klistrer. Form farsen til runde deller på størrelse med golfbolde."
    },
    {
      "section": "Til grøntsagsdellerne",
      "text": "Læg dellerne på en bageplade med bagepapir. Bag dem ved 175 °C varmluft i 15-18 minutter, og vend dem et par gange undervejs."
    },
    {
      "section": "Til risretten",
      "text": "Varm olien op i en sauterpande ved middelvarme. Steg løg, hvidløg og soltørrede tomater i nogle minutter, til de er bløde."
    },
    {
      "section": "Til risretten",
      "text": "Tilsæt squash, hakkede tomater, fond, timian, rosmarin og ris, og rør godt rundt. Læg låg på, og lad retten simre ved lav varme, til risen er mør."
    },
    {
      "section": "Til risretten",
      "text": "Rør spinaten i. Læg grøntsagsdellerne ovenpå, smuldr fetaen over, og fordel oliven og frisk oregano til sidst."
    }
  ],
