  "steps": [
    {
      "section": "Tærtebund",
      "text": "Bland begge slags mel med saltet i en skål. Smuldr smørret ud i melet med fingrene, eller kør det i en foodprocessor."
    },
    {
      "section": "Tærtebund",
      "text": "Tilsæt vandet og æltes sammen til en dej. Lad den gerne hvile 30 minutter på køl."
    },
    {
      "section": "Tærtebund",
      "text": "Tryk dejen ud i en smurt tærteform på 24 cm. Prik bunden med en gaffel."
    },
    {
      "section": "Tærtebund",
      "text": "Forbag bunden 10 minutter ved 175 °C varmluft i en forvarmet ovn."
    },
    {
      "section": "Fyld",
      "text": "Vend kyllingeternene i melet sammen med salt og peber."
    },
    {
      "section": "Fyld",
      "text": "Varm olien på en pande, og brun kyllingen hurtigt. Den skal ikke stege helt igennem."
    },
    {
      "section": "Fyld",
      "text": "Pisk æg, mælk og hytteost sammen med salt og peber. Vend kylling, broccoli og chorizo i."
    },
    {
      "section": "Fyld",
      "text": "Hæld fyldet i den forbagte bund, og drys cheddar over."
    },
    {
      "section": "Fyld",
      "text": "Bag tærten ved 175 °C varmluft i cirka 35 minutter, til ægget er stivnet."
    }
  ],
