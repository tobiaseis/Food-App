  "steps": [
    {
      "section": "Tærtedej",
      "text": "Bland begge slags mel med saltet, og smuldr smørret ud i melet med fingrene eller i en foodprocessor."
    },
    {
      "section": "Tærtedej",
      "text": "Tilsæt vandet, og samle dejen. Lad den gerne hvile på køl i 30 minutter."
    },
    {
      "section": "Tærtedej",
      "text": "Forvarm ovnen til 175 °C varmluft. Tryk dejen ud i en smurt tærteform på 24 cm og prik bunden med en gaffel."
    },
    {
      "section": "Tærtedej",
      "text": "Forbag bunden i 10 minutter."
    },
    {
      "section": "Tærtefyld",
      "text": "Steg baconen sprød på en pande. Tag panden af varmen, og læg baconen til side."
    },
    {
      "section": "Tærtefyld",
      "text": "Smelt smør og olivenolie på samme pande ved høj varme. Brun champignonerne gyldne, mens du rører hele tiden."
    },
    {
      "section": "Tærtefyld",
      "text": "Sænk til middelvarme, og steg løgene, til de er bløde."
    },
    {
      "section": "Tærtefyld",
      "text": "Pisk æg, tørret timian, creme fraiche og fløde sammen, og smag til med salt og peber."
    },
    {
      "section": "Tærtefyld",
      "text": "Hak baconen groft, og vend den sammen med champignon, løg og ost. Fordel blandingen i den forbagte bund, og hæld æggemassen over."
    },
    {
      "section": "Tærtefyld",
      "text": "Bag tærten ved 175 °C varmluft i ca. 35 minutter, til den er fast og gylden."
    },
    {
      "section": "Til servering",
      "text": "Pynt med frisk timian."
    }
  ],
