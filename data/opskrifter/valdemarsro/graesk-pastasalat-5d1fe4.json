    {
      "section": null,
      "text": "Kog pastaen, så den er al dente, og følg tiden på pakken."
    },
    {
      "section": null,
      "text": "Si pastaen fra kogevandet, og skyl den med koldt vand, til den er helt kold."
    },
    {
      "section": "Til dressingen",
      "text": "Pisk olivenolie, citronsaft og citronskal sammen med sukker, hvidløg, oregano og persille. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Kom pasta, tomater, agurk, peberfrugt, rødløg, oliven og feta i en stor skål."
    },
    {
      "section": null,
      "text": "Hæld dressingen over, og vend det hele godt rundt."
    }
