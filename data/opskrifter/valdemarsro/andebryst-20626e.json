  "steps": [
    {
      "section": "Appelsinsauce",
      "text": "Kom alt til saucen i en gryde, og kog det ind til cirka 1 dl. Det tager omtrent lige så lang tid, som anden skal bruge på panden."
    },
    {
      "section": "Andebryst",
      "text": "Rids skindet på andebrysterne i et mønster med en skarp kniv. Skær kun i fedtet og ikke ned i kødet, ellers løber kødsaften ud, og kødet bliver tørt."
    },
    {
      "section": "Andebryst",
      "text": "Gnid andebrysterne med salt og peber på alle sider."
    },
    {
      "section": "Andebryst",
      "text": "Læg andebrysterne med skindsiden nedad på en kold, tør pande. Tænd for lav middelvarme, så panden langsomt bliver varm, og fedtet når at smelte ud."
    },
    {
      "section": "Andebryst",
      "text": "Steg ved lav varme i cirka 20 minutter, til skindet er sprødt. Vend dem derefter, og steg dem cirka 5 minutter på kødsiden."
    },
    {
      "section": "Andebryst",
      "text": "Sluk for varmen, og tag andebrysterne op. Lad fedtet blive på panden."
    },
    {
      "section": "Appelsinsauce",
      "text": "Si saucen ned på panden med fedtet, og rør rundt. Smag til med salt og peber."
    },
    {
      "section": "Servering",
      "text": "Skær andebrysterne i tynde skiver, og læg dem på tallerkener eller et fad. Hæld saucen over."
    }
  ],
