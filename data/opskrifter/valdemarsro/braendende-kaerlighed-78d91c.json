  "steps": [
    {
      "section": "Kartoffelmos",
      "text": "Skræl kartoflerne og kog dem møre i rigeligt vand uden salt."
    },
    {
      "section": "Kartoffelmos",
      "text": "Hæld vandet fra, og mos kartoflerne sammen med smørternene."
    },
    {
      "section": "Kartoffelmos",
      "text": "Pisk moset med håndmixer på laveste hastighed, til det er luftigt. Pisk så den lune mælk i lidt ad gangen, til konsistensen er, som du vil have den."
    },
    {
      "section": "Kartoffelmos",
      "text": "Krydr med salt, peber og muskatnød."
    },
    {
      "section": "Topping",
      "text": "Steg baconen sprød på en pande ved middelvarme. Læg den over på køkkenrulle, så fedtet kan sive af."
    },
    {
      "section": "Topping",
      "text": "Svits løgene bløde i baconfedtet sammen med smørret. Rør chilien i, hvis du vil have lidt ekstra bid og varme, og smag til med peber."
    },
    {
      "section": "Topping",
      "text": "Anret moset med baconen og løgene. Server med de syltede rødbeder, purløg og persille."
    }
  ],
