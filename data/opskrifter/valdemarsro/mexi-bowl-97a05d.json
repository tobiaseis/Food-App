  "steps": [
    {
      "section": "Bønnemos",
      "text": "Svits løg og hvidløg med spidskommen og koriander i olien i en lille gryde, til det dufter, og løget er blødt."
    },
    {
      "section": "Bønnemos",
      "text": "Tilsæt bønner og fond, og lad det småkoge, til bønnerne er varme hele vejen igennem."
    },
    {
      "section": "Bønnemos",
      "text": "Tag gryden af varmen, og blend bønnerne med stavblender til et mos."
    },
    {
      "section": "Smørristet majs",
      "text": "Smelt smørret på en varm pande, til det bruser."
    },
    {
      "section": "Smørristet majs",
      "text": "Steg majsen ved høj varme under omrøring, til den får farve. Krydr med salt og peber."
    },
    {
      "section": "Til anretning",
      "text": "Fordel salaten i fire skåle, og læg majs, bønnemos, avocado, tomater, ost, rødløg og agurk i hver sin del af skålen. Pres limesaft over."
    },
    {
      "section": "Til anretning",
      "text": "Top med cremefraiche, og drys med frisk koriander lige før servering. Byt gerne rundt på toppings, så der er både noget sprødt og noget cremet."
    }
  ],
  "changes": []
