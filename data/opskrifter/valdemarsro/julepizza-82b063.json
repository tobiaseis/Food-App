  "steps": [
    {
      "section": "Pizzadej",
      "text": "Rør gæren ud i det lunkne vand i en stor skål. Til en dej, der skal hæve natten over i køleskabet, bruges kun 5 g gær i stedet for 25 g."
    },
    {
      "section": "Pizzadej",
      "text": "Rør halvdelen af melet sammen med olien og saltet, til det er jævnt. Tilsæt resten af melet lidt ad gangen, mens du rører."
    },
    {
      "section": "Pizzadej",
      "text": "Vend dejen ud på et meldrysset bord, og ælt den med hænderne, til den er smidig."
    },
    {
      "section": "Pizzadej",
      "text": "Skyl skålen, og smør den med olie. Læg dejen i, og vend den, så hele overfladen er olieret. Det gør dejen let at arbejde med og skorpen sprødere."
    },
    {
      "section": "Pizzadej",
      "text": "Lad dejen hæve i cirka 60 minutter på køkkenbordet, eller sæt den natten over i køleskabet."
    },
    {
      "section": "Pizzasauce",
      "text": "Blend alle ingredienserne til sauce, til den er helt jævn. Der bruges 2 spsk sauce pr. pizza. Frys resten i portioner, eller brug den som pastasauce."
    },
    {
      "section": "Topping",
      "text": "Sæt en bageplade, et bagestål eller en pizzasten øverst i ovnen, og varm ovnen op på den højeste temperatur."
    },
    {
      "section": "Topping",
      "text": "Lad mozzarellaen dryppe af, og dup den tør med køkkenrulle. Skær den i skiver."
    },
    {
      "section": "Topping",
      "text": "Del dejen i to, og form to runde pizzaer på et meldrysset bord med hænderne."
    },
    {
      "section": "Topping",
      "text": "Smør sauce og pesto ud på bundene. Læg andekød, mozzarella, rødkål og æble ovenpå."
    },
    {
      "section": "Topping",
      "text": "Skru ovnen om til grill. Bag pizzaerne i 4-5 minutter, og hold godt øje med dem."
    },
    {
      "section": "Topping",
      "text": "Pynt med frisk timian og et lille skvæt olivenolie, før pizzaerne serveres."
    }
  ],
