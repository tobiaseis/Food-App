  "steps": [
    {
      "section": "Svampefyld",
      "text": "Udblød de tørrede svampe som angivet på pakken, og lad dem derefter dryppe af i en sigte."
    },
    {
      "section": "Svampefyld",
      "text": "Varm olie op i en bred pande, og lad smørret smelte, til det holder op med at boble."
    },
    {
      "section": "Svampefyld",
      "text": "Brun champignonerne ved høj varme, til de har fået en flot gylden skorpe."
    },
    {
      "section": "Svampefyld",
      "text": "Sænk varmen, og kom løg, hvidløg, rosmarin, spinat og de udblødte svampe i panden. Lad det simre, til løgene er bløde, og spinaten er faldet sammen."
    },
    {
      "section": "Svampefyld",
      "text": "Hæld hvidvin og fløde i, og lad det koge op kort. Smag til med citronskal, lidt citronsaft, salt og peber."
    },
    {
      "section": "Mornaysauce",
      "text": "Smelt smørret i en gryde, og rør melet i. Pisk, til det former en samlet klump."
    },
    {
      "section": "Mornaysauce",
      "text": "Hæld mælken i en smule ad gangen under konstant piskning, til saucen er jævn og tyk."
    },
    {
      "section": "Mornaysauce",
      "text": "Rør mozzarellaen i, og lad den smelte. Krydr med muskatnød, salt og peber."
    },
    {
      "section": "Samling",
      "text": "Forvarm ovnen til 200 °C varmluft, og smør et ovnfast fad."
    },
    {
      "section": "Samling",
      "text": "Bred et lag svampefyld i bunden af fadet, og dæk med lasagneplader og lidt mornaysauce. Gentag lagene, og slut af med mornaysauce øverst."
    },
    {
      "section": "Samling",
      "text": "Bland pankorasp og parmesan, og strø det over. Bag lasagnen i ca. 15 minutter, til pladerne er møre."
    },
    {
      "section": "Salat",
      "text": "Rør olie, citronsaft, honning og sennep sammen til en dressing, og smag til med salt og peber."
    },
    {
      "section": "Salat",
      "text": "Vend salaten i dressingen. Anret lasagnen med timian drysset over, og server salaten ved siden af."
    }
  ],
