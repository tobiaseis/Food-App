  "steps": [
    {
      "section": "Ramen",
      "text": "Rist sesamfrøene på en tør pande, og stil dem til side."
    },
    {
      "section": "Ramen",
      "text": "Kog nudlerne i letsaltet vand i ca. 1 minut kortere end angivet på pakken. Si dem, og skyl dem i koldt vand, så de ikke klistrer sammen."
    },
    {
      "section": "Ramen",
      "text": "Kog de 4 æg i 7 minutter i kogende vand, så blommen bliver blød. Pil dem."
    },
    {
      "section": "Sprød kylling",
      "text": "Vend kyllingen i hvedemel, salt og peber. Dyp den i det sammenpiskede æg, og vend den i panko. Pres pankoen let fast på kødet."
    },
    {
      "section": "Sprød kylling",
      "text": "Steg kyllingen i olie på en pande ved middel varme i ca. 6 minutter på hver side, til den er gyldne, sprød og gennemstegt."
    },
    {
      "section": "Misosuppe",
      "text": "Bring fond, ingefær og hvidløg i kog i en gryde. Tag den af varmen, og rør misoen ud i suppen. Smag til med sojasauce og fiskesauce."
    },
    {
      "section": "Servering",
      "text": "Skær kyllingen i skiver. Fordel nudler, pak choi, forårsløg, koriander og kylling i skåle, og hæld den varme suppe over."
    },
    {
      "section": "Servering",
      "text": "Top med de halverede æg, chili og sesamfrø, og server med limebåde til at presse over."
    }
  ],
