  "steps": [
    {
      "section": "Coq au vin",
      "text": "Krydr kyllingestykkerne med salt og peber. Varm smør og olie i en stor gryde, og brun kyllingen, til skindet er gyldent og begynder at blive sprødt. Læg stykkerne over på et fad."
    },
    {
      "section": "Coq au vin",
      "text": "Rør løg, hvidløg, knoldselleri og halvdelen af gulerødderne i gryden, og svits dem i få minutter."
    },
    {
      "section": "Coq au vin",
      "text": "Kom kyllingen tilbage i gryden og hæld rødvinen over. Tilsæt timian, laurbærblade, nelliker og peberkorn. Sæt låg på, og lad det simre i 1-1½ time."
    },
    {
      "section": "Coq au vin",
      "text": "Kort før kyllingen er færdig: Steg baconen sprød på en pande, og tag den af panden. Brug baconfedtet til at riste champignon og resten af gulerødderne. Stil dem til side."
    },
    {
      "section": "Coq au vin",
      "text": "Tør panden ren. Kom perleløg, en klump af smørret til stegning, sukker, vand og lidt salt på panden. Lad det koge op og rør, til løgene er karamelliserede."
    },
    {
      "section": "Coq au vin",
      "text": "Løft kyllingen op af gryden og stil den til side. Si væsken gennem en finmasket si ned i en ren gryde, og smid grøntsagerne og krydderierne i sien ud."
    },
    {
      "section": "Coq au vin",
      "text": "Fjern overskydende fedt fra saucen med en ske, og kog den ind uden låg. Tilsæt den udrørte majsstivelse, så saucen tykner, og smag til med salt og peber."
    },
    {
      "section": "Coq au vin",
      "text": "Kom kylling, champignon, gulerødder, perleløg og bacon ned i saucen. Varm det hele godt igennem, og drys med persille, inden retten kommer på bordet."
    },
    {
      "section": "Kartoffelmos",
      "text": "Kog kartoflerne møre i usaltet vand, og afdryp dem."
    },
    {
      "section": "Kartoffelmos",
      "text": "Varm mælken i en kasserolle til ca. 50 grader."
    },
    {
      "section": "Kartoffelmos",
      "text": "Mos de varme kartofler groft sammen med smørret. Pisk dem derefter med håndmixer, mens du hælder den lune mælk i lidt ad gangen, til moset er cremet, luftigt og blødt."
    },
    {
      "section": "Kartoffelmos",
      "text": "Smag til med salt, peber og friskrevet muskatnød."
    }
  ],
