  "steps": [
    {
      "section": "Krabbeklør",
      "text": "Bring vandet i en stor gryde i kog. Kom salt, citronbåde og krabbeklør i."
    },
    {
      "section": "Krabbeklør",
      "text": "Læg låg på, og lad det koge op igen. Lad kløerne småkoge i 20 minutter."
    },
    {
      "section": "Krabbeklør",
      "text": "Tag gryden af varmen, og lad kløerne trække i vandet i 10 minutter. Fisk dem derefter op."
    },
    {
      "section": "Krabbeklør",
      "text": "Knæk skallerne med en hammer eller lignende, og pil kødet ud med lange, smalle gafler."
    },
    {
      "section": "Dilddressing",
      "text": "Rør creme fraiche og dild sammen i en skål. Smag til med salt og peber."
    }
  ],
