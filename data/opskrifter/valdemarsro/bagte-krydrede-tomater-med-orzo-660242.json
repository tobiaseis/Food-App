  "steps": [
    {
      "section": null,
      "text": "Varm ovnen op til 200 °C. Smør et ovnfast fad og læg tomater, hvidløg, timian, rosmarin, honning og olivenolie i. Krydr med salt og peber og vend det hele godt."
    },
    {
      "section": null,
      "text": "Bag fadet i 30 minutter, til tomaterne er sprækket, og hvidløgene er møre."
    },
    {
      "section": null,
      "text": "Imens lægger du parmaskinken på en bageplade med bagepapir. Bag den ved 180 °C i ca. 10 minutter, til den er sprød."
    },
    {
      "section": null,
      "text": "Kog orzo efter anvisningen på pakken, og lad den dryppe af i et dørslag."
    },
    {
      "section": null,
      "text": "Tag fadet ud af ovnen og mos tomater og hvidløg med en gaffel. Rør parmesan i, mens tomaterne er varme, så det bliver til en sauce. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Vend orzo og tomatsauce sammen i en stor skål, og rør basilikum i. Drys med pinjekerner og sesamfrø."
    },
    {
      "section": null,
      "text": "Læg burrata ovenpå, og smuldr den sprøde parmaskinke over."
    }
  ],
  "changes": []
