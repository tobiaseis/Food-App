  "steps": [
    {
      "section": "Suppe",
      "text": "Læg avocado, agurk, koriander, hvidløg og fond i en blender. Blend, til massen er helt glat og cremet."
    },
    {
      "section": "Suppe",
      "text": "Smag til med limesaft, lidt limeskal, chiliflager, salt og peber."
    },
    {
      "section": "Suppe",
      "text": "Blend suppen kort igen. Stil den derefter i køleskabet i ca. 3 timer, eller i fryseren i 30-40 minutter, til den er helt kold."
    },
    {
      "section": "Til servering",
      "text": "Rist græskarkerner, solsikkekerner og pinjekerner på en tør, varm pande, til de får en anelse farve."
    },
    {
      "section": "Til servering",
      "text": "Hæld den iskolde suppe i skåle. Top med koriander, chiliflager, et skvæt limesaft og de ristede kerner."
    },
    {
      "section": "Til servering",
      "text": "Suppen rækker til 4 personer, hvis den serveres som forret."
    }
  ],
