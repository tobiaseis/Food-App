  "steps": [
    {
      "section": "Lammekrone",
      "text": "Tør lammekronen grundigt med køkkenrulle."
    },
    {
      "section": "Lammekrone",
      "text": "Rids fedtet i et tæt rudemønster. Skær kun gennem fedtlaget, så du ikke rører kødet."
    },
    {
      "section": "Lammekrone",
      "text": "Stød salt, hvidløg og rosmarin i en morter, til det er grønt og duftende. Tilsæt peber."
    },
    {
      "section": "Lammekrone",
      "text": "Gnid blandingen ind i kronen, så den trænger ned i ridserne."
    },
    {
      "section": "Lammekrone",
      "text": "Læg kronen med fedtsiden opad i et ovnfast fad. Bag den ved 175 °C varmluft i 20-30 minutter, alt efter hvor rosa eller gennemstegt den skal være (24-25 minutter giver et godt resultat)."
    },
    {
      "section": "Lammekrone",
      "text": "Lad kødet hvile i 10-15 minutter, før du skærer det ud."
    },
    {
      "section": "Rosmarinkartofler",
      "text": "Stød rosmarin og flagesalt grundigt i en morter til et grønt rosmarinsalt."
    },
    {
      "section": "Rosmarinkartofler",
      "text": "Pensl et ovnfast fad med lidt af olivenolien. Vend kartofler, gulerødder, hvidløg og løg med resten af olien, rosmarinsaltet og peber."
    },
    {
      "section": "Rosmarinkartofler",
      "text": "Fordel grøntsagerne i fadet og læg små klatter smør ovenpå."
    },
    {
      "section": "Rosmarinkartofler",
      "text": "Bag ved 175 °C varmluft i 40-45 minutter, til kartoflerne er møre."
    }
  ],
