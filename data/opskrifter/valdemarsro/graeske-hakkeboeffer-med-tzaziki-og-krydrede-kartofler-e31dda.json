  "steps": [
    {
      "section": "Tzatziki",
      "text": "Vend den revne agurk med lidt salt, og lad den stå og trække i 5-10 minutter. Hæld den i en sigte, så væden løber fra, og pres derefter så meget vand som muligt ud af agurken."
    },
    {
      "section": "Tzatziki",
      "text": "Bland agurken i yoghurten. Rør hvidløg og olivenolie i, og smag til med salt og peber. Stil tzatzikien på køl, til den skal bruges."
    },
    {
      "section": "Krydrede kartofler",
      "text": "Varm ovnen op til 175 °C. Del kartoflerne på midten, og vend dem med halvdelen af olien og lidt flagesalt. Læg dem på en bageplade med bagepapir, og bag dem i ca. 10 minutter."
    },
    {
      "section": "Krydrede kartofler",
      "text": "Tag kartoflerne ud, og vend dem med resten af olien, timian, rosmarin og lidt mere salt. Bag dem videre i ca. 15 minutter, til de er møre og gyldne."
    },
    {
      "section": "Græske hakkebøffer",
      "text": "Ælt alle ingredienserne til hakkebøfferne sammen i en skål, og form dem til bøffer."
    },
    {
      "section": "Græske hakkebøffer",
      "text": "Varm olie op på en pande ved høj varme, og brun bøfferne i 1 minut på hver side, så de får en fin skorpe. Skru ned til middelvarme, og steg dem 3-5 minutter på hver side."
    },
    {
      "section": "Grønt tilbehør",
      "text": "Vend cherrytomater, agurk og feta med salt og peber."
    },
    {
      "section": null,
      "text": "Anret hakkebøfferne med kartofler, grønt tilbehør og tzatziki."
    }
  ],
