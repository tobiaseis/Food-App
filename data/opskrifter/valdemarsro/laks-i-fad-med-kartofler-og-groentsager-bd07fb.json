  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 190 °C varmluft. Smør et ovnfast fad."
    },
    {
      "section": null,
      "text": "Kom porre, gulerødder, fennikel, løg, spidskål og kartoffelskiver i fadet."
    },
    {
      "section": null,
      "text": "Pisk fond, fløde og hvidvin sammen med sennep, timian, salt og peber. Hæld blandingen over grøntsagerne."
    },
    {
      "section": null,
      "text": "Bag fadet i knap 45 minutter, til kartoflerne er næsten møre."
    },
    {
      "section": null,
      "text": "Tag fadet ud. Strø kapers over grøntsagerne, læg laksen ovenpå og krydr med salt, peber, et skvæt citronsaft og lidt citronskal."
    },
    {
      "section": null,
      "text": "Sæt fadet tilbage i ovnen i 7-8 minutter, til laksen netop er gennemstegt."
    },
    {
      "section": null,
      "text": "Lad retten hvile i 4-5 minutter, så smagen samler sig. Server med persille drysset over."
    }
  ],
