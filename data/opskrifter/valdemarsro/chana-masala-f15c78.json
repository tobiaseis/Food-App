  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en gryde ved middelvarme. Svits løg og spidskommen, til løgene er blødt igennem."
    },
    {
      "section": null,
      "text": "Rør hvidløg, ingefær, stødt koriander, chili, kardemomme, gurkemeje og garam masala i gryden, og lad krydderierne sive et øjeblik."
    },
    {
      "section": null,
      "text": "Hæld tomater og kikærter i, og bring det hele i kog under omrøring."
    },
    {
      "section": null,
      "text": "Lad gryden simre uden låg i 20 minutter. Rør ofte, og tynd saucen med grøntsagsfonden, hvis den bliver for tyk."
    },
    {
      "section": null,
      "text": "Kog imens risene efter anvisningen på pakken."
    },
    {
      "section": null,
      "text": "Smag chana masalaen til med sukker, salt og peber, og tilføj flere krydderier, hvis du vil have mere smag."
    },
    {
      "section": null,
      "text": "Anret med ris og drys med frisk koriander."
    }
  ],
