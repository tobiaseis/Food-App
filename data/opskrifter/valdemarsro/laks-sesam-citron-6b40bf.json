  "steps": [
    {
      "section": null,
      "text": "Rør sesamfrø, citronskal, salt og peber sammen på en tallerken."
    },
    {
      "section": null,
      "text": "Tryk laksefileternes overside ned i blandingen, så den dækker godt."
    },
    {
      "section": null,
      "text": "Varm smør og olie på en pande ved middelvarme. Læg laksen på med skindsiden nedad, og steg den i cirka 15 minutter."
    },
    {
      "section": null,
      "text": "Vend fileterne, og steg dem cirka 3-4 minutter på sesamsiden."
    },
    {
      "section": null,
      "text": "Tjek laksen undervejs, for tiden afhænger af, hvor tykke fileterne er."
    },
    {
      "section": null,
      "text": "Server med dild drysset over."
    }
