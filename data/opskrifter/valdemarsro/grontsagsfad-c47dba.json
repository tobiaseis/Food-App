  "steps": [
    {
      "section": null,
      "text": "Rens og pil grøntsagerne, og skær dem i helt små stykker."
    },
    {
      "section": null,
      "text": "Put grøntsagerne i en gryde med vand, så de lige er dækket, og tilsæt salt. Kog dem i 8 minutter, og hæld vandet fra."
    },
    {
      "section": null,
      "text": "Blend grøntsagerne med æg og parmesan. Tilsæt rasp og halvdelen af mozzarellaen, og blend igen. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Tænd ovnen på 180 °C varmluft. Smør et ovnfast fad, og fyld blandingen i."
    },
    {
      "section": null,
      "text": "Drys med rasp. Skær den resterende mozzarella i skiver, og fordel dem ovenpå."
    },
    {
      "section": null,
      "text": "Bag fadet i den forvarmede ovn i 30 minutter."
    }
