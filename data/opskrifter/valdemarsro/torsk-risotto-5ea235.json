  "steps": [
    {
      "section": "Risotto",
      "text": "Svits løg og hvidløg i olie i en gryde, til løgene er bløde."
    },
    {
      "section": "Risotto",
      "text": "Rør risene med i gryden, og vend dem rundt. Hæld hvidvinen i, og rør, til den er trukket helt ind."
    },
    {
      "section": "Risotto",
      "text": "Tilsæt grøntsagsfonden, og bring det i kog. Skru ned, så det simrer svagt, læg låg på, og lad risene simre i ca. 25-30 minutter, til de er møre. Rør parmesan i, og smag til med salt og peber."
    },
    {
      "section": "Bagt spidskål",
      "text": "Læg spidskålskvartene i et ovnfast fad. Pensl med smeltet smør, og drys med parmesan, timian, salt og peber."
    },
    {
      "section": "Bagt spidskål",
      "text": "Bag ved 175 °C varmluft i ca. 15-20 minutter i en forvarmet ovn."
    },
    {
      "section": "Torsk med krydret rasp",
      "text": "Smuldr brødet på en bageplade med bagepapir, og bag det ved 175 °C varmluft i ca. 8-10 minutter i en forvarmet ovn. Vend krummerne et par gange undervejs."
    },
    {
      "section": "Torsk med krydret rasp",
      "text": "Lad krummerne køle af. Blend dem fint i en minihakker sammen med urterne og en smule salt."
    },
    {
      "section": "Torsk med krydret rasp",
      "text": "Del torsken i passende stykker, læg dem på en bradepande med bagepapir, og tør dem med køkkenrulle. Fordel raspen over fisken, og tryk den let ind, så den hænger fast."
    },
    {
      "section": "Torsk med krydret rasp",
      "text": "Bag torsken ved 175 °C varmluft i 10-12 minutter i en forvarmet ovn, til den er mør."
    },
    {
      "section": "Servering",
      "text": "Anret risottoen på tallerkener med torsk og en kvart spidskål. Drys med parmesan og hakket persille."
    }
  ],
