  "steps": [
    {
      "section": "Lammefrikadeller",
      "text": "Bland alle ingredienser til frikadellerne i en skål, og krydr med salt og peber. Sæt gerne farsen på køl i mindst en halv time, så den sætter sig."
    },
    {
      "section": "Lammefrikadeller",
      "text": "Form farsen til små frikadeller. Varm olie og smør op på en pande, og steg frikadellerne, til de er gennemstegte. Vend dem flere gange undervejs."
    },
    {
      "section": "Tzatziki",
      "text": "Skær agurkerne over på langs, og skrab kernerne ud med en teske."
    },
    {
      "section": "Tzatziki",
      "text": "Riv agurkerne groft i en skål, og bland dem med salt. Lad dem stå i 5-10 minutter, og hæld dem derefter i en sigte, hvor du presser al væden fra."
    },
    {
      "section": "Tzatziki",
      "text": "Rør den afdryppede agurk sammen med yoghurten. Smag til med hvidløg, olivenolie, salt og peber."
    },
    {
      "section": "Mør spidskål",
      "text": "Riv skallen af citronen, og pres saften. Kom begge dele i en stor skål sammen med spidskål, olivenolie, dijonsennep og honning, og smag til med salt og peber."
    },
    {
      "section": "Mør spidskål",
      "text": "Ælt kålen med hænderne i omkring et minut, til den er blød og mør."
    },
    {
      "section": "Servering",
      "text": "Anret frikadellerne med spidskålen, tzatzikien, tomaterne og agurkeskiverne. Drys med oliven, feta, soltørrede tomater og oregano."
    }
  ],
