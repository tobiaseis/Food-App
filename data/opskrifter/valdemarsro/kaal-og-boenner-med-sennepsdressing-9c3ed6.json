  "steps": [
    {
      "section": "Sennepsdressing",
      "text": "Bland alle ingredienserne til dressingen, og smag til med salt og peber. Lad den hvile og trække, mens du laver resten."
    },
    {
      "section": null,
      "text": "Forvarm ovnen til 180 °C varmluft. Læg blomkålsskiverne på en bradepande med bagepapir, og pensl dem med det smeltede smør."
    },
    {
      "section": null,
      "text": "Bland både den søde og den røgede paprika med salt og peber, og drys blandingen over blomkålen. Bag i cirka 20 minutter, til skiverne er møre og gyldne."
    },
    {
      "section": null,
      "text": "Kog bulguren, som det står på emballagen. Læg grønkålen i en stor skål, og ælt den kraftigt med hænderne i nogle minutter, til den er blød."
    },
    {
      "section": null,
      "text": "Læg grønkål, bulgur og blomkål på et fad. Top med butterbeans og dressing, og drys med valnødder, chiliflager og persille."
    }
  ],
