  "steps": [
    {
      "section": "Bagekartofler",
      "text": "Forvarm ovnen til 200 °C varmluft. Skrub kartoflerne rene og del dem på langs i to halvdele."
    },
    {
      "section": "Bagekartofler",
      "text": "Læg halvdelene med snitfladen opad på en bageplade med bagepapir. Pensl dem med olie, og krydr med citronskal, salt og peber."
    },
    {
      "section": "Bagekartofler",
      "text": "Bag kartoflerne midt i ovnen i 30 minutter, til de er møre."
    },
    {
      "section": "Bagekartofler",
      "text": "Steg imens baconen sprød på en pande, og lad den dryppe af."
    },
    {
      "section": "Cremet topping",
      "text": "Rør creme fraiche, hvidløg, persille og det meste af purløget sammen. Smag til med salt og peber."
    },
    {
      "section": "Cremet topping",
      "text": "Del dressingen i to. Vend den ene halvdel med halvdelen af baconen."
    },
    {
      "section": "Æbleslaw",
      "text": "Bland æbler, gulerødder, spidskål, tranebær og solsikkekerner i en stor skål. Vend den anden halvdel af dressingen i, til alt er dækket."
    },
    {
      "section": "Servering",
      "text": "Læg kartoffelhalvdelene på fade, og top dem med dressingen med bacon. Drys med resten af baconen og lidt purløg, og server slawen ved siden af."
    }
  ],
