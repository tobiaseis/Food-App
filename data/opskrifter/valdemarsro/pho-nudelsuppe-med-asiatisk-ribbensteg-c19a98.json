  "steps": [
    {
      "section": "Asiatisk ribbensteg",
      "text": "Tag eventuelle ben af ribbenstegen, og læg den med sværsiden nedad på et skærebræt. Skær riller i kødsiden på tværs af hele stykket, ca. 1 cm dybe."
    },
    {
      "section": "Asiatisk ribbensteg",
      "text": "Rør five spice, brun farin, citronskal, salt og peber sammen i en skål. Gnid blandingen godt ind i rillerne, og fyld dem derefter med det hakkede løg."
    },
    {
      "section": "Asiatisk ribbensteg",
      "text": "Vend stegen, så sværen vender opad. Rids sværen i et net af ca. 1 cm brede tern, og skær kun gennem svær og fedt, ikke ned i kødet. Gnid sværen godt med olie og salt."
    },
    {
      "section": "Asiatisk ribbensteg",
      "text": "Læg stegen i et ovnfast fad med bagepapir, og sæt den i en kold ovn. Indstil ovnen på 125 °C, og steg i 2 timer. Skru derefter op på 230 °C, og steg, til sværen er helt knasende sprød."
    },
    {
      "section": "Nudelsuppe",
      "text": "Bring fond, five spice, ingefær, hvidløg, fiskesauce, riseddike og peber i kog i en gryde. Smag suppen godt til."
    },
    {
      "section": "Nudelsuppe",
      "text": "Kog nudlerne direkte i suppen, som det står på pakken."
    },
    {
      "section": "Til servering",
      "text": "Skær ribbenstegen i mundrette stykker."
    },
    {
      "section": "Til servering",
      "text": "Del den varme nudelsuppe ud i skåle. Top med ribbensteg og sprød svær, bønnespirer, forårsløg, urter og chili. Server limebådene ved siden af, så man kan presse dem over."
    }
  ],
  "changes": [
    "Thaibasilikum er erstattet med almindelig basilikum."
  ]
}
