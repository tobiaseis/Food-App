  "steps": [
    {
      "section": "Tun og marinade",
      "text": "Skær tunen i tern eller tynde skiver. Det går lettest, hvis den stadig er lidt frossen."
    },
    {
      "section": "Tun og marinade",
      "text": "Rør teriyakisauce, sesamolie, ingefær, limesaft og limeskal sammen i en skål. Smag til med salt og peber."
    },
    {
      "section": "Tun og marinade",
      "text": "Vend tunen i marinaden, og lad den stå og trække i 10-15 minutter."
    },
    {
      "section": "Chilimayo",
      "text": "Rør mayonnaise og sriracha sammen. Tilsæt mere sriracha, hvis du vil have den stærkere."
    },
    {
      "section": "Til bowlen",
      "text": "Kom edamamebønnerne i en skål, og overhæld dem med kogende vand, så de bliver varme og tøer op. Si vandet fra."
    },
    {
      "section": "Til bowlen",
      "text": "Fordel ris, edamamebønner, agurk, avocado, vandmelon og den marinerede tun i skåle."
    },
    {
      "section": "Til bowlen",
      "text": "Strø forårsløg og sesamfrø over, og dryp med chilimayo. Server limebådene ved siden af, så hver kan presse efter smag."
    }
  ],
