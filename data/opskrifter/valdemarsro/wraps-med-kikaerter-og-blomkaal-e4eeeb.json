  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 175 °C varmluft. Læg bagepapir på en bageplade."
    },
    {
      "section": null,
      "text": "Rør hvidløg, citronsaft, citronskal, olie, salt og peber sammen i en skål."
    },
    {
      "section": null,
      "text": "Læg kikærter, blomkål og løg på bagepladen. Hæld marinaden over, og vend det hele godt rundt."
    },
    {
      "section": null,
      "text": "Bag i 20-25 minutter, til blomkålen er gylden, mør og saftig."
    },
    {
      "section": null,
      "text": "Strø sumak, kapers og persille over det varme blomkålsmix."
    },
    {
      "section": null,
      "text": "Varm tortillas i ovnen eller på en pande, til de er bløde."
    },
    {
      "section": null,
      "text": "Fyld tortillas med blomkålsmixet. Top med rucola, tomat, agurk og ristede græskarkerner."
    }
  ],
