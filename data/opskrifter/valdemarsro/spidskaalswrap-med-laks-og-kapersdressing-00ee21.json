  "steps": [
    {
      "section": null,
      "text": "Forvarm ovnen til 175 °C varmluft. Læg bagepapir i et ovnfast fad."
    },
    {
      "section": null,
      "text": "Læg laksen i fadet, og drys med salt og peber. Dryp med lidt af citronsaften."
    },
    {
      "section": null,
      "text": "Bag laksen midt i ovnen i 15 minutter."
    },
    {
      "section": "Til dressingen",
      "text": "Rør yoghurt, kapers og purløg sammen. Smag til med salt, peber og eventuelt lidt citronsaft."
    },
    {
      "section": null,
      "text": "Del spidskålen i blade. Fordel pære, agurk, rødløg og dressing i hver sin lille skål."
    },
    {
      "section": null,
      "text": "Flak laksen, og stil den på bordet sammen med resten. Hver især fylder sine spidskålsblade og ruller dem sammen."
    }
