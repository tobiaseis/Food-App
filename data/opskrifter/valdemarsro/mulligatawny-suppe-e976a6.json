  "steps": [
    {
      "section": null,
      "text": "Rist karry og spidskommen i en tør gryde ved middelvarme, til det dufter."
    },
    {
      "section": null,
      "text": "Hæld olien i, og svits løg, hvidløg og porre i krydderierne, til grøntsagerne er bløde."
    },
    {
      "section": null,
      "text": "Brun kyllingen på alle sider. Hæld fonden over, og rør timian i."
    },
    {
      "section": null,
      "text": "Læg låg på, og lad suppen simre ved lav varme i 20 minutter, til kyllingen er mør. Kog risene i samme tid."
    },
    {
      "section": null,
      "text": "Kom tomater og peberfrugt i gryden, og smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Rør majsstivelsen ud i koldt vand, og tilsæt under omrøring, så suppen bliver lidt tykkere."
    },
    {
      "section": null,
      "text": "Lad suppen koge godt igennem, og tilsæt derefter fløden."
    },
    {
      "section": null,
      "text": "Top med persille, og server med de kogte ris."
    }
  ],
