  "steps": [
    {
      "section": null,
      "text": "Kom tun, mayonnaise, creme fraiche, kapers, citronsaft, salt og peber i en blender, og kør det til en glat sauce. Smag til."
    },
    {
      "section": null,
      "text": "Rør pesto op med olivenolien, så den bliver tyndere."
    },
    {
      "section": null,
      "text": "Smør tunsauce på hver skive kød, og rul skiverne sammen. Dryp den fortyndede pesto over."
    },
    {
      "section": null,
      "text": "Læg salat, agurk og kapersbær på tallerkenerne, og anret kødrullerne ovenpå. Server med resten af tunsaucen og lidt mere pesto ved siden af."
    }
  ],
