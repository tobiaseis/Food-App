  "steps": [
    {
      "section": null,
      "text": "Varm lidt af olien i en gryde, og steg baconskiverne sprøde. Læg dem på køkkenrulle, og stil dem til side."
    },
    {
      "section": null,
      "text": "Svits løgene i baconfedtet og resten af olien, til de er bløde."
    },
    {
      "section": null,
      "text": "Tilsæt oksekødet, skru op for varmen, og brun det under omrøring."
    },
    {
      "section": null,
      "text": "Kom spidskommen, paprika, spidskål, gulerødder, squash, hvidløg, cherrytomater, hakkede tomater og fond i gryden. Bring det i kog, og lad suppen simre i 7-10 minutter."
    },
    {
      "section": null,
      "text": "Rør flødeosten i suppen, og smag til med salt og peber."
    },
    {
      "section": "Servering",
      "text": "Øs suppen op i skåle. Smuldr baconen ud over, og top med cheddar, cornichoner og persille."
    }
  ],
