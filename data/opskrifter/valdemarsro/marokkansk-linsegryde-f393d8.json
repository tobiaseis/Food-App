  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en gryde ved middelvarme, og blød løg og hvidløg op, til de er møre."
    },
    {
      "section": null,
      "text": "Bland alle krydderierne med melet, og krydr med salt og peber. Rør blandingen ned i gryden, og vend det hele godt rundt, så løgene er dækket."
    },
    {
      "section": null,
      "text": "Kom linser, hakkede tomater, fond, dadler og abrikoser i gryden. Bring det langsomt i kog, læg låg på, og lad det simre ved lav til middel varme i 25-30 minutter, til linserne er møre."
    },
    {
      "section": null,
      "text": "Vend kikærterne i sammen med halvdelen af cashewnødderne, og varm det hele godt igennem. Smag til med citronskal, citronsaft, salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Anret gryden med ris, og drys med koriander, mynte og de resterende cashewnødder."
    }
  ],
  "changes": [
