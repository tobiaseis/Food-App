  "steps": [
    {
      "section": "Til vaflerne",
      "text": "Pisk mel og bouillon sammen til en tyk dej i en stor skål, og lad den stå ved stuetemperatur i 10 minutter."
    },
    {
      "section": "Til vaflerne",
      "text": "Svits løg og hvidløg i lidt olie på en pande, til de er møre. Lad dem køle lidt af."
    },
    {
      "section": "Til vaflerne",
      "text": "Vend de svitsede løg, æggene og spidskålen ned i dejen. Krydr med salt og peber."
    },
    {
      "section": "Til vaflerne",
      "text": "Pensl vaffeljernet med olie, og bag vaflerne, til de er gyldne og helt gennemstegte."
    },
    {
      "section": "Til dressingen",
      "text": "Rør ketchup, sojasauce, honning og worcestershiresauce sammen, og juster smagen."
    },
    {
      "section": "Til servering",
      "text": "Anret to vafler på hver tallerken med lidt dressing imellem. Top med bacon og halvdelen af forårsløgene."
    },
    {
      "section": "Til servering",
      "text": "Træk striber af dressing og mayonnaise hen over vaflerne. Drys med karse, sesamfrø, chiliflager og resten af forårsløgene."
    },
    {
      "section": "Til servering",
      "text": "Server med rucola og agurkeskiver ved siden af."
    }
  ],
