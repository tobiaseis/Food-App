  "steps": [
    {
      "section": null,
      "text": "Stød salt, peber, urter, citronskal og hvidløg til en jævn, aromatisk krydderiblanding i en morter."
    },
    {
      "section": null,
      "text": "Rids fedtlaget på culotten i et rudemønster: først på langs, så på tværs. Skær kun gennem fedtet og ikke ned i selve kødet."
    },
    {
      "section": null,
      "text": "Gnid krydderiblandingen ind over hele stegen."
    },
    {
      "section": null,
      "text": "Læg stegen i ovnen ved 175 °C varmluft, eller læg den på en varm grill med indirekte varme."
    },
    {
      "section": null,
      "text": "Steg i 10 minutter, og lad stegen hvile på en rist i 10 minutter."
    },
    {
      "section": null,
      "text": "Steg igen i 10 minutter, og lad den hvile på risten i 10 minutter."
    },
    {
      "section": null,
      "text": "Steg til sidst i 5 minutter, til kernetemperaturen er 56 °C (brug eventuelt et stegetermometer). Lad stegen hvile på risten i 10 minutter."
    },
    {
      "section": null,
      "text": "Skær stegen i tynde skiver, og server."
    }
  ],
