  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en gryde ved høj varme, og brun oksekødet, mens du rører rundt."
    },
    {
      "section": null,
      "text": "Kom løg, hvidløg, gulerødder og squash i gryden sammen med de hakkede tomater, de soltørrede tomater, tomatpuréen, oregano, timian og bouillonen."
    },
    {
      "section": null,
      "text": "Lad saucen simre uden låg i 5 minutter. Smag den til med salt, peber og fløde."
    },
    {
      "section": null,
      "text": "Forvarm ovnen til 175 °C varmluft, og smør et ovnfast fad."
    },
    {
      "section": null,
      "text": "Læg sauce og lasagneplader i lag i fadet, og slut med et lag sauce øverst."
    },
    {
      "section": null,
      "text": "Pil mozzarellaen i mindre stykker, og fordel dem over toppen. Bag lasagnen i 15 minutter."
    }
  ],
