  "steps": [
    {
      "section": null,
      "text": "Forvarm ovnen til 180 °C varmluft. Smør et ovnfast fad."
    },
    {
      "section": null,
      "text": "Læg tomaterne i fadet. Fordel hvidløg, olie, oregano, timian, chili og peber over, og hak halvdelen af basilikummen fint og drys den på. Vend det hele godt rundt."
    },
    {
      "section": null,
      "text": "Placer fetaen midt i fadet oven på tomaterne, og bag i 25 minutter."
    },
    {
      "section": null,
      "text": "Kog pastaen al dente i letsaltet vand, mens fadet er i ovnen. Hæld et par dl af kogevandet i en skål, før du hælder resten fra."
    },
    {
      "section": null,
      "text": "Tag fadet ud af ovnen, og mas tomater og feta sammen med en gaffel, til det er blandet godt."
    },
    {
      "section": null,
      "text": "Rør resten af basilikummen i, og tynd med lidt pastavand, til saucen er cremet. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Vend saucen med den varme pasta, og tilsæt mere pastavand, hvis den skal være cremetere."
    },
    {
      "section": null,
      "text": "Anret på tallerkener, og pynt med frisk basilikum."
    }
  ],
