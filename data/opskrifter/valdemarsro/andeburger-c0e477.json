  "steps": [
    {
      "section": null,
      "text": "Varm bollerne i brødristeren eller i ovnen. Opvarm rødkålssalaten i en lille gryde."
    },
    {
      "section": null,
      "text": "Rør mayonnaise og julesauce sammen til en dressing, og smag den til med salt og peber."
    },
    {
      "section": null,
      "text": "Vend grønkålen med en lille del af dressingen, og massér den let, så den bliver lidt mørkere og mere mør."
    },
    {
      "section": null,
      "text": "Bred resten af dressingen på de varme bollehalvdele."
    },
    {
      "section": null,
      "text": "Læg grønkål på underdelene, og top med andekød, rødløg, den varme rødkål og æblekompot. Sæt låget på og server."
    }
