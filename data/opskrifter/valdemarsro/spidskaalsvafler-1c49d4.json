  "steps": [
    {
      "section": "Syltede grøntsager",
      "text": "Bring vand, sukker og eddike i en gryde i kog, og lad det koge, til sukkeret er opløst. Tag gryden af varmen."
    },
    {
      "section": "Syltede grøntsager",
      "text": "Læg gulerødder og agurk i den varme lage, og hæld det hele på et glas. Sæt låg på, og stil glasset i køleskabet, mens du laver resten."
    },
    {
      "section": "Vafler",
      "text": "Pisk mel og bouillon sammen til en tyk dej. Lad dejen trække i 10 minutter."
    },
    {
      "section": "Vafler",
      "text": "Svits løg og hvidløg i olie på en pande, til de er bløde."
    },
    {
      "section": "Vafler",
      "text": "Vend løg og hvidløg i dejen sammen med æg, spidskål, revne gulerødder og spinat. Smag til med salt og peber."
    },
    {
      "section": "Vafler",
      "text": "Pensl vaffeljernet med smør eller olie, og varm det op. Bag vaflerne, til de er gyldne og sprøde, og lad dem ligge på en rist, mens resten bages."
    },
    {
      "section": "Til servering",
      "text": "Anret vaflerne på tallerkener med striber af mayonnaise og sriracha. Fordel de syltede grøntsager, avocado, rucola, karse og hampefrø ovenpå."
    }
  ],
  "changes": [
