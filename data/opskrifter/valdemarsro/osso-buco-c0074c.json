  "steps": [
    {
      "section": "Osso buco",
      "text": "Tør skankene godt med køkkenrulle. Bland hvedemel med salt og peber, og vend kødet i blandingen."
    },
    {
      "section": "Osso buco",
      "text": "Varm olien i en stor gryde. Brun skankene på begge sider få ad gangen, og stil dem på et fad."
    },
    {
      "section": "Osso buco",
      "text": "Tilsæt lidt ekstra olie i gryden, og svits løg og hvidløg, til de er bløde. Rør gulerødder og selleri i, og svits dem nogle minutter."
    },
    {
      "section": "Osso buco",
      "text": "Hæld tomater, tomatpuré, hvidvin og laurbærblade i gryden. Læg skankene tilbage, og hæld bouillonen over. Sæt låg på."
    },
    {
      "section": "Osso buco",
      "text": "Lad retten simre i 3 timer. Begynd på risotto og gremolata, når der er cirka en halv time tilbage."
    },
    {
      "section": "Safranrisotto",
      "text": "Smelt smørret i en gryde, og svits løg og hvidløg, til løgene er bløde."
    },
    {
      "section": "Safranrisotto",
      "text": "Rør risene og safranen ned i løgene, og hæld hvidvinen over. Rør, til væsken er optrukket."
    },
    {
      "section": "Safranrisotto",
      "text": "Tilsæt grøntsagsbouillonen lidt ad gangen, cirka 1 dl ad gangen, og rør, til risene er møre."
    },
    {
      "section": "Safranrisotto",
      "text": "Rør parmesan i til sidst, og smag til med citronskal, salt og peber."
    },
    {
      "section": "Gremolata",
      "text": "Bland persille, hvidløg og citronskal i en skål."
    },
    {
      "section": "Gremolata",
      "text": "Anret osso buco med risotto, og strø gremolata over."
    }
  ],
