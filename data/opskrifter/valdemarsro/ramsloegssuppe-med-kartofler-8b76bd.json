  "steps": [
    {
      "section": "Suppe",
      "text": "Rør løgene i olien i en gryde ved middel varme, til de er bløde."
    },
    {
      "section": "Suppe",
      "text": "Kom kartofler og fond i gryden, og lad det koge, til kartoflerne er møre."
    },
    {
      "section": "Suppe",
      "text": "Tilsæt ramsløg og fløde, og blend suppen, til den er glat og cremet."
    },
    {
      "section": "Suppe",
      "text": "Krydr med salt, peber, citronskal og lidt citronsaft."
    },
    {
      "section": "Ramsløgsolie",
      "text": "Blend ramsløg, olie, citronsaft og citronskal med en stavblender til en jævn grøn olie."
    },
    {
      "section": "Til servering",
      "text": "Hæld suppen op, og top med creme fraiche, et par dryp ramsløgsolie, pinjekerner og peber. Server brødet ved siden af."
    }
  ],
