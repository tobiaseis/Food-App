  "steps": [
    {
      "section": "Tomatsauce",
      "text": "Varm olien op i en stor gryde ved middelvarme. Svits løg og hvidløg, til de er blødt."
    },
    {
      "section": "Tomatsauce",
      "text": "Kom resten af saucens ingredienser i gryden, og rør rundt. Bring det i kog, og lad det simre i 30 minutter."
    },
    {
      "section": "Tomatsauce",
      "text": "Blend saucen glat, og smag den til med salt og peber."
    },
    {
      "section": "Kødboller",
      "text": "Ælt oksekød, persille, timian, parmesan og æg sammen til en fars. Form små kødboller af farsen."
    },
    {
      "section": "Kødboller",
      "text": "Bring bouillonen i kog i en anden gryde. Kog kødbollerne 1 minut i den, og løft dem op med en hulske."
    },
    {
      "section": "Kødboller",
      "text": "Læg kødbollerne ned i den varme tomatsauce, og lad dem simre med i 5 minutter."
    },
    {
      "section": "Servering",
      "text": "Anret spaghetti med sauce og kødboller. Top med parmesan og friske krydderurter, fx timianblade og hakket basilikum."
    }
  ],
