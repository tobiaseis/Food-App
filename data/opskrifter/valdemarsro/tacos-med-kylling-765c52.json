  "steps": [
    {
      "section": "Pulled chicken",
      "text": "Bland sød paprika, røget paprika, spidskommen, brun farin, hvidløg og sriracha til en marinade. Smag til med salt og peber."
    },
    {
      "section": "Pulled chicken",
      "text": "Vend kyllingebrysterne i marinaden, så de er dækket hele vejen rundt. Læg dem i en lufttæt beholder, og lad dem trække på køl i mindst 30 minutter – gerne natten over."
    },
    {
      "section": "Pulled chicken",
      "text": "Forvarm ovnen til 125 °C. Fordel smørret i en støbejernsgryde, så både bund og sider er dækket, og læg kyllingen i."
    },
    {
      "section": "Pulled chicken",
      "text": "Hæld fonden i gryden, sæt låg på, og lad kyllingen stege i ovnen i 3 timer."
    },
    {
      "section": "Pulled chicken",
      "text": "Tag kyllingen op, og pil den i tråde med to gafler."
    },
    {
      "section": "Mangosalsa",
      "text": "Kom mango, avocado, koriander og basilikum i en skål, og vend det forsigtigt sammen. Krydr med limesaft, limeskal, chili, salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Brun majsene i smør på en varm pande, til de er gyldne, og drys dem med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Varm tortillaerne på en tør pande. Server dem med kylling, mangosalsa, rucola og majs."
    }
  ],
  "changes": []
