  "steps": [
    {
      "section": "Cæsardressing",
      "text": "Blend ansjos, worcestershire sauce, parmesan og citronsaft til en jævn masse."
    },
    {
      "section": "Cæsardressing",
      "text": "Rør mayonnaise og creme fraiche ind, og smag dressingen til med citronskal, salt og peber."
    },
    {
      "section": "Tacos",
      "text": "Fordel hakket kylling i lige så mange portioner, som der er tortillas. Form hver portion til en flad, tynd bøf."
    },
    {
      "section": "Tacos",
      "text": "Pres kødet ud over en tortilla, så det dækker helt ud til kanten. Gør det samme med resten, og krydr kødet med salt og peber."
    },
    {
      "section": "Tacos",
      "text": "Varm olie op på en eller to store pander. Steg tortillaerne med kødsiden nedad i 1-2 minutter."
    },
    {
      "section": "Tacos",
      "text": "Vend tortillaerne, drys kødsiden med parmesan, og steg i 1 minut mere. Steg resten på samme måde."
    },
    {
      "section": "Tacos",
      "text": "Top tacoerne med romainesalat, parmesan og cæsardressing, og server dem med det samme."
    },
    {
      "section": "Til servering",
      "text": "Kog broccolibuketterne 1 minut i let saltet vand, og hæld vandet fra med det samme."
    },
    {
      "section": "Til servering",
      "text": "Server broccoli og agurkestave med resten af dressingen til at dyppe i."
    }
  ],
