  "steps": [
    {
      "section": "Boller",
      "text": "Varm mælken, til den er lunken, og hæld den i en skål. Rør gæren ud i den."
    },
    {
      "section": "Boller",
      "text": "Tilsæt honning, salt, kardemomme, æg, smør og to tredjedele af melet. Rør, gerne i røremaskine, til dejen er glat og ensartet."
    },
    {
      "section": "Boller",
      "text": "Ælt resten af melet i, til dejen er smidig og elastisk. Dæk skålen med et rent viskestykke, og lad dejen hæve i 2 timer."
    },
    {
      "section": "Boller",
      "text": "Del dejen i 20 stykker, rul dem til runde boller, og læg dem på en bageplade med bagepapir. Lad dem hæve i 1 time og 30 minutter."
    },
    {
      "section": "Boller",
      "text": "Varm ovnen op til 175 °C varmluft. Pisk ægget til pensling, pensl bollerne, og drys dem med sesamfrø."
    },
    {
      "section": "Boller",
      "text": "Bag bollerne i 12-14 minutter. Lad dem køle af på en rist. De kan fryses."
    },
    {
      "section": "Bøffer",
      "text": "Bland alle ingredienserne til bøfferne i en skål. Form 20 små bøffer."
    },
    {
      "section": "Bøffer",
      "text": "Brun bøfferne i olie og smør på en pande i 3-4 minutter på hver side. Læg et lille stykke cheddar på hver til sidst, hvis de skal være cheeseburgere."
    },
    {
      "section": "Samling",
      "text": "Del bollerne på midten. Læg salat, agurk, tomat, løgring, mayonnaise, ketchup, bacon, evt. smeltet cheddar og en bøf i hver."
    }
  ],
