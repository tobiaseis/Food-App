  "steps": [
    {
      "section": null,
      "text": "Forvarm ovnen til 175 °C varmluft. Smør et ovnfast fad med lidt olie."
    },
    {
      "section": null,
      "text": "Læg tomater, peberfrugt, løg og hvidløg i fadet. Dryp med olivenolie, og krydr med timian, rosmarin, fennikelfrø, salt og peber."
    },
    {
      "section": null,
      "text": "Bag grøntsagerne i ovnen i 30-40 minutter."
    },
    {
      "section": null,
      "text": "Kom de bagte grøntsager i en blender med fonden, og blend, til suppen er helt glat og cremet."
    },
    {
      "section": null,
      "text": "Smag suppen til med citronskal, lidt citronsaft, salt og peber."
    },
    {
      "section": null,
      "text": "Anrett suppen med creme fraiche og basilikum, og server den med det ristede brød."
