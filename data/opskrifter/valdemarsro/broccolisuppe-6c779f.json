  "steps": [
    {
      "section": "Suppe",
      "text": "Varm olien i en gryde ved middel varme, og steg løg og hvidløg, til løgene er bløde."
    },
    {
      "section": "Suppe",
      "text": "Kom kartoffeltern, timian og bouillon i gryden. Bring det i kog, læg låg på, og lad det simre i 15 minutter."
    },
    {
      "section": "Suppe",
      "text": "Læg broccolibuketterne i, og kog suppen videre i 5 minutter."
    },
    {
      "section": "Suppe",
      "text": "Blend suppen helt glat, rør fløden i, og smag den til med æblecidereddike, salt og peber. Blend den en gang til."
    },
    {
      "section": "Toppings",
      "text": "Rist græskarkernerne på en tør pande med olie og salt, til de begynder at poppe."
    },
    {
      "section": "Toppings",
      "text": "Rør æblecidereddike og honning sammen, og vend æbletern i blandingen."
    },
    {
      "section": "Toppings",
      "text": "Anret den varme suppe i skåle, og top med æbletern og de sprøde græskarkerner."
    }
  ],
