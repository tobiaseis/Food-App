  "steps": [
    {
      "section": "Grøntsager",
      "text": "Tænd ovnen på 180 °C varmluft. Smør et ovnfast fad."
    },
    {
      "section": "Grøntsager",
      "text": "Vend porre, spidskål og squash i fadet med fløde, fond, citronskal, citronsaft, salt og peber. Bag midt i ovnen i ca. 10 minutter."
    },
    {
      "section": "Sprød crunch",
      "text": "Blend persille, rasp, citronskal, salt og peber i en minihakker, til persillen er helt fin."
    },
    {
      "section": "Fisk og servering",
      "text": "Del torsken i pæne stykker og læg dem oven på de forbagte grøntsager. Fordel crunchen over fisken, og top hvert stykke med en klat smør."
    },
    {
      "section": "Fisk og servering",
      "text": "Bag fadet i yderligere 15 minutter, til torsken er færdig."
    },
    {
      "section": "Fisk og servering",
      "text": "Drys med hakket persille, og server med de nykogte kartofler."
    }
  ],
