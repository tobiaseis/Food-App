  "steps": [
    {
      "section": "Lasagnesauce",
      "text": "Varm olien op i en gryde ved middelvarme, og blød løgene i den."
    },
    {
      "section": "Lasagnesauce",
      "text": "Skru op for varmen, og rør champignonerne i. Steg dem under omrøring."
    },
    {
      "section": "Lasagnesauce",
      "text": "Tilsæt de resterende ingredienser til saucen. Lad det simre ved lav varme i mindst 1 time – jo længere, jo cremetere sauce. Rør ofte, og skvæt lidt ekstra bouillon i, hvis saucen bliver for tør. Smag til med salt og peber."
    },
    {
      "section": "Spinatfyld",
      "text": "Lav spinatfyldet, mens saucen er færdigsimret. Blød løg og hvidløg i olien på en pande."
    },
    {
      "section": "Spinatfyld",
      "text": "Kom den frosne spinat på panden, og varm op, til den er tøet. Hæld væden fra."
    },
    {
      "section": "Spinatfyld",
      "text": "Rør basilikum og fløde i. Smag til med muskatnød, salt og peber."
    },
    {
      "section": "Mornaysauce",
      "text": "Smelt smørret i en gryde, og pisk melet i, så det danner en klump."
    },
    {
      "section": "Mornaysauce",
      "text": "Hæld mælken i lidt ad gangen under konstant piskning, til saucen er glat uden meleklumper. Lad den koge igennem, og tilsæt evt. lidt mere mælk."
    },
    {
      "section": "Mornaysauce",
      "text": "Saucen skal være cremet, men stadig flydende. Rør så mozzarellaen i, til den er smeltet, og smag til med muskatnød, salt og peber."
    },
    {
      "section": "Samling",
      "text": "Smør et ovnfast fad, og fordel halvdelen af mornaysaucen i bunden."
    },
    {
      "section": "Samling",
      "text": "Læg lag på lag af lasagnesauce, spinatfyld og lasagneplader, til alt er brugt. Slut med resten af mornaysaucen øverst."
    },
    {
      "section": "Samling",
      "text": "Forvarm ovnen til 175 °C varmluft. Bag lasagnen i ca. 20-25 minutter, til pladerne er møre."
    }
  ],
  "changes": []
