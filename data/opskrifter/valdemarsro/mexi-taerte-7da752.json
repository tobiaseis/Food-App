  "steps": [
    {
      "section": "Tærtedej",
      "text": "Bland begge slags mel med saltet, og smuldr det kolde smør i. Det går også fint i en foodprocessor."
    },
    {
      "section": "Tærtedej",
      "text": "Ælt vandet i, til dejen samler sig. Lad den helst hvile på køl i 30 minutter."
    },
    {
      "section": "Tærtedej",
      "text": "Tryk dejen ud i en smurt tærteform på 28 cm i diameter, og prik bunden med en gaffel."
    },
    {
      "section": "Tærtedej",
      "text": "Forbag bunden i 10 minutter i ovnen, der er forvarmet til 175 °C varmluft."
    },
    {
      "section": "Krydret tomatkylling",
      "text": "Rist krydderierne et par minutter i en lille kasserolle ved middelvarme."
    },
    {
      "section": "Krydret tomatkylling",
      "text": "Tilsæt olie, hvidløg, tomater, selleri, squash og kylling. Lad det simre uden låg i 10 minutter."
    },
    {
      "section": "Krydret tomatkylling",
      "text": "Tag gryden af varmen, og lad blandingen køle lidt af. Hæld eventuel overskydende væske fra."
    },
    {
      "section": "Fyld",
      "text": "Pisk æg, hytteost, salt og peber sammen. Vend den lune tomatkylling, kidneybønnerne og majsen i."
    },
    {
      "section": "Fyld",
      "text": "Hæld fyldet i den forbagte tærtebund. Drys med cheddar og de knuste nachos."
    },
    {
      "section": "Fyld",
      "text": "Bag tærten i ca. 35 minutter ved 175 °C varmluft, til ægmassen er stivnet."
    },
    {
      "section": "Til servering",
      "text": "Anret tærten med sriracha, cremefraiche, chili, lime og koriander ved siden af."
    }
  ],
