  "steps": [
    {
      "section": null,
      "text": "Varm olivenolien i en gryde over middelvarme. Svits løget, til det er blankt og gennemsigtigt."
    },
    {
      "section": null,
      "text": "Kom hakkekødet i gryden og brun det, mens du rører rundt."
    },
    {
      "section": null,
      "text": "Tilsæt hvidløg, gulerødder, selleri, den revne squash, tomatpuré, hakkede tomater, oregano og timian. Rør det godt sammen."
    },
    {
      "section": null,
      "text": "Læg låg på og lad saucen simre i 1 time."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber, og justér krydderierne efter behov."
    },
    {
      "section": null,
      "text": "Skær imens de to squash i lange strimler som spaghetti."
    },
    {
      "section": null,
      "text": "Anret saucen over squashstrimlerne, eller vend den med kogt spaghetti."
    },
    {
      "section": null,
      "text": "Top med parmesan og friske krydderurter."
    }
