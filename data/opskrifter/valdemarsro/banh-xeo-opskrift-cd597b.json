  "steps": [
    {
      "section": "Dejen",
      "text": "Pisk æg, kokosmælk, vand, rismel, majsmel, fiskesauce, gurkemeje og salt sammen i en skål, så det bliver en tynd dej."
    },
    {
      "section": "Dejen",
      "text": "Rør forårsløgene i dejen, og stil den i køleskabet i en halv time."
    },
    {
      "section": "Dip",
      "text": "Bring vandet i kog, og rør sukkeret i, til det er opløst. Lad det køle helt af."
    },
    {
      "section": "Dip",
      "text": "Tilsæt fiskesauce, hvidløg og chili, og stil dippen til side."
    },
    {
      "section": "Stegning",
      "text": "Hæld lidt af kokosolien på en pande, og varm den godt op. Steg rejerne kort og hurtigt, og tag dem af panden."
    },
    {
      "section": "Stegning",
      "text": "Steg svinekødet hurtigt på begge sider, til det lige er gennemstegt. Læg det til side sammen med rejerne."
    },
    {
      "section": "Stegning",
      "text": "Kom lidt mere olie på panden, og læg nogle løgskiver på. Hæld en stor øse dej over, og drej panden, så dejen danner et helt tyndt lag."
    },
    {
      "section": "Stegning",
      "text": "Steg pandekagen sprød på undersiden, og vend den. Fordel lidt rejer, svinekød og bønnespirer på den, og fold den sammen til en halvmåne."
    },
    {
      "section": "Stegning",
      "text": "Steg, til pandekagen er sprød hele vejen igennem, og læg den på en rist. Gentag med resten af dejen."
    },
    {
      "section": "Servering",
      "text": "Anret pandekagerne med urter, mango, salat og rispapir. Stil en skål med vand frem, så rispapiret kan blødgøres."
    },
    {
      "section": "Servering",
      "text": "Riv en bid af pandekagen, og rul den ind i et blødt rispapir med urter, mango og evt. salat. Dyp rullen i dippen."
    }
  ],
  "changes": [
