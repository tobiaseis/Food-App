  "steps": [
    {
      "section": null,
      "text": "Kog risene, som det står på pakken. Lav imens marinaden og wasabidippen."
    },
    {
      "section": "Marinade til risene",
      "text": "Rør riseddike, sukker, ingefær og limesaft sammen."
    },
    {
      "section": "Wasabidip",
      "text": "Blend avocado, mayonnaise, wasabi, hvidløg, limesaft og limeskal med et skvæt soja og peber i en minihakker, til dippen er helt glat. Smag til."
    },
    {
      "section": null,
      "text": "Skær den frosne laks i meget tynde skiver."
    },
    {
      "section": null,
      "text": "Læg edamamebønnerne i en skål, og overhæld dem med kogende vand."
    },
    {
      "section": null,
      "text": "Vend marinaden i risene, mens de stadig er lune."
    },
    {
      "section": null,
      "text": "Fordel risene i 4 skåle. Læg edamamebønner, agurk, avocado, gulerod, tangsalat, noritang og laks ovenpå."
    },
    {
      "section": null,
      "text": "Top hver skål med en skefuld wasabidip og drys med sesamfrø. Server med limebåde og sojasauce til at dryppe over."
    }
  ],
