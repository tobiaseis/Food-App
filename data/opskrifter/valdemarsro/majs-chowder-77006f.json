  "steps": [
    {
      "section": "Suppe",
      "text": "Varm olien i en gryde og svits løg, hvidløg og gulerødder, til løgene er blanke og bløde."
    },
    {
      "section": "Suppe",
      "text": "Tilsæt majs, kartofler og chili, og rør rundt et par minutter ved middelvarme."
    },
    {
      "section": "Suppe",
      "text": "Hæld hvidvinen i og lad den koge lidt ind. Tilsæt bouillonen og bring det i kog."
    },
    {
      "section": "Suppe",
      "text": "Sæt låg på, og lad det simre i 12-15 minutter, til kartoflerne er møre."
    },
    {
      "section": "Suppe",
      "text": "Tag omtrent halvdelen af grøntsagerne op med en hulske, og blend dem med fløden til en glat, cremet masse. Smag til med salt og peber."
    },
    {
      "section": "Suppe",
      "text": "Rør den blendede masse ud i gryden igen. Smag til med salt, peber, en smule citronsaft og den fintrevne citronskal."
    },
    {
      "section": "Smørristede champignon og majs",
      "text": "Smelt smør på en pande, til det bruser og skummer."
    },
    {
      "section": "Smørristede champignon og majs",
      "text": "Steg champignon og majs, til svampene har fået en fin gylden skorpe. Smag til med timian, salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Hæld suppen i skåle, og top med de ristede champignon og majs. Drys med persille og lidt ekstra chili efter smag."
    }
  ],
  "changes": []
