  "steps": [
    {
      "section": null,
      "text": "Steg baconen i en bred sauterpande, til den netop er begyndt at tage farve. Løft den op på køkkenrulle, så fedtet kan sive af, og skær den i tynde strimler."
    },
    {
      "section": null,
      "text": "Sauter champignon og løg i olie i samme pande ved middelhøj varme, til løgene er bløde."
    },
    {
      "section": null,
      "text": "Tilsæt svinemørbraden og brun den på alle sider."
    },
    {
      "section": null,
      "text": "Kom pølser, chorizo, baconstrimler, begge slags paprika og vandet i panden, og rør rundt. Rør tomatpuré og hakkede tomater ned i retten."
    },
    {
      "section": null,
      "text": "Sæt låg på og lad gryden simre i ca. 15 minutter."
    },
    {
      "section": null,
      "text": "Tilsæt peberfrugten og rør fløden i. Bring det i kog, og smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Er saucen for tynd, så rør majsstivelsen ud i lidt koldt vand og pisk den ned i gryden. Lad den koge godt igennem bagefter."
    },
    {
      "section": null,
      "text": "Anret med de kogte ris og drys med persille."
    }
  ],
