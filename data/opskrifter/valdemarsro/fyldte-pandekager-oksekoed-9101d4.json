  "steps": [
    {
      "section": "Pandekager",
      "text": "Pisk æg, mælk og salt sammen med hvedemel og fuldkornsmel til en jævn dej."
    },
    {
      "section": "Pandekager",
      "text": "Varm en pande med smør eller lidt olie, og steg pandekagerne én ad gangen, til de er lysebrune på begge sider. Stil dem til side."
    },
    {
      "section": "Oksekødsfyld",
      "text": "Brun oksekødet i olie på en varm pande, mens du rører rundt."
    },
    {
      "section": "Oksekødsfyld",
      "text": "Sænk varmen, og tilsæt løg, hvidløg, spidskommen og koriander. Svits, til løgene er bløde."
    },
    {
      "section": "Oksekødsfyld",
      "text": "Rør gulerod, squash, tomater og majs ned i panden. Lad fylden simre uden låg i 5-10 minutter, og smag til med salt og peber."
    },
    {
      "section": "Avocadomos",
      "text": "Mos avocadoens kød med en gaffel på en tallerken. Smag til med limesaft, limeskal, spidskommen og salt."
    },
    {
      "section": "Til servering",
      "text": "Tænd ovnen på 200 °C varmluft."
    },
    {
      "section": "Til servering",
      "text": "Fordel fylden og lidt af cheddaren på pandekagerne, og rul dem sammen. Læg dem med samlingen nedad i et ovnfast fad, og drys resten af osten over."
    },
    {
      "section": "Til servering",
      "text": "Bag pandekagerne i ovnen i ca. 10 minutter. Drys med persille, og server med salat og avocadomos."
    }
  ],
