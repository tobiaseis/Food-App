  "steps": [
    {
      "section": "Kartoffelmos",
      "text": "Put kartoflerne i usaltet vand, og kog dem møre. Hæld vandet fra."
    },
    {
      "section": "Kartoffelmos",
      "text": "Mos kartoflerne i en skål med smørret. Pisk dem på laveste hastighed, og tilsæt mælk, til moset har den konsistens, du kan lide. Smag til med salt og peber."
    },
    {
      "section": "Millionbøf",
      "text": "Varm olien i en gryde, og svits løget, til det er blødt."
    },
    {
      "section": "Millionbøf",
      "text": "Tilsæt hakkekødet, og skru op for varmen. Rør rundt, til kødet er brunet."
    },
    {
      "section": "Millionbøf",
      "text": "Kom gulerødder, squash, timian, paprika, tomatpuré, bouillon og laurbærblade i gryden, og rør godt rundt. Læg låg på, og lad retten simre i 15 minutter."
    },
    {
      "section": "Millionbøf",
      "text": "Rør majsstivelsen ud i det kolde vand, og jævn sovsen med blandingen. Tilsæt kulør efter behov, så farven bliver pæn, og smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Anret millionbøffen med kartoffelmos og syltede rødbeder, og drys med persille."
    }
  ],
