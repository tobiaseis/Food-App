  "steps": [
    {
      "section": "Sur-sødsauce",
      "text": "Pisk alle ingredienserne til saucen sammen i en gryde. Bring det i kog, og lad det simre et par minutter, til saucen er lidt tykkere."
    },
    {
      "section": "Sur-sødsauce",
      "text": "Tag gryden af varmen, og lad saucen køle af."
    },
    {
      "section": "Nudelsalat",
      "text": "Kog nudlerne efter anvisningen på pakken. Kom edamamebønnerne i til nudlerne i det sidste minut af kogetiden."
    },
    {
      "section": "Nudelsalat",
      "text": "Si nudler og bønner med det samme, og skyl dem med iskoldt vand, så de ikke bliver ved med at koge og klistrer sammen."
    },
    {
      "section": "Nudelsalat",
      "text": "Vend nudler og bønner med halvdelen af saucen."
    },
    {
      "section": "Nudelsalat",
      "text": "Læg gulerødder og spidskål i bunden af en stor skål, og top med nudler og bønner."
    },
    {
      "section": "Nudelsalat",
      "text": "Fordel sukkerærter, forårsløg, ananas og avocado ovenpå, og dryp med resten af saucen."
    },
    {
      "section": "Nudelsalat",
      "text": "Hak koriander og peanuts, og drys dem sammen med sesamfrøene over salaten lige før servering."
    }
  ],
