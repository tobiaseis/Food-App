  "steps": [
    {
      "section": "Ris",
      "text": "Kog risene efter anvisningen på pakken. Lav kylling og grøntsager, mens risene koger."
    },
    {
      "section": "Teriyakikylling",
      "text": "Rør teriyakisauce, sojasauce, hvidløg, brun farin, ingefær, riseddike og vand sammen i en skål. Sigt majsstivelsen ned i og pisk, til marinaden er glat."
    },
    {
      "section": "Teriyakikylling",
      "text": "Varm olien op på en pande ved høj varme. Brun kyllingen i 3-4 minutter, til alle sider har fået farve."
    },
    {
      "section": "Teriyakikylling",
      "text": "Skru ned på lav varme, og hæld marinaden på panden. Lad kyllingen simre i 10 minutter, og vend den jævnligt, til den er gylden og helt gennemstegt."
    },
    {
      "section": "Grøntsager",
      "text": "Bring letsaltet vand i kog i en gryde. Kog broccolien i 1 minut, tilsæt edamamebønnerne, rør rundt, og si straks alt vandet fra."
    },
    {
      "section": "Servering",
      "text": "Fordel ris, broccoli, edamamebønner og kylling i dybe tallerkener. Strø sesamfrø og forårsløg over, og server med limebådene til at presse over."
    }
  ],
