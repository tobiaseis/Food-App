  "steps": [
    {
      "section": null,
      "text": "Varm ovnen op til 200 °C varmluft. Smør et ovnfast fad."
    },
    {
      "section": null,
      "text": "Læg kartofler, porre og løg i fadet. Pisk fond, fløde, rosmarin og olie sammen med salt og peber, og hæld det over grøntsagerne."
    },
    {
      "section": null,
      "text": "Bag fadet i 45 minutter."
    },
    {
      "section": null,
      "text": "Tag fadet ud, strø tomaterne ovenpå, og bag i 10 minutter mere."
    },
    {
      "section": null,
      "text": "Del torsken i portionsstykker, og peber dem. Pak hvert stykke ind i parmaskinke."
    },
    {
      "section": null,
      "text": "Læg torskepakkerne ned i fadet, og bag i ca. 12 minutter, til fisken lige er mør."
    },
    {
      "section": null,
      "text": "Lad fadet stå i 2 minutter, og drys med rucola."
    },
    {
      "section": "Til urtedressingen",
      "text": "Hak urterne. Rør creme fraiche og mayonnaise sammen, og vend urterne i."
    },
    {
      "section": "Til urtedressingen",
      "text": "Smag til med lidt revet citronskal, et skvæt citronsaft, salt og peber. Server dressingen til retten."
    }
  ],
