  "steps": [
    {
      "section": "Farsen",
      "text": "Bland lammekød, løg, hvidløg, æg, pinjekerner, persille, chiliflager, spidskommen og bulgur i en skål. Smag til med salt og peber."
    },
    {
      "section": "Squash",
      "text": "Skær squashen over på langs, og del den i to halvdele. Skrab det bløde kødfulde indre ud med en ske, så der dannes en skål i hver halvdel."
    },
    {
      "section": "Squash",
      "text": "Fordel farsen i squashhalvdelene. Sæt dem i en bradepande med bagepapir eller i et fedtet ovnfast fad."
    },
    {
      "section": "Squash",
      "text": "Bag i ovnen ved 175 °C i cirka 20 minutter."
    },
    {
      "section": "Til servering",
      "text": "Pisk tahin og yoghurt sammen. Hæld dressingen over de bagte squash, og top med persille, granatæblekerner og pinjekerner."
    }
  ],
