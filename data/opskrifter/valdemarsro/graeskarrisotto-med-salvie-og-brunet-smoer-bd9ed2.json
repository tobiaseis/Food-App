  "steps": [
    {
      "section": "Brunet smør med salvie",
      "text": "Smelt smørret på en pande, til det holder op med at bruse. Skru ned på laveste varme, og læg salvieblade fra stilkene i smørret."
    },
    {
      "section": "Brunet smør med salvie",
      "text": "Rør i smørret en gang imellem i 10-15 minutter, til det er gyldenbrunt og dufter nøddeagtigt, og salvien er sprød. Tag panden af varmen."
    },
    {
      "section": "Græskarrisotto",
      "text": "Kog græskartern i letsaltet vand i 15-20 minutter, til de er helt møre. Si vandet fra, og blend græsset til en helt glat puré."
    },
    {
      "section": "Græskarrisotto",
      "text": "Varm smørret til stegning i en gryde, og svits løg og hvidløg, til løget er blødt og klart. Vend risene i, og rør dem godt rundt i fedtstoffet."
    },
    {
      "section": "Græskarrisotto",
      "text": "Hæld hvidvinen i, og rør, til risene har optaget den. Tilsæt derefter bouillonen lidt ad gangen under omrøring, til risene lige er møre, og risottoen er cremet."
    },
    {
      "section": "Græskarrisotto",
      "text": "Vend græskarpuréen og den fintrevne parmesan i. Smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Anret risottoen på tallerkener, og top med pinjekerner, sprød salvie, brunet smør og friskrevet parmesan."
    }
  ],
  "changes": []
