  "steps": [
    {
      "section": "Marinade",
      "text": "Bland ingefær, appelsinsaft, sød chilisauce, sojasauce, nellike, kanel og sesamolie til en marinade."
    },
    {
      "section": "Marinade",
      "text": "Vend kyllingen i marinaden, og lad den trække i mindst 15 minutter. Den smager endnu bedre, hvis den står hele dagen."
    },
    {
      "section": "Sesamris",
      "text": "Kog risene i let saltet vand efter anvisningen på pakken."
    },
    {
      "section": "Sesamris",
      "text": "Vend de varme ris med sesamfrø og peber, og drys sesamolie over. Læg låg på gryden, så risene holder varmen."
    },
    {
      "section": "Kylling",
      "text": "Varm lidt olie op på en pande, mens risene koger."
    },
    {
      "section": "Kylling",
      "text": "Løft kyllingen op af marinaden, og brun den ved høj varme, til den er gyldenbrun."
    },
    {
      "section": "Kylling",
      "text": "Hæld resten af marinaden på panden, og lad kyllingen simre, til den er helt gennemstegt."
    },
    {
      "section": "Kylling",
      "text": "Vend spinaten i, og lad den falde sammen. Læg til sidst appelsinbådene på panden, så de bliver varme."
    },
    {
      "section": "Servering",
      "text": "Anret sesamris og kylling på tallerkener eller i skåle. Top med forårsløg og lidt flere ristede sesamfrø."
    }
  ],
