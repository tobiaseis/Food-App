  "steps": [
    {
      "section": "Stracciatella",
      "text": "Riv mozzarellaen i små stykker i en skål. Rør fløden i sammen med salt og peber."
    },
    {
      "section": "Stracciatella",
      "text": "Dæk skålen og lad den stå på bordet i 30 minutter. Rør rundt og smag til igen."
    },
    {
      "section": "Stracciatella",
      "text": "Stil skålen i køleskabet i mindst 1 time. Den kan holde sig op til 2 dage."
    },
    {
      "section": "Pesto",
      "text": "Rist pinjekernerne til pestoen på en tør pande, mens du rører, til de er gyldne."
    },
    {
      "section": "Pesto",
      "text": "Blend basilikum, hvidløg, parmesan, de ristede pinjekerner og olivenolie, til det er fint hakket. Smag til med salt og peber, og tilsæt lidt mere olie, hvis pestoen skal være tyndere."
    },
    {
      "section": "Bagte tomater",
      "text": "Tænd ovnen på 180 °C varmluft. Bland olie, hvidløg, rosmarin, timian, salt og peber i en stor skål."
    },
    {
      "section": "Bagte tomater",
      "text": "Vend rødløg og tomater rundt i marinaden, og læg dem på en bradepande med bagepapir."
    },
    {
      "section": "Bagte tomater",
      "text": "Bag i ca. 20 minutter."
    },
    {
      "section": "Til lasagnen",
      "text": "Skær lasagnepladerne i stykker på ca. 25 cm."
    },
    {
      "section": "Til lasagnen",
      "text": "Kog dem i letsaltet vand, så længe der står på pakken. Løft dem op og lad vandet løbe af."
    },
    {
      "section": "Til lasagnen",
      "text": "Byg lasagnen på hver tallerken i lag: pasta, stracciatella, pesto, bagte tomater og løg, rucola."
    },
    {
      "section": "Til lasagnen",
      "text": "Top med pinjekerner, nogle af tomaterne, striber af balsamico glace, basilikum, parmesan og peber."
    }
  ],
