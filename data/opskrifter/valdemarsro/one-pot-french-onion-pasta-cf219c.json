  "steps": [
    {
      "section": null,
      "text": "Varm smør og olie op i en stor gryde ved middellav varme. Svits løgene i 30 minutter, og rør ofte, til de er møre, bløde og let karamelliserede."
    },
    {
      "section": null,
      "text": "Rør hvidløg, timian, hvidvin, pasta, bouillon og fløde i. Rør rundt i 5 minutter, sæt låg på, og bring det i kog."
    },
    {
      "section": null,
      "text": "Lad retten koge i ca. 10 minutter, til pastaen er helt mør. Krydr med salt, peber og balsamico."
    },
    {
      "section": null,
      "text": "Vend osten i, og rør, til den er smeltet, og saucen er jævn."
    },
    {
      "section": null,
      "text": "Server med det samme, og drys med persille og lidt friskkværnet peber."
    }
  ],
