  "steps": [
    {
      "section": "Pico de gallo",
      "text": "Bland tomat, agurk, rødløg, chili, hvidløg, koriander, limesaft og lidt limeskal i en stor skål. Start med halvdelen af chilien."
    },
    {
      "section": "Pico de gallo",
      "text": "Smag til med resten af chilien, mere limesaft og limeskal samt salt og peber."
    },
    {
      "section": "Taquitos",
      "text": "Svits løg og hvidløg i lidt af olien på en pande, til løgene er møre. Tilsæt oregano, paprika og spidskommen, og varm det godt igennem."
    },
    {
      "section": "Taquitos",
      "text": "Træk panden af varmen. Rør tomatpuré, jalapeños og flødeost i."
    },
    {
      "section": "Taquitos",
      "text": "Kør kikærterne kort i en minihakker, så de bliver groft hakket. Vend dem i fyldet, og smag til med salt og peber."
    },
    {
      "section": "Taquitos",
      "text": "Opvarm tortillaerne på en tør pande, til de er bløde og smidige. Pensl dem med olie på begge sider."
    },
    {
      "section": "Taquitos",
      "text": "Fordel kikærtefyld og cheddar i en stribe midt på hver tortilla. Slå siderne ind over fyldet, og rul tortillaen stramt."
    },
    {
      "section": "Taquitos",
      "text": "Læg rullerne med samlingen nedad på en bageplade med bagepapir."
    },
    {
      "section": "Taquitos",
      "text": "Bag dem ved 225 °C varmluft i 5-7 minutter i en forvarmet ovn. Vend dem, og bag 5 minutter mere, til osten er smeltet, og de er sprøde."
    },
    {
      "section": "Grøn chilidip",
      "text": "Blend jalapeños, koriander, feta, limesaft, limeskal og creme fraiche glat i en foodprocessor. Smag til med salt, peber og eventuelt mere limesaft."
    },
    {
      "section": null,
      "text": "Server taquitos med pico de gallo og chilidip."
    }
  ],
