  "steps": [
    {
      "section": "Farsen",
      "text": "Kom alt til farsen i en stor skål, og pisk det med håndmikser i 3 minutter, til det er godt blandet."
    },
    {
      "section": "Farsen",
      "text": "Form farsen til et brød midt i et stort fad. Der skal være plads til rodfrugterne langs siderne."
    },
    {
      "section": "Toppen og fadet",
      "text": "Forvarm ovnen til 180 °C varmluft."
    },
    {
      "section": "Toppen og fadet",
      "text": "Strø rasp over farsbrødet, og dæk det helt med baconskiverne."
    },
    {
      "section": "Toppen og fadet",
      "text": "Fordel rødbeder, gulerødder og kartofler på begge sider af farsbrødet, og drys dem med den hakkede timian."
    },
    {
      "section": "Bagning",
      "text": "Bag i ca. 1 time. Tiden varierer fra ovn til ovn, så mål kernetemperaturen: Den skal være ca. 75 °C."
    },
    {
      "section": "Bagning",
      "text": "Vend rodfrugterne et par gange under bagningen."
    },
    {
      "section": "Bagning",
      "text": "Server med lidt frisk timian drysset over."
    }
  ],
  "changes": []
