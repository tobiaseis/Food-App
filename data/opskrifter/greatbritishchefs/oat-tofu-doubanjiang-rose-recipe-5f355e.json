  "steps": [
    {
      "section": "Tofuen",
      "text": "Kom alle ingredienserne til tofuen i en Thermomix. Kør på hastighed 3,5, og varm blandingen op til 100 °C."
    },
    {
      "section": "Tofuen",
      "text": "Tag låget af, så snart blandingen har ramt 100 °C, og sænk temperaturen til 70 °C."
    },
    {
      "section": "Tofuen",
      "text": "Når massen er 70 °C og helt ensartet, fordeles den i otte runde forme på ca. 3 cm i diameter. Sæt formene i fryseren natten over."
    },
    {
      "section": "Tofuen",
      "text": "Hæld resten af massen i større beholdere og lad den sætte sig. Den kan bruges i andre retter."
    },
    {
      "section": "Saucen",
      "text": "Blend alle ingredienserne til saucen i en krydderikværn eller en lille blender, til den er helt glat."
    },
    {
      "section": "Servering",
      "text": "Læg en portion frossen tofu på en tallerken, og lad den tø i 45 minutter. Vælg en tallerken, der er nem at gøre ren, for tofuen afgiver lidt vand, når den tør op."
    },
    {
      "section": "Servering",
      "text": "Tør vandet af tallerkenen. Hæld saucen rundt om tofuen, og dryp en teskefuld sesamolie over."
    },
    {
      "section": "Servering",
      "text": "Drys med sesamfrø, og pynt til sidst med urter og blomster."
    }
  ],
  "changes": [
    "Double cream er skiftet til piskefløde.",
    "La-Yu chiliolie er skiftet til almindelig chiliolie."
  ]
