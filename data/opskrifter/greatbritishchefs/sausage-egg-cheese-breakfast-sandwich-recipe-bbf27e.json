  "steps": [
    {
      "section": null,
      "text": "Bland svinekødet med salvie, timian, salt og peber, og ælt det godt sammen. Form fire runde bøffer."
    },
    {
      "section": null,
      "text": "Varm lidt olie på en pande, og steg bøfferne i cirka 5 minutter på hver side, til de er gennemstegte. Tag dem af panden."
    },
    {
      "section": null,
      "text": "Steg baconen sprød på en pande med en smule olie."
    },
    {
      "section": null,
      "text": "Pochér æggene i letkogende vand i 4 minutter, til de lige er stivnet."
    },
    {
      "section": null,
      "text": "Rør smør og purløg sammen, og pensl blandingen på de ristede bollehalvdele."
    },
    {
      "section": null,
      "text": "Læg ost, æg, pølsebøf og bacon i lag på bunden af hver bolle, og top evt. med tabasco. Læg låget på."
    },
    {
      "section": null,
      "text": "Lad sandwichene hvile i nogle minutter, gerne pakket ind i folie, så osten når at smelte og smagene trækker sammen."
    }
  ],
