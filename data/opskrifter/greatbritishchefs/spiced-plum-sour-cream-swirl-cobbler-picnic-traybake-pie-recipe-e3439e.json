  "steps": [
    {
      "section": "Fyld",
      "text": "Tænd ovnen på 200 °C (180 °C varmluft)."
    },
    {
      "section": "Fyld",
      "text": "Vend blommeskiverne med farin, kanel, ingefær, appelsinskal, appelsinsaft og majsstivelse."
    },
    {
      "section": "Fyld",
      "text": "Fordel blommerne på en bageplade og steg dem i 20 minutter, til de er bløde og sirupsagtige. Lad dem køle af."
    },
    {
      "section": "Swirl",
      "text": "Pisk creme fraiche, lønnesirup, æggeblomme og vanilje glat sammen. Sæt det på køl."
    },
    {
      "section": "Tærten",
      "text": "Skru ovnen ned til 180 °C (160 °C varmluft). Beklæd en form på ca. 20 × 30 cm med bagepapir."
    },
    {
      "section": "Tærten",
      "text": "Læg to butterdejsplader, så de overlapper hinanden med nogle få centimeter, og pres dem sammen. Brug lidt vand, hvis de ikke vil hænge sammen."
    },
    {
      "section": "Tærten",
      "text": "Rul den samlede dejplade ud på et meldrysset bord, til den er ca. 3 mm tyk og stor nok til at dække både bund og sider. Pres den ned i formen."
    },
    {
      "section": "Tærten",
      "text": "Drys de malede mandler over bunden. Fordel halvdelen af blommerne ovenpå, og træk halvdelen af creme fraiche-blandingen igennem i swirls. Gentag med resten af blommer og creme."
    },
    {
      "section": "Tærten",
      "text": "Tag nogle få spsk af de piskede æg fra til pensling. Hæld resten forsigtigt over fyldet."
    },
    {
      "section": "Tærten",
      "text": "Læg den sidste dejplade over som låg, og klem kanterne sammen. Pensl med det afsatte æg, drys med farin og rids dejen let med en kniv."
    },
    {
      "section": "Tærten",
      "text": "Bag tærten i 1 time og 20 minutter, til den er hævet og gylden. Lad den køle helt af, før du skærer den ud."
    },
    {
      "section": "Krydret flødeskum",
      "text": "Pisk fløde, lønnesirup, ingefær og kanel til bløde toppe, lige før servering."
    },
    {
      "section": "Bærsalat",
      "text": "Vend bærrene forsigtigt med citronsaft og honning. Bland de ristede havregryn i lige før servering."
    }
  ],
