  "steps": [
    {
      "section": "Confiterede andelår",
      "text": "Gnid andelårene godt ind i salt og peber. Læg dem i en stor gryde sammen med hvidløg, timian og rosmarin."
    },
    {
      "section": "Confiterede andelår",
      "text": "Hæld andefedtet over, så kødet er helt dækket. Læg låg på og lad lårene simre ved svag varme i ca. 3 timer, til kødet falder fra benet."
    },
    {
      "section": "Chilihonning",
      "text": "Varm honning, chiliflager og timianblade forsigtigt op i en lille gryde, og lad det småkoge få minutter. Stil det til side og lad det køle af."
    },
    {
      "section": "Vafler",
      "text": "Tænd ovnen på 200 °C."
    },
    {
      "section": "Vafler",
      "text": "Rør æggeblommen sammen med mel, bagepulver og en god knivspids salt i en stor skål. Tilsæt farin, og pisk mælken i. Pisk derefter smør og sennep ned i dejen."
    },
    {
      "section": "Vafler",
      "text": "Pisk æggehviden til bløde toppe, og vend den forsigtigt i dejen."
    },
    {
      "section": "Vafler",
      "text": "Varm vaffeljernet op efter producentens anvisning, og pensl det med lidt olie. Hæld så meget dej i, at bunden lige dækkes, luk jernet og bag vaflen færdig efter anvisningen. Gentag med resten af dejen."
    },
    {
      "section": "Servering",
      "text": "Tag andelårene op af fedtet og læg dem på en bageplade med bagepapir. Bag dem i ovnen i ca. 10 minutter, til skindet er sprødt."
    },
    {
      "section": "Servering",
      "text": "Steg to spejlæg i varm olie, så de bliver, som du bedst kan lide dem."
    },
    {
      "section": "Servering",
      "text": "Anret vaflerne med et sprødt andelår og et spejlæg på hver, og hæld rigeligt chilihonning over."
    }
  ],
