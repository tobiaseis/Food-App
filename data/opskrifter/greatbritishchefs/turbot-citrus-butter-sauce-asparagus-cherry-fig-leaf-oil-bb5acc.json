  "steps": [
    {
      "section": "Figenbladsolie",
      "text": "Varm olien op til 80 °C."
    },
    {
      "section": "Figenbladsolie",
      "text": "Blend figenblade, den varme olie og salt i en Thermomix i 8 minutter ved 80 °C."
    },
    {
      "section": "Figenbladsolie",
      "text": "Si olien gennem en osteklæde og stil den på køl."
    },
    {
      "section": "Syltede rosenblade",
      "text": "Rør eddike, vand og sukker sammen i en gryde, og varm det op, til sukkeret er opløst."
    },
    {
      "section": "Syltede rosenblade",
      "text": "Lad lagen køle af, hæld den over rosenbladene, og lad dem stå og køle helt af."
    },
    {
      "section": "Pighvar",
      "text": "Pisk saltet ud i vandet, til det er helt opløst, og læg kombuen i."
    },
    {
      "section": "Pighvar",
      "text": "Læg pighvarfileterne i saltlagen i 30 minutter."
    },
    {
      "section": "Pighvar",
      "text": "Blend fiskeafskæringen helt glat. Tilsæt fløde og æggehvider, og blend igen, til massen er jævn."
    },
    {
      "section": "Pighvar",
      "text": "Pres mousseen gennem en fin sigte, og fyld den i en sprøjtepose."
    },
    {
      "section": "Pighvar",
      "text": "Rør timian og citronskal i mousseen, og smag til med salt."
    },
    {
      "section": "Pighvar",
      "text": "Skær hver pighvarfilet op som en bog. Sprøjt mousse ind i midten, og fold fileten sammen om fyldet."
    },
    {
      "section": "Pighvar",
      "text": "Vakuumpak fisken, og tilbered den sous-vide ved 55 °C i 8 minutter."
    },
    {
      "section": "Citronsmørsauce",
      "text": "Kog fløde og citronsaft ind, til det tykner. Pisk smørret i, så saucen emulgerer."
    },
    {
      "section": "Citronsmørsauce",
      "text": "Vend både de hvide og de grønne asparges samt de friske kirsebær i saucen. Rør derefter de afdryppede rosenblade i, og tilsæt en smule figenbladsolie."
    },
    {
      "section": "Citronsmørsauce",
      "text": "Anret saucen på tallerkenerne, og læg en portion pighvar ovenpå."
    }
  ],
  "changes": [
    "Citrontimian er skiftet til almindelig timian."
  ]
}
