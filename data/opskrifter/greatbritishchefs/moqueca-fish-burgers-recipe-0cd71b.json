  "steps": [
    {
      "section": "Fisken",
      "text": "Læg torskestykkerne i et højsidet ovnfast fad på ca. 30 × 23 cm. Vend dem med olie og salt, så de er dækket hele vejen rundt."
    },
    {
      "section": "Moquecasauce",
      "text": "Kom alle ingredienser til saucen i en blender, og blend den helt glat."
    },
    {
      "section": "Moquecasauce",
      "text": "Hæld saucen over fisken, og vend stykkerne, så de er dækket af sauce. Lad fadet stå ved stuetemperatur og marinere i 30 minutter til 1 time."
    },
    {
      "section": "Fisken",
      "text": "Tænd ovnen på 240 °C varmluft (eller så varm, som den kan blive). Sæt fadet ind, når ovnen er varm, og bag i 30 minutter, til saucen bobler og er kogt ind og tyknet. Tag fadet ud, og lad det køle lidt af."
    },
    {
      "section": "Coleslaw",
      "text": "Rør alle ingredienserne til coleslawen sammen i en skål."
    },
    {
      "section": "Samling",
      "text": "Del burgerbollerne, og rist skæresiderne i en meget varm pande, til de er gyldne."
    },
    {
      "section": "Samling",
      "text": "Læg et stykke fisk på hver bolleunderdel, og kom rigeligt sauce ovenpå. Fordel en god portion coleslaw over, og læg toppen på."
    },
    {
      "section": "Samling",
      "text": "Server straks med en skål sauce til dypning og lidt ekstra lime ved siden af."
    }
  ],
  "changes": [
