  "steps": [
    {
      "section": "Chorizosmør og drys",
      "text": "Kom chorizo og det usaltede smør i en pande ved middel varme. Steg stille og roligt, til fedtet er smeltet ud, og chorizoen er sprød."
    },
    {
      "section": "Chorizosmør og drys",
      "text": "Si smørret over i en skål, og tryk chorizoen godt, så al smagen kommer med. Hold smørret varmt, og gem chorizoen for sig."
    },
    {
      "section": "Chorizosmør og drys",
      "text": "Varm olivenolien til drysset i en anden pande ved middel varme. Kom mandler, græskarkerner, solsikkekerner, panko og salt i, og steg, til det er gyldent, duftende og sprødt."
    },
    {
      "section": "Chorizosmør og drys",
      "text": "Vend den sprøde chorizo i drysset, og tag panden af varmen."
    },
    {
      "section": "Hollandaise",
      "text": "Sæt en varmefast skål over en gryde med vand, der småkoger svagt. Pisk æggeblommer, eddike og sennep, til blandingen tykner en smule."
    },
    {
      "section": "Hollandaise",
      "text": "Hæld det varme chorizosmør i en tynd stråle, mens du pisker hele tiden, så saucen bindes. Bliver den for tyk, så tynd den ud med et par skefulde varmt vand."
    },
    {
      "section": "Hollandaise",
      "text": "Smag til med citronsaft og salt, og hold saucen varm."
    },
    {
      "section": "Asparges",
      "text": "Kom aspargesene og det saltede smør i en pande med låg ved middel varme. Steg dem forsigtigt, til de er let gyldne og begynder at blive møre."
    },
    {
      "section": "Asparges",
      "text": "Tilsæt et skvæt vand, læg låg på, og damp i et par minutter, til de lige er møre. Tag dem af panden, og hold dem varme."
    },
    {
      "section": "Æg og brød",
      "text": "Bring en gryde vand i kog og skru ned, så det kun småsimrer. Hæld eddiken i."
    },
    {
      "section": "Æg og brød",
      "text": "Slå ægget ud i en lille skål ad gangen, og lad det glide forsigtigt ned i vandet. Pochér i 2½-3 minutter, til hviderne er stivnet, og blommerne stadig er bløde. Tag æggene op med en hulske, og lad dem løbe af på køkkenrulle."
    },
    {
      "section": "Æg og brød",
      "text": "Dryp brødskiverne med lidt olivenolie, og rist dem under en varm grill, til de er gyldne og sprøde."
    },
    {
      "section": "Anretning",
      "text": "Skær brødet over, og læg det med aspargesene på tallerkener. Læg æggene ovenpå, og kom den varme chorizohollandaise over."
    },
    {
      "section": "Anretning",
      "text": "Drys med chorizodrysset, purløg og lidt sort peber."
    }
  ],
