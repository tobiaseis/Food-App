  "steps": [
    {
      "section": "Oliven- og citronmarmelade",
      "text": "Kom alle ingredienserne til marmeladen i en gryde. Varm op til en let simren, og rør, til sukkeret er opløst."
    },
    {
      "section": "Oliven- og citronmarmelade",
      "text": "Lad det simre på lav varme i ca. 30 minutter, til olivenerne er bløde og klæbrige af sukker."
    },
    {
      "section": "Fyld",
      "text": "Imens: Steg chorizoen på en pande ved middelhøj varme, til den er gennemstegt."
    },
    {
      "section": "Fyld",
      "text": "Kom oliven, skalotteløg, selleri, dild, cornichoner og hvidløg på panden. Svits, til det er blødt. Tilsæt hvidvinen, og lad den koge ind til det halve."
    },
    {
      "section": "Fyld",
      "text": "Hæld fiskefond, persille, asparges, rasp og salt på panden. Lad blandingen koge, til den tykner og er tør. Tilsæt lidt mere rasp, hvis den er for våd. Stil fyldet til side."
    },
    {
      "section": "Makrel",
      "text": "Skær hoved og finner af makrellerne. Læg fisken på et skærebræt, og snit bugen op mod hovedet. Fjern indvolde, og skyl fisken grundigt for blod."
    },
    {
      "section": "Makrel",
      "text": "Skær fra hovedenden langs bugen for at løsne den ene side af fileten. Vend fisken, og gør det samme på den anden side. Skær langs rygraden, så filet-sidderne hænger sammen som en sommerfugl. Pil ribben og mellemgræder af efter behov. Gør det samme med den anden makrel."
    },
    {
      "section": "Makrel",
      "text": "Fyld makrellerne med fyldet, og bind dem tæt med køkkengarn. Sørg for, at begge ender er lukkede."
    },
    {
      "section": "Kapersdressing",
      "text": "Rør alle ingredienserne til dressingen sammen, og smag til med salt og peber."
    },
    {
      "section": "Makrel",
      "text": "Hæld lidt olie på en pande. Krydr makrellerne med salt og peber, og steg dem et par minutter på hver side."
    },
    {
      "section": "Makrel",
      "text": "Skru lidt ned for varmen, og kom smør, citronsaft, persille og hvidløg på panden. Øs smørret over fisken i nogle minutter, til den er gennemstegt. Tag panden af varmen."
    },
    {
      "section": "Til servering",
      "text": "Læg de bundne makreller på et fad sammen med karse, citronbåde og marmeladen. Hæld rigeligt af kapersdressingen over, og drys med persille."
    }
  ],
  "changes": [
    "Glasurt er erstattet med asparges.",
    "Vegetable oil er erstattet med rapsolie."
  ]
}
