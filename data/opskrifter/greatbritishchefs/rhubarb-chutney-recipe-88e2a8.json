  "steps": [
    {
      "section": null,
      "text": "Kom alle ingredienserne i en stor gryde og bring det langsomt i let kog. Rør godt rundt."
    },
    {
      "section": null,
      "text": "Lad chutneyen simre ved middel-lav varme i ca. 1 time. Rør i den en gang imellem."
    },
    {
      "section": null,
      "text": "Lad den køle af, og fyld den derefter på en eller flere rene bøtter eller glas. Den holder sig op til en måned i køleskabet."
    }
