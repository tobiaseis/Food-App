  "steps": [
    {
      "section": "Marinade",
      "text": "Pisk hoisinsauce, øl, eddike, sojasauce og sennep sammen i en stor skål, til massen er helt glat. Rør løg, hvidløg og peber i."
    },
    {
      "section": "Marinade",
      "text": "Læg skinkesteaksene i marinaden, så de er helt dækket. Lad dem trække mindst 6 timer – gerne natten over i køleskabet."
    },
    {
      "section": "Stegning",
      "text": "Tag steaksene op af marinaden, og lad dem stå ved stuetemperatur i mindst en time."
    },
    {
      "section": "Stegning",
      "text": "Steg dem på en varm pande, til de er gyldne og karamelliserede, og kernetemperaturen er 60 °C (medium)."
    },
    {
      "section": "Stegning",
      "text": "Stil steaksene et lunt sted, så kødet kan hvile."
    },
    {
      "section": "Pommes frites og æg",
      "text": "Tilbered pommes frites, og drys dem med svampekrydderi efter smag."
    },
    {
      "section": "Pommes frites og æg",
      "text": "Slå æggene ud på en varm pande med lidt smør, og steg dem, til bunden er sprød."
    },
    {
      "section": "Anretning",
      "text": "Skær steaksene i tykke skiver. Læg spejlæg ovenpå, og server pommes frites ved siden af."
    },
    {
      "section": "Anretning",
      "text": "Dryp chiliolie over æggene, og top med forårsløg og koriander."
    }
  ],
