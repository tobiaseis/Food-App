  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 160 °C varmluft. Beklæd en brødform på 900 g med bagepapir."
    },
    {
      "section": null,
      "text": "Pisk æbler, olie, brun farin, sukker, æg og vaniljepasta sammen i en skål, til det er glat."
    },
    {
      "section": null,
      "text": "Vend hvedemel, bagepulver, kanel, salt og det meste af hasselnødderne i dejen med piskeriset."
    },
    {
      "section": null,
      "text": "Hæld dejen i formen og glat overfladen ud. Læg æbleskiverne ovenpå, og strø resten af hasselnødderne over."
    },
    {
      "section": null,
      "text": "Bag brødet i 50-55 minutter, til det er gyldent, og en pind kommer ren op af midten."
    },
    {
      "section": null,
      "text": "Lad brødet køle af i formen. Tag det op, og drys med flormelis, før du serverer."
    }
  ],
