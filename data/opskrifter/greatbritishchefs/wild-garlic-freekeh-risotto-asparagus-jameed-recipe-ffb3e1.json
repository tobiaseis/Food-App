  "steps": [
    {
      "section": "Bulgurbunden",
      "text": "Sæt en stor gryde med låg over varmen. Svits skalotteløgene i smørret, til de er bløde og klare."
    },
    {
      "section": "Bulgurbunden",
      "text": "Rør hvidløget i og steg det i 1 minut, til det dufter. Tilsæt bulgur og steg under omrøring i 3 minutter."
    },
    {
      "section": "Bulgurbunden",
      "text": "Kom timian, fond, vand, vin og salt i. Bring det i kog, læg låg på, og lad det simre ved lav varme i 18 minutter."
    },
    {
      "section": "Bulgurbunden",
      "text": "Tag gryden af varmen og lad den stå med låg på i 10 minutter. Bred bulgur ud på en bakke, lad den køle helt af, og opbevar den i en tæt beholder i køleskabet, til den skal bruges."
    },
    {
      "section": "Purløgspuréen",
      "text": "Blend purløg og rapsolie, til massen er helt glat. Stil den på køl."
    },
    {
      "section": "Purløgssmørret",
      "text": "Blitz purløg og blødt smør i en foodprocessor, til alt er hakket fint og blandet. Der bliver mere, end du skal bruge – resten kan fryses."
    },
    {
      "section": "Til servering",
      "text": "Sæt en stor pande over middelvarme. Gør samtidig grillen klar til direkte varme, eller varm en grillpande op."
    },
    {
      "section": "Til servering",
      "text": "Grill aspargesene, og vend dem ofte, til de har fået flot farve og er møre. Flyt dem til en køligere del af grillen, hvis de brunes for hurtigt."
    },
    {
      "section": "Til servering",
      "text": "Svits imens skalotteløg i smør på panden, til de begynder at blive bløde. Tilsæt porre og forårsløg og sauter, til de er møre."
    },
    {
      "section": "Til servering",
      "text": "Kom bulgurbunden og vinen på panden. Rør ofte, mens vinen koger ind, og bulgur bliver varm igen."
    },
    {
      "section": "Til servering",
      "text": "Vend purløgspuréen og 100 g af purløgssmørret i den varme ret. Smag til med salt og citronsaft."
    },
    {
      "section": "Til servering",
      "text": "Anret i dybe tallerkener og drys med pistaciekerner. Læg de grillede asparges ved siden af, og riv parmesan fint over."
    }
  ],
