  "steps": [
    {
      "section": "Kagebunde",
      "text": "Tænd ovnen på 170 °C. Beklæd tre springforme på 20 cm med bagepapir."
    },
    {
      "section": "Kagebunde",
      "text": "Pisk smør og brun farin luftigt. Tilsæt æggene ét ad gangen, og pisk dem ind."
    },
    {
      "section": "Kagebunde",
      "text": "Vend hvedemel, bagepulver, kakao, revet nellike og appelsinskal i dejen. Pisk, til den er helt glat."
    },
    {
      "section": "Kagebunde",
      "text": "Fordel dejen ligeligt i de tre forme. Bag kagebundene i 50–60 minutter."
    },
    {
      "section": "Kagebunde",
      "text": "Lad bundene hvile i formene i 10 minutter, og vend dem derefter ud på en rist."
    },
    {
      "section": "Frosting",
      "text": "Pisk smørret i en røremaskine med piskeris. Rør saltet i, og tilsæt flormelis lidt ad gangen. Pisk hver portion helt ind, før næste kommer i."
    },
    {
      "section": "Frosting",
      "text": "Sæt maskinen på middel-lav, og tilsæt fløden lidt ad gangen med en spiseskefuld pr. gang."
    },
    {
      "section": "Frosting",
      "text": "Skru op på middel-høj. Pisk vaniljepasta og krydderierne i cremen."
    },
    {
      "section": "Samling",
      "text": "Smør en klat creme på en kageplade, så bunden sidder fast, og læg den første kagebund ovenpå."
    },
    {
      "section": "Samling",
      "text": "Fordel et lag creme over bunden med en paletkniv. Læg den næste bund på, og gentag med creme og den sidste bund."
    },
    {
      "section": "Samling",
      "text": "Stil kagen på køl i 15 minutter. Smør et tyndt lag creme rundt om siderne og over toppen, så krummerne sidder fast, og stil den på køl i yderligere 15 minutter."
    },
    {
      "section": "Samling",
      "text": "Dæk kagen med et sidste lag creme på top og sider."
    },
    {
      "section": "Pynt",
      "text": "Pynt med revet mælkechokolade, kanelstænger i midten, appelsinskal, et drys kanel og spåner af hvid chokolade. Skær i stykker, og server."
    }
  ],
