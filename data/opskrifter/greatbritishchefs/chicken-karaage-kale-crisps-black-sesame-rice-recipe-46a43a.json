  "steps": [
    {
      "section": "Karrypulver",
      "text": "Rist alle krydderierne på en tør pande, til de dufter. Mal dem til et fint pulver i en krydderikværn."
    },
    {
      "section": "Karrysauce",
      "text": "Varm olien op i en gryde. Svits løg, hvidløg og ingefær ved middel-lav varme i ca. 15 minutter."
    },
    {
      "section": "Karrysauce",
      "text": "Rør gulerødder, hvedemel og tomatpuré i, og lad det stege i 2 minutter."
    },
    {
      "section": "Karrysauce",
      "text": "Tilsæt karrypulver, fond, sojasauce, mirin og sukker. Lad saucen simre i 20 minutter, og blend den derefter helt glat."
    },
    {
      "section": "Kylling",
      "text": "Rør sojasauce, vin, ingefær og hvidløg sammen. Vend kyllingestykkerne i marinaden, og lad dem trække i 30 minutter."
    },
    {
      "section": "Sortsesamris",
      "text": "Imens: Hæld vandet fra risene, og kom dem i en gryde med det friske vand. Bring i kog, skru ned til middel-lav varme, læg et viskestykke og låg over, og lad det koge i ca. 12 minutter."
    },
    {
      "section": "Sortsesamris",
      "text": "Tag gryden af varmen, og lad risene dampe i 10 minutter under låg. Vend sesamfrøene i."
    },
    {
      "section": "Grønkålschips",
      "text": "Tænd ovnen på 160 °C varmluft."
    },
    {
      "section": "Syltet agurk",
      "text": "Vend agurkeskiverne med riseddike, citronsaft, sukker og salt. Lad dem stå i 15 minutter, til de er møre."
    },
    {
      "section": "Grønkålschips",
      "text": "Gnid grønkålen ind i olie og salt, og læg den på en bageplade med bagepapir. Bag i 12 minutter, til den er sprød."
    },
    {
      "section": "Kylling",
      "text": "Varm olie op til 170 °C i en høj, tyk gryde, så der er nok til at friturestege kyllingen."
    },
    {
      "section": "Kylling",
      "text": "Vend kyllingestykkerne i majsstivelse lige før stegning. Steg dem i 4–5 minutter, til de er sprøde, gyldne og gennemstegte. Lad dem dryppe af på køkkenrulle."
    },
    {
      "section": "Til servering",
      "text": "Anret sesamris i skåle, og læg kyllingen ovenpå. Hæld karrysauce over, og pynt med syltet agurk, grønkålschips og forårsløg."
    }
  ],
  "changes": [
    "Sake er erstattet af hvidvin.",
    "Yuzujuice er erstattet af citronsaft."
  ]
}
