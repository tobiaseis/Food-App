  "steps": [
    {
      "section": "Kartofler",
      "text": "Tænd ovnen på 190 °C og beklæd en bageplade med bagepapir."
    },
    {
      "section": "Kartofler",
      "text": "Læg kartoflerne på pladen, gnid dem ind i olie og flagesalt, og prik dem med en gaffel."
    },
    {
      "section": "Kartofler",
      "text": "Bag dem i 1 time og 20 minutter, til skindet er sprødt, og kartoflen er blød indeni. Læg prosciuttoen på pladen de sidste 5-6 minutter, så den bliver sprød."
    },
    {
      "section": "Grøn guddinde-dressing",
      "text": "Kom alle ingredienserne til dressingen i en foodprocessor. Blend den glat, og tilsæt en sjat vand ad gangen, til konsistensen minder om piskefløde."
    },
    {
      "section": "Grøn guddinde-dressing",
      "text": "Der bliver mere, end du skal bruge. Stil dressingen på køl, til den skal bruges."
    },
    {
      "section": "Fyld",
      "text": "Skær de bagte kartofler over på langs. Øs det meste af indmaden ud, og lad en kant på ca. 1 cm blive tilbage i skindet."
    },
    {
      "section": "Fyld",
      "text": "Kom kartoffelmosen i en skål, og mos den sammen med fyldets ingredienser, til den er jævn. Smag til med salt og peber."
    },
    {
      "section": "Fyld",
      "text": "Fordel fyldet i skindene, og rids toppen let op med gaflen. Sæt kartoflerne tilbage i ovnen i ca. 10 minutter, til de er varme igennem, og toppen er let sprød."
    },
    {
      "section": "Topping",
      "text": "Vend den snittede salat med 3 spsk af dressingen. Skær avocadoerne i skiver."
    },
    {
      "section": "Topping",
      "text": "Anret de varme kartofler på tallerkener med salat, avocado og burrata. Knus den sprøde prosciutto ovenpå, og dryp med mere dressing. Top med pistaciekerner, citronskal, purløg og sort peber."
    }
  ],
