  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 200 °C. Har din ovn damp, så vælg lav damp (25 % fugtighed). Klæd en bradepande med bagepapir."
    },
    {
      "section": "Hurtigt syltede skalotteløg",
      "text": "Kom skalotteløg, citronskal og dild i en skål."
    },
    {
      "section": "Hurtigt syltede skalotteløg",
      "text": "Varm eddike, vand, honning, salt, peberkorn og sennepsfrø forsigtigt i en lille kasserolle i 2 minutter, og rør, til salt og honning er opløst. Hæld lagen over skalotteløgene, og lad dem stå og trække."
    },
    {
      "section": "Kylling",
      "text": "Bland olie, salt, peber, hvidløgspulver, paprika og løgpulver i en stor skål. Vend kyllingen rundt i blandingen, så den er dækket hele vejen rundt."
    },
    {
      "section": "Kylling",
      "text": "Læg kyllingen i bradepanden, og steg den i ovnen i 30 minutter."
    },
    {
      "section": "Citronyoghurt",
      "text": "Rør alle ingredienserne sammen, og smag til med salt og peber. Stil yoghurten på køl, til den skal bruges."
    },
    {
      "section": "Hot honey-sennepsglaze",
      "text": "Varm alle ingredienserne forsigtigt i en lille gryde, og hold glazen varm."
    },
    {
      "section": null,
      "text": "Når kyllingen er sprød og gennemstegt, pensl den rigeligt med glaze. Sæt den tilbage i ovnen i 5 minutter."
    },
    {
      "section": null,
      "text": "Smør yoghurten ud på et fad, og læg kyllingen ovenpå. Top med dildtoppe, flagesalt og de syltede skalotteløg."
    }
  ],
