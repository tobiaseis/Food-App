  "steps": [
    {
      "section": "Cure fisken",
      "text": "Bland salt og sukker, og vend havørredfileten i blandingen, så den er helt dækket."
    },
    {
      "section": "Cure fisken",
      "text": "Stil fisken på køl i 4 timer. Skyl derefter curingen af under koldt vand."
    },
    {
      "section": "Røget bouillon",
      "text": "Læg ben og afskær i en hulbundet, varmefast bakke, og stram film over toppen."
    },
    {
      "section": "Røget bouillon",
      "text": "Læg enrisgrenene i en brandsikker beholder, tænd dem, og pust flammerne ud, så de kun ulmer."
    },
    {
      "section": "Røget bouillon",
      "text": "Sæt bakken oven på grenene, og lad det ryge i 10 minutter."
    },
    {
      "section": "Røget bouillon",
      "text": "Kom de røgede ben i en gryde sammen med forårsløg, kombu og ingefær, og fyld op med vand, så det dækker."
    },
    {
      "section": "Røget bouillon",
      "text": "Bring det i kog, smag til med salt og lidt eddike, og lad det simre i 3 timer. Køl bouillonen ned i køleskabet."
    },
    {
      "section": "Røget bouillon",
      "text": "Blend eller hak 50 g af afskæret helt fint, og pisk det ud i æggehviderne."
    },
    {
      "section": "Røget bouillon",
      "text": "Pisk blandingen ned i den kolde bouillon, og varm op til det simrer. Hviderne binder urenhederne og klarer bouillonen."
    },
    {
      "section": "Røget bouillon",
      "text": "Når hviderne er stivnet, løfter du dem af som en skorpe og kasserer dem."
    },
    {
      "section": "Tomatsalat",
      "text": "Ca. 30 minutter før servering blandes alle ingredienserne til salaten. Smag til med salt og eddike."
    },
    {
      "section": "Til fisken",
      "text": "Varm ghee op til 55 °C, og læg den curede fisk forsigtigt i."
    },
    {
      "section": "Til fisken",
      "text": "Lad den stå, til den lige er gennemvarm, ca. 10 minutter. Tag den op, og del den i flager."
    },
    {
      "section": "Anretning",
      "text": "Anret tomatsalat og puffet boghvede på tallerkener. Læg fiskeflager og ørredrogn ovenpå."
    },
    {
      "section": "Anretning",
      "text": "Drys fisken med chipotle, og hæld den klarede bouillon rundt om."
    }
  ],
