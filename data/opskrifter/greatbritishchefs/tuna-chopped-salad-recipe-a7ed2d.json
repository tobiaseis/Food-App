  "steps": [
    {
      "section": "Salat",
      "text": "Kog saltet vand op i en gryde. Kog bønnerne i 2 minutter, til de er møre. Hæld vandet fra, og skyl dem i koldt vand."
    },
    {
      "section": "Salat",
      "text": "Hak bønner, oliven, agurk, tomater, løg og persille fint, så stykkerne er lige store. Kom det hele i en stor skål."
    },
    {
      "section": "Dressing",
      "text": "Pisk olivenolie, citronsaft, sennep, honning og hvidløg sammen, til dressingen er cremet og samlet. Smag til med salt og peber."
    },
    {
      "section": "Salat",
      "text": "Pil tunen i flager over de hakkede grøntsager. Hæld dressingen over, og vend salaten grundigt, så alt er dækket."
    },
    {
      "section": "Salat",
      "text": "Lad salaten trække i 10 minutter, så smagene når at blande sig. Server den med ristet brød."
    }
  ],
