  "steps": [
    {
      "section": "Til fyldet",
      "text": "Tænd ovnen på 200 °C varmluft."
    },
    {
      "section": "Til fyldet",
      "text": "Vend gulerødder, pastinak og rosenkål med olie, honning, timian, salt og peber."
    },
    {
      "section": "Til fyldet",
      "text": "Fordel grøntsagerne på en bageplade og rist dem i 25–30 minutter. Vend dem én gang undervejs, til de er karamelliserede."
    },
    {
      "section": "Til fyldet",
      "text": "Lad grøntsagerne køle lidt af og hak dem fint. Gem lidt til senere."
    },
    {
      "section": "Til fyldet",
      "text": "Bland kartoffelmosen med persille og de hakkede grøntsager. Smag til med rigeligt salt og peber, og lad fyldet køle lidt af."
    },
    {
      "section": "Til rulladerne",
      "text": "Kog en stor gryde vand med salt. Blancher kålbladene i 1–2 minutter, til de er bløde og bøjelige."
    },
    {
      "section": "Til rulladerne",
      "text": "Tag bladene op med en hulske, og læg dem straks i isvand, så de holder op med at koge. Dup dem tørre."
    },
    {
      "section": "Til rulladerne",
      "text": "Læg ét blad fladt på et skærebræt, og kom nogle skefulde fyld på midten. Slå siderne ind over fyldet, og rul bladet stramt sammen til en pæn pakke. Gør det samme med resten."
    },
    {
      "section": "Til tomatfondue",
      "text": "Varm olien i en gryde, og svits løg, hvidløg og laurbærblad ved svag varme i 8–10 minutter, til løgene er bløde."
    },
    {
      "section": "Til tomatfondue",
      "text": "Rør tomater, tomatpuré, fond, sukker og eddike i. Lad saucen simre i 20 minutter, til den er tyknet og blank."
    },
    {
      "section": "Til tomatfondue",
      "text": "Fjern laurbærbladet, og blend saucen glat med en stavblender. Smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Skru ovnen ned på 180 °C varmluft."
    },
    {
      "section": "Til servering",
      "text": "Kom et lag sauce i et ovnfast fad, og læg kålrulladerne ovenpå. Hæld mere sauce over, og drys de resterende grøntsager rundt om."
    },
    {
      "section": "Til servering",
      "text": "Dæk løst med folie eller låg, og bag i 20–25 minutter, til retten er sydende varm."
    },
    {
      "section": "Til servering",
      "text": "Anret rulladerne med en ekstra skefuld sauce, og pynt med persilleblade og parmesan."
    }
  ],
