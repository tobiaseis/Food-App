  "steps": [
    {
      "section": "Dadler og spyd",
      "text": "Skær hver dadel næsten helt igennem på langs, så bunden holder sammen, og tag stenen ud."
    },
    {
      "section": "Dadler og spyd",
      "text": "Klip de 8 rosmarinkviste til samme længde. Træk nålene af, så kun toppen beholder dem. Nu har du 8 spyd."
    },
    {
      "section": "Stiltoncreme",
      "text": "Pisk stilton, flødeost og fløde med piskeris i en røremaskine på middelhøj hastighed, til cremen er glat og ensartet."
    },
    {
      "section": "Stiltoncreme",
      "text": "Kom cremen i en sprøjtepose med glat tud."
    },
    {
      "section": "Tranebærsirup",
      "text": "Kog alle ingredienserne til sirup op og lad dem simre svagt i 20–30 minutter, til massen er tyk og sirupsagtig. Lad den ikke koge kraftigt, for så bliver sukkeret overkogt, og sirupen stivner."
    },
    {
      "section": "Hvidløgsfløde til bunden",
      "text": "Mens sirupen simrer, pisker du fløde og stilton glat i røremaskinen. Pisk hvidløget i og smag til med salt og peber. Stil cremen i køleskabet."
    },
    {
      "section": "Sprødt drys",
      "text": "Varm olien op i en pande ved middelhøj varme, til den næsten ryger. Rist panko og hakket rosmarin i olien, til det er gyldent. Smag til med salt og peber, og stil det til side."
    },
    {
      "section": "Samling",
      "text": "Åbn dadlerne forsigtigt én ad gangen, og sprøjt stiltoncreme pænt i. Drys med salt, peber, lidt timianblade og noget af det ristede panko."
    },
    {
      "section": "Samling",
      "text": "Træk 5–7 dadler på hvert rosmarinspyd, uden at de går i stykker."
    },
    {
      "section": "Anretning",
      "text": "Smør hvidløgsfløden ud i bunden af et serveringsfad og dryp sirupen over. Læg dadelspydene ovenpå."
    },
    {
      "section": "Anretning",
      "text": "Pynt med resten af det ristede panko, tranebær fra sirupen, honning, timian, sort peber og honningkage."
    }
  ],
