  "steps": [
    {
      "section": "Svinekødet",
      "text": "Tænd ovnen på 150 °C varmluft."
    },
    {
      "section": "Svinekødet",
      "text": "Gnid kødet ind i olivenolie, salt og peber. Læg løg, gulerødder, hvidløg, rosmarin og timian i et dybt bradefad, og læg kødet ovenpå. Hæld fond og cider rundt om."
    },
    {
      "section": "Svinekødet",
      "text": "Dæk fadet helt tæt med alufolie. Steg i 3½-4 timer, til kødet er så mørt, at det kan trækkes i stykker med en gaffel. Lad det hvile under sværbagningen."
    },
    {
      "section": "Sprødt svær",
      "text": "Skru ovnen op på 220 °C varmluft."
    },
    {
      "section": "Sprødt svær",
      "text": "Tør svinesværet grundigt med køkkenrulle, og gnid det rigeligt med salt. Læg det fladt på en bageplade, og bag det i 25-30 minutter, til det er boblet og sprødt. Lad det køle af, og knæk det i skår."
    },
    {
      "section": "Æblemos",
      "text": "Smelt smørret i en gryde. Kom æbler, sukker, vand og citronsaft i, læg låg på, og lad det simre ved svag varme i 10-15 minutter, til æblerne er bløde."
    },
    {
      "section": "Æblemos",
      "text": "Blend æblerne glatte, og pres dem gennem en fin si. Hold mosen varm til servering."
    },
    {
      "section": "Servering",
      "text": "Træk kødet i stykker med to gafler, og kassér overskydende fedt."
    },
    {
      "section": "Servering",
      "text": "Læg kartoffelmos på hver tallerken, og top med det trukne svinekød. Hæld æblemos over, og stik skår af svær i. Pynt med timianblade, purløg og de stegte gulerødder og løg fra bradefadet."
    }
  ],
