  "steps": [
    {
      "section": "Suppebase",
      "text": "Varm kokosolien op i en stor gryde ved middelvarme. Rør skalotteløg, jalapeño og ingefær rundt i olien, til det dufter."
    },
    {
      "section": "Suppebase",
      "text": "Hæld fond og kokosmælk i gryden, og kom citrongræs, koriander og basilikum i."
    },
    {
      "section": "Suppebase",
      "text": "Lad det komme i kog og simre kort. Tag gryden af varmen, og blend suppen helt glat med en stavblender."
    },
    {
      "section": "Suppebase",
      "text": "Si suppen gennem en finmasket si over i en ren gryde. Smag til med salt og peber. Lad den køle af, og stil den derefter i køleskabet, til den er helt kold."
    },
    {
      "section": "Til servering",
      "text": "Kog nudlerne møre efter anvisningen på pakken. Si dem fra, og skyl dem i koldt vand. Vend dem med lidt olie, så de ikke klistrer sammen, og stil dem på køl, til de skal bruges."
    },
    {
      "section": "Chiliolie",
      "text": "Kom chiliflager, hvidløg, farin, jordnødder og sesamfrø i en tykbundet kasserolle eller en stor ildfast skål."
    },
    {
      "section": "Chiliolie",
      "text": "Varm olien op i en tykbundet kasserolle til 140 °C."
    },
    {
      "section": "Chiliolie",
      "text": "Hæld forsigtigt den varme olie over krydderierne. Det bruser kraftigt op, så stå på afstand, og hæld evt. olien i flere omgange."
    },
    {
      "section": "Chiliolie",
      "text": "Lad olien trække, mens resten tilberedes."
    },
    {
      "section": "Svampe",
      "text": "Varm olien op i en pande ved høj varme. Steg svampene med snitfladen nedad, til de er gyldne."
    },
    {
      "section": "Svampe",
      "text": "Tilsæt smør, østerssauce, mirin, sukker, sojasauce og sesamolie. Rør rundt, til svampene er blanke og klistrede af sauce."
    },
    {
      "section": "Til servering",
      "text": "Fordel nudlerne i skåle, og øs den grønne suppe over. Læg svampe, chiliolie, æg og forårsløg ovenpå, og server straks."
    }
  ],
