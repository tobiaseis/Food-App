  "steps": [
    {
      "section": "Laksen",
      "text": "Tænd ovnen på 180 °C og beklæd en bageplade med bagepapir."
    },
    {
      "section": "Laksen",
      "text": "Læg laksefiletterne på pladen. Drys med gurkemeje, salt og peber, og dryp med olivenolie. Læg en citronskive på hver filet."
    },
    {
      "section": "Laksen",
      "text": "Bag laksen i 12 minutter, til den lige akkurat er gennemstegt. Lad den hvile lidt, og pluk den derefter i stykker."
    },
    {
      "section": "Æg og pasta",
      "text": "Bring en lille kasserolle med vand i kog, og skru ned til en jævn simren. Sænk æggene forsigtigt ned med en hulske, og lad dem simre i 6 minutter."
    },
    {
      "section": "Æg og pasta",
      "text": "Køl æggene i isvand, og pil dem, når de er kolde."
    },
    {
      "section": "Æg og pasta",
      "text": "Kog spaghettien i rigeligt saltet vand efter anvisningen på pakken. Gem ca. 2,5 dl af kogevandet, og si pastaen fra."
    },
    {
      "section": "Yoghurtsauce",
      "text": "Pisk alle ingredienserne til saucen sammen i en stor skål."
    },
    {
      "section": "Samling",
      "text": "Vend den varme spaghetti i saucen, til den er dækket. Tilsæt lidt kogevand, hvis den er for tør."
    },
    {
      "section": "Samling",
      "text": "Vend den hakkede dild og den pillede laks forsigtigt i."
    },
    {
      "section": "Samling",
      "text": "Fordel pastaen i fire skåle. Halvér æggene, læg dem ovenpå, og drys dem med lidt salt og peber. Slut af med citronskal og de sparede dildtoppe."
    }
  ],
