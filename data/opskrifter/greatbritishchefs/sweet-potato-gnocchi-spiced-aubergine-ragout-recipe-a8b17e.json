  "steps": [
    {
      "section": "Bag grøntsagerne",
      "text": "Tænd ovnen på 200 °C varmluft. Beklæd en bageplade med bagepapir."
    },
    {
      "section": "Bag grøntsagerne",
      "text": "Skær sødkartoflerne i stykker på ca. 170 g, med skræl på."
    },
    {
      "section": "Bag grøntsagerne",
      "text": "Del aubergineme på langs. Pensl snitfladerne med lidt olie, og læg dem med snitfladen nedad på pladen sammen med sødkartoflerne."
    },
    {
      "section": "Bag grøntsagerne",
      "text": "Bag i 45-50 minutter, til auberginerne er møre og pæne brune på undersiden, og sødkartoflerne er bløde helt igennem."
    },
    {
      "section": "Bag grøntsagerne",
      "text": "Tag pladen ud, og skær nogle sprækker i sødkartoflerne, så de køler hurtigere af."
    },
    {
      "section": "Lav ragouten",
      "text": "Skrab auberginekødet ned i en stor stegepande, der endnu ikke står på varmen. Kassér skrællen."
    },
    {
      "section": "Lav ragouten",
      "text": "Kom resten af ragoutens ingredienser i panden. Sæt den på middel varme, og rør rundt i 4 minutter. Træk den derefter af varmen."
    },
    {
      "section": "Form gnocchierne",
      "text": "Skrab sødkartoffelkødet ud i en skål, og kassér skrællen. Mos det grundigt, til der ingen klumper er. Du skal have ca. 300 g mos."
    },
    {
      "section": "Form gnocchierne",
      "text": "Bland æggeblomme, majsmel, salt, peber og muskatnød i moset, og rør det godt sammen."
    },
    {
      "section": "Form gnocchierne",
      "text": "Beklæd en bakke med bagepapir, og smør papiret let med olivenolie. Form dejen til spidse ovaler ved hjælp af to spiseskeer, og læg dem på bakken."
    },
    {
      "section": "Kog og server",
      "text": "Bring en gryde med rigeligt saltet vand i kog, og skru så ned, så vandet kun simrer let."
    },
    {
      "section": "Kog og server",
      "text": "Kog gnocchierne i ca. 4 minutter, til alle flyder op til overfladen."
    },
    {
      "section": "Kog og server",
      "text": "Løft gnocchierne over i ragoutpanden med en hulske, og tilsæt ca. 100 g af kogevandet. Varm det op på middel varme i nogle minutter, og vend forsigtigt, så saucen dækker gnocchierne."
    },
    {
      "section": "Kog og server",
      "text": "Top med parmesan, citronskal, peber, muskatnød og lidt basilikum. Dryp med olie."
    }
  ],
