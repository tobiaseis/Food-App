  "steps": [
    {
      "section": "Svinekødet",
      "text": "Varm olien op i en stor pande ved middelhøj varme. Brun det hakkede svinekød, til det er gyldent og sprødt."
    },
    {
      "section": "Svinekødet",
      "text": "Skru ned for varmen, og rør hvidløg og ingefær i panden. Steg i et par minutter, til det dufter."
    },
    {
      "section": "Svinekødet",
      "text": "Skru lidt op igen, og hæld fiskesauce, østerssauce, sojasauce og mirin på. Lad det koge ind, smag til med salt, og vend forårsløgene i. Stil kødet til side."
    },
    {
      "section": "Suppen",
      "text": "Rør hvidløg, gochugaru, tahin og sukker sammen i en skål."
    },
    {
      "section": "Suppen",
      "text": "Varm mælk og bouillon, til det næsten simrer. Pisk det derefter lidt ad gangen ned i tahinblandingen, til saucen er glat."
    },
    {
      "section": "Suppen",
      "text": "Hæld suppen over i panden, og bring den i et let kog. Pisk miso og limesaft i, smag til med salt og peber, og tag panden af varmen."
    },
    {
      "section": "Til servering",
      "text": "Kog soba-nudlerne møre efter anvisningen på pakken. Si dem, skyl dem, og afkøl dem i isvand."
    },
    {
      "section": "Til servering",
      "text": "Fordel nudlerne i to skåle, og hæld den varme suppe over. Top med det stegte svinekød, æg og forårsløg, og dryp rigeligt med chiliolie over."
    }
  ],
