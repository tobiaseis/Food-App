  "steps": [
    {
      "section": "Syltede grøntsager",
      "text": "Rør eddike, sukker, salt og det lunkne vand sammen i en skål, til sukker og salt er opløst."
    },
    {
      "section": "Syltede grøntsager",
      "text": "Kom gulerødder, radiser og agurk i lagen, og vend dem rundt, så alt er dækket. Lad dem trække i mindst 30 minutter – gerne længere."
    },
    {
      "section": "Chilismør",
      "text": "Pisk det bløde smør sammen med resten af ingredienserne til chilismøret, til det er glat og ensartet. Stil det til side."
    },
    {
      "section": "Dressing",
      "text": "Pisk alle ingredienserne til dressingen sammen og stil den til side."
    },
    {
      "section": "Spejlæg",
      "text": "Varm 2 spsk rapsolie op på en pande ved middelhøj varme."
    },
    {
      "section": "Spejlæg",
      "text": "Slå æggene ud på panden, og steg dem, til kanterne er gyldne og sprøde, mens blommerne stadig er flydende. Øs varm olie over æggene undervejs."
    },
    {
      "section": "Spejlæg",
      "text": "Drys æggene let med salt, og lad dem dryppe af på køkkenrulle."
    },
    {
      "section": "Samling",
      "text": "Rist imens flutens snitflader under en varm grill."
    },
    {
      "section": "Samling",
      "text": "Smør chilismør på snitfladerne, og fordel det meste af dressingen over. Læg de afdryppede grøntsager og korianderblade på."
    },
    {
      "section": "Samling",
      "text": "Top med de sprøde spejlæg, chiliskiverne og hakket koriander. Dryp resten af dressingen over, og server med det samme."
    }
  ],
