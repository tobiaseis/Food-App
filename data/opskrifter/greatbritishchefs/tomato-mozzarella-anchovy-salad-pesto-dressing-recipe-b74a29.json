  "steps": [
    {
      "section": null,
      "text": "Varm halvdelen af olivenolien på en stor pande ved middelhøj varme. Steg brødternene, til de er gyldne og sprøde, og vend dem ofte."
    },
    {
      "section": null,
      "text": "Læg croutonerne på køkkenrulle, og drys dem med salt."
    },
    {
      "section": null,
      "text": "Rør pesto, ricotta og citronsaft sammen med resten af olien og en knivspids salt og peber til en tyk dressing. Stil den til side."
    },
    {
      "section": null,
      "text": "Fordel romainesalaten på et stort fad. Kom tomater og croutoner ovenpå, og læg ansjoserne henover."
    },
    {
      "section": null,
      "text": "Skeen dressingen forsigtigt over salaten, og drys med pinjekerner, basilikum og parmesan."
    },
    {
      "section": null,
      "text": "Læg mozzarellaen øverst, og dæk den med pistacienødder og lidt peber. Server med det samme."
    }
  ],
