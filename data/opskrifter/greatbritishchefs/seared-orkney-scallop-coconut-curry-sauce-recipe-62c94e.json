  "steps": [
    {
      "section": "Korianderemulsion",
      "text": "Blend olie og koriander sammen til en grøn olie."
    },
    {
      "section": "Korianderemulsion",
      "text": "Si olien gennem et musselinklæde ned i en engangssprøjtepose. Hæng posen med spidsen nedad i køleskabet natten over."
    },
    {
      "section": "Korianderemulsion",
      "text": "Næste dag har vandet samlet sig nederst. Klip spidsen af posen, og lad vand og bundfald løbe fra, til olien er klar."
    },
    {
      "section": "Korianderemulsion",
      "text": "Rør den klare olie sammen med mayonnaisen i en skål, til den bliver en tyk emulsion."
    },
    {
      "section": "Karrysauce",
      "text": "Svits løget i ghee i en gryde, til det er blødt og blankt."
    },
    {
      "section": "Karrysauce",
      "text": "Tilsæt hvidløg og ingefær, og lad det stege i 5 minutter."
    },
    {
      "section": "Karrysauce",
      "text": "Rist alle krydderierne, hele og stødte, i en tør pande, til de dufter og får lidt farve."
    },
    {
      "section": "Karrysauce",
      "text": "Kom krydderierne i gryden sammen med tomatpuréen, og lad det simre i 5 minutter. Tilsæt de hakkede tomater, og kog dem ind i 10 minutter."
    },
    {
      "section": "Karrysauce",
      "text": "Hæld fonden i, og lad saucen simre svagt i 10 minutter."
    },
    {
      "section": "Karrysauce",
      "text": "Rør kokosmælk og creme fraiche i, og kog videre i 10 minutter."
    },
    {
      "section": "Karrysauce",
      "text": "Blend saucen helt glat. Smag til med honning og citronsaft."
    },
    {
      "section": "Kammuslinger",
      "text": "Åbn muslingerne, og skær først den hele muskel fri. Fjern derefter kanten og rognen."
    },
    {
      "section": "Kammuslinger",
      "text": "Skyl muslingerne i isvand, og dup dem tørre."
    },
    {
      "section": "Kammuslinger",
      "text": "Varm en støbejernspande op, til den er meget varm. Tilsæt lidt olie, og drys muslingerne med salt."
    },
    {
      "section": "Kammuslinger",
      "text": "Steg muslingerne med den pæne side nedad i 1 minut. Vend dem, kom smørret på panden, og øs det over muslingerne i endnu 1 minut."
    },
    {
      "section": "Kammuslinger",
      "text": "Tag muslingerne af panden, og lad dem hvile et par minutter. Lige før servering drysses de med limeskal, limesaft og flagesalt. Skær hver musling i tre skiver."
    },
    {
      "section": "Til anretning",
      "text": "Hæld karrysaucen på tallerkenerne, og læg muslingerne ovenpå. Sæt prikker af korianderemulsion rundt om."
    },
    {
      "section": "Til anretning",
      "text": "Pynt med lime, ristede kokosflager, karse og puffet ris."
    }
  ],
  "changes": [
    "Ghee i stedet for klaret smør.",
