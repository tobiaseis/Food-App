  "steps": [
    {
      "section": "Schnitzlerne",
      "text": "Skær overskydende fedt af koteletterne. Læg dem mellem to stykker bagepapir, og bank dem jævnt ud med en kagerulle eller kødhammer, til de er cirka 3 mm tykke. Krydr begge sider med salt og peber."
    },
    {
      "section": "Schnitzlerne",
      "text": "Stil tre dybe tallerkener frem. Kom mel på den første. Pisk æg og sennep sammen på den anden. Bland rasp, parmesan og en knivspids salt og peber på den tredje."
    },
    {
      "section": "Schnitzlerne",
      "text": "Vend hver kotelet i melet, og ryst det overskydende af. Træk den gennem ægget og derefter raspen. Gentag med æg og rasp, så panéringen bliver helt dækkende og tyk. Stil til side."
    },
    {
      "section": "Cæsardressing",
      "text": "Kom æggeblomme, sennep, hvidløg, ansjoser, citronskal og citronsaft i en morter eller en lille foodprocessor, og arbejd det til en pasta."
    },
    {
      "section": "Cæsardressing",
      "text": "Rør eller blend det hele, mens du langsomt hælder olivenolien i en tynd stråle, så dressingen emulgerer. Vend parmesanen i, og smag til med rigeligt peber."
    },
    {
      "section": "Stegning",
      "text": "Sæt en bred stegepande og en grillpande over middelhøj varme. Når begge er varme, tilsættes en god sjat rapsolie på dem."
    },
    {
      "section": "Stegning",
      "text": "Kom smørret på stegepanden. Læg schnitzlerne i, når smørret skummer – steg dem i portioner, hvis der ikke er plads. Steg 3-4 minutter på hver side, og øs jævnligt det varme fedt over dem."
    },
    {
      "section": "Stegning",
      "text": "Imens lægges hjertesalaten med snitfladen nedad på den varme grillpande. Lad den ligge urørt, til der er mørke grillstriber, og salaten er lidt faldet sammen. Drys med salt, og stil til side."
    },
    {
      "section": "Servering",
      "text": "Anret en schnitzel midt på hver tallerken, og læg en halv hjertesalat ovenpå. Rør lidt rundt i dressingen, og tynd den evt. ud med en sjat vand. Dryp den over salaten."
    },
    {
      "section": "Servering",
      "text": "Afslut med parmesan, persille, peber, ansjoser og et drys olivenolie."
    }
  ],
  "changes": [
    "Frisk rasp er erstattet med almindelig rasp.",
    "Baby gem er erstattet med hjertesalat.",
    "Vegetabilsk olie er erstattet med rapsolie."
  ]
