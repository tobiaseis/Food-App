  "steps": [
    {
      "section": "Til mayonnaisen",
      "text": "Rør æggeblomme, sennep, citronsaft, paprika og cayennepeber sammen i en skål."
    },
    {
      "section": "Til mayonnaisen",
      "text": "Pisk olien i en tynd stråle i blommeblandingen, til du har en jævn mayonnaise."
    },
    {
      "section": "Til mayonnaisen",
      "text": "Vend ketchup i og smag til med salt og peber."
    },
    {
      "section": "Til sandwichen",
      "text": "Vend rejerne med så meget af mayonnaisen, som smager dig."
    },
    {
      "section": "Til salaten",
      "text": "Pensl salatens skåret side med olie og drys med salt."
    },
    {
      "section": "Til salaten",
      "text": "Brun salaten med snitfladen nedad på en varm pande, og tag den derefter af panden."
    },
    {
      "section": "Til salaten",
      "text": "Snit salaten fint, vend den med eddiken, og smag til med salt."
    },
    {
      "section": "Til sandwichen",
      "text": "Læg et stykke brød på et bræt, og fordel rejeblandingen og salaten ovenpå."
    },
    {
      "section": "Til sandwichen",
      "text": "Læg det andet stykke brød på, og drys med purløg inden servering."
    }
  ],
