  "steps": [
    {
      "section": "Kartoffelmad",
      "text": "Kom kartoflerne i en gryde med koldt vand og salt. Bring det i kog, og lad dem simre i 12-15 minutter, til de lige er møre."
    },
    {
      "section": "Kartoffelmad",
      "text": "Hæld vandet fra, og lad kartoflerne køle lidt af. Skær dem derefter i ens skiver på ca. 3 mm."
    },
    {
      "section": "Dildmayonnaise",
      "text": "Pisk æggeblommer, sennep og eddike sammen i en skål."
    },
    {
      "section": "Dildmayonnaise",
      "text": "Bland solsikkeolie og olivenolie. Rør olien i en tynd stråle ned i æggeblandingen, mens du pisker konstant, så den emulgerer."
    },
    {
      "section": "Dildmayonnaise",
      "text": "Når mayonnaisen er tyk og blank, røres citronsaft og hakket dild i. Smag til med salt og hvid peber."
    },
    {
      "section": "Kartoffelmad",
      "text": "Smør rugbrødet godt med smør, og læg kartoffelskiverne pænt ovenpå."
    },
    {
      "section": "Kartoffelmad",
      "text": "Top med dildmayonnaise, og pynt med rødløg, purløg, dildkviste og lidt sort peber."
    }
  ],
  "changes": [
    "Nanna Tate-kartofler er skiftet til nye kartofler."
  ]
