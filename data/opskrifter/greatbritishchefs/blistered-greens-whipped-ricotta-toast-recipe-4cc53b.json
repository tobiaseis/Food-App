  "steps": [
    {
      "section": "Pisket ricotta",
      "text": "Pisk ricotta, olivenolie, fløde, hvidløg og halvdelen af citronens skal og saft kraftigt sammen, til massen er glat og luftig. Stil den på køl, til den skal bruges."
    },
    {
      "section": "Grøntsagerne",
      "text": "Kog en stor gryde vand op med salt."
    },
    {
      "section": "Grøntsagerne",
      "text": "Kog broccolini, asparges og sukkerærter i 1 minut. Hæld dem derefter straks i en skål med isvand."
    },
    {
      "section": "Grøntsagerne",
      "text": "Tag grøntsagerne op, når de er kolde, og dup dem tørre med køkkenrulle."
    },
    {
      "section": "Grøntsagerne",
      "text": "Varm en stor grillpande eller bageplade op på høj varme med lidt rapsolie. Skru ned til middelhøj varme, når den er varm."
    },
    {
      "section": "Grøntsagerne",
      "text": "Læg de blancherede grøntsager og squashbåndene i ét lag på panden. Lad dem stå uden at røre i 2-4 minutter, til undersiden er sort og blæret."
    },
    {
      "section": "Grøntsagerne",
      "text": "Vend grøntsagerne og steg dem 2-4 minutter mere, til de er møre og har fået flot farve."
    },
    {
      "section": "Servering",
      "text": "Rist imens brødet, og smør et generøst lag pisket ricotta på hver skive."
    },
    {
      "section": "Servering",
      "text": "Læg de stegte grøntsager ovenpå. Dryp med olivenolie og resten af citronskal og citronsaft, og top med basilikum, chili, pinjekerner og lidt flagesalt."
    }
  ],
