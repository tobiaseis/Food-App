  "steps": [
    {
      "section": "Koteletter og marinade",
      "text": "Læg koteletterne i en stor skål sammen med alle marinadens ingredienser. Dæk skålen til, og sæt den i køleskabet i 30 minutter."
    },
    {
      "section": "Klistret glasur",
      "text": "Kom glasurens ingredienser i en gryde, og bring dem i kog under omrøring."
    },
    {
      "section": "Klistret glasur",
      "text": "Skru ned på lav varme, og lad glasuren koge ind i ca. 15 minutter. Den er klar, når den hænger tykt på bagsiden af en ske."
    },
    {
      "section": "Koteletter og marinade",
      "text": "Tag koteletterne op af køleskabet, og varm en pande op ved middel-høj varme."
    },
    {
      "section": "Koteletter og marinade",
      "text": "Steg koteletterne i 3-4 minutter på hver side, til de er gennemstegte, og kernetemperaturen er 74 °C."
    },
    {
      "section": "Koteletter og marinade",
      "text": "Pensl koteletterne med glasur, vend dem, og lad glasuren sætte sig i panden. Gentag på den anden side."
    },
    {
      "section": "Koteletter og marinade",
      "text": "Tag panden af varmen, og pensl koteletterne med lidt mere glasur. Læg dem på et fad under stanniol, og lad dem hvile."
    },
    {
      "section": "Varm slaw",
      "text": "Varm olivenolien op i en lille pande ved middelvarme, og svits løgene møre i 10-15 minutter."
    },
    {
      "section": "Varm slaw",
      "text": "Tilsæt selleri, gulerødder og æble, og lad det stege blødt i cirka 10 minutter."
    },
    {
      "section": "Varm slaw",
      "text": "Rør eddike og farin i. Lad eddiken koge ind, smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Skær koteletterne på tværs af fibrene, og anret dem med slawen. Dryp med resten af glasuren, og drys med purløg."
    }
  ],
