  "steps": [
    {
      "section": "Ragù",
      "text": "Tænd ovnen på 140°C. Gnid oksebrystet godt ind i salt og peber."
    },
    {
      "section": "Ragù",
      "text": "Varm olien op i en tykbundet gryde, og brun kødet på alle sider, til det er gyldent. Tag det op og stil det til side."
    },
    {
      "section": "Ragù",
      "text": "Svits løg, gulerødder og selleri i samme gryde ved middel varme i ca. 10 minutter, til grøntsagerne er bløde og tager lidt farve. Rør hvidløget i, og lad det stege med i 2 minutter."
    },
    {
      "section": "Ragù",
      "text": "Hæld eddiken i, og skrab alt det fastbrændte fra bunden. Tilsæt rødvinen, og lad det koge ind til det halve."
    },
    {
      "section": "Ragù",
      "text": "Rør hakkede tomater, tomatpuré og fond i. Læg laurbærblade, rosmarin og kødet i gryden, sæt låg på, og lad det stege i ovnen i 5–6 timer, til kødet er mørt."
    },
    {
      "section": "Ragù",
      "text": "Pil kødet i stykker med to gafler direkte i saucen."
    },
    {
      "section": "Flødekartofler",
      "text": "Skru ovnen op på 175°C varmluft. Skær kartoflerne i meget tynde skiver, gerne på en mandolin."
    },
    {
      "section": "Flødekartofler",
      "text": "Kom kartofler, mælk, fløde, hvidløg, salt og peber i en gryde. Bring det i kog, og lad det simre ved lav varme i ca. 10 minutter."
    },
    {
      "section": "Flødekartofler",
      "text": "Tag gryden af varmen, og rør gruyèren i, til den er helt smeltet."
    },
    {
      "section": "Flødekartofler",
      "text": "Hæld blandingen i et smurt ovnfast fad. Fordel brie og smør ovenpå, og bag i 40 minutter, til gratinen er gylden og boblende."
    },
    {
      "section": "Urtekrummer",
      "text": "Rist brød, kerner og valnødder på en tør pande, til de er gyldne."
    },
    {
      "section": "Urtekrummer",
      "text": "Kør det sammen med de øvrige ingredienser til krummerne i en foodprocessor, til konsistensen er grov. Smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Anret gratinen i en stor skål, og top med ragù og urtekrummer. Slut af med friskkværnet peber."
    }
  ],
  "changes": [
    "Maltseddike er skiftet til almindelig eddike."
  ]
}
