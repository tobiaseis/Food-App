  "steps": [
    {
      "section": "Grøn shatta",
      "text": "Begynd tre dage før servering. Vend chilierne med saltet i en renset beholder, læg låg på, og sæt den i køleskabet i 3 dage."
    },
    {
      "section": "Grøn shatta",
      "text": "Chilierne er nu blevet lidt møre, og skarpheden er dæmpet. Mix dem med eddike og citronsaft til en grov pasta."
    },
    {
      "section": "Grøn shatta",
      "text": "Kom shattaen i en beholder, og hæld olivenolie ud over, så overfladen er dækket. Opbevar den med låg i køleskabet. Du får mere, end du skal bruge."
    },
    {
      "section": "Konfiteret hvidløg",
      "text": "Kom alle ingredienserne i en gryde, og lad dem simre ved meget svag varme i 45-60 minutter, til hvidløgene er bløde og kan smøres ud."
    },
    {
      "section": "Konfiteret hvidløg",
      "text": "Lad hvidløgene køle af i olien, og opbevar dem i den i køleskabet. Du får mere, end du skal bruge."
    },
    {
      "section": "Labneh",
      "text": "Blend forårsløg og rapsolie glat i en blender eller foodprocessor. Vend 30 g af puréen i labnehen, og stil den til side. Resten af puréen kan gemmes."
    },
    {
      "section": "Za'atar-rasp",
      "text": "Varm 20 g af olien fra det konfiterede hvidløg op på en pande. Rist panko i olien, til den er gylden og sprød."
    },
    {
      "section": "Za'atar-rasp",
      "text": "Rør za'atar og begge slags salt i, tag panden af varmen, og lad raspen køle helt af."
    },
    {
      "section": "Vallekaramel",
      "text": "Springes over, hvis du ikke vil lave den. Kom valle, sukker og citronskal i en gryde, og lad det koge langsomt ind til en tyk, blank, karamelagtig konsistens, der næsten ligner vaseline."
    },
    {
      "section": "Vallekaramel",
      "text": "Tag gryden af varmen, og rør citronsaften i."
    },
    {
      "section": "Servering",
      "text": "Fordel labnehen på tallerkener, og lav en fordybning i midten af hver med bagsiden af en ske."
    },
    {
      "section": "Servering",
      "text": "Læg konfiteret hvidløg, shatta og eventuelt vallekaramel i fordybningen, og dryp med lidt af hvidløgsolien."
    },
    {
      "section": "Servering",
      "text": "Top med za'atar-rasp, koriander og en knivspids sumak."
    }
  ],
  "changes": [
