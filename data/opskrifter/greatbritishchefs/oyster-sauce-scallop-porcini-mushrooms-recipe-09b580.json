  "steps": [
    {
      "section": "Svampemælk",
      "text": "Varm mælken med de tørrede svampe op i en mellemstor gryde, til den næsten koger. Tag gryden af varmen."
    },
    {
      "section": "Svampemælk",
      "text": "Lad mælken køle af og stil den i køleskabet i 6 timer, så smagen trækker. Si svampene fra og gem mælken."
    },
    {
      "section": "Ketchup af sort hvidløg",
      "text": "Kom alle ingredienserne til ketchuppen i en lille gryde. Lad det småkoge ved svag varme, til hvidløgene er bløde."
    },
    {
      "section": "Ketchup af sort hvidløg",
      "text": "Blend massen helt glat."
    },
    {
      "section": "Kammuslinger og svampe",
      "text": "Varm en pande til den er meget varm. Læg kammuslinger og de snittede svampehalvdele med snitsiden nedad, og steg dem gyldne. Tilsæt smør."
    },
    {
      "section": "Kammuslinger og svampe",
      "text": "Vend kammuslinger og svampe. Øs det skummende smør over i cirka 1 minut, eller til de er stegt, som du bedst kan lide dem. Dryp med citronsaft."
    },
    {
      "section": "Kammuslinger og svampe",
      "text": "Løft kammuslinger og svampe over på et fad, og lad dem hvile i 2-3 minutter."
    },
    {
      "section": "Kammuslinger og svampe",
      "text": "Pensl kammuslingerne med østerssauce, drys med svampebouillon og purløg, og del hver i to halvdele."
    },
    {
      "section": "Svampemælk",
      "text": "Varm svampemælken forsigtigt op uden at lade den koge, og pisk den til skum med en mælkeskummer."
    },
    {
      "section": "Anretning",
      "text": "Kom en klat sort hvidløgsketchup i bunden af hver skål. Læg kammuslinger, stegte svampe og rå svampeskiver ovenpå, og top med lidt svampeskum."
    }
  ],
