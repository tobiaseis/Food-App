  "steps": [
    {
      "section": "Shakshuka",
      "text": "Varm en tykbundet pande op ved middel varme med en smule olie. Brun pølserne, til de begynder at karamellisere."
    },
    {
      "section": "Shakshuka",
      "text": "Kom løget på panden og lad det stege blødt i ca. 10 minutter."
    },
    {
      "section": "Shakshuka",
      "text": "Rør hvidløg og krydderier i og steg under omrøring i cirka et minut."
    },
    {
      "section": "Shakshuka",
      "text": "Hæld tomaterne på panden, smag til med salt, og lad det simre i 20 minutter."
    },
    {
      "section": "Shakshuka",
      "text": "Tænd ovnen på 180 °C."
    },
    {
      "section": "Shakshuka",
      "text": "Slå æggene ud i tomatsovsen, og sæt panden i ovnen i 5 minutter, til æggene lige er stivnet."
    },
    {
      "section": "Citronsalsa",
      "text": "Bland alle ingredienserne til salsaen, og smag til med salt og peber."
    },
    {
      "section": "Citronsalsa",
      "text": "Anret shakshukaen med salsa over, og drys med koriander og chiliflager. Server med brød ved siden af."
    }
  ],
  "changes": [
    "Merguez er skiftet ud med chorizo.",
    "Konserveret citron er skiftet ud med frisk citron (kun skallen).",
    "Aleppo-chiliflager er skiftet ud med almindelige chiliflager."
  ]
