  "steps": [
    {
      "section": "Havregryn",
      "text": "Rør havregryn, mandler, tranebær, honning, krydderier og salt sammen aftenen før. Hæld mælken over og rør godt rundt."
    },
    {
      "section": "Havregryn",
      "text": "Fordel blandingen i 6 skåle eller glas, dæk til og lad den stå i køleskabet natten over."
    },
    {
      "section": "Kardemommefløde",
      "text": "Næste dag piskes fløden med kardemomme og salt. Tilsæt sukkeret lidt ad gangen, og pisk, til fløden står i stive toppe."
    },
    {
      "section": "Kardemommefløde",
      "text": "Kom flødeskummet i en sprøjtepose med stjernetud."
    },
    {
      "section": "Til servering",
      "text": "Sprøjt en top af fløde på hvert glas. Bruger du skåle, så sprøjt en klat og tryk en lille fordybning i midten med bagsiden af en ske, som er varmet i varmt vand."
    },
    {
      "section": "Til servering",
      "text": "Vend pærerne med honningen, og læg dem oven på havregrynene. Drys med chiafrø, kanel og pistaciekerner, og server."
    }
  ],
  "changes": [
    "Double cream er skiftet til piskefløde.",
    "Caster sugar er skiftet til almindeligt sukker."
  ]
}
