  "steps": [
    {
      "section": "Tomatsauce med chorizo",
      "text": "Varm en stor stegepande op ved svag til middel varme. Steg chorizoen, til den begynder at give fedt fra sig."
    },
    {
      "section": "Tomatsauce med chorizo",
      "text": "Tilsæt skalotteløg og en knivspids salt. Lad dem stege forsigtigt i 10 minutter under jævnlig omrøring, til de er bløde og glasagtige."
    },
    {
      "section": "Tomatsauce med chorizo",
      "text": "Rør hvidløget i og steg det 1 minut. Rør tomatpuréen i og lad den stege 2 minutter."
    },
    {
      "section": "Tomatsauce med chorizo",
      "text": "Hæld tomaterne i og mos dem med en grydeske. Smag til med salt og peber, og lad saucen simre svagt, mens du laver resten."
    },
    {
      "section": "Tomatsauce med chorizo",
      "text": "Vil du, kan du lade saucen simre på den indirekte side af grillen, mens auberginerne grilles. Brug i så fald en støbejernspande eller en grillpande i rustfrit stål, som tåler grillen."
    },
    {
      "section": "Grillede auberginer",
      "text": "Rør olie, honning, eddike og hvidløg sammen i en stor skål med salt og peber. Vend aubergineskiverne rundt i marinaden og lad dem stå."
    },
    {
      "section": "Grillede auberginer",
      "text": "Gør grillen klar til direkte varme. Grill auberginerne i 10 minutter med låg på, hvis grillen har et. Vend dem midtvejs, til de er brændte i kanten, røgede og møre."
    },
    {
      "section": "Grillede auberginer",
      "text": "Læg dem på et bræt og skær hver skive i fire stykker."
    },
    {
      "section": "Pasta og samling",
      "text": "Kog pastaen al dente i rigeligt letsaltet vand. Hæld vandet fra, men gem et glas af kogevandet."
    },
    {
      "section": "Pasta og samling",
      "text": "Kom pastaen i tomatsaucen og vend den godt rundt. Tilsæt en smule af kogevandet, hvis saucen skal være mere silkeblød."
    },
    {
      "section": "Pasta og samling",
      "text": "Vend auberginerne og parmesanen i, og rør rundt, til alt er varmt."
    },
    {
      "section": "Pasta og samling",
      "text": "Fordel pastaen i dybe tallerkener. Top med ekstra parmesan, ristet rasp, basilikum og en tår olivenolie."
    }
  ],
  "changes": [
