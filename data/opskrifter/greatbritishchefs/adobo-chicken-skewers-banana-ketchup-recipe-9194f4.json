  "steps": [
    {
      "section": "Marinade",
      "text": "Rør alle ingredienserne til marinaden sammen. Vend kyllingestykkerne i marinaden, og lad dem stå i køleskabet i mindst 30 minutter – gerne natten over."
    },
    {
      "section": "Bananketchup",
      "text": "Varm olien op i en gryde, og svits skalotteløgene i ca. 5 minutter, til de er bløde."
    },
    {
      "section": "Bananketchup",
      "text": "Tilsæt hvidløg, chili, ingefær, gurkemeje, allehånde og røget paprika. Steg det i 1 minut, til det dufter."
    },
    {
      "section": "Bananketchup",
      "text": "Rør resten af ingredienserne i, og bring det i kog. Skru ned på lav varme, læg låg på, og lad det simre i 15-20 minutter, til det er tykt. Lad det køle af."
    },
    {
      "section": "Bananketchup",
      "text": "Smag til med salt og peber, og blend det helt glat. Tynd det evt. ud med lidt vand. Hæld lidt i en lille skål til dip, og kom resten i en anden skål til at pensle med under grillningen."
    },
    {
      "section": "Glasur med brun farin",
      "text": "Kog alle ingredienserne op i en gryde, og lad dem simre i 5 minutter. Gem lidt glasur til sidst, og hæld resten i en skål til at pensle med under grillningen."
    },
    {
      "section": null,
      "text": "Lægger du træspyd i blød, så lad dem trække i vand i mindst 20 minutter og dryp dem af."
    },
    {
      "section": null,
      "text": "Træk kyllingen på spyddene, og sæt en limehalvdel for enden af hvert spyd, så kødet sidder fast."
    },
    {
      "section": null,
      "text": "Gør grillen klar til direkte varme ved middelhøj varme."
    },
    {
      "section": null,
      "text": "Pensl spyddene med lidt olie, og læg dem på grillen. Grill dem med låg på og udluftningen åben i 15-20 minutter. Vend dem hvert 2. minut, og pensl skiftevis med bananketchup og glasur. Flyt spyddene til en køligere zone, hvis de bliver for mørke. Kernetemperaturen skal være mindst 74 °C."
    },
    {
      "section": null,
      "text": "Grill imens limekinderne, til de har fået flot farve, og tag dem af."
    },
    {
      "section": null,
      "text": "Anret spyddene på et fad – kødet kan trækkes af spyddene, hvis du vil. Pensl med den reserverede glasur med en ren pensel, og drys med koriander. Server med de grillede limekinder og bananketchup til dip."
    }
  ],
  "changes": [
    "Bananskalotteløg er erstattet med skalotteløg."
  ]
}
