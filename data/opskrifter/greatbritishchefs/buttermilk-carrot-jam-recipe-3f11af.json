  "steps": [
    {
      "section": "Sprøde kagekrummer",
      "text": "Tænd ovnen på 50 °C. Fordel kagekrummerne på en bageplade, og lad dem tørre natten over, til de er helt sprøde."
    },
    {
      "section": "Sprøde kagekrummer",
      "text": "Opbevar krummerne i en tæt beholder, til de skal bruges."
    },
    {
      "section": "Gulerodssirup",
      "text": "Kom alle ingredienserne til sirup i en lille gryde, og lad dem koge ved middel varme, til væsken er tyknet og sirupsagtig."
    },
    {
      "section": "Gulerodssirup",
      "text": "Hæld sirupen på en sprayflaske eller klemmeflaske, og stil den på køl."
    },
    {
      "section": "Gulerodsmarmelade",
      "text": "Kom alle ingredienserne til marmeladen i en gryde, og varm dem langsomt op under jævnlig omrøring, til massen når 105 °C."
    },
    {
      "section": "Gulerodsmarmelade",
      "text": "Lad marmeladen køle af, og stil den tildækket på køl."
    },
    {
      "section": "Kærnemælksskum",
      "text": "Pisk alle ingredienserne til skummet sammen, til de er helt blandet."
    },
    {
      "section": "Kærnemælksskum",
      "text": "Hæld blandingen i en fløde­fl­aske til skum (sifon). Sæt gaspatron på lige før servering."
    },
    {
      "section": "Til servering",
      "text": "Kom en skefuld marmelade i bunden af hver skål, og top med mandelflager."
    },
    {
      "section": "Til servering",
      "text": "Sprøjt skummet ovenpå, så skålen bliver fyldt. Drys med de sprøde kagekrummer."
    },
    {
      "section": "Til servering",
      "text": "Dryp med gulerodssirup, og pynt til sidst med karse."
    }
  ],
