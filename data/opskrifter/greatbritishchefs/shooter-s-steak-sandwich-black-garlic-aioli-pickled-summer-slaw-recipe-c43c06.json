  "steps": [
    {
      "section": "Bøf, svampe og løg",
      "text": "Krydr bøfferne godt med salt og peber. Brun dem i en varm pande med olivenolie i 2 minutter på hver side, til kernetemperaturen er 55 °C (medium rare). Læg dem til hvile."
    },
    {
      "section": "Bøf, svampe og løg",
      "text": "Steg svampene i samme pande, til de er gyldne. Tilsæt mere olie efter behov, og smag til med salt. Tag dem af panden."
    },
    {
      "section": "Bøf, svampe og løg",
      "text": "Kom løgene på panden med lidt mere olie, hvis der er brug for det. Steg dem ved lav varme i 15-20 minutter, til de er bløde og gyldne."
    },
    {
      "section": "Aioli",
      "text": "Blend sort hvidløg, æggeblomme og sennep sammen i en blender med kande."
    },
    {
      "section": "Aioli",
      "text": "Lad blenderen køre, og hæld olien i en tynd stråle, til massen er tyk og blank. Rør citronsaft i, og smag til med salt. Stil på køl."
    },
    {
      "section": "Sandwich",
      "text": "Skær låget af brødet, og hul det ud, så der bliver plads til fyldet. Smør aioli indvendigt. Skær bøfferne i skiver, og læg lag på lag med rucola, bøf, peberrodscreme, svampe og løg."
    },
    {
      "section": "Sandwich",
      "text": "Sæt låget på, og pres sandwichen sammen. Pak den tæt ind, og stil den på køl i 6-8 timer med en vægt ovenpå."
    },
    {
      "section": "Kålsalat",
      "text": "Vend kål, gulerod og forårsløg med eddike, sukker og salt 20 minutter før servering. Lad salaten trække i 15 minutter."
    },
    {
      "section": "Kålsalat",
      "text": "Skær sandwichen i kiler. Server med kålsalaten og ekstra aioli ved siden af."
    }
  ],
