  "steps": [
    {
      "section": null,
      "text": "Kom kartofler, vand, citronsaft, hele hvidløgsfed og salt i en gryde. Bring det i kog, og lad det simre i 15-18 minutter, til kartoflerne næsten er møre."
    },
    {
      "section": null,
      "text": "Hæld vandet fra, og lad kartoflerne dampe af i et par minutter."
    },
    {
      "section": "Urteolie",
      "text": "Rør olie, persille, hvidløg, citronskal, citronsaft og oregano sammen i en skål. Du kan også blende det i en foodprocessor."
    },
    {
      "section": null,
      "text": "Gør grillen klar til direkte varme, eller varm en grillpande op på middelhøj varme."
    },
    {
      "section": null,
      "text": "Træk kartoflerne på metalspyd, og pensl dem med urteolie."
    },
    {
      "section": null,
      "text": "Grill spyddene i 10-12 minutter. Vend dem jævnligt, og pensl med mere urteolie undervejs, til kartoflerne er gyldne og har fået grillkant."
    },
    {
      "section": null,
      "text": "Brunes kartoflerne for hurtigt på grillen, så flyt dem om i en køligere zone."
    },
    {
      "section": null,
      "text": "Tag spyddene af varmen, og pensl dem med resten af urteolien."
    },
    {
      "section": "Til servering",
      "text": "Læg kartoflerne på et fad. Drys med feta, citronskal og hakkede krydderurter, og server med citronbåde."
    }
  ],
  "changes": [
