  "steps": [
    {
      "section": "Sauteret knoldselleri",
      "text": "Varm olien i en pande ved middel varme. Svits pølsen forsigtigt, til fedtet begynder at smelte ud. Den må ikke blive sprød."
    },
    {
      "section": "Sauteret knoldselleri",
      "text": "Vend knoldselleriet i fedtet, og steg det, til det er mørt. Tag panden af varmen."
    },
    {
      "section": "Sauteret knoldselleri",
      "text": "Rør et stænk eddike i, og hold blandingen varm, til den skal bruges."
    },
    {
      "section": "Eddikesmørsauce",
      "text": "Kom eddike, hvidvin, fiskefond og skalotteløg i en kasserolle. Lad det koge ved middel varme, til væsken er halveret."
    },
    {
      "section": "Eddikesmørsauce",
      "text": "Sænk varmen til lav. Pisk smørtern i, nogle få ad gangen, til saucen er glat og letbundet."
    },
    {
      "section": "Eddikesmørsauce",
      "text": "Sigt saucen gennem en finmasket si, så løget bliver tilbage. Smag til med salt, og stil den til side."
    },
    {
      "section": "Kammuslinger",
      "text": "Dup kammuslingerne tørre, og salt dem godt på alle sider."
    },
    {
      "section": "Kammuslinger",
      "text": "Varm olien i en støbejernspande ved høj varme, til den er varm, men ikke ryger. Læg kammuslingerne med den flade side nedad, og lad dem stege uberørt i 1½-2 minutter."
    },
    {
      "section": "Kammuslinger",
      "text": "Vend dem, og tilsæt smør og et stænk eddike. Øs smørret over muslingerne i 30 sekunder."
    },
    {
      "section": "Kammuslinger",
      "text": "Tag dem straks af panden. De skal have en dyb gyldenbrun skorpe og en let gennemsigtig midte."
    },
    {
      "section": "Kammuslinger",
      "text": "Anret en toppet spiseskefuld af selleri- og pølseblandingen i bunden af hver skål. Læg en kammusling ovenpå, og hæld saucen rundt om."
    }
  ],
  "changes": [
