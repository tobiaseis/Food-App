  "steps": [
    {
      "section": "Konfiteret hvidløg",
      "text": "Kom de hele hvidløgsfed, olien og en knivspids salt i en lille gryde. Varm op ved svag varme, og lad hvidløgene simre forsigtigt i 35-40 minutter, til de er bløde, lysegyldne og cremede. Stil til side."
    },
    {
      "section": "Ragù",
      "text": "Krydr oksekødet rigeligt med salt og peber. Varm en stor gryde op ved middelhøj varme med lidt olie, og brun kødet i omgange. Tag det op og stil det til side."
    },
    {
      "section": "Ragù",
      "text": "Svits løg, selleri og gulerødder i samme gryde i 10-12 minutter, til de er bløde, søde og let karamelliserede. Tilsæt evt. lidt mere olie. Rør hvidløget i og steg det 1-2 minutter, og steg derefter tomatpuréen med i 2 minutter."
    },
    {
      "section": "Ragù",
      "text": "Hæld rødvinen i og kog bunden løs. Tilsæt fond, hakkede tomater, laurbærblade og timian, og læg kødet tilbage i gryden. Lad det simre svagt uden låg i 2,5-3 timer. Rør af og til, til kødet falder fra hinanden, og saucen er tyk. Smag til med salt og peber."
    },
    {
      "section": "Gnocchi",
      "text": "Når ragùen er færdig, smeltes smørret i en bred pande ved middelvarme. Bruner det i ca. 8 minutter, til det er gyldent og dufter af nødder."
    },
    {
      "section": "Gnocchi",
      "text": "Kom salvie og gnocchi på panden. Steg under jævnlig omrøring, til gnocchien er gyldne og begynder at blive sprøde."
    },
    {
      "section": "Servering",
      "text": "Fordel gnocchien i skåle, og top med rigeligt ragù. Læg nogle konfiterede hvidløgsfed i hver portion, og dryss med revet parmesan."
    }
  ],
  "changes": [
    "Oksekød af skirt er erstattet med oksebov, som er nemmere at få og egner sig til langtidssimring."
  ]
}
