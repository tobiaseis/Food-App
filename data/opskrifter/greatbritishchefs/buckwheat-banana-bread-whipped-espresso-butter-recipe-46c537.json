  "steps": [
    {
      "section": "Bananbrød",
      "text": "Tænd ovnen på 180 °C (160 °C varmluft). Beklæd en brødform med bagepapir."
    },
    {
      "section": "Bananbrød",
      "text": "Blend de 5 bananer til dejen med æg og det smeltede smør, til det er en jævn masse."
    },
    {
      "section": "Bananbrød",
      "text": "Bland begge slags mel, salt, bagepulver, kanel, farin og sukker i en stor skål. Rør ¾ af pekannødderne i."
    },
    {
      "section": "Bananbrød",
      "text": "Hæld bananmassen lidt ad gangen i de tørre ingredienser under omrøring, til dejen er glat."
    },
    {
      "section": "Bananbrød",
      "text": "Kom dejen i formen og glat overfladen. Læg banan-halvdelene øverst med snitfladen opad, og drys de resterende pekannødder over."
    },
    {
      "section": "Bananbrød",
      "text": "Bag brødet i 50-60 minutter, til det er gyldent, og en spiddet pind kommer ren op. Lad det hvile i formen i 5 minutter, og løft det så over på en rist, hvor det køler helt af."
    },
    {
      "section": "Espressosmør",
      "text": "Pisk smør, farin og espresso i en stor skål eller røremaskinen, til smørret er lyst og luftigt."
    },
    {
      "section": "Espressosmør",
      "text": "Rist skiver af bananbrødet, og smør dem rigeligt med espressosmørret."
    }
  ],
