  "steps": [
    {
      "section": "Tortilladej",
      "text": "Bland mel, salt og bagepulver i en stor skål. Rør smør og lunkent vand i lidt ad gangen, til dejen er blød."
    },
    {
      "section": "Tortilladej",
      "text": "Ælt dejen i 5-6 minutter, til den er glat. Dæk den til og lad den hvile i 20 minutter."
    },
    {
      "section": "Æggemayo",
      "text": "Kog de 6 æg i 9 minutter, og afkøl dem straks i iskoldt vand. Pil dem, og skil blommer fra hvider."
    },
    {
      "section": "Æggemayo",
      "text": "Mos de kogte blommer i en skål, og hak hviderne fint."
    },
    {
      "section": "Æggemayo",
      "text": "Pisk den rå æggeblomme med Dijon-sennep og eddike i en anden skål eller i en blender."
    },
    {
      "section": "Æggemayo",
      "text": "Tilsæt olien dråbevis, og øg til en jævn stråle, mens du pisker hele tiden, så det emulgerer."
    },
    {
      "section": "Æggemayo",
      "text": "Rør citronsaft, røget paprika, engelsk sennep og evt. cayennepeber i den tykke mayo. Vend de moste blommer og de hakkede hvider i, og smag til med salt og peber."
    },
    {
      "section": "Sennepsfrøsalat",
      "text": "Vend kål, gulerod og rødløg med eddike og en knivspids salt. Lad det stå i 10 minutter, så det syrnes let."
    },
    {
      "section": "Sennepsfrøsalat",
      "text": "Rist imens sennepsfrøene på en tør pande, til de begynder at poppe. Hæld olien på, og varm den et par sekunder."
    },
    {
      "section": "Sennepsfrøsalat",
      "text": "Hæld den varme sennepsfrøolie over salaten, og vend den godt. Lad den dryppe af i et sigte."
    },
    {
      "section": "Tortillaerne",
      "text": "Del dejen i fire kugler, og rul hver af dem tyndt ud til en rund plade på 22 cm."
    },
    {
      "section": "Tortillaerne",
      "text": "Varm en tør pande eller grillpande op ved middelhøj varme. Bag hver tortilla 30-60 sekunder på hver side, til den er let brunet og har hævet sig enkelte steder. Hold dem varme i et rent viskestykke."
    },
    {
      "section": "Samling",
      "text": "Læg en varm tortilla fladt, og kom en rigelig portion æggemayo ned ad midten. Top med sennepsfrøsalat og en tot karse."
    },
    {
      "section": "Samling",
      "text": "Fold højre og venstre side ind over fyldet. Træk den nederste kant stramt over fyldet med tommelfingrene, og rul wrappen fast sammen som en burrito."
    },
    {
      "section": "Samling",
      "text": "Klip et stykke bagepapir lidt større end tortillaen. Læg wrappen med samlingen nedad på papiret, fold siderne ind, og rul den stramt sammen som en knallert. Gentag med et stykke alufolie ovenpå papiret. Så holder wrappen sig varm og pæn, og den er perfekt til picnic."
    }
  ],
