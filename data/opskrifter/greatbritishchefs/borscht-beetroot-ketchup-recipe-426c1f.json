  "steps": [
    {
      "section": null,
      "text": "Kom rødbeder, hvidløg, allehånde, vand, balsamico, salt, hvid peber og cayennepeber i en blender. Kør det, til det er næsten helt glat."
    },
    {
      "section": null,
      "text": "Hæld massen over i en gryde ved middel-lav varme, og rør brun farin i."
    },
    {
      "section": null,
      "text": "Bring det i kog, så det simrer. Lad det koge uden låg i 30 minutter, og rør af og til, til ketchuppen er tyknet og reduceret."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber efter behov. Lad ketchuppen køle af."
    },
    {
      "section": "Til servering",
      "text": "Kom ketchuppen i en skål, og top med creme fraiche og purløg. Server som dip til chips eller som tilbehør til sandwich og andre retter."
    },
    {
      "section": "Til servering",
      "text": "Opbevar den tildækket i køleskabet i op til en uge."
    }
  ],
