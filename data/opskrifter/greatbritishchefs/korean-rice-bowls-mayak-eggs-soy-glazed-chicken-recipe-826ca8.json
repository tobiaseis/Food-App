  "steps": [
    {
      "section": "Mayak-æg",
      "text": "Lav æggene dagen før. Bring en gryde vand i let kog, og læg æggene forsigtigt i. Kog dem i 6 minutter."
    },
    {
      "section": "Mayak-æg",
      "text": "Flyt æggene straks over i isvand, og lad dem køle helt af."
    },
    {
      "section": "Mayak-æg",
      "text": "Rør alle de øvrige ingredienser til mayak-æggene sammen i en skål eller en beholder til en marinade."
    },
    {
      "section": "Mayak-æg",
      "text": "Pil æggene, og læg dem helt ned i marinaden. Sæt låg på, og stil dem på køl natten over – mindst 6 timer. Jo længere de ligger, jo mere trækker soja ind i blommen, og jo blødere bliver den."
    },
    {
      "section": "Soja-glaseret kylling",
      "text": "Rør alle ingredienser til glaseringen sammen i en skål – kyllingen venter. Vend derefter kyllingestrimlerne i, og lad dem marinere i 20 minutter."
    },
    {
      "section": "Chilliris",
      "text": "Kog risene efter anvisningen på pakken. Vend chiliolie, sesamolie og salt i, og hold risene varme."
    },
    {
      "section": "Syltet agurk",
      "text": "Rør eddike, sukker og salt sammen i en lille skål, til sukker og salt er opløst. Vend agurkeskiverne i, og stil dem til side."
    },
    {
      "section": "Gochujang-mayo",
      "text": "Rør alle ingredienserne til mayoen sammen, og smag til med salt og peber. Stil den til side."
    },
    {
      "section": "Soja-glaseret kylling",
      "text": "Varm en pande op ved middelhøj til høj varme med en smule olie. Si kyllingen fra marinaden, men gem marinaden."
    },
    {
      "section": "Soja-glaseret kylling",
      "text": "Læg kyllingen i ét lag på panden, og steg den i 10-15 minutter. Vend den halvvejs, til den er gennemstegt."
    },
    {
      "section": "Soja-glaseret kylling",
      "text": "Hæld den gemte marinade over, og lad den simre ind til en blank glasur, der hænger ved kødet."
    },
    {
      "section": "Servering",
      "text": "Fordel ris i skåle, og hæld lidt af mayak-marinaden over (resten kan bruges til andre retter). Læg kylling, avocadoskiver og syltet agurk ovenpå."
    },
    {
      "section": "Servering",
      "text": "Dryp med gochujang-mayo, og drys med forårsløg, sesamfrø og limeskal. Skær mayak-æggene over, og læg dem på."
    },
    {
      "section": "Servering",
      "text": "Lad blommen løbe ud og blande sig med chiliolien og glasuren, så der opstår en rig sauce."
    }
  ],
