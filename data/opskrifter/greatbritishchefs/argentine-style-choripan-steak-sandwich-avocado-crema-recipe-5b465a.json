  "steps": [
    {
      "section": "Syltet rødløg",
      "text": "Læg de tynde rødløg i en skål, og hæld rødvinseddike over, så de er dækket. Lad dem trække, mens resten laves."
    },
    {
      "section": "Kød og sandwich",
      "text": "Varm olivenolien op på en pande. Steg bøfferne ca. 2 minutter på hver side, til de er medium-rare (kernetemperatur 55 °C). Tag dem af panden, og lad dem hvile."
    },
    {
      "section": "Kød og sandwich",
      "text": "Steg chorizoen på samme pande, til den er sprød og gennemstegt."
    },
    {
      "section": "Chimichurri",
      "text": "Rør persille, hvidløg, chili, oregano, eddike og olie sammen. Smag til med salt, og justér med mere salt, olie eller eddike efter behov."
    },
    {
      "section": "Avocadocreme",
      "text": "Blend avocado, limesaft og creme fraiche glat. Smag til med salt og peber, og stil cremen på køl, til den skal bruges."
    },
    {
      "section": "Majssalat",
      "text": "Brun majs og squash i olivenolie på en pande, til de er møre og har fået farve. Vend dem med limesaft og koriander, og smag til med salt."
    },
    {
      "section": "Samling",
      "text": "Del bollerne, og smør avocadocreme på. Fordel chorizo, skåret bøf, syltet rødløg og chimichurri over."
    },
    {
      "section": "Samling",
      "text": "Server sandwichene med den lune salat og ekstra chimichurri ved siden af."
    }
  ],
