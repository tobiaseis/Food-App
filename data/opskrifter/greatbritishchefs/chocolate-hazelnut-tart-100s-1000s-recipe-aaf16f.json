  "steps": [
    {
      "section": "Chokoladecremoso",
      "text": "Varm fløden op til lige under kogepunktet. Pisk imens sukker og æggeblommer godt sammen. Kom den hakkede chokolade i en stor skål."
    },
    {
      "section": "Chokoladecremoso",
      "text": "Hæld den varme fløde i æggemassen lidt ad gangen, mens du pisker. Kom det hele tilbage i gryden, og varm under konstant piskning til 83 °C, så blandingen ikke skiller."
    },
    {
      "section": "Chokoladecremoso",
      "text": "Si cremen gennem en fin si ned over chokoladen, og pisk, til chokoladen er smeltet. Smag til med lidt salt, og stil den kold, til den er stivnet."
    },
    {
      "section": "Kakaomørdej",
      "text": "Sæt ovnen på 170 °C. Pisk smørret luftigt i en røremaskine. Tilsæt flormelis og salt lidt efter lidt, og pisk, til det er lyst og let."
    },
    {
      "section": "Kakaomørdej",
      "text": "Pisk æggeblommer og vaniljeekstrakt i, til massen er glat. Tag skålen af maskinen."
    },
    {
      "section": "Kakaomørdej",
      "text": "Bland mel og kakao i en anden skål. Ælt det tørre sammen med smørblandingen med hænderne, til det hele er ensartet. Form dejen til en rulle, og lad den hvile i køleskabet i mindst 30 minutter."
    },
    {
      "section": "Kakaomørdej",
      "text": "Rul dejen ud i 0,5 cm tykkelse, og beklæd 8 små tærteforme eller 1 stor form. Bag i 10-15 minutter, til bunden er tør og mør at røre ved. Lad tærteskallerne køle helt af."
    },
    {
      "section": "Vallekaramel",
      "text": "Kog vallen op i en bred mellemstor gryde, og lad den koge ind til det halve."
    },
    {
      "section": "Vallekaramel",
      "text": "Rør farin og smør i, og kog videre, til karamellen når 112-113 °C. Si den over i en stor skål."
    },
    {
      "section": "Vallekaramel",
      "text": "Lad karamellen køle af, og pisk jævnligt i den, så den ikke skiller. Smag til, når den er kold, og fyld den i en sprøjtepose. Stil den i køleskabet."
    },
    {
      "section": "Hasselnøddekrymmel",
      "text": "Bring sukker, smør, glukosesirup og vand i kog ved middel varme."
    },
    {
      "section": "Hasselnøddekrymmel",
      "text": "Kom hasselnødderne i, og kog, til massen er lys karamel. Tag af varmen, og rør straks salt og natron i."
    },
    {
      "section": "Hasselnøddekrymmel",
      "text": "Hæld massen ud på bagepapir på et varmefast underlag, og lad den køle helt af. Hak den groft."
    },
    {
      "section": "Knitrende topping",
      "text": "Lav først en hasselnødkrokant: Bring sukker, smør, glukosesirup og vand i kog ved middel varme. Kom hasselnødderne i, og kog, til det er lys karamel."
    },
    {
      "section": "Knitrende topping",
      "text": "Tag af varmen, og rør salt og natron i. Hæld ud på bagepapir på et varmefast underlag, og lad den køle helt af."
    },
    {
      "section": "Knitrende topping",
      "text": "Hak den kolde krokant fint. Afvej lidt over halvdelen, og gem resten til en anden ret. Bland med feuilletine, kakaonibs og popping candy, og opbevar i en tæt beholder."
    },
    {
      "section": "Anretning",
      "text": "Tag vallekaramel og cremoso ud af køleskabet 20-30 minutter før servering, så de får lidt temperatur. Cremosoen kan blive ret fast."
    },
    {
      "section": "Anretning",
      "text": "Sæt tærteskallerne på tallerkener, og fastgør dem med en klat karamel. Sprøjt karamel i bunden af hver skal, og glat overfladen med en paletkniv."
    },
    {
      "section": "Anretning",
      "text": "Sprøjt eller kom cremosoen i skallerne. Drys rigeligt med den knitrende topping og hasselnøddekrymmel, og server."
    }
  ],
  "changes": [
    "Double cream er skiftet til piskefløde.",
    "Liquid glucose er skiftet til glukosesirup.",
    "Bicarbonate of soda er skiftet til natron."
  ]
}
