  "steps": [
    {
      "section": "Marineret kylling",
      "text": "Tænd ovnen på 190 °C varmluft."
    },
    {
      "section": "Marineret kylling",
      "text": "Rør yoghurt, ingefær, hvidløg, gurkemeje, garam masala, spidskommen, bukkehornsblade, citronsaft og olie sammen til en marinade, og smag til med salt og peber."
    },
    {
      "section": "Marineret kylling",
      "text": "Skær overskydende fedt af kyllingelårene, og del dem i store stykker. Vend dem i marinaden, og lad dem trække i køleskabet i 1–2 timer."
    },
    {
      "section": "Ristet græskar",
      "text": "Vend græskarternene med olie, spidskommen, koriander, salt og peber i et ildfast fad."
    },
    {
      "section": "Ristet græskar",
      "text": "Rist dem i ovnen i 30–40 minutter, til de er møre og har fået lidt farve i kanterne."
    },
    {
      "section": "Rødbede- og løgsalat",
      "text": "Bland løg, rødbeder, chili og koriander med chaat masala, cayennepeber og stødt koriander."
    },
    {
      "section": "Rødbede- og løgsalat",
      "text": "Tilsæt citronsaft, smag til med salt og peber, og vend det hele igen. Dæk salaten, og sæt den på køl til servering."
    },
    {
      "section": "Makhani-sauce",
      "text": "Svits løget i halvdelen af olien ved middel varme i 10–15 minutter, til det er blødt og let gyldent."
    },
    {
      "section": "Makhani-sauce",
      "text": "Kom løg, tomater og cashewnødder i en blender, og kør dem til en glat masse. Tilsæt lidt af udblødningsvandet, hvis massen er for tyk."
    },
    {
      "section": "Makhani-sauce",
      "text": "Varm en stor pande op ved middel varme med resten af olien. Brun kyllingestykkerne et par minutter på hver side. De skal ikke være gennemstegte endnu. Læg dem over på en tallerken."
    },
    {
      "section": "Makhani-sauce",
      "text": "Sæt panden tilbage på varmen med en smule olie. Når olien er varm, kommer de hele krydderier i."
    },
    {
      "section": "Makhani-sauce",
      "text": "Når krydderierne syder, tilsættes hvidløg, ingefær og chili. Sænk varmen, og steg i ca. 2 minutter, uden at hvidløget tager farve."
    },
    {
      "section": "Makhani-sauce",
      "text": "Tag panden af varmen, og rør de stødte krydderier i. Lad dem stege med i et minuts tid, og hæld så tomat- og cashewmassen i."
    },
    {
      "section": "Makhani-sauce",
      "text": "Rør godt rundt, og tilsæt sukker, salt og peber. Lad saucen simre med låget halvt på i 15–20 minutter, til den er tyknet og reduceret. Tilsæt en sjat vand, hvis den koger for hurtigt ind."
    },
    {
      "section": "Gurkemejeris",
      "text": "Smelt ghee ved middel varme i en gryde, og steg ingefær og hvidløg i ca. 1 minut. Hvidløget må ikke brune."
    },
    {
      "section": "Gurkemejeris",
      "text": "Rist garam masala, peber og gurkemeje i fedtstoffet. Hæld vandet fra risene, og kom dem i gryden. Skru op til middelhøj varme, og rør forsigtigt i ca. 2 minutter, så kornene holder sig hele."
    },
    {
      "section": "Gurkemejeris",
      "text": "Hæld bouillon og salt i, og bring det i kog. Læg et viskestykke og et låg over gryden. Kog ved middel varme i ca. 10 minutter, og sluk så for varmen. Lad risene dampe i yderligere 10 minutter."
    },
    {
      "section": "Makhani-sauce",
      "text": "Fisk de hele krydderier op af saucen, og smid dem ud."
    },
    {
      "section": "Makhani-sauce",
      "text": "Kom den forstegte kylling tilbage i saucen. Tilsæt lidt vand, hvis saucen er meget tyk."
    },
    {
      "section": "Makhani-sauce",
      "text": "Læg låg på, og lad retten simre i 5–7 minutter, til kyllingen er mør og gennemstegt."
    },
    {
      "section": "Makhani-sauce",
      "text": "Vend det ristede græskar i, og varm det igennem. Rør bukkehornsbladene i, og smag til med salt og peber. Tag gryden af varmen, og rør fløde, smør og koriander i."
    },
    {
      "section": "Til servering",
      "text": "Luft risene op med en gaffel. Server dem med kylling makhani, græskar og rødbedesalat. Top med en klat yoghurt og korianderbladene."
    }
  ],
  "changes": [
