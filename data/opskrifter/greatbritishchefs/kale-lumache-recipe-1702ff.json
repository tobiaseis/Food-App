  "steps": [
    {
      "section": "Grønkålssauce",
      "text": "Skær bladene af grønkålen, og gem stilkene. Bring en stor gryde vand i kog med rigeligt salt."
    },
    {
      "section": "Grønkålssauce",
      "text": "Varm olie og hvidløg op i en mindre gryde ved lav varme. Lad hvidløget trække og blive blødt uden at brune. Tag hvidløget op og kassér det."
    },
    {
      "section": "Grønkålssauce",
      "text": "Kog stilkene 2 minutter i det kogende vand. Tilsæt bladene, og kog dem 1-2 minutter, til de lige er møre. Si grønkålen fra, og lad den køle af."
    },
    {
      "section": "Grønkålssauce",
      "text": "Blend den afkølede grønkål med hvidløgsolien i en kraftig blender, til du har en glat pasta."
    },
    {
      "section": "Pasta",
      "text": "Kog pastaen efter anvisningen på posen. Si den, og gem 1 dl af kogevandet."
    },
    {
      "section": "Pasta",
      "text": "Smelt smørret i en stor pande, og rør grønkålspastaen i. Vend den kogte pasta med. Tynd saucen ud med lidt af kogevandet, hvis den er for tyk."
    },
    {
      "section": "Pasta",
      "text": "Pres citronsaft i efter smag, og smag til med salt."
    },
    {
      "section": "Til servering",
      "text": "Anret på tallerkener, og drys med peber, parmesan og chiliflager."
    }
  ],
  "changes": [
    "Cavolo nero og krølkål er erstattet af grønkål."
  ]
