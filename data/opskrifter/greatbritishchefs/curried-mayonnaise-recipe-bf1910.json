  "steps": [
    {
      "section": null,
      "text": "Pisk æggeblomme, sennep, citronsaft, garam masala og gurkemeje sammen i en skål."
    },
    {
      "section": null,
      "text": "Hæld olien i en helt tynd stråle ned i blommeblandingen, mens du pisker hele tiden. Skålen glider let rundt – stil den på et par fugtige viskestykker, så den står fast."
    },
    {
      "section": null,
      "text": "Når blandingen begynder at tykne og binde, kan du hælde olien i lidt hurtigere."
    },
    {
      "section": null,
      "text": "Smag til med rigeligt salt og peber. Drys med chiliflager og server."
    }
  ],
  "changes": [
    "Vegetable oil er erstattet med rapsolie."
  ]
