  "steps": [
    {
      "section": "Rissorbet",
      "text": "Kom risene og vandet i en gryde med låg, og kog dem på høj varme i cirka 10 minutter, til risene lige er møre."
    },
    {
      "section": "Rissorbet",
      "text": "Hæld risene over en fin sigte og opsaml kogevandet i en skål under sigten."
    },
    {
      "section": "Rissorbet",
      "text": "Blend de afdryppede ris med sukker, glukosesirup, vodka og salt, til massen er helt glat."
    },
    {
      "section": "Rissorbet",
      "text": "Rør xanthangummi og olivenolie sammen. Pisk kogevandet i lidt ad gangen, og pisk grundigt mellem hver tilsætning."
    },
    {
      "section": "Rissorbet",
      "text": "Vend den blendede risblanding i og stil det hele på køl, til det er helt afkølet."
    },
    {
      "section": "Rissorbet",
      "text": "Kør blandingen i en ismaskine, og opbevar sorbeten i fryseren, til den skal bruges."
    },
    {
      "section": "Risengrød",
      "text": "Bring fløde og mælk i kog i en gryde, og skru ned til svag kog."
    },
    {
      "section": "Risengrød",
      "text": "Tilsæt brun farin, laurbærblade og salt. Lad det simre ved lav varme under jævnlig omrøring, til væsken er kogt cirka en tredjedel ind."
    },
    {
      "section": "Risengrød",
      "text": "Kom risene i og kog videre i 45 minutter, mens du rører jævnligt. Risene skal være bløde, men stadig holde formen."
    },
    {
      "section": "Risengrød",
      "text": "Gør grøden forholdsvis tynd, for risene suger mere væske til sig, når gryden er taget af varmen."
    },
    {
      "section": "Rabarber",
      "text": "Imens risene koger: Bring sukker og vand i kog i en gryde, og skru ned til en jævn simren."
    },
    {
      "section": "Rabarber",
      "text": "Læg rabarberne i og kog dem i 20 sekunder. Sluk for varmen og læg låg på, så rabarberne bliver færdige i den resterende varme, mens grøden gør sig færdig."
    },
    {
      "section": "Til servering",
      "text": "Anret den lune risengrød i skåle. Top med rabarber og en kugle risensorbet, og dryp med lidt honning."
    }
  ],
  "changes": [
    "Japansk kortkornet ris er erstattet af sushiris."
  ]
