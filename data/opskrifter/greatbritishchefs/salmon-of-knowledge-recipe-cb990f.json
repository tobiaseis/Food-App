  "steps": [
    {
      "section": "Husets vinaigrette",
      "text": "Rør alle ingredienserne sammen i en skål sammen med en knivspids salt. Dæk skålen til, og lad den stå ved stuetemperatur i 3 dage, så smagen trækker."
    },
    {
      "section": "Husets vinaigrette",
      "text": "Si væsken gennem en fin sigte og over i en flaske eller et glas. Ryst eller pisk, til den er bundet. Smag til med mere salt og sukker, hvis den har brug for det."
    },
    {
      "section": "Gribiche",
      "text": "Blend æggeblommer, sennep og hvidløg glatte i en lille foodprocessor. Hold maskinen kørende, og hæld olien i en tynd stråle, til saucen er tyk og emulgeret."
    },
    {
      "section": "Gribiche",
      "text": "Vend resten af ingredienserne i, og smag til. Stil saucen på køl, til den skal bruges."
    },
    {
      "section": "Citrongel",
      "text": "Kom alle ingredienserne i en lille gryde, og bring det i kog. Lad massen køle af, og pisk i den ind imellem. Fyld den derefter på en sprøjtepose eller klemmeflaske."
    },
    {
      "section": "Samling",
      "text": "Pil de yderste 4-5 blade af hver hjertesalat, så kun hjertet er tilbage. Skær rodenden til, og fjern misfarvede dele. Skær toppen af, så lagene åbner sig."
    },
    {
      "section": "Samling",
      "text": "Vend salaterne i lidt af vinaigretten. Sprøjt gribichen ind mellem bladene, og kom så langt ned mod roden som muligt."
    },
    {
      "section": "Samling",
      "text": "Drys rigeligt dulsepulver over salaterne, og sprøjt klatter af citrongel udenpå. Pynt med dild og kornblomster."
    }
  ],
