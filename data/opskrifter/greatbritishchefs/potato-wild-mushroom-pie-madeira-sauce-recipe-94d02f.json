  "steps": [
    {
      "section": "Til tærten",
      "text": "Kog kartoffeltern i letsaltet vand i 8–10 minutter, til de er møre. Hæld vandet fra og lad dem stå."
    },
    {
      "section": "Til tærten",
      "text": "Varm olie og smør op på en pande. Svits skalotteløg og hvidløg, til de er bløde."
    },
    {
      "section": "Til tærten",
      "text": "Tilsæt champignon og timian, og steg ved middelhøj varme, til svampene har afgivet væde og er gyldne."
    },
    {
      "section": "Til tærten",
      "text": "Vend kartoflerne, fløden og parmesan i panden. Smag til med salt og peber, og rør persillen i."
    },
    {
      "section": "Til tærten",
      "text": "Lad fyldet køle helt af."
    },
    {
      "section": "Til tærten",
      "text": "Sæt ovnen på 200 °C varmluft."
    },
    {
      "section": "Til tærten",
      "text": "Rul butterdejen ud på et let meldrysset bord. Skær to cirkler: en på 22 cm og en på 24 cm."
    },
    {
      "section": "Til tærten",
      "text": "Læg den lille cirkel på en bageplade med bagepapir. Fordel det kolde fyld i en bunke midt på, og lad en kant på 2 cm være fri. Pensl kanten med æggeblandingen."
    },
    {
      "section": "Til tærten",
      "text": "Læg den store cirkel over, og tryk kanterne godt sammen. Lav bølger i kanten med knivens bagside, og rids et spiralmønster i toppen."
    },
    {
      "section": "Til tærten",
      "text": "Pensl rigeligt med æggeblanding, og drys med saltflager."
    },
    {
      "section": "Til tærten",
      "text": "Bag i 30–35 minutter, til tærten er hævet, gylden og blank."
    },
    {
      "section": "Til sauce",
      "text": "Imens: Svits skalotteløg, hvidløg og timian forsigtigt i olien, til løgene er bløde."
    },
    {
      "section": "Til sauce",
      "text": "Hæld portvinen i, og lad den koge ind til det halve."
    },
    {
      "section": "Til sauce",
      "text": "Tilsæt fonden, bring i kog, og lad saucen koge ind, til den tykner."
    },
    {
      "section": "Til sauce",
      "text": "Rør fløden i, og pisk smørret ud i saucen. Si den gennem en fin si."
    },
    {
      "section": "Servering",
      "text": "Anret tærten på et bræt eller fad, og pynt med timian og persilleblade. Skær den i skiver, og server med saucen ved siden af."
    }
  ],
  "changes": [
    "Blandede vilde svampe er skiftet til champignon.",
    "Madeira er skiftet til portvin.",
    "Butterdej af ren smør er skiftet til almindelig butterdej."
  ]
