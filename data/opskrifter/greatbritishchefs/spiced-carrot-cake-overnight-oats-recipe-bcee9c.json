  "steps": [
    {
      "section": "Overnight oats",
      "text": "Rør havregryn, gulerødder, honning, chiafrø, krydderier og mælk grundigt sammen i en skål."
    },
    {
      "section": "Overnight oats",
      "text": "Fordel blandingen i seks bægre eller glas, dæk til og sæt dem på køl natten over."
    },
    {
      "section": "Muskatkrymmel",
      "text": "Tænd ovnen på 170 °C næste morgen."
    },
    {
      "section": "Muskatkrymmel",
      "text": "Kom nødder og havregryn på en bageplade med bagepapir. Fordel smørternene ovenpå, drys med muskatnød og salt, og vend det hele sammen med hænderne."
    },
    {
      "section": "Muskatkrymmel",
      "text": "Rist krymmelen i ovnen i ca. 15 minutter, til den er gylden."
    },
    {
      "section": "Yoghurtcreme",
      "text": "Pisk yoghurten luftig med en håndmixer, og pisk derefter vaniljepastaen i."
    },
    {
      "section": "Yoghurtcreme",
      "text": "Tilsæt flormelis lidt ad gangen, mens du pisker. Fyld cremen i en sprøjtepose med stjernetud."
    },
    {
      "section": "Til servering",
      "text": "Tag bægrene ud af køleskabet og sprøjt yoghurtcreme ovenpå."
    },
    {
      "section": "Til servering",
      "text": "Top med muskatkrymmel, lidt chiafrø og en smule muskatnød. Dryp med honning og læg bananskiver på."
    }
  ],
  "changes": []
