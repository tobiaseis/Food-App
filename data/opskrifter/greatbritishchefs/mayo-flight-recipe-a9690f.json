  "steps": [
    {
      "section": "Persillemayonnaise",
      "text": "Kør persille og olie sammen i en blender eller foodprocessor, til olien er grøn."
    },
    {
      "section": "Persillemayonnaise",
      "text": "Hæld den grønne olie i en gryde og lad den småkoge, så farven fæstner. Si den derefter gennem en fin si beklædt med osteklæde eller køkkenrulle ned i en skål."
    },
    {
      "section": "Persillemayonnaise",
      "text": "Lad olien dryppe igennem i sit eget tempo. Presser du på, bliver den uklar."
    },
    {
      "section": "Persillemayonnaise",
      "text": "Pisk æggeblomme, sennep og citronsaft sammen i en skål. Stil skålen på nogle fugtige viskestykker, så den står stabilt."
    },
    {
      "section": "Persillemayonnaise",
      "text": "Når olien er sivet igennem og afkølet, pisk den i blommeblandingen i en helt tynd stråle under konstant piskning."
    },
    {
      "section": "Persillemayonnaise",
      "text": "Når massen begynder at tykne, kan olien komme lidt hurtigere i. Smag til med rigeligt salt og peber, og stil den på køl."
    },
    {
      "section": "Chorizomayonnaise",
      "text": "Hæld olien i en gryde, og læg chorizoskiverne i. Varm langsomt op, til det syder, og lad det stege, til chorizoen er sprød og olien er rød."
    },
    {
      "section": "Chorizomayonnaise",
      "text": "Tag chorizoen op med en hulske og stil den til side. Lad olien køle af."
    },
    {
      "section": "Chorizomayonnaise",
      "text": "Pisk æggeblomme, sennep og citronsaft sammen. Pisk den kolde olie i lidt ad gangen, og smag til med salt og peber. Stil på køl."
    },
    {
      "section": "Cocktailsauce",
      "text": "Lav en mayonnaise af æggeblomme, sennep, citronsaft og olie på samme måde som før. Rør ketchup, paprika og cayennepeber i, og stil den på køl."
    },
    {
      "section": "Karrymayonnaise",
      "text": "Pisk æggeblomme, sennep, citronsaft, garam masala og gurkemeje sammen. Pisk olien i lidt ad gangen, smag til med salt og peber, og stil på køl."
    },
    {
      "section": "Klassisk mayonnaise",
      "text": "Pisk æggeblomme, sennep og citronsaft sammen. Tilsæt olien gradvist under piskning, smag til med salt og peber, og stil på køl."
    },
    {
      "section": "Til servering",
      "text": "Fordel de fem mayonnaiser i små skåle. Pynt persillemayonnaisen med persilleblade og chorizomayonnaisen med noget af den sprøde chorizo og lidt chiliflager."
    },
    {
      "section": "Til servering",
      "text": "Drys cayennepeber over cocktailsaucen, sort peber over den klassiske og en knivspids chiliflager over karrymayonnaisen."
    },
    {
      "section": "Til servering",
      "text": "Stil skålene på et stort bræt, og læg grøntsagerne rundt om."
    }
  ],
  "changes": []
