  "steps": [
    {
      "section": "Krydderirub",
      "text": "Varm en stor gryde med låg op ved middelvarme. Rist alle frøene med salt og peber, til de dufter kraftigt."
    },
    {
      "section": "Krydderirub",
      "text": "Tag frøene af gryden, og stød dem til pulver i en mortér. Bland med den røgede paprika, og stil til side."
    },
    {
      "section": "Lammet",
      "text": "Varm ovnen op til 140 °C. Smør lammeboven over det hele med sennep, og gnid den derefter ind i krydderiblandingen."
    },
    {
      "section": "Braiseringen",
      "text": "Sæt gryden tilbage på middelhøj varme med olien. Når olien ryger, brunes artiskokhjerterne til de er gyldne."
    },
    {
      "section": "Braiseringen",
      "text": "Skru ned for varmen, og svits rødløgene, til de er bløde uden at få farve."
    },
    {
      "section": "Braiseringen",
      "text": "Rør hvidløget i, og steg det et minut. Drys melet over, og rør rundt i et halvt minut. Rør harissaen ind."
    },
    {
      "section": "Braiseringen",
      "text": "Skru op for varmen, hæld rødvinen i, og lad den koge ind til det halve."
    },
    {
      "section": "Braiseringen",
      "text": "Tilsæt fonden sammen med rosmarin, timian og laurbærblad. Læg lammeboven oven på, sæt låg på, og stil gryden i ovnen i ca. 5 timer."
    },
    {
      "section": "Braiseringen",
      "text": "Tag låget af, og lad kødet stå i ovnen i endnu en time. Det er færdigt, når det falder fra hinanden."
    },
    {
      "section": "Braiseringen",
      "text": "Øs det meste af det udsmeltede fedt af saucen. Fjern og kassér derefter knogler og urtestilke."
    },
    {
      "section": "Braiseringen",
      "text": "Pluk kødet i stykker med to gafler, og fjern sener. Vend det tilbage i saucen."
    },
    {
      "section": "Til servering",
      "text": "Smag til med salt og peber, og drys med hakket koriander."
    }
  ],
