  "steps": [
    {
      "section": "Panna cotta",
      "text": "Varm mælk, fløde, sukker og figenblade langsomt op i en gryde, til det lige akkurat simrer. Tag gryden af varmen, og lad blandingen trække i 30 minutter."
    },
    {
      "section": "Panna cotta",
      "text": "Si blandingen over i en ren gryde, og kassér bladene."
    },
    {
      "section": "Panna cotta",
      "text": "Lad fløden koge sagte ved middelhøj varme i cirka 5 minutter. Pres vandet af husblassen, og pisk den ud i den varme fløde, til den er opløst."
    },
    {
      "section": "Panna cotta",
      "text": "Rør honningen i, og fordel massen i forme. Lad dem stå fremme i cirka 30 minutter, og sæt dem derefter i køleskabet i 6 timer."
    },
    {
      "section": "Brændt honning og figenchutney",
      "text": "Kom honningen i en gryde ved middelhøj varme, og lad den boble, til den er mørk og karamelliseret."
    },
    {
      "section": "Brændt honning og figenchutney",
      "text": "Pisk forsigtigt eddiken ned i honningen. Tilsæt figner, rosiner og salt."
    },
    {
      "section": "Brændt honning og figenchutney",
      "text": "Rør godt rundt, og lad chutneyen koge ind ved middel-lav varme i cirka 40 minutter, til den er tyk og klistret."
    },
    {
      "section": "Servering",
      "text": "Dyp hver form i varmt vand i 20 sekunder, og vend panna cottaen ud på et fad."
    },
    {
      "section": "Servering",
      "text": "Anret med chutney, friske figner og bikage. Dryp med olivenolie og balsamicocreme."
    }
  ],
