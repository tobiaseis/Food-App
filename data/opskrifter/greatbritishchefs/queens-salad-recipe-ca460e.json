  "steps": [
    {
      "section": "Konfiteret hvidløg",
      "text": "Kom hvidløg, rapsolie, timian og salt i en kasserolle. Lad det småputte ved meget svag varme i 45-60 minutter, til hvidløgene er bløde og kan smøres ud."
    },
    {
      "section": "Konfiteret hvidløg",
      "text": "Lad det køle af og opbevar hvidløgene i olien i køleskabet. Der bliver mere, end du skal bruge."
    },
    {
      "section": "Karamelliserede hasselnødder",
      "text": "Varm ovnen op til 170 °C. Rist hasselnødderne, til de er gyldne og dufter, og lad dem køle af."
    },
    {
      "section": "Karamelliserede hasselnødder",
      "text": "Smelt sukkeret uden vand i en lille tykbundet pande ved middel-lav varme. Lad det få en dyb ravfarve, men tag det af varmen, lige før det bliver bittert."
    },
    {
      "section": "Karamelliserede hasselnødder",
      "text": "Vend nødderne hurtigt og forsigtigt i karamellen. Hæld dem ud på en måtte, der ikke klistrer, eller på en bageplade med bagepapir, og lad dem blive helt kolde."
    },
    {
      "section": "Karamelliserede hasselnødder",
      "text": "Knæk nødderne i stykker og blend dem groft i en foodprocessor. Stil dem ved stuetemperatur. Der bliver mere, end du skal bruge."
    },
    {
      "section": "Dronningedressing",
      "text": "Kom alle ingredienser undtagen olierne i en blender sammen med 6 fed konfiteret hvidløg. Blend, til massen er helt glat."
    },
    {
      "section": "Dronningedressing",
      "text": "Bland de to olier i en kande. Hæld dem i en tynd, jævn stråle ned i blenderen, mens den kører, så dressingen emulgerer og bliver stabil."
    },
    {
      "section": "Dronningedressing",
      "text": "Smag til med salt og citronsaft."
    },
    {
      "section": "Salat",
      "text": "Læg radicchiobladene i en stor skål. Tilsæt clementiner, rødløg, dadler, krydderurter og granatæblekerner."
    },
    {
      "section": "Salat",
      "text": "Vend salaten godt med rigeligt dressing, så alle blade er dækket. Smag til med salt og anret på et stort fad eller på tallerkener."
    },
    {
      "section": "Salat",
      "text": "Top med karamelliserede hasselnødder, ekstra granatæblekerner og lidt af clementinerne. Slut med sumak, en tråd olivenolie og saften fra en halv citron."
    }
  ],
  "changes": [
    "Kumquats er skiftet til clementiner.",
    "Riesling-agridulce-eddike er skiftet til hvidvinseddike med en knivspids sukker."
  ]
}
