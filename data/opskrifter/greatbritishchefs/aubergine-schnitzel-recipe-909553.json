  "steps": [
    {
      "section": "Til de syltede løg",
      "text": "Kom rødløgene i en stor skål. Rør eddike, vand, sukker og salt sammen, og hæld det over løgene."
    },
    {
      "section": "Til de syltede løg",
      "text": "Dæk skålen og lad løgene stå ved stuetemperatur i mindst 30 minutter."
    },
    {
      "section": "Til schnitzlerne",
      "text": "Skær top og bund af auberginerne. Skær de runde sider af, så hver aubergine bliver en rektangulær klods. Del klodserne på langs, så du får 4 tykke skiver i alt."
    },
    {
      "section": "Til schnitzlerne",
      "text": "Salt skiverne på begge sider, og lad dem stå i 20 minutter, så de afgiver væde."
    },
    {
      "section": "Til toum",
      "text": "Blend hvidløg og salt fint i en lille blender eller foodprocessor."
    },
    {
      "section": "Til toum",
      "text": "Lad maskinen køre, og tilsæt olien i en helt tynd stråle – først dråbevis, så blandingen emulgerer og tykner."
    },
    {
      "section": "Til toum",
      "text": "Når saucen begynder at binde, kan olien komme i en jævn stråle. Skift indimellem til lidt citronsaft og koldt vand, så emulsionen holder."
    },
    {
      "section": "Til toum",
      "text": "Fortsæt, til toumen er tyk, glat og blank. Smag til med salt og citronsaft, og sæt den på køl."
    },
    {
      "section": "Til schnitzlerne",
      "text": "Stil tre tallerkener frem: mel på den første, sammenpisket æg på den anden, og panko blandet med alle krydderierne på den tredje."
    },
    {
      "section": "Til schnitzlerne",
      "text": "Tør aubergineskiverne grundigt med køkkenrulle. Vend dem i melet og ryst overskuddet af, træk dem derefter gennem ægget og tryk dem til sidst ned i den krydrede panko."
    },
    {
      "section": "Til schnitzlerne",
      "text": "Læg schnitzlerne på en bakke, og lad dem hvile i 10 minutter, så panaden sætter sig."
    },
    {
      "section": "Til schnitzlerne",
      "text": "Varm en stor pande op over middel varme med olie nok til, at bunden er rigeligt dækket. Steg schnitzlerne i omgange i 4-5 minutter på hver side, til de er dybt gyldne og sprøde."
    },
    {
      "section": "Til schnitzlerne",
      "text": "Lad dem dryppe af på køkkenrulle, og drys dem let med salt."
    },
    {
      "section": "Til servering",
      "text": "Varm fladbrødene, og læg et på hver tallerken. Smør rigeligt toum ovenpå, og læg en schnitzel på."
    },
    {
      "section": "Til servering",
      "text": "Top med syltede løg, og drys med paprika, persille og nogle mynteblade."
    }
  ],
