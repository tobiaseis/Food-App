  "steps": [
    {
      "section": "Portreduktion",
      "text": "Kom alle ingredienserne til portreduktionen i en gryde. Lad det småkoge ved middel-lav varme, til væsken er reduceret til det halve."
    },
    {
      "section": "Portreduktion",
      "text": "Si væsken gennem en finmasket si, og lad den køle helt af."
    },
    {
      "section": "Dadelmarmelade",
      "text": "Kom dadler, farin, eddike og vand i en gryde. Kog ved lav varme, til dadlerne er helt bløde. Tilsæt lidt vand undervejs, hvis massen bliver for tyk."
    },
    {
      "section": "Dadelmarmelade",
      "text": "Hæld de bløde dadler i en kraftig blender, og blend til en helt glat marmelade. Smag til med salt og lidt mere eddike, hvis den mangler det."
    },
    {
      "section": "Dadelmarmelade",
      "text": "Fyld marmeladen i en sprayflaske eller sprøjteflaske, og stil den til side."
    },
    {
      "section": "Parfait",
      "text": "Varm ovnen op til 135 °C."
    },
    {
      "section": "Parfait",
      "text": "Kom alt til parfaiten undtagen fløden i en blender sammen med 100 g af portreduktionen. Blend, til massen er helt glat."
    },
    {
      "section": "Parfait",
      "text": "Rør fløden i med en ske. Gør det i hånden, så den ikke bliver tyk i blenderen."
    },
    {
      "section": "Parfait",
      "text": "Beklæd en terrineform på 1,3 liter med bagepapir, og hæld massen i. Dæk med alufolie."
    },
    {
      "section": "Parfait",
      "text": "Sæt formen i et dybt fad med kogende vand, og bag i omkring 1 time. Parfaiten er færdig, når den ryster let i midten."
    },
    {
      "section": "Parfait",
      "text": "Tag formen op, og lad parfaiten køle af til stuetemperatur. Stil den derefter i køleskabet i mindst 6 timer, til den er fast."
    },
    {
      "section": "Parfait",
      "text": "Skrab den misfarvede overflade af, og kassér den. Blend resten i en foodprocessor, til den er helt glat."
    },
    {
      "section": "Parfait",
      "text": "Læg bagepapir direkte på overfladen, så parfaiten ikke oxiderer, og opbevar den i køleskabet."
    },
    {
      "section": "Til servering",
      "text": "Smør parfaiten ud i den ene side af hver tallerken, og læg brødet ved siden af. Sprøjt en rigelig klat dadelmarmelade på, og drys med friskkværnet peber."
    }
  ],
