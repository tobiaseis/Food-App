  "steps": [
    {
      "section": "Karrypulver",
      "text": "Rist alle krydderierne på en tør pande, til de dufter. Mal dem derefter til et fint pulver i en krydderikværn."
    },
    {
      "section": "Karrysauce",
      "text": "Varm olien op i en gryde. Svits løg, hvidløg og ingefær ved middel-lav varme i ca. 15 minutter."
    },
    {
      "section": "Karrysauce",
      "text": "Rør gulerødder, mel og tomatpuré i gryden, og lad det stege med i 2 minutter."
    },
    {
      "section": "Karrysauce",
      "text": "Tilsæt karrypulver, fond, sojasauce, mirin og sukker. Lad saucen simre i 20 minutter, og blend den derefter helt glat og blank."
    },
    {
      "section": "Kylling",
      "text": "Gnid kyllingelårene ind i miso og honning, og lad dem marinere i 15 minutter."
    },
    {
      "section": "Kylling",
      "text": "Vend lårene først i mel, så i æg og til sidst i panko, så de er helt dækket."
    },
    {
      "section": "Kylling",
      "text": "Steg lårene i rigeligt varm olie i 4-5 minutter på hver side, til de er gyldne og gennemstegte. Lad dem dryppe af på køkkenrulle."
    },
    {
      "section": "Syltede pærer",
      "text": "Vend pæreskiverne med chili, eddike, sukker og salt. Lad dem trække i 15 minutter."
    },
    {
      "section": "Ris",
      "text": "Kog ris og vand op. Skru ned til middel-lav varme, læg et viskestykke og låg over, og lad risene koge i ca. 12 minutter."
    },
    {
      "section": "Ris",
      "text": "Tag gryden af varmen, og lad risene dampe færdige i 10 minutter."
    },
    {
      "section": "Til servering",
      "text": "Skær den stegte kylling i tykke skiver."
    },
    {
      "section": "Til servering",
      "text": "Anret kyllingen på risene, og hæld karrysauce over. Top med syltede pærer, ristede sesamfrø, koriander og forårsløg."
    }
  ],
  "changes": [
    "Risvineddike er skiftet til almindelig eddike."
  ]
}
