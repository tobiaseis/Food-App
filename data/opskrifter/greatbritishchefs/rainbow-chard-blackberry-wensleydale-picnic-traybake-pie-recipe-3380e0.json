  "steps": [
    {
      "section": "Tærte",
      "text": "Tænd ovnen på 200 °C (180 °C varmluft)."
    },
    {
      "section": "Tærte",
      "text": "Vend mangoldstilkene med olie, krydr med salt og peber, og rist dem i ovnen i 15–20 minutter."
    },
    {
      "section": "Tærte",
      "text": "Svits løgskiverne i en stegepande med et skvæt olie i ca. 15 minutter, til de er møre og søde."
    },
    {
      "section": "Tærte",
      "text": "Kog kartoffelskiverne i 8 minutter i kogende vand, til de er møre. Hæld vandet fra, og lad dem køle af."
    },
    {
      "section": "Tærte",
      "text": "Kog mangoldbladene i 1 minut i kogende vand, og skyl dem i koldt vand. Pres vandet godt ud, og hak bladene groft."
    },
    {
      "section": "Tærte",
      "text": "Rør eddike, honning, sennep og timian sammen til en dressing. Vend brombærrene forsigtigt i dressingen, og stil dem til side."
    },
    {
      "section": "Tærte",
      "text": "Sænk ovnen til 180 °C (160 °C varmluft), og beklæd en bradepande på ca. 20 × 30 cm med bagepapir."
    },
    {
      "section": "Tærte",
      "text": "Læg to af butterdejspladerne, så de overlapper hinanden et par centimeter. Saml dem med lidt vand, hvis det er nødvendigt, og rul dem sammen på et meldrysset bord til én stor plade på ca. 3 mm. Den skal kunne dække både bund og kanter. Tryk dejen ned i formen."
    },
    {
      "section": "Tærte",
      "text": "Strø rasp over dejbunden. Fordel derefter lagene i denne rækkefølge: mangoldstilke, løg, brombær, mangoldblade, feta, kartofler og ærter. Smag til med salt og peber mellem lagene."
    },
    {
      "section": "Tærte",
      "text": "Tag lidt af det piskede æg fra til pensling, og hæld resten forsigtigt over fyldet."
    },
    {
      "section": "Tærte",
      "text": "Læg den sidste dejplade over som låg. Klip overskydende dej af, og klem kanterne sammen. Pensl med æg, drys med valmuefrø, og skær et mønster, så tærten kan deles i 12 stykker."
    },
    {
      "section": "Tærte",
      "text": "Bag tærten i 1 time og 20 minutter, til den er gylden og sprød. Lad den køle helt af, før du løfter den ud og skærer den ud."
    },
    {
      "section": "Brombærdip",
      "text": "Mos brombær med yoghurt, honning, eddike, timian og salt. Stil dippen på køl, til den skal bruges."
    },
    {
      "section": "Æbleslaw",
      "text": "Vend æblestrimlerne med citronsaft, honning, olie, hasselnødder og salt."
    },
    {
      "section": null,
      "text": "Server tærten med slawen og dippen ved siden af."
    }
  ],
