  "steps": [
    {
      "section": "Udonnudlerne",
      "text": "Rør saltet ud i vandet i en stor skål, til det er opløst. Kom melet i en anden skål."
    },
    {
      "section": "Udonnudlerne",
      "text": "Hæld saltvandet i melet i en tynd stråle, og ælt undervejs, så det samler sig til en dej."
    },
    {
      "section": "Udonnudlerne",
      "text": "Ælt dejen i 5-8 minutter, til den er glat og elastisk. Form den som en rulle, pak den i film eller en tæt æske, og lad den hvile i 30 minutter."
    },
    {
      "section": "Karrypulveret",
      "text": "Bland alle krydderierne til karrypulveret i en lille skål, mens dejen hviler."
    },
    {
      "section": "Karrysuppen",
      "text": "Smelt smørret i en mellemstor gryde, og lad skalotteløgene stege ved svag varme i cirka 10 minutter, til de er møre og duftende."
    },
    {
      "section": "Karrysuppen",
      "text": "Tilsæt ingefær, kartoffel og gulerod, og steg i cirka et minut."
    },
    {
      "section": "Karrysuppen",
      "text": "Rør 2 spsk af karrypulveret i sammen med gochujang, røget paprika, cayennepeber og chiliflager. Lad det stege et minut ved svag varme."
    },
    {
      "section": "Karrysuppen",
      "text": "Drys melet over, og rør godt rundt. Pisk den varme fond i, først lidt ad gangen, så der ikke kommer klumper."
    },
    {
      "section": "Karrysuppen",
      "text": "Skru op til middel varme, og rør sukkeret i. Lad suppen simre i cirka 30 minutter, til den er tyknet. Pisk lidt vand i, hvis den bliver for tyk."
    },
    {
      "section": "Udonnudlerne",
      "text": "Ælt dejen igen i cirka et minut. Rul den ud på en meldrysset bordplade til ca. 1 cm tykkelse."
    },
    {
      "section": "Udonnudlerne",
      "text": "Støv dejen let med mel, og rul den videre ud til 3 mm. Skær den i brede strimler, træk dem fra hinanden, og vend dem i lidt mel."
    },
    {
      "section": "Udonnudlerne",
      "text": "Kog nudlerne i rigeligt kogende vand i 10-13 minutter. Hæld dem i isvand for at stoppe kogningen, og stil dem til side."
    },
    {
      "section": "Rejerne",
      "text": "Fjern tarmen på rejerne, og skær dem op i midten, så de kan foldes ud som en sommerfugl."
    },
    {
      "section": "Rejerne",
      "text": "Krydr melet med salt og peber. Vend hver reje i mel, derefter i æggeblandingen og til sidst i panko. Gentag, så hver reje er panerede to gange."
    },
    {
      "section": "Rejerne",
      "text": "Varm olie op i en tung pande, så den står cirka 1 cm højt. Steg rejerne i den varme olie, til de er gyldne og sprøde."
    },
    {
      "section": "Servering",
      "text": "Vend nudlerne i den varme karrysuppe, og smag til med salt og peber. Anret i skåle, og hæld evt. mere suppe over."
    },
    {
      "section": "Servering",
      "text": "Læg de sprøde rejer ovenpå, og pynt med forårsløg, chiliolie og chiliflager."
    }
  ],
  "changes": [
    "Stærkt mel er skiftet til hvedemel.",
    "Doves Farm-mel er skiftet til almindeligt hvedemel."
  ]
}
