  "steps": [
    {
      "section": "Graveret laks",
      "text": "Rør rødbeder, havsalt, sukker, enebær, citronskal, gin og dild sammen til en tyk masse."
    },
    {
      "section": "Graveret laks",
      "text": "Læg en stor bane husholdningsfilm frem, og fordel halvdelen af massen på den. Læg laksen med skindsiden nedad ovenpå, og dæk kødsiden helt med resten af massen."
    },
    {
      "section": "Graveret laks",
      "text": "Pak laksen stramt ind, og læg den på en bakke. Læg en ekstra bakke ovenpå som vægt, og sæt den i køleskabet i 48 timer. Vend fisken efter 24 timer."
    },
    {
      "section": "Graveret laks",
      "text": "Skyl massen af laksen under koldt vand, og dup den tør. Opbevar den i køleskabet til servering."
    },
    {
      "section": "Syltet agurk",
      "text": "Kog eddike, sukker, salt og sennepsfrø op i en lille gryde."
    },
    {
      "section": "Syltet agurk",
      "text": "Tag gryden af varmen, og hæld lagen over agurkebåndene. Lad dem stå og syltes i mindst 30 minutter, og stil dem derefter koldt, når de er afkølede."
    },
    {
      "section": "Blinis",
      "text": "Pisk mel, bagepulver, salt og sukker sammen. Tilsæt mælk og æg, og pisk til en glat dej. Rør det smeltede smør i."
    },
    {
      "section": "Blinis",
      "text": "Varm en lille pande op, og smør den let med olie. Kom små klatter dej på, og steg dem gyldne og færdige i 1–2 minutter på hver side."
    },
    {
      "section": "Creme fraiche",
      "text": "Bland alle ingredienserne til cremen, og smag til med salt og peber."
    },
    {
      "section": "Servering",
      "text": "Skær laksen i tynde skiver. Top hver blini med creme fraiche, en skive laks og en krølle agurk. Pynt med citronskal, dild, stenbiderrogn og kapers."
    }
  ],
