  "steps": [
    {
      "section": "Pærer i gløgg",
      "text": "Smelt smørret i en gryde. Rør sukker og rødvin i, til sukkeret er opløst."
    },
    {
      "section": "Pærer i gløgg",
      "text": "Kom krydderier, appelsinskræl og salt i, og lad det småsimre. Læg pærerne i og pochér dem forsigtigt i ca. 5 minutter. Tag dem derefter op af væsken."
    },
    {
      "section": "Karamel",
      "text": "Kom sukker og vand i en tykbundet gryde med høje kanter. Bring det i kog og sving gryden, så sukkeret opløses."
    },
    {
      "section": "Karamel",
      "text": "Lad det koge til en lys karamel, og sving gryden en gang imellem. Karamellen skal være ca. 170 °C."
    },
    {
      "section": "Karamel",
      "text": "Tag gryden af varmen. Tilsæt smørret med største forsigtighed, og rør med en ske, til det er smeltet og blandet godt ind."
    },
    {
      "section": "Karamel",
      "text": "Rør rommen i, og lad karamellen køle af i ca. 10 minutter. Vend så pæreskiverne forsigtigt i karamellen."
    },
    {
      "section": "Kagedej",
      "text": "Beklæd en kageform på 20 cm med bagepapir. Læg de karamelliserede pæreskiver i et viftemønster på bunden."
    },
    {
      "section": "Kagedej",
      "text": "Tænd ovnen på 200 °C (180 °C varmluft)."
    },
    {
      "section": "Kagedej",
      "text": "Pisk smør og sukker i en røremaskine, til det er let og luftigt. Tilsæt æggene ét ad gangen, og pisk dejen glat efter hvert."
    },
    {
      "section": "Kagedej",
      "text": "Sigt mel, bagepulver og kakao i, og rør dejen glat."
    },
    {
      "section": "Kagedej",
      "text": "Fordel dejen over pærerne i formen. Bag kagen i 40 minutter, til den er hævet og færdig."
    },
    {
      "section": "Til servering",
      "text": "Løsn kagen fra formens kant, mens den er lun. Vend den om på et fad, og tag bagepapiret af."
    },
    {
      "section": "Til servering",
      "text": "Rør creme fraiche med honning, og server den til kageskiverne."
    }
  ],
