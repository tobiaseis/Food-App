  "steps": [
    {
      "section": "Dej",
      "text": "Tænd ovnen på 180 °C varmluft."
    },
    {
      "section": "Dej",
      "text": "Blend alle ingredienser til galetterne med lidt salt, til dejen er helt glat. Lad den hvile i 20 minutter."
    },
    {
      "section": "Fyld",
      "text": "Rør den revne ost sammen med creme fraiche, og smag til med salt og peber."
    },
    {
      "section": "Steg og bag",
      "text": "Smelt lidt smør på en non-stick pande. Hæld så meget dej på, at bunden lige dækkes, og drej panden, så dejen fordeler sig jævnt."
    },
    {
      "section": "Steg og bag",
      "text": "Steg pandekagen, til overfladen ikke længere er våd. Den skal ikke vendes. Lad den glide over på en tallerken, og steg resten af dejen på samme måde."
    },
    {
      "section": "Steg og bag",
      "text": "Læg pandekagerne på en stor bageplade. Fordel osteblandingen i fire lige store dele midt på hver pandekage, og lad der være et hul i midten. Slå et æg ud i hvert hul, og fold kanterne ind over fyldet."
    },
    {
      "section": "Steg og bag",
      "text": "Bag i 6 minutter, til æggehviderne akkurat er stivnet. Pynt med chiliflager, sesamfrø, koriander og lidt ekstra purløg."
    }
  ],
