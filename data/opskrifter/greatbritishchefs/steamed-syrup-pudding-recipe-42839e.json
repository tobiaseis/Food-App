  "steps": [
    {
      "section": "Budding",
      "text": "Smør seks små forme rigeligt med smør. Kom 1 tsk lys sirup i bunden af hver form."
    },
    {
      "section": "Budding",
      "text": "Bland hvedemel, bagepulver, nyretalg, sukker og salt i en skål."
    },
    {
      "section": "Budding",
      "text": "Pisk æg og mælk sammen i en anden skål. Vend de tørre ingredienser i, til du har en tyk dej."
    },
    {
      "section": "Budding",
      "text": "Fordel dejen i formene, og lad der være plads øverst, så buddingerne kan hæve."
    },
    {
      "section": "Budding",
      "text": "Klip firkanter af bagepapir og alufolie, og læg begge dele over hver form. Luk tæt rundt om kanten."
    },
    {
      "section": "Budding",
      "text": "Stil formene i en stor gryde, og hæld kogende vand i, så det når halvvejs op ad formene. Læg låg på, og damp buddingerne ved middel varme i 25 minutter."
    },
    {
      "section": "Vaniljecreme",
      "text": "Imens varmes mælk, fløde, kardemomme samt vaniljefrø og -stang forsigtigt i en lille gryde, til der stiger damp op."
    },
    {
      "section": "Vaniljecreme",
      "text": "Pisk æggeblommer og sukker, til det er let og luftigt."
    },
    {
      "section": "Vaniljecreme",
      "text": "Rør en sjat af den varme mælk ned i blommerne. Hæld blandingen tilbage i gryden, og varm den ved svag varme under konstant omrøring, til cremen har den tykkelse, du bedst kan lide."
    },
    {
      "section": "Vaniljecreme",
      "text": "Si evt. kardemomme og vaniljestang fra, før du serverer."
    },
    {
      "section": "Budding",
      "text": "Kør en lille kniv rundt langs kanten af formene, og vend buddingerne ud på tallerkener. Hæld lidt varm creme over, og server resten ved siden af."
    }
  ],
  "changes": [
    "Golden syrup er skiftet til lys sirup.",
    "Self-raising flour er skiftet til hvedemel og bagepulver.",
    "Double cream er skiftet til piskefløde."
  ]
