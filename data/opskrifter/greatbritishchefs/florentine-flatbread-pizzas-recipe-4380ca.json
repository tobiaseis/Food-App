  "steps": [
    {
      "section": "Fladbrød",
      "text": "Rør vand, mælk og gær sammen i en kande. Lad det stå, til det skummer."
    },
    {
      "section": "Fladbrød",
      "text": "Kom mel, olie og salt i en røremaskine med dejkrog. Hæld gærblandingen i, og ælt i 5 minutter, til dejen er glat og elastisk."
    },
    {
      "section": "Fladbrød",
      "text": "Læg dejen i en olieret skål, og dæk med film. Lad den hæve, til den er cirka dobbelt så stor."
    },
    {
      "section": "Topping",
      "text": "Rør hvidløg, creme fraiche og salt sammen, og stil det på køl, til det skal bruges."
    },
    {
      "section": "Spinatpesto",
      "text": "Blend alle ingredienserne til pestoen i en lille blender, til den har en pestoagtig konsistens. Smag til med salt, og stil den til side."
    },
    {
      "section": "Fladbrød",
      "text": "Varm en tung pande op ved middel varme, og pensl den let med olie. Del dejen i fire stykker, og rul dem ud på en meldrysset bordplade."
    },
    {
      "section": "Fladbrød",
      "text": "Steg fladbrødene ét ad gangen i få minutter på hver side, til de er gyldne og har bobler. Tør panden af mellem hvert brød, hvis resterne af melet begynder at brænde på."
    },
    {
      "section": "Topping",
      "text": "Varm ovnen op til 200 °C varmluft."
    },
    {
      "section": "Topping",
      "text": "Smør hvidløgscremen tykt ud på fladbrødene, fordel mozzarella ovenpå, og slå et æg ud midt på hvert. Krydr ægget med salt og peber."
    },
    {
      "section": "Topping",
      "text": "Bag i ovnen i 3–5 minutter, til æggehviden er stivnet."
    },
    {
      "section": "Spinatpesto",
      "text": "Dryp spinatpesto over fladbrødene, og server med det samme."
    }
  ],
