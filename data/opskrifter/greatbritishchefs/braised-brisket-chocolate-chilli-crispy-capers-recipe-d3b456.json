  "steps": [
    {
      "section": "Oksebryst og sauce",
      "text": "Tænd ovnen på 150 °C."
    },
    {
      "section": "Oksebryst og sauce",
      "text": "Bland alle krydderierne til rubben, og gnid dem ind i kødet sammen med en knivspids salt."
    },
    {
      "section": "Oksebryst og sauce",
      "text": "Varm olien op i en stor ovnfast gryde ved middel varme, til den begynder at ryge. Brun kødet på alle sider, til det er dybt gyldent. Tag det op, og skru ned på lav varme."
    },
    {
      "section": "Oksebryst og sauce",
      "text": "Svits løg, gulerødder og selleri i gryden, til de er bløde uden at få farve. Rør hvidløget i, og lad det stege i 1 minut, til det dufter. Drys melet over, og rør rundt i cirka 1 minut. Tilsæt chilien og chipotlepastaen."
    },
    {
      "section": "Oksebryst og sauce",
      "text": "Hæld rødvinen i, og skru lidt op for varmen. Lad vinen koge ind til det halve, og rør bunden fri. Kom tomater og oksefond i, bring det i kog, og smag til med salt og peber. Læg kødet tilbage i gryden."
    },
    {
      "section": "Oksebryst og sauce",
      "text": "Læg låg på, og sæt gryden i ovnen i 4-5 timer, til kødet falder fra hinanden."
    },
    {
      "section": "Sprøde kapers",
      "text": "Hæld så meget olie i en bred pande, at bunden er dækket. Når olien er meget varm, kommer du kapers i – dog ikke den ene spiseskefuld, der skal gemmes. Steg dem i cirka 3 minutter, til de er sprøde. Løft dem op med en hulske, og lad dem dryppe af på køkkenrulle."
    },
    {
      "section": "Citrongremolata",
      "text": "Kør alle ingredienserne undtagen olivenolien i en foodprocessor sammen med de gemte kapers. Rør olivenolien i, og smag til med salt og peber."
    },
    {
      "section": "Polenta",
      "text": "Start polentaen en time, før maden skal på bordet. Bring fonden i kog ved høj varme. Pisk polenta, spidskommen og hvidløgspulver i, mens du visper godt."
    },
    {
      "section": "Polenta",
      "text": "Skru ned på lav varme, og lad polentaen simre i 45 minutter. Rør jævnligt, så der ikke dannes klumper."
    },
    {
      "section": "Polenta",
      "text": "Pisk taleggio og parmesan i, til osten er smeltet ind. Visp mælk og smør i, så polentaen bliver lidt løsere. Smag til med salt og peber."
    },
    {
      "section": "Oksebryst og sauce",
      "text": "Tag det møre kød op af saucen, og pluk det i tråde med to gafler. Lad det hvile et øjeblik."
    },
    {
      "section": "Oksebryst og sauce",
      "text": "Sæt saucen tilbage på varmen, og kom chokolade og ansjoser i, hvis du bruger dem. Lad den simre blidt, til den er reduceret og tyk, og rør jævnligt. Er den ikke tyk nok, jævnes den med majsstivelse udrørt i lidt vand. Smag til med salt og peber, vend det pillede kød i saucen, og rør det godt rundt."
    },
    {
      "section": "Oksebryst og sauce",
      "text": "Anret polentaen i skåle, og top med kødretten. Fordel gremolata og sprøde kapers ovenpå, og afslut med lidt friskkværnet peber."
    }
  ],
  "changes": [
    "Anchochili er erstattet med tørret chili.",
    "Chipotleflager og chipotlepasta er erstattet med chipotle."
  ]
}
