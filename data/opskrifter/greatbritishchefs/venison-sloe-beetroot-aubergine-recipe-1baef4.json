  "steps": [
    {
      "section": "Syltetøj af blommer og rødbeder",
      "text": "Vend blommerne i sukker og salt. Grill dem langsomt over kul i cirka 30 minutter, til de er forkullede udenpå og helt bløde indeni. Fjern stenene."
    },
    {
      "section": "Syltetøj af blommer og rødbeder",
      "text": "Tænd ovnen på 190 °C. Gnid rødbederne ind i olivenolie og salt, pak dem i alufolie og bag dem i 1 time og 30 minutter."
    },
    {
      "section": "Syltetøj af blommer og rødbeder",
      "text": "Skræl rødbederne, når de er kølet så meget af, at de kan håndteres. Læg 100 g til side til syltetøjet og gem resten til rødbedesaucen."
    },
    {
      "section": "Syltetøj af blommer og rødbeder",
      "text": "Smelt sukkeret tørt i en gryde til en karamel. Tilsæt forsigtigt blommerne, de 100 g rødbede og peberkornene, og lad det simre i 30 minutter."
    },
    {
      "section": "Syltetøj af blommer og rødbeder",
      "text": "Kom de grillede blommer i gryden og kog yderligere 1 time, til rødbederne er bløde."
    },
    {
      "section": "Syltetøj af blommer og rødbeder",
      "text": "Blend alt med basilikum og figenblade i en kraftig blender. Lad låget sidde på klem, så dampen kan slippe ud. Sigt massen gennem en fin sigte."
    },
    {
      "section": "Syltetøj af blommer og rødbeder",
      "text": "Smag til med citronsaft og rødvinseddike, og stil syltetøjet til side."
    },
    {
      "section": "Auberginesauce",
      "text": "Vend aubergine, tomater, blommer og rødløg med rigeligt olie og salt."
    },
    {
      "section": "Auberginesauce",
      "text": "Grill grøntsagerne, til de er meget mørke. Læg dem i en beholder med tætsluttende låg eller film, så de damper og bliver helt bløde."
    },
    {
      "section": "Auberginesauce",
      "text": "Blend grøntsagerne til en pasta i en foodprocessor og stil den til side."
    },
    {
      "section": "Auberginesauce",
      "text": "Smelt en klat smør i en gryde. Svits skalotteløg og hvidløg meget forsigtigt i cirka 20 minutter, til de er bløde uden at have taget farve."
    },
    {
      "section": "Auberginesauce",
      "text": "Rør chili og peber i og lad det stege i et par minutter. Hæld hvidvin og øl i og kog op, mens du skraber bunden fri."
    },
    {
      "section": "Auberginesauce",
      "text": "Tilsæt kyllingefond og kog det ind til det halve."
    },
    {
      "section": "Auberginesauce",
      "text": "Blend løgreduktionen med basilikum, hvidløgsolie, rapsolie, smør og auberginepastaen. Del det i mindre portioner, hvis det er nødvendigt. Smag til med salt."
    },
    {
      "section": "Hibiscusreduktion",
      "text": "Bring hibiscus og vand i kog. Tag gryden af varmen og lad det trække under tætsluttende låg i en halv time."
    },
    {
      "section": "Hibiscusreduktion",
      "text": "Si hibiscus fra. Kog teen op med sukkeret, og rør, til sukkeret er opløst. Lad det koge til 106 °C og tag gryden af varmen."
    },
    {
      "section": "Rødbedesauce",
      "text": "Tænd ovnen på 190 °C."
    },
    {
      "section": "Rødbedesauce",
      "text": "Grill kirsebærrene over kul, til de er bløde, og fjern stenene."
    },
    {
      "section": "Rødbedesauce",
      "text": "Blend de gemte rødbeder med kirsebær og resten af ingredienserne til saucen sammen med 60 g af hibiscusreduktionen."
    },
    {
      "section": "Til retten",
      "text": "Brun hjortemørbraden på alle sider, og grill den derefter i 3 minutter. Lad kødet hvile i 10 minutter. Gentag grillning og hvile to gange mere, eller til kødet er færdigt efter din smag. Vend kødet ofte, så det bliver brunet hele vejen rundt."
    },
    {
      "section": "Til retten",
      "text": "Varm auberginesaucen og rødbedesaucen op."
    },
    {
      "section": "Til retten",
      "text": "Pil rejerne og grill dem 1 minut på hver side. Grill derefter pak choi."
    },
    {
      "section": "Til retten",
      "text": "Steg de halve champignon i rigeligt olie, og øs olien over dem, til de er gyldne og karamelliserede. Læg en skive bacon på hver, så den smelter under hvilen."
    },
    {
      "section": "Til retten",
      "text": "Skær hjortekødet i skiver lige før servering."
    },
    {
      "section": "Til retten",
      "text": "Anret på varme tallerkener. Kom en skefuld rødbedesauce, auberginesauce og syltetøj på hver tallerken. Læg en rejer, hjortekød og pak choi ovenpå. Dryp med den reducerede fond og drys med chiliflager."
    }
  ],
