  "steps": [
    {
      "section": "Bagte kartofler",
      "text": "Tænd ovnen på 200 °C varmluft. Læg de halverede kartofler på en bageplade med snitfladen opad, dryp med olie, og krydr kraftigt med salt og peber."
    },
    {
      "section": "Bagte kartofler",
      "text": "Bag i 40-45 minutter, til de er bløde i midten og let sprøde i kanten."
    },
    {
      "section": "Vichyssoise",
      "text": "Imens varmes smør og olie i en gryde. Svits porre, løg og hvidløg ved svag varme i 10 minutter, til de er bløde uden at have taget farve."
    },
    {
      "section": "Vichyssoise",
      "text": "Kom kartoffelternene i gryden, hæld fonden over, og smag svagt til med salt. Lad det koge ved jævn varme i 15-18 minutter, til kartoflerne er helt møre."
    },
    {
      "section": "Vichyssoise",
      "text": "Rør fløden i, og blend suppen helt glat. Smag til med salt og hvid peber, vend purløgene i, og hold den varm."
    },
    {
      "section": "Sprøde kartoffelstykker",
      "text": "Tag kartoflerne ud af ovnen, men lad ovnen være tændt. Skrab det meste af indmaden ud med en ske, så der bliver en kant på ca. 1 cm."
    },
    {
      "section": "Sprøde kartoffelstykker",
      "text": "Smul indmaden i små, grove stykker, og vend den med lidt olie og salt."
    },
    {
      "section": "Sprøde kartoffelstykker",
      "text": "Fordel stykkerne på en bageplade, og bag dem ved 200 °C i 15-20 minutter, til de er gyldne og sprøde."
    },
    {
      "section": "Til servering",
      "text": "Fyld de bagte kartoffelskaller med den varme vichyssoise, så den danner en blød top."
    },
    {
      "section": "Til servering",
      "text": "Læg et par skefulde creme fraiche på, og dryp rigeligt med olie over. Drys med de sprøde kartoffelstykker og ristede løg."
    },
    {
      "section": "Til servering",
      "text": "Slut af med purløg, lidt citronskal og friskkværnet peber."
    }
  ],
