  "steps": [
    {
      "section": "Sprød svær",
      "text": "Tænd ovnen på 220 °C varmluft."
    },
    {
      "section": "Sprød svær",
      "text": "Rids sværen, tør den og gnid den godt ind i salt. Lad den stå i 20 minutter, så saltet trækker væde ud."
    },
    {
      "section": "Sprød svær",
      "text": "Børst saltet af og tør sværen grundigt med køkkenrulle. Drys den med friskt salt."
    },
    {
      "section": "Sprød svær",
      "text": "Bag sværen i ovnen i 20–30 minutter, til den er gylden og sprød over det hele. Tag den ud og skru ovnen ned på 190 °C varmluft."
    },
    {
      "section": "Kartofler",
      "text": "Duppe kartoffelskiverne tørre."
    },
    {
      "section": "Kartofler",
      "text": "Smelt smørret i en pande, og brun hvidløget let, til det dufter. Pas på, for hvidløg brænder let på."
    },
    {
      "section": "Kartofler",
      "text": "Pensl et ildfast fad med det smeltede smør. Læg kartoflerne i lag i fadet, og pensl hvert lag med smør og krydr med salt og peber."
    },
    {
      "section": "Misobechamel",
      "text": "Smelt smørret i en gryde, og rør melet i. Svits det, men lad jævningen forblive lys."
    },
    {
      "section": "Misobechamel",
      "text": "Rør misoen i, og tilsæt så den varme mælk lidt ad gangen under konstant omrøring."
    },
    {
      "section": "Misobechamel",
      "text": "Kog saucen, til den tykner. Tag gryden af varmen, rør osten i, og smag til med salt og peber."
    },
    {
      "section": "Bagning",
      "text": "Hæld bechamelen over kartoflerne. Bag fadet i 30–40 minutter, til kartoflerne er møre og toppen er gyldenbrun."
    },
    {
      "section": "Svær og dressing",
      "text": "Pisk gochujang, honning, æblecidereddike, sojasauce og olie sammen. Brug en gaffel eller et piskeris."
    },
    {
      "section": "Svær og dressing",
      "text": "Bræk den bagte svær i stykker, og vend den i gochujangblandingen."
    },
    {
      "section": "Svær og dressing",
      "text": "Rør honning, hvidvinseddike, olie, persille og basilikum sammen til dressingen, og smag den til med salt."
    },
    {
      "section": "Servering",
      "text": "Top det varme kartoffelfad med svær, dressing og resten af gochujang-honningblandingen. Dryss med purløg og friskkværnet peber."
    }
  ],
