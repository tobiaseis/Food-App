  "steps": [
    {
      "section": "Rösti",
      "text": "Riv kartoflerne groft, skyl dem grundigt i koldt vand, og lad dem dryppe godt af."
    },
    {
      "section": "Rösti",
      "text": "Vend kartoflerne med salt, og lad dem stå i 10 minutter. Pres derefter vandet ud i et rent viskestykke eller et osteklæde."
    },
    {
      "section": "Rösti",
      "text": "Bland kartoflerne med ghee, vakuumpak dem, og rul dem jævnt flade med en kagerulle."
    },
    {
      "section": "Rösti",
      "text": "Damp dem i dampovn ved 100 °C i 20 minutter."
    },
    {
      "section": "Rösti",
      "text": "Læg et fad eller en bakke oven på de dampede kartofler, og tynge det med noget tungt, fx dåser. Lad det stå i køleskabet natten over."
    },
    {
      "section": "Sort olivenolie",
      "text": "Tørr olivenerne i en dehydrator ved 70 °C i 12 timer, til de er helt tørre og sprøde."
    },
    {
      "section": "Sort olivenolie",
      "text": "Blend de tørre oliven glatte med olivenolien i en kraftig blender. Hæld blandingen i en skål, og lad den trække i 6 timer."
    },
    {
      "section": "Sort olivenolie",
      "text": "Si olien gennem et osteklæde, og stil den i køleskabet."
    },
    {
      "section": "Basilikumolie",
      "text": "Blend alle ingredienserne i en Thermomix ved 75 °C i 10 minutter, til olien er varm og er skilt."
    },
    {
      "section": "Basilikumolie",
      "text": "Si olien gennem et osteklæde, og stil den i køleskabet."
    },
    {
      "section": "Lammesauce",
      "text": "Varm ovnen op til 180 °C."
    },
    {
      "section": "Lammesauce",
      "text": "Brun lammeknogler og afskær i en stor ovnfast gryde eller pande, til de er pænt gyldne, men ikke brændte. Hæld overskydende fedt fra."
    },
    {
      "section": "Lammesauce",
      "text": "Flyt gryden over på komfuret ved middel varme. Steg grøntsagerne og hvidløget i cirka 10 minutter, til de har fået farve."
    },
    {
      "section": "Lammesauce",
      "text": "Rør fennikelfrø og tomatpuré i, og lad det stege et par minutter. Hæld hvidvinen i, og kog den ind til en tredjedel."
    },
    {
      "section": "Lammesauce",
      "text": "Tilsæt begge fonder, og bring det i kog. Kom timian i, og lad saucen simre i 40 minutter."
    },
    {
      "section": "Lammesauce",
      "text": "Skru op for varmen, og kog saucen ind med en tredjedel. Skum den jævnligt, så alt snavs og urenheder fjernes."
    },
    {
      "section": "Lammesauce",
      "text": "Si saucen gennem en finmasket si. Smag til med salt, og afslut med eddike."
    },
    {
      "section": "Tomatfondue",
      "text": "Svits skalotteløg og timian i olivenolien i cirka 5 minutter, til løgene er klare."
    },
    {
      "section": "Tomatfondue",
      "text": "Tilsæt hvidløget, og steg det 2 minutter mere. Rør tomatpuréen i, og lad den stege et par minutter. Afglas med eddike."
    },
    {
      "section": "Tomatfondue",
      "text": "Kom halvdelen af tomaterne i, og kog, til saften er væk, og blandingen begynder at se tør ud. Hæld den gemte tomatsaft i, og kog et par minutter mere."
    },
    {
      "section": "Tomatfondue",
      "text": "Tilsæt resten af tomaterne, og kog et par minutter. Smag til med salt, og tjek balancen mellem syre og sødme."
    },
    {
      "section": "Squash- og basilikumpuré",
      "text": "Varm olivenolien op i en pande. Steg squash og spinat så hurtigt som muligt, så grøntsagerne beholder deres farve og ikke smager af kogt."
    },
    {
      "section": "Squash- og basilikumpuré",
      "text": "Pres væsken ud af squashen i en si, så purén ikke bliver for tynd."
    },
    {
      "section": "Squash- og basilikumpuré",
      "text": "Blend squash og spinat sammen med basilikum til en puré, si den gennem en fin si, og smag til med salt."
    },
    {
      "section": "Lammefrikadeller",
      "text": "Svits hvidløg og løg med rosmarin, til de er møre. Tag rosmarinen op."
    },
    {
      "section": "Lammefrikadeller",
      "text": "Bland løgblandingen med alt det hakkede kød og farsen. Vej massen, og ælt mælkepulver (2 % af vægten) og salt (1,5 % af vægten) i."
    },
    {
      "section": "Lammefrikadeller",
      "text": "Form 8-10 små kugler. Pak dem stramt ind i nethinde og derefter i husholdningsfilm."
    },
    {
      "section": "Lammefrikadeller",
      "text": "Pochér kuglerne i 7-8 minutter, lad dem dryppe af, og brun dem med en gasbrænder."
    },
    {
      "section": "Rösti",
      "text": "Varm flere centimeter olie op til 170 °C i en høj, tykbundet gryde."
    },
    {
      "section": "Rösti",
      "text": "Stik 8-10 runde skiver ud af den pressede rösti med en udstikker på 4 cm. Vend dem let i mel, og friturestek dem i 4 minutter ved 170 °C, til de er sprøde og gyldne."
    },
    {
      "section": "Lammecarré",
      "text": "Pas fedtet til, og del carréerne i stykker med 2 ribben."
    },
    {
      "section": "Lammecarré",
      "text": "Rids fedtlaget, så det smelter lettere, og krydr med salt og peber."
    },
    {
      "section": "Lammecarré",
      "text": "Brun lammet på en varm pande, så noget af fedtet smelter ud. Når kødet er gyldent, tilsæt hvidløg, timian og smør, og ös smørret over kødet, til det er stegt, som du vil have det."
    },
    {
      "section": "Lammecarré",
      "text": "Lad kødet hvile i 7 minutter. Skær det i skiver, og drys med flagesalt."
    },
    {
      "section": "Til anretning",
      "text": "Steg squashhalvdelene med snitfladen nedad i lidt olie, til de er gyldne og møre. Skær dem på skrå, og drys med flagesalt."
    },
    {
      "section": "Til anretning",
      "text": "Pensl lammefrikadellerne med varm lammesauce, og læg hver på en rösti."
    },
    {
      "section": "Til anretning",
      "text": "Anret frikadeller, skåret lam, stegt squash, squashpuré og tomatfondue rundt langs tallerkenens kant. Sæt lidt indkogt lammesauce i midten, dryp med oliven- og basilikumolie, og pynt med basilikumblade."
    }
  ],
  "changes": [
    "Clarified butter er skiftet til ghee.",
