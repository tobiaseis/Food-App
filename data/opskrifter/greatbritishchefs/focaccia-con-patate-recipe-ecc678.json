  "steps": [
    {
      "section": "Dej",
      "text": "Bland mel, gær og salt i en skål. Tilsæt vand og olie, og saml det til en dej."
    },
    {
      "section": "Dej",
      "text": "Ælt dejen i 8-10 minutter, til den er glat. Dæk skålen til, og lad dejen hæve ved stuetemperatur i 1 time."
    },
    {
      "section": "Topping",
      "text": "Smelt smørret i en stor gryde. Kog løgene ved svag varme i 15 minutter."
    },
    {
      "section": "Topping",
      "text": "Rør ansjoser og sukker i gryden, og lad det simre 15 minutter mere, til løgene er bløde og dybt brune."
    },
    {
      "section": "Topping",
      "text": "Vend kartoffelskiverne med olie, rosmarin og salt, så de er dækket jævnt."
    },
    {
      "section": "Samling",
      "text": "Læg dejen i en stor bageplade med bagepapir. Tryk fingrene ned i dejen, så der kommer fordybninger."
    },
    {
      "section": "Samling",
      "text": "Smør et tyndt lag ansjosløg ud over dejen, og fordel kartoflerne jævnt ovenpå."
    },
    {
      "section": "Samling",
      "text": "Læg et fugtigt viskestykke over, og lad brødet hæve i 20 minutter."
    },
    {
      "section": "Bagning",
      "text": "Mod slutningen af hævningen tændes ovnen på 250 °C, eller så varm som den kan blive."
    },
    {
      "section": "Bagning",
      "text": "Bag focaccian i 12-15 minutter, til kartoflerne er sprøde og dybt gyldne, og skorpen er brunet."
    },
    {
      "section": "Bagning",
      "text": "Drys det varme brød med kapers og persille. Læg evt. ekstra ansjoser på, og dryp med lidt olie til sidst."
    }
  ],
  "changes": [
    "Nanna Tate-kartofler er skiftet til almindelige kartofler."
  ]
}
