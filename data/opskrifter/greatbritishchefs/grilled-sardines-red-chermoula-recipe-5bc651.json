  "steps": [
    {
      "section": "Til sardinerne",
      "text": "Læg sardinerne på et fad og gnid dem ind med olivenolie, hvidløg, røget paprika, salt og peber."
    },
    {
      "section": "Til sardinerne",
      "text": "Anbring fiskene i ét lag i en grillrist til fisk, og stil dem til side."
    },
    {
      "section": "Til sardinerne",
      "text": "Gør en kulgrill klar til direkte varme."
    },
    {
      "section": "Til chermoulaen",
      "text": "Imens moses hvidløg og citronskal med lidt af saltet i en mortér."
    },
    {
      "section": "Til chermoulaen",
      "text": "Rør ras el hanout, resten af saltet, røget paprika, spidskommen og harissa i."
    },
    {
      "section": "Til chermoulaen",
      "text": "Stød koriander og persille i, til det bliver en pasta. Tynd den ud med safranvandet og olivenolien, så den kan øses med ske."
    },
    {
      "section": "Til chermoulaen",
      "text": "Smag til med salt og peber, og stil den til side."
    },
    {
      "section": "Til sardinerne",
      "text": "Læg citronhalvdelene på grillen, så de karamelliserer."
    },
    {
      "section": "Til sardinerne",
      "text": "Grill sardinerne 2 minutter på hver side over kullene med låg på og ventilerne åbne, til skindet er boblet og fisken er gennemstegt. De går hurtigt. Tag fisk og citron af grillen."
    },
    {
      "section": "Til sardinerne",
      "text": "Tag sardinerne ud af risten og læg dem på et fad. Fordel chermoulaen ovenpå."
    },
    {
      "section": "Til sardinerne",
      "text": "Vend kapers, korianderblade og de krøllede forårsløg let sammen og drys over fisken. Dryp med lidt olivenolie, og server med den grillede citron."
    }
  ],
