  "steps": [
    {
      "section": "Rødbeder",
      "text": "Tænd ovnen på 190 °C. Vend rødbederne i olie og salt, og pak hver rødbede ind i sit eget stykke folie."
    },
    {
      "section": "Rødbeder",
      "text": "Bag dem i ca. 45 minutter, til de er møre, når man stikker en gaffel i dem. Pak dem ud, og lad dem køle af."
    },
    {
      "section": "Rødbeder",
      "text": "Pil skrællen af, skær rødbederne i både, og stil dem til side."
    },
    {
      "section": "Chilichokoladevinaigrette",
      "text": "Smelt chokoladen i en skål over en gryde med vand, der kun lige simrer. Tag skålen af varmen, og lad chokoladen køle lidt."
    },
    {
      "section": "Chilichokoladevinaigrette",
      "text": "Rør balsamico, olie, honning og chiliflager i, og smag til med salt og peber."
    },
    {
      "section": "Urtecreme af gedeost",
      "text": "Kom alle ingredienserne til urtecremen i en foodprocessor, og kør dem glatte. Smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Pisk lidt balsamico og olie sammen med salt og peber. Vend rødbeder, julesalat og rucola i dressingen."
    },
    {
      "section": "Til servering",
      "text": "Fordel urtecremen i to skåle, og læg de dressede rødbeder og salat ovenpå. Drys med valnødder, og hæld chilichokoladevinaigretten over til sidst."
    }
  ],
