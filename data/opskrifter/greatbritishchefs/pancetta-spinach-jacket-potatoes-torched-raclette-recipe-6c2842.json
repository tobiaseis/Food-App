  "steps": [
    {
      "section": "Kartofler",
      "text": "Tænd ovnen på 200 °C varmluft."
    },
    {
      "section": "Kartofler",
      "text": "Skrub kartoflerne, og stik dem med en gaffel. Gnid dem ind i olie og salt."
    },
    {
      "section": "Kartofler",
      "text": "Bag dem i 1 time direkte på ovnristen eller på en bageplade, til skindet er sprødt, og indersiden er luftig."
    },
    {
      "section": "Fyld",
      "text": "Steg baconen i olien på panden, til den er gylden og sprød."
    },
    {
      "section": "Fyld",
      "text": "Rør skalotteløg og hvidløg i, og svits dem i 2-3 minutter, til de er bløde."
    },
    {
      "section": "Fyld",
      "text": "Vend spinaten i, og lad den falde sammen. Tilsæt fløden, smag til med salt og peber, og stil panden til side."
    },
    {
      "section": "Syltede løg",
      "text": "Bring eddike, vand, sukker, salt og peberkorn i kog i en lille kasserolle, og rør, til sukkeret er opløst."
    },
    {
      "section": "Syltede løg",
      "text": "Tag kasserollen af varmen, læg rødløgsringene i, og lad dem trække i mindst 20 minutter."
    },
    {
      "section": "Ostesauce",
      "text": "Når kartoflerne næsten er færdige, varmes fløde og sennep forsigtigt op i en gryde."
    },
    {
      "section": "Ostesauce",
      "text": "Rør osteskiverne i, til saucen er tyk og blank. Hold den varm."
    },
    {
      "section": "Til servering",
      "text": "Skær kartoflerne op, og luk indersiden let op med en gaffel."
    },
    {
      "section": "Til servering",
      "text": "Fordel fyldet i kartoflerne, og hæld den varme ostesauce over."
    },
    {
      "section": "Til servering",
      "text": "Brænd osten let af med en gasbrænder, til den bobler og får en svag farve."
    },
    {
      "section": "Til servering",
      "text": "Læg syltede rødløg på hver kartoffel, og drys med timian og purløg. Server straks med ekstra syltede løg ved siden af."
    }
  ],
