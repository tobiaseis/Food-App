  "steps": [
    {
      "section": "Kalvebris",
      "text": "Bring en gryde vand i kog med rigeligt salt. Kog brisen i cirka 20 sekunder, og læg den straks i isvand, så den stivner."
    },
    {
      "section": "Kalvebris",
      "text": "Træk den tynde hinde af brisen."
    },
    {
      "section": "Kalvebris",
      "text": "Vakuumpak brisen med timian og smør. Tilbered den sous-vide ved 64 °C i 1 time, og afkøl den bagefter i isvand."
    },
    {
      "section": "Speltrisotto",
      "text": "Kog spelten i hvidvinen, til næsten al vinen er fordampet."
    },
    {
      "section": "Speltrisotto",
      "text": "Hæld fonden på lidt ad gangen, og lad spelten simre, til kornene er møre."
    },
    {
      "section": "Speltrisotto",
      "text": "Tilsæt en sjat fond, og rør smør og parmesan i. Tag gryden af varmen, vend rucolaen i, og smag til med salt."
    },
    {
      "section": "Valnøddegel",
      "text": "Blend de syltede valnødder helt glatte i en kraftig blender."
    },
    {
      "section": "Valnøddegel",
      "text": "Tilsæt Ultratex lidt ad gangen, til massen har en fast gelékonsistens."
    },
    {
      "section": "Til servering",
      "text": "Vend brisen i boghvedemel. Varm en høj, tungbundet pande med få centimeter olie op."
    },
    {
      "section": "Til servering",
      "text": "Friturestég brisen, til den er sprød og gylden, og lad den dryppe af på køkkenpapir."
    },
    {
      "section": "Til servering",
      "text": "Opvarm risottoen, og anret den i dybe tallerkener. Drys med timianblade, og sæt prikker af valnøddegel rundt om."
    },
    {
      "section": "Til servering",
      "text": "Strø poppet boghvede over, og læg den sprøde bris øverst. Slut af med lidt ekstra parmesan og tynde skiver trøffel."
    }
  ],
  "changes": [
