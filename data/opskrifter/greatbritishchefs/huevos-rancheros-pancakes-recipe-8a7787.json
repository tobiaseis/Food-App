  "steps": [
    {
      "section": "Til pico de gallo",
      "text": "Bland tomat, rødløg, chili, limesaft og koriander. Smag til med salt, og stil skålen i køleskabet, til den skal bruges."
    },
    {
      "section": "Til pandekagerne",
      "text": "Rør hvedemel, bagepulver og salt sammen i en skål. Pisk æg og mælk i, til dejen er glat, og vend derefter koriander i."
    },
    {
      "section": "Til pandekagerne",
      "text": "Varm lidt olie på en pande. Steg små pandekager på begge sider, til de er gyldne, og hold dem varme."
    },
    {
      "section": "Til toppen",
      "text": "Steg chorizoskiverne på panden, til de er sprøde, og tag dem af."
    },
    {
      "section": "Til toppen",
      "text": "Steg æggene på samme pande, til kanterne er sprøde, og blommen stadig er flydende."
    },
    {
      "section": "Til toppen",
      "text": "Læg pandekagerne i stakke på tallerkener. Top med pico de gallo, spejlæg, chorizo, avocado og feta, og dryp til sidst med hot sauce."
    }
  ],
