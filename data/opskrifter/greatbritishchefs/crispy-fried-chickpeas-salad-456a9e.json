  "steps": [
    {
      "section": "Sprøde kikærter",
      "text": "Varm olien op i en pande ved middelhøj varme. Steg kikærterne, til de er gyldne og sprøde, og ryst panden jævnligt."
    },
    {
      "section": "Sprøde kikærter",
      "text": "Løft kikærterne op på køkkenrulle, så de kan dryppe af. Krydr med flagesalt og røget paprika, og stil dem til side."
    },
    {
      "section": "Vinaigrette",
      "text": "Kom alle ingredienserne til vinaigretten i en lille blender, og kør dem helt glatte."
    },
    {
      "section": "Vinaigrette",
      "text": "Tynd om nødvendigt med et skvæt koldt vand. Smag til med salt og peber, og stil til side."
    },
    {
      "section": "Salat",
      "text": "Varm en grillpande af støbejern op på høj varme. Grill forårsløgene, til de er bløde og let sorte i kanterne. Lad dem køle lidt af."
    },
    {
      "section": "Salat",
      "text": "Vend alle salatens ingredienser undtagen gedeosten sammen med vinaigretten i en stor skål, og anret det på et fad."
    },
    {
      "section": "Salat",
      "text": "Top med de sprøde kikærter og gedeosten. Dryp med lidt olivenolie, og drys med salt og peber."
    }
  ],
  "changes": [
    "Romanesco er skiftet til almindelig blomkål."
  ]
