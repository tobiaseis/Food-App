  "steps": [
    {
      "section": "Kålen",
      "text": "Kom den fintskårne rødkål i en stor skål, drys med salt og vend rundt. Lad den stå i 30 minutter, så saltet trækker væde ud og gør kålen mør."
    },
    {
      "section": "Kålen",
      "text": "Skyl kålen kort under koldt vand, lad den løbe af, og tør den godt med køkkenrulle."
    },
    {
      "section": "Lagen",
      "text": "Kom alle ingredienserne til lagen i en gryde. Varm op under omrøring, til sukkeret er opløst, og bring det i kog. Lad lagen simre i 2–3 minutter, så krydderierne trækker."
    },
    {
      "section": "Syltning",
      "text": "Pak kålen i et rent, varmefast glas eller en æske. Hæld den varme lage over, så kålen er helt dækket."
    },
    {
      "section": "Syltning",
      "text": "Luk låget og lad kålen køle af til stuetemperatur. Sæt den derefter i køleskabet i mindst 3 timer."
    },
    {
      "section": "Servering",
      "text": "Hæld noget af lagen fra, og anret kålen på et fad. Pynt med timianblade, knuste lyserøde peberkorn og citronskal."
    }
  ],
  "changes": [
    "Flagesalt er skiftet til almindeligt salt."
