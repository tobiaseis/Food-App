  "steps": [
    {
      "section": "Syltede skalotteløg",
      "text": "Læg skalotteløgsringene i en varmefast skål."
    },
    {
      "section": "Syltede skalotteløg",
      "text": "Kom eddike, vand, sukker, salt, peberkorn og korianderfrø i en lille kasserolle, og lad det komme i kog ved svag varme. Hæld væsken straks over løgene."
    },
    {
      "section": "Syltede skalotteløg",
      "text": "Lad løgene stå i 30 minutter ved stuetemperatur, og sæt dem derefter i køleskabet, til de skal bruges."
    },
    {
      "section": "Fladbrød",
      "text": "Bland mel, bagepulver og salt i en stor skål. Rør yoghurten i, og tilsæt vandet lidt ad gangen, til dejen er blød og samler sig."
    },
    {
      "section": "Fladbrød",
      "text": "Ælt dejen let i 1-2 minutter, til den er glat. Dæk den til, og lad den hvile."
    },
    {
      "section": "Mynteyoghurt",
      "text": "Rør alle ingredienserne sammen, og smag til med salt. Stil yoghurten i køleskabet, så smagene får tid til at trække."
    },
    {
      "section": "Lammekoteletter",
      "text": "Mal kaffe, kakao, paprika, spidskommen, peberkorn og salt fint i en krydderikværn eller morter."
    },
    {
      "section": "Lammekoteletter",
      "text": "Tør koteletterne med køkkenrulle, gnid dem ind i olivenolie, og vend dem i krydderiblandingen, så de er dækket hele vejen rundt. Stil dem til side."
    },
    {
      "section": "Fladbrød",
      "text": "Del dejen i 4 lige store stykker, og rul hvert stykke ud til en rund plade på 0,5 cm. Varm en støbejernspande op ved middelhøj varme, og bag brødene ét ad gangen i 1-2 minutter på hver side, til de hæver og er gyldne."
    },
    {
      "section": "Fladbrød",
      "text": "Pensl brødene med olivenolie, skær dem i stykker, og hold dem varme i et rent viskestykke."
    },
    {
      "section": "Lammekoteletter",
      "text": "Varm imens en grillpande eller stegepande, til den er rigtig varm. Steg koteletterne 2-3 minutter på hver side, til de har fået en mørk, aromatisk skorpe. Steg dem eventuelt i omgange."
    },
    {
      "section": "Lammekoteletter",
      "text": "Lad kødet hvile i 5 minutter."
    },
    {
      "section": "Til servering",
      "text": "Tag nogle skalotteløgsringe op af lagen til pynt. Resten kan blive i køleskabet og bruges til andre retter."
    },
    {
      "section": "Til servering",
      "text": "Smør mynteyoghurten ud på tallerkenerne med bagsiden af en ske. Fordel fladbrødene, og læg 3 koteletter på hver tallerken, så de står lidt op. Top med de syltede løg."
    },
    {
      "section": "Til servering",
      "text": "Dryp med lidt olivenolie, og server med myntblade og et drys sumak, røget paprika, salt og peber."
    }
  ],
