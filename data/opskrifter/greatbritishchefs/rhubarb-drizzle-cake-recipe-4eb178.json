  "steps": [
    {
      "section": "Syltet rabarber",
      "text": "Begynd dagen før. Læg rabarberbåndene i en bøtte eller dyb skål."
    },
    {
      "section": "Syltet rabarber",
      "text": "Kom eddike, vand, sukker, appelsinskal og salt i en lille kasserolle. Bring det i kog, og lad det simre. Lad lagen køle af til stuetemperatur."
    },
    {
      "section": "Syltet rabarber",
      "text": "Hæld den afkølede lage over rabarberbåndene, og stil dem i køleskabet natten over."
    },
    {
      "section": "Kage",
      "text": "Forvarm ovnen til 180 °C. Beklæd en brødform med bagepapir."
    },
    {
      "section": "Kage",
      "text": "Pisk sukker og smør i en stor skål, til det er lyst og luftigt. Pisk æggene i et ad gangen, og pisk grundigt mellem hvert."
    },
    {
      "section": "Kage",
      "text": "Vend mel, mandler, bagepulver, mælk og salt i dejen med en spatel. Vend til sidst den hakkede rabarber i."
    },
    {
      "section": "Kage",
      "text": "Hæld dejen i formen, og bag kagen i 1 time, til en spiseskeen eller en grillpind, der stikkes ned i midten, kommer ren op."
    },
    {
      "section": "Rabarberglasur",
      "text": "Smelt smørret i en lille kasserolle, mens kagen bager. Kog rabarberne i smørret i 5 minutter, til de er møre."
    },
    {
      "section": "Rabarberglasur",
      "text": "Tag gryden af varmen, og tilsæt flormelis, fløde og salt. Blend glasuren glat med en stavblender, og stil den til afkøling."
    },
    {
      "section": "Vaniljeflødeskum",
      "text": "Pisk fløden stiv med el-pisker eller i en røremaskine, og tilsæt sukkeret lidt ad gangen. Vend vaniljepastaen i, når skummet står stift, og stil det til side."
    },
    {
      "section": null,
      "text": "Lad den bagte kage hvile i formen i 15 minutter. Løft den derefter ud, og lad den køle helt af på en rist."
    },
    {
      "section": null,
      "text": "Fordel glasuren over hele kagen, og lad den sætte sig lidt. Server skiver af kagen med en rigelig klat flødeskum og syltede rabarberbånd på toppen."
    }
  ],
  "changes": [
