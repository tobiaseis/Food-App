  "steps": [
    {
      "section": "Riskager",
      "text": "Lav radise-kimchien mindst 5 dage før, eller køb den færdig i supermarkedet."
    },
    {
      "section": "Riskager",
      "text": "Skyl risene fire gange, til vandet er næsten klart. Kom dem i en gryde med vand, så de er dækket, og bring det i kog ved svag varme."
    },
    {
      "section": "Riskager",
      "text": "Læg låg på, og lad risene simre i 10 minutter. Tag gryden af varmen, og lad risene dampe under låg i yderligere 10 minutter."
    },
    {
      "section": "Dressing",
      "text": "Pisk alle ingredienserne til dressingen sammen, mens risene koger."
    },
    {
      "section": "Riskager",
      "text": "Luft risene med en gaffel, og lad dem køle lidt af. Vend dem med majsstivelse og et nip salt."
    },
    {
      "section": "Riskager",
      "text": "Varm olien op ved middel varme i en stor non-stick pande. Pres risene ud i et tyndt lag, og lad dem stege uden at røre i 10-15 minutter, til undersiden er gylden og sprød."
    },
    {
      "section": "Riskager",
      "text": "Vend risene i store stykker, så der kommer enkelte kager, og steg dem, til den anden side også er gyldenbrun."
    },
    {
      "section": "Salat",
      "text": "Kom riskager, agurk, gulerod, urter og dressing i en stor skål. Tilsæt kimchi, og vend det hele sammen."
    },
    {
      "section": "Til servering",
      "text": "Anret salaten på et fad. Top med ekstra kimchi, revet limeskal, forårsløg og sesamfrø. Dryp med chiliolie, og server med limebåde."
    }
  ],
  "changes": [
