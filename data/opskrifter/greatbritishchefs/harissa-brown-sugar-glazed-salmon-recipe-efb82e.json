  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 200 °C. Beklæd en bageplade med bagepapir."
    },
    {
      "section": null,
      "text": "Læg laksen på pladen og drys den rigeligt med salt over det hele."
    },
    {
      "section": null,
      "text": "Rør harissa, brun farin, hvidløg, eddike og olivenolie sammen i en skål. Smag til med salt og eventuelt lidt mere eddike."
    },
    {
      "section": null,
      "text": "Hæld marinaden over laksen, og smør den ud med hænderne eller en lille spatel, så fisken er dækket hele vejen rundt."
    },
    {
      "section": null,
      "text": "Bag laksen i 15-20 minutter, til den er gennemstegt og har en kernetemperatur på 63 °C."
    },
    {
      "section": null,
      "text": "Drys med flagesalt og krydderurter. Server laksen direkte på bordet, så alle kan tage selv."
    }
  ],
