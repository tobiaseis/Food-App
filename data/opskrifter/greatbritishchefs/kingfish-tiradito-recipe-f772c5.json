  "steps": [
    {
      "section": "Purløgsolie",
      "text": "Start med oliene, gerne dagen før. Blend purløg og rapsolie på høj hastighed i 5 minutter, til olien er skarpt grøn."
    },
    {
      "section": "Purløgsolie",
      "text": "Sigt olien over en skål med et musselinklæde eller et stykke køkkenrulle i sigten."
    },
    {
      "section": "Skaldyrsolie",
      "text": "Varm lidt af rapsolien i en gryde ved middel varme. Svits skalotteløg, hvidløg og rejer, til skallerne er blevet røde."
    },
    {
      "section": "Skaldyrsolie",
      "text": "Hæld resten af olien i, og tilsæt røget paprika og tørret chili. Lad det simre svagt i 30 minutter, til olien er dybrød."
    },
    {
      "section": "Skaldyrsolie",
      "text": "Sigt olien gennem musselinklæde eller køkkenrulle over en skål."
    },
    {
      "section": "Fisk og bejdse",
      "text": "Læg fiskefileten på en bakke. Bland salt og sukker, og gnid blandingen ind over hele fisken. Lad den bejdse i 30 minutter."
    },
    {
      "section": "Leche de tigre",
      "text": "Kom alle ingredienserne til leche de tigre i en blender, og blend dem helt glatte. Smag til: mere sambal oelek giver mere styrke, og lidt ekstra sukker tager skarpheden af."
    },
    {
      "section": "Leche de tigre",
      "text": "Si væsken fint over i en sprøjteflaske eller kande, og stil den på køl, til den skal bruges."
    },
    {
      "section": "Fisk og bejdse",
      "text": "Skyl bejdsen af fisken, og dup den tør. Skær den på tværs i mundrette skiver."
    },
    {
      "section": "Til servering",
      "text": "Dæk bunden af hver tallerken med leche de tigre. Sæt pletter af skaldyrsolie og purløgsolie ovenpå – det er lettest med sprøjteflasker, men en ske går også."
    },
    {
      "section": "Til servering",
      "text": "Læg fiskeskiverne ovenpå, og pynt med hasselnødder, appelsin, jalapeño, koriander, karse og radiser. Afslut med klatter af labneh."
    }
  ],
