  "steps": [
    {
      "section": "Syltede surkirsebær",
      "text": "Gør kirsebærrene klar dagen før. Kom dem i en varmefast, lufttæt beholder."
    },
    {
      "section": "Syltede surkirsebær",
      "text": "Kog eddike, vand og sukker op, og hæld det varme lage over kirsebærrene. Lad dem køle helt af i lagen, og stil dem derefter i køleskabet i mindst 24 timer."
    },
    {
      "section": "Braiseret hjortebov",
      "text": "Begynd om morgenen dagen før servering. Varm ovnen op til 95 °C."
    },
    {
      "section": "Braiseret hjortebov",
      "text": "Rist alle krydderierne tørt i en stor ovnfast gryde, og tag dem op igen."
    },
    {
      "section": "Braiseret hjortebov",
      "text": "Krydr hjortebovens kød kraftigt med salt og peber, og brun det gyldent i lidt olie. Tag kødet op, og brun grøntsagerne i omgange. Tilsæt lidt vand mellem hver omgang for at løsne bundfaldet, og gem vandet."
    },
    {
      "section": "Braiseret hjortebov",
      "text": "Læg kød og grøntsager tilbage i gryden sammen med krydderierne, vinen og det gemte vand. Fyld om nødvendigt op med vand, så væsken når to tredjedele op ad kødet."
    },
    {
      "section": "Braiseret hjortebov",
      "text": "Sæt låg på, og lad det braisere i ovnen i 10-12 timer, til kødet er mørt og falder fra hinanden."
    },
    {
      "section": "Braiseret hjortebov",
      "text": "Si væsken gennem en fin si over en skål, og gem den. Kassér grøntsagerne, og pil kødet af benet og træk det i strimler. Der skal komme omkring 1 kg."
    },
    {
      "section": "Borek",
      "text": "Svits løget blødt i lidt olie. Kog imens den gemte braisevæske ind til ca. 2,5 dl."
    },
    {
      "section": "Borek",
      "text": "Bland det trevlede kød med den indkogte væske, løget, krydderiblandingen, tranebærrene og eventuelt kødlim."
    },
    {
      "section": "Borek",
      "text": "Rul massen til en tyk pølse i husholdningsfilm, og læg den på køl, til den er fast. Det kan godt være natten over."
    },
    {
      "section": "Hjorteryg",
      "text": "Gnid hjorteryggen ind i krydderiblandingen og granatæblemelassen."
    },
    {
      "section": "Hjorteryg",
      "text": "Vakuumpak den med hvidløg og timian, og tilbered den i vandbad ved 52 °C i 2 timer."
    },
    {
      "section": "Hjorteryg",
      "text": "Uden vakuummaskine og vandbad: Brun ryggen på alle sider i lidt olie ved middelhøj varme, og øs derefter rigeligt smør over, til kødet er tilpas stegt. Gør det først lige inden servering."
    },
    {
      "section": "Selleripuré",
      "text": "Brun sellerien i en varm pande med lidt olie. Tilsæt smør, løg, hvidløg og timian, og svits det."
    },
    {
      "section": "Selleripuré",
      "text": "Hæld mælk og fløde på, og lad det småkoge, til grøntsagerne er bløde."
    },
    {
      "section": "Selleripuré",
      "text": "Blend det glat, og rør Marmite i. Brug mere, hvis du vil have en kraftigere umamismag."
    },
    {
      "section": "Selleripuré",
      "text": "Kom purérn i en lufttæt beholder, og læg film direkte på overfladen. Lad den køle af, og stil den på køl."
    },
    {
      "section": "Persilleolie",
      "text": "Blend persille og olie på høj hastighed. Hvis du har en Thermomix, blend til 65 °C. Ellers blend i foodprocessor eller blender i 7 minutter, så olien bliver varm, og den grønne farve fæstner sig."
    },
    {
      "section": "Persilleolie",
      "text": "Si olien gennem et musselinklæde i en fin si, og lad den dryppe igennem. Opbevar den på køl."
    },
    {
      "section": "Jus",
      "text": "Brun løget i lidt olie, til det er blødt. Tilsæt en klat smør, hvidløg og kardemomme, skru op for varmen, og lad det karamellisere."
    },
    {
      "section": "Jus",
      "text": "Hæld rødvinen i, og kog den ind til det halve. Tilsæt begge fonde, og kog ind til en fyldig konsistens."
    },
    {
      "section": "Jus",
      "text": "Rund af med en klat smør og espresso. Lad juicen køle af, og stil den på køl."
    },
    {
      "section": "Borek",
      "text": "Når kødrullen er fast, lægges to ark filodej, så de overlapper i midten og danner en bund. Pensl med smeltet smør."
    },
    {
      "section": "Borek",
      "text": "Læg de øvrige ark ovenpå ét ad gangen, og pensl hvert lag rigeligt med smør. Arkene skal mindst være lige så lange som kødrullen."
    },
    {
      "section": "Borek",
      "text": "Rul kødrullen stramt ind i dejen, og fold kanterne ind. Stil den på køl, til den er fast."
    },
    {
      "section": "Borek",
      "text": "Skær rullen i portioner, og pynt eventuelt ved at skære enderne af. Læg portionerne med snitfladen opad på en bageplade, og læg en klat smør på hver. Stil dem på køl, til de skal bruges."
    },
    {
      "section": null,
      "text": "Når du skal servere, varmes ovnen op til 180 °C, og en grill tændes til direkte varme. Tag de syltede kirsebær ud, så de når stuetemperatur."
    },
    {
      "section": null,
      "text": "Bag boreken i 10-12 minutter, til den er gylden og gennemvarm."
    },
    {
      "section": null,
      "text": "Grill hjorteryggen over høj varme, til den får fin farve. Vend den ofte, og pensl med granatæblemelasse og smeltet smør. Lad den hvile bagefter."
    },
    {
      "section": null,
      "text": "Varm selleripuréen og juicen op imens."
    },
    {
      "section": null,
      "text": "Anret ved at lægge en portion purée på hver tallerken og trykke en fordybning i midten. Hæld lidt jus i fordybningen, og sæt boreken ovenpå. Skær hjorteryggen i skiver, og læg en skive på hver borek. Pynt med syltede kirsebær, karse, få dråber granatæblemelasse og lidt persilleolie."
    }
  ],
