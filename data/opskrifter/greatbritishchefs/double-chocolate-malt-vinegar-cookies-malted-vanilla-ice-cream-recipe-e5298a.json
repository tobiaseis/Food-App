  "steps": [
    {
      "section": "Til isen",
      "text": "Pisk æggeblommer, sukker og maltmælkepulver med elpisker, til det er lyst og luftigt."
    },
    {
      "section": "Til isen",
      "text": "Varm mælk og fløde sammen i en gryde, til der står damp op af dem. Lad dem ikke koge."
    },
    {
      "section": "Til isen",
      "text": "Hæld den varme mælkeblanding i æggeblommerne i en tynd stråle, mens du pisker hele tiden. Kom det hele tilbage i gryden."
    },
    {
      "section": "Til isen",
      "text": "Varm cremen over meget svag varme under omrøring, til den tykner og har ca. 75 °C."
    },
    {
      "section": "Til isen",
      "text": "Rør vaniljepasta og eddike i. Hæld cremen i en beholder med låg, og stil den på køl natten over."
    },
    {
      "section": "Til isen",
      "text": "Kør cremen i ismaskine dagen efter. Frys isen derefter i ca. 3 timer, til den er fast."
    },
    {
      "section": "Til cookies",
      "text": "Smelt chokolade og smør sammen, og lad det køle lidt af."
    },
    {
      "section": "Til cookies",
      "text": "Pisk æg, brun farin og vaniljeekstrakt med elpisker, til det er lyst og luftigt. Pisk den smeltede chokolade i, og tilsæt derefter eddiken."
    },
    {
      "section": "Til cookies",
      "text": "Sigt kakao, mel, bagepulver og salt ned i dejen, og vend det forsigtigt sammen. Rør chokoladechips i, og stil dejen på køl i 1 time."
    },
    {
      "section": "Til cookies",
      "text": "Tænd ovnen på 180 °C varmluft."
    },
    {
      "section": "Til cookies",
      "text": "Del dejen i ca. 10 klatter, og fordel dem på to bageplader med bagepapir. Sørg for god afstand mellem dem."
    },
    {
      "section": "Til cookies",
      "text": "Bag cookiesene i 10–12 minutter, til overfladen er revnet, men midten stadig er blød. Lad dem køle lidt af."
    },
    {
      "section": "Til cookies",
      "text": "Server de lune cookies med store kugler is."
    }
  ],
