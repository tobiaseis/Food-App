  "steps": [
    {
      "section": "Oksespidsbryst",
      "text": "Start mindst 2 dage før servering. Kog vand og salt op, og rør, til saltet er opløst. Lad saltlagen køle helt af."
    },
    {
      "section": "Oksespidsbryst",
      "text": "Læg kødet i en bakke, og dæk det med saltlagen. Lad det stå i køleskabet i 3 timer."
    },
    {
      "section": "Oksespidsbryst",
      "text": "Mal alle krydderierne til et fint pulver i en krydderikværn eller en mortér."
    },
    {
      "section": "Oksespidsbryst",
      "text": "Tag kødet op af saltlagen, tør det og gnid det ensartet ind i krydderiblandingen. Vakuumpak det, og kog det sous vide i vandbad ved 84 °C i 24 timer, til det er mørt."
    },
    {
      "section": "Hvidløgskonfit",
      "text": "Varm hvidløg, olie og salt op i en sauterpande ved svag varme. Lad det småkoge i 3 timer, til hvidløgene er bløde. Lad det køle af, og opbevar det i olien i køleskabet. Tag ca. 60 g konfit til side til borsjtjen. Der bliver rester."
    },
    {
      "section": "Brioche med sort hvidløg",
      "text": "Kom melet i en røremaskineskål. Blend sort hvidløg, gær, mælk, æg og sukker glat i en foodprocessor."
    },
    {
      "section": "Brioche med sort hvidløg",
      "text": "Rør blandingen gradvist i melet ved lav hastighed, til det samler sig til en dej. Ælt i ca. 7 minutter, til dejen får struktur."
    },
    {
      "section": "Brioche med sort hvidløg",
      "text": "Tilsæt saltet. Pisk derefter det kolde smør i dejen lidt ad gangen, og vent med mere, til hvert hold er blandet helt ind."
    },
    {
      "section": "Brioche med sort hvidløg",
      "text": "Læg dejen i en skål, og lad den hæve ved stuetemperatur i 30 minutter. Slå den ned, og lad den hæve 30 minutter mere. Stil den derefter i køleskabet i 3-8 timer."
    },
    {
      "section": "Glaze til oksespidsbryst",
      "text": "Når kødet er færdigt, hæld 500 ml af kogesaften i en gryde, og kog den ind til det halve. Tilsæt smør, paprika, eddike og honning, og lad det simre sammen til en blank, rig glaze med balance mellem sødme og syre."
    },
    {
      "section": "Oksespidsbryst",
      "text": "Tag benene fra kødet, og pres kødet mellem to bakker. Læg en vægt ovenpå, og lad det trække i køleskabet natten over. Skær det næste dag i terninger på 3 cm, og opbevar dem koldt."
    },
    {
      "section": "Brioche med sort hvidløg",
      "text": "Smør bageformene godt ind med smør. Del den hvilede dej i 4 stykker, og del hvert stykke i 9. Rul dem til runde boller."
    },
    {
      "section": "Brioche med sort hvidløg",
      "text": "Læg 8 boller langs kanten af hver form og 1 i midten. Lad dem efterhæve køligt, til de er hævede, og dejen ikke springer helt tilbage ved et let tryk."
    },
    {
      "section": "Brioche med sort hvidløg",
      "text": "Stil formene i køleskabet i 10-15 minutter, så smørret stivner. Pensl med æggeblomme."
    },
    {
      "section": "Brioche med sort hvidløg",
      "text": "Forvarm ovnen til 200 °C. Drys brødene med flagesalt, og bag dem i 40-45 minutter, til de er gyldne, hævede og gennembagte. Sænk temperaturen eller dæk med folie, hvis de brunes for hurtigt."
    },
    {
      "section": "Æblefedt",
      "text": "Steg løget svagt i lidt af oksefedtet i ca. 10 minutter, til det er blødt. Tilsæt æblet, og steg 5 minutter mere."
    },
    {
      "section": "Æblefedt",
      "text": "Kom resten af fedtet i, og lad det simre ved svag varme i ca. 2 timer. Rør jævnligt."
    },
    {
      "section": "Æblefedt",
      "text": "Hæld det meste af fedtet i en foodprocessor, og lad lidt blive tilbage i panden, så resten kan blive sprødt. Tag de sprøde stykker op, og gem dem til servering."
    },
    {
      "section": "Æblefedt",
      "text": "Pulsér fedtet i processoren til en grov, ske-venlig konsistens. Afkøl helt, og stil det koldt."
    },
    {
      "section": "Rødbedepuré",
      "text": "Blend de hakkede rødbeder i en kraftig blender på fuld hastighed i 5 minutter, til de er helt glatte. Mål 250 g puré af til suppen."
    },
    {
      "section": "Borsjtj",
      "text": "Svits løg og gulerødder i olie i en stor gryde, til de er let karamelliserede. Rør tomatpuréen i, og lad den stege med i 2 minutter."
    },
    {
      "section": "Borsjtj",
      "text": "Kom de øvrige grøntsager og hvidløgskonfitten i, og lad det stege og blødgøres i 5 minutter."
    },
    {
      "section": "Borsjtj",
      "text": "Hæld oksefond, rødbedejuice og de 250 g rødbedepuré i. Tilsæt laurbærblade, peberkorn, tørrede pærer, begge slags eddike, jalapeños, sukker og salt."
    },
    {
      "section": "Borsjtj",
      "text": "Lad suppen simre svagt i ca. 1 time, så smagene samler sig, og suppen forbliver klar og afbalanceret."
    },
    {
      "section": "Peberrodssauce",
      "text": "Blend peberrod og rødbedejuice glat i en kraftig blender i 3 minutter. Fyld saucen i en sprøjtepose, og stil den til side."
    },
    {
      "section": "Servering",
      "text": "Varm suppen forsigtigt op, så balancen mellem sødt, surt og dybde bevares, og øs den i skåle."
    },
    {
      "section": "Servering",
      "text": "Varm oksekødsterningerne i glazen, til de er helt varme og dækket af den. Server 1 terning pr. person."
    },
    {
      "section": "Servering",
      "text": "Varm æblefedtet blidt op, og kom det i en lille skål. Top med de sprøde stykker."
    },
    {
      "section": "Servering",
      "text": "Sprøjt prikker af peberrodssauce og sennep på en tallerken. Kom creme fraiche, forårsløg, persille og dild i små skåle. Server suppen med kødet og brioche-brødene, hvor hvert brød rækker til 2 personer. Kom varmt æblefedt på suppen, så det smelter ud."
    }
  ],
  "changes": [
    "Hvedemel erstatter T65-mel.",
    "Røget paprika erstatter Urfa-peber.",
    "Tørrede pærer erstatter de røgede tørrede pærer.",
    "Creme fraiche erstatter soured cream.",
    "Revet peberrod på glas erstatter peberrodspasta."
  ]
