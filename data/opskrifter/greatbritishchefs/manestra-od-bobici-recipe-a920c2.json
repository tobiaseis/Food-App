  "steps": [
    {
      "section": null,
      "text": "Kom bønner, spareribs, svineskank, gulerod, selleri, majs og laurbærblade i en stor gryde. Tilsæt en god sløjfe salt og dæk med koldt vand."
    },
    {
      "section": null,
      "text": "Bring det i kog, og lad det så småkoge svagt i ca. 2 timer. Rør af og til."
    },
    {
      "section": null,
      "text": "Kog imens pastaen al dente i rigeligt saltet vand. Si den fra og stil den til side."
    },
    {
      "section": null,
      "text": "Blødgør løg og hvidløg i en lille pande med en god skvæt olivenolie. Tilsæt tomat, røget paprika og en knivspids salt, og steg et par minutter mere. Stil panden til side."
    },
    {
      "section": null,
      "text": "Tag ribs og skank op af gryden, når de 2 timer er gået. Pil kødet af ribbenene, og skær majskernerne af kolberne. Kom kød og kerner tilbage i suppen, og smid knoglerne ud."
    },
    {
      "section": null,
      "text": "Rør løgblandingen og pastaen i suppen. Tilsæt eddiken lidt ad gangen – start med halvdelen – og smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Server maneštraen med sprødt brød."
    }
  ],
  "changes": [
    "Røget skinkeknogle er erstattet af røget svineskank."
