  "steps": [
    {
      "section": "Syltet chili",
      "text": "Kom eddike og sukker i en lille kasserolle, og lad det småkoge. Hæld den varme lage over chiliskiverne, og lad dem trække og køle af, mens du laver resten."
    },
    {
      "section": "Bønnecreme",
      "text": "Kør bønner, hvidløg, citronsaft, olivenolie, persille, dild og purløg i en foodprocessor, til massen er jævn og cremet. Tilsæt en smule vand, hvis den er for tør. Smag til med rigeligt salt og peber."
    },
    {
      "section": "Sprød rosmarin",
      "text": "Varm et tyndt lag olie op i en lille pande. Steg rosmarinnålene i få sekunder, til de er sprøde og dufter. Tag dem op og lad dem dryppe af på køkkenrulle."
    },
    {
      "section": "Til servering",
      "text": "Rist brødet, til det er gyldent. Smør bønnecremen tykt ovenpå, eller sprøjt den på med en sprøjtepose. Læg syltet chili og sprød rosmarin på toppen."
    },
    {
      "section": "Til servering",
      "text": "Dryp med lidt olivenolie, og drys med dild, chiliskiver og flagesalt. Server toastene lune."
    }
  ],
