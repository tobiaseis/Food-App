  "steps": [
    {
      "section": "Pommes frites",
      "text": "Varm ovnen op til 200 °C. Fordel pommes fritesene i ét lag på en stor bageplade."
    },
    {
      "section": "Pommes frites",
      "text": "Bag dem efter anvisningen på posen, men giv dem et par minutter ekstra, til de er dybt gyldne og sprøde. Vend dem undervejs midt i tiden."
    },
    {
      "section": "Pommes frites",
      "text": "Kom dem i en stor skål og drys med salt."
    },
    {
      "section": "Glasur",
      "text": "Mens pommes fritesene bager, blandes alle ingredienser til glasuren i en lille kasserolle."
    },
    {
      "section": "Glasur",
      "text": "Varm dem forsigtigt på lav varme i 1-2 minutter under konstant omrøring, til glasuren er blank og lidt tykkere."
    },
    {
      "section": "Glasur",
      "text": "Tilsæt vandet lidt ad gangen, til glasuren er klistret, men stadig kan hældes. Den skal dække bagsiden af en ske."
    },
    {
      "section": "Til servering",
      "text": "Hæld glasuren over pommes fritesene, og vend dem forsigtigt, så de er dækket."
    },
    {
      "section": "Til servering",
      "text": "Læg dem på et fad, og top med sesamfrø, forårsløg og chili."
    }
  ],
