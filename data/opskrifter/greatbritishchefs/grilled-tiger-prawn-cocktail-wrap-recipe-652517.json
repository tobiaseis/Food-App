  "steps": [
    {
      "section": "Fladbrød",
      "text": "Kog vand op i en lille gryde. Blancher aspargesene i 30 sekunder, og køl dem af i isvand. Lad dem dryppe godt af, tør dem og hak dem fint."
    },
    {
      "section": "Fladbrød",
      "text": "Bland hvedemel, salt og bagepulver i en stor skål. Rør de hakkede asparges og olivenolien i."
    },
    {
      "section": "Fladbrød",
      "text": "Hæld det lunkne vand i lidt ad gangen, mens du rører med en gaffel eller hænderne, til dejen er blød og smidig. Ælt den i 5-6 minutter, til den er glat. Dæk til, og lad den hvile i 20 minutter."
    },
    {
      "section": "Rejer",
      "text": "Vend rejerne med hvidløg, røget paprika, olivenolie, salt og peber. Lad dem marinere i 15-20 minutter."
    },
    {
      "section": "Cocktailsauce",
      "text": "Pisk æggeblomme, eddike, citronsaft og sennep sammen i en ren skål eller en blender."
    },
    {
      "section": "Cocktailsauce",
      "text": "Tilsæt olien dråbevis under konstant piskning eller blendning, og øg til en jævn tynd stråle, når saucen begynder at binde."
    },
    {
      "section": "Cocktailsauce",
      "text": "Rør tomatpuré, worcestershiresauce og tabasco i. Smag til med salt og eventuelt mere citronsaft."
    },
    {
      "section": "Fladbrød",
      "text": "Del dejen i fire lige store kugler. Rul hver kugle ud på en meldrysset flade til cirka 20 cm i diameter."
    },
    {
      "section": "Fladbrød",
      "text": "Varm en tør pande eller grillpande op ved middelhøj til høj varme. Steg fladbrødene 1-2 minutter på hver side, til de hæver og får brune pletter. Hold dem varme i et viskestykke."
    },
    {
      "section": "Rejer",
      "text": "Varm en grillpande, til den ryger. Grill rejerne 1-2 minutter på hver side, til de lige er færdige og har lidt grillmærker. Stil dem til side."
    },
    {
      "section": "Til servering",
      "text": "Smør cocktailsauce på de varme fladbrød. Læg rucola og de grillede rejer ovenpå."
    },
    {
      "section": "Til servering",
      "text": "Pres citron over, og dryp eventuelt lidt olivenolie til sidst."
    }
  ],
  "changes": [
    "Asparges erstatter samphire, som er svær at få i danske supermarkeder."
  ]
