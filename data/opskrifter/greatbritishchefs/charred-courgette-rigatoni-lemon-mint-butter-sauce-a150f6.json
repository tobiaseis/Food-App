  "steps": [
    {
      "section": "Citron- og myntesmør",
      "text": "Pisk det bløde smør sammen med citronskal, citronsaft, mynte, hvidløg og en knivspids salt, til det er jævnt."
    },
    {
      "section": "Squash",
      "text": "Vend squashskiverne med olie, hvidløg, citronsaft og en knivspids salt i en skål. Lad dem stå til side."
    },
    {
      "section": "Squash",
      "text": "Gør grillen klar til direkte varme. Grill skiverne 2-3 minutter på hver side, til de har fået tydelige grillstriber."
    },
    {
      "section": "Squash",
      "text": "Skær den grillede squash i mundrette stykker og stil den til side."
    },
    {
      "section": "Pasta",
      "text": "Kog rigatoni al dente i rigeligt saltet vand. Gem 2,5 dl af kogevandet, og hæld resten fra."
    },
    {
      "section": "Pasta",
      "text": "Steg kapers i olien på en pande ved middel varme, til de åbner sig lidt og er sprøde. Tag dem op med en hulske, og lad dem dryppe af på køkkenrulle."
    },
    {
      "section": "Pasta",
      "text": "Vend den varme pasta med smørret og en sjat af kogevandet. Du kan bruge mindre smør, men brug mindst 100 g. Rør, til smørret danner en cremet sauce, og vend så squashen i."
    },
    {
      "section": "Pasta",
      "text": "Fordel pastaen i skåle. Top med sprøde kapers, parmesan, mynteblade og peber, og dryp med lidt olivenolie."
    }
  ],
  "changes": []
