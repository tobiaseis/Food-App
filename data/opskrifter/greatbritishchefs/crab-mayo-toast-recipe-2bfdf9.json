  "steps": [
    {
      "section": "Syltede radiser",
      "text": "Rør eddike, sukker og salt sammen, til sukker og salt er opløst."
    },
    {
      "section": "Syltede radiser",
      "text": "Kom radiseskiverne i lagen, og lad dem trække i 10-15 minutter."
    },
    {
      "section": "Krabbesalat",
      "text": "Vend krabbekød, mayonnaise, sennep, citronskal, citronsaft og olie sammen. Vend forsigtigt, så krabbekødet ikke går i stykker."
    },
    {
      "section": "Krabbesalat",
      "text": "Smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Rist brødskiverne let, så de er sprøde yderst og stadig bløde indeni."
    },
    {
      "section": "Til servering",
      "text": "Fordel krabbesalaten jævnt på det ristede brød, og læg nogle syltede radiseskiver ovenpå."
    },
    {
      "section": "Til servering",
      "text": "Drys med dild, purløg og lidt revet citronskal. Server straks med en citronbåd til at presse over."
    }
  ],
