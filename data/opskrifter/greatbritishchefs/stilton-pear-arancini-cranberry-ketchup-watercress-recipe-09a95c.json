  "steps": [
    {
      "section": "Risotto",
      "text": "Varm en stor pande op ved middel varme. Smelt halvdelen af smørret, og svits løget blødt. Skru ned for varmen, hvis det begynder at brænde på."
    },
    {
      "section": "Risotto",
      "text": "Rør hvidløget i, og steg det, til det dufter. Tilsæt pæren, og steg et minut mere."
    },
    {
      "section": "Risotto",
      "text": "Vend risene ud i panden, og rist dem i ca. 1 minut under omrøring. Hæld hvidvinen over, og rør, til den er trukket helt ind."
    },
    {
      "section": "Risotto",
      "text": "Tilsæt fonden lidt ad gangen med en øse. Lad risene optage hver øse, før du hælder den næste i, og rør ofte. Det er ikke sikkert, at du skal bruge al fonden."
    },
    {
      "section": "Risotto",
      "text": "Tag panden af varmen, når risene er møre og færdigkogte. Rør parmesan, stilton og resten af smørret i, og smag til med salt og peber."
    },
    {
      "section": "Risotto",
      "text": "Fordel risottoen på en bageplade med bagepapir, dæk med film, og stil den på køl, til den er helt afkølet."
    },
    {
      "section": "Tranebærketchup",
      "text": "Imens: Bring tranebær, rødløg og vand i kog i en gryde, og lad det simre i ca. 15 minutter."
    },
    {
      "section": "Tranebærketchup",
      "text": "Blend massen glat, og hæld den tilbage i gryden. Tilsæt sukker, eddike, salt og kanelstangen."
    },
    {
      "section": "Tranebærketchup",
      "text": "Lad ketchuppen simre i 20-25 minutter, til den er tyk. Stil den til afkøling."
    },
    {
      "section": "Tomatsalsa med stilton",
      "text": "Bland alle ingredienserne til salsaen i en stor skål, og smag til med salt og peber."
    },
    {
      "section": "Arancini",
      "text": "Afvej portioner af den kolde risotto på ca. 70 g, og form dem til kugler med olierede hænder. Tryk et hul i midten af hver kugle, og læg et stykke stilton i."
    },
    {
      "section": "Arancini",
      "text": "Luk risene om osten, og læg kuglerne på en bageplade med bagepapir."
    },
    {
      "section": "Arancini",
      "text": "Varm olien op til 170 °C i en tykbundet gryde med høje kanter, mens du former resten."
    },
    {
      "section": "Arancini",
      "text": "Stil mel, sammenpisket æg og krydret panko op i hver sin skål. Vend kuglerne i mel, derefter æg og så panko. Gentag æg og panko en gang til, så de får en dobbelt panering."
    },
    {
      "section": "Arancini",
      "text": "Frit kuglerne i et par minutter, til de er gyldne. Tag dem op, og lad dem dryppe af på køkkenrulle."
    },
    {
      "section": "Salat",
      "text": "Pisk olie, honning, eddike, salt og peber sammen til en vinaigrette, og stil den til side. Skyl rucolaen."
    },
    {
      "section": "Salat",
      "text": "Vend rucolaen i vinaigretten lige før servering."
    },
    {
      "section": "Til servering",
      "text": "Anret en håndfuld salat midt på hver tallerken, og kom salsa ovenpå. Læg tre arancini i midten, og top med tranebærketchup."
    },
    {
      "section": "Til servering",
      "text": "Dryp med olivenolie, og strø purløg over ketchuppen."
    }
  ],
