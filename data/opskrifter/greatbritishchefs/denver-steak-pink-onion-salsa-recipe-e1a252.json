  "steps": [
    {
      "section": "Til de syltede løg",
      "text": "Læg de tynde løgskiver i en skål. Pisk eddike, vand, salt, sukker og lyserød peber sammen, og hæld det over løgene."
    },
    {
      "section": "Til de syltede løg",
      "text": "Stil skålen i køleskabet, og lad løgene syltes i mindst 1 time."
    },
    {
      "section": "Til salsaen",
      "text": "Afmål 200 g af de syltede løg, og bland dem i en skål med tomat, rødbeder, chili, persille og hvidløg."
    },
    {
      "section": "Til salsaen",
      "text": "Smag til med salt og peber. Rør olivenolien i lidt ad gangen, til salsaen har den konsistens, du kan lide. Hvis du vil have den tyk, skal du ikke bruge det hele. Stil den til side."
    },
    {
      "section": "Til bøffen",
      "text": "Varm olien i en pande over middelhøj varme. Krydr bøfferne rigeligt med salt og peber."
    },
    {
      "section": "Til bøffen",
      "text": "Når panden ryger, lægger du bøfferne forsigtigt i. Steg dem i 2 minutter uden at røre ved dem."
    },
    {
      "section": "Til bøffen",
      "text": "Vend bøfferne, og kom smør, rosmarin, timian og hvidløg på panden. Øs det smeltede smør over kødet i cirka 1 minut."
    },
    {
      "section": "Til bøffen",
      "text": "Mål kernetemperaturen med et stegetermometer. Ved 55°C tager du bøfferne op på et bræt eller fad og lader dem hvile i 5 minutter."
    },
    {
      "section": "Til bøffen",
      "text": "Skær bøfferne i skiver på tværs af fibrene. Anret med salsaen ovenpå, og drys med lyserød peber."
    }
  ],
  "changes": [
    "Denver steak er erstattet af culotte, som er nemmere at få i Danmark.",
    "Vegetabilsk olie er erstattet af rapsolie.",
    "Lyserøde peberkorn hedder lyserød peber."
  ]
