  "steps": [
    {
      "section": null,
      "text": "Dagen før: Rør ginen og fennikelfrøene sammen i en lufttæt beholder, og lad den stå natten over ved stuetemperatur, så smagen trækker."
    },
    {
      "section": null,
      "text": "Si ginen gennem en fin si. Til de to drinks skal du bruge 120 ml. Resten kan gemmes."
    },
    {
      "section": null,
      "text": "Fyld en cocktailshaker med is, og hæld den afmålte gin, vermouth, lage og bitter i."
    },
    {
      "section": null,
      "text": "Rør eller ryst i 30 sekunder, til drinken er iskold. Sigt den over i to martiniglas."
    },
    {
      "section": "Pynt",
      "text": "Træk asier og oliven på en tandstik eller et lille spyd. Brænd dem med en gasbrænder, til skindet bobler og får sorte pletter."
    },
    {
      "section": "Pynt",
      "text": "Læg spyddet i glasset, og dryp lidt olivenolie over drinken."
    }
  ],
