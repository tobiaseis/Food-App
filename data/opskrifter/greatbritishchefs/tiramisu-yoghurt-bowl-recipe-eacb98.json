  "steps": [
    {
      "section": "Kaffechiabudding",
      "text": "Pisk chiafrø, espresso, mælk og lønnesirup sammen i en lille skål."
    },
    {
      "section": "Kaffechiabudding",
      "text": "Pisk yoghurten i, til massen er tyk og cremet. Stil skålen i køleskabet i mindst 15 minutter, så chiafrøene kan svulme op. Den kan også stå natten over."
    },
    {
      "section": "Klistret toffeesauce",
      "text": "Rør mandelsmør, lønnesirup, mælk og dadler sammen i en lille skål (eller blend), til saucen er glat som toffeesauce. Tilsæt lidt mere mælk, hvis den er for tyk."
    },
    {
      "section": "Til bowlen",
      "text": "Kom så meget yoghurt i en skål, som du har lyst til."
    },
    {
      "section": "Til bowlen",
      "text": "Læg frugten rundt langs kanten, og kom chiabuddingen i midten – lige så meget, du vil."
    },
    {
      "section": "Til bowlen",
      "text": "Hæld toffeesaucen ovenpå, og top med chokolade og müsli. Dryss kakaopulver over til sidst."
    }
  ],
