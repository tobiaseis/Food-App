  "steps": [
    {
      "section": "Gulerødderne",
      "text": "Tænd ovnen på 200 °C varmluft."
    },
    {
      "section": "Gulerødderne",
      "text": "Læg gulerødderne på en bageplade. Vend dem rundt i olivenolie, salt og peber. Fordel smørret i små klatter over dem."
    },
    {
      "section": "Gulerødderne",
      "text": "Rist gulerødderne i ovnen i 25–30 minutter, og vend dem én gang undervejs. De skal være møre og begynde at karamellisere i kanterne."
    },
    {
      "section": "Glasuren",
      "text": "Kom appelsinsaft og -skal, sirup, timianblade og brun farin i en lille gryde, mens gulerødderne er i ovnen. Lad det simre ved middel varme i 5–6 minutter, til glasuren er blank og lidt tykkere."
    },
    {
      "section": "Gremolataen",
      "text": "Bland alle ingredienserne til gremolataen, og smag til med salt. Blend det i en foodprocessor, til det er næsten glat."
    },
    {
      "section": "Glasuren",
      "text": "Hæld glasuren over de ristede gulerødder, og vend dem godt. Sæt dem tilbage i ovnen i 5 minutter, til de er klistrede og blanke."
    },
    {
      "section": "Servering",
      "text": "Anret gulerødderne på et fad, og top dem med lidt gremolata. Server resten ved siden af."
    },
    {
      "section": "Servering",
      "text": "Pynt med timiankviste, persilleblade, appelsinbåde, knust rosenpeber og lidt revet appelsinskal."
    }
  ],
