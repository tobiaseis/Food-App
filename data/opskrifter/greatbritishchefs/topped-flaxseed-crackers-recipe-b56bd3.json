  "steps": [
    {
      "section": "Hørfrøknækbrød",
      "text": "Tænd ovnen på 180 °C varmluft."
    },
    {
      "section": "Hørfrøknækbrød",
      "text": "Rør hørfrø, olivenolie, salt, peber og vand sammen, til det bliver en ujævn, klistret dej."
    },
    {
      "section": "Hørfrøknækbrød",
      "text": "Rul dejen ud mellem to ark bagepapir, så den er cirka 2 mm tyk. Løft den over på en bageplade, og tag det øverste ark papir af."
    },
    {
      "section": "Hørfrøknækbrød",
      "text": "Skær dejen i rektangler eller trekanter af nogenlunde samme størrelse med en skarp kniv. Bag dem i 25 minutter, til de er gyldne hele vejen over."
    },
    {
      "section": "Hørfrøknækbrød",
      "text": "Tag pladen ud, og løft forsigtigt papiret med knækbrødene over på en rist eller et varmefast underlag. Del dem fra hinanden, og lad dem køle helt af."
    },
    {
      "section": "Dildflødeost",
      "text": "Blend flødeost og dild sammen, og smag til med salt og peber. Stil den til side."
    },
    {
      "section": "Balsamicoreduktion",
      "text": "Kog balsamico og farin op ved middel varme. Lad det koge ind i cirka 15 minutter, til det er en tyk glaze. Tag det af varmen, og lad det køle af."
    },
    {
      "section": "Med røget ørred",
      "text": "Smør dildflødeost på nogle af knækbrødene, og læg ørred ovenpå. Drys med kerner og kapers."
    },
    {
      "section": "Med figen",
      "text": "Læg flødeost og et stykke figen på nogle knækbrød. Dryp med balsamicoreduktion og honning, og drys med hampefrø."
    },
    {
      "section": "Med skinke og melon",
      "text": "Læg skinke, melonstykker og cornichoner på nogle knækbrød, og drys med kerner."
    },
    {
      "section": "Med radiser",
      "text": "Top de sidste knækbrød med en rigelig skive smør, radiser og forårsløg."
    },
    {
      "section": "Til servering",
      "text": "Anret alle knækbrødene på et fad. Dryp med olivenolie, og drys med flagesalt."
    }
  ],
  "changes": [
    "Linwoods formalede hørfrø er erstattet med almindelige formalede hørfrø.",
