  "steps": [
    {
      "section": "Kartofler",
      "text": "Tænd ovnen på 190 °C."
    },
    {
      "section": "Kartofler",
      "text": "Læg kartoflerne på en bageplade med bagepapir. Gnid dem ind i olivenolie og salt, og prik dem med en gaffel."
    },
    {
      "section": "Kartofler",
      "text": "Bag dem i 1 time og 20 minutter, til skindet er sprødt, og kødet er blødt. Tag dem ud."
    },
    {
      "section": "Brunet smør til fyldet",
      "text": "Smelt smørret i en lille pande på middelvarme, og lad det simre ca. 8 minutter, til det er mørkt gyldent og dufter af nødder. Hæld det i en stor skål, som senere skal bruges til at made kartoflerne. Stil til side."
    },
    {
      "section": "Thermidorsauce",
      "text": "Smelt smørret til saucen i den samme pande. Svits skalotteløg i 2-3 minutter, til de er møre. Tilsæt hvidløg, og steg yderligere 1 minut."
    },
    {
      "section": "Thermidorsauce",
      "text": "Hæld hvidvinen i, og kog den ind til det halve. Rør fløde, sennep, Worcestershire sauce, parmesan, gruyère og cayennepeber i. Lad saucen simre svagt i 3 minutter, til den er lidt tykkere."
    },
    {
      "section": "Thermidorsauce",
      "text": "Vend persillen i, og smag til med salt og peber. Hold saucen varm."
    },
    {
      "section": "Krabbeblanding",
      "text": "Vend krabbekødet forsigtigt med citronskal, citronsaft, cayennepeber og peber. Stil det på køl, til det skal bruges."
    },
    {
      "section": "Samling",
      "text": "Skær de bagte kartofler over på langs, og skrab kødet ud. Kom det i skålen med brunet smør sammen med fløde og sennep til fyldet, og mos det til en jævn masse."
    },
    {
      "section": "Samling",
      "text": "Vend krabbeblandingen og thermidorsaucen i moset. Fyld det tilbage i kartoffelskallerne."
    },
    {
      "section": "Samling",
      "text": "Riv ekstra parmesan over, og gratinér under grillen i ca. 5 minutter, til toppen bobler og er let sprød i kanten."
    },
    {
      "section": "Samling",
      "text": "Top med purløg, peber og lidt cayennepeber. Server med citronbåde ved siden af."
    }
  ],
