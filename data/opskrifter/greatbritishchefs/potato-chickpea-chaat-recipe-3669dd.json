  "steps": [
    {
      "section": "Kikærter",
      "text": "Tænd ovnen på 200 °C."
    },
    {
      "section": "Kikærter",
      "text": "Vend kikærterne med olie, spidskommen, chili og salt. Læg dem på en bageplade med bagepapir og bag dem sprøde i 20-25 minutter."
    },
    {
      "section": "Kartofler",
      "text": "Varm lidt olie i en pande. Rist spidskommenfrø og karryblade, til det dufter."
    },
    {
      "section": "Kartofler",
      "text": "Kom kartofler og gurkemeje på panden, og smag til med salt. Steg i 15-20 minutter, og vend af og til, til kartoflerne er gyldne og møre."
    },
    {
      "section": "Myntechutney",
      "text": "Blend alle ingredienserne til chutneyen, mens kartoflerne steger."
    },
    {
      "section": "Chaat-krydderi",
      "text": "Bland krydderierne i en lille skål."
    },
    {
      "section": "Anretning",
      "text": "Kom de varme kartofler i en skål, og drys de bagte kikærter ovenpå."
    },
    {
      "section": "Anretning",
      "text": "Top med rødløg, klatter af yoghurt, skefulde af myntechutney og chaat-krydderiblandingen."
    },
    {
      "section": "Anretning",
      "text": "Pynt med korianderblade og grøn chili."
    }
  ],
