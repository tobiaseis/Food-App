  "steps": [
    {
      "section": "Havrebund",
      "text": "Rør havregryn, chiafrø, matcha, pistacier, bær, honning og mælk sammen. Fordel blandingen i seks små bøtter, læg låg på og sæt dem på køl natten over."
    },
    {
      "section": "Kompot",
      "text": "Næste dag: Kom bær, sukker og citronsaft i en gryde. Kog det ved middel-lav varme, til det er blevet som en marmelade. Lad kompotten køle lidt af."
    },
    {
      "section": "Pistaciefløde",
      "text": "Pisk fløden med flormelis, pistaciepasta og salt, til den danner bløde toppe. Fyld den i en sprøjtepose med stjernetud."
    },
    {
      "section": "Servering",
      "text": "Sprøjt en top af pistaciefløde på hver portion. Læg en skefuld kompot ved siden af, og drys med pistacier, chiafrø, hasselnødder og pekannødder. Dryp evt. med lidt ekstra honning."
    }
  ],
  "changes": [
    "Double cream er skiftet til piskefløde.",
