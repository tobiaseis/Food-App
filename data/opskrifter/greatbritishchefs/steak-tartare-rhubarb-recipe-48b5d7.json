  "steps": [
    {
      "section": "Syltet rabarber",
      "text": "Kom rabarbertern i én skål og rabarberbåndene i en anden."
    },
    {
      "section": "Syltet rabarber",
      "text": "Pisk vand, eddike, sukker, havsalt og lyserød peber sammen, og fordel lagen mellem de to skåle."
    },
    {
      "section": "Syltet rabarber",
      "text": "Dæk skålene til, og lad rabarberne syltes i køleskabet i mindst 2 timer – gerne natten over."
    },
    {
      "section": "MSG-chips",
      "text": "Varm olie op til 170 °C i en gryde."
    },
    {
      "section": "MSG-chips",
      "text": "Tør kartoffelskiverne godt med køkkenrulle, og steg dem i omgange, til de er gyldne og sprøde."
    },
    {
      "section": "MSG-chips",
      "text": "Lad chipsene dryppe af på køkkenrulle. Vend dem derefter i en skål med MSG og salt."
    },
    {
      "section": "Tatar",
      "text": "Læg oksemørbraden i fryseren i 20 minutter, så den stivner og bliver lettere at skære."
    },
    {
      "section": "Tatar",
      "text": "Skær kødet på tværs af fibrene i skiver på 0,5 cm, og skær skiverne i tern af samme størrelse."
    },
    {
      "section": "Tatar",
      "text": "Bland kødet med cornichoner, persille, kapers, skalotteløg, purløg og 1 spsk af de afdryppede rabarbertern."
    },
    {
      "section": "Tatar",
      "text": "Rør mayonnaise, sennep, hvidvinseddike, worcestershiresauce og 2 af æggeblommerne i. Smag til med salt og peber."
    },
    {
      "section": "Tatar",
      "text": "Sæt en bagering på hver tallerken, og fyld halvdelen af tataren i hver. Fjern ringen."
    },
    {
      "section": "Tatar",
      "text": "Pynt med syltede rabarberbånd og purløg. Læg en æggeblomme øverst på hver tatar, og server chipsene ved siden af."
    }
  ],
  "changes": []
