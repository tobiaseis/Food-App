  "steps": [
    {
      "section": "Mørdej",
      "text": "Smuldr mel og smør sammen med fingerspidserne, til det ligner fine rasp. Rør flormelis og salt i."
    },
    {
      "section": "Mørdej",
      "text": "Tilsæt ægget, og saml dejen. Ælt så lidt som muligt, så dejen ikke bliver sej."
    },
    {
      "section": "Mørdej",
      "text": "Form dejen til en rund skive, pak den ind, og lad den hvile på køl i mindst 1 time."
    },
    {
      "section": "Rabarber",
      "text": "Varm ovnen op til 200 °C. Læg rabarberne i et ildfast fad eller en bradepande, og vend dem med sukker, appelsinjuice og vanilje."
    },
    {
      "section": "Rabarber",
      "text": "Bag dem i 10-12 minutter, til de lige er møre, men stadig holder formen. De trækker videre af eftervarmen."
    },
    {
      "section": "Rabarber",
      "text": "Tag fadet ud, og lad rabarberne køle af i deres egen saft."
    },
    {
      "section": "Tærtebund",
      "text": "Rul den kolde dej ud til en tykkelse på ca. 3 mm. Læg den i tærteformen, tryk den godt ned i kanterne, og skær overskydende dej af."
    },
    {
      "section": "Tærtebund",
      "text": "Stil formen på køl i 30 minutter, så bunden krymper mindre i ovnen."
    },
    {
      "section": "Tærtebund",
      "text": "Beklæd dejen med bagepapir, og fyld op med bagekugler eller tørrede bønner. Forbag bunden i 15 minutter."
    },
    {
      "section": "Tærtebund",
      "text": "Løft papir og kugler af, og sæt bunden tilbage i ovnen i 5-7 minutter, til den er tør og let gylden. Stil den til side, og skru ovnen ned på 190 °C."
    },
    {
      "section": "Frangipane",
      "text": "Pisk smør og sukker luftigt i en røremaskine med fladpisker."
    },
    {
      "section": "Frangipane",
      "text": "Tilsæt æggene i tre omgange, og pisk hver gang godt sammen. Skrab ned fra skålens sider undervejs."
    },
    {
      "section": "Frangipane",
      "text": "Vend mandelmel, mel, citronskal, vanilje og salt i på lav hastighed, til massen er jævn. Skrab ned efter behov."
    },
    {
      "section": "Samling og bagning",
      "text": "Fordel frangipanen jævnt i tærtebunden, og læg rabarberne pænt ovenpå."
    },
    {
      "section": "Samling og bagning",
      "text": "Bag tærten i 35-40 minutter, til frangipanen er stivnet og let gylden."
    },
    {
      "section": "Samling og bagning",
      "text": "Lad tærten køle lidt, og løsn den fra formen, mens den stadig er lun, så dejen ikke sætter sig fast. Lad den derefter køle helt af."
    },
    {
      "section": "Glasur",
      "text": "Varm marmelade og vand i en lille kasserolle. Pensl glasuren over rabarberne, mens tærten er lun, og lad den køle helt af."
    }
  ],
