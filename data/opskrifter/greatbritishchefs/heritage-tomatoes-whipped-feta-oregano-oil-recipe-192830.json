  "steps": [
    {
      "section": "Oreganoolie",
      "text": "Kog en lille gryde vand op. Dyk oreganoblade i det kogende vand i 10 sekunder, og læg dem straks i isvand. Pres dem helt tørre."
    },
    {
      "section": "Oreganoolie",
      "text": "Blend bladene med olivenolie og salt, til olien er helt glat og skinnende grøn. Si den gennem en fin si eller et klæde, og pres forsigtigt, så olien forbliver klar. Stil den på køl."
    },
    {
      "section": "Tomatdressing",
      "text": "Blend tomater, skalotteløg, eddike og honning glat. Lad olien løbe i en tynd stråle under blendingen, så dressingen bliver cremet."
    },
    {
      "section": "Tomatdressing",
      "text": "Smag til med salt og peber, og si dressingen fint, så den bliver silkeblød. Stil den på køl."
    },
    {
      "section": "Fetacreme",
      "text": "Kør feta, yoghurt, hvidløg, citronskal, citronsaft og peber glat i en blender eller foodprocessor. Hæld olien i en tynd stråle under kørslen, så massen bliver let og luftig."
    },
    {
      "section": "Fetacreme",
      "text": "Smag til – der skal næppe meget salt i, da fetaen er salt. Kom cremen i en skål, dæk til, og stil den på køl i 20 minutter, så den sætter sig lidt."
    },
    {
      "section": "Tomater",
      "text": "Skær tomaterne i både, skiver og halve efter størrelse. Variationen gør anretningen mere spændende."
    },
    {
      "section": "Tomater",
      "text": "Vend tomaterne forsigtigt i en stor skål med flagesalt, sukker, eddike og olivenolie. Lad dem trække i 15 minutter."
    },
    {
      "section": "Servering",
      "text": "Tag oreganoolie, tomatdressing og fetacreme ud af køleskabet en stund før servering, så de bliver lidt lunkne."
    },
    {
      "section": "Servering",
      "text": "Smør fetacremen ud på et stort fad, og læg de marinerede tomater generøst ovenpå. Fordel tomatdressingen over."
    },
    {
      "section": "Servering",
      "text": "Top med oregano, basilikum og pinjekerner. Dryp med oreganoolie, og drys med sorte sesamfrø og peber."
    }
  ],
