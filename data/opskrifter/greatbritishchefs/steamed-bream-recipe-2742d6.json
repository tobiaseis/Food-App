  "steps": [
    {
      "section": "Til fisken",
      "text": "Skær tre skrå snit i hver side af fisken med en skarp kniv. Drys med salt udvendigt og i bugen."
    },
    {
      "section": "Til fisken",
      "text": "Fyld bugen med de groftskårne forårsløg og korianderblade. Gem lidt koriander til pynt."
    },
    {
      "section": "Til fisken",
      "text": "Læg fisken på et ildfast fad eller en bakke med kant, som kan være i wokken. Sæt en rist eller et andet understel i bunden af wokken, og stil fadet oven på."
    },
    {
      "section": "Til fisken",
      "text": "Hæld fiskefonden i wokken, så fisken står tørt over væsken."
    },
    {
      "section": "Til fisken",
      "text": "Pisk sojasauce, sherry, fiskesauce, ingefær-hvidløgspasta og sesamolie sammen."
    },
    {
      "section": "Til fisken",
      "text": "Sæt wokken over lav til middel varme. Hæld sojablandingen over fisken, læg låg eller folie over, og damp i 8-10 minutter."
    },
    {
      "section": "Til forårsløgsolien",
      "text": "Varm rapsolien op i en kasserolle til ca. 170 °C, mens fisken damper."
    },
    {
      "section": "Til forårsløgsolien",
      "text": "Kom skalotteløg, chiliflager, hvidløg, ingefær og forårsløg forsigtigt i olien. Tag straks kasserollen af varmen."
    },
    {
      "section": "Til forårsløgsolien",
      "text": "Lad olien trække og rør jævnligt i den, til fisken er færdigdampet."
    },
    {
      "section": "Til servering",
      "text": "Løft fadet forsigtigt op af wokken. Hæld den varme olie over fisken."
    },
    {
      "section": "Til servering",
      "text": "Pynt med de sprøde forårsløgsstrimler fra isvandet og resten af korianderen, og server."
    }
  ],
  "changes": [
    "Shaoxing-vin er erstattet af tør sherry."
