  "steps": [
    {
      "section": "Kartoffelmos",
      "text": "Kog kartoflerne i rigeligt letsaltet vand i ca. 15 minutter, til en gaffel nemt glider ind. Tiden afhænger af størrelsen."
    },
    {
      "section": "Kartoffelmos",
      "text": "Hæld vandet fra, put kartoflerne tilbage i gryden, og lad dem dampe af et par minutter."
    },
    {
      "section": "Kartoffelmos",
      "text": "Mos kartoflerne fint, f.eks. i en kartoffelpresser. Rør kærnemælk, creme fraiche, purløg og persille i, og smag til med salt og peber."
    },
    {
      "section": "Purløgsolie",
      "text": "Blancher purløgene i saltet kogende vand i 1 minut, og køl dem straks ned i isvand."
    },
    {
      "section": "Purløgsolie",
      "text": "Dup purløgene tørre i et rent viskestykke."
    },
    {
      "section": "Purløgsolie",
      "text": "Blend purløg og olivenolie helt glat. Lad blandingen trække i ca. 30 minutter, og sigt den derefter gennem en fin sigte."
    },
    {
      "section": "Brunet smørrasp",
      "text": "Brun smørret i en gryde ved middelvarme, til det er gyldent og dufter nøddeagtigt. Tilsæt pankoraspen."
    },
    {
      "section": "Brunet smørrasp",
      "text": "Rør raspen godt rundt i smørret, og rist den, til den er sprød. Smag til med salt og peber."
    },
    {
      "section": "Pølser og løgsovs",
      "text": "Steg pølserne i rapsolie på en stor pande, til de er gennemstegte. Tag dem af panden og stil dem til side."
    },
    {
      "section": "Pølser og løgsovs",
      "text": "Hæld overskydende fedt fra panden, hvis der er meget. Svits rødløgene i ca. 10 minutter, til de er begyndt at blive bløde, og rør derefter farin i."
    },
    {
      "section": "Pølser og løgsovs",
      "text": "Lad løgene stege videre ved lav varme i ca. 15 minutter, til de er flot karamelliserede."
    },
    {
      "section": "Pølser og løgsovs",
      "text": "Rør melet i løgene, hæld rødvinen i, og lad det koge ind til det halve."
    },
    {
      "section": "Pølser og løgsovs",
      "text": "Tilsæt fonden lidt ad gangen, og rør godt mellem hver gang. Kom rosmarin i, og smag til med salt og peber."
    },
    {
      "section": "Pølser og løgsovs",
      "text": "Lad sovsen simre, til den er tyknet og reduceret med ca. en fjerdedel. Tag den af varmen."
    },
    {
      "section": "Pølser og løgsovs",
      "text": "Pisk det kolde smør i tern ind i sovsen. Det gør den tykkere og giver den en blank overflade."
    },
    {
      "section": "Til servering",
      "text": "Anret mos og tre pølser på hver tallerken. Top med løgsovs, brunet smørrasp og dryp med purløgsolie. Server med persille og friskkværnet peber."
    }
  ],
