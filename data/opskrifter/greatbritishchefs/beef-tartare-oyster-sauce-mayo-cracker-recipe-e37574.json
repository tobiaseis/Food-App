  "steps": [
    {
      "section": "Til mayoen",
      "text": "Pisk æggeblommer, eddike og sennep sammen i en skål til en tyk masse."
    },
    {
      "section": "Til mayoen",
      "text": "Pisk kontinuerligt, mens begge slags olie drypper i en tynd stråle, indtil mayoen er jævn og tyk. Det kan også gøres i en foodprocessor."
    },
    {
      "section": "Til mayoen",
      "text": "Rør østerssaucen i, og smag til med salt og peber."
    },
    {
      "section": "Til knækbrødet",
      "text": "Tænd ovnen på 180 °C."
    },
    {
      "section": "Til knækbrødet",
      "text": "Bland mel, fennikelfrø og kommenfrø i en skål. Tilsæt vand, østerssauce og olivenolie, og ælt det grundigt sammen til en dej."
    },
    {
      "section": "Til knækbrødet",
      "text": "Læg dejen mellem to stykker bagepapir, og rul den ud til cirka 3 mm tykkelse. Løft den over på en bageplade, og tag det øverste papir af."
    },
    {
      "section": "Til knækbrødet",
      "text": "Bag i 20 minutter, og lad det køle af."
    },
    {
      "section": "Til tatar",
      "text": "Vend oksekød, skalotteløg, cornichoner, kapers og persille sammen med 4 spsk af mayoen. Smag til med salt og peber."
    },
    {
      "section": "Til tatar",
      "text": "Anret tatar på fire tallerkener. Brud knækbrødet i fire stykker, og læg et ved siden af hver portion."
    },
    {
      "section": "Til tatar",
      "text": "Sæt flere klatter mayo ovenpå, og drys med chiliflager."
    }
  ],
  "changes": [
    "Rapsolie i stedet for vegetabilsk olie.",
