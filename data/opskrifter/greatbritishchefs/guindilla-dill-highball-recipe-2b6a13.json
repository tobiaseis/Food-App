  "steps": [
    {
      "section": "Til dildolien",
      "text": "Kog vand op, og kog dilden i det i 10 sekunder. Læg den straks i iskoldt vand."
    },
    {
      "section": "Til dildolien",
      "text": "Pres dilden så tør som muligt, og kom den i en blender sammen med olie og salt."
    },
    {
      "section": "Til dildolien",
      "text": "Blend i nogle minutter, til olien er skarpt grøn. Si den gennem en fin sigte, og stil den til side."
    },
    {
      "section": "Til drinken",
      "text": "Fyld to highballglas med is. Hæld whisky, lage og citronsaft i, og rør forsigtigt, så drinken bliver kold."
    },
    {
      "section": "Til drinken",
      "text": "Fyld op med tonic, men lad der være lidt plads øverst. Dryp en teskefuld dildolie over hvert glas, og pas på ikke at røre op i bundfaldet."
    },
    {
      "section": "Til drinken",
      "text": "Pynt hvert glas med en pepperoncini, en citronbåd og en stilk mynte."
    }
  ],
  "changes": [
    "Guindilla-chili er skiftet til pepperoncini, og lagen er fra dem."
