  "steps": [
    {
      "section": "Laks en croûte",
      "text": "Smelt smørret ved svag varme på en pande, og svits skalotteløg og hvidløg, til de er bløde."
    },
    {
      "section": "Laks en croûte",
      "text": "Kom spinaten på panden, og lad den falde sammen på 1–2 minutter."
    },
    {
      "section": "Laks en croûte",
      "text": "Pres væsken fra spinaten, hak den groft, smag til med salt og peber, og lad den køle helt af."
    },
    {
      "section": "Laks en croûte",
      "text": "Rul butterdejen ud på en let meldrysset bordplade til ca. 3–4 mm tykkelse. Del den i 4 lige store rektangler, så hvert stykke kan pakkes helt om en laksefilet med en kant på 2–3 cm."
    },
    {
      "section": "Laks en croûte",
      "text": "Læg et dejstykke foran dig, og smør lidt sennep på midten med en bred kant hele vejen rundt. Fordel noget af spinaten som et pænt rektangel, der er lidt mindre end laksefileten."
    },
    {
      "section": "Laks en croûte",
      "text": "Læg laksen oven på spinaten, og krydr let med salt og peber."
    },
    {
      "section": "Laks en croûte",
      "text": "Pensl dejkanterne med lidt af æggemassen. Slå den ene lange side ind over laksen og den anden ovenpå, så de overlapper lidt. Tryk til, så pakken lukker."
    },
    {
      "section": "Laks en croûte",
      "text": "Pres kanterne let ned med bagsiden af en kniv, så de får et bølgemønster, og rids dejen på toppen uden at skære igennem. Gør det samme med de øvrige filetter."
    },
    {
      "section": "Laks en croûte",
      "text": "Pensl toppen med æggemassen, og sæt pakkerne på køl i 20 minutter."
    },
    {
      "section": "Laks en croûte",
      "text": "Varm ovnen op til 200 °C varmluft."
    },
    {
      "section": "Laks en croûte",
      "text": "Bag pakkerne i 20–25 minutter, til dejen er dyb gylden og sprød."
    },
    {
      "section": "Til servering",
      "text": "Sæt ovnkartoflerne i ovnen, mens du laver hollandaisen."
    },
    {
      "section": "Dildhollandaise",
      "text": "Pisk æggeblommer og eddike i en varmefast skål over en gryde med vand, der næsten ikke simrer. Pisk, til massen er tyk og lys."
    },
    {
      "section": "Dildhollandaise",
      "text": "Pisk det smeltede smør i, mens du fortsætter med at piske. Begynd med dråber, og øg til en jævn stråle, indtil alt smørret er pisket ind."
    },
    {
      "section": "Dildhollandaise",
      "text": "Rør citronsaft og cayennepeber i, smag til med salt, og vend den hakkede dild i. Hold saucen lun til servering."
    },
    {
      "section": "Hvidløgsspinat",
      "text": "Steg hvidløgsskiverne i olivenolie, til de lige er gyldne. Tilsæt spinaten, og rør, til den falder sammen."
    },
    {
      "section": "Hvidløgsspinat",
      "text": "Smag til med salt, peber og muskatnød, og hæld overskydende væske fra."
    },
    {
      "section": "Til servering",
      "text": "Anret spinat på hver tallerken, og læg en laksepakke ovenpå – gerne skåret over. Server med ovnkartoflerne ved siden af, hæld hollandaise over, og pynt med citronskal og dildkviste."
    }
  ],
