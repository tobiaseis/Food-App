  "steps": [
    {
      "section": "Kylling",
      "text": "Kom kyllingestrimlerne i en skål, og drys dem let med salt. Vend dem med kærnemælk, røget paprika, Cajun-krydderi, citronsaft og peber."
    },
    {
      "section": "Kylling",
      "text": "Dæk skålen til, og lad kyllingen trække i mindst 20 minutter. Den kan også stå op til 24 timer i køleskabet."
    },
    {
      "section": "Cajunremoulade",
      "text": "Pisk æggeblomme, begge slags sennep, hvidløg, Cajun-krydderi, røget paprika, tabasco og citronsaft sammen i en skål."
    },
    {
      "section": "Cajunremoulade",
      "text": "Hæld olien i en tynd stråle, mens du pisker konstant, til saucen bliver tyk og blank."
    },
    {
      "section": "Cajunremoulade",
      "text": "Smag til med salt og peber, og tilsæt mere tabasco eller citron, hvis den skal være skarpere eller sprødere i smagen. Sæt remouladen tildækket i køleskabet til servering."
    },
    {
      "section": "Panering",
      "text": "Bland hvedemel, majsstivelse, peber, røget paprika og Cajun-krydderi i en skål. Pisk æg og mælk sammen i en anden."
    },
    {
      "section": "Panering",
      "text": "Tag kyllingestykkerne op af kærnemælken, og lad overskuddet dryppe af. Vend dem i melblandingen, og tryk, så den sidder fast hele vejen rundt."
    },
    {
      "section": "Panering",
      "text": "Træk stykkerne gennem æggeblandingen, og vend dem derefter i melblandingen igen, så panéringen bliver tyk og ujævn."
    },
    {
      "section": "Panering",
      "text": "Læg de panerede strimler på en bakke, og lad dem hvile i 10 minutter. Varm imens olie op til 170 °C i en dyb gryde, der er fyldt til to tredjedele."
    },
    {
      "section": "Stegning og servering",
      "text": "Steg strimlerne portionsvis i 3-4 minutter, og vend dem undervejs, til de er dybt gyldne og sprøde hele vejen rundt."
    },
    {
      "section": "Stegning og servering",
      "text": "Løft dem op med hulske, lad dem dryppe af på køkkenrulle, og drys let med salt."
    },
    {
      "section": "Stegning og servering",
      "text": "Anret strimlerne med en skål remoulade. Pynt remouladen med persille, og strø cornichoner og purløg over kyllingen. Server med svitset citron til at presse over."
    }
  ],
