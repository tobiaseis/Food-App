  "steps": [
    {
      "section": "Forberedelse",
      "text": "Tænd ovnen på 200°C (180°C varmluft)."
    },
    {
      "section": "Forberedelse",
      "text": "Vend tomatskiverne i olivenolie og krydr dem godt. Læg dem i ét lag på en bageplade og rist dem i 20 minutter. Lad dem køle af."
    },
    {
      "section": "Forberedelse",
      "text": "Svits rødløget i lidt olie ved svag varme i 10-15 minutter, til det er blødt og gyldent."
    },
    {
      "section": "Forberedelse",
      "text": "Kog kartoffelskiverne i 8 minutter, til de næsten er møre. Hæld vandet fra, og lad dem køle af."
    },
    {
      "section": "Pesto",
      "text": "Kør alle pestoens ingredienser i en foodprocessor til en løs pesto, der kan øses. Stil den til side."
    },
    {
      "section": "Samling",
      "text": "Sænk ovnen til 180°C (160°C varmluft)."
    },
    {
      "section": "Samling",
      "text": "Beklæd en form på 20 × 30 cm med bagepapir, så papiret stikker op over kanten og kan bruges som håndtag til at løfte tærten ud."
    },
    {
      "section": "Samling",
      "text": "Læg to dejplader et par centimeter over hinanden, og rul dem sammen til én plade. Brug lidt vand som lim, hvis det er nødvendigt. Rul pladen ud til cirka 3 mm tykkelse, så den dækker både bund og sider af formen. Tryk den ned i formen."
    },
    {
      "section": "Samling",
      "text": "Drys raspen over dejbunden. Læg grøntsagerne i lag i denne rækkefølge: squash, peberfrugt, ristede tomater, løg, feta, kartofler og ærter. Dryp pesto over og krydr mellem hvert lag."
    },
    {
      "section": "Samling",
      "text": "Tag 2-3 spiseskefulde af de piskede æg fra til pensling. Hæld resten forsigtigt over fyldet."
    },
    {
      "section": "Samling",
      "text": "Læg den sidste dejplade som låg over tærten. Beskær kanten, og luk den godt. Pensl låget med det tilbageholdte æg, drys med sesamfrø, og skær let 12 felter i overfladen."
    },
    {
      "section": "Bagning",
      "text": "Bag tærten i 1 time og 20 minutter, til den er dyb gyldenbrun og sprød. Lad den køle helt af, før du skærer i den."
    },
    {
      "section": "Dip og salat",
      "text": "Rør dipens ingredienser sammen, og stil den på køl til servering."
    },
    {
      "section": "Dip og salat",
      "text": "Vend squashbåndene med citronskal og -saft, olie, honning, salt og basilikum. Stil salaten på køl, til den skal serveres."
    }
  ],
  "changes": [
    "Heritage-tomater er erstattet af almindelige tomater i blandede farver."
  ]
