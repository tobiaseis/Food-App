  "steps": [
    {
      "section": "Grøntsagerne",
      "text": "Tænd ovnen på 200 °C."
    },
    {
      "section": "Grøntsagerne",
      "text": "Bland fennikelfrø, korianderfrø, chiliflager og hvidløg i en stor skål sammen med en knivspids salt og peber. Vend olie, fennikelbåde og artiskokhjerter i krydderiblandingen."
    },
    {
      "section": "Grøntsagerne",
      "text": "Fordel det på en bageplade og læg smørklatter ovenpå. Bag i 30 minutter, og vend det undervejs. Fennikel skal være mør og karamelliseret med gyldne, lidt sprøde kanter."
    },
    {
      "section": "Rasp",
      "text": "Varm olien på en lille pande ved middel varme. Rist raspen i ca. 5 minutter under jævnlig omrøring, til den er gylden og sprød. Smag til med salt og stil den til side."
    },
    {
      "section": "Saucen",
      "text": "Start saucen, når grøntsagerne har været i ovnen i ca. 15 minutter. Varm olie og smør på en stor pande ved middel varme."
    },
    {
      "section": "Saucen",
      "text": "Svits skalotteløgene ved svag varme i 5 minutter, til de er bløde og klare. Tilsæt hvidløg og svits yderligere 1 minut."
    },
    {
      "section": "Saucen",
      "text": "Hæld hvidvinen på og lad den koge ind i 3 minutter. Tilsæt fonden og lad det småkoge i 5 minutter mere. Rør eddiken i."
    },
    {
      "section": "Pasta",
      "text": "Kog linguinen i rigeligt saltet vand efter anvisningen på pakken, mens saucen simrer."
    },
    {
      "section": "Pasta",
      "text": "Løft pastaen med en tang over i saucen og tilsæt et stænk pastavand. Kom de ovnbagte grøntsager med deres sky i, og vend det hele sammen. Fortynd med mere pastavand, hvis saucen er for tyk."
    },
    {
      "section": "Pasta",
      "text": "Tag panden af varmen. Vend parmesan, persille og størstedelen af citronskallen i."
    },
    {
      "section": "Pasta",
      "text": "Server straks med rasp, fennikelblade, chiliflager, resten af citronskallen og citronbåde."
    }
  ],
  "changes": [
