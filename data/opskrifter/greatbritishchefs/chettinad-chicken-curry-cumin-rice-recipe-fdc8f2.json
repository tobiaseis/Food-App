  "steps": [
    {
      "section": "Marinade",
      "text": "Bland alle ingredienserne til marinaden i en stor skål, og vend kyllingen godt rundt i den. Lad den marinere i cirka 1 time."
    },
    {
      "section": "Chettinad-masala",
      "text": "Varm en stor pande op ved lav til middel varme. Rist chili, korianderfrø, fennikelfrø, spidskommen, bukkehornsfrø, valmuefrø, peberkorn, kardemomme, kanel, nelliker og stjerneanis, til det dufter og har taget let farve. Lad krydderierne køle af på et fad."
    },
    {
      "section": "Chettinad-masala",
      "text": "Mal de afkølede krydderier til et fint pulver i en kryddermølle, og stil det til side."
    },
    {
      "section": "Chettinad-masala",
      "text": "Hæld olie, kokos og karryblade på den samme pande. Rist, til kokosen er lysegylden, og tag det af panden."
    },
    {
      "section": "Chettinad-masala",
      "text": "Kør kokosblandingen, cashewnødderne, krydderipulveret og en sjat koldt vand til en glat pasta i en lille blender. Stil pastaen til side."
    },
    {
      "section": "Karrybase",
      "text": "Varm ghee og laurbærblad op i en stor stegepande ved middel varme, til laurbærbladet dufter."
    },
    {
      "section": "Karrybase",
      "text": "Svits løgene i cirka 15 minutter, til de er bløde og let gyldne. Tag dem op af panden."
    },
    {
      "section": "Karrybase",
      "text": "Tilsæt en sjat olie, og skru op for varmen til det højeste. Brun kyllingelårene, til de er gyldne og har en flot stegeskorpe, og læg dem over på en tallerken."
    },
    {
      "section": "Karrybase",
      "text": "Kom løgene tilbage på panden, og rør de hakkede tomater i. Lad det simre i cirka 20 minutter, til olien skiller fra og danner pletter på overfladen."
    },
    {
      "section": "Karrybase",
      "text": "Rør karryblade, masalapastaen og det varme vand i, og læg kyllingen ned i saucen. Kyllingen skal næsten være dækket af saucen."
    },
    {
      "section": "Karrybase",
      "text": "Læg låg på, og lad retten simre svagt i cirka 20 minutter, til kyllingen er gennemstegt (74 °C, hvor kødet er tykkest). Smag til med salt."
    },
    {
      "section": "Syltede rødløg",
      "text": "Rør rødløgene sammen med sukker, eddike, vand og salt, til sukker og salt er opløst. Sæt dem i køleskabet i cirka 30 minutter, mens du laver risene."
    },
    {
      "section": "Ris med spidskommen",
      "text": "Varm ghee op i en gryde, og rist alle krydderierne i omkring et minut, til de dufter."
    },
    {
      "section": "Ris med spidskommen",
      "text": "Tilsæt chili og de afdryppede ris. Rist dem under omrøring i et par minutter."
    },
    {
      "section": "Ris med spidskommen",
      "text": "Hæld vand og salt i, og rør rundt. Dæk gryden med et viskestykke og låg, og bring det i kog."
    },
    {
      "section": "Ris med spidskommen",
      "text": "Skru ned, og lad risene simre i 15 minutter."
    },
    {
      "section": "Ris med spidskommen",
      "text": "Tag gryden af varmen, men lad låg og viskestykke sidde. Lad risene dampe i 10 minutter, og luk dem derefter op med en gaffel."
    },
    {
      "section": "Til servering",
      "text": "Anret risene i en skål ved siden af en solid portion karry. Server med syltede løg, koriander, agurk, fennikel og limebåde."
    }
  ],
  "changes": [
    "Frisk revet kokos er erstattet af kokosflager.",
    "Tørrede Kashmiri-chili er erstattet af almindelig tørret rød chili.",
    "Almindelig sukker erstatter caster sugar.",
    "Rapsolie erstatter vegetable oil."
  ]
}
