  "steps": [
    {
      "section": "Karrypulver",
      "text": "Rist alle krydderierne på en tør pande, til de dufter. Mal dem derefter til et fint pulver i en krydderikværn."
    },
    {
      "section": "Syltede radiser",
      "text": "Vend radiskeskiverne med eddike, sukker og salt. Lad dem stå, mens resten laves."
    },
    {
      "section": "Karrysauce",
      "text": "Varm olien i en gryde, og sæt løg, hvidløg og ingefær over middel-lav varme. Lad dem blive bløde i cirka 15 minutter."
    },
    {
      "section": "Karrysauce",
      "text": "Rør gulerødder, mel og tomatpuré i, og lad det stege med i 2 minutter."
    },
    {
      "section": "Karrysauce",
      "text": "Tilsæt karrypulveret, fonden, sojasaucen, mirinen og honningen. Lad saucen simre i 20 minutter, og blend den så til den er glat og blank."
    },
    {
      "section": "Katsu",
      "text": "Vend squashskiverne først i mel, derefter i æg og til sidst i panko. Steg dem i olie på en pande, til de er gyldne på begge sider og møre hele vejen igennem."
    },
    {
      "section": "Katsu",
      "text": "Læg skiverne på køkkenrulle, så overskydende fedt trækker af, og drys dem med flagesalt."
    },
    {
      "section": "Ris",
      "text": "Si risene godt fra. Kom dem i en gryde med vandet, og bring det i kog."
    },
    {
      "section": "Ris",
      "text": "Skru ned til middel-lav varme, læg et viskestykke og et låg over, og lad risene koge i cirka 13 minutter."
    },
    {
      "section": "Ris",
      "text": "Tag gryden af varmen, og lad risene dampe med låg i 10 minutter. Luft dem op med en gaffel."
    },
    {
      "section": "Til servering",
      "text": "Fordel risene i skåle, og læg katsu-skiverne ovenpå. Hæld karrysauce over, og top med syltede radiser, forårsløg og koriander."
    }
  ],
  "changes": [
    "Flagesalt er skiftet til almindeligt salt."
  ]
}
