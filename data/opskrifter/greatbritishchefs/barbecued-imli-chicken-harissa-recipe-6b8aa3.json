  "steps": [
    {
      "section": "Kyllingen",
      "text": "Vend kyllingen med ingefær- og hvidløgspasta, garam masala, chilipulver, citronsaft og en knivspids salt i en stor skål, så alt er dækket."
    },
    {
      "section": "Kyllingen",
      "text": "Sæt skålen tildækket i køleskabet i 4 timer."
    },
    {
      "section": "Harissa",
      "text": "Si vandet fra chilierne. Kør dem i en blender med hvidløg, eddike, nelliker, spidskommen og koriander til en glat pasta. Smag til med salt."
    },
    {
      "section": "Harissa",
      "text": "Kom massen i en lille gryde og lad den simre ved lav varme i 15-20 minutter. Rør ofte."
    },
    {
      "section": "Harissa",
      "text": "Lad harissaen køle af, og rør derefter sojayoghurten i. Fyld den i en sprayflaske eller sprøjteflaske."
    },
    {
      "section": "Glasur",
      "text": "Bland alle glasurens ingredienser i en skål med en knivspids salt. Stil den til side."
    },
    {
      "section": "Gulerodssalat",
      "text": "Varm lidt olie i en lille gryde og steg hvidløget i 1 minut. Rør gurkemeje i og steg 1 minut mere."
    },
    {
      "section": "Gulerodssalat",
      "text": "Tilsæt gulerødder, eddike, sukker og en knivspids salt. Lad det simre cirka 5 minutter, til gulerødderne er møre, men stadig har bid."
    },
    {
      "section": "Gulerodssalat",
      "text": "Smag til med peber og lad salaten køle af."
    },
    {
      "section": "Jordnødde-thecha",
      "text": "Varm lidt olie i en gryde ved middel varme. Brun de hele chilier og de pillede fed i 3-4 minutter, til chilierne har fået blærer, og hvidløget er lidt blødt."
    },
    {
      "section": "Jordnødde-thecha",
      "text": "Rør spidskommen i og steg i 30 sekunder. Lad blandingen køle af."
    },
    {
      "section": "Jordnødde-thecha",
      "text": "Kør den afkølede blanding med jordnødder, chilipulver og en knivspids salt i en kværn eller foodprocessor, til den er halvgrov."
    },
    {
      "section": "Jordnødde-thecha",
      "text": "Varm den let på en tør pande, så den tørrer lidt. Stil til side."
    },
    {
      "section": "Grillning",
      "text": "Gør grillen klar til direkte varme, og vent til kullene er dækket af hvid aske."
    },
    {
      "section": "Grillning",
      "text": "Grill kyllingen 1 minut på hver side. Pensl derefter rigeligt med glasur og grill 2-3 minutter mere. Tiden kan variere med større stykker kylling."
    },
    {
      "section": "Servering",
      "text": "Anret kyllingen med prikker af harissa og gulerodssalat ved siden af. Drys med jordnødde-thecha og pynt evt. med karse, syltede chilier og spiselige blomster."
    }
  ],
