  "steps": [
    {
      "section": "Persilleolien",
      "text": "Bring en lille gryde vand i kog. Kog persillen i 10 sekunder, og læg den straks i iskoldt vand. Pres så meget vand ud af den som muligt."
    },
    {
      "section": "Persilleolien",
      "text": "Blend persillen med olien og saltet i nogle minutter, til olien er helt glat og skarpt grøn."
    },
    {
      "section": "Persilleolien",
      "text": "Si olien gennem en fin si foret med musselinklæde eller køkkenrulle. Det tager tid. Olien holder sig nogle dage i køleskabet, men mister så smag og farve."
    },
    {
      "section": "Muslingerne",
      "text": "Varm en stor gryde op på middel. Svits smør og hvidløg i nogle minutter, til det dufter."
    },
    {
      "section": "Muslingerne",
      "text": "Hæld vin, fond, timian og citronsaft i gryden, og lad det småkoge."
    },
    {
      "section": "Muslingerne",
      "text": "Kom muslingerne i, læg låg på, og lad dem koge i 4 minutter. Ryst gryden jævnligt. Kassér muslinger, der ikke har åbnet sig."
    },
    {
      "section": "Servering",
      "text": "Anret muslinger og bouillon i dybe tallerkener. Dryp persilleolie over, og drys med purløg og citronskal. Server med den ristede flute."
    }
  ],
