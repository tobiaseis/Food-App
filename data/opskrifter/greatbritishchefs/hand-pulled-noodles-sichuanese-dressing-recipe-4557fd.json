  "steps": [
    {
      "section": "Dressing",
      "text": "Kom hvidløg, forårsløg, rød chili og chiliflager i en varmefast skål."
    },
    {
      "section": "Dressing",
      "text": "Varm olien op i en gryde, til den ryger."
    },
    {
      "section": "Dressing",
      "text": "Hæld den rygende olie over blandingen i skålen. Det skal syde kraftigt."
    },
    {
      "section": "Dressing",
      "text": "Rør resten af dressingens ingredienser i, smag til og lad dressingen stå, til nudlerne er klar."
    },
    {
      "section": "Nudler",
      "text": "Bring en stor gryde letsaltet vand i kog."
    },
    {
      "section": "Nudler",
      "text": "Kog nudlerne, til de flyder op til overfladen, cirka 90 sekunder. Løft dem op og afkøl dem straks i koldt vand."
    },
    {
      "section": "Nudler",
      "text": "Få vandet i kog igen. Kog nudlerne i 20 sekunder mere, og lad dem dryppe af."
    },
    {
      "section": "Nudler",
      "text": "Vend de varme nudler i en skål med dressingen, koriander, det finthakkede forårsløg og sesamfrø. Server med det samme."
    }
  ],
