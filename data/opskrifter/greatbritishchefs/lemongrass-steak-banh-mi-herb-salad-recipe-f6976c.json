  "steps": [
    {
      "section": "Bøf og marinade",
      "text": "Rør citrongræs, hvidløg, fiskesauce, sojasauce, brun farin og olie sammen. Gnid marinaden ind i bøfferne, og lad dem stå i 1 time."
    },
    {
      "section": "Syltede grøntsager",
      "text": "Vend gulerod og radise med eddike, sukker og salt. Lad det trække i 20 minutter."
    },
    {
      "section": "Sriracha-mayo",
      "text": "Rør mayonnaise og sriracha sammen i en skål."
    },
    {
      "section": "Nuoc cham",
      "text": "Rør alle ingredienserne til nuoc cham sammen i en anden skål."
    },
    {
      "section": "Urter og servering",
      "text": "Bland basilikum, koriander og mynte i en skål, og sæt persillen til side til servering."
    },
    {
      "section": "Bøf og marinade",
      "text": "Smelt en rigelig klat smør på en pande. Steg bøfferne 2 minutter på hver side, til de er medium-rare (55 °C), og øs løbende det smeltede smør over dem. Lad kødet hvile i 5 minutter, og skær det derefter i tynde skiver."
    },
    {
      "section": "Urter og servering",
      "text": "Rist flutten let, og smør den med sriracha-mayo. Fyld den med de syltede grøntsager, bøfskiverne og lidt af urteblandingen."
    },
    {
      "section": "Urter og servering",
      "text": "Server med agurk og limebåde. Anret resten af urterne ved siden af, og sæt nuoc cham frem som dip."
    }
  ],
  "changes": [
