  "steps": [
    {
      "section": "Glaskanten",
      "text": "Bland chili og salt på en lille tallerken."
    },
    {
      "section": "Glaskanten",
      "text": "Fugt kanten på begge glas med limebåden, og tryk kanten ned i chilisaltet, så den er dækket hele vejen rundt."
    },
    {
      "section": "Glaskanten",
      "text": "Læg isterninger i glassene, til de er fyldt."
    },
    {
      "section": "Cocktailen",
      "text": "Fyld en shaker med is. Hæld tequila, grapefrugtjuice, jalapeñolage og agavesirup i."
    },
    {
      "section": "Cocktailen",
      "text": "Ryst kraftigt i cirka 15 sekunder, så drinken bliver kold og blandet godt. Si den over i de to glas."
    },
    {
      "section": "Cocktailen",
      "text": "Fyld op med tonic, og sæt en skive lime på kanten af hvert glas."
    }
  ],
