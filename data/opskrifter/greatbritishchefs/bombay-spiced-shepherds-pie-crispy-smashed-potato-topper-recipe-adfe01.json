  "steps": [
    {
      "section": "Lammeragout",
      "text": "Tænd ovnen på 150 °C varmluft."
    },
    {
      "section": "Lammeragout",
      "text": "Vend lammekødet med olie og en knivspids salt. Brun det i en stor gryde, til alle stykkerne har fået farve hele vejen rundt. Tag kødet op og stil det til side."
    },
    {
      "section": "Lammeragout",
      "text": "Svits løg, gulerod og selleri i samme gryde ved middel varme. Kom hvidløg, ingefær og chili i efter et par minutter, og lad grøntsagerne simre ca. 15 minutter, til de er bløde."
    },
    {
      "section": "Lammeragout",
      "text": "Rør garam masala og hvedemel i, og lad det stege ved lav varme i cirka et minut. Rør derefter tomatpuréen i."
    },
    {
      "section": "Lammeragout",
      "text": "Tilsæt spidskommen, gurkemeje, koriander og hakkede tomater. Hæld fonden i lidt ad gangen, og pisk efter hver gang i starten, så melet ikke klumper."
    },
    {
      "section": "Lammeragout",
      "text": "Kom lammet tilbage i gryden sammen med rosmarin, laurbærblad og timian. Smag til med salt og peber, alt efter hvor salt fonden er."
    },
    {
      "section": "Lammeragout",
      "text": "Læg låg på og sæt gryden i ovnen i 5–6 timer, til lammet er mørt og falder fra hinanden. Hæld mere fond i, hvis saucen er ved at koge ind."
    },
    {
      "section": "Syltede løg",
      "text": "Rør eddike, vand, sukker, salt og peberkorn sammen, til sukkeret er opløst. Læg løgskiverne i lagen og lad dem trække i køleskabet, mens lammet står i ovnen."
    },
    {
      "section": "Smadrede kartofler",
      "text": "Kog kartoflerne i letsaltet vand i ca. 15 minutter, til de er møre. Hæld vandet fra og lad dem dampe tørre i gryden."
    },
    {
      "section": "Smadrede kartofler",
      "text": "Smelt imens smørret med spidskommen, hvidløg og nigellafrø. Bruns det let, og hæld det i en ovnfast skål."
    },
    {
      "section": "Smadrede kartofler",
      "text": "Skru ovnen op på 180 °C varmluft. Læg kartoflerne på en bageplade med bagepapir og tryk dem flade med en kartoffelmoser, så de holder sammen. Lad dem hvile et par minutter, og dryp med noget af det brunede smør."
    },
    {
      "section": "Smadrede kartofler",
      "text": "Krydr med salt og peber og bag dem i 15 minutter. Det er første bagning, inden de kommer oven på lammet."
    },
    {
      "section": "Samling",
      "text": "Tag gryden ud af ovnen, når lammet er mørt, og fisk urterne op. Smag til med salt og peber."
    },
    {
      "section": "Samling",
      "text": "Hæld lammeragouten i et dybt ovnfast fad. Læg de forbagte kartofler ovenpå og dryp med mere brunet smør."
    },
    {
      "section": "Samling",
      "text": "Bag i ca. 25 minutter, til kartoflerne er sprøde og gennemstegte."
    },
    {
      "section": "Koriandergurt og pynt",
      "text": "Rør koriander og yoghurt sammen og smag til med salt og peber."
    },
    {
      "section": "Koriandergurt og pynt",
      "text": "Anret en rigelig portion shepherd's pie i dybe tallerkener. Top med en klat koriandergurt, de syltede løg og hakket purløg."
    }
  ],
