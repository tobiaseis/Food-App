  "steps": [
    {
      "section": "Fennikel- og abrikosmarmelade",
      "text": "Kom alle ingredienserne til marmeladen i en stor gryde, og bring dem i let kog."
    },
    {
      "section": "Fennikel- og abrikosmarmelade",
      "text": "Skru ned på lav varme, og lad det simre i 30–40 minutter, til fennikel og abrikoser er helt bløde og er kogt ud."
    },
    {
      "section": "Syltet kålrabi",
      "text": "Rør alle ingredienserne til syltningen sammen i en skål, til sukkeret er opløst. Stil skålen tildækket i køleskabet, mens du laver svinekødet."
    },
    {
      "section": "Svinekød",
      "text": "Vend nakkekoteletterne i en stor skål med brun farin, østerssauce og fiskesauce. Krydr med salt og peber og lidt olie, og lad dem stå i 15 minutter."
    },
    {
      "section": "Svinekød",
      "text": "Varm en pande op ved middelhøj varme, og tænd ovnen på 180 °C varmluft."
    },
    {
      "section": "Svinekød",
      "text": "Brun koteletterne gyldne på begge sider i lidt olie. Tilsæt smørret, sænk varmen lidt, og øs smørret over kødet nogle gange."
    },
    {
      "section": "Svinekød",
      "text": "Læg koteletterne på en bageplade, og steg dem i ovnen, til kernetemperaturen er 74 °C. Lad kødet hvile i 10 minutter."
    },
    {
      "section": "Til servering",
      "text": "Skær kødet i skiver, og anret det med rucolaen. Top med den syltede kålrabi, fennikelgrønt og knust rosépeber. Server marmeladen ved siden af."
    }
  ],
