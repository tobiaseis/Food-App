  "steps": [
    {
      "section": "Tamarind- og jordnøddedressing",
      "text": "Rør tamarind og varmt vand sammen. Mos tamarinden med fingrene eller en ske, og si væsken gennem en fin si. Der skal bruges 90 ml tamarindvand."
    },
    {
      "section": "Tamarind- og jordnøddedressing",
      "text": "Tænd ovnens grill på høj varme. Smør rejepastaen tyndt ud på et stykke folie, og grill den, til den dufter og er let forkullet."
    },
    {
      "section": "Tamarind- og jordnøddedressing",
      "text": "Rist kokosen tør på en pande eller i en wok ved middelvarme, til den er gyldenbrun. Der skal bruges 24 g ristet kokos."
    },
    {
      "section": "Tamarind- og jordnøddedressing",
      "text": "Varm farin og vand i en lille gryde, til sukkeret er opløst. Tilsæt fiskesauce, tamarindvand og salt."
    },
    {
      "section": "Tamarind- og jordnøddedressing",
      "text": "Rør rejepulver, ingefær, chili, den grillede rejepasta, jordnødder og ristet kokos i. Lad saucen simre i 3-5 minutter, til den er tyknet og smagene har trukket."
    },
    {
      "section": "Tamarind- og jordnøddedressing",
      "text": "Lad saucen køle af, og hæld den på et sterilt glas. Den holder sig 1-2 uger i køleskab."
    },
    {
      "section": "Til servering",
      "text": "Blend æblejuice, wasabi og saften fra østersene, og smag til. Vej væsken, og tilsæt sojalecithin svarende til 1 % af vægten."
    },
    {
      "section": "Til servering",
      "text": "Blend lecithinen grundigt ind med en stavblender. Hæld blandingen i en skål, så der danner sig et let skum øverst."
    },
    {
      "section": "Til servering",
      "text": "Vend østersene med lidt af dressingen, og lad dem marinere i 2 minutter."
    },
    {
      "section": "Til servering",
      "text": "Pynt med et shisoblad og spiselige blomster, og top med wasabiskum."
    }
  ],
