  "steps": [
    {
      "section": "Pulled pork",
      "text": "Tænd ovnen på 150 °C varmluft."
    },
    {
      "section": "Pulled pork",
      "text": "Bland paprika, hvidløgspulver, løgpulver, brun farin, salt og peber til en krydderiblanding. Gnid den ind i kødet, så det er dækket hele vejen rundt."
    },
    {
      "section": "Pulled pork",
      "text": "Varm olivenolie op i et stort ovnfast fad eller en stegepande ved middel varme. Brun kødet på alle sider, og tag det op."
    },
    {
      "section": "Pulled pork",
      "text": "Hæld æblecidereddike og fond i fadet, og skrab alle stegeskorperne løs fra bunden."
    },
    {
      "section": "Pulled pork",
      "text": "Læg kødet tilbage i fadet, dæk tæt med alufolie, og steg i ovnen i 6 timer."
    },
    {
      "section": "Jordnøddesauce",
      "text": "Pisk alle ingredienserne til saucen sammen i en skål, til jordnøddesmørret er helt glat. Tilsæt lidt vand, til saucen er tyndere og lækker at røre i."
    },
    {
      "section": "Pak choi",
      "text": "Varm en pande op ved middelhøj varme med olien. Steg pak choi med snitfladen nedad, til den er gylden."
    },
    {
      "section": "Pak choi",
      "text": "Skru ned for varmen, og kom smør, sojasauce, fiskesauce og mirin på panden. Læg låg på, og lad kålen simre i ca. 5 minutter, til den er mør."
    },
    {
      "section": "Til servering",
      "text": "Kog sobanudlerne møre. Vend de varme nudler straks i jordnøddesaucen, så de er dækket af den."
    },
    {
      "section": "Til servering",
      "text": "Tag kødet ud af ovnen. Træk det i stykker med to gafler eller en tang, og vend det med barbecuesaucen. Smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Anret nudler og sauce i skåle. Top med æggeblommer, pulled pork, pak choi, koriander, gulerod, forårsløg og chiliflager."
    }
  ],
