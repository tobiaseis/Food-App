  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 220 °C (200 °C varmluft)."
    },
    {
      "section": null,
      "text": "Varm olien op i en stor pande ved middelhøj varme. Steg kyllingen med salt og krydderi i 4-5 minutter, til den er gyldin og helt gennemstegt. Kødet skal være hvidt uden rosa."
    },
    {
      "section": null,
      "text": "Tag panden af varmen, og vend kyllingen rundt i BBQ-saucen."
    },
    {
      "section": null,
      "text": "Skær baguetterne over på langs, og læg dem direkte på ovnristen. Bag dem i 7-8 minutter."
    },
    {
      "section": null,
      "text": "Mens brødet bager, rives guleroden groft. Vend den i en stor skål med rødkål, halvdelen af mayonnaisen, olie og salt til slawen."
    },
    {
      "section": null,
      "text": "Rør resten af mayonnaisen sammen med en lille knivspids salt i en lille skål."
    },
    {
      "section": null,
      "text": "Skyl salaten, og vend den med olie og salt til salaten."
    },
    {
      "section": null,
      "text": "Læg baguetterne på tallerkener, og smør dem med mayonnaisen. Fordel slaw og kylling i brødet, og dryp ketchup over. Server med salaten."
    }
