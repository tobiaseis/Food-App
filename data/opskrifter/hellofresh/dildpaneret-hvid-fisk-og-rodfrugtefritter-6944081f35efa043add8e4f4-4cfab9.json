  "steps": [
    {
      "section": "Rodfrugtfritter",
      "text": "Tænd ovnen på 240°C (220°C varmluft)."
    },
    {
      "section": "Rodfrugtfritter",
      "text": "Skær selleri, rødbede og pastinak i fritter på ca. 1 cm. Rødbede og pastinak skal ikke skrælles."
    },
    {
      "section": "Rodfrugtfritter",
      "text": "Læg rodfrugterne på en bageplade med bagepapir. Vend dem med olie, salt, peber og lidt citron, og brug to plader, hvis de ikke kan ligge i ét lag."
    },
    {
      "section": "Rodfrugtfritter",
      "text": "Bag fritterne i 25-35 minutter, til de er møre."
    },
    {
      "section": "Fisk",
      "text": "Hak dilden fint. Sæt tre dybe tallerkener frem: bland mel og peber i den første, pisk ægget i den anden, og vend panko med dild i den tredje."
    },
    {
      "section": "Fisk",
      "text": "Tør fisken med køkkenrulle, og drys den med salt. Vend den først i melet, så i ægget og til sidst i dildpankoen."
    },
    {
      "section": "Fisk",
      "text": "Hæld olie på en pande, så bunden er dækket, og varm den på middelhøj varme. Steg fisken 2-3 minutter på hver side, til panden er gylden og fisken mælkehvid og mat hele vejen igennem. Læg den på køkkenrulle."
    },
    {
      "section": "Tomatsalat",
      "text": "Halvér tomaterne. Skær enden af salaten, skil bladene ad, og hak dem groft."
    },
    {
      "section": "Tomatsalat",
      "text": "Vend salat og tomater med olie, salt og peber i en skål."
    },
    {
      "section": "Til servering",
      "text": "Skær citronen i både. Anret fritter, fisk og salat på tallerkener, og server med aioli og citronbåde."
    }
  ],
