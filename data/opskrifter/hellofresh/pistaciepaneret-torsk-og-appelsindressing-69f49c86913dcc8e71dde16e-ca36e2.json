  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 200 °C (180 °C varmluft). Sæt en gryde med saltet vand over til kogning."
    },
    {
      "section": "Fisk og blomkålsris",
      "text": "Hak pistacienødderne fint, og bland dem i en lille skål med panko, salt og olie til panering."
    },
    {
      "section": "Fisk og blomkålsris",
      "text": "Læg torsken på den ene halvdel af en bageplade med bagepapir. Tør den med køkkenrulle, smør sennep ovenpå, og tryk pistaciemassen fast."
    },
    {
      "section": "Fisk og blomkålsris",
      "text": "Læg blomkålsrisene på den anden halvdel af pladen. Vend dem med lidt olie, salt og peber."
    },
    {
      "section": "Fisk og blomkålsris",
      "text": "Bag i ovnen i 9-10 minutter, til fisken er gennemstegt. Kødet skal være hvidt og mat."
    },
    {
      "section": "Dressing og salat",
      "text": "Hak persillen fint. Fjern skræl og hvid hinde fra appelsinen, og skær halvdelen i tern på 2 cm."
    },
    {
      "section": "Dressing og salat",
      "text": "Pres saften fra den anden halvdel af appelsinen ned i en stor skål, og rør olie til dressing i."
    },
    {
      "section": "Broccoli",
      "text": "Del broccolien i buketter, og skær stokken i tern på 2 cm. Kog i det saltede vand i 4-6 minutter, til den er mør, og si fra."
    },
    {
      "section": "Samling",
      "text": "Vend kål, persille, tranebær, appelsintern og de bagte blomkålsris sammen med dressingen."
    },
    {
      "section": "Samling",
      "text": "Anret salat, broccoli og fisk på dybe tallerkener."
    }
