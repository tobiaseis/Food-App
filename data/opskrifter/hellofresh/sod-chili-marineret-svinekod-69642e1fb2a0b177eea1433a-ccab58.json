  "steps": [
    {
      "section": "Ris",
      "text": "Kom vand og bouillon i en gryde, og bring det i kog. Rør risene og saltet i, læg låg på, og lad dem simre ved middellav varme i 12 minutter."
    },
    {
      "section": "Ris",
      "text": "Træk gryden af varmen, og lad risene hvile under låg i 10 minutter. Løft ikke låget undervejs."
    },
    {
      "section": "Forberedelse",
      "text": "Mens risene koger, skæres gulerod, løg, radiser og bønner som angivet i ingredienslisten. Hak hvidløget fint, og riv ingefæren fint."
    },
    {
      "section": "Forberedelse",
      "text": "Skær citronen i både. Tern svinekødet på et separat skærebræt, og drys det med salt."
    },
    {
      "section": "Grøntsager",
      "text": "Varm olien op i en stor pande ved middelhøj varme. Steg gulerod, løg, radiser og bønner i 3-4 minutter, til de er næsten møre."
    },
    {
      "section": "Grøntsager",
      "text": "Kom hvidløget på panden, og steg med i 1 minut."
    },
    {
      "section": "Sauce",
      "text": "Rør sød chilisauce, sojasauce og ingefær sammen i en lille skål med et godt skvæt citronsaft."
    },
    {
      "section": "Grøntsager",
      "text": "Smag grøntsagerne til med salt og peber, og læg dem over i en skål med låg eller et fad som låg."
    },
    {
      "section": "Svinekød",
      "text": "Hæld olien på den samme pande, og varm den op ved middelhøj varme. Steg svinekødet i 3-4 minutter, til det er gennemstegt."
    },
    {
      "section": "Svinekød",
      "text": "Hæld saucen over kødet de sidste 30 sekunder, og vend det rundt, til saucen er varm."
    },
    {
      "section": "Anretning",
      "text": "Fordel ris og grøntsager på tallerkener, og læg svinekødet ovenpå. Server med citronbådene ved siden af."
    }
  ],
