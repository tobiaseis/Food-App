  "steps": [
    {
      "section": "Kylling",
      "text": "Skær peberfrugten i strimler på ca. 2 cm, og si kikærterne fra deres væske."
    },
    {
      "section": "Kylling",
      "text": "Vend kyllingen i en stor skål med mel, salt, peber og halvdelen af souvlaki-krydderiet. Pisk ægget i en anden skål, og rør det i kyllingen."
    },
    {
      "section": "Kylling",
      "text": "Varm olien på en stor pande ved middelhøj varme. Tilsæt panko til kyllingen lige før stegning, og vend det hele rundt."
    },
    {
      "section": "Kylling",
      "text": "Steg kylling, kikærter, peberfrugt og resten af krydderiet i 6-8 minutter, til kyllingen er gylden og helt gennemstegt. Kødet skal være hvidt uden spor af rødt."
    },
    {
      "section": "Salat",
      "text": "Skær agurken i halve skiver. Skær bunden af salaten, og pluk bladene fra hinanden."
    },
    {
      "section": "Salat",
      "text": "Vend salat og agurk i en stor skål med dressing, halvdelen af eddiken, salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Læg salaten på tallerkener, og fordel kylling, kikærter og peberfrugt ovenpå. Dryp med aioli."
    }
  ],
