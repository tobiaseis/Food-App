  "steps": [
    {
      "section": null,
      "text": "Sæt en stor gryde med vand over varmen, og kom rigeligt salt i, så det smager af havvand. Lad det koge."
    },
    {
      "section": "Til saucen",
      "text": "Pres eller finhak hvidløget, og hak peanuts groft. Rør dem sammen med ingefær, gochujang, sojasauce, sataysauce, ketchup og eddike i en skål."
    },
    {
      "section": "Til nudlerne",
      "text": "Snit forårsløget fint, og skær champignon i tynde skiver."
    },
    {
      "section": "Til nudlerne",
      "text": "Varm olien op i en stor pande ved middelhøj varme. Steg champignon og wokblanding med saltet, til det er brunet, 3-4 minutter."
    },
    {
      "section": "Til nudlerne",
      "text": "Kog nudlerne møre i 4 minutter. Tag 1 dl af kogevandet fra, og si nudlerne."
    },
    {
      "section": "Til nudlerne",
      "text": "Vend nudler, sauce og det afmålte nudelvand ned i panden til grøntsagerne. Tilsæt lidt vand, hvis det er for tørt."
    },
    {
      "section": "Til toppen",
      "text": "Fordel nudlerne i dybe tallerkener, og drys med forårsløg, sesamfrø og cashewnødder."
    }
  ],
