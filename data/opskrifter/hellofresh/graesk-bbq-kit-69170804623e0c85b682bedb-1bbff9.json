  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 240 °C (220 °C varmluft). Varm grillen op til 200 °C på middel varme, og dryp lidt olivenolie på risten."
    },
    {
      "section": "Kartofler",
      "text": "Halvér citronen. Hak rosmarin fint, og hak eller pres halvdelen af hvidløget."
    },
    {
      "section": "Kartofler",
      "text": "Skær kartoflerne i tern på 2 cm, og læg dem på to bageplader med bagepapir. Vend dem med olivenolie, citronsaft, rosmarin, hvidløg, salt og peber."
    },
    {
      "section": "Kartofler",
      "text": "Bag kartoflerne i 25-35 minutter, til de er gyldne."
    },
    {
      "section": "Ostedip",
      "text": "Smuldr halvdelen af fetaen i en skål. Tilsæt halvdelen af yoghurten, sukker, olivenolie, salt og peber, og pisk 1-2 minutter, til dippen er glat."
    },
    {
      "section": "Tzatziki",
      "text": "Pres eller hak det resterende hvidløg. Riv den ene agurk groft, og pres så meget væske ud af den som muligt. Rør agurk, resten af yoghurten, hvidløg, salt og peber sammen."
    },
    {
      "section": "Græsk salat",
      "text": "Skær løget i tynde skiver, halvér cherrytomaterne og skær den anden agurk i halve skiver. Hak oregano fint, og halvér olivenerne."
    },
    {
      "section": "Græsk salat",
      "text": "Vend grøntsager, oliven og oregano med citronsaft, olivenolie, salt og peber. Smuldr den resterende feta ovenpå."
    },
    {
      "section": "Fisk",
      "text": "Skær den halve citron i skiver på ½ cm, og hak de soltørrede tomater groft."
    },
    {
      "section": "Fisk",
      "text": "Tør fisken med køkkenrulle, pensl den med olivenolie, og drys med salt og peber."
    },
    {
      "section": "Fisk",
      "text": "Klip fire stykker sølvpapir på ca. 30 x 30 cm. Dryp olie midt på hvert stykke, og læg en citronskive, fisk og soltørrede tomater ovenpå. Fold kanterne op som en båd, og luk enderne godt, men lad toppen være åben."
    },
    {
      "section": "Grill",
      "text": "Grill fiskebådene i 10-12 minutter. Fisken er færdig, når kødet er mælkehvidt og mat."
    },
    {
      "section": "Grill",
      "text": "Skær halloumien i tynde skiver på tværs, og pensl begge sider med olie. Grill den 2-3 minutter på hver side, til den er gylden."
    },
    {
      "section": "Grill",
      "text": "Grill pitabrødene 1-2 minutter på hver side, til de er gyldne, og skær dem i trekanter."
    },
    {
      "section": "Servering",
      "text": "Læg kartoflerne på et fad, og top med ostedippen. Anret fisken med solsikkekerner på et andet fad. Server med græsk salat, halloumi, pita og tzatziki."
    }
  ],
