  "steps": [
    {
      "section": "Løgringe",
      "text": "Tænd ovnen på 200 °C (180 °C varmluft). Skær løget i ringe på ca. 1 cm."
    },
    {
      "section": "Løgringe",
      "text": "Læg ringene på en bageplade med bagepapir. Drys med olie, salt og halvdelen af krydderiblandingen, og top med revet ost."
    },
    {
      "section": "Løgringe",
      "text": "Bag i 15-20 minutter, til osten er gylden."
    },
    {
      "section": "Sauce",
      "text": "Rør worcestershiresauce, ketchup, creme fraiche, mayonnaise og resten af krydderiblandingen sammen i en lille skål."
    },
    {
      "section": "Salat",
      "text": "Skyl romainesalaten, pluk den i blade, og hak dem groft. Snit forårsløget fint."
    },
    {
      "section": "Salat",
      "text": "Skær gulerodden i lange, tynde bånd med en skræller, og hak den sidste rest fint."
    },
    {
      "section": "Salat",
      "text": "Vend salat, gulerod og forårsløg med olie og salt."
    },
    {
      "section": "Svinekam",
      "text": "Drys svinekammen med salt. Bland mel og salt på en dyb tallerken, pisk ægget på en anden, og kom panko på en tredje."
    },
    {
      "section": "Svinekam",
      "text": "Vend kødet først i melet, så i ægget og til sidst i panko. Har du ikke æg, kan du bruge 2 spsk mælk i stedet."
    },
    {
      "section": "Svinekam",
      "text": "Varm olien på en pande ved middelhøj varme, så bunden er dækket. Steg kødet 3-4 minutter på hver side, til det er gyldent og helt gennemstegt uden rødt. Tilsæt mere olie, hvis det behøves."
    },
    {
      "section": "Svinekam",
      "text": "Skær kødet på langs i to stykker, læg det på køkkenrulle, og drys med salt."
    },
    {
      "section": "Svinekam",
      "text": "Steg baconen på samme pande i 4-5 minutter, til den er gylden."
    },
    {
      "section": "Brød",
      "text": "Skær baguetterne midt over, og smør underdelene med smør. Læg dem direkte på ovnristen i 2-3 minutter."
    },
    {
      "section": "Brød",
      "text": "Smør brødet med saucen, og læg lidt salat på. Fyld med svinekam, bacon og de ostebagte løgringe, og server resten af salaten ved siden af."
    }
  ],
