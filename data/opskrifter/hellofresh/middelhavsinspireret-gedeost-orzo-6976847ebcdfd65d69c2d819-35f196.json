  "steps": [
    {
      "section": "Grøntsager",
      "text": "Sæt ovnen på 220 °C (200 °C varmluft)."
    },
    {
      "section": "Grøntsager",
      "text": "Skær peberfrugten i strimler på ca. 1 cm. Del løg og tomater i både på ca. 1 cm."
    },
    {
      "section": "Grøntsager",
      "text": "Læg grøntsagerne på en bageplade med bagepapir. Hæld lidt olivenolie over, tilsæt salt og peber, og vend det hele rundt."
    },
    {
      "section": "Grøntsager",
      "text": "Bag i 15-25 minutter, til grøntsagerne er møre."
    },
    {
      "section": "Orzotto",
      "text": "Pres hvidløget eller hak det fint."
    },
    {
      "section": "Orzotto",
      "text": "Varm lidt olivenolie op i en stor stegepande ved middelhøj varme. Rør hvidløg og Hello Sunrise rundt i 30 sekunder, til det dufter."
    },
    {
      "section": "Orzotto",
      "text": "Kom orzo og tomatpuré i panden, og steg under omrøring i 1 minut."
    },
    {
      "section": "Orzotto",
      "text": "Hæld vand og salt i, og lad det komme i kog. Skru ned til middel varme, læg låg på, og lad det simre i 12-14 minutter, til orzoen er al dente (kogt, men med lidt bid)."
    },
    {
      "section": "Orzotto",
      "text": "Rør ofte i panden, så orzoen ikke brænder fast. Ser den tør ud, så tilsæt et skvæt vand."
    },
    {
      "section": "Til servering",
      "text": "Hak persillen groft, mens orzoen koger."
    },
    {
      "section": "Til servering",
      "text": "Rør gruyère og chiliflager ned i den kogte orzo. Brug mindre chili eller drop den, hvis I ikke vil have det stærkt."
    },
    {
      "section": "Til servering",
      "text": "Hæld orzotto op i dybe tallerkener, og læg de bagte grøntsager ovenpå. Smuldr gedeost over, og drys med persille og mandelflager."
    }
  ],
