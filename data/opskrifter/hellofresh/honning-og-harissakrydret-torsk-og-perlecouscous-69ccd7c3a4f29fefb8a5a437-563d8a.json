  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 220°C (200°C varmluft)."
    },
    {
      "section": "Couscous",
      "text": "Kog vand, salt og bouillon op i en gryde. Kom perlecouscousen i, læg låg på, og lad den simre på middellav varme i 12-15 minutter, til den er blød. Si overskydende vand fra."
    },
    {
      "section": "Grøntsager",
      "text": "Skær løget i både på ca. 2 cm. Skær squash og gulerod i tynde halvmåner. Skyl rucolaen."
    },
    {
      "section": "Grøntsager",
      "text": "Læg løg, squash og gulerod på en bageplade med bagepapir. Vend dem med lidt olie og salt, og bag dem i 25-35 minutter, til de er møre."
    },
    {
      "section": "Fisk",
      "text": "Rør olie, harissa og halvdelen af honningen sammen i en lille skål. Tør fisken med køkkenrulle, og drys den med salt."
    },
    {
      "section": "Fisk",
      "text": "Læg fisken i et ildfast fad med bagepapir, og smør harissablandingen ovenpå, når der er 12-15 minutter tilbage af grøntsagernes tid. Bag den færdig, til den er gylden og gennemstegt. Kødet skal være hvidt og mat."
    },
    {
      "section": "Granatæble",
      "text": "Rul granatæblet hårdt hen over bordet, og skær det over på midten. Læg det i en skål med vand, og pil kernerne ud med fingrene under vandet, så saften ikke farver. Kernerne synker, mens det hvide skal flyder øverst og kan fjernes. Skyl kernerne i en si under koldt vand."
    },
    {
      "section": "Dressing og anretning",
      "text": "Rør tahin, vand, resten af honningen og salt sammen i en skål."
    },
    {
      "section": "Dressing og anretning",
      "text": "Vend de bagte grøntsager, rucola og granatæblekerner i couscousen. Fordel couscous og fisk på tallerkener, drys med mandelflager, og dryp med tahinidressing."
    }
  ],
