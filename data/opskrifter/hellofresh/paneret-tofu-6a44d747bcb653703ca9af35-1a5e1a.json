  "steps": [
    {
      "section": "Rodfrugtfritter",
      "text": "Tænd ovnen på 220 °C varmluft."
    },
    {
      "section": "Rodfrugtfritter",
      "text": "Skær rødbeder og pastinak i fritter på cirka 1 cm, og læg dem på en bageplade med bagepapir. Brug flere plader, hvis de ligger for tæt."
    },
    {
      "section": "Rodfrugtfritter",
      "text": "Dryp med lidt olie, drys med oregano og salt, og vend rundt. Bag i 25-35 minutter, til de er møre."
    },
    {
      "section": "Æble-fennikelsalat",
      "text": "Del citronen i både. Skær æblet i små tern og fennikel i tynde skiver, som du halverer."
    },
    {
      "section": "Æble-fennikelsalat",
      "text": "Rør olie, en sjat citronsaft og sukker sammen i en skål. Vend æble og fennikel i dressingen."
    },
    {
      "section": "Paneret tofu",
      "text": "Skær tofuen i to skiver, én til hver. Sæt tre dybe tallerkener frem: hvedemel og salt i den første, pisket æg i den anden, panko og hvidløg- og urtekrydderi i den tredje."
    },
    {
      "section": "Paneret tofu",
      "text": "Vend hver skive først i melet, så i ægget og til sidst i panko, så den er helt dækket."
    },
    {
      "section": "Paneret tofu",
      "text": "Varm olie op i en stor pande ved middelhøj varme, så bunden er dækket. Steg tofuen gylden i 2-3 minutter på hver side."
    },
    {
      "section": "Paneret tofu",
      "text": "Læg tofuen på køkkenrulle, og drys med lidt salt."
    },
    {
      "section": null,
      "text": "Anret tofu, fritter og salat på tallerkener, og server med remoulade."
    }
  ],
