  "steps": [
    {
      "section": "Tærtebunden",
      "text": "Tænd ovnen på 220 °C (200 °C varmluft). Lad tærtedejen stå ved stuetemperatur i 30 minutter."
    },
    {
      "section": "Tærtebunden",
      "text": "Læg dejen med bagepapiret på en bageplade, og stik små huller i den med en gaffel. Slå kanten cirka 2 cm ind hele vejen rundt, så der kommer en skorpe."
    },
    {
      "section": "Tærtebunden",
      "text": "Forbag bunden i 5-6 minutter. Det holder bunden sprød, når tærten er færdig."
    },
    {
      "section": "Fyld",
      "text": "Hak løg og hvidløg fint, og skær porren i tynde, halve skiver."
    },
    {
      "section": "Fyld",
      "text": "Varm en mellemstor pande op på middelhøj varme, og brun baconen i 4-5 minutter, til den er gylden. Tag den op på en tallerken med køkkenrulle."
    },
    {
      "section": "Fyld",
      "text": "Svits løg, hvidløg og porre i samme pande i 4-5 minutter, til de er møre."
    },
    {
      "section": "Fyld",
      "text": "Hæld fløde og vand i, og rør bouillon, salt og peber ud i. Lad saucen simre i 3-4 minutter, til den er let tyknet."
    },
    {
      "section": "Bagning",
      "text": "Fordel porresaucen på den forbagte bund. Strø bacon og ost ovenpå."
    },
    {
      "section": "Bagning",
      "text": "Bag tærten i 15-20 minutter, til den er gyldenbrun, og osten er smeltet."
    },
    {
      "section": "Salat",
      "text": "Skyl salaten. Skræl gulerodden i lange bånd, og hak resten fint."
    },
    {
      "section": "Salat",
      "text": "Vend salat, gulerod, solsikkekerner, sennep, olie, salt og peber sammen i en stor skål."
    },
    {
      "section": "Servering",
      "text": "Del tærten i stykker, og server den med salaten."
    }
  ],
