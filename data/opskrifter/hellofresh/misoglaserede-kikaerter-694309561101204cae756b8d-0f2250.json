  "steps": [
    {
      "section": null,
      "text": "Kog vandet op i en mellemstor gryde. Kom ris og salt i, læg låg på, og lad risen koge ved middellav varme i 12 minutter."
    },
    {
      "section": null,
      "text": "Tag gryden af varmen, og lad risen trække under låg i 10 minutter. Løft ikke låget undervejs."
    },
    {
      "section": "Misoglaze",
      "text": "Hæld lagen fra kikærterne i en lille skål, og rør sojasauce, honning, misopasta og hvedemel ud i den."
    },
    {
      "section": "Hvidløgsolie",
      "text": "Rør hvidløg og olie sammen i en anden lille skål."
    },
    {
      "section": null,
      "text": "Varm olien til stegning op på en stor pande ved middelhøj varme. Brun kikærterne i 5-7 minutter, til de er gyldne."
    },
    {
      "section": "Ponzugrøntsager",
      "text": "Vend radiser, agurk, pak choi og peanuts med ponzudressing, olie, salt og peber i en mellemstor skål."
    },
    {
      "section": "Misoglaze",
      "text": "Hæld glazen på panden til kikærterne, og lad den småkoge i 2-3 minutter, til saucen er tyk, og kikærterne er dækket af glaze."
    },
    {
      "section": "Chiliyoghurt",
      "text": "Rør yoghurt og chiliflager sammen, og smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Fordel risen i dybe tallerkener, og dryp hvidløgsolien over. Læg grøntsagerne og kikærterne ovenpå, og server med chiliyoghurt og koriander."
    }
  ],
