  "steps": [
    {
      "section": null,
      "text": "Tag bøfferne ud af køleskabet i god tid. Gnid dem med salt og Tex-Mex-krydderi."
    },
    {
      "section": "Ris",
      "text": "Hak eller pres hvidløget. Smelt smørret i en gryde ved middel varme, og svits hvidløget i ca. 30 sekunder, til det dufter."
    },
    {
      "section": "Ris",
      "text": "Hæld vandet i, og bring det i kog. Kom ris og salt i, læg låg på, og lad risen koge ved middellav varme i 10 minutter."
    },
    {
      "section": "Ris",
      "text": "Træk gryden af varmen, og lad risen trække under låg i 10 minutter. Løft ikke låget undervejs."
    },
    {
      "section": "Chimichurri",
      "text": "Hak løg, persille og koriander fint. Del citronen på midten. Rør det hakkede sammen med salt, olivenolie og et godt skvæt citronsaft i en lille skål."
    },
    {
      "section": "Avocadosalat",
      "text": "Skær cherrytomaterne i kvarte. Halver avocadoen, fjern kernen, og øs kødet ud med en ske. Skær det i tern på ca. 2 cm."
    },
    {
      "section": "Avocadosalat",
      "text": "Vend tomater og avocado med salt og olivenolie i en skål."
    },
    {
      "section": "Cremet majs",
      "text": "Si majsene fra vandet. Varm en stegepande op ved middelhøj varme, og steg majsene i 4-5 minutter, til de er gyldne."
    },
    {
      "section": "Cremet majs",
      "text": "Kom majsene i en skål, og rør dem sammen med mayonnaise, salt og peber."
    },
    {
      "section": "Bøffer",
      "text": "Varm lidt olivenolie op i en stegepande ved middelhøj varme. Steg bøfferne 3-4 minutter på hver side, til de er brunede. Steg 1-2 minutter længere pr. side, hvis de skal være gennemstegte."
    },
    {
      "section": "Bøffer",
      "text": "Pak bøfferne ind i folie, og lad dem hvile, til du skal servere. Skær dem derefter i tynde skiver."
    },
    {
      "section": "Servering",
      "text": "Fordel ris, kød, majs, tortillachips og avocadosalat i dybe tallerkener. Smuldr feta over majsene, og top bøfferne med chimichurri."
    }
  ],
