  "steps": [
    {
      "section": "Bulgur",
      "text": "Kom vand, bulgur, bouillon og salt i en mellemstor gryde. Bring det i kog, og lad det simre på middel varme i 9-10 minutter, til bulguren er al dente."
    },
    {
      "section": "Grøntsager og syltede løg",
      "text": "Hak tomater, agurk og salat groft. Pres eller finhak hvidløget, og hak persillen fint."
    },
    {
      "section": "Grøntsager og syltede løg",
      "text": "Skær løget i tynde halve skiver, og rør dem i en skål med eddike, sukker, salt og vand."
    },
    {
      "section": "Kylling",
      "text": "Vend kyllingestrimlerne med salt og karry i en skål."
    },
    {
      "section": "Kylling",
      "text": "Varm lidt olivenolie op i en stor pande på middelhøj varme. Steg kyllingen i 4-5 minutter, til den er gylden og helt gennemstegt – kødet skal være hvidt uden rosa."
    },
    {
      "section": "Hvidløgsyoghurt",
      "text": "Rør yoghurt, hvidløg og vand sammen i en lille skål, og smag til med salt og peber."
    },
    {
      "section": "Samling",
      "text": "Vend persillen i bulguren. Si løgene, men gem lidt af syltelagen."
    },
    {
      "section": "Samling",
      "text": "Bland agurk, salat, tomat og løg med den gemte syltelage, og smag til med salt og peber."
    },
    {
      "section": "Samling",
      "text": "Fordel bulguren i dybe tallerkener, og læg kylling og grøntsagssalat ovenpå. Slut med hvidløgsyoghurten."
    }
  ],
