  "steps": [
    {
      "section": "Ris",
      "text": "Kom vand i en gryde, og bring det i kog. Tilsæt salt og ris, læg låg på, og lad det koge ved middellav varme i 14 minutter."
    },
    {
      "section": "Ris",
      "text": "Tag gryden af varmen, og lad risene stå under låg i 10 minutter. Løft ikke låget undervejs."
    },
    {
      "section": "Stroganoff",
      "text": "Skær pølsen i strimler på ca. 1 cm, og hak løget fint."
    },
    {
      "section": "Stroganoff",
      "text": "Varm olien op i en stor stegepande ved middelhøj varme. Brun pølse og løg i 4-5 minutter."
    },
    {
      "section": "Stroganoff",
      "text": "Rør tomatpuréen ind, og lad den stege med i 1 minut."
    },
    {
      "section": "Stroganoff",
      "text": "Hæld fløde, mælk, vand og sojasauce i panden, og rør ketchup og sennep ud i saucen. Lad den simre i 4-5 minutter, til den har tyknet lidt."
    },
    {
      "section": "Stroganoff",
      "text": "Smag til med salt lige før servering."
    },
    {
      "section": "Salat",
      "text": "Hak persillen groft, mens saucen simrer. Vend spidskål, halvdelen af persillen, olie og salt sammen i en skål."
    },
    {
      "section": "Salat",
      "text": "Fordel ris og stroganoff i dybe tallerkener, og drys med resten af persillen. Server med salaten ved siden af."
    }
  ],
