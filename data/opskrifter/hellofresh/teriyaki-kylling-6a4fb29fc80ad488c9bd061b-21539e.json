  "steps": [
    {
      "section": null,
      "text": "Sæt en gryde med vand over varmen, og bring det i kog. Smag til med rigeligt salt, så vandet minder om havvand."
    },
    {
      "section": "Kyllingen",
      "text": "Varm lidt olie op i en stor pande ved middelhøj varme. Drys kyllingen med salt, og brun den 2 minutter på hver side."
    },
    {
      "section": "Kyllingen",
      "text": "Skru ned til middel varme, og steg kyllingen 2-3 minutter mere på hver side. Den er færdig, når kødet er hvidt hele vejen igennem."
    },
    {
      "section": "Kyllingen",
      "text": "Skær kyllingen i tynde skiver, og vend dem i teriyakisaucen i en skål."
    },
    {
      "section": "Salaten",
      "text": "Mens kyllingen steger, skæres roden af salaten, og resten hakkes groft. Skær agurken i tynde stave."
    },
    {
      "section": "Salaten",
      "text": "Pluk mynteblade af, og riv dem i grove stykker. Del citronen i to."
    },
    {
      "section": "Salaten",
      "text": "Kog nudlerne i 1 minut, til de er varme. Hæld vandet fra, og skyl dem koldt i en si."
    },
    {
      "section": "Salaten",
      "text": "Rør sesamolie, ingefærpasta, mynte, olie, salt og peber sammen i en stor skål med et skvæt citronsaft."
    },
    {
      "section": "Salaten",
      "text": "Vend nudler, kålsalat, salat og agurk i dressingen."
    },
    {
      "section": "Servering",
      "text": "Fordel nudelsalaten i dybe tallerkener, og læg kyllingen ovenpå. Dryp med sriracha."
    }
  ],
