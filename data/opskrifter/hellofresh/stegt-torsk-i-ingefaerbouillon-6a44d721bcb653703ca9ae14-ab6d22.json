  "steps": [
    {
      "section": "Citrongræsris",
      "text": "Slå citrongræsstilken let med en kagerulle, så den åbner sig."
    },
    {
      "section": "Citrongræsris",
      "text": "Varm olien i en mellemstor gryde ved middel varme, og rist citrongræsset i 1-2 minutter, til det dufter."
    },
    {
      "section": "Citrongræsris",
      "text": "Hæld vandet i, og bring det i kog. Kom ris og salt i, læg låg på, og lad det simre ved middellav varme i 14 minutter."
    },
    {
      "section": "Citrongræsris",
      "text": "Træk gryden af varmen, og lad risene trække under låg i 10 minutter. Løft ikke låget undervejs. Tag citrongræsset op til sidst."
    },
    {
      "section": "Ingefærbouillon",
      "text": "Skær chilien på langs, fjern kernerne, og hak den fint. Skær citronen over, og hak koriander groft."
    },
    {
      "section": "Ingefærbouillon",
      "text": "Rør saften fra citronen sammen med salt, koriander, ingefær, chili og vand i en lille skål. Brug mindre chili eller drop den, hvis den færdige ret skal være mild."
    },
    {
      "section": "Grøntsager",
      "text": "Hak pak choi og broccolini groft. Skær løget i halve, tynde skiver, og hak eller pres hvidløget."
    },
    {
      "section": "Grøntsager",
      "text": "Varm olien i en stor pande ved middelhøj varme. Steg løg og broccolini i 3-4 minutter, til de næsten er møre."
    },
    {
      "section": "Grøntsager",
      "text": "Kom pak choi, sesamfrø, hvidløg, salt og peber på panden, og steg 1-2 minutter, til det dufter. Hæld grøntsagerne i en stor skål, og læg folie over, så de holder varmen."
    },
    {
      "section": "Fisk",
      "text": "Tør panden af, og varm lidt olie op ved middelhøj varme. Dup torsken tør med køkkenrulle, og drys med salt og peber."
    },
    {
      "section": "Fisk",
      "text": "Steg fisken 3-4 minutter på hver side, til den er gylden og gennemstegt, og kødet er mat og hvidt. Kom smørret på panden, og lad det smelte."
    },
    {
      "section": "Fisk",
      "text": "Tag panden af varmen, og hæld ingefærbouillonen på."
    },
    {
      "section": "Fisk",
      "text": "Anret ris, grøntsager og fisk på tallerkener, og hæld bouillonen fra panden over fisken."
    }
  ],
