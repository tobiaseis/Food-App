  "steps": [
    {
      "section": "Hvidløgsris",
      "text": "Smelt smørret i en mellemstor gryde ved middel varme, og svits halvdelen af hvidløget i ca. 30 sekunder, til det dufter."
    },
    {
      "section": "Hvidløgsris",
      "text": "Hæld vandet i, og bring det i kog. Kom ris og salt i, læg låg på, og lad risene simre ved middellav varme i 14 minutter."
    },
    {
      "section": "Hvidløgsris",
      "text": "Tag gryden af varmen, og lad risene trække under låg i 10 minutter. Løft ikke låget undervejs."
    },
    {
      "section": "Forberedelse",
      "text": "Skræl guleroden i lange, tynde bånd, og hak resten fint. Hak pak choi og løg groft, og del citronen i både."
    },
    {
      "section": "Syltet gulerod",
      "text": "Rør eddike, sukker, vand og en knivspids salt sammen i en lille skål, og vend gulerodsbåndene heri. Lad dem stå, og hæld væsken fra lige før servering."
    },
    {
      "section": "Kylling",
      "text": "Vend kyllingestrimlerne i mel, salt og peber i en stor skål."
    },
    {
      "section": "Marinade",
      "text": "Rør sojasauce, sukker, et godt skvæt citronsaft og resten af hvidløget sammen i en lille skål."
    },
    {
      "section": "Kylling",
      "text": "Varm halvdelen af olien i en stor pande ved middelhøj varme, og steg pak choi i 2-3 minutter, til den er blød. Smag til med salt og peber, og stil den i en skål med låg."
    },
    {
      "section": "Kylling",
      "text": "Brug samme pande, og tilsæt lidt mere olie, hvis det er nødvendigt. Steg kylling og løg i 4-5 minutter, til kødet er gennemstegt og helt hvidt."
    },
    {
      "section": "Kylling",
      "text": "Tag panden af varmen, hæld marinaden over, og vend det hele rundt."
    },
    {
      "section": "Til servering",
      "text": "Hak peanuts, mynte og koriander groft, og skær chilien i tynde skiver."
    },
    {
      "section": "Til servering",
      "text": "Fordel ris, kylling, pak choi og gulerod i dybe tallerkener. Drys med peanuts, urter og chili, og server med srirachamayonnaise og de resterende citronbåde. Brug mindre chili eller drop den, hvis du ikke bryder dig om stærk mad."
    }
  ],
