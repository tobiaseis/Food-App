  "steps": [
    {
      "section": null,
      "text": "Sæt en stor gryde med letsaltet vand over varmen og bring det i kog. Del kartoflerne på midten uden at skrælle dem, og hak basilikum groft."
    },
    {
      "section": null,
      "text": "Kog kartoflerne i 12-15 minutter, til de er møre. Si vandet fra, smag til med salt og peber, og læg låg på, så de holder varmen."
    },
    {
      "section": "Fisken",
      "text": "Varm lidt olivenolie op i en stegepande ved middelhøj varme. Tør kulleren med køkkenrulle, og drys den med salt og krydderiet."
    },
    {
      "section": "Fisken",
      "text": "Steg fisken 2-3 minutter på hver side, til den er gylden og helt gennemstegt. Kødet skal være mælkehvidt og mat. Læg den over på en tallerken."
    },
    {
      "section": "Salaten",
      "text": "Skær æblet i tynde halve skiver, og skær agurken i halve skiver. Massér spidskålen med lidt olivenolie i en stor skål i ca. 30 sekunder."
    },
    {
      "section": "Salaten",
      "text": "Vend æble, agurk, tranebær, salt og lidt peber i skålen."
    },
    {
      "section": "Saucen",
      "text": "Pres eller hak hvidløget fint. Smelt smørret i den samme pande ved middelhøj varme, og svits hvidløget i 1 minut, til det dufter."
    },
    {
      "section": "Saucen",
      "text": "Rør fløde, bouillon og basilikum i panden, og lad saucen simre i 1-2 minutter, til den er varm hele vejen igennem. Smag til med salt og rigeligt peber."
    },
    {
      "section": null,
      "text": "Fordel kartofler, fisk og salat på tallerkener, og hæld basilikumsaucen over fisken."
    }
  ],
