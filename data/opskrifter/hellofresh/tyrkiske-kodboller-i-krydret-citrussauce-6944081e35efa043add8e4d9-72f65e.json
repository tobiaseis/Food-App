  "steps": [
    {
      "section": "Perlecouscous",
      "text": "Kog vandet op med saltet i en gryde. Kom couscous i, læg låg på, og lad den simre ved middellav varme i 12-15 minutter, til den er al dente. Si det overskydende vand fra."
    },
    {
      "section": "Kødboller",
      "text": "Rør fars, æg, rasp, krydderi og salt sammen i en stor skål. Form 4 kødboller pr. person, og læg dem på et fad."
    },
    {
      "section": "Fennikelsalat",
      "text": "Vend fennikelskiverne med en knivspids salt i en stor skål, og lad dem stå."
    },
    {
      "section": "Kødboller",
      "text": "Varm olien op i en stor pande ved middelhøj varme. Brun kødbollerne, og skru ned til middel varme. Steg dem i alt 12-14 minutter, til de er gennemstegte og helt uden rødt i midten."
    },
    {
      "section": "Citrussauce",
      "text": "Del citronen i to. Lad smørret smelte i panden efter kødbollerne. Rør røget paprika, chiliflager og en god sjat citronsaft i, og steg i ca. 30 sekunder, til det dufter. Brug mindre chili eller drop den, hvis du ikke vil have det så stærkt."
    },
    {
      "section": "Perlecouscous",
      "text": "Rør yoghurt, hvidløg og en knivspids salt ind i den kogte couscous."
    },
    {
      "section": "Fennikelsalat",
      "text": "Vend salat, olie og dild med fennikel lige inden servering."
    },
    {
      "section": null,
      "text": "Server couscous og salat i dybe tallerkener. Læg kødboller ovenpå, og hæld saucen fra panden over."
    }
  ],
