  "steps": [
    {
      "section": "Kokosris",
      "text": "Varm ovnen op til 220 °C (200 °C varmluft)."
    },
    {
      "section": "Kokosris",
      "text": "Varm olien i en mellemstor gryde ved middel varme. Rist kokosmelet i ca. 30 sekunder, til det er gyldent og dufter."
    },
    {
      "section": "Kokosris",
      "text": "Hæld vandet i, og bring det i kog. Rør ris og salt ned i, læg låg på, og lad det koge ved middellav varme i 10 minutter."
    },
    {
      "section": "Kokosris",
      "text": "Træk gryden væk fra varmen, og lad risen trække under låg i 10 minutter. Løft ikke låget undervejs."
    },
    {
      "section": "Kachumbersalat",
      "text": "Mens risen koger, skal citronen deles i halve. Skær løget i tynde halve skiver."
    },
    {
      "section": "Kachumbersalat",
      "text": "Pres saften fra citronen i en lille skål, og rør sukker og salt til syltningen ud i den. Vend løgskiverne i, og lad dem stå til senere."
    },
    {
      "section": "Kachumbersalat",
      "text": "Rul granatæblet hårdt hen over bordet, og skær det over på midten. Læg det i en skål med vand, og pil kernerne løs med fingrene. Kernerne synker, mens den hvide hinde flyder op, så den kan fiskes fra. Hæld kernerne i en si, og skyl dem under koldt vand."
    },
    {
      "section": "Kachumbersalat",
      "text": "Hak agurken groft, og halver tomaterne. Kom begge dele i en stor skål sammen med granatæblekernerne."
    },
    {
      "section": "Urteolie og naan",
      "text": "Hak myntebladene fint, og rør dem sammen med olie til urteolien og en smule salt i en lille skål."
    },
    {
      "section": "Butter chicken",
      "text": "Skær kyllingebrystet i tynde strimler på et separat skærebræt."
    },
    {
      "section": "Butter chicken",
      "text": "Varm olien i en stor pande ved middelhøj varme, og brun kyllingen i 3-4 minutter."
    },
    {
      "section": "Butter chicken",
      "text": "Rør tikka masala, tomatpuré, garam masala, sukker og smør i panden, og lad det simre i ca. 30 sekunder, til det dufter kraftigt."
    },
    {
      "section": "Butter chicken",
      "text": "Tilsæt bouillon, salt, fløde og vand. Lad saucen simre i 1-2 minutter, til kyllingen er helt gennemstegt – kødet skal være hvidt uden rosa."
    },
    {
      "section": "Urteolie og naan",
      "text": "Læg naanbrødene på en bageplade med bagepapir, og pensl dem med urteolien. Bag dem i ovnen i 2-3 minutter, til de er sprøde."
    },
    {
      "section": "Kachumbersalat",
      "text": "Lige før servering vendes de syltede løg med lagen, olien og saltet til salaten i skålen med agurk, tomat og granatæble."
    },
    {
      "section": null,
      "text": "Fordel kokosris og butter chicken i dybe tallerkener, og server med salaten og urtenaanen ved siden af."
    }
  ],
