  "steps": [
    {
      "section": "Ris",
      "text": "Kom vand og salt i en gryde, og bring det i kog. Rør risen i, læg låg på, og lad den koge ved middellav varme i 10 min."
    },
    {
      "section": "Ris",
      "text": "Træk gryden af varmen. Lad risen trække under låg i 10 min, og løft ikke låget undervejs."
    },
    {
      "section": "Sauce",
      "text": "Skær løget i tynde halve skiver, og hak tomaterne fint. Riv ingefæren fint, og pres eller hak hvidløget. Del chilien på langs, fjern kernerne, og hak den fint."
    },
    {
      "section": "Sauce",
      "text": "Varm olien op i en mellemstor gryde ved middelhøj varme. Steg løg og tomat i 3-4 min, til de er bløde."
    },
    {
      "section": "Sauce",
      "text": "Rør hvidløg, ingefær, chili og garam masala i, og svits det i 30 sek., til det dufter."
    },
    {
      "section": "Sauce",
      "text": "Hæld kokosmælk og vand i, og tilsæt salt og sukker. Bring det i kog, skru ned til middel varme, og lad saucen simre under låg i 4-5 min, til den er let tyknet."
    },
    {
      "section": "Sauce",
      "text": "Blend saucen jævn med stavblender eller i en blender. Uden blender kan du mose den groft med en kartoffelmoser."
    },
    {
      "section": "Fisk og servering",
      "text": "Hak koriander fint, og skær citronen over. Dup fisken tør med køkkenrulle, og drys den med salt."
    },
    {
      "section": "Fisk og servering",
      "text": "Læg fisken i saucen, og lad den simre i 5-6 min, til kødet er mat i midten."
    },
    {
      "section": "Fisk og servering",
      "text": "Rør koriander og et stort skvæt citronsaft i lige før servering. Anret ris, fisk og sauce i dybe tallerkener."
    }
  ],
