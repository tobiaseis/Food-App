  "steps": [
    {
      "section": "Ris",
      "text": "Kog vandet op i en mellemstor gryde. Kom risen og saltet i, læg låg på, og lad det simre ved middellav varme i 12 minutter."
    },
    {
      "section": "Ris",
      "text": "Tag gryden af varmen, og lad risen trække under låg i 10 minutter. Løft ikke låget undervejs."
    },
    {
      "section": "Syltet løg",
      "text": "Skær løget i tynde halve skiver, og halver limen."
    },
    {
      "section": "Syltet løg",
      "text": "Rør et stort skvæt limesaft sammen med sukker og salt i en lille skål, og vend løget i. Si væden fra lige før servering."
    },
    {
      "section": "Tunsalat og grønt",
      "text": "Halver avocadoen, tag stenen ud, og skrab kødet ud med en ske. Skær det i tynde skiver."
    },
    {
      "section": "Tunsalat og grønt",
      "text": "Riv gulerod groft med skræl på. Brug en skræller til at tage lange, tynde bånd af agurken."
    },
    {
      "section": "Tunsalat og grønt",
      "text": "Snit forårsløget fint, og lad tunen dryppe af. Vend tun, forårsløg, gulerod og sriracha sammen i en mellemstor skål."
    },
    {
      "section": "Dressing",
      "text": "Hak koriander fint. Slå chilien op, fjern kernerne, og skær den i tynde skiver."
    },
    {
      "section": "Dressing",
      "text": "Rør chili, koriander, fiskesauce, vand, olivenolie og et skvæt limesaft sammen i en lille skål. Brug mindre chili eller helt uden, hvis det ikke skal være så stærkt."
    },
    {
      "section": null,
      "text": "Fordel ris, tunsalat, avocado, agurk og syltet løg i dybe tallerkener, og hæld dressingen over."
    }
  ],
