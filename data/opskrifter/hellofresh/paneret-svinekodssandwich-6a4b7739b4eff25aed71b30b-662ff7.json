  "steps": [
    {
      "section": "Osteløgringe",
      "text": "Tænd ovnen på 200 °C (180 °C varmluft). Skær løget i ringe på ca. 1 cm."
    },
    {
      "section": "Osteløgringe",
      "text": "Læg ringene på en bageplade med bagepapir. Drys med olie, salt, peber og halvdelen af krydderiblandingen, og strø den revne gouda over."
    },
    {
      "section": "Osteløgringe",
      "text": "Bag løgringene midt i ovnen i 15-20 minutter, til osten er gylden."
    },
    {
      "section": "Sauce",
      "text": "Rør worcestershiresauce, ketchup, mayonnaise, creme fraiche og resten af krydderiblandingen sammen i en lille skål."
    },
    {
      "section": "Salat",
      "text": "Skyl romainesalaten, pluk bladene fra hinanden, og hak dem groft. Lav lange, tynde bånd af gulerodden med skræller, og hak resten fint. Snit forårsløget fint."
    },
    {
      "section": "Salat",
      "text": "Vend salat, gulerod og forårsløg med olie og salt i en skål."
    },
    {
      "section": "Svinekam",
      "text": "Skær svinekammen i to skiver, én til hver. Drys dem med salt."
    },
    {
      "section": "Svinekam",
      "text": "Sæt tre dybe tallerkener frem: bland mel, salt og peber i den første, pisk ægget i den anden, og hæld panko i den tredje. Vend skiverne først i mel, så i æg og til sidst i panko. Har du ikke æg, kan du bruge 2 spsk mælk i stedet."
    },
    {
      "section": "Svinekam",
      "text": "Varm olie op i en stegepande på middelhøj varme, så bunden er dækket. Steg skiverne 3-4 minutter på hver side, til de er gyldne og helt gennemstegte uden rødt kød. Tilsæt mere olie, hvis panden bliver tør."
    },
    {
      "section": "Svinekam",
      "text": "Skær skiverne i to på langs, og læg dem på køkkenrulle."
    },
    {
      "section": "Brød",
      "text": "Skær baguetterne midt over, og smør bunden med smør. Læg dem direkte på ovnristen i 4-5 minutter."
    },
    {
      "section": "Brød",
      "text": "Smør brødene med saucen, og læg lidt salat på. Læg svinekammen og de ostebagte løgringe ovenpå, og server resten af salaten ved siden af."
    }
  ],
