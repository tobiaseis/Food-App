  "steps": [
    {
      "section": "Kartofler",
      "text": "Tænd ovnen på 240 °C (220 °C varmluft). Tag bøfferne ud af køleskabet, og drys dem med salt."
    },
    {
      "section": "Kartofler",
      "text": "Kog kartoflerne i letsaltet vand i 15-18 minutter, til de er næsten møre."
    },
    {
      "section": "Kartofler",
      "text": "Forbered imens løg, timian, hvidløg, tomater og rucola som beskrevet i ingredienslisten."
    },
    {
      "section": "Kartofler",
      "text": "Læg de kogte kartofler på en bageplade med bagepapir, og tryk hver enkelt let flad med en gaffel. Dryp med olie, og drys med salt. Bag dem i 10-12 minutter, til de er gyldne."
    },
    {
      "section": "Bøffer",
      "text": "Varm lidt olie op i en stor pande ved middelhøj varme. Steg bøfferne 3-4 minutter på hver side, til de er brunede. Giv dem 1-2 minutter mere på hver side, hvis de skal være gennemstegte."
    },
    {
      "section": "Bøffer",
      "text": "Pak bøfferne ind i folie, og lad dem hvile, mens du laver saucen."
    },
    {
      "section": "Sauce",
      "text": "Smelt smørret i den samme pande ved middellav varme. Svits løget i 2-3 minutter, og rør hvidløget i i det sidste halve minut."
    },
    {
      "section": "Sauce",
      "text": "Tilsæt brun sovs, rødvinssauce, timian, bouillon, vand og peber samt kødsaften fra folien. Lad det simre i 3-4 minutter."
    },
    {
      "section": "Salat og servering",
      "text": "Vend rucola og tomater med olie og salt i en skål."
    },
    {
      "section": "Salat og servering",
      "text": "Skær bøfferne i tynde skiver, og anret dem med kartoflerne og salaten. Hæld saucen over kødet, og drys fetaen over salaten."
    }
  ],
  "changes": [
    "Ostesnack er erstattet med feta, som kan smuldres over salaten."
  ]
