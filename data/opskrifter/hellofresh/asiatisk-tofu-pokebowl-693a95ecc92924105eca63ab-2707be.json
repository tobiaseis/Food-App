  "steps": [
    {
      "section": "Til risen",
      "text": "Pres hvidløget eller hak det fint. Varm olien op i en mellemstor gryde ved middel varme, og svits hvidløget i ca. 30 sekunder, til det dufter."
    },
    {
      "section": "Til risen",
      "text": "Hæld vandet i, og bring det i kog. Kom ris og salt i, læg låg på, og lad risen småkoge ved middellav varme i 12 minutter."
    },
    {
      "section": "Til risen",
      "text": "Tag gryden af varmen, og lad risen trække under låg i 10 minutter. Løft ikke låget undervejs."
    },
    {
      "section": "Til saucen",
      "text": "Mens risen koger, skæres citronen i både. Rør sojasauce, mel, vand, honning-ingefærdressing og sukker sammen i en lille skål, og pres en god sjat citronsaft i."
    },
    {
      "section": "Til bowlen",
      "text": "Skær agurken i skiver. Lav lange, tynde bånd af guleroden med skræller, og hak det stykke, der er til overs, fint."
    },
    {
      "section": "Til bowlen",
      "text": "Skræl mangoen, og skær kødet af på begge sider af stenen. Skær det i tern på 1 cm."
    },
    {
      "section": "Til bowlen",
      "text": "Drys tofuen med et nip salt. Varm olien til stegning op på en stor pande ved middelhøj varme, og steg tofuen gylden i 3-4 minutter."
    },
    {
      "section": "Til bowlen",
      "text": "Tag panden af varmen, hæld saucen over tofuen, og vend rundt."
    },
    {
      "section": "Til servering",
      "text": "Fordel risen i dybe tallerkener, og læg tofu, gulerod, agurk og mango ovenpå. Dryp med ponzudressing."
    },
    {
      "section": "Til servering",
      "text": "Strø peanuts og mynte over. Server med srirachamayonnaise og de resterende citronbåde ved siden af."
    }
  ],
  "changes": [
    "Citrusfrugt er skiftet til citron."
  ]
