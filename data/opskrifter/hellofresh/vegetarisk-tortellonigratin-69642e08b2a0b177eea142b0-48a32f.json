  "steps": [
    {
      "section": "Forberedelse",
      "text": "Sæt ovnen på 240 °C (220 °C varmluft)."
    },
    {
      "section": "Forberedelse",
      "text": "Hak hvidløg, løg og basilikum, og skær tomater og peberfrugt i tern. Skyl rucola."
    },
    {
      "section": "Forberedelse",
      "text": "Rør panko, parmesan, solsikkekerner, olie, salt og peber sammen i en lille skål."
    },
    {
      "section": "Sauce og pasta",
      "text": "Varm olie op i en stor stegepande, der tåler ovn, ved middelhøj varme. Svits tomatpuré, hvidløg og løg i 30 sekunder."
    },
    {
      "section": "Sauce og pasta",
      "text": "Kom tomat, peberfrugt, basilikum, salt og peber i panden, og lad det simre 1-2 minutter."
    },
    {
      "section": "Sauce og pasta",
      "text": "Skru ned til middel varme. Hæld fløde, bouillon og vand i, og lad saucen småkoge 2-3 minutter. Smag til med salt og peber."
    },
    {
      "section": "Sauce og pasta",
      "text": "Vend tortelloni i saucen, og rør rundt i 1-2 minutter, til saucen er tyknet, og pastaen er al dente. Tilsæt lidt ekstra vand, hvis saucen bliver for tyk. Tåler panden ikke ovn, så hæld det i et ildfast fad."
    },
    {
      "section": "Gratinering",
      "text": "Fordel pankoblandingen over pastaen, og bag i ovnen i 5-7 minutter, til toppen er gylden og sprød."
    },
    {
      "section": "Servering",
      "text": "Vend rucola med balsamico i en skål, gerne med en smule olivenolie."
    },
    {
      "section": "Servering",
      "text": "Anret gratinen i dybe tallerkener, og læg rucolaen ovenpå."
    }
  ],
  "changes": [
    "Parmigiano Reggiano er skiftet til parmesan.",
    "Tortelloni er beholdt under sit navn, da der ikke er en dansk afløser."
