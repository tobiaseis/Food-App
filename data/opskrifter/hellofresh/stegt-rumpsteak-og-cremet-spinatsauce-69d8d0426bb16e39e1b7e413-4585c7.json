  "steps": [
    {
      "section": "Kartofler og kød",
      "text": "Tænd ovnen på 240 °C (220 °C varmluft). Tag bøfferne ud af køleskabet, og drys dem med saltet til kødet."
    },
    {
      "section": "Kartofler og kød",
      "text": "Skær kartoflerne i tern på 2 cm uden at skrælle dem. Læg dem på en bageplade med bagepapir, og vend dem med en smule olie og saltet til kartoflerne. Brug to plader, hvis de ligger for tæt."
    },
    {
      "section": "Kartofler og kød",
      "text": "Bag kartoflerne i 25-35 minutter, til de er møre."
    },
    {
      "section": "Karamelliserede løg",
      "text": "Skær halvdelen af løgene i tynde halve skiver. Varm olien til løgene op i en stor pande på middel varme, og steg løgene i 5-6 minutter, til de er bløde."
    },
    {
      "section": "Karamelliserede løg",
      "text": "Hæld vand, sukker og salt på panden, og lad det småkoge i 3-5 minutter, til løgene er karamelliserede. Kom dem over i en lille skål."
    },
    {
      "section": "Salat og forberedelse",
      "text": "Hak de resterende løg fint, og pres eller hak hvidløget. Klip karsen af lige over rødderne, og skyl spinaten."
    },
    {
      "section": "Salat og forberedelse",
      "text": "Skær avocadoen over, og tag stenen ud. Skrab kødet ud med en ske, og skær det i tynde skiver. Hak romainesalaten groft, og vend den med avocado, olie og salt i en skål."
    },
    {
      "section": "Bøffer",
      "text": "Varm olien til stegning op i den store pande på middelhøj varme. Steg bøfferne 3-4 minutter på hver side, til de er brunede. Steg 1-2 minutter længere pr. side, hvis de skal være gennemstegte."
    },
    {
      "section": "Bøffer",
      "text": "Pak bøfferne ind i folie, og lad dem hvile, til du skal servere. Gem den safts, der samler sig."
    },
    {
      "section": "Spinatsauce",
      "text": "Sænk varmen til middel, og steg de hakkede løg i samme pande i 2-3 minutter, til de dufter. Kom hvidløg og spinat i, og steg 1-2 minutter, til spinaten er faldet sammen."
    },
    {
      "section": "Spinatsauce",
      "text": "Rør fløde, bouillon og saften fra folien i. Lad saucen småkoge i 1-2 minutter, til den er let tyknet, og smag den til med salt."
    },
    {
      "section": "Anretning",
      "text": "Vend de bagte kartofler med de karamelliserede løg. Skær bøfferne i tykke skiver."
    },
    {
      "section": "Anretning",
      "text": "Læg bøf, kartofler og spinatsauce på tallerkener, og drys med karse. Server med salaten."
    }
  ],
