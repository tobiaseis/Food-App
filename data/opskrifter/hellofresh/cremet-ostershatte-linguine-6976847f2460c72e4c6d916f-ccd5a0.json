  "steps": [
    {
      "section": "Pasta",
      "text": "Kog en stor gryde vand op og salt det kraftigt, så det smager som havvand. Kog linguinen i 8 minutter, til den er al dente, så den stadig har lidt bid."
    },
    {
      "section": "Pasta",
      "text": "Tag en kop af kogevandet fra, inden du hælder resten fra."
    },
    {
      "section": "Valnøddecrumble",
      "text": "Varm olien på en pande ved middelhøj varme, mens pastaen koger. Rist valnødder og panko i 3-4 minutter, til de er gyldne og sprøde. Smag til med salt og peber, og kom crumblen i en skål."
    },
    {
      "section": "Svampe",
      "text": "Gør løg, hvidløg, chili og svampe klar som beskrevet i ingredienslisten, og skyl spinaten."
    },
    {
      "section": "Svampe",
      "text": "Varm olien til stegning i samme pande ved middelhøj varme. Brun svampene i 3-4 minutter, og drys dem med salt og peber. Læg dem på en tallerken med køkkenrulle."
    },
    {
      "section": "Pasta og sauce",
      "text": "Sænk varmen til middel, og hæld olien til saucen på panden. Svits løg, hvidløg og chili i 1-2 minutter, til de er blødt."
    },
    {
      "section": "Pasta og sauce",
      "text": "Rør tomatpuré, creme fraiche, kogevand, krydderurter, bouillon og røget paprika i. Lad saucen simre i 3-4 minutter, til den er tyknet."
    },
    {
      "section": "Pasta og sauce",
      "text": "Vend pasta, svampe, parmesan og spinat i saucen, og peber efter smag."
    },
    {
      "section": "Pasta og sauce",
      "text": "Anret i dybe tallerkener, og drys valnøddecrumblen over."
    }
  ],
