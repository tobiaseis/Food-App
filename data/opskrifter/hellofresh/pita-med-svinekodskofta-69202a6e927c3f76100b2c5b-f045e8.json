  "steps": [
    {
      "section": "Regnbuefritter",
      "text": "Tænd ovnen på 240 °C (220 °C varmluft). Skær gulerødder, knoldselleri og rødbeder i fritter på ca. 1 cm uden at skrælle dem."
    },
    {
      "section": "Regnbuefritter",
      "text": "Læg grøntsagerne på en bageplade med bagepapir. Vend dem med olie, salt og peber. Brug to plader, hvis de ligger for tæt."
    },
    {
      "section": "Regnbuefritter",
      "text": "Bag i 25-35 minutter, til de er møre."
    },
    {
      "section": "Koftaer",
      "text": "Rør svinekød, æg, rasp, krydderi og salt sammen i en stor skål. Rul farsen til koftaer på ca. 8 cm, tre til hver person."
    },
    {
      "section": "Koftaer",
      "text": "Varm lidt olie på en stor pande ved middelhøj varme. Brun koftaerne i 2-3 minutter."
    },
    {
      "section": "Koftaer",
      "text": "Skru ned til middel varme, og steg koftaerne færdige i 6-7 minutter. Kødet skal være helt gennemstegt uden spor af rødt."
    },
    {
      "section": "Yoghurtdressing",
      "text": "Rør yoghurt, hvidløg, salt og peber sammen i en lille skål."
    },
    {
      "section": "Til servering",
      "text": "Skær bunden af salaten, og pluk bladene fra hinanden. Hak tomat og løg som beskrevet i ingredienslisten."
    },
    {
      "section": "Til servering",
      "text": "Hold pitabrødene et øjeblik under vandhanen. Læg dem på ovnristen, og varm dem i 3-4 minutter."
    },
    {
      "section": "Til servering",
      "text": "Anret fritterne på tallerkener. Stil pitabrød, koftaer, dressing og grøntsager på bordet, så alle kan fylde deres egen pita."
    }
  ],
