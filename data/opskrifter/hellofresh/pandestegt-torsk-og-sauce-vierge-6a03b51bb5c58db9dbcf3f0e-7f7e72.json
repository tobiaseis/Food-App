  "steps": [
    {
      "section": "Kartoffelmos",
      "text": "Kom kartoffelternene i en stor gryde med kogende saltet vand. Kog dem i 11-13 minutter, til en kniv let går igennem."
    },
    {
      "section": "Kartoffelmos",
      "text": "Hæld vandet fra. Tilsæt mælk, salt og peber, og mos kartoflerne med en kartoffelmoser eller gaffel. Læg låg på, og sæt gryden til side."
    },
    {
      "section": "Salat",
      "text": "Varm en stor stegepande op ved middelhøj varme, mens kartoflerne koger. Rist hasselnødderne i 3-4 minutter, til de er gyldne."
    },
    {
      "section": "Salat",
      "text": "Vend salaten med de ristede nødder, olie, salt og peber i en skål."
    },
    {
      "section": "Sauce vierge",
      "text": "Pres saften af citronen. Rør tomat, oliven, persille, vand, citronsaft, sukker, olie, salt og peber sammen i en lille skål."
    },
    {
      "section": "Fisk",
      "text": "Tør torsken med køkkenrulle. Krydr den med de tørrede krydderurter og salt."
    },
    {
      "section": "Fisk",
      "text": "Varm olien i en stor pande ved middelhøj varme, og steg fisken 2-3 minutter på hver side, til den er gylden og gennemstegt. Den er klar, når kødet er mælkehvidt og mat."
    },
    {
      "section": "Fisk",
      "text": "Hæld halvdelen af saucen på panden, og smag til med salt og peber. Varm igennem i 1 minut."
    },
    {
      "section": "Fisk",
      "text": "Anret fisk, mos og salat på tallerkener. Hæld resten af saucen over fisken."
    }
  ],
