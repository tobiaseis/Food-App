  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 220 °C (200 °C varmluft)."
    },
    {
      "section": null,
      "text": "Del kartoflerne i halve. Skær squashen i halve skiver på cirka 1 cm, og halver cherrytomaterne."
    },
    {
      "section": null,
      "text": "Rør madlavningsfløde, karrypasta, vand, ingefærpuré og salt til saucen sammen i en skål."
    },
    {
      "section": null,
      "text": "Hak koriander groft, og skær citronen over på midten."
    },
    {
      "section": null,
      "text": "Tør torsken med køkkenrulle, og gnid den ind i salt og Ginger Ninja."
    },
    {
      "section": null,
      "text": "Læg kartoflerne i et ildfast fad, og vend dem med olie, salt og peber. Bag dem i 10 min."
    },
    {
      "section": null,
      "text": "Kom squash og cherrytomater i fadet, vend rundt, og bag videre i 15-17 min, til kartoflerne er møre."
    },
    {
      "section": null,
      "text": "Hæld saucen over grøntsagerne, og vend dem i den. Læg torsken ovenpå, og bag i 10-12 min mere, til fisken er gennemstegt. Den er klar, når den er mælkehvid og mat."
    },
    {
      "section": null,
      "text": "Pres et godt stænk citronsaft over lige før servering, og drys med koriander. Sæt fadet direkte på bordet."
    }
  ],
