  "steps": [
    {
      "section": null,
      "text": "Sæt en stor gryde med rigeligt vand i kog, og smag til med salt, så det smager som havvand."
    },
    {
      "section": null,
      "text": "Skær løget i tynde skiver, og hak tomaterne groft. Hak persille og hvidløg fint, og skyl rucolaen."
    },
    {
      "section": null,
      "text": "Kog pastaen i 2-3 minutter, til den er al dente. Tag en kop af kogevandet fra, og si resten fra."
    },
    {
      "section": "Sauce",
      "text": "Varm en stor pande op over middelhøj varme med olie. Brun bacon og løg i 3-4 minutter."
    },
    {
      "section": "Sauce",
      "text": "Rør hvidløgget i, og steg i cirka 1 minut, til det dufter."
    },
    {
      "section": "Sauce",
      "text": "Hæld madlavningsfløde og pastavand i, og tilsæt paprika, bouillon, halvdelen af osten og lidt peber. Lad det simre ved middel varme i 3-4 minutter, til saucen er let tyknet."
    },
    {
      "section": "Salat",
      "text": "Vend rucola og tomat med olie, salt og peber i en skål."
    },
    {
      "section": "Anretning",
      "text": "Vend pasta og persille i saucen. Er den for tyk, så tilsæt et skvæt vand."
    },
    {
      "section": "Anretning",
      "text": "Fordel pastaen i dybe tallerkener, drys med resten af osten og solsikkekernerne, og server med salaten ved siden af."
    }
