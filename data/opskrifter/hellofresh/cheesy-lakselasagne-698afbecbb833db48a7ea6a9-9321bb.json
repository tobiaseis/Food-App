  "steps": [
    {
      "section": "Laks og svampe",
      "text": "Varm ovnen op til 220 °C (200 °C varmluft). Tør laksen med køkkenrulle og drys den med salt. Læg den med skindsiden nedad på en bageplade med bagepapir, og bag den i 9-10 minutter, til kødet er mat i midten."
    },
    {
      "section": "Laks og svampe",
      "text": "Hak løget fint og champignonerne groft, mens laksen bager."
    },
    {
      "section": "Laks og svampe",
      "text": "Varm lidt olie op i en stor pande ved middelhøj varme. Steg champignonerne med salt i 3-4 minutter, til de er brunede."
    },
    {
      "section": "Laks og svampe",
      "text": "Pil den bagte laks i mundrette stykker med to gafler. Vend den sammen med champignonerne i en stor skål."
    },
    {
      "section": "Bechamel",
      "text": "Skyl spinaten. Rør fløde, mælk og vand sammen i en skål."
    },
    {
      "section": "Bechamel",
      "text": "Smelt smørret i en gryde ved middel varme, og svits løget i 1-2 minutter, til det er blødt. Rør mel og bouillon i, og pisk i 1-2 minutter."
    },
    {
      "section": "Bechamel",
      "text": "Hæld mælkeblandingen i lidt ad gangen, mens du rører, og kog i 3-4 minutter, til saucen er tyknet. Pisk spinat, salt, parmesan og peber i, til spinaten er faldet sammen."
    },
    {
      "section": "Samling og bagning",
      "text": "Saml lasagnen, mens bechamelen stadig er varm og flydende. Kom først et lag bechamel i bunden af et ildfast fad, og læg lasagneplader over. Fordel noget af laksefyldet, og læg nye plader ovenpå."
    },
    {
      "section": "Samling og bagning",
      "text": "Gentag med bechamel, plader og fyld, og slut med et lag bechamel. Drys med cheddar. Til 3-4 personer skal du bruge et større fad."
    },
    {
      "section": "Samling og bagning",
      "text": "Dæk fadet med stanniol, og bag i 25-35 minutter. Tag folien af de sidste 10 minutter, så osten bliver gylden."
    },
    {
      "section": "Salat",
      "text": "Skyl salaten. Riv artiskokkerne i grove stykker. Vend salat, artiskokker, balsamico, olivenolie, solsikkekerner og salt i en stor skål."
    },
    {
      "section": "Salat",
      "text": "Sæt lasagnen på bordet og server den med salaten."
    }
  ],
