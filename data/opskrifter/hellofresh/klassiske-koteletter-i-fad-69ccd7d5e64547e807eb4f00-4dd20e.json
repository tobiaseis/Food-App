  "steps": [
    {
      "section": "Ris",
      "text": "Tænd ovnen på 180 °C almindelig ovn eller 160 °C varmluft."
    },
    {
      "section": "Ris",
      "text": "Kog vandet op i en gryde. Kom ris og salt i, læg låg på, og lad dem koge ved middellav varme i 14 minutter."
    },
    {
      "section": "Ris",
      "text": "Træk gryden af varmen, og lad risene stå med låg på i 10 minutter. Løft ikke låget undervejs."
    },
    {
      "section": "Kød og sauce",
      "text": "Skær løget i tynde halve skiver, og hak champignonerne groft. Brug et separat skærebræt til svinekødet, og skær det i skiver – én til hver person."
    },
    {
      "section": "Kød og sauce",
      "text": "Varm olien i en stor stegepande ved middelhøj varme. Krydr kødet med salt og røget paprika, og brun det 1-2 minutter på hver side, til det er gennemstegt. Læg det i et ildfast fad."
    },
    {
      "section": "Kød og sauce",
      "text": "Hæld lidt mere olie i samme pande, og steg løg og champignon ved middelhøj varme i 3-4 minutter, til de er brune."
    },
    {
      "section": "Kød og sauce",
      "text": "Skru ned til middel varme. Rør fløde, tomater, vand, smør, salt, sukker og peber i, og lad saucen simre i 4-5 minutter."
    },
    {
      "section": "Bagning",
      "text": "Fordel saucen over kødet i fadet, og bag det i ovnen i 10-12 minutter. Kødet er færdigt, når der ikke er rosa tilbage."
    },
    {
      "section": "Bagning",
      "text": "Server svinekød og sauce sammen med risene."
    }
  ],
