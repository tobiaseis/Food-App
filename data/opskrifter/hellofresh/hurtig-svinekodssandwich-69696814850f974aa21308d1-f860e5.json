  "steps": [
    {
      "section": "Brød",
      "text": "Tænd ovnen på 220 °C (200 °C varmluft). Skær baguetterne over på langs."
    },
    {
      "section": "Brød",
      "text": "Pres eller hak hvidløget, og rør det sammen med olie og salt til hvidløgsolie."
    },
    {
      "section": "Brød",
      "text": "Læg baguetterne på en bageplade med bagepapir, og pensl dem let med hvidløgsolien. Bag dem i 6-8 minutter, til de er sprøde og gyldne."
    },
    {
      "section": "Svinekød",
      "text": "Varm lidt olie op i en stor pande ved middelhøj varme. Steg koteletterne med et nip salt i 3-4 minutter på hver side, til de er gyldne og helt gennemstegte uden rødt kød."
    },
    {
      "section": "Kålsalat",
      "text": "Del citronen i to. Skær agurken i skiver, og hak persillen fint."
    },
    {
      "section": "Kålsalat",
      "text": "Vend kål, persille, agurk, olie, et skvæt citronsaft, salt og peber sammen i en stor skål."
    },
    {
      "section": "Cajundressing",
      "text": "Rør yoghurt og cajun-krydderi sammen i en lille skål."
    },
    {
      "section": "Samling",
      "text": "Smør dressingen på baguetterne, og læg kød og noget af kålsalaten ovenpå. Server resten af kålsalaten ved siden af."
    }
  ],
