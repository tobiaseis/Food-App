  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 220°C (200°C varmluft)."
    },
    {
      "section": "Squash",
      "text": "Del squashen på langs, og skær kødet ud med en ske. Gem det til bulguren. Læg squashbådene med snitfladen nedad på en bageplade med bagepapir, dryp med olie, og drys med salt og peber. Bag dem i 8-10 minutter."
    },
    {
      "section": "Fyld",
      "text": "Pres saften fra den halve citron i en skål. Rør ricotta og halvdelen af halloumien sammen med et godt skvæt af saften. Del citronen først i to."
    },
    {
      "section": "Tomatbulgur",
      "text": "Hak det udskårne squashkød groft. Rør det sammen med bulgur, vand, bouillon, hakkede tomater, za'atar, sukker, salt og olie i en stor skål."
    },
    {
      "section": "Tahiniyoghurt",
      "text": "Pisk tahin, yoghurt, honning, salt og peber sammen i en lille skål."
    },
    {
      "section": "Samling",
      "text": "Fyld de forbagte squashbåde med ricottablandingen. Hæld tomatbulguren i et ildfast fad, og læg de fyldte både ovenpå. Sæt fadet i ovnen i 20-25 minutter."
    },
    {
      "section": "Samling",
      "text": "Når der er 10 minutter tilbage, strøs resten af halloumien og solsikkekernerne over. Bag retten færdig."
    },
    {
      "section": "Servering",
      "text": "Sæt fadet på bordet, og server tahiniyoghurten ved siden af."
    }
  ],
