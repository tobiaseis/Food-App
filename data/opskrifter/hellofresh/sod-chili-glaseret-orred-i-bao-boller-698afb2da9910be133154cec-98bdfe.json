  "steps": [
    {
      "section": "Syltede løg",
      "text": "Hvis bollerne skal dampes, så sæt en mellemstor gryde med vand over varmen og bring det i kog."
    },
    {
      "section": "Syltede løg",
      "text": "Skær løget i tynde halve ringe. Pres saften fra citronen i en lille skål, og rør sukker, vand og salt i. Vend løgene i lagen, og lad dem stå, til maden skal på bordet. Si lagen fra til sidst."
    },
    {
      "section": "Salat",
      "text": "Hak pak choi groft. Skær enderne af sukkerærterne, og del dem på langs. Lav lange bånd af gulerodden med en skræller, og hak resten fint."
    },
    {
      "section": "Salat",
      "text": "Læg grøntsagerne i en skål. Vend dem med olie og salt lige før servering."
    },
    {
      "section": "Fisk",
      "text": "Varm olien i en stor stegepande ved middelhøj varme. Tør ørreden med køkkenrulle, og drys den med salt."
    },
    {
      "section": "Fisk",
      "text": "Steg fisken på skindsiden i 3-4 minutter. Vend den, og steg 3-5 minutter mere, til den er gylden og helt gennemstegt. Kødet skal være mat og mælkehvidt. Tag fisken op på en tallerken, og træk skindet af."
    },
    {
      "section": "Fisk",
      "text": "Sæt stegepanden på middelvarme igen. Hæld vand, sojasauce, sød chilisauce og chiliflager i, og lad det simre i 1-2 minutter, til saucen er lidt tykkere. Brug mindre chili eller drop den, hvis den skal være mild."
    },
    {
      "section": "Fisk",
      "text": "Tag panden af varmen. Læg fisken i, del den i flager med en paletkniv, og vend den rundt i saucen."
    },
    {
      "section": "Til servering",
      "text": "Rør Hello Sunrise ud i mayonnaisen."
    },
    {
      "section": "Til servering",
      "text": "Klip et lille hul i hver side af pakken med boller, og varm dem 40 sekunder i mikrobølgeovnen. Ellers kan de dampes under låg i en si over den kogende gryde i 3-5 minutter. Varm dem lige før servering, så de bliver bløde."
    },
    {
      "section": "Til servering",
      "text": "Fyld bollerne med salat, fisk og syltede løg, og server dem med mayonnaisen ved siden af."
    }
  ],
  "changes": [
    "Citrusfrugt er skiftet til citron."
  ]
}
