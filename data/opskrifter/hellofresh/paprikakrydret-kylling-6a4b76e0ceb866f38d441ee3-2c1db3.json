  "steps": [
    {
      "section": null,
      "text": "Kog kartoflerne i en mellemstor gryde med letsaltet vand i 12-15 minutter, til en kniv let går igennem. Si vandet fra, smag til med salt og peber, og læg låg på gryden."
    },
    {
      "section": null,
      "text": "Gnid kyllingebrystet med salt og paprika."
    },
    {
      "section": null,
      "text": "Varm lidt olie på en stor pande ved middelhøj varme. Brun kyllingen 2-3 minutter på hver side."
    },
    {
      "section": null,
      "text": "Skru ned til middel varme, og steg kyllingen 3-4 minutter mere på hver side. Den er færdig, når kødet er hvidt hele vejen igennem."
    },
    {
      "section": "Gremolata",
      "text": "Hak persillen fint, og hak eller pres hvidløget. Del citronen i to."
    },
    {
      "section": "Gremolata",
      "text": "Rør persille, hvidløg, chiliflager, saft fra halvdelen af citronen, olie, sukker, salt og peber sammen i en lille skål. Brug mindre chili eller drop den, hvis du ikke bryder dig om stærk mad."
    },
    {
      "section": "Salat",
      "text": "Skær radiserne i kvarte. Skræl glaskålen, og skær den i tynde stave. Skyl salatblandingen."
    },
    {
      "section": "Salat",
      "text": "Vend salat, rødkål, radiser, glaskål, olie, salt og peber sammen i en stor skål."
    },
    {
      "section": "Dressing og anretning",
      "text": "Vend gremolataen med de kogte kartofler i gryden."
    },
    {
      "section": "Dressing og anretning",
      "text": "Rør creme fraiche med et skvæt citronsaft, salt og peber til dressingen."
    },
    {
      "section": "Dressing og anretning",
      "text": "Skær kyllingen i skiver. Anret den med kartofler og salat på tallerkener, og skænk dressingen over."
    }
