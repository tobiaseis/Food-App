  "steps": [
    {
      "section": "Ris",
      "text": "Kom vand, ris og salt i en mellemstor gryde, og bring det i kog. Læg låg på, og lad risen koge ved middellav varme i 14 minutter."
    },
    {
      "section": "Ris",
      "text": "Tag gryden af varmen, og lad risen trække under låg i 10 minutter. Løft ikke låget undervejs."
    },
    {
      "section": "Bønnegryde",
      "text": "Varm olien op i en stor stegepande ved middelhøj varme. Rist krydderurterne og krydderiblandingen i ca. 30 sekunder, til de dufter."
    },
    {
      "section": "Bønnegryde",
      "text": "Rør hakkede tomater, bouillon, sukker og salt i panden. Lad det simre ved middel varme i 5-6 minutter."
    },
    {
      "section": "Gremolata",
      "text": "Mens saucen simrer: Bland persille, parmesan, olie, solsikkekerner, salt og peber i en skål."
    },
    {
      "section": "Bønnegryde",
      "text": "Hæld væsken fra bønnerne. Tilsæt vand, fløde, peberfrugt og bønner i panden, og lad det simre i 2-3 minutter."
    },
    {
      "section": "Bønnegryde",
      "text": "Skyl spinaten, og vend den i gryden med den færdige ris."
    },
    {
      "section": "Servering",
      "text": "Fordel risen i dybe tallerkener, og hæld bønnegryden over. Top med gremolata og smuldret feta."
    }
  ],
