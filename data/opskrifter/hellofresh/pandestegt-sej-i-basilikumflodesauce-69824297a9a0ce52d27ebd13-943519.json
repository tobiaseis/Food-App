  "steps": [
    {
      "section": "Kartofler",
      "text": "Kom kartoflerne i en gryde med letsaltet kogende vand, og kog dem i 12-15 minutter, til en kniv let glider igennem. Hæld vandet fra."
    },
    {
      "section": "Kartofler",
      "text": "Vend kartoflerne med smør, salt og peber, og lad dem stå under låg."
    },
    {
      "section": "Kålsalat",
      "text": "Halver appelsinen, og pres saften ned i en skål. Rør den sammen med olivenolie, salt og peber."
    },
    {
      "section": "Kålsalat",
      "text": "Skær bunden af salathovedet, og pil bladene fra hinanden. Hak dem groft, og vend dem med kålen i dressingen. Stil skålen til side."
    },
    {
      "section": "Fisk og sauce",
      "text": "Hak persillen fint. Tør sejen med køkkenrulle, og drys den med salt."
    },
    {
      "section": "Fisk og sauce",
      "text": "Varm smørret på en stor pande ved middelhøj varme, og steg fisken 2-3 minutter på første side."
    },
    {
      "section": "Fisk og sauce",
      "text": "Vend fisken, og hæld fløde, persille, bouillon, vand, salt og peber på panden. Lad det simre 2-3 minutter, til fisken er gennemstegt, og saucen er lidt tykkere. Fisken er færdig, når kødet er mælkehvidt og mat."
    },
    {
      "section": "Servering",
      "text": "Læg kartofler, fisk og salat på tallerkener. Hæld saucen over fisken, og strø græskarkerner ovenpå."
    }
  ],
  "changes": [
