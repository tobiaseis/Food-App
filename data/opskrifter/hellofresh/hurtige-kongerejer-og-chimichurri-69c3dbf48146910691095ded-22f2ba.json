  "steps": [
    {
      "section": "Ris",
      "text": "Kom vandet i en gryde og bring det i kog. Rør risene og saltet i, læg låg på, og lad dem simre ved middel-lav varme i 10 min."
    },
    {
      "section": "Ris",
      "text": "Tag gryden af varmen, og lad risene trække under låg i 10 min. Løft ikke låget undervejs."
    },
    {
      "section": "Rejer og grøntsager",
      "text": "Mens risene koger, skæres squash, peberfrugt og løg som beskrevet i ingredienslisten."
    },
    {
      "section": "Rejer og grøntsager",
      "text": "Varm lidt olivenolie op i en stor pande ved middelhøj varme. Steg grøntsagerne i 4-5 min, til de er lidt bløde."
    },
    {
      "section": "Rejer og grøntsager",
      "text": "Kom rejerne på panden sammen med krydderurterne, saltet og peberen. Steg i 2-3 min, til rejerne er gyldne og helt hvide og matte indeni."
    },
    {
      "section": "Chimichurri",
      "text": "Rør persille, hvidløg, chiliflager, krydderurter, eddike, olivenolie, salt og peber sammen i en lille skål."
    },
    {
      "section": "Chimichurri",
      "text": "Læg ris, rejer og grøntsager på tallerkener, og hæld chimichurrien ovenpå."
    }
  ],
