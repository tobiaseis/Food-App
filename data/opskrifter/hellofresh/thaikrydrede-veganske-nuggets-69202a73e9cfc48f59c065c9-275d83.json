  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 240 °C (220 °C varmluft)."
    },
    {
      "section": "Ris",
      "text": "Bring vandet i kog i en gryde. Kom ris og salt i, læg låg på, og lad risene simre på middellav varme i 14 minutter."
    },
    {
      "section": "Ris",
      "text": "Træk gryden fra varmen, og lad risene stå under låg i 10 minutter. Løft ikke låget undervejs."
    },
    {
      "section": "Nuggets og pak choi",
      "text": "Vend nuggets med olie og karrypasta i en stor skål. Del pak choi i kvarte."
    },
    {
      "section": "Nuggets og pak choi",
      "text": "Læg nuggets og pak choi på en bageplade med bagepapir. Drys pak choi med salt, og dryp lidt olie over."
    },
    {
      "section": "Nuggets og pak choi",
      "text": "Bag i 12 minutter, til nuggets er gyldne og sprøde, og pak choi er mør."
    },
    {
      "section": "Mangosalat",
      "text": "Hak agurken groft, og del citronen i to."
    },
    {
      "section": "Mangosalat",
      "text": "Skræl mango. Skær frugtkødet af stenen i to store stykker, og del dem i tern på ca. 1 cm."
    },
    {
      "section": "Mangosalat",
      "text": "Vend mango med ingefær, agurk, en sjat citronsaft, chiliflager og salt i en stor skål. Brug mindre chili eller spring den over, hvis maden ikke skal være stærk."
    },
    {
      "section": "Servering",
      "text": "Fordel ris, mangosalat og pak choi i dybe tallerkener. Læg nuggets på risene, og top med mayonnaise og sesamfrø."
    }
  ],
