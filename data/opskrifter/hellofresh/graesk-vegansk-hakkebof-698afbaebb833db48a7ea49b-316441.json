  "steps": [
    {
      "section": "Kartofler",
      "text": "Tænd ovnen på 240 °C (220 °C varmluft). Skær kartoflerne over på midten, og læg dem på en bageplade med bagepapir."
    },
    {
      "section": "Kartofler",
      "text": "Hæld lidt olie over, og drys med oregano, salt og peber. Vend kartoflerne rundt, og bag dem i 25-35 minutter, til de er møre."
    },
    {
      "section": "Tomatsalat",
      "text": "Hak løget fint, og skær tomaterne i tern på cirka 2 cm. Rør dem sammen med olie, balsamico, salt og peber i en lille skål."
    },
    {
      "section": "Bøffer",
      "text": "Varm lidt olie op i en stor pande ved middelhøj varme. Steg bøfferne 2-3 minutter på hver side, til de er gyldne. Krydr med salt."
    },
    {
      "section": "Tzatziki",
      "text": "Riv hvidløget fint, og riv agurken groft. Pres vandet fra agurken så grundigt som muligt."
    },
    {
      "section": "Tzatziki",
      "text": "Rør agurk, hvidløg og yoghurt sammen, og smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Anret bøffer, kartofler, tomatsalat og tzatziki på tallerkener."
    }
  ],
