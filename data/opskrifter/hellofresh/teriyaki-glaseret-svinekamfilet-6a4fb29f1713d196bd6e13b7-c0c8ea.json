  "steps": [
    {
      "section": "Kød",
      "text": "Sæt en gryde med vand over varmen, og kom salt i, så vandet smager som havvand. Lad det koge."
    },
    {
      "section": "Kød",
      "text": "Skær svinekammen i 2 skiver, én til hver person. Varm en smule olie i en stor pande på høj varme."
    },
    {
      "section": "Kød",
      "text": "Krydr kødet med salt, og steg det 1-2 minutter på hver side, til det er gyldent og helt gennemstegt uden spor af rødt."
    },
    {
      "section": "Kød",
      "text": "Skær kødet i tynde skiver, og vend dem rundt i teriyakisaucen i en mellemstor skål."
    },
    {
      "section": "Nudelsalat",
      "text": "Mens kødet steges: Skær roden af salaten, og hak den groft. Skær agurken i tynde stave."
    },
    {
      "section": "Nudelsalat",
      "text": "Pluk mynteblade af, og riv dem i grove stykker. Del citronen på midten."
    },
    {
      "section": "Nudelsalat",
      "text": "Kog nudlerne i 1 minut, til de er varme. Si dem fra, og skyl dem i koldt vand."
    },
    {
      "section": "Dressing",
      "text": "Rør sesamolie, ingefærpasta, mynte, et skvæt citronsaft, olie, salt og peber sammen i en stor skål."
    },
    {
      "section": "Nudelsalat",
      "text": "Vend nudler, kål, salat og agurk i dressingen."
    },
    {
      "section": "Til servering",
      "text": "Fordel nudelsalaten i to skåle, læg svinekødet ovenpå, og dryp med sriracha."
    }
  ],
