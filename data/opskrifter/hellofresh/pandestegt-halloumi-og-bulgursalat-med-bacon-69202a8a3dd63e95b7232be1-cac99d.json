  "steps": [
    {
      "section": "Bulgur",
      "text": "Kog vandet op i en mellemstor gryde. Kom bulgur, bouillon og salt i, læg låg på, og lad det simre ved middellav varme i 9-10 minutter, til bulguren er al dente."
    },
    {
      "section": "Bulgur",
      "text": "Hæld bulguren i en stor skål, og rør olien i."
    },
    {
      "section": "Dilddressing",
      "text": "Rist græskarkernerne på en tør, stor pande ved middelhøj varme i 2-3 minutter, til de begynder at poppe. Tag dem af panden."
    },
    {
      "section": "Dilddressing",
      "text": "Hak dilden groft, og rør den sammen med yoghurt, salt og peber."
    },
    {
      "section": "Halloumi og bacon",
      "text": "Skær halloumien i skiver, to til hver person, og drys dem med krydderiet."
    },
    {
      "section": "Halloumi og bacon",
      "text": "Varm olien på en stor pande ved middelhøj varme. Steg halloumien 2-3 minutter på hver side, til den er gylden. Tag den af panden."
    },
    {
      "section": "Halloumi og bacon",
      "text": "Steg baconen på samme pande i 4-5 minutter, til den er gylden."
    },
    {
      "section": "Glaserede grøntsager",
      "text": "Varm olien på en mellemstor pande ved middelhøj varme. Steg rødbeder og rødkål i 3-4 minutter, til de er møre."
    },
    {
      "section": "Glaserede grøntsager",
      "text": "Tilsæt balsamico og salt, og steg i 1 minut mere, til grøntsagerne er glaserede. Kom dem over i en skål."
    },
    {
      "section": "Til salaten",
      "text": "Skræl guldroden i lange, tynde bånd, og hak resten fint. Skyl salaten."
    },
    {
      "section": "Til salaten",
      "text": "Vend salat og bacon i skålen med bulgur."
    },
    {
      "section": "Til salaten",
      "text": "Fordel bulgursalaten i to skåle, og læg rødbeder, rødkål og gulerod ovenpå. Top med halloumi og græskarkerner, og dryp med dilddressingen."
    }
  ],
