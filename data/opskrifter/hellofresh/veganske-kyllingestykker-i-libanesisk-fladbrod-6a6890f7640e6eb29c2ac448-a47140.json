  "steps": [
    {
      "section": null,
      "text": "Hak persillen fint, og skær agurk og tomat i grove stykker. Skræl appelsinen, så al den hvide hinde fjernes, og skær kødet i tern på 1 cm."
    },
    {
      "section": null,
      "text": "Vend persille, tomat, agurk og appelsin sammen i en skål med salt, olie og et nip peber. Sæt salaten til side."
    },
    {
      "section": null,
      "text": "Skær løget i tynde skiver."
    },
    {
      "section": null,
      "text": "Varm lidt olie på en stor pande ved middelhøj varme. Steg kyllingestykker og løg med salt, ras el hanout og et nip peber, til det er pænt brunet, i 3-4 minutter."
    },
    {
      "section": null,
      "text": "Rør imens halvdelen af za'atar sammen med smør og olie. Smelt blandingen i mikrobølgeovnen i 30 sekunder eller i en lille gryde."
    },
    {
      "section": null,
      "text": "Pensl den ene side af fladbrødene med za'atarsmørret lige før servering."
    },
    {
      "section": null,
      "text": "Fyld fladbrødene med kyllingestykker, løg og lidt af appelsinsalaten. Top med yoghurt, og server resten af salaten ved siden af."
    }
  ],
