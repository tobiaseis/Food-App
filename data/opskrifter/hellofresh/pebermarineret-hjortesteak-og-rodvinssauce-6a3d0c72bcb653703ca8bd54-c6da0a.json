  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 220°C (200°C varmluft). Tag hjortesteakene op af køleskabet, og drys dem med salt."
    },
    {
      "section": "Mos",
      "text": "Bring en mellemstor gryde med saltet vand i kog. Skræl kartoflerne, og skær dem i tern på 2 cm."
    },
    {
      "section": "Mos",
      "text": "Kog kartoflerne i 11-13 minutter, til en kniv let går igennem dem. Si vandet fra, og tilsæt mælk, salt og peber. Mos med kartoffelmoser eller gaffel, og læg låg på."
    },
    {
      "section": "Mos",
      "text": "Tip: En klat smør i mosen gør den cremet."
    },
    {
      "section": "Tomater",
      "text": "Del cherrytomaterne i halve, og læg dem i et ildfast fad. Vend dem med balsamico, olivenolie, sukker, salt og peber. Sæt fadet øverst i ovnen i 15 minutter."
    },
    {
      "section": "Steaks",
      "text": "Varm lidt olivenolie op i en stor pande ved middelhøj varme. Brun steakene i 5-6 minutter på hver side."
    },
    {
      "section": "Steaks",
      "text": "Pak steakene ind i folie, og lad dem hvile, til maden skal på bordet. Tip: Steg 1-2 minutter længere for gennemstegt kød."
    },
    {
      "section": "Sauce",
      "text": "Hak rosmarin og hvidløg fint. Sæt den brugte pande på middel varme, og smelt smørret i den."
    },
    {
      "section": "Sauce",
      "text": "Kom hvidløg, rosmarin, rødvinssauce, vand, salt og peber i panden. Lad saucen simre i 2-3 minutter."
    },
    {
      "section": "Salat",
      "text": "Skyl salaten. Hak persillen groft, og vend den i kartoffelmosen."
    },
    {
      "section": "Salat",
      "text": "Lad mozzarellaen dryppe af, tør den med køkkenrulle, og skær den i tern på 2 cm."
    },
    {
      "section": "Salat",
      "text": "Tag tomaterne ud af ovnen, og lad dem køle lidt af. Vend dem med salaten i en skål, og krydr med salt og peber. Tilsæt evt. lidt olivenolie."
    },
    {
      "section": "Servering",
      "text": "Skær steakene i tykke skiver. Anret mos, kød og salat på tallerkener."
    },
    {
      "section": "Servering",
      "text": "Hæld rødvinssauce over kødet, og top salaten med mozzarella og græskarkerner."
    }
  ],
