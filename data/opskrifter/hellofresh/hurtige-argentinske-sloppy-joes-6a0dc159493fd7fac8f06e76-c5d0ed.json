  "steps": [
    {
      "section": null,
      "text": "Sæt ovnen på 220 °C (200 °C varmluft). Hak løget fint."
    },
    {
      "section": "Kødet",
      "text": "Varm olien i en stor pande på middelhøj varme. Brun kød og løg i 4-5 minutter sammen med salt og peber."
    },
    {
      "section": "Kødet",
      "text": "Rør churrascosauce, smør, worcestershiresauce og vand i panden. Lad det simre 1-2 minutter, til saucen har sat sig let. Kødet skal være gennemstegt uden rosa eller rødt."
    },
    {
      "section": "Chimichurri og salat",
      "text": "Pluk persillebladene, og skær citronen i både. Pres lidt saft fra citronen over persillen i en lille skål, og rør chiliflagerne i. Brug færre flager eller drop dem, hvis det skal være mildt."
    },
    {
      "section": "Chimichurri og salat",
      "text": "Skyl salaten, og hak tomaterne groft. Lav lange bånd af guleroden med en skræller, og hak resten fint."
    },
    {
      "section": "Chimichurri og salat",
      "text": "Vend salat, tomat og gulerod med olie, salt og peber i en skål."
    },
    {
      "section": "Boller og anretning",
      "text": "Skær bollerne over, og læg dem direkte på ovnristen i 3-4 minutter."
    },
    {
      "section": "Boller og anretning",
      "text": "Fordel kødet i bollerne, og top med chimichurri. Server med salaten."
    }
