  "steps": [
    {
      "section": "Ris",
      "text": "Kom vand i en gryde og bring det i kog. Tilsæt ris og salt, læg låg på, og lad risen koge ved middellav varme i 10 minutter."
    },
    {
      "section": "Ris",
      "text": "Tag gryden af varmen, og lad risen trække under låg i 10 minutter. Løft ikke låget undervejs."
    },
    {
      "section": "Kikærtegryde",
      "text": "Skyl kikærterne i en si. Smelt smørret i en mellemstor stegepande ved middelhøj varme."
    },
    {
      "section": "Kikærtegryde",
      "text": "Rist kikærter, souvlaki-krydderi og chiliflager i ca. 30 sekunder, til det dufter. Brug mindre chili eller drop den, hvis I ikke vil have det stærkt."
    },
    {
      "section": "Kikærtegryde",
      "text": "Hæld hakkede tomater, sukker og salt på panden. Lad det simre i 5-6 minutter, til saucen er tyknet lidt."
    },
    {
      "section": "Salat",
      "text": "Skær tomat og agurk i grove stykker, og vend dem i en stor skål med olie og salt."
    },
    {
      "section": "Ris",
      "text": "Skyl spinaten, og pluk den sammen med dilden i grove stykker. Vend begge dele i risen lige før servering."
    },
    {
      "section": "Til servering",
      "text": "Fordel ris, salat og kikærter i dybe tallerkener. Smuldr fetaen ovenpå."
    }
  ],
