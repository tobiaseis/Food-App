  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 240 °C (220 °C varmluft). Skær sødkartoffel og squash i tern på 2 cm."
    },
    {
      "section": "Tzatziki og sauce",
      "text": "Pres hvidløget eller riv det fint. Riv agurken groft, og klem så meget væde ud af den som muligt."
    },
    {
      "section": "Tzatziki og sauce",
      "text": "Rør agurk, hvidløg, yoghurt, salt og en smule peber sammen i en skål. Stil den kold."
    },
    {
      "section": "Tzatziki og sauce",
      "text": "Rør chutneyen ud med vandet i en lille skål."
    },
    {
      "section": "Bagning",
      "text": "Vend falafel i olien beregnet til dem i en skål. Vend squash i en anden skål med olie, halvdelen af krydderiblandingen og en smule salt."
    },
    {
      "section": "Bagning",
      "text": "Læg sødkartoffel og blomkål på en plade med bagepapir. Hæld lidt olie over, drys med salt og resten af krydderiblandingen, og vend rundt."
    },
    {
      "section": "Bagning",
      "text": "Sæt pladen i ovnen i 20-25 minutter. Når der er 10-12 minutter tilbage, lægger du falafel og squash på pladen."
    },
    {
      "section": "Bagning",
      "text": "Bag videre, til falaflerne er gyldne, og grøntsagerne er møre."
    },
    {
      "section": "Servering",
      "text": "Sæt pladen på bordet, og top med tzatziki og chutneysauce."
    }
