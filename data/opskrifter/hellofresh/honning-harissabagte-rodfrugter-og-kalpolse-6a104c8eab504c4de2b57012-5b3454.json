  "steps": [
    {
      "section": "Rodfrugter",
      "text": "Tænd ovnen på 240 °C (220 °C varmluft). Skræl knoldselleriet."
    },
    {
      "section": "Rodfrugter",
      "text": "Skær gulerødder og knoldselleri i stave på ca. 1 cm. Del løgene i både på ca. 2 cm."
    },
    {
      "section": "Rodfrugter",
      "text": "Læg grøntsagerne på en bageplade med bagepapir. Hæld lidt olivenolie og honning over, drys med harissa, salt og peber, og vend det hele rundt."
    },
    {
      "section": "Rodfrugter",
      "text": "Bag i 25-35 minutter, til rodfrugterne er møre. Brug to plader, hvis der ikke er plads på én."
    },
    {
      "section": "Kartofler og pølser",
      "text": "Læg kartoflerne på den ene halvdel af en bageplade med bagepapir, og tryk dem flade med bunden af et glas. Dryp med lidt olivenolie, og drys med salt og peber."
    },
    {
      "section": "Kartofler og pølser",
      "text": "Sæt kartoflerne i ovnen i 20-25 minutter. Læg ostepølserne på pladens anden halvdel, når der er 15 minutter tilbage, og bag dem færdige, til de er gyldne og gennemvarme."
    },
    {
      "section": "Thousand island-dressing",
      "text": "Rør yoghurt, mayonnaise, ketchup, worcestershiresauce og salt sammen i en lille skål, mens maden bager."
    },
    {
      "section": "Anretning",
      "text": "Smuldr fetaen over rodfrugter og pølser, så snart de er ude af ovnen."
    },
    {
      "section": "Anretning",
      "text": "Fordel pølser, kartofler og rodfrugter på tallerkener, og skee dressingen ovenpå."
    }
  ],
