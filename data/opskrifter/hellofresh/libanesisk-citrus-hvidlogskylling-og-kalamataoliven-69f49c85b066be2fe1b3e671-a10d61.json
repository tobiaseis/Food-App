  "steps": [
    {
      "section": "Pinjekerneris",
      "text": "Kom vand i en gryde og bring det i kog. Tilsæt ris og salt, læg låg på og lad det småkoge på middellav varme i 10 minutter."
    },
    {
      "section": "Pinjekerneris",
      "text": "Tag gryden af varmen og lad risene trække under låg i 10 minutter. Løft ikke låget undervejs."
    },
    {
      "section": "Tahinidressing",
      "text": "Rør yoghurt, tahin, honning, salt og peber sammen i en lille skål."
    },
    {
      "section": "Pinjekerneris",
      "text": "Varm en stor pande op på middelhøj varme, og rist pinjekernerne i 2-3 minutter, til de er gyldne. Kom dem i en skål."
    },
    {
      "section": "Salat",
      "text": "Hak romainesalat og agurk groft. Vend dem i en stor skål med tranebær, olie, salt og peber."
    },
    {
      "section": "Kylling",
      "text": "Læg kyllingebrystet mellem to stykker bagepapir og bank det ud til en tykkelse på ca. 2 cm med en kødhammer eller en kagerulle."
    },
    {
      "section": "Kylling",
      "text": "Skær citronen i skiver, og klargør hvidløg, oliven og persille som angivet i ingredienslisten."
    },
    {
      "section": "Kylling",
      "text": "Varm olien op i den store pande på middelhøj varme. Krydr kyllingen med harissa, salt og peber, og brun den i 2 minutter på hver side."
    },
    {
      "section": "Kylling",
      "text": "Skru ned til middel varme, og steg kyllingen 2-3 minutter mere på hver side, til den er gennemstegt og helt hvid indeni."
    },
    {
      "section": "Kylling",
      "text": "Kom hvidløg, oliven, vand, smør samt salt og peber i panden, og læg 2 citronskiver på hvert stykke kylling. Lad det simre i 1-2 minutter, til saucen er reduceret lidt."
    },
    {
      "section": "Pinjekerneris",
      "text": "Vend i mellemtiden ristede løg og halvdelen af pinjekernerne i den kogte ris."
    },
    {
      "section": "Til servering",
      "text": "Pres risen let sammen i en lille skål, og vend den ud på en tallerken, så den danner en kuppel. Gør det samme med resten af risen."
    },
    {
      "section": "Til servering",
      "text": "Anret salat og kylling ved siden af risen, og hæld pandesaucen over kyllingen. Server med tahinidressingen, og drys med persille og resten af pinjekernerne."
    }
  ],
