  "steps": [
    {
      "section": "Forberedelse",
      "text": "Tænd ovnen på 220 °C (200 °C varmluft)."
    },
    {
      "section": "Forberedelse",
      "text": "Kom vand, salt og bouillon i en gryde, og bring det i kog."
    },
    {
      "section": "Forberedelse",
      "text": "Rør hoisinsauce og vand sammen i en lille skål."
    },
    {
      "section": "Forberedelse",
      "text": "Snit enderne af bønnerne, og skær dem over på midten. Riv ingefæren fint med skrællen på."
    },
    {
      "section": "Kødboller",
      "text": "Ælt kød, ingefær, æg, rasp og salt sammen i en stor skål. Rul farsen til kødboller, ca. 5 pr. person."
    },
    {
      "section": "Mangosalat",
      "text": "Hak agurken groft. Skræl manngoen, og skær kødet af stenen på begge sider. Skær det i tern på ca. 2 cm."
    },
    {
      "section": "Mangosalat",
      "text": "Del limen over, og vend mango og agurk med et skvæt limesaft, chiliflager og salt. Brug mindre chili eller drop den, hvis nogen ikke bryder sig om stærk mad."
    },
    {
      "section": "Bagning",
      "text": "Kom risene i et stort ildfast fad, og hæld den varme bouillon over. Læg sølvpapir eller låg tæt over, og sæt fadet i ovnen i 25-27 minutter i alt."
    },
    {
      "section": "Bagning",
      "text": "Når der er 12-15 minutter tilbage, tages fadet ud, og risene røres igennem med en gaffel. Fordel bønner og kødboller ovenpå, dæk til igen, og bag videre."
    },
    {
      "section": "Bagning",
      "text": "Tag låget eller sølvpapiret af de sidste 5 minutter. Kødbollerne skal være brunede og gennemstegte uden rødt i midten, og risene bløde."
    },
    {
      "section": "Servering",
      "text": "Sæt fadet på bordet, og dryp hoisinsaucen over kødbollerne. Server med mangosalaten ved siden af."
    }
  ],
