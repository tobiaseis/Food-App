  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 220 °C (200 °C varmluft). Hak løg og hvidløg fint."
    },
    {
      "section": "Saucer",
      "text": "Rør madlavningsfløde, ricotta, hvidløg, oregano, mælk og saltet til ricottablandingen sammen i en mellemstor skål."
    },
    {
      "section": "Saucer",
      "text": "Rør passata, Hello Sunrise, vand, sukker og saltet til saucen sammen i en stor skål."
    },
    {
      "section": "Bagning",
      "text": "Fordel olie i bunden af et ildfast fad. Smuldr oksekødet ud over olien, og læg løg og hvidkål ovenpå i et jævnt lag."
    },
    {
      "section": "Bagning",
      "text": "Bag fadet i 20 minutter. Kødet skal være gennemstegt uden spor af rødt."
    },
    {
      "section": "Bagning",
      "text": "Vend makaroni rundt i tomatsaucen, og hæld det over det bagte kød. Smør ricottablandingen ud over, og drys med parmesan."
    },
    {
      "section": "Bagning",
      "text": "Bag videre i 6-8 minutter, til makaroniens bid er al dente, altså kogt, men med lidt modstand."
    },
    {
      "section": null,
      "text": "Sæt fadet på bordet, og pynt med basilikum."
    }
