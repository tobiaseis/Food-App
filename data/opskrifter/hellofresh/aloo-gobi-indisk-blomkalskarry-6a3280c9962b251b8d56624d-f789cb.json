  "steps": [
    {
      "section": null,
      "text": "Varm ovnen op til 240 °C (220 °C varmluft)."
    },
    {
      "section": "Ris",
      "text": "Bring vandet i kog i en gryde. Kom risene og saltet i, læg låg på, og lad dem simre ved middellav varme i 10 min."
    },
    {
      "section": "Ris",
      "text": "Tag gryden af varmen, og lad risene trække under låg i 10 min. Løft ikke låget undervejs."
    },
    {
      "section": "Grøntsager",
      "text": "Skær de uskrællede kartofler i tern på 2 cm, og del blomkålen i buketter på 3 cm."
    },
    {
      "section": "Grøntsager",
      "text": "Læg det hele på en bageplade med bagepapir. Hæld lidt olie over, drys med salt og peber, og vend rundt. Brug to plader, hvis der ikke er plads."
    },
    {
      "section": "Grøntsager",
      "text": "Bag midt i ovnen i 20-25 min, til grøntsagerne er møre."
    },
    {
      "section": "Sauce",
      "text": "Skær løgene i tynde halve skiver. Riv hvidløg og ingefær fint. Slå chilien op, skrab kernerne ud, og hak den fint. Hak tomater og koriander fint. Spring chilien over eller brug mindre, hvis nogen ikke bryder sig om stærk mad."
    },
    {
      "section": "Sauce",
      "text": "Varm olie op i en mellemstor gryde ved middelhøj varme. Svits løgene med saltet i 3-4 min, til de er lidt bløde."
    },
    {
      "section": "Sauce",
      "text": "Rør tomater, chili, hvidløg, ingefær og krydderiblandingen i, og steg i 4-5 min, til det er blødt."
    },
    {
      "section": "Sauce",
      "text": "Skru ned til middel varme, hæld vandet i, og lad saucen simre i 2-3 min, til den er let tyknet."
    },
    {
      "section": "Servering",
      "text": "Vend de bagte grøntsager og halvdelen af korianderen i saucen."
    },
    {
      "section": "Servering",
      "text": "Fordel ris og aloo gobi i dybe tallerkener. Top med chutney, yoghurt og resten af korianderen."
    }
  ],
