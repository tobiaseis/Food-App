  "steps": [
    {
      "section": "Æblesalat",
      "text": "Skær æblet i tynde skiver og halvér dem. Hak agurken groft, og halvér citronen."
    },
    {
      "section": "Æblesalat",
      "text": "Vend kål, agurk og æble i en stor skål med et skvæt citronsaft, salt og olie."
    },
    {
      "section": "Kød",
      "text": "Varm olien i en stor pande ved middelhøj varme. Brun oksekødet med saltet i 4-5 minutter."
    },
    {
      "section": "Kød",
      "text": "Skru ned på lav varme, og rør paprikaen i kødet. Lad den stege i 30 sekunder, til det dufter."
    },
    {
      "section": "Kød",
      "text": "Rør sriracha, honning og ketchup ind, og tag panden af varmen. Kødet skal være gennemstegt uden spor af rødt."
    },
    {
      "section": "Hvidløgsmayonnaise",
      "text": "Rør hvidløg, mayonnaise og vand sammen i en lille skål."
    },
    {
      "section": "Til servering",
      "text": "Varm tortillaerne i mikrobølgeovnen i 30-60 sekunder. Du kan også pakke dem i alufolie og varme dem i 4-5 minutter i ovnen ved 220 °C (200 °C varmluft)."
    },
    {
      "section": "Til servering",
      "text": "Fyld tortillaerne med æblesalat, og kom hvidløgsmayonnaise og kød ovenpå."
    }
  ],
