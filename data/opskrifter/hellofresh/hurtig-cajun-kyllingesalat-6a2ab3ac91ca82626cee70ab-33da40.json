  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 240 °C (220 °C varmluft). Si kikærterne fra deres lage."
    },
    {
      "section": "Kikærter",
      "text": "Læg kikærterne på en bageplade med bagepapir, og tryk dem let med en gaffel eller spatel, så de revner. Drys med lidt olivenolie, salt til kikærterne, paprika og peber, og vend rundt."
    },
    {
      "section": "Kikærter",
      "text": "Bag kikærterne midt i ovnen i 10-12 minutter, til de er sprøde."
    },
    {
      "section": "Kylling",
      "text": "Skær løget i tynde halve skiver. Varm lidt olivenolie op i en stor pande over middelhøj varme."
    },
    {
      "section": "Kylling",
      "text": "Steg kylling og løg sammen med salt til kyllingen, Cajun-krydderi og peber i 4-5 minutter, til kødet er gyldent og helt igennem hvidt uden rosa."
    },
    {
      "section": "Salat og dressing",
      "text": "Skær bunden af salaten, pluk bladene fra hinanden, og hak dem groft. Del citronen i både."
    },
    {
      "section": "Salat og dressing",
      "text": "Rør yoghurt, aioli, worcestershiresauce, ketchup, et skvæt citronsaft, salt og peber sammen i en stor skål. Vend salat og gulerødder i dressingen sammen med salt til salaten."
    },
    {
      "section": "Anretning",
      "text": "Fordel salaten i dybe tallerkener, og læg kylling, løg og kikærter ovenpå. Server med de resterende citronbåde."
    }
