  "steps": [
    {
      "section": null,
      "text": "Pres eller finhak hvidløget. Hak tomat og svampe groft."
    },
    {
      "section": null,
      "text": "Varm olien op i en stor pande ved middelhøj varme. Brun svampene i 3-4 minutter."
    },
    {
      "section": null,
      "text": "Rør hvidløget i panden, og steg det i ca. 30 sekunder, til det dufter."
    },
    {
      "section": null,
      "text": "Kom tomat, fløde, bouillon, miso, parmesan, vand, tortelloni og smør i panden. Lad det simre i 3-4 minutter, til saucen er let tyknet, og pastaen er al dente (kogt, men med en smule bid)."
    },
    {
      "section": null,
      "text": "Skyl rucolaen, mens saucen simrer, og hak peberfrugten groft."
    },
    {
      "section": null,
      "text": "Fordel tortelloni i dybe tallerkener. Drys med rucola og peberfrugt, og dryp evt. lidt olie over."
    }
  ],
