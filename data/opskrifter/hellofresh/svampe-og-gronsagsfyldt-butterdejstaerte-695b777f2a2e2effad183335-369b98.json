  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 240 °C (220 °C varmluft)."
    },
    {
      "section": "Grøntsager",
      "text": "Slå porren over på langs, skyl den, og skær den i tynde halve skiver. Skær champignon i tynde skiver."
    },
    {
      "section": "Grøntsager",
      "text": "Skræl kartoflerne, og skær dem i tern på 1 cm. Hak gulerod og hvidløg fint. Pluk timianbladene af stilkene."
    },
    {
      "section": "Sauce",
      "text": "Varm smør og olie i en stor pande ved middelhøj varme. Steg gulerod, porre, kartofler og champignon med salt i 4-5 minutter."
    },
    {
      "section": "Sauce",
      "text": "Rør timian, mel og hvidløg i, og steg i 1 minut."
    },
    {
      "section": "Sauce",
      "text": "Hæld fløde, vand, eddike og bouillon i. Skru ned til middel varme, og lad det simre i 1-2 minutter, til saucen er tyk."
    },
    {
      "section": "Tærte",
      "text": "Kom blandingen i et ildfast fad, og drys parmesan over. Læg butterdejen ovenpå, og skær et kryds i den."
    },
    {
      "section": "Tærte",
      "text": "Bag tærten i 10-15 minutter, til dejen er gyldenbrun. Lad den hvile i 5 minutter."
    },
    {
      "section": "Salat",
      "text": "Skyl rucolaen, og vend den med salt og olie i en skål."
    },
    {
      "section": "Servering",
      "text": "Anret tærten på tallerkener med salaten ved siden af, og drys græskarkerner over salaten."
    }
  ],
  "changes": [
