  "steps": [
    {
      "section": "Kartofler og løg",
      "text": "Tænd ovnen på 240°C (220°C varmluft). Skær de uskrællede kartofler i tern på 2 cm, og del løget i både på ca. 2 cm."
    },
    {
      "section": "Kartofler og løg",
      "text": "Læg kartofler og løg på en bageplade med bagepapir. Drys med souvlaki-krydderi, salt og peber, og rør rundt med lidt olivenolie. Brug to plader, hvis der ikke er plads på én."
    },
    {
      "section": "Kartofler og løg",
      "text": "Bag i 25-35 minutter, til kartoflerne er møre."
    },
    {
      "section": "Dildcreme fraiche",
      "text": "Hak dilden fint, og rør den sammen med creme fraiche, salt og peber i en lille skål."
    },
    {
      "section": "Grøntsager og laks",
      "text": "Skyl spinaten. Skær squashen i tern på 2 cm, og hak broccolien groft."
    },
    {
      "section": "Grøntsager og laks",
      "text": "Når der er 9-10 minutter tilbage af bagetiden, skal ovnen skrues ned på 220°C (200°C varmluft)."
    },
    {
      "section": "Grøntsager og laks",
      "text": "Tør laksen med køkkenrulle, og drys den med salt. Læg broccoli, squash og laks med skindsiden nedad på en ny bageplade med bagepapir."
    },
    {
      "section": "Grøntsager og laks",
      "text": "Bag resten af tiden, til laksen er gennemstegt og kødet er mat i midten."
    },
    {
      "section": "Anretning",
      "text": "Tag begge plader ud af ovnen, og vend spinaten i de bagte grøntsager på pladen."
    },
    {
      "section": "Anretning",
      "text": "Fordel grøntsagerne på tallerkener, læg laksen ovenpå, og strø græskarkerner over. Server med dildcreme fraichen."
    }
  ],
