  "steps": [
    {
      "section": "Bouillon",
      "text": "Kom fond, vand, hvidløg, sojasauce, Worcestershire sauce, ingefær, five spice og chili i en stor gryde. Bring det i kog, skru ned og lad det simre i 5 minutter."
    },
    {
      "section": "Bouillon",
      "text": "Smag bouillonen til. Tilsæt sukker for mere sødme eller lidt ekstra sojasauce for mere salt."
    },
    {
      "section": "Til servering",
      "text": "Kog nudlerne efter anvisningen på pakken. Si dem fra og stil dem til side."
    },
    {
      "section": "Til servering",
      "text": "Steg kødskiverne i sesamolie på en pande, til de lige begynder at tage farve. Stil dem til side."
    },
    {
      "section": "Til servering",
      "text": "Fordel nudlerne i fire skåle. Læg kød, spinat, majs og to æggehalvdele på hver, så alt deles ligeligt."
    },
    {
      "section": "Til servering",
      "text": "Si bouillonen over i en ren gryde, og bring den i kog igen."
    },
    {
      "section": "Til servering",
      "text": "Hæld den kogende bouillon over skålene. Drys med nori, forårsløg og sesamfrø. Lad spinaten falde lidt sammen, inden du serverer."
    }
  ],
  "changes": [
    "Ramennudler er erstattet af almindelige nudler.",
    "Frisk ingefær angives som et stykke, da kilden ikke opgiver en vægt.",
    "Chili i pulver er skrevet som stødt chili."
  ]
