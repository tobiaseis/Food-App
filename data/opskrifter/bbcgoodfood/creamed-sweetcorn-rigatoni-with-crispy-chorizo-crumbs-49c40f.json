  "steps": [
    {
      "section": "Chorizodrys",
      "text": "Varm en lille pande op ved middel varme. Steg chorizoen i nogle minutter, til den har afgivet sin olie og er sprød."
    },
    {
      "section": "Chorizodrys",
      "text": "Rør panko i og steg i 30 sekunder til 1 minut, til det lige er blevet gyldent."
    },
    {
      "section": "Chorizodrys",
      "text": "Bland citronskallen i, og de ristede løg, hvis du bruger dem. Stil panden til side."
    },
    {
      "section": "Pasta og sauce",
      "text": "Smelt smørret i en pande ved middel varme. Svits løget i 5 minutter."
    },
    {
      "section": "Pasta og sauce",
      "text": "Tilsæt majskernerne og steg i 1 minut. Hæld vandet på, skru ned for varmen, læg låg på og lad det simre i 10 minutter."
    },
    {
      "section": "Pasta og sauce",
      "text": "Kog imens pastaen efter anvisningen på pakken, og si den fra."
    },
    {
      "section": "Pasta og sauce",
      "text": "Hæld fløden over majsene, smag til med salt og peber, og lad det koge i 3-5 minutter."
    },
    {
      "section": "Pasta og sauce",
      "text": "Rør mozzarellaen i, og lad den smelte i 1 minut. Vend pastaen i saucen, og varm det hele igennem i 1 minut."
    },
    {
      "section": "Pasta og sauce",
      "text": "Anret retten og drys med chorizodrysset. Server med det samme."
    }
  ],
