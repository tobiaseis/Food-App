  "steps": [
    {
      "section": null,
      "text": "Varm olien op på en pande ved middel varme. Steg løget forsigtigt i 8-10 minutter, til det er gyldent og klistret."
    },
    {
      "section": null,
      "text": "Rør hvidløg, gurkemeje, spidskommen og paprika ned i løget, og steg det i 1 minut."
    },
    {
      "section": null,
      "text": "Smuldr tofuen groft i en skål med en gaffel, så der bliver nogle store stykker."
    },
    {
      "section": null,
      "text": "Kom tofuen på panden, og steg den i 3 minutter."
    },
    {
      "section": null,
      "text": "Skru op for varmen, kom tomaterne på panden, og steg i 5 minutter mere, til de begynder at blive bløde."
    },
    {
      "section": null,
      "text": "Vend persillen i og server straks, gerne med ristet rugbrød."
    }
