  "steps": [
    {
      "section": "Giardiniera",
      "text": "Hæld eddike og vand i en lille gryde. Tilsæt sukker og salt, og lad det simre, til alt er opløst."
    },
    {
      "section": "Giardiniera",
      "text": "Kom gulerod, selleri, blomkål, chili og hvidløg i et rent lille glas eller en varmefast skål. Drys peberkorn og fennikelfrø over, og hæld den varme lage over."
    },
    {
      "section": "Giardiniera",
      "text": "Lad det køle helt af, og top med olivenolien. Sæt det på køl i mindst 1 time eller natten over."
    },
    {
      "section": "Olivensalat",
      "text": "Mos 75 g af grøntsagerne fra giardinieraen sammen med oliven, peberfrugt, kapers, hvidløg og persille i en foodprocessor. Det skal være fint hakket, men stadig have bid."
    },
    {
      "section": "Olivensalat",
      "text": "Skrab blandingen i en skål, og rør olivenolie, rødvinseddike og 1 spsk af giardinieraens lage i. Smag til med peber, og stil det på køl i 30 minutter eller natten over."
    },
    {
      "section": "Sandwich",
      "text": "Del brødet i to halvdele på langs af midten. Er krummen meget tyk og luftig, så pil lidt af den ud, så der bliver plads til fyldet."
    },
    {
      "section": "Sandwich",
      "text": "Pensl snitfladerne med olie, og fordel olivensalaten på begge halvdele, så saften trækker ind i brødet."
    },
    {
      "section": "Sandwich",
      "text": "Læg mortadella, salami og skinke i lag på bunden, og dæk med osten. Læg låget på, og tryk godt sammen."
    },
    {
      "section": "Sandwich",
      "text": "Pak sandwichen stramt ind i bagepapir. Læg et bræt eller en bakke ovenpå, og tynge det ned med et par dåser."
    },
    {
      "section": "Sandwich",
      "text": "Lad den stå i 1 time ved stuetemperatur, før den skæres i stykker og serveres."
    }
  ],
