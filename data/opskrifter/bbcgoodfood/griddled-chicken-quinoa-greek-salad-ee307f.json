  "steps": [
    {
      "section": null,
      "text": "Kog quinoaen efter anvisningen på pakken. Skyl den i koldt vand, og lad den dryppe grundigt af."
    },
    {
      "section": null,
      "text": "Rør smør, chili og hvidløg sammen til en jævn smørblanding."
    },
    {
      "section": null,
      "text": "Vend kyllingefileterne med 2 tsk af olivenolien, salt og peber."
    },
    {
      "section": null,
      "text": "Varm en grillpande op, til den er rigtig varm. Steg kyllingen 3-4 minutter på hver side, til den er gennemstegt."
    },
    {
      "section": null,
      "text": "Læg kyllingen på et fad, og fordel klatter af chilismørret over. Lad det stå og smelte."
    },
    {
      "section": null,
      "text": "Kom tomater, oliven, rødløg, feta og mynte i en stor skål, og vend quinoaen i."
    },
    {
      "section": null,
      "text": "Rør resten af olien, citronsaft og citronskal i. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Anret salaten med kyllingen ovenpå, og hæld den smørrige stegesaft fra fadet over."
    }
  ],
