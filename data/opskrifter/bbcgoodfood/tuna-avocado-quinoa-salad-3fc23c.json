  "steps": [
    {
      "section": null,
      "text": "Skyl quinoaen i koldt vand. Kom den i en gryde, dæk med vand, og bring det i kog."
    },
    {
      "section": null,
      "text": "Skru ned for varmen, og lad quinoaen simre i 15 minutter. Kornene skal være svulmet op, men stadig have lidt bid."
    },
    {
      "section": null,
      "text": "Si vandet fra, og lad quinoaen køle lidt af i en skål."
    },
    {
      "section": null,
      "text": "Rør olie, citronsaft og eddike sammen til en dressing i en kande. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Vend den afkølede quinoa med dressingen, tun, avocado, tomater, feta, spinat og kerner. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Fordel salaten på tallerkener eller i madkasser."
    }
  ],
