  "steps": [
    {
      "section": null,
      "text": "Kog risnudlerne efter anvisningen på pakken. Si dem fra og stil dem til side."
    },
    {
      "section": null,
      "text": "Rør alle ingredienser til saucen sammen i en skål eller kande."
    },
    {
      "section": null,
      "text": "Varm olien op i en stor wok eller pande ved høj varme. Rør hvidløg og chili rundt i cirka 20 sekunder, til de lige begynder at få farve."
    },
    {
      "section": null,
      "text": "Kom oksekødet i og rør det rundt i 1 minut, til det er brunet."
    },
    {
      "section": null,
      "text": "Tilsæt broccoli og wok i endnu 1 minut."
    },
    {
      "section": null,
      "text": "Vend nudlerne i woken, hæld saucen over, og rør det hele i 1-2 minutter, til nudlerne er varme og dækket af sauce."
    },
