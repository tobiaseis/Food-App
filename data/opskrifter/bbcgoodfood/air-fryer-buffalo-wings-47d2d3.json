  "steps": [
    {
      "section": "Vinger",
      "text": "Tør vingerne godt med køkkenrulle."
    },
    {
      "section": "Vinger",
      "text": "Bland bagepulver, majsstivelse, hvidløgspulver, paprika, cayennepeber og salt i en stor skål."
    },
    {
      "section": "Vinger",
      "text": "Vend vingerne rundt i olien, drys krydderiblandingen over, og vend dem, til de er dækket jævnt."
    },
    {
      "section": "Vinger",
      "text": "Læg vingerne i ét lag i airfryerkurven. Er der ikke plads til alle, så steg dem i omgange."
    },
    {
      "section": "Vinger",
      "text": "Airfry ved 200 °C i 25-30 minutter. Vend vingerne halvvejs, og tag dem ud, når de er sprøde, gyldne og gennemstegte."
    },
    {
      "section": "Buffalosauce",
      "text": "Smelt smør, hot sauce og honning sammen i en lille gryde eller i mikroovnen, og rør, til det er ensartet."
    },
    {
      "section": "Ranchdip",
      "text": "Rør mayonnaise, yoghurt, hvidløgspulver og citronsaft sammen. Tilsæt forårsløg eller purløg, og smag til med salt."
    },
    {
      "section": null,
      "text": "Vend de færdige vinger i buffalosaucen, og server dem straks med ranchdippen ved siden af."
    }
  ],
  "changes": [
    "Soured cream er erstattet med yoghurt, som kilden også angiver.",
