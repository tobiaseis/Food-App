  "steps": [
    {
      "section": null,
      "text": "Kom avocado, yoghurt, purløg, dild, persille, forårsløg, eddike, olivenolie og hvidløg i en blender eller foodprocessor. Tilsæt 1 spsk af citronsaften."
    },
    {
      "section": null,
      "text": "Kør blandingen, til den er finthakket og helt glat og cremet."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber. Tilsæt mere citronsaft, hvis du vil have mere syrlighed."
    },
    {
      "section": null,
      "text": "Rør koldt vand i, lidt ad gangen (1 spsk), indtil dressingen er tynd nok til at dryppe fra en ske."
    }
  ],
