  "steps": [
    {
      "section": "Sauce",
      "text": "Varm olien op i en gryde ved middel varme. Rør hvidløget i og steg det i 1 minut."
    },
    {
      "section": "Sauce",
      "text": "Tilsæt tomatpuré og lad den stege med i 1 minut."
    },
    {
      "section": "Sauce",
      "text": "Hæld hakkede tomater i. Skyl dåsen med lidt vand og hæld skyllevandet i gryden sammen med bønnerne."
    },
    {
      "section": "Sauce",
      "text": "Lad saucen simre i 10 minutter."
    },
    {
      "section": "Kødboller",
      "text": "Kom hakket svinekød, fennikelfrø, ricotta, parmesan og panko i en stor skål. Krydr med peber og ælt det hele godt sammen med hænderne."
    },
    {
      "section": "Kødboller",
      "text": "Form blandingen til 12 kødboller."
    },
    {
      "section": "Bagning",
      "text": "Tag gryden af varmen og rør fløden i. Smag saucen til med salt og peber."
    },
    {
      "section": "Bagning",
      "text": "Tænd ovnen på 200 °C (180 °C varmluft). Hæld bønnesaucen i et fladt ovnfast fad og læg kødbollerne ovenpå."
    },
    {
      "section": "Bagning",
      "text": "Bag i ovnen i 25-30 minutter."
    },
    {
      "section": "Til servering",
      "text": "Drys med ekstra parmesan og basilikum før servering. Skal retten fryses, så lad den afkøle helt og dæk den godt til."
    }
  ],
  "changes": [
    "Smørbønner er erstattet af hvide bønner.",
    "Panko er beholdt som panko.",
    "Double cream er erstattet af piskefløde."
