  "steps": [
    {
      "section": "Enchiladasaucen",
      "text": "Varm olien op i en stor gryde ved middel varme. Rør melet ud i olien og lad det simre ca. 1 minut under konstant omrøring."
    },
    {
      "section": "Enchiladasaucen",
      "text": "Tilsæt chilipulver, løgpulver, hvidløgspulver, spidskommen og saltet. Steg krydderierne i 2 minutter."
    },
    {
      "section": "Enchiladasaucen",
      "text": "Rør chipotle, tomatpuré og eddike i, og lad det småputte 1-2 minutter."
    },
    {
      "section": "Enchiladasaucen",
      "text": "Hæld bouillonen i lidt ad gangen, og pisk, så saucen bliver helt glat. Bring den i kog, skru ned og lad den simre i 5 minutter, til den er tyknet. Tag gryden af varmen og lad saucen køle af."
    },
    {
      "section": "Fyldet",
      "text": "Tænd ovnen på 180 °C."
    },
    {
      "section": "Fyldet",
      "text": "Svits løg og jalapeños i olien på en stor pande ved middel varme i 5 minutter, til de er bløde."
    },
    {
      "section": "Fyldet",
      "text": "Skru op for varmen, og kom oksekødet og saltet på panden. Brun kødet, til det er gennemstegt. Er kødet magert, skal der ikke hældes fedt fra; ellers øs overskydende fedt af."
    },
    {
      "section": "Fyldet",
      "text": "Bland bønnerne og 250 ml af saucen i fyldet."
    },
    {
      "section": "Samling og bagning",
      "text": "Brug et ovnfast fad på ca. 23 x 33 cm. Bred 250 ml sauce ud i bunden."
    },
    {
      "section": "Samling og bagning",
      "text": "Vend 6 tortillas i saucen, og læg dem i fadet, så de dækker bunden. Fordel halvdelen af kødfyldet ovenpå, og drys med halvdelen af osten."
    },
    {
      "section": "Samling og bagning",
      "text": "Vend de sidste tortillas i saucen, og læg dem som næste lag. Slut med resten af kødfyldet, al den sauce, der er tilbage, og resten af osten."
    },
    {
      "section": "Samling og bagning",
      "text": "Bag retten i ovnen i 25 minutter, til den er boblende og gylden."
    },
    {
      "section": "Samling og bagning",
      "text": "Server med salsa, creme fraiche, koriander og jalapeños i skiver."
    }
  ],
