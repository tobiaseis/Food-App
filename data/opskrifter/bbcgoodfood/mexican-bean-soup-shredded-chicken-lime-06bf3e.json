  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en mellemstor gryde. Steg løg og peberfrugt i 10 minutter, og rør ofte."
    },
    {
      "section": null,
      "text": "Rør hvidløg og krydderier i, og hæld derefter tomater og bønner med lagen i gryden. Fyld en halv tom tomatdåse med vand, tilsæt det sammen med bouillonpulveret, og lad suppen simre under låg i 15 minutter."
    },
    {
      "section": null,
      "text": "Vend imens kyllingen med koriander, limesaft og eventuelt lidt chili i en skål."
    },
    {
      "section": null,
      "text": "Øs suppen op i to skåle, og top med kyllingeblandingen."
    }
