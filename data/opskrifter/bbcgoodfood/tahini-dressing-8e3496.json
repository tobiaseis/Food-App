  "steps": [
    {
      "section": null,
      "text": "Pisk tahin, citronskal, citronsaft, olivenolie, hvidløg og lønnesirup sammen i en lille skål. Krydr kraftigt med salt og peber."
    },
    {
      "section": null,
      "text": "Rør vandet i lidt ad gangen, til dressingen er tyk, men stadig kan hældes."
    },
    {
      "section": null,
      "text": "Vend purløget i. Andre bløde, hakkede krydderurter kan bruges i stedet."
    },
    {
      "section": null,
      "text": "Hæld dressingen over en salat, fx af revet rosenkål, rucola, gulerod, agurk og avocado."
    }
  ],
