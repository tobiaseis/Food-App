  "steps": [
    {
      "section": "Fisk og grøntsager",
      "text": "Tænd ovnen på 220 °C (200 °C varmluft)."
    },
    {
      "section": "Fisk og grøntsager",
      "text": "Kog kartoffelskiverne i rigeligt kogende saltvand i ca. 5 minutter, til de næsten er møre. Hæld vandet fra, og lad dem dampe af."
    },
    {
      "section": "Fisk og grøntsager",
      "text": "Skær tre dybe snit på skrå på hver side af fisken, så der kommer et rudemønster. Gnid fisken med olien, og krydr med salt og peber."
    },
    {
      "section": "Fisk og grøntsager",
      "text": "Put de knuste hvidløg og citronskiverne ind i bugen."
    },
    {
      "section": "Fisk og grøntsager",
      "text": "Fordel kartofler og alle tomaterne i et ovnfast fad, og krydr dem. Læg fisken ovenpå."
    },
    {
      "section": "Fisk og grøntsager",
      "text": "Bag i 20-25 minutter. Fisken er færdig, når kødet er uigennemsigtigt ved det tykkeste sted og let slipper benene."
    },
    {
      "section": "Fisk og grøntsager",
      "text": "Tag fisken op, og dæk den til, så den holder varmen. Lad kartofler og tomater bage videre i 10 minutter."
    },
    {
      "section": "Til salsaen",
      "text": "Kom rucola, persille, koriander, chili og kapers i en foodprocessor. Kør i korte pulser, til det er fint hakket, og lad lidt af olien løbe ned undervejs."
    },
    {
      "section": "Til salsaen",
      "text": "Rør resten af olien i sammen med hvidløg og citronsaft. Smag til med salt og peber."
    },
    {
      "section": "Til salsaen",
      "text": "Anret kartofler og tomater på et fad, læg fisken ovenpå, og dryp salsaen over."
    }
  ],
