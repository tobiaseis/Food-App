  "steps": [
    {
      "section": "Kødboller",
      "text": "Pil pølsekødet ud af skindet i en stor skål. Bland med hakket oksekød, hvidløg, persille, rasp og æg."
    },
    {
      "section": "Kødboller",
      "text": "Krydr godt med salt og peber, og ælt farsen igennem igen."
    },
    {
      "section": "Kødboller",
      "text": "Drys et stort fad eller bræt let med hvedemel. Form farsen til kugler med en dessertske, og vend dem i melet. Lidt olie på hænderne gør det nemmere at rulle."
    },
    {
      "section": "Kødboller",
      "text": "Varm olien op på en stor pande. Brun kødbollerne portionsvis rundt om, og læg dem over på et rent fad."
    },
    {
      "section": "Kødboller",
      "text": "Hæld overskydende fedt fra panden, og skyl og tør den af."
    },
    {
      "section": "Tomatsovs",
      "text": "Varm olien i panden i 1 minut. Steg hvidløget et par sekunder."
    },
    {
      "section": "Tomatsovs",
      "text": "Kom tomaterne i, og rør dem fra hinanden. Lad dem koge ved middelhøj varme i ca. 5 minutter, til sovsen begynder at tykne."
    },
    {
      "section": "Tomatsovs",
      "text": "Smag til med salt, peber og sukker."
    },
    {
      "section": "Tomatsovs",
      "text": "Læg kødbollerne tilbage i sovsen, og vend dem, så de er dækket helt. Læg låg på, og lad dem simre ved lav varme i ca. 30 minutter."
    },
    {
      "section": "Tomatsovs",
      "text": "Øs af og til sovs over kødbollerne, og tilsæt lidt vand, hvis sovsen bliver for tør."
    },
    {
      "section": "Til servering",
      "text": "Kog spaghettien efter anvisningen på pakken, så den er færdig samtidig med kødbollerne – start ca. 15 minutter før."
    },
    {
      "section": "Til servering",
      "text": "Rør det meste af persillen ned i sovsen. Anret kødboller og sovs på spaghettien, og strø resten af persillen over."
    },
    {
      "section": "Til servering",
      "text": "Server med revet parmesan ved siden af."
    }
  ],
