  "steps": [
    {
      "section": "Marinade",
      "text": "Rør paprika, oregano, chipotle, kanel, hvidløg, limeskal og olie sammen i en skål. Smag til med salt og peber."
    },
    {
      "section": "Marinade",
      "text": "Vend kyllingelårene i marinaden, til de er dækket. Læg film over skålen og sæt den på køl i mindst nogle timer, gerne op til 24 timer."
    },
    {
      "section": "Dressing og grill",
      "text": "Rør yoghurt, limesaft, olie, paprika, chipotle og honning sammen med en knivspids salt. Stil dressingen til side."
    },
    {
      "section": "Dressing og grill",
      "text": "Tænd grillen og vent, til flammerne har lagt sig, eller varm en grillpande op på høj varme."
    },
    {
      "section": "Dressing og grill",
      "text": "Pensl majskolberne med lidt olie. Grill dem sammen med kyllingen i cirka 10 minutter, og vend ofte. Kyllingen skal være forkullet, fast at trykke på og gennemstegt hele vejen ind – skær i et af de tykkeste stykker for at tjekke. Majsen skal være skinnende gul og saftig."
    },
    {
      "section": "Dressing og grill",
      "text": "Læg kylling og majs på et bræt eller fad, og dæk dem til, så de holder varmen."
    },
    {
      "section": "Tortillastrimler",
      "text": "Skær tortillaerne i strimler eller små stykker. Steg dem i lidt olie på en pande, til de er sprøde og gyldne. Lad dem dryppe af på køkkenpapir, og drys med salt."
    },
    {
      "section": "Salat",
      "text": "Anret salat, bønner, tomater og avocado på et stort fad eller i en skål. Vent med at vende det sammen til lige før servering, så salatbladene ikke falder sammen."
    },
    {
      "section": "Salat",
      "text": "Skær kyllingen i strimler på cirka 1 cm, og skær de forkullede kerner af majskolberne. Kom begge dele på salaten."
    },
    {
      "section": "Salat",
      "text": "Hæld dressingen over sammen med den safte, kyllingen har afgivet, og vend det hele rundt. Top med koriander og tortillastrimler, og server med limebåde ved siden af."
    }
  ],
