  "steps": [
    {
      "section": "Marinade",
      "text": "Rør citronsaft, spidskommen, paprika, chili og yoghurt sammen i en skål. Smag til med salt og peber."
    },
    {
      "section": "Marinade",
      "text": "Skær kyllingen i mundrette stykker og vend dem i marinaden. Dæk skålen og stil den på køl i 1 time eller natten over."
    },
    {
      "section": "Sauce",
      "text": "Varm olien op i en stor, tung gryde. Svits løg, hvidløg, grøn chili og ingefær med salt og peber ved middel varme i ca. 10 minutter, til løgene er bløde."
    },
    {
      "section": "Sauce",
      "text": "Rør garam masala, bukkehorn og tomatpuré i gryden, og lad det stege i 2 minutter, til det dufter."
    },
    {
      "section": "Sauce",
      "text": "Hæld fond og marineret kylling i gryden, og lad det koge i 15 minutter. Skrab resten af marinaden fra skålen ned i gryden, og lad retten simre i 5 minutter."
    },
    {
      "section": "Servering",
      "text": "Drys med ristede mandelflager. Server med ris, naanbrød, mango chutney, koriander og limebåde."
    }
  ],
  "changes": [
    "Mango chutney i stedet for 'mango chutney eller lime pickle'."
  ]
