  "steps": [
    {
      "section": null,
      "text": "Bring saltet vand i kog i en gryde, og sæt en dampindsats eller et dørslag over."
    },
    {
      "section": null,
      "text": "Damp bønner, asparges og ærter, til de lige er møre. Stil dem til side."
    },
    {
      "section": null,
      "text": "Kog pasta efter anvisningen på pakken."
    },
    {
      "section": null,
      "text": "Imens svitses porren ved svag varme i olie og smør i ca. 5 minutter, til den er blød."
    },
    {
      "section": null,
      "text": "Rør creme fraiche ned i porren, og varm den helt forsigtigt igennem under konstant omrøring, så saucen ikke skiller."
    },
    {
      "section": null,
      "text": "Vend krydderurter og de dampede grøntsager i saucen sammen med en sjat af pastavandet, så saucen bliver løsere."
    },
    {
      "section": null,
      "text": "Si pastaen, og vend den i saucen. Smag til med salt."
    },
    {
      "section": null,
      "text": "Server med parmesan drysset over og lidt olivenolie dryppet ovenpå."
    }
  ],
