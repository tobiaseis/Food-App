  "steps": [
    {
      "section": null,
      "text": "Pensl tunstykkerne med lidt olie og varm en non-stick-pande op."
    },
    {
      "section": null,
      "text": "Steg tunen 1 minut på hver side, eller lidt længere, hvis stykkerne er tykke. Læg den på et fad og lad den hvile."
    },
    {
      "section": null,
      "text": "Del avocadoen, fjern stenen, og skrab frugtkødet i en lille skål."
    },
    {
      "section": null,
      "text": "Tilsæt sennep og eddike, og mos det hele, til det er helt glat og minder om mayonnaise. Rør kapers i."
    },
    {
      "section": null,
      "text": "Skær tunen i skiver. Den skal være lyserød indeni."
    },
    {
      "section": null,
      "text": "Anret tun, salatblade og tomater på tallerkener, og sæt avocadomayoen ved siden af."
    },
    {
      "section": null,
      "text": "Fyld salatbladene med mayo, tun, tomater og lidt ekstra kapers, og rul dem sammen til små wraps."
    }
  ],
  "changes": [
    "Engelsk sennepspulver er erstattet af sennep."
