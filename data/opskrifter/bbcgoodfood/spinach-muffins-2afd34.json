  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 180 °C (varmluft 160 °C)."
    },
    {
      "section": null,
      "text": "Kør spinaten i en foodprocessor, til den er hakket i stykker, men ikke til puré. Kom den i en skål sammen med osten og timianen."
    },
    {
      "section": null,
      "text": "Pisk æg og yoghurt sammen i en anden skål. Rør mælken i. Tilsæt lidt mere mælk, hvis dejen virker for tør."
    },
    {
      "section": null,
      "text": "Sigt begge slags mel og bagepulver ned i skålen med æggemassen, og rør det sammen. Vend spinatblandingen i."
    },
    {
      "section": null,
      "text": "Smør en muffinform, og fordel dejen i hullerne."
    },
    {
      "section": null,
      "text": "Bag muffinsene i 20-25 minutter. Lad dem køle af."
    }
