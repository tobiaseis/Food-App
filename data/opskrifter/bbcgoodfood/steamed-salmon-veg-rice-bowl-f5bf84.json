  "steps": [
    {
      "section": "Dressing",
      "text": "Rør alle ingredienserne til dressingen sammen i en lille skål, og stil den til side."
    },
    {
      "section": "Ris",
      "text": "Kog risene i rigeligt vand i ca. 15 minutter, til de netop er møre. Hæld vandet fra."
    },
    {
      "section": "Damp",
      "text": "Læg laksen og grøntsagerne i hver sin etage i en stor dampkoger, mens risene koger."
    },
    {
      "section": "Damp",
      "text": "Damp laksen i 5-8 minutter og grøntsagerne i 4-5 minutter, til alt er gennemvarmt og mørt."
    },
    {
      "section": "Anretning",
      "text": "Fordel risene i skåle, og læg laks og grøntsager ovenpå. Hæld dressing over, og drys med forårsløg, kerner og eventuelt syltet ingefær."
    }
  ],
