  "steps": [
    {
      "section": null,
      "text": "Rør citrongræs, ingefær, hvidløg, limesaft, farin, sojasauce, vand og eventuel chili sammen i en skål. Stil den til side."
    },
    {
      "section": null,
      "text": "Varm olien op i en wok eller en stor, høj pande ved høj varme. Brun squash og kylling i 4 minutter under omrøring."
    },
    {
      "section": null,
      "text": "Kom sukkerærter og kokos i woken. Steg dem 1-2 minutter, og rør godt rundt, så kokosen ikke brænder på."
    },
    {
      "section": null,
      "text": "Hæld saucen i langs panderanden og rør rundt. Lad det koge ved høj varme i ca. 1-2 minutter, til saucen er reduceret, og kyllingen er gennemstegt."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber. Varm risene efter anvisningen på posen, og server dem med woken."
    }
  ],
