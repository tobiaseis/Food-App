  "steps": [
    {
      "section": null,
      "text": "Varm halvdelen af sesamolien op på en stor, belagt pande over høj varme."
    },
    {
      "section": null,
      "text": "Steg kalkunfarsen i 10-12 minutter, til den er gylden og sprød. Del den i småstykker med en træske undervejs."
    },
    {
      "section": null,
      "text": "Rør ingefær og hvidløg ned i panden, og lad det stege i 1 minut."
    },
    {
      "section": null,
      "text": "Tilsæt honning, sojasauce og sriracha. Lad det simre i 2 minutter."
    },
    {
      "section": null,
      "text": "Kog imens nudlerne i rigeligt vand efter anvisningen på pakken, og si dem fra."
    },
    {
      "section": null,
      "text": "Vend de varme nudler med resten af sesamolien og al limesaften, og fordel dem i skåle."
    },
    {
      "section": null,
      "text": "Top med kalkunfars, gulerod, forårsløg og koriander. Server med limebåde, så man kan presse mere saft over."
    }
  ],
