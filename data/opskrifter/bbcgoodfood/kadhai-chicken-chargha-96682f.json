  "steps": [
    {
      "section": "Mariner kyllingen",
      "text": "Blend hvidløg med halvdelen af den græske yoghurt til en jævn pasta."
    },
    {
      "section": "Mariner kyllingen",
      "text": "Rør pastaen sammen med chilipulver, koriander, gurkemeje, garam masala og salt i en skål. Vend resten af yoghurten og kyllingestykkerne i, så kødet er dækket hele vejen rundt."
    },
    {
      "section": "Mariner kyllingen",
      "text": "Stil skålen i køleskabet i 2-3 timer – gerne natten over."
    },
    {
      "section": "Steg kyllingen",
      "text": "Varm olien op over middelvarme i en wok eller en dyb pande. Kom spidskommen og tørret chili i, og lad dem syde i ca. 10 sekunder, så olien tager smag."
    },
    {
      "section": "Steg kyllingen",
      "text": "Kom den marinerede kylling i panden og steg den i 5-7 minutter, mens du rører hele tiden."
    },
    {
      "section": "Steg kyllingen",
      "text": "Skru ned på lav varme, læg låg på, og lad kyllingen simre i 20 minutter, så dampen samler sig i panden."
    },
    {
      "section": "Lav raitaen",
      "text": "Knus spidskommen og peber til et fint pulver i en morter."
    },
    {
      "section": "Lav raitaen",
      "text": "Blend pulveret med 2 spsk af yoghurten, mynte, koriander og hvidløg til en glat masse. Hæld den i en serveringsskål, og rør resten af yoghurten i. Sæt raitaen på køl, til den skal på bordet."
    },
    {
      "section": "Server",
      "text": "Tjek, at kyllingen er mør og gennemstegt. Rør ingefær og rød chili i, og drys med koriander."
    },
    {
      "section": "Server",
      "text": "Server kyllingen varm med mynteraita og naanbrød."
    }
  ],
  "changes": [
