  "steps": [
    {
      "section": "Burgere",
      "text": "Kom halvdelen af rejerne, halvdelen af laksen, forårsløgene, citronskallen og halvdelen af koriandrene i en foodprocessor. Kør det kort, til det er en grov masse."
    },
    {
      "section": "Burgere",
      "text": "Vend massen op i en skål sammen med resten af rejerne og laksen. Smag til med salt og peber, form fire burgere, og stil dem på køl i 10 minutter."
    },
    {
      "section": "Stærk mayo",
      "text": "Rør mayonnaise og sriracha sammen. Smag til med salt, peber og citronsaft."
    },
    {
      "section": "Salat",
      "text": "Bland salat og agurk. Vend dem med lidt citronsaft og 1 tsk af olivenolien, og stil salaten til side."
    },
    {
      "section": "Stegning",
      "text": "Varm den resterende olie op på en stor pande. Steg burgerne 3-4 minutter på hver side, til de har fået en fin skorpe, og fisken er gennemstegt."
    },
    {
      "section": "Servering",
      "text": "Server burgerne i de ristede boller eller med salaten ved siden af. Top med en generøs klat stærk mayo."
    }
  ],
