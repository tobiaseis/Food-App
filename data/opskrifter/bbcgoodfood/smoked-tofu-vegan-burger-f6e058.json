  "steps": [
    {
      "section": "Burgerbøffer",
      "text": "Kom sødkartoffelternene i en mikrobølgeegnet skål, dæk med film, og varm dem på fuld styrke i 3 minutter, til de er møre."
    },
    {
      "section": "Burgerbøffer",
      "text": "Varm olivenolien op på en non-stick pande. Svits løget med en stor knivspids salt i ca. 5 minutter, til det er blødt."
    },
    {
      "section": "Burgerbøffer",
      "text": "Tilsæt hvidløg, spidskommen, røget paprika og hvidløgssalt. Rør rundt i 2 minutter, og tag panden af varmen."
    },
    {
      "section": "Burgerbøffer",
      "text": "Kom tofu og cashewnødder i en blender, og kør dem fint. Tilsæt sødkartoffel og løgblandingen, smag til med salt og peber, og blend, til massen er ensartet."
    },
    {
      "section": "Burgerbøffer",
      "text": "Form massen til fire bøffer. Læg dem på en bageplade med bagepapir, og stil dem i køleskabet, mens du laver salaten."
    },
    {
      "section": "Rødkålssalat",
      "text": "Bland rødkål, gulerod, koriander, limesaft og sesamfrø i en skål. Stil salaten til side."
    },
    {
      "section": "Panering",
      "text": "Rør sennep og sojadrik sammen i en dyb tallerken. Bland hvedemel, pankorasp, hvidløgssalt, cayennepeber, flormelis og bagepulver i en anden."
    },
    {
      "section": "Panering",
      "text": "Vend hver bøf i melblandingen, derefter i sojadrikblandingen og igen i melblandingen. Gentag hele runden en gang til, så panéringen bliver rigtig sprød."
    },
    {
      "section": "Stegning",
      "text": "Hæld rapsolie i en stor pande, så der står ca. 2 cm op ad siden. Varm den op ved middelhøj varme."
    },
    {
      "section": "Stegning",
      "text": "Læg bøfferne forsigtigt i den varme olie med en paletkniv. Steg dem 1 minut på hver side, til de er sprøde, og lad dem dryppe af på køkkenrulle."
    },
    {
      "section": "Til servering",
      "text": "Læg bøfferne i burgerbollerne, og top med rødkålssalat. Dryp med sriracha-mayonnaisen."
    }
  ],
  "changes": [
    "Engelsk sennep er skiftet til almindelig sennep."
  ]
}
