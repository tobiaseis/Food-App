  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en mellemstor gryde. Rør løg, ingefær og chili i gryden sammen med salt og peber, og lad det stege i 5 minutter."
    },
    {
      "section": null,
      "text": "Kom kyllingen og risene i gryden, og rør rundt i 2 minutter."
    },
    {
      "section": null,
      "text": "Hæld bouillonen i, og bring det i kog. Skru ned på lav varme, læg låg på, og lad retten simre i 8-10 minutter, til risene lige er møre."
    },
    {
      "section": null,
      "text": "Kom edamamebønnerne i gryden de sidste 3 minutter."
    },
    {
      "section": null,
      "text": "Drys med korianderblade, og server med en klat yoghurt, hvis du har lyst."
    }
  ],
