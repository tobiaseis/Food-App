  "steps": [
    {
      "section": null,
      "text": "Forbered kyllingen aftenen før: Varm ovnen op til 200 °C (180 °C varmluft)."
    },
    {
      "section": null,
      "text": "Læg kyllingestrimlerne i et ovnfast fad. Vend dem med jerkpasta, olivenolie og lidt salt og peber."
    },
    {
      "section": null,
      "text": "Bag kyllingen i 15 minutter, til den er gennemstegt. Lad den køle af, og stil den derefter på køl."
    },
    {
      "section": null,
      "text": "Rør yoghurt og mangochutney sammen til en dressing, og hæld den i en lille beholder."
    },
    {
      "section": null,
      "text": "Fordel linser, kylling, forårsløg, koriander og mango i to skåle. Læg limebådene ved siden af."
    },
    {
      "section": null,
      "text": "Vend bowlen med dressingen lige før servering."
    }
