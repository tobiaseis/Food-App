  "steps": [
    {
      "section": "Rejefrikadeller",
      "text": "Kør rejerne i en foodprocessor, til de er en jævn, fin masse."
    },
    {
      "section": "Rejefrikadeller",
      "text": "Kom rejemassen i en stor skål. Bland mango, limeskal, hvidløg, ingefær, koriander, æg, hvedemel og eventuelt chili i. Krydr med salt og peber, og rør det godt sammen."
    },
    {
      "section": "Rejefrikadeller",
      "text": "Varm olien op på en pande ved middel varme."
    },
    {
      "section": "Rejefrikadeller",
      "text": "Læg en spiseskefuld af farsen på panden, og tryk den ud til en rund, flad pandekage med bagsiden af en ske. Steg portionsvis, til de er gyldne på begge sider og gennemstegte, i alt 8-10 minutter. Det giver 12 stk."
    },
    {
      "section": "Til servering",
      "text": "Anret rejefrikadellerne på ris eller nudler. Server med skiver af agurk, mango og gulerod samt satay-sauce ved siden af."
    }
  ],
