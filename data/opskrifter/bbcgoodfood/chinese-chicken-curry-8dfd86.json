  "steps": [
    {
      "section": null,
      "text": "Vend kyllingestykkerne med majsstivelse, salt og peber. Stil dem til side."
    },
    {
      "section": "Sauce",
      "text": "Varm halvdelen af olien op i en wok ved lav til middel varme. Steg løget i 5-6 minutter, til det er blødt."
    },
    {
      "section": "Sauce",
      "text": "Tilsæt hvidløg og steg 1 minut. Rør krydderierne og sukkeret i, og steg endnu 1 minut."
    },
    {
      "section": "Sauce",
      "text": "Hæld fond og sojasauce i. Lad det småkoge i 20 minutter."
    },
    {
      "section": "Sauce",
      "text": "Blend saucen glat i en blender."
    },
    {
      "section": "Kylling",
      "text": "Tør woken af, og varm resten af olien op. Brun kyllingen på alle sider."
    },
    {
      "section": "Kylling",
      "text": "Hæld saucen tilbage i woken, og bring den i kog. Kom ærterne i, og lad retten småkoge i 5 minutter. Tynd evt. saucen med lidt vand."
    },
    {
      "section": "Kylling",
      "text": "Server med kogte ris."
    }
