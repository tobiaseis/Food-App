  "steps": [
    {
      "section": "Hummus",
      "text": "Tag lidt af kikærterne fra til pynt. Kom resten i en blender sammen med lidt af kikærtelagen."
    },
    {
      "section": "Hummus",
      "text": "Tilsæt tahin, hvidløg, citronsaft, olivenolie og en god knivspids salt. Blend til en helt glat masse."
    },
    {
      "section": "Hummus",
      "text": "Smag til. Har hummusen brug for et løft, så tilsæt lidt citron eller salt. Er den for tyk, så rør lidt mere kikærtelage i. Den skal være silkeblød. Hummusen kan opbevares i køleskab i op til tre dage."
    },
    {
      "section": "Salat",
      "text": "Bland alle salatens ingredienser undtagen persillen, og smag til med salt og peber. Salaten kan stå en times tid. Vend persillen i lige før servering."
    },
    {
      "section": "Æg og halloumi",
      "text": "Bring en gryde vand i let kog. Læg æggene forsigtigt i, og lad vandet nå kogepunktet igen. Kog dem derefter ved svag varme i 7 minutter."
    },
    {
      "section": "Æg og halloumi",
      "text": "Køl æggene i en skål med koldt vand, og pil dem, når de er til at holde i."
    },
    {
      "section": "Æg og halloumi",
      "text": "Varm lidt olivenolie op på en pande. Steg halloumien gylden og sprød i 3 minutter på hver side. Dryp med honning, og drys med chiliflager."
    },
    {
      "section": "Anretning",
      "text": "Kom hummusen i en lav skål, og stil den midt på et stort fad eller bræt. Top med de afsatte kikærter og de ristede pinjekerner, dryp med olivenolie, og drys med lidt af sumakken."
    },
    {
      "section": "Anretning",
      "text": "Halvér æggene, og læg dem i det ene hjørne. Krydr med flagesalt og resten af sumakken. Anret salaten i et andet hjørne og halloumien i et tredje. Server med fladbrød."
    }
  ],
