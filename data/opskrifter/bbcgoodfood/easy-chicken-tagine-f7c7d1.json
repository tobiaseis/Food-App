  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en bred gryde eller dyb pande med låg. Brun kyllingen hurtigt, til den er let farvet."
    },
    {
      "section": null,
      "text": "Tilsæt løg og ingefær, og steg det med i 2 minutter."
    },
    {
      "section": null,
      "text": "Hæld vandet i, og kom safran, honning og gulerødder i. Smag til med salt og peber, og rør rundt."
    },
    {
      "section": null,
      "text": "Bring det i kog, sæt låg stramt på, og lad retten simre i 30 minutter, til kyllingen er mør."
    },
    {
      "section": null,
      "text": "Tag låget af, og skru op for varmen i ca. 5 minutter, så saucen koger lidt ind."
    },
    {
      "section": null,
      "text": "Drys med persille, og server med citronbåde, som man kan presse over."
    }
  ],
