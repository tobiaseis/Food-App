  "steps": [
    {
      "section": "Sauce",
      "text": "Kom alle ingredienserne til saucen i en lille gryde, og lad den koge ved svag varme, til den er tyk og sirupsagtig. Det tager 3-4 minutter."
    },
    {
      "section": "Sauce",
      "text": "Tag gryden af varmen, og stil den til side."
    },
    {
      "section": "Kyllingen",
      "text": "Krydr vingerne med salt, peber og den revne ingefær."
    },
    {
      "section": "Kyllingen",
      "text": "Vend dem i majsstivelsen, så de er dækket helt."
    },
    {
      "section": "Kyllingen",
      "text": "Varm ca. 2 cm olie op på en stor pande ved middelhøj varme. Steg vingerne i 8-10 minutter, og vend dem undervejs, til de er sprøde."
    },
    {
      "section": "Kyllingen",
      "text": "Løft vingerne op af olien, og lad dem dryppe af på køkkenrulle i ca. 2 minutter."
    },
    {
      "section": "Servering",
      "text": "Varm saucen op igen, og vend de sprøde vinger rundt i den."
    },
    {
      "section": "Servering",
      "text": "Kom vingerne i en skål, og drys med sesamfrø og forårsløg."
    }
