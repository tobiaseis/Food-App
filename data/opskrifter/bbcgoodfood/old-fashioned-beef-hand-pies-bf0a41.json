  "steps": [
    {
      "section": "Fyldet",
      "text": "Tænd ovnen på 160 °C (140 °C varmluft)."
    },
    {
      "section": "Fyldet",
      "text": "Varm olien i en ovnfast gryde ved middel-lav varme. Svits selleri, løg, gulerødder og laurbærblad, til grøntsagerne er bløde."
    },
    {
      "section": "Fyldet",
      "text": "Kødet skal ikke brunes. Rør det direkte ned i gryden, og tilsæt smør og mel. Rør til sidst tomatpuré og fond i, og bring det i kog ved svag varme."
    },
    {
      "section": "Fyldet",
      "text": "Læg låg på, og sæt gryden i ovnen i 2 timer og 30 minutter. Tag låget af, og lad det simre i ovnen i mindst 30 minutter mere, til kødet er meget mørt, og saucen er tyk."
    },
    {
      "section": "Fyldet",
      "text": "Lad fyldet køle helt af."
    },
    {
      "section": "Samling og bagning",
      "text": "Skru op til 200 °C (180 °C varmluft). Beklæd to bageplader med bagepapir."
    },
    {
      "section": "Samling og bagning",
      "text": "Rul butterdejen ud, og udstik otte cirkler på ca. 14 cm i diameter."
    },
    {
      "section": "Samling og bagning",
      "text": "Læg fire af cirklerne på pladerne, og fordel fyldet på dem. Lad der være en bred kant hele vejen rundt."
    },
    {
      "section": "Samling og bagning",
      "text": "Pensl kanterne med lidt af ægget, og læg de sidste fire cirkler over som låg. Tryk kanterne sammen med en gaffel, så tærterne lukker tæt. Skær et lille hul til dampen i hver tærte."
    },
    {
      "section": "Samling og bagning",
      "text": "Pensl toppen med resten af ægget, og bag tærterne i 30 minutter, til dejen er gylden og gennembagt."
    },
    {
      "section": "Samling og bagning",
      "text": "Server med grønt, kartoffelmos og brun sauce."
    }
  ],
  "changes": [
    "Bouillon: kraftig oksefond bruges i stedet for strong beef stock.",
