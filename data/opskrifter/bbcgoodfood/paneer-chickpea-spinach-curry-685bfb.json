  "steps": [
    {
      "section": null,
      "text": "Varm olien i en dyb stegepande på middel varme. Svits løget i 3-4 minutter, til det er blødt."
    },
    {
      "section": null,
      "text": "Rør ingefær, hvidløg, alle krydderierne og chilien i. Steg 1-2 minutter, til det dufter."
    },
    {
      "section": null,
      "text": "Kom paneer og kikærter i panden, og hæld kokosmælk, spinat og fond over."
    },
    {
      "section": null,
      "text": "Bring det i kog, skru ned og lad karryen simre i 20 minutter, til saucen er reduceret og tyk."
    },
    {
      "section": null,
      "text": "Rør mango chutney i, og smag til med salt, peber og citronsaft."
    },
    {
      "section": null,
      "text": "Anret over ris og top med koriander og eventuelt chili i skiver."
    }
  ],
