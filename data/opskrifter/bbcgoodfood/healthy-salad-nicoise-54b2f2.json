  "steps": [
    {
      "section": null,
      "text": "Bring en stor gryde vand i kog. Kom kartoffelskiverne og æggene i, og lad dem koge i 7 minutter."
    },
    {
      "section": null,
      "text": "Tag æggene op med en hulske. Læg bønnerne i gryden, og kog videre i 4 minutter."
    },
    {
      "section": null,
      "text": "Hæld kartofler og bønner i et dørslag sammen med æggene, og skyl dem under koldt rindende vand, til de er kølige. Lad dem dryppe af."
    },
    {
      "section": null,
      "text": "Pil æggene, og skær dem i kvarte. Fordel salatbladene i to lave skåle."
    },
    {
      "section": null,
      "text": "Top med bønner, kartofler, tomater og æggekvarte. Dup ansjoserne tørre med køkkenrulle, og læg dem øverst."
    },
    {
      "section": null,
      "text": "Del tunen i store stykker, og fordel dem over salaten."
    },
    {
      "section": "Dressing",
      "text": "Rør mayonnaise og koldt vand sammen til en glat dressing. Dryp den over salaten, og server straks."
    }
