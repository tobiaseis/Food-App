  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 200 °C (180 °C varmluft). Læg bagepapir på en bageplade."
    },
    {
      "section": null,
      "text": "Rul croissantdejen ud, og skær den ad i trekanter."
    },
    {
      "section": null,
      "text": "Fordel fetaen og halvdelen af za'atar over trekanterne, og tryk det let ned i dejen med fingrene."
    },
    {
      "section": null,
      "text": "Rul hver trekant sammen fra den brede ende mod spidsen. Bøj enderne lidt indad, så de får croissantform."
    },
    {
      "section": null,
      "text": "Læg croissanterne på bagepladen, pensl dem med æg, og drys resten af za'atar over."
    },
    {
      "section": null,
      "text": "Bag dem i 15-20 minutter, til de er dybt gyldne."
    }
