  "steps": [
    {
      "section": "Tomatsauce",
      "text": "Varm olien i en stor stegepande med låg, gerne non-stick. Kom løg, gulerødder, selleri, hvidløg og fennikel i og rør godt rundt."
    },
    {
      "section": "Tomatsauce",
      "text": "Læg låg på og lad grøntsagerne stege ved middel varme i 8 minutter. Rør engang imellem."
    },
    {
      "section": "Tomatsauce",
      "text": "Hæld passataen i og smag til med salt og peber. Sæt låg på og lad saucen simre i 20 minutter."
    },
    {
      "section": "Kødboller",
      "text": "Imens blander du kalkunkødet med havregryn, fennikelfrø, fennikelbladene, hvidløg og rigeligt peber i en stor skål. Ælt det sammen med hænderne."
    },
    {
      "section": "Kødboller",
      "text": "Form blandingen let til cirka 25 kødboller på størrelse med en valnød."
    },
    {
      "section": "Kødboller",
      "text": "Pensl eller spray en non-stick pande med lidt olie. Brun kødbollerne nænsomt, til de får lidt farve."
    },
    {
      "section": "Kødboller",
      "text": "Rør rundt i saucen og læg kødbollerne og persillen i. Læg låg på og lad det simre i 10 minutter, til kødbollerne er gennemstegte og grøntsagerne er møre."
    },
    {
      "section": "Kødboller",
      "text": "Server med broccoli og kogte kartofler med skræl, eller med pasta og salat."
    }
  ],
