  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en stor tykbundet gryde ved middel varme."
    },
    {
      "section": null,
      "text": "Rør løg og selleri i gryden, og lad dem stege i 5 minutter, til de begynder at blive bløde."
    },
    {
      "section": null,
      "text": "Kom svampene i, og steg dem i 3 minutter."
    },
    {
      "section": null,
      "text": "Tilsæt hvidløg, ingefær og kyllingelår. Brun kødet i nogle minutter."
    },
    {
      "section": null,
      "text": "Hæld gulerødder, miso, salt, peber og vand i gryden. Bring det i kog."
    },
    {
      "section": null,
      "text": "Skru ned, læg låg på, og lad suppen simre i 20-30 minutter, til kyllingen er helt gennemkogt."
    },
    {
      "section": null,
      "text": "Tag kyllingelårene op, fjern benene, og pil kødet i strimler."
    },
    {
      "section": null,
      "text": "Kom broccoli og nudler i suppen, og lad dem koge 4-5 minutter, til nudlerne er møre. Læg kødet tilbage."
    },
    {
      "section": null,
      "text": "Server straks, evt. med forårsløg og rød chili på toppen."
    }
  ],
