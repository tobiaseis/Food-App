  "steps": [
    {
      "section": "Falafler",
      "text": "Tænd ovnen på 190 °C (170 °C varmluft), og læg bagepapir på en bageplade."
    },
    {
      "section": "Falafler",
      "text": "Kom spinat, kikærter, hvidløg, spidskommen, persille og hvedemel i en foodprocessor. Krydr let med salt og peber, og pulsér til en grov blanding."
    },
    {
      "section": "Falafler",
      "text": "Olie hænderne let. Form ca. 16 kugler af blandingen med en spiseskefuld til hver, og læg dem på pladen. Tryk dem lidt flade med håndfladen."
    },
    {
      "section": "Falafler",
      "text": "Pensl falaflerne med olie, og bag dem i 20-25 minutter, til de er faste og gyldne. Vend dem midtvejs."
    },
    {
      "section": "Hummus",
      "text": "Mens falaflerne bager, blendes alle ingredienserne til hummussen i foodprocessoren, til den er glat og fløjlsblød."
    },
    {
      "section": "Til servering",
      "text": "Fordel spinat, agurk, rødløg, falafler og hummus i hver sin del af skålene. Dryp med olivenolie, og kværn peber over."
    },
    {
      "section": "Til servering",
      "text": "Server med de ristede pitabrød ved siden af og eventuelt lidt citron at presse over."
    }
  ],
