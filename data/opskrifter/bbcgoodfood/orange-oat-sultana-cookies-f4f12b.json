  "steps": [
    {
      "section": "Dej",
      "text": "Tænd ovnen på 180 °C (160 °C varmluft)."
    },
    {
      "section": "Dej",
      "text": "Pisk smør og farin med en træske, til det er glat og luftigt."
    },
    {
      "section": "Dej",
      "text": "Rør banan, vaniljeekstrakt og æg i lidt ad gangen. Tilsæt appelsinskallen, og rør, til massen er helt ensartet."
    },
    {
      "section": "Dej",
      "text": "Bland mel, salt, bagepulver, havregryn, kokosmel, valnødder og rosiner (eller chokolade) i en stor skål."
    },
    {
      "section": "Dej",
      "text": "Vend de tørre ingredienser i den våde masse, og rør, til du har en tyk, sammenhængende dej."
    },
    {
      "section": "Bagning",
      "text": "Læg bagepapir på en bageplade."
    },
    {
      "section": "Bagning",
      "text": "Sæt dejen på pladen med hævede spiseskefulde, så der er ca. 5 cm mellem kagerne. Tryk dem let flade."
    },
    {
      "section": "Bagning",
      "text": "Bag kagerne i 15-20 minutter, til de er let gyldne. Lad dem køle af."
    }
  ],
