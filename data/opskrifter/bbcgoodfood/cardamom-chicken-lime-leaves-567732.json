  "steps": [
    {
      "section": "Til retten",
      "text": "Varm olien op i en stor, bred gryde. Svits løget ved middel varme i 5 minutter, til det er blødt, og rør af og til."
    },
    {
      "section": "Til retten",
      "text": "Rør hvidløg, ingefær, kardemommefrø, nelliker og kanel i gryden. Steg det i 5 minutter og rør ofte."
    },
    {
      "section": "Til retten",
      "text": "Tilsæt de øvrige krydderier og chilien, og rør kort rundt. Hæld tomaterne i sammen med en tom tomatdåse fyldt med vand, og tilsæt chutney og bouillon."
    },
    {
      "section": "Til retten",
      "text": "Kom auberginen i og bring det i kog. Læg låg på, og lad det simre i 15 minutter."
    },
    {
      "section": "Til retten",
      "text": "Rør godt rundt, og læg kyllingelår og limeblade i gryden. Tryk dem ned under væsken, og drys peberfrugten ovenpå. Sæt låg på og lad retten simre i 40 minutter."
    },
    {
      "section": "Til retten",
      "text": "Tag kyllingen op, og pil den i mellemstore stykker. Kom kødet tilbage i saucen."
    },
    {
      "section": "Til risen",
      "text": "Imens kommer du alle ingredienser til risen i en mellemstor gryde med 750 ml vand. Bring det i kog, læg låg på, og lad det koge i 20 minutter."
    },
    {
      "section": "Til risen",
      "text": "Tag gryden af varmen, og lad den stå under låg i 5 minutter, så den resterende fugt trækkes ind. Server risen til kyllingeretten."
    }
  ],
