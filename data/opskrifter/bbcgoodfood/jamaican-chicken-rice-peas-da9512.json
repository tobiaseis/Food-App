  "steps": [
    {
      "section": "Kyllingen",
      "text": "Varm olien op i en meget stor non-stick pande, og steg rødløgene i ca. 5 minutter, til de er bløde."
    },
    {
      "section": "Kyllingen",
      "text": "Vend kyllingen i timian, karry og allehånde, så den er helt dækket."
    },
    {
      "section": "Kyllingen",
      "text": "Brun kyllingen kort i panden. Tilsæt tomater, chili, hvidløg og bouillon, og hæld vandet over."
    },
    {
      "section": "Kyllingen",
      "text": "Læg låg på, og lad retten småkoge i ca. 30 minutter, til kyllingen er mør."
    },
    {
      "section": "Risene",
      "text": "Kom imens ris, løg, hvidløg, timian og bouillon i en mellemstor gryde, og hæld vandet i."
    },
    {
      "section": "Risene",
      "text": "Læg låg på, og kog i ca. 25 minutter, til risene er møre, og væsken er optaget. Kig til dem mod slutningen, så de ikke brænder på."
    },
    {
      "section": "Risene",
      "text": "Rør bønnerne i, og varm dem igennem. Server risene med kyllingen, og drys med lidt ekstra timian."
    }
  ],
