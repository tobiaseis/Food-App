  "steps": [
    {
      "section": "Bagt feta",
      "text": "Tænd ovnens grill på høj varme. Læg fetaen i et ildfast fad, og dryp olie og honning over. Drys med fennikelfrø og chili."
    },
    {
      "section": "Bagt feta",
      "text": "Grill fetaen i 7-10 minutter, til den bobler og er mørk i kanterne. Tag den ud, og lad den køle lidt af."
    },
    {
      "section": "Salat",
      "text": "Vend mynte, asparges, peberfrugt, bønner og salat sammen i en stor skål, mens fetaen griller."
    },
    {
      "section": "Dressing",
      "text": "Rør eddike, aioli og sennep sammen. Smag til med salt og peber, og tynd med en sjat vand, hvis den skal kunne dryppe."
    },
    {
      "section": "Dressing",
      "text": "Hæld dressingen over salaten, og vend det hele rundt."
    },
    {
      "section": "Servering",
      "text": "Pil fetaen i stykker ovenpå salaten, og hæld saften fra fadet over. Server evt. med ristet ciabatta."
    }
  ],
