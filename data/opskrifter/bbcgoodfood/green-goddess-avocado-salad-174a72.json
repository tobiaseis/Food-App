  "steps": [
    {
      "section": "Kylling",
      "text": "Brug rå kylling? Varm olien op på en pande ved middel til kraftig varme. Krydr kyllingen med salt og peber på alle sider."
    },
    {
      "section": "Kylling",
      "text": "Steg kyllingen i 7-8 minutter på hver side. Læg låg på de sidste 5 minutter, til kødet er gennemstegt."
    },
    {
      "section": "Kylling",
      "text": "Lad kyllingen hvile i 10 minutter, og skær den derefter i skiver. Er kyllingen allerede færdigstegt, skal den bare skæres i skiver."
    },
    {
      "section": "Dressing",
      "text": "Kom avocado, yoghurt, purløg, dild, persille, forårsløg, eddike, olivenolie, hvidløg og 1 spsk citronsaft i en blender eller foodprocessor."
    },
    {
      "section": "Dressing",
      "text": "Kør det, til det er fint hakket og glat. Smag til med salt og peber, og tilsæt gerne mere citronsaft."
    },
    {
      "section": "Dressing",
      "text": "Rør koldt vand i, 1 spsk ad gangen, til dressingen er tynd nok til at dryppe af en ske."
    },
    {
      "section": "Salat",
      "text": "Vend kyllingeskiverne med 4 spsk af dressingen."
    },
    {
      "section": "Salat",
      "text": "Bland selleri, salat, radiser, æble og agurk, og anret det på et stort fad."
    },
    {
      "section": "Salat",
      "text": "Fordel den hakkede avocado og kyllingen over salaten. Dryp med så meget af resten af dressingen, som du har lyst til."
    },
    {
      "section": "Salat",
      "text": "Riv lidt citronskal fint over, og afslut med friskkværnet peber."
    }
  ],
  "changes": [
