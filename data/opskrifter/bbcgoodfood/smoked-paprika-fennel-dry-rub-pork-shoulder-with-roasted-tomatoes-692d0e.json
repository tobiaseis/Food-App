  "steps": [
    {
      "section": "Dagen før",
      "text": "Bland alle krydderierne til krydderiblandingen med saltet og peberen."
    },
    {
      "section": "Dagen før",
      "text": "Læg svinebovlen i et stegefad, og gnid krydderiblandingen ind over hele kødet."
    },
    {
      "section": "Dagen før",
      "text": "Lad kødet stå uden låg eller film i køleskabet i mindst 6 timer – gerne natten over."
    },
    {
      "section": "Stegning",
      "text": "Tag fadet ud af køleskabet 1 time før stegning. Varm ovnen op til 240 °C (220 °C varmluft)."
    },
    {
      "section": "Stegning",
      "text": "Vend sværen opad, dryp olien over, og gnid den godt ind i sværen."
    },
    {
      "section": "Stegning",
      "text": "Steg i 25-30 minutter, til sværen begynder at boble og danne blærer."
    },
    {
      "section": "Stegning",
      "text": "Løft kødet over på en tallerken. Kom hvidløg, oregano, løg, vin, tomatpuré, fond og tomater i fadet, og rør rundt."
    },
    {
      "section": "Stegning",
      "text": "Læg kødet tilbage med sværen opad. Sænk ovnen til 180 °C (160 °C varmluft), og steg i 1½-2 timer. Kødet er færdigt, når det er meget mørt under sværen, når du trykker på det."
    },
    {
      "section": "Sprød svær",
      "text": "Flyt kødet til en bageplade. Skru ovnen op på 220 °C (200 °C varmluft), og steg i yderligere 20-25 minutter, til sværen er gylden, oppustet og sprød og er tør og knitrende, når du banker på den med en kniv."
    },
    {
      "section": "Sprød svær",
      "text": "Hvis sværen ikke er sprød nok, så steg 5-10 minutter mere."
    },
    {
      "section": "Sprød svær",
      "text": "Tag kødet ud, og hvil det i 20 minutter under et løst stykke folie."
    },
    {
      "section": "Sauce og hvidløgsyoghurt",
      "text": "Pluk hvidløgene op af fadet, og pres det bløde indre ud af skrællen i en skål. Rør persille og yoghurt i, og smag til med salt og peber."
    },
    {
      "section": "Sauce og hvidløgsyoghurt",
      "text": "Sæt fadet over middelvarme på blusset, eller hæld indholdet i en gryde. Lad det koge op og småkoge 1-2 minutter, mens du mases tomaterne med bagsiden af en træske, så saucen tykner."
    },
    {
      "section": "Sauce og hvidløgsyoghurt",
      "text": "Rør eddiken i, og smag til."
    },
    {
      "section": "Servering",
      "text": "Brug hænderne til at bryde sværen af i store stykker og derefter i mindre stykker. Pil kødet i strimler, og server det med stegesky og hvidløgsyoghurt."
    }
  ],
