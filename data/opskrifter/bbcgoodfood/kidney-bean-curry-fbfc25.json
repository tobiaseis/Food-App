  "steps": [
    {
      "section": null,
      "text": "Varm olien i en stor pande ved lav til middel varme. Svits løget med en knivspids salt, mens du rører af og til, til det er blødt og lige begynder at få farve."
    },
    {
      "section": null,
      "text": "Kom hvidløg, ingefær og korianderstilke på panden, og steg dem 2 minutter, til det dufter."
    },
    {
      "section": null,
      "text": "Rør spidskommen, paprika og garam masala i, og lad dem stege 1 minut, til duften er tydelig."
    },
    {
      "section": null,
      "text": "Hæld de hakkede tomater og kidneybønnerne med vandet fra dåsen i. Bring det i kog."
    },
    {
      "section": null,
      "text": "Sænk varmen, og lad karryen simre i 15 minutter, til den er tyk."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber. Server med basmatiris og drys med korianderbladene."
    }
  ],
  "changes": [
    "Vegetable oil er byttet med rapsolie."
