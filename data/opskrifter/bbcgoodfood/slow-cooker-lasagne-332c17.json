  "steps": [
    {
      "section": "Kødsovs",
      "text": "Varm slowcookeren op, hvis den kræver det."
    },
    {
      "section": "Kødsovs",
      "text": "Varm olien på en stor non-stick-pande. Steg løg, selleri, gulerødder og hvidløg under jævnlig omrøring i 5-10 minutter, til de er møre og begynder at tage farve."
    },
    {
      "section": "Kødsovs",
      "text": "Kom hakket oksekød på panden, del det ud med en træske, og brun det under omrøring."
    },
    {
      "section": "Kødsovs",
      "text": "Tilsæt tomater, vand, tomatpuré, fond, balsamico, timian og rigeligt peber. Bring det i kog, og lad det simre i 5 minutter."
    },
    {
      "section": "Samling",
      "text": "Fordel halvdelen af kødsovsen i bunden af slowcookeren. Læg halvdelen af lasagnepladerne ovenpå, og knæk dem, så de dækker kødet mest muligt."
    },
    {
      "section": "Samling",
      "text": "Gentag med resten af kødsovsen og resten af pladerne. Læg låg på, og sæt slowcookeren på lav, mens du laver den hvide sovs."
    },
    {
      "section": "Hvid sovs",
      "text": "Pisk mælk og mel sammen i en gryde, og læg laurbærblad og muskatnød i. Varm op under konstant piskning, til sovsen tykner. Lad den koge nogle minutter, så melsmagen forsvinder."
    },
    {
      "section": "Hvid sovs",
      "text": "Tag laurbærbladet op, og rør parmesan i."
    },
    {
      "section": "Samling",
      "text": "Hæld sovsen over pladerne, og stryg den jævnt ud med en spatel. Læg låg på, og lad retten stå på lav i 3 timer, til kødet er gennemsteget og pladerne er møre."
    },
    {
      "section": "Samling",
      "text": "Lad lasagnen hvile i 10 minutter, og server den med salat."
    }
  ],
