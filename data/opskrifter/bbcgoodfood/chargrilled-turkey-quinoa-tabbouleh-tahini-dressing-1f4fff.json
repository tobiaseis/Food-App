  "steps": [
    {
      "section": "Quinoaen",
      "text": "Kom quinoaen i en gryde med vandet og læg låg på. Bring det i kog, skru ned og lad det simre, til vandet er væk, ca. 20 minutter, ligesom ved ris."
    },
    {
      "section": "Quinoaen",
      "text": "Tag låget af og lad quinoaen køle af, mens du laver salat og kalkun."
    },
    {
      "section": "Salaten",
      "text": "Bland agurk, tomater, forårsløg, persille og koriander i en stor skål. Tilsæt olivenolie og citronsaft, smag til med salt og peber, og vend det hele rundt."
    },
    {
      "section": "Kalkunen",
      "text": "Varm en grillpande op, til den ryger. Gnid kalkunschnitzlerne ind i olivenolien, og steg dem ca. 5 minutter på hver side, afhængigt af tykkelsen."
    },
    {
      "section": "Dressingen",
      "text": "Rør tahin, yoghurt, citronsaft, hvidløg, honning og vand sammen til en jævn dressing."
    },
    {
      "section": "Servering",
      "text": "Vend den afkølede quinoa i salaten og fordel den på tallerkener. Skær kalkunen i tykke skiver, læg dem ovenpå, og dryp med dressingen."
    }
  ],
  "changes": [
    "Kalkun-steaks er erstattet med kalkunschnitzel.",
    "Letyoghurt er erstattet med almindelig yoghurt."
  ]
