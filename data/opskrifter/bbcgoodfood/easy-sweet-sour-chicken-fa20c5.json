  "steps": [
    {
      "section": null,
      "text": "Bland ketchup, eddike, farin og hvidløg i et stort fad, der tåler mikroovn. Vend kylling, løg og peberfrugt grundigt rundt i sovsen."
    },
    {
      "section": null,
      "text": "Sæt fadet i mikroovnen uden låg og kør på fuld styrke i 8-10 minutter, til kyllingen begynder at blive gennemstegt, og sovsen syder."
    },
    {
      "section": null,
      "text": "Rør ananas og sukkerærter i, og kør videre i 3-5 minutter, til kyllingen er helt gennemstegt."
    },
    {
      "section": null,
      "text": "Lad retten hvile et par minutter. Rør evt. cashewnødder i, og server."
    }
  ],
