  "steps": [
    {
      "section": null,
      "text": "Ælt kalkunkødet sammen med krydderierne, løget og appelsinskallen i en stor skål, til det hele er grundigt blandet."
    },
    {
      "section": null,
      "text": "Form farsen til ca. 20 kødboller på størrelse med en valnød."
    },
    {
      "section": null,
      "text": "Kom couscous i en skål, og hæld den varme bouillon over. Dæk med film, og lad den trække i 10 minutter."
    },
    {
      "section": null,
      "text": "Varm olivenolien op på en pande. Steg kødbollerne i ca. 12 minutter, og vend dem ofte, til de er brunede hele vejen rundt og gennemstegte."
    },
    {
      "section": null,
      "text": "Luft couscousen med en gaffel, og vend appelsinstykkerne og koriander i. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Anret couscousen på tallerkner, og server kødbollerne ved siden af."
    }
