  "steps": [
    {
      "section": "Bund",
      "text": "Beklæd en springform på 20 cm med bagepapir."
    },
    {
      "section": "Bund",
      "text": "Kør kiksene til fine krummer i en foodprocessor. Hæld det smeltede smør over, og pulsér, til massen ligner fugtigt sand."
    },
    {
      "section": "Bund",
      "text": "Pres krummerne ud i formen, og glat overfladen med en ske. Stil formen på køl, mens du laver fyldet."
    },
    {
      "section": "Fyld",
      "text": "Pisk flødeost, Ovomaltine, begge slags chokolade, sukker og fløde sammen, til massen er fast og danner toppe."
    },
    {
      "section": "Fyld",
      "text": "Vend fyldet ud på bunden, og glat det jævnt med en spatel."
    },
    {
      "section": "Fyld",
      "text": "Lad kagen stå på køl i mindst 3 timer. Den holder sig op til fire dage på køl."
    },
    {
      "section": "Topping",
      "text": "Pisk fløde og Ovomaltine til bløde toppe."
    },
    {
      "section": "Topping",
      "text": "Løsn kagen fra formen, og lad den stå ca. 10 minutter, så den får stuetemperatur."
    },
    {
      "section": "Topping",
      "text": "Læg flødeskummet ovenpå, og træk det ud i bølger. Drys med Maltesers, og skær kagen i skiver. Den smager bedst samme dag, som den er pyntet."
    }
  ],
