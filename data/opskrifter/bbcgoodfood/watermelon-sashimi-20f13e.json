  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 180 °C (160 °C varmluft)."
    },
    {
      "section": null,
      "text": "Del vandmelonen på midten, og skær den i skiver på ½-1 cm."
    },
    {
      "section": null,
      "text": "Læg skiverne let overlappende i et dybt ovnfad. Hæld sojasauce, eddike og sesamolie over, og vend skiverne, så de er dækket."
    },
    {
      "section": null,
      "text": "Bag i ovnen i 40 minutter, til melonen er blød. Lad den køle helt af."
    },
    {
      "section": "Til dippen",
      "text": "Rør ingredienserne til dippen sammen, og hæld den i en lille skål."
    },
    {
      "section": null,
      "text": "Anret den afkølede melon på et fad, og drys med sesamfrø. Server med dippen ved siden af."
    }
