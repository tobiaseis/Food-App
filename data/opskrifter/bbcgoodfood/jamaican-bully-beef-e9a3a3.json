  "steps": [
    {
      "section": null,
      "text": "Varm olien op på en pande ved middel-lav varme."
    },
    {
      "section": null,
      "text": "Kom løg, forårsløg, hvidløg, timian og chili på panden, og lad det stege i 8 minutter, til løgene er lidt bløde."
    },
    {
      "section": null,
      "text": "Tilsæt tomat og peberfrugt, og steg i 4-5 minutter, til det hele er mørt."
    },
    {
      "section": null,
      "text": "Skru op til middel-høj varme. Kom corned beef på panden, og mos den ud med en træske."
    },
    {
      "section": null,
      "text": "Rør ketchup og peber i, og lad retten stege 6 minutter. Rør af og til."
    },
    {
      "section": null,
      "text": "Server med de kogte ris, og drys med timianblade."
    }
  ],
