  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 200 °C (varmluft 180 °C)."
    },
    {
      "section": null,
      "text": "Rør mascarpone, rosmarin og hvidløg sammen, og smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Læg kyllingebrysterne på et skærebræt. Løsn skindet forsigtigt fra kødet, men lad det blive siddende i den ene side."
    },
    {
      "section": null,
      "text": "Fordel mascarponeblandingen under skindet på hvert bryst. Pak to skiver parmaskinke stramt og pænt rundt om hvert bryst, så fyldet bliver derinde."
    },
    {
      "section": null,
      "text": "Varm olien på en slip-let pande, og brun kyllingen hurtigt på begge sider."
    },
    {
      "section": null,
      "text": "Læg kyllingen i et ovnfast fad, og bag den i ovnen i 15-20 minutter, til den lige akkurat er gennemstegt."
    },
    {
      "section": null,
      "text": "Hæld citronsaften i fadet, og rør rundt over varmen, mens du skraber de sprøde stykker løs fra bunden."
    },
    {
      "section": null,
      "text": "Hæld saften over kyllingen, og server med kartofler og grønne bønner."
    }
  ],
  "changes": [
