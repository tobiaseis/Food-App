  "steps": [
    {
      "section": null,
      "text": "Kog de frosne ærter i 3 minutter, til de er møre. Si dem fra, skyl dem under koldt vand i ca. 30 sekunder, og lad dem køle af."
    },
    {
      "section": null,
      "text": "Pisk mel, bagepulver, æg og citronskal sammen i en stor skål til en jævn dej. Rør ricottaen i."
    },
    {
      "section": null,
      "text": "Vend ærter, forårsløg, dild og persille i dejen. Stil den til side."
    },
    {
      "section": null,
      "text": "Varm lidt af olivenolien på en stor pande ved middel-lav varme. Kom en ottendedel af dejen på panden, og form den hurtigt til en rund skive. Gør det samme med resten af dejen, gerne i omgange."
    },
    {
      "section": null,
      "text": "Steg hver fritter i 3-4 minutter, til undersiden er gylden, så den kan vendes. Steg den derefter 2-3 minutter mere, til den er gennemstegt."
    },
    {
      "section": null,
      "text": "Hold de færdige fritter varme i en lav ovn eller under et rent viskestykke, mens resten steges. Server med harissayoghurt, avocado og pocheret æg eller dine yndlingstilbehør."
    }
  ],
  "changes": [
    "Hvedemel og bagepulver erstatter selvhævende mel."
  ]
