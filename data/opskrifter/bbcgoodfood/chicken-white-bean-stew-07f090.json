  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en stor gryde. Brun kyllingen let ved middelhøj varme."
    },
    {
      "section": null,
      "text": "Kom løg, gulerødder og selleri i gryden, og steg dem et par minutter."
    },
    {
      "section": null,
      "text": "Tilsæt timian, laurbærblad og bouillon, og bring det i kog under omrøring."
    },
    {
      "section": null,
      "text": "Skru ned for varmen, læg låg på, og lad retten simre i 40 minutter, til kyllingen er mør."
    },
    {
      "section": null,
      "text": "Vend bønnerne i, og lad dem simre med i 5 minutter."
    },
    {
      "section": null,
      "text": "Rør persillen i, og server gryderetten med godt brød."
