  "steps": [
    {
      "section": null,
      "text": "Hæld fonden i en gryde, og rør karrypasta, fiskesauce, sukker, limesaft og det meste af limeskallen i."
    },
    {
      "section": null,
      "text": "Bring det i kog. Kom champignon og de hvide dele af forårsløgene i, læg låg på, og lad det simre i 2 minutter."
    },
    {
      "section": null,
      "text": "Vend kyllingekødet og det meste af det grønne fra forårsløgene i, og lad suppen varme igennem ved lav varme."
    },
    {
      "section": null,
      "text": "Øs suppen op i skåle, og drys med resten af limeskallen."
    },
    {
      "section": null,
      "text": "Sæt ekstra fiskesauce, sukker og limesaft på bordet, så enhver kan smage sin egen skål til."
    }
  ],
