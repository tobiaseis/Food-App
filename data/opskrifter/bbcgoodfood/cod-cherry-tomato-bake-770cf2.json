  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 200 °C (180 °C varmluft)."
    },
    {
      "section": null,
      "text": "Vend tomater, 2 spsk af basilikummen, oliven, hvidløg og olie sammen i et lille, nonstick bradepande eller et fladt ovnfast fad. Læg torsken ned i fadet."
    },
    {
      "section": null,
      "text": "Bag i ovnen i 15-18 minutter, til fisken er gennemstegt."
    },
    {
      "section": null,
      "text": "Kog imens kartoflerne i en gryde. Sæt et dampindsats over gryden, og damp bønnerne med. Begge dele skal koge i 15 minutter, til de er møre."
    },
    {
      "section": null,
      "text": "Fordel bønnerne på to tallerkener, og læg torsken ovenpå."
    },
    {
      "section": null,
      "text": "Hæld tomaterne med al saften i en skål. Rør resten af basilikummen, den ekstra jomfruolie og balsamico i, og kom blandingen over fisken."
    },
    {
      "section": null,
      "text": "Server med kartoflerne ved siden af og drys eventuelt med peber."
    }
  ],
  "changes": [
    "Fine grønne bønner er skiftet til haricots verts.",
