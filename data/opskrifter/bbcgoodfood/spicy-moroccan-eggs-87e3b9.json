  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en stor, dyb pande. Steg løg og hvidløg i ca. 8 minutter, og rør af og til, til de begynder at få en gylden farve."
    },
    {
      "section": null,
      "text": "Rør harissa og stødt koriander i, og hæld fonden og kikærterne med deres væske i panden. Læg låg på, og lad det småkoge i 5 minutter."
    },
    {
      "section": null,
      "text": "Mos cirka en tredjedel af kikærterne, så saucen tykner lidt."
    },
    {
      "section": null,
      "text": "Kom tomater og squash i panden, og lad det simre ved lav varme i 10 minutter, til squashen er mør."
    },
    {
      "section": null,
      "text": "Vend spinaten i, til den falder sammen. Rør den hakkede koriander ind."
    },
    {
      "section": null,
      "text": "Lav 4 fordybninger i blandingen, og slå et æg ud i hver. Læg låg på, og kog i 2 minutter."
    },
    {
      "section": null,
      "text": "Tag panden af varmen, og lad den stå med låg i 2 minutter, før retten serveres."
    }
  ],
