  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 180 °C varmluft, og sæt 6 muffinforme i en muffinbakke."
    },
    {
      "section": "Dej",
      "text": "Rør hørfrøene ud i vandet i en lille skål, og lad dem stå i 5 minutter, til blandingen er tyk og geleagtig."
    },
    {
      "section": "Dej",
      "text": "Pisk hørfrøgelen sammen med lønnesirup, mandelsmør, mandelaroma, sojayoghurt og plantedrik i en stor skål."
    },
    {
      "section": "Dej",
      "text": "Vend mel, bagepulver og salt i med en spatel, indtil der ikke er mere tørt mel. Rør ikke mere end nødvendigt."
    },
    {
      "section": "Mandelfyld",
      "text": "Bland alle ingredienserne til fyldet i en anden skål, til det danner en tyk pasta."
    },
    {
      "section": "Bagning",
      "text": "Fordel halvdelen af dejen i formene. Læg en klat mandelfyld på hver, og dæk med resten af dejen."
    },
    {
      "section": "Bagning",
      "text": "Drys med mandelflager, og bag muffinsene i 20 minutter, til de er gyldne, og en spids pind kommer ren op af dem."
    },
    {
      "section": "Bagning",
      "text": "Lad dem køle lidt af, og sigt flormelis over, før de serveres."
    }
  ],
