  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 180 °C (varmluft 160 °C). Smør en kvadratisk form på 20 cm og beklæd bunden og siderne med bagepapir."
    },
    {
      "section": null,
      "text": "Rør det smeltede smør sammen med vaniljeekstrakten i en skål."
    },
    {
      "section": null,
      "text": "Bland sukker, hvedemel, bagepulver og kakaopulver i en anden skål."
    },
    {
      "section": null,
      "text": "Hæld smørblandingen ned i de tørre ingredienser, og rør det hele godt sammen. Tilsæt det piskede æg, og rør, til dejen er jævn."
    },
    {
      "section": null,
      "text": "Tryk dejen ud i formen. Pensl overfladen med lidt vand, og drys sukkeret til toppen udover."
    },
    {
      "section": null,
      "text": "Bag kagen i 30-35 minutter."
    },
    {
      "section": null,
      "text": "Lad den stå i formen i 5 minutter. Skær den derefter i kvadrater, og flyt dem over på en bagerist, hvor de køler helt af."
    }
  ],
