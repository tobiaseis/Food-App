  "steps": [
    {
      "section": null,
      "text": "Kom teposer, sukker, honning og vand i en stor kande. Lad teen trække i 10 minutter, og fjern derefter teposerne."
    },
    {
      "section": null,
      "text": "Stil kanden i køleskabet, til teen skal serveres."
    },
    {
      "section": null,
      "text": "Rør citronsaft, citronskiver, appelsinskiver og mynteblade i. Fyld kanden op med rigeligt is, og rør rundt igen."
    },
    {
      "section": null,
      "text": "Fyld høje glas med is, og hæld iste over. Server med ekstra honning, så hver gæst kan søde efter smag."
    }
  ],
