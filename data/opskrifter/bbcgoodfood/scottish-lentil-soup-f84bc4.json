  "steps": [
    {
      "section": null,
      "text": "Kom fond, gulerødder, løg, kålroe og linser i en stor gryde. Krydr med salt og peber."
    },
    {
      "section": null,
      "text": "Lad suppen småkoge ved middel varme i ca. 40 minutter."
    },
    {
      "section": null,
      "text": "Tilsæt kartoflerne, og kog videre i ca. 20 minutter, til de er møre, og linserne er faldet fra hinanden."
    },
    {
      "section": null,
      "text": "Vend kødet i, hvis du bruger det, og lad det varme igennem i nogle minutter."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber. Drys med persille, og server med brød ved siden af."
    }
