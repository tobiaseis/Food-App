  "steps": [
    {
      "section": "Guacamole",
      "text": "Mos avocadoen i en skål. Rør halvdelen af koriander og limesaften i."
    },
    {
      "section": "Guacamole",
      "text": "Smag til med chiliflager, salt og peber. Stil den på køl, til den skal bruges."
    },
    {
      "section": "Fyld",
      "text": "Varm olien op i en stor pande ved middelvarme. Steg den veganske kylling i 2-3 minutter under jævnlig omrøring, til den er gylden på begge sider. Krydr og læg den over i en skål."
    },
    {
      "section": "Fyld",
      "text": "Steg rødløg og hvidløg på samme pande i 8-10 minutter, til kanterne er gyldne."
    },
    {
      "section": "Fyld",
      "text": "Rør chipotle og fajitakrydderi i løgene. Kom kikærter og den stegte vegetarkylling tilbage på panden, og vend det hele godt."
    },
    {
      "section": "Fyld",
      "text": "Lad fyldet simre i 5 minutter, til det er gennemvarmt. Smag til med salt og peber, tag panden af varmen, og pres en limebåd over."
    },
    {
      "section": "Samling",
      "text": "Fordel fyld og guacamole på tortillaerne, og drys med resten af koriander. Server med limebåde, så man selv kan presse lidt over."
    }
  ],
