  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 180 °C (160 °C varmluft). Sæt store papirforme i en muffinplade med 12 forme."
    },
    {
      "section": null,
      "text": "Pisk æg, yoghurt, rapsolie, æblemos, banan, honning og vaniljeekstrakt sammen i en kande."
    },
    {
      "section": null,
      "text": "Bland mel, havregryn, bagepulver, natron, kanel, blåbær og salt i en stor skål. Kernerne og frøene skal ikke med her."
    },
    {
      "section": null,
      "text": "Hæld det våde i det tørre, og rør kun, til dejen er jævn. Rør ikke for meget, ellers bliver muffinsene tunge."
    },
    {
      "section": null,
      "text": "Fordel dejen i formene, og drys med ekstra havregryn og kerner og frø."
    },
    {
      "section": null,
      "text": "Bag muffinsene i 25-30 minutter, til de er gyldne og hævede, og en spids pind fra midten kommer ren ud."
    },
    {
      "section": null,
      "text": "Lad dem køle af på en rist. Opbevar dem i en lufttæt beholder i op til 3 dage."
    }
  ],
  "changes": []
