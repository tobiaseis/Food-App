  "steps": [
    {
      "section": "Grøn chutney",
      "text": "Kom alle ingredienserne til den grønne chutney i en kraftig blender, og kør dem til en helt glat pasta. Stil den til side."
    },
    {
      "section": "Bhel puri",
      "text": "Kog kartoffelstykkerne i letsaltet vand i en lille gryde, til de er møre, så der går 7-9 minutter. Hæld vandet fra, lad kartoflerne køle af, og hak dem fint."
    },
    {
      "section": "Bhel puri",
      "text": "Vend Rice Krispies, kartoffel, chili, snackmix, rødløg, agurk, jordnødder, koriander og chaat masala sammen i en stor skål. Tilsæt sennepsolie, hvis du bruger den, 1 spsk tamarindchutney og 2 spsk af den grønne chutney, og rør det hele godt sammen."
    },
    {
      "section": "Bhel puri",
      "text": "Rør resten af tamarindchutneyen med 1 tsk grøn chutney i en lille skål, og smag til med limesaft."
    },
    {
      "section": "Bhel puri",
      "text": "Anret bhel puri i små skåle. Server tamarindblandingen og resten af den grønne chutney ved siden af."
    }
  ],
  "changes": [
