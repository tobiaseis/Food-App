  "steps": [
    {
      "section": null,
      "text": "Varm olien i en stor gryde ved middel varme. Svits løg, gulerødder og selleri i 8 minutter under omrøring, til de er bløde."
    },
    {
      "section": null,
      "text": "Hæld fonden i, og rør chipotle ud i den. Kog op, og lad det simre i 10 minutter."
    },
    {
      "section": null,
      "text": "Kom halvdelen af suppen i en blender, og blend den glat. Hæld den tilbage i gryden."
    },
    {
      "section": null,
      "text": "Tilsæt kylling, ærter og citronsaft, og smag til med salt og peber. Lad suppen simre i 5 minutter, til alt er varmt."
    },
    {
      "section": "Citronfraiche",
      "text": "Rør citronskallen, hvidløget og lidt vand ind i creme fraichen, til den er letflydende."
    },
    {
      "section": "Til servering",
      "text": "Øs suppen op i skåle, og rør citronfraichen ud i toppen. Drys med chiliflager, hvis du bruger det."
    }
  ],
