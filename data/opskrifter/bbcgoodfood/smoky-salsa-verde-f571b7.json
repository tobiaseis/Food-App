  "steps": [
    {
      "section": null,
      "text": "Tænd ovnens grill, og sæt en rist øverst i ovnen."
    },
    {
      "section": null,
      "text": "Læg tomater, hvidløg, løg og jalapeños på en bageplade. Grill dem i ca. 5 minutter, til de er sorte i kanten."
    },
    {
      "section": null,
      "text": "Tag pladen ud. Pil hvidløgsfeddene, og pres dem ud i en blender eller foodprocessor."
    },
    {
      "section": null,
      "text": "Kom de øvrige ristede grøntsager fra pladen i sammen med salt, chipotle, koriander og limesaft."
    },
    {
      "section": null,
      "text": "Blend til en glat salsa. Smag til, og tilsæt mere salt om nødvendigt."
    }
