  "steps": [
    {
      "section": null,
      "text": "Kog spaghettien i en stor gryde med rigeligt kogende saltvand efter anvisningen på pakken."
    },
    {
      "section": null,
      "text": "Tag 1 spsk olie fra sardindåsen, og varm den op på en non-stick pande ved middelvarme."
    },
    {
      "section": null,
      "text": "Steg kapers og halvdelen af hvidløget i 1-2 minutter, til det dufter."
    },
    {
      "section": null,
      "text": "Kom tomaterne på panden, og steg dem i 4-5 minutter, til de er bløde og begynder at falde fra hinanden."
    },
    {
      "section": null,
      "text": "Rør sardiner og rucola i, og vend rundt nogle gange, så fisken deles i stykker, og rucolaen falder sammen. Smag til med salt og peber."
    },
    {
      "section": "Gremolata",
      "text": "Bland citronskal, persille og resten af hvidløget i en lille skål. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Si pastaen fra, og anret den med sardinsaucen. Top med gremolataen."
    }
  ],
