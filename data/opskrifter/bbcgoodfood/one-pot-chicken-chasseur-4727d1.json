  "steps": [
    {
      "section": null,
      "text": "Varm olie og halvdelen af smørret i en stor gryde med låg."
    },
    {
      "section": null,
      "text": "Krydr kyllingelårene med salt og peber. Brun dem i ca. 5 minutter på hver side, til de er gyldne. Tag dem op og stil dem til side."
    },
    {
      "section": null,
      "text": "Smelt resten af smørret i gryden. Svits løget i ca. 5 minutter, til det er blødt."
    },
    {
      "section": null,
      "text": "Rør hvidløget i og lad det stege i ca. 1 minut. Kom champignon i og steg i 2 minutter, og hæld så rødvinen på."
    },
    {
      "section": null,
      "text": "Rør tomatpuréen ud i væsken, og lad den koge ind i ca. 5 minutter. Tilsæt timian og kyllingefond."
    },
    {
      "section": null,
      "text": "Læg kyllingelårene tilbage i gryden. Læg låg på, og lad det simre ved lav varme i ca. 1 time, til kyllingen er meget mør."
    },
    {
      "section": null,
      "text": "Løft kyllingen op af gryden og hold den varm. Kog saucen kraftigt ind i ca. 10 minutter, til den er sirupsagtig og fyldig i smagen."
    },
    {
      "section": null,
      "text": "Vend kyllingelårene tilbage i saucen og server."
    }
  ],
  "changes": []
