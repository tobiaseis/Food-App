  "steps": [
    {
      "section": "Marinade",
      "text": "Rør alle ingredienserne til marinaden sammen i en skål. Vend kyllingestykkerne i marinaden, så de er dækket hele vejen rundt."
    },
    {
      "section": "Marinade",
      "text": "Lad kyllingen marinere i mindst 20 minutter, eller sæt den køligt til næste dag."
    },
    {
      "section": "Tzatziki",
      "text": "Bland ingredienserne til tzatzikien, og stil den til side, inden du går i gang med airfryeren."
    },
    {
      "section": "Tilberedning",
      "text": "Tilbered pommes fritesene i airfryeren efter anvisningen på posen, typisk ved 200 °C i 15-20 minutter. Ryst dem hvert 5. minut."
    },
    {
      "section": "Tilberedning",
      "text": "Har din airfryer to skuffer, kan kyllingen stå i den anden skuffe samtidig. Har den kun én, så tag pommes fritesene ud og sæt dem til side."
    },
    {
      "section": "Tilberedning",
      "text": "Kom kyllingen i airfryeren, og kør den ved 180 °C i 20-25 minutter. Vend stykkerne halvvejs."
    },
    {
      "section": "Tilberedning",
      "text": "Tag kyllingen ud, og lad den hvile i 5 minutter. Varm imens pommes fritesene igen ved 200 °C i 5 minutter, hvis de har ligget til side."
    },
    {
      "section": "Samling",
      "text": "Skær kyllingen i skiver. Smør tzatziki på hvert fladbrød, og læg tomat, rødløg, kylling og pommes frites ovenpå."
    },
    {
      "section": "Samling",
      "text": "Rul fladbrødene sammen. Pak dem evt. ind i bagepapir, før de serveres."
    }
  ],
