  "steps": [
    {
      "section": "Kagen",
      "text": "Pisk alle de tørre ingredienser sammen i en stor skål – dog ikke kaffepulveret."
    },
    {
      "section": "Kagen",
      "text": "Rør kaffepulveret ud i 200 ml varmt vand i en kande. Tilsæt kokosolie, kokosmælk og vaniljeekstrakt."
    },
    {
      "section": "Kagen",
      "text": "Lad væsken køle, så den føles kold at røre ved. Pisk derefter æggene i ét ad gangen."
    },
    {
      "section": "Kagen",
      "text": "Tænd ovnen på 180 °C (160 °C varmluft). Smør en form på 23 cm med kokosolie, og beklæd bunden med bagepapir."
    },
    {
      "section": "Kagen",
      "text": "Hæld de våde ingredienser over de tørre, og vend det sammen med piskeris, til der ikke er mel tilbage. Rør ikke mere end nødvendigt."
    },
    {
      "section": "Kagen",
      "text": "Vend den rå rødbede i dejen, og fyld den i formen."
    },
    {
      "section": "Kagen",
      "text": "Bag kagen i 45-50 minutter. Den er færdig, når den er fjedrende, og en spiseskefuld af en pind kommer ren op af midten. Lad den køle helt af."
    },
    {
      "section": "Cremen",
      "text": "Pisk mascarpone, honning, flormelis og vaniljepasta glat i en stor skål, mens kagen bager."
    },
    {
      "section": "Cremen",
      "text": "Hæld fløden i en tynd stråle, og pisk, til cremen er glat og danner bløde toppe. Pisk den ikke for meget."
    },
    {
      "section": "Samling",
      "text": "Smør cremen ud over den afkølede kage, og riv den mørke chokolade henover."
    }
  ],
  "changes": [
