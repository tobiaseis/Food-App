  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en stor, slip-let gryde på høj varme. Krydr kyllingelårene med salt og peber, og brun dem på alle sider i 4-5 minutter. Tag dem op med en tang og læg dem på en tallerken."
    },
    {
      "section": null,
      "text": "Sænk varmen og kom løget i gryden. Svits det i 8-10 minutter, til det er blødt. Tilsæt en sjat af fonden, hvis løget er ved at brænde på."
    },
    {
      "section": null,
      "text": "Rør hvidløget i og svits det i 1 minut, til det dufter. Kom derefter begge peberfrugter i gryden."
    },
    {
      "section": null,
      "text": "Tilsæt oregano, farin, sennep, worcestershiresauce, tomatpuré, cola, resten af fonden og ketchup. Bring det i kog."
    },
    {
      "section": null,
      "text": "Skru ned for varmen, læg kyllingen tilbage i gryden, og læg låg på. Lad det simre i 10 minutter, til kyllingen er gennemstegt."
    },
    {
      "section": null,
      "text": "Skru op for varmen, og lad saucen koge ind uden låg i 10 minutter, til den er lidt tykkere."
    },
    {
      "section": null,
      "text": "Drys med forårsløg, og server med ris eller pasta."
    }
  ],
  "changes": [
    "Sennepspulver er erstattet af almindelig sennep.",
    "Ketchup med reduceret salt og sukker er erstattet af almindelig ketchup."
  ]
}
