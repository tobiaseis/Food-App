  "steps": [
    {
      "section": "Bærfyld",
      "text": "Tænd ovnen på 200 °C (180 °C varmluft)."
    },
    {
      "section": "Bærfyld",
      "text": "Vend bærrene i et stort ovnfast fad sammen med marmelade, vanilje, citronsaft og sukker."
    },
    {
      "section": "Bærfyld",
      "text": "Bag i 10 minutter, til bærrene er bløde, men stadig har deres form."
    },
    {
      "section": "Bærfyld",
      "text": "Rør majsstivelsen ud med et par spiseskefulde af saften fra fadet i en lille skål. Vend blandingen i bærrene, og rør godt rundt."
    },
    {
      "section": "Topping",
      "text": "Bland alle ingredienserne til toppingen i en stor skål, og husk saltet."
    },
    {
      "section": "Topping",
      "text": "Pres blandingen sammen i hånden, så der dannes klumper."
    },
    {
      "section": "Topping",
      "text": "Fordel toppingen over bærrene, og sæt fadet tilbage i ovnen i 20 minutter, til overfladen er sprød og gylden."
    },
    {
      "section": "Til servering",
      "text": "Server med tyk græsk yoghurt eller labneh."
    }
  ],
  "changes": [
    "Mixed berries er skrevet som bær, og golden caster sugar er skiftet til almindeligt sukker.",
