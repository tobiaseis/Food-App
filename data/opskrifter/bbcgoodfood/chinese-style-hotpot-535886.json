  "steps": [
    {
      "section": "Suppebund",
      "text": "Varm olien op i en stor, dyb wok eller gryde (ca. 2 liter) over høj varme. Rør tørret chili og sichuanpeber rundt i ca. 5 sekunder, til det dufter."
    },
    {
      "section": "Suppebund",
      "text": "Rør chilibønnesaucen i, og hæld den varme fond over. Kom tørrede shiitake, stjerneanis, mandarinskal (hvis du bruger den), chiliolie og ingefær i, og bring det i kog."
    },
    {
      "section": "Suppebund",
      "text": "Læg kinakålen i bouillonen, og lad den koge i 2 minutter. Tilsæt derefter forårsløgene."
    },
    {
      "section": "Dip 1",
      "text": "Rør alle ingredienserne til den første dip sammen i en skål, og stil den til side."
    },
    {
      "section": "Dip 2",
      "text": "Bland ingredienserne til den anden dip i en anden skål, og stil den til side."
    },
    {
      "section": null,
      "text": "Stil en induktionsplade midt på spisebordet, og anret de rå ingredienser på tallerkener rundt om den. Sæt woken med bouillon på pladen, så den småkoger."
    },
    {
      "section": null,
      "text": "Lad hver gæst lægge det, de vil have, i bouillonen og fiske det op med en hulske eller et trådsold. Kog skaldyr, kylling og svinekød, til de er helt uigennemsigtige, mens grøntsagerne koger efter smag. Server med dipperne."
    }
  ],
  "changes": [
    "Oksemørbrad-udskæringen sirloin er erstattet med entrecote.",
    "Sort riseddike er erstattet med balsamico."
  ]
}
