  "steps": [
    {
      "section": null,
      "text": "Mos avocadoen groft i en skål. Rør det meste af olien, limesaften og de hakkede tomater i, og smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Del bagelsene på midten, og rist dem, til de er lette gyldne."
    },
    {
      "section": null,
      "text": "Smør avocadoblandingen på den nederste halvdel af hver bagel. Læg kylling og spinat ovenpå."
    },
    {
      "section": null,
      "text": "Dryp den resterende olie på de øverste halvdele, og læg dem med olien nedad oven på spinaten. Tryk let til."
    }
