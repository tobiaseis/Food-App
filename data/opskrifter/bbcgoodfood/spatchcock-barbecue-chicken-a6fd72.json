  "steps": [
    {
      "section": null,
      "text": "Rør olie, paprika, hvidløg, citronskal, salt og peber sammen til en marinade."
    },
    {
      "section": null,
      "text": "Pensl marinaden over hele kyllingens skind, og lad den stå i køleskabet i 30 minutter."
    },
    {
      "section": null,
      "text": "Læg kyllingen midt på grillen, og grill den 5 minutter på hver side."
    },
    {
      "section": null,
      "text": "Flyt den derefter ud mod kanten, hvor varmen er mildere, og grill videre. Vend den jævnligt, og pensl den indimellem med øl eller vand."
    },
    {
      "section": null,
      "text": "Tjek, at kyllingen er gennemstegt: Stik en kniv ind mellem lår og brystben. Kødet skal være hvidt og fast, og saften klar."
    },
    {
      "section": null,
      "text": "Med et stegetermometer i den tykkeste del af låret skal det vise 74 °C."
    },
    {
      "section": null,
      "text": "Tag kyllingen af grillen, dæk den med folie, og lad den hvile i 10-15 minutter."
    },
    {
      "section": null,
      "text": "Del kyllingen i portioner. Dryp med citronsaft og lidt olie, og drys med salt, peber og et nip paprika. Server med citronbåde."
    }
