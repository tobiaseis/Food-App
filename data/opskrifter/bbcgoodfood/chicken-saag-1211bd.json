  "steps": [
    {
      "section": "Ris",
      "text": "Kom riset, gurkemeje, kardemommefrø og salt i en gryde. Fyld op med vand, så riset dækkes rigeligt."
    },
    {
      "section": "Ris",
      "text": "Læg låg på og lad det småkoge i 20 minutter. Tag gryden af varmen og stil den til side."
    },
    {
      "section": "Kylling og sauce",
      "text": "Varm olien op i en stor pande ved lav til middel varme. Kom løg, ingefær og hvidløg i, læg låg på, og lad det stege i 5 minutter, til det begynder at tage farve."
    },
    {
      "section": "Kylling og sauce",
      "text": "Rør rundt, tilsæt alle krydderierne, og rist dem kort, til de dufter."
    },
    {
      "section": "Kylling og sauce",
      "text": "Kom kyllingen på panden og rør den rundt et par minutter. Tilsæt tomater, tomatpuré og spinat, og lad det simre under omrøring i 5 minutter, til spinaten er faldet sammen."
    },
    {
      "section": "Kylling og sauce",
      "text": "Retten kan nu tages af varmen, afkøles helt og fryses i op til tre måneder. Tø den helt op før genopvarmning."
    },
    {
      "section": "Kylling og sauce",
      "text": "Rør yoghurten i og varm retten igennem i 1 minut. Si riset om nødvendigt, og server det til kyllingen."
    }
  ],
