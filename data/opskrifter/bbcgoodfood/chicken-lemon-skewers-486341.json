  "steps": [
    {
      "section": "Marinade",
      "text": "Hak halvdelen af myntebladene, og rør dem sammen med yoghurt, halvdelen af citronsaften, al citronskallen, krydderierne og ingefæren."
    },
    {
      "section": "Marinade",
      "text": "Smag til med rigeligt peber og en knivspids salt."
    },
    {
      "section": "Marinade",
      "text": "Vend kyllingestykkerne i marinaden, og lad dem trække i køleskabet i 20-30 minutter."
    },
    {
      "section": "Marinade",
      "text": "Hvis du bruger trææspyd, så læg dem i blød i vand i mindst 20 minutter."
    },
    {
      "section": "Grill",
      "text": "Sæt grillen på middelvarme, og beklæd bakken med alufolie."
    },
    {
      "section": "Grill",
      "text": "Træk kyllingen på spyddene, og grill dem i 15-20 minutter. Vend dem undervejs, til kødet er gyldent og gennemstegt."
    },
    {
      "section": "Servering",
      "text": "Varm brødene få sekunder under grillen."
    },
    {
      "section": "Servering",
      "text": "Fyld dem med salat, kylling og rødløg, og dryp med resten af citronsaften. Drys med resten af mynten."
    },
    {
      "section": "Servering",
      "text": "Server eventuelt med ekstra yoghurt, syltet rødkål, chilisauce og hummus."
    }
  ],
