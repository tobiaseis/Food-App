  "steps": [
    {
      "section": "Harissamayo",
      "text": "Rør mayonnaise og harissa sammen, og sæt blandingen på køl til servering."
    },
    {
      "section": "Braiseret squash",
      "text": "Tag fisken ud af køleskabet 20 minutter før stegning, så den når stuetemperatur."
    },
    {
      "section": "Braiseret squash",
      "text": "Varm olivenolien i en dyb, non-stick pande ved middelhøj varme. Steg fennikelfrø, rødløg og chili med en knivspids salt i 5 minutter, til løgene er bløde og dufter."
    },
    {
      "section": "Braiseret squash",
      "text": "Kom tomater, hvidløg og squash på panden, krydr med salt og peber, og lad det simre sammen i nogle minutter."
    },
    {
      "section": "Braiseret squash",
      "text": "Hæld hvidvin, citronsaft og vand ved, og lad det simre i 15-20 minutter, til tomater og squash falder fra hinanden. Kog overskydende væske ind."
    },
    {
      "section": "Braiseret squash",
      "text": "Vend dilden i, og hold grøntsagerne varme, mens fisken steges."
    },
    {
      "section": "Havbars",
      "text": "Varm olivenolie og timian i en non-stick pande ved lav til middel varme."
    },
    {
      "section": "Havbars",
      "text": "Læg fileterne med skindsiden nedad i panden, og drys kødsiden med salt og peber."
    },
    {
      "section": "Havbars",
      "text": "Steg dem forsigtigt i ca. 8 minutter, til skindet er sprødt. Olien kan sprøjte, så pas på."
    },
    {
      "section": "Havbars",
      "text": "Pres lidt citronsaft over, og øs den varme olie hen over fiskens kødside i ca. 4 minutter, til den er uigennemsigtig og færdig."
    },
    {
      "section": "Havbars",
      "text": "Fordel squashen på tallerkener, læg fisken ovenpå, og server med harissamayo og citronbåde."
    }
  ],
