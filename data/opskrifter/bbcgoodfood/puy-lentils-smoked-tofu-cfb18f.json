  "steps": [
    {
      "section": null,
      "text": "Varm en non-stick pande op med lidt olie. Steg squash, tofu og røget paprika i nogle minutter, til squashen er blød."
    },
    {
      "section": null,
      "text": "Hæld balsamico på panden, og lad den boble og koge ind."
    },
    {
      "section": null,
      "text": "Kom imens linser, rødløg og peberfrugt i en skål, og vend forsigtigt, så linserne slipper hinanden."
    },
    {
      "section": null,
      "text": "Vend den varme squash og tofu i skålen."
    },
    {
      "section": null,
      "text": "Drys med rucola lige før servering. Salaten kan holde sig 2 dage på køl."
    }
  ],
