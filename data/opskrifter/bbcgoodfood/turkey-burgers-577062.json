  "steps": [
    {
      "section": "Til burgerne",
      "text": "Varm halvdelen af olien op på en pande ved lav varme. Steg løget i 5 minutter, til det er blødt."
    },
    {
      "section": "Til burgerne",
      "text": "Tilsæt hvidløget og steg det i 1 minut. Kom havregrynene på og steg dem 2 minutter mere. Hæld blandingen i en skål, og lad den køle af."
    },
    {
      "section": "Til burgerne",
      "text": "Bland kalkun, abrikoser, gulerod og æg i den afkølede blanding med hænderne. Smag til med salt og peber, og form 8 bøffer."
    },
    {
      "section": "Til burgerne",
      "text": "Forvarm ovnen til 200 °C (varmluft 180 °C)."
    },
    {
      "section": "Til burgerne",
      "text": "Varm resten af olien op på en stor non-stick-pande. Brun burgerne 3-4 minutter på hver side, til de har fået god farve."
    },
    {
      "section": "Til burgerne",
      "text": "Læg burgerne på en bageplade, og bag dem i ovnen i 10-15 minutter. Server dem med chutney og agurkeskiver."
    },
    {
      "section": "Til chutneyen",
      "text": "Varm olien op i en pande, og svits løget i 5 minutter, til det er blødt. Tilsæt hvidløget, og lad det stege 1 minut."
    },
    {
      "section": "Til chutneyen",
      "text": "Rør tomatpuré, hakkede tomater og sukker i. Lad det simre ved lav varme i 20-25 minutter, til chutneyen er tyk og fyldig."
    },
    {
      "section": "Til chutneyen",
      "text": "Smag til med salt og peber. Lad chutneyen køle af, inden den serveres."
    }
  ],
