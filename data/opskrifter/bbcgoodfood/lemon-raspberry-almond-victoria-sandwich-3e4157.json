  "steps": [
    {
      "section": "Kagebunde",
      "text": "Tænd ovnen på 180 °C (160 °C varmluft). Smør to springforme på 20 cm, og beklæd bunden med bagepapir."
    },
    {
      "section": "Kagebunde",
      "text": "Fordel halvdelen af de ristede mandler jævnt over bunden af den ene form."
    },
    {
      "section": "Kagebunde",
      "text": "Pisk smør, sukker, vaniljeekstrakt og citronskal med håndmixer i 3-4 minutter, til massen er lys, glat og cremet."
    },
    {
      "section": "Kagebunde",
      "text": "Rør mælken i. Tilsæt æggene ét ad gangen, og pisk grundigt efter hvert."
    },
    {
      "section": "Kagebunde",
      "text": "Vend hvedemel, stødte mandler, bagepulver og salt i med en spatel, til der ikke er mere tørt mel at se."
    },
    {
      "section": "Kagebunde",
      "text": "Del dejen mellem de to forme. Smør den forsigtigt ud over de ristede mandler, så de bliver liggende. Glat toppen."
    },
    {
      "section": "Kagebunde",
      "text": "Tryk halvdelen af hindbærrene ned i dejen."
    },
    {
      "section": "Kagebunde",
      "text": "Bag midt i ovnen i 25-30 minutter, til kagerne er gyldne og hævede, og en spids pind i midten kommer ren ud. Hænger der rå dej på pinden, så bag 5 minutter mere og prøv igen."
    },
    {
      "section": "Kagebunde",
      "text": "Lad kagerne hvile i formene i 30 minutter. Vend dem derefter ud på en rist, træk bagepapiret af, og lad dem køle helt af. Bundene er skrøbelige, så vær forsigtig. De kan fryses indpakket i op til tre måneder."
    },
    {
      "section": "Fyld",
      "text": "Pisk fløde, mascarpone, flormelis og vaniljeekstrakt sammen i et par minutter, til cremen netop kan holde formen."
    },
    {
      "section": "Fyld",
      "text": "Læg bunden uden mandler på et fad. Smør cremen ud til kanten, og drys resten af hindbærrene og de ristede mandler over."
    },
    {
      "section": "Fyld",
      "text": "Læg den anden bund ovenpå med mandlerne opad, og sigt flormelis over. Kagen kan stå på køl i en lufttæt beholder i op til to dage."
    }
  ],
  "changes": [
    "Hvedemel og bagepulver i stedet for selvhævende mel."
  ]
}
