  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 180 °C."
    },
    {
      "section": null,
      "text": "Varm olien op i en stor pande ved middelvarme. Steg løg og hvidløg med saltet i 4 minutter."
    },
    {
      "section": null,
      "text": "Rør tacokrydderi, suppe, hakkede tomater og fond i, og bring det i kog."
    },
    {
      "section": null,
      "text": "Kom kylling, majs og bønner i panden. Skru ned, og lad det simre i 5 minutter."
    },
    {
      "section": null,
      "text": "Hæld blandingen i et ovnfast fad på ca. 33 x 23 cm, og drys halvdelen af osten over."
    },
    {
      "section": null,
      "text": "Knus chipsene let, og fordel dem ovenpå. Dæk med resten af osten."
    },
    {
      "section": null,
      "text": "Bag retten i 25 minutter, til den bobler og er gylden."
    },
    {
      "section": null,
      "text": "Anret i skåle, og server med creme fraiche, avocado, rødløg, koriander, tabasco og Tajín."
    }
  ],
