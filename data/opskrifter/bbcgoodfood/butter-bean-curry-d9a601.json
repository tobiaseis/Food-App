  "steps": [
    {
      "section": "Til karryen",
      "text": "Varm olien op i en non-stick pande ved middel varme. Svits løgene i 8 minutter, til de er bløde."
    },
    {
      "section": "Til karryen",
      "text": "Tilsæt ingefær, hvidløg og chili, og lad det stege i nogle minutter mere."
    },
    {
      "section": "Til karryen",
      "text": "Hæld 300 ml af væsken fra bønnedåserne op i en kande, og rør fondpulveret ud i den. Hvis det klumper, gør det ikke noget – det opløses under kogningen."
    },
    {
      "section": "Til karryen",
      "text": "Rør spidskommen og karry ned i løgene. Kom tomater, bønner og aubergine i panden, og hæld den klargjorte fond over."
    },
    {
      "section": "Til karryen",
      "text": "Bring det i kog, skru ned til middel-lav varme, læg låg på, og lad karryen simre i 30 minutter, til grøntsagerne er møre."
    },
    {
      "section": "Til karryen",
      "text": "Tag panden af varmen, og rør halvdelen af korianderen i."
    },
    {
      "section": "Til raitaen",
      "text": "Vend banan og limesaft sammen. Bland agurk, rødløg, chili og resten af korianderen i."
    },
    {
      "section": "Til karryen",
      "text": "Varm risene efter anvisningen på posen. Server halvdelen af karryen med ris og raita."
    },
    {
      "section": "Til karryen",
      "text": "Afkøl resten af karryen og raitaen, og stil dem i køleskab. Karryen holder sig 3 dage, raitaen 1 dag."
    }
  ],
  "changes": []
