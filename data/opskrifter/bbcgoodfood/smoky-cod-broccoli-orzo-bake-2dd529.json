  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 200 °C (180 °C varmluft)."
    },
    {
      "section": null,
      "text": "Varm olien i en dyb, ovnfast pande. Steg løget i 5 minutter, til det er blødt."
    },
    {
      "section": null,
      "text": "Rør paprika, chipotle, broccoli og fond ned i panden, og kom orzoen i. Sæt panden i ovnen i 10 minutter."
    },
    {
      "section": null,
      "text": "Tag panden ud og vend halvdelen af urterne og de frosne ærter i. Læg torsken ned i orzoen."
    },
    {
      "section": null,
      "text": "Drys fisken med en knivspids paprika, dryp med olie og krydr med salt og peber. Bag i 8-10 minutter, til fisken er gennemstegt og orzoen er mør."
    },
    {
      "section": null,
      "text": "Rør resten af urterne sammen med yoghurten. Tynd den ud med en smule vand, hvis den er for tyk. Server til fisk og orzo."
    }
  ],
