  "steps": [
    {
      "section": "Marinade",
      "text": "Pres saften fra begge limefrugter i en stor skål. Rør oregano, spidskommen, paprika, olivenolie og hvidløg i."
    },
    {
      "section": "Marinade",
      "text": "Skær kyllingen i tern, vend dem i marinaden, og stil skålen til side."
    },
    {
      "section": "Spyd",
      "text": "Fjern kernerne i peberfrugterne, og skær dem i stykker. Del rødløget i både eller stykker."
    },
    {
      "section": "Spyd",
      "text": "Træk kylling, peberfrugt og løg på spyd, så de skiftes. Spydene kan laves flere timer i forvejen og står så på køl, til de skal på grillen."
    },
    {
      "section": "Guacamole",
      "text": "Fjern sten og skræl fra avocadoerne. Kom dem i en skål sammen med lime og cherrytomater, og mos det hele med en kartoffelmoser. Hæld guacamolen i en serveringsskål."
    },
    {
      "section": "Tilberedning",
      "text": "Varm grillen eller en grillpande op. Grill spydene i 10-12 minutter, og vend dem undervejs, til kyllingen er gennemstegt."
    },
    {
      "section": "Tilberedning",
      "text": "Server spydene på varme tortillas med guacamole, creme fraiche eller yoghurt og hakket koriander. Sæt limebåde på bordet, og tilbyd chilisauce til dem, der vil have lidt hede."
    }
  ],
