  "steps": [
    {
      "section": null,
      "text": "Kom lammekødet i en stor gryde sammen med løg, fond, salt og peber."
    },
    {
      "section": null,
      "text": "Bring det i kog ved middel varme. Skru ned, og lad det simre i 2 ½–3 timer."
    },
    {
      "section": null,
      "text": "Sluk for varmen, og øs det grå skum af overfladen."
    },
    {
      "section": null,
      "text": "Løft lammet op af gryden, og lad det køle, til du kan holde på det. Skær kødet fra benene, og stil det til side."
    },
    {
      "section": null,
      "text": "Kom kartofler, gulerødder og kålroe i fonden. Bring den i kog igen, og lad grøntsagerne simre i 25–30 minutter, til de lige er møre."
    },
    {
      "section": null,
      "text": "Rør porrerne og det udbenede kød ned i gryden, og kog videre i 5 minutter, til porrerne er møre."
    },
    {
      "section": null,
      "text": "Server i dybe tallerkener, og drys med persille."
    }
  ],
