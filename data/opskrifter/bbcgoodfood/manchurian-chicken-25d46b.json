  "steps": [
    {
      "section": "Marinade",
      "text": "Pisk æggehvide, sojasauce og majsstivelse sammen i en stor skål. Vend kyllingestrimlerne grundigt i blandingen."
    },
    {
      "section": "Panering",
      "text": "Bland alle ingredienserne til paneringen i en anden skål, og stil den til side."
    },
    {
      "section": "Sauce",
      "text": "Varm olien op i en pande ved middel varme. Rør ingefær, hvidløg og hovedparten af forårsløgene rundt i 1 minut. Gem lidt forårsløg til pynt."
    },
    {
      "section": "Sauce",
      "text": "Tilsæt ketchup, sojasauce, chilisauce og 3 spsk vand, og lad det koge 1 minut."
    },
    {
      "section": "Sauce",
      "text": "Rør majsstivelsen ud i 1 spsk koldt vand, og hæld det i saucen. Skru ned på lav varme, og lad den småkoge et minuts tid, til den tykner. Tag panden af varmen."
    },
    {
      "section": "Til stegning og servering",
      "text": "Hæld en god sjat olie i en stor, bred pande, og varm den ved middel varme."
    },
    {
      "section": "Til stegning og servering",
      "text": "Løft kyllingestykkerne op af marinaden, lad overskuddet dryppe af, og vend dem i paneringen. Ryst overskydende mel af."
    },
    {
      "section": "Til stegning og servering",
      "text": "Læg stykkerne i den varme olie i ét lag. Steg dem 4-5 minutter på hver side, til de er sprøde, lysegyldne og gennemstegte."
    },
    {
      "section": "Til stegning og servering",
      "text": "Lad dem dryppe af i et dørslag over en skål. Steg resten af kyllingen på samme måde."
    },
    {
      "section": "Til stegning og servering",
      "text": "Varm saucen op ved lav varme, mens du steger. Vend al kyllingen forsigtigt i saucen, og drys med de sidste forårsløg. Server gerne med nudler."
    }
  ],
