  "steps": [
    {
      "section": "Sauce",
      "text": "Varm olien op i en stor pande. Steg peberfrugt og hvidløg i 5 minutter, til de er blevet bløde."
    },
    {
      "section": "Sauce",
      "text": "Hæld eddiken på, og lad den koge væk. Kom de hakkede tomater på panden sammen med vandet."
    },
    {
      "section": "Sauce",
      "text": "Læg låg på, og lad saucen småkoge i 10-15 minutter, til peberfrugten er mør, og saucen er tyk."
    },
    {
      "section": "Pandekager",
      "text": "Imens pisker du ét æg med 1 tsk vand, salt og peber. Varm en lille non-stick pande op med et par dråber olie."
    },
    {
      "section": "Pandekager",
      "text": "Hæld ægget på panden, og steg det i 1-2 minutter, til det har sat sig som en tynd pandekage. Læg den på en tallerken under stanniol."
    },
    {
      "section": "Pandekager",
      "text": "Lav de tre øvrige pandekager på samme måde."
    },
    {
      "section": "Pandekager",
      "text": "Rul pandekagerne sammen og læg dem på varme tallerkener. Hæld saucen over, og drys med basilikum."
    },
    {
      "section": "Pandekager",
      "text": "Server med brød eller salat ved siden af."
    }
  ],
