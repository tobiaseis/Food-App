  "steps": [
    {
      "section": "Coleslaw",
      "text": "Bland kål, gulerod, forårsløg, æble, yoghurt, citronsaft og sennep i en stor skål. Smag til med salt og peber, og stil den til side."
    },
    {
      "section": "Schnitzler",
      "text": "Læg kyllingebrysterne mellem to lag husholdningsfilm. Bank dem med en kagerulle, til de er 2-3 mm tykke."
    },
    {
      "section": "Schnitzler",
      "text": "Hæld melet på en tallerken og krydr det med salt og peber. Slå ægget ud på en anden tallerken."
    },
    {
      "section": "Schnitzler",
      "text": "Vend kyllingen først i melet og derefter i ægget."
    },
    {
      "section": "Schnitzler",
      "text": "Bland panko og parmesan i en lav skål. Vend kyllingen i blandingen, så den er dækket hele vejen rundt. Stil den afkølet i køleskabet, hvis den ikke skal steges med det samme."
    },
    {
      "section": "Schnitzler",
      "text": "Varm olien op på en stor pande ved middelhøj til høj varme. Steg 2 schnitzler ad gangen i 2-3 minutter på hver side, til de er helt gyldne."
    },
    {
      "section": "Schnitzler",
      "text": "Læg dem over på køkkenrulle, så fedtet løber af. Hold dem varme i en lav ovn, mens resten steges. Server med coleslawen."
    }
  ],
  "changes": [
    "Vegetabilsk olie er skiftet til rapsolie.",
    "English mustard er skiftet til sennep."
  ]
}
