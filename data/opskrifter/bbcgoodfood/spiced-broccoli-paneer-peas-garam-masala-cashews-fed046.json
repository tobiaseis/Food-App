  "steps": [
    {
      "section": "Marinade og paneer",
      "text": "Rør halvdelen af olien sammen med ingefær, hvidløg, spidskommen, gurkemeje, 1 spsk garam masala, salt og peber i en skål."
    },
    {
      "section": "Marinade og paneer",
      "text": "Vend paneren i marinaden, så alle tern er dækket. Sæt skålen i køleskabet i mindst 2 timer eller natten over."
    },
    {
      "section": "Koriandersauce",
      "text": "Blend koriander, yoghurt og salt med en stavblender eller i en lille food processor, til saucen er helt grøn. Stil den på køl, til den skal bruges."
    },
    {
      "section": "Cashewnødder",
      "text": "Sæt grillen på medium. Vend cashewnødderne med garam masala og havsalt i et fladt ovnfast fad."
    },
    {
      "section": "Cashewnødder",
      "text": "Grill dem i 2 minutter, til de er gyldne, og vend dem undervejs. Kom dem over i en skål og stil dem til side."
    },
    {
      "section": "Grøntsager",
      "text": "Vend broccoli og rosenkål med resten af olien, og krydr med salt og peber. Fordel dem i det samme fad, som cashewnødderne lå i."
    },
    {
      "section": "Grøntsager",
      "text": "Grill i 10 minutter, til grøntsagerne lige begynder at blive møre, og vend dem en enkelt gang undervejs."
    },
    {
      "section": "Grøntsager",
      "text": "Bland paneren med al marinaden ned til grøntsagerne, og grill igen i 10 minutter, til det er gyldent og let svedet."
    },
    {
      "section": "Grøntsager",
      "text": "Strø ærterne ud over og vend det hele godt. Varm igennem under grillen i 1-2 minutter – ikke længere, ellers skrumper ærterne."
    },
    {
      "section": "Til servering",
      "text": "Drys med de krydrede cashewnødder og pres limesaften ud over."
    },
    {
      "section": "Til servering",
      "text": "Dryp med koriandersaucen. Server med mango chutney, varmt naanbrød og limebåde."
    }
  ],
