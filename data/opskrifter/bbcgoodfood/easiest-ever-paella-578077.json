  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en dyb stegepande. Svits porren i 5 minutter, så den bliver blød uden at tage farve."
    },
    {
      "section": null,
      "text": "Kom chorizoen i, og steg den, til fedtet løber ud af den."
    },
    {
      "section": null,
      "text": "Rør gurkemeje og ris i, så risene bliver dækket af fedtet. Hæld fonden over."
    },
    {
      "section": null,
      "text": "Bring det i kog, og lad det simre i 15 minutter. Rør af og til."
    },
    {
      "section": null,
      "text": "Kom ærterne i, og lad dem koge med i 5 minutter."
    },
    {
      "section": null,
      "text": "Vend skaldyrene i, og varm dem 1-2 minutter, til risene er møre."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber, og server straks med citronbåde."
    }
  ],
