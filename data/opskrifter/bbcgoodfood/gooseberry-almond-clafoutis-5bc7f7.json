  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 200 °C (180 °C varmluft). Smør en rund tærteform på 23 cm."
    },
    {
      "section": null,
      "text": "Drys bunden af formen med lidt af sukkeret. Kom stikkelsbærrene i, og ryst formen forsigtigt, så bærrene får et let lag sukker. Stil formen til side."
    },
    {
      "section": null,
      "text": "Pisk æg, hvedemel, malede mandler, vaniljeekstrakt, citronskal, salt og resten af sukkeret sammen i en skål, til dejen er helt glat."
    },
    {
      "section": null,
      "text": "Rør fløden i lidt ad gangen, til den er blandet godt ind, og dejen igen er helt glat."
    },
    {
      "section": null,
      "text": "Hæld dejen over stikkelsbærrene, og strø mandelflager ovenpå."
    },
    {
      "section": null,
      "text": "Bag midt i ovnen i 30-35 minutter, til clafoutisen er hævet og lysebrun."
    },
    {
      "section": null,
      "text": "Lad den køle lidt af, sigt flormelis over, og server den lun."
    }
  ],
  "changes": [
    "Double cream er skiftet til piskefløde."
  ]
