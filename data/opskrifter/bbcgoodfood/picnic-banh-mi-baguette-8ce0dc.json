  "steps": [
    {
      "section": "Syltede grøntsager",
      "text": "Varm eddike, vand, sukker og salt op i en lille gryde ved lav varme, til det damper."
    },
    {
      "section": "Syltede grøntsager",
      "text": "Kom radiser og gulerødder i en skål af glas eller keramik. Hæld den varme lage over, og lad det trække i mindst 30 minutter."
    },
    {
      "section": "Dressing",
      "text": "Rør fiskesauce, limesaft, chili og sukker sammen. Smag til, og tilsæt mere sukker, lime eller fiskesauce efter behov."
    },
    {
      "section": "Baguetter",
      "text": "Bag baguetterne efter anvisningen på pakken."
    },
    {
      "section": "Baguetter",
      "text": "Del baguetterne på langs, og smør dem med smør og derefter leverpostej."
    },
    {
      "section": "Baguetter",
      "text": "Læg svinekam, afdryppede syltede grøntsager, forårsløg, agurk og koriander ovenpå. Dryp med lidt af dressingen."
    },
    {
      "section": "Baguetter",
      "text": "Server med resten af dressingen ved siden af til at dyppe i."
    }
  ],
