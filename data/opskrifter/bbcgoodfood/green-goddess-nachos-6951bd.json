  "steps": [
    {
      "section": "Sauce",
      "text": "Kom alle ingredienserne til saucen i en blender sammen med en god knivspids salt. Blend, til den er helt glat."
    },
    {
      "section": "Sauce",
      "text": "Tynd om nødvendigt ud med en sjat vand, så saucen kan dryppe fra en ske. Smag til med mere salt eller lime."
    },
    {
      "section": "Radiser og bønner",
      "text": "Vend radiserne med limesaften og en knivspids salt i en skål. Lad dem stå og syrne let, mens du laver resten."
    },
    {
      "section": "Radiser og bønner",
      "text": "Rør bønnerne sammen med chipotle, honning og en knivspids salt i en anden skål."
    },
    {
      "section": "Nachos",
      "text": "Tænd ovnen på 200 °C (180 °C varmluft)."
    },
    {
      "section": "Nachos",
      "text": "Læg halvdelen af nachochipsene i et stort ovnfast fad. Fordel halvdelen af fetaen, mozzarellaen og bønnerne over."
    },
    {
      "section": "Nachos",
      "text": "Læg resten af chipsene, mozzarellaen og bønnerne ovenpå, og bag nachos i 20 minutter, til osten er smeltet og gylden."
    },
    {
      "section": "Servering",
      "text": "Dryp lidt af saucen over de varme nachos, og hæld resten i en skål til at dyppe i."
    },
    {
      "section": "Servering",
      "text": "Drys med den resterende feta, de syrnede radiser, jalapeños og rigeligt koriander."
    }
  ],
