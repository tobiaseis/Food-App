  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 180 °C (160 °C varmluft)."
    },
    {
      "section": null,
      "text": "Rør morgenmadsprodukter, sukker, tørret frugt og mælk sammen i en stor skål. Lad blandingen stå, til mælken er trukket ind – mindst 1 time."
    },
    {
      "section": null,
      "text": "Smør en non-stick-brødform på ca. 450 g rigeligt, eller beklæd den med bagepapir."
    },
    {
      "section": null,
      "text": "Vend hvedemel og bagepulver i skålen med den iblødsatte blanding, til der ikke er mel tilbage."
    },
    {
      "section": null,
      "text": "Kom dejen i formen, og bag brødet i 1 time."
    },
    {
      "section": null,
      "text": "Vend brødet ud på en rist, og lad det køle lidt af. Skær det i skiver og server."
    }
  ],
  "title": "Morgenmadsbrød med All-Bran og tørret frugt",
