  "steps": [
    {
      "section": "Pandekager",
      "text": "Bland mel, bagepulver, revet æble, farin og salt i en stor skål."
    },
    {
      "section": "Pandekager",
      "text": "Pisk æg og mælk sammen i en anden skål. Rør det lidt ad gangen ned i melblandingen, til dejen er helt glat."
    },
    {
      "section": "Topping",
      "text": "Pisk fløde og farin til stiv flødeskum med en elpisker."
    },
    {
      "section": "Topping",
      "text": "Vend yoghurt og det meste af limeskallen i skummet. Stil det på køl, til pandekagerne er klar."
    },
    {
      "section": "Pandekager",
      "text": "Varm halvdelen af olien på en pande ved middel varme. Kom 2 spsk dej på panden, og stryg den ud til en lille rund pandekage. Fyld panden på samme måde."
    },
    {
      "section": "Pandekager",
      "text": "Steg pandekagerne i 2-3 minutter, til der kommer bobler på overfladen. Vend dem, og steg i 2-3 minutter mere. Steg resten af dejen i omgange, og brug den sidste olie undervejs."
    },
    {
      "section": "Til servering",
      "text": "Læg toppingen på pandekagerne, og drys med den resterende limeskal. Server med limebåde til at presse over."
    }
  ],
