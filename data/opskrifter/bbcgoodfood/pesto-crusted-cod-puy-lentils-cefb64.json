  "steps": [
    {
      "section": "Pesto",
      "text": "Kom basilikum, de hele hvidløgsfed, pinjekerner, saften fra den halve citron, salt og peber i en food processor. Kør det i korte ryk, og hæld det meste af olien i en tynd stråle undervejs. Smag til med salt og peber."
    },
    {
      "section": "Torsk",
      "text": "Tænd ovnen på 180 °C (160 °C varmluft), og beklæd et fad eller en bradepande med folie."
    },
    {
      "section": "Torsk",
      "text": "Krydr torskefiletterne på begge sider, og smør pestoen tykt ud over dem."
    },
    {
      "section": "Torsk",
      "text": "Bag fisken i 8-10 minutter, til pestoen har dannet en skorpe, og torsken er gennemstegt."
    },
    {
      "section": "Linser",
      "text": "Mens fisken bager, varmes den resterende olie i en lille gryde. Svits det knuste hvidløg og chilien et par minutter, så smagen frigives."
    },
    {
      "section": "Linser",
      "text": "Kom tomaterne i gryden, og lad dem koge med i 1 minut."
    },
    {
      "section": "Linser",
      "text": "Rør linserne i, pres saften fra den anden halve citron ud over, og smag til med salt og peber. Varm det hele godt igennem."
    },
    {
      "section": "Linser",
      "text": "Server linserne sammen med den pestobagte torsk."
    }
  ],
