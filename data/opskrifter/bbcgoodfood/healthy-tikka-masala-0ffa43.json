  "steps": [
    {
      "section": null,
      "text": "Kør løg, hvidløg og ingefær i en foodprocessor, til det er en helt jævn masse."
    },
    {
      "section": null,
      "text": "Varm halvdelen af olien i en gryde med tykt bund ved middel varme. Steg løgmassen i 15 minutter, og kom den derefter over i en skål. Tør gryden ren."
    },
    {
      "section": null,
      "text": "Hæld resten af olien i gryden, og brun kyllingen let i 5-7 minutter."
    },
    {
      "section": null,
      "text": "Rør tikkakrydderiet og cayennepeber i, og steg det med i 1 minut."
    },
    {
      "section": null,
      "text": "Kom løgmassen tilbage i gryden sammen med tomaterne. Fyld tomatdåsen med vand, og hæld det i."
    },
    {
      "section": null,
      "text": "Bring det i kog, skru ned, og lad retten simre uden låg i 15 minutter."
    },
    {
      "section": null,
      "text": "Rør mandler og spinat i, og lad det simre i 10 minutter mere."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber. Vend yoghurt og koriander i lige før servering, og server med brune ris."
    }
  ],
