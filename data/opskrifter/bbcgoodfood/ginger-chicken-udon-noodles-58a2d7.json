  "steps": [
    {
      "section": null,
      "text": "Varm olien i en stor, dyb pande over middelhøj til høj varme."
    },
    {
      "section": null,
      "text": "Rør kylling og hvidkål på den varme pande i 5-7 minutter, til kødet er brunet og næsten gennemstegt."
    },
    {
      "section": null,
      "text": "Kom ingefær og chili i, og steg i nogle minutter, til det dufter."
    },
    {
      "section": null,
      "text": "Tilsæt sojasauce, eddike, mirin, bønnespirer, forårsløg og nudler. Steg under omrøring i 1-2 minutter, til kyllingen er gennemstegt, og nudlerne er varme og møre."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber, og tilsæt gerne lidt mere sojasauce, eddike eller mirin."
    },
    {
      "section": null,
      "text": "Server med koriander og eventuelt syltet ingefær ovenpå."
    }
