  "steps": [
    {
      "section": "Syltet rødløg",
      "text": "Kom rødløg, eddike, sukker, salt og det kogende vand i en lille skål, der ikke er af metal. Dæk til, og lad løgene trække i mindst 30 minutter."
    },
    {
      "section": "Kartofler",
      "text": "Kog kartoflerne i letsaltet vand i 15-20 minutter, til en kniv let glider ind. Hæld vandet fra, og lad dem dampe af."
    },
    {
      "section": "Kartofler",
      "text": "Tænd ovnen på 220 °C (200 °C varmluft). Smør en bageplade let med olie, og læg kartoflerne på den med god afstand."
    },
    {
      "section": "Kartofler",
      "text": "Tryk hver kartoffel flad med bunden af et glas eller en spatel, der er smurt med lidt olie. De skal ligge i ét lag."
    },
    {
      "section": "Kartofler",
      "text": "Dryp med olivenolien, og drys med salt og peber. Bag i 20-25 minutter, til kanterne er gyldne og sprøde."
    },
    {
      "section": "Dressing og anretning",
      "text": "Si løgene, og gem væsken. Pisk olie, sennep og det meste af dilden ned i væsken."
    },
    {
      "section": "Dressing og anretning",
      "text": "Læg de knuste kartofler på et fad, og smuldr fetaen ovenpå. Hæld dressingen over, og top med resten af dilden og de syltede løg."
    }
  ],
