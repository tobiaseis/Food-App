  "steps": [
    {
      "section": null,
      "text": "Rist brødskiven på grill, grillpande eller i brødristeren, til den er gylden og sprød udenpå, men stadig lidt blød indeni."
    },
    {
      "section": null,
      "text": "Gnid den ene side af det varme brød let med den snittede flade af hvidløgsfeddet."
    },
    {
      "section": null,
      "text": "Skær tomaten over på midten. Riv den på den grove side af et rivejern over en sigte, der står i en skål, så overskydende væde løber fra."
    },
    {
      "section": null,
      "text": "Hæld den revne tomat ud over brødet, og drys med salt. Dryp olivenolien over, og server straks."
    }
  ],
