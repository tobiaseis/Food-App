  "steps": [
    {
      "section": "Ris",
      "text": "Kom risene i en mellemstor gryde med vand og salt. Bring det i kog over høj varme."
    },
    {
      "section": "Ris",
      "text": "Skru ned på den laveste varme, læg låg på, og lad risene simre i 15 minutter."
    },
    {
      "section": "Ris",
      "text": "Tag gryden af varmen, luft risene op med en gaffel, og sæt låget på igen. Lad dem trække i 5 minutter."
    },
    {
      "section": "Ris",
      "text": "Smag på risene: Vandet skal være optaget, og kornene bløde, men ikke grødede. Vend sukker og riseddike i, og læg låg på, så de holder sig varme."
    },
    {
      "section": "Grøntsager og laks",
      "text": "Bring en lille gryde med vand i et blidt kog. Kog edamamebønnerne i 3 minutter, og hæld dem fra på et dørslag."
    },
    {
      "section": "Grøntsager og laks",
      "text": "Pil gulerod, og skræl den derefter i lange bånd med skrælleren."
    },
    {
      "section": "Grøntsager og laks",
      "text": "Skær radiserne i tynde skiver. Del agurken i stave, og skær dem i tynde strimler på langs."
    },
    {
      "section": "Grøntsager og laks",
      "text": "Pluk laksen i små stykker med fingrene, og fjern evt. ben undervejs."
    },
    {
      "section": "Anretning",
      "text": "Fordel de varme ris i to skåle, og læg edamame, gulerod, radiser, agurk og laks ovenpå."
    },
    {
      "section": "Anretning",
      "text": "Dryp med sojasauce, og drys med sesamfrø. Server evt. med lidt sushiingefær."
    }
  ],
