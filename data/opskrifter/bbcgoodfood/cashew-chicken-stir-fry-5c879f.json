  "steps": [
    {
      "section": "Sauen",
      "text": "Rør jordnøddesmør, sojasauce og vand sammen i en lille skål, til det er jævnt. Stil den til side."
    },
    {
      "section": "Woken",
      "text": "Kog nudlerne efter anvisningen på pakken, så de lige akkurat er møre. Hæld vandet fra, og lad dem stå i en skål med koldt vand, til du skal bruge dem."
    },
    {
      "section": "Woken",
      "text": "Varm olien op i en wok eller stor pande ved middelhøj varme. Steg hvidløg og chili i 2 minutter, til de er bløde og dufter."
    },
    {
      "section": "Woken",
      "text": "Kom kylling og broccoli i woken, og steg dem under jævnlig omrøring i 5-6 minutter, til begge dele er møre."
    },
    {
      "section": "Woken",
      "text": "Hæld vandet fra nudlerne. Vend dem i woken sammen med gulerødderne, og bland det hele med en tang, til nudlerne er varme hele vejen igennem."
    },
    {
      "section": "Woken",
      "text": "Tag panden af varmen, og rør sauen ud over retten."
    },
    {
      "section": "Servering",
      "text": "Server straks med cashewnødder og forårsløg drysset ovenpå."
    }
  ],
  "changes": [
