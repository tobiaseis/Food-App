  "steps": [
    {
      "section": "Dressing",
      "text": "Pisk alle ingredienserne til dressingen sammen, til den er helt glat."
    },
    {
      "section": "Salat",
      "text": "Kom risnudlerne i en varmefast skål og hæld kogende vand over, så de er dækket. Lad dem stå i 3 minutter, til de er lidt bløde, og si dem fra."
    },
    {
      "section": "Salat",
      "text": "Bland nudler, gulerødder, sukkerærter, forårsløg, koriander, jordnødder, æbler og radiser i en stor skål."
    },
    {
      "section": "Salat",
      "text": "Vend dressingen i, så alt er dækket."
    },
    {
      "section": "Salat",
      "text": "Drys med ekstra koriander og jordnødder, og server med limebåde ved siden af."
    }
