  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en wok med slip-let-belægning."
    },
    {
      "section": null,
      "text": "Steg broccolien ved høj varme i cirka 5 minutter, til den lige er mør. Tilsæt en smule vand, hvis den begynder at sætte sig fast."
    },
    {
      "section": null,
      "text": "Rør hvidløg og chili i og steg i 1 minut."
    },
    {
      "section": null,
      "text": "Vend forårsløg, sojabønner, pak choi og tofu i woken, og wok det hele i 2-3 minutter."
    },
    {
      "section": null,
      "text": "Hæld hoisinsauce og sojasauce over, og kom cashewnødderne i. Lad det varme igennem, og smag til med mere sojasauce, hvis du vil."
    }
