  "steps": [
    {
      "section": null,
      "text": "Varm kokosolien op på en slip-let pande ved lav til medium varme."
    },
    {
      "section": null,
      "text": "Steg tomater og forårsløg forsigtigt i 3-4 minutter, til de er bløde."
    },
    {
      "section": null,
      "text": "Kom fetaen på panden, og lad den varme igennem i 1 minut."
    },
    {
      "section": null,
      "text": "Hæld de piskede æg og purløg på panden, krydr med peber, og rør løbende, til æggene er stivnet til røræg."
    },
    {
      "section": null,
      "text": "Læg en håndfuld af spinaten på en tallerken, og top med røræggen. Server resten af spinaten ved siden af."
    }
