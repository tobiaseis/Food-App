  "steps": [
    {
      "section": "Dej",
      "text": "Pisk kærnemælk, smeltet smør og vanilje sammen i en stor skål."
    },
    {
      "section": "Dej",
      "text": "Skil ægget, og rør blommen ned i kærnemælksblandingen."
    },
    {
      "section": "Dej",
      "text": "Pisk æggehviden i en ren skål til stive toppe. Det er den, der gør vaflerne lette og luftige."
    },
    {
      "section": "Dej",
      "text": "Sigt mel, salt, sukker, bagepulver og natron ned i en anden skål."
    },
    {
      "section": "Dej",
      "text": "Vend den våde blanding i de tørre ingredienser, og pisk til en jævn dej. Vend derefter æggehviden forsigtigt, men bestemt i. Et par små klumper gør ikke noget."
    },
    {
      "section": "Dej",
      "text": "Dæk skålen med film, og lad dejen hvile i 30 minutter, hvis du har tid."
    },
    {
      "section": "Bagning",
      "text": "Pensl vaffeljernet let med olie, og varm det op. Sæt ovnen på lav varme, så de færdige vafler kan holde sig varme."
    },
    {
      "section": "Bagning",
      "text": "Hæld en fjerdedel af dejen i jernet, luk låget, og bag vaflen i 2–2½ minut, til den er gyldenbrun på begge sider og slipper let."
    },
    {
      "section": "Bagning",
      "text": "Gentag med resten af dejen, og server vaflerne med de toppings, du bedst kan lide."
    }
  ],
