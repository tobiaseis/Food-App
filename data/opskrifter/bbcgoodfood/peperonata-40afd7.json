  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en stor pande ved middel varme."
    },
    {
      "section": null,
      "text": "Rør skalotteløg, tomatpuré og salt i panden. Steg i 5-7 minutter, til løgene er bløde og karamelliserede."
    },
    {
      "section": null,
      "text": "Tilsæt hvidløget og steg i 1-2 minutter, til det dufter."
    },
    {
      "section": null,
      "text": "Kom peberfrugt og tomater i panden. Lad det simre i 25-30 minutter under jævnlig omrøring, til blandingen er blød og marmeladeagtig."
    },
    {
      "section": null,
      "text": "Rør eddiken i og smag til med salt og evt. peber."
    },
    {
      "section": null,
      "text": "Lad peperonataen køle af, og opbevar den i en tæt lukket beholder i køleskabet. Den holder sig op til fire dage."
    }
  ],
