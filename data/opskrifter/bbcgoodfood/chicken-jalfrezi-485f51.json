  "steps": [
    {
      "section": "Til kyllingen",
      "text": "Vend kyllingeterningerne i spidskommen, koriander og gurkemeje. Stil dem på køl, mens saucen laves."
    },
    {
      "section": "Til saucen",
      "text": "Brun løg, hvidløg og grøn chili i en stor pande med lidt olie i ca. 5 minutter."
    },
    {
      "section": "Til saucen",
      "text": "Hæld vandet på løgblandingen, og lad den simre i ca. 20 minutter."
    },
    {
      "section": "Til saucen",
      "text": "Blend de flåede tomater helt glatte i en foodprocessor, mens løgene simrer."
    },
    {
      "section": "Til saucen",
      "text": "Varm en anden stor pande, og rist koriander, spidskommen og gurkemeje ved svag varme i lidt olie i ca. 1 minut. Kom de blendede tomater i, og lad det simre i ca. 10 minutter."
    },
    {
      "section": "Til saucen",
      "text": "Blend løgblandingen glat, og rør den ned i tomatsaucen. Smag til med rigeligt salt og peber, og lad saucen simre i 20 minutter. Saucen kan laves i stor mængde og fryses."
    },
    {
      "section": "Til kyllingen",
      "text": "Steg den marinerede kylling i olie under konstant omrøring. Skru ned for varmen efter nogle minutter, og tilsæt løgskiver, peberfrugt og rød chili. Rør, til løg og peberfrugt er møre."
    },
    {
      "section": "Til kyllingen",
      "text": "Hæld saucen over kyllingen, og lad retten simre i 10-20 minutter. Tilsæt en smule vand, hvis den bliver for tyk."
    },
    {
      "section": "Til servering",
      "text": "Rør garam masala og koriander i lige før servering. Server med ris eller naanbrød."
    }
  ],
  "changes": [
