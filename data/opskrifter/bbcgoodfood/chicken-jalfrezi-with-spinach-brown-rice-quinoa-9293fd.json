  "steps": [
    {
      "section": "Ris og quinoa",
      "text": "Skyl de brune ris grundigt i en sigte. Kom dem i en gryde med kogende saltet vand, sænk varmen, og lad dem simre i 20 minutter."
    },
    {
      "section": "Ris og quinoa",
      "text": "Tilsæt quinoaen, og lad det simre videre i 10 minutter. Sigt derefter vandet fra."
    },
    {
      "section": "Jalfrezi",
      "text": "Varm olien op i en stor pande ved middelvarme. Steg løgene, til de lige begynder at tage farve."
    },
    {
      "section": "Jalfrezi",
      "text": "Kom kyllingestrimlerne på panden, og brun dem. Rør spidskommen, hvidløg og ingefær i, og steg under omrøring i ca. 1 minut."
    },
    {
      "section": "Jalfrezi",
      "text": "Tilsæt tomatpuré, gurkemeje, koriander, chili og en knivspids salt. Rør det godt sammen."
    },
    {
      "section": "Jalfrezi",
      "text": "Hæld det kogende vand over, og lad retten simre i ca. 10 minutter, til saucen er dyb rød."
    },
    {
      "section": "Jalfrezi",
      "text": "Rør garam masala, peberfrugt og spinat i. Læg låg på, og lad det koge ved middelvarme i nogle minutter, til spinaten er faldet sammen, og peberfrugterne stadig har lidt bid."
    },
    {
      "section": "Jalfrezi",
      "text": "Justér konsistensen med lidt vand, hvis saucen er for tyk."
    },
    {
      "section": "Til servering",
      "text": "Anret ris og quinoa på tallerkener, og top med kyllingegryden. Drys med hakket koriander."
    }
  ],
