  "steps": [
    {
      "section": "Kyllingeblanding",
      "text": "Tænd ovnen på 200 °C (180 °C varmluft)."
    },
    {
      "section": "Kyllingeblanding",
      "text": "Rør kylling, hakket chili, creme fraiche, spidskommen, hvidløgspulver og limesaft sammen i en skål. Smag til med salt og peber."
    },
    {
      "section": "Samling og bagning",
      "text": "Fordel halvdelen af nachochipsene i et stort ovnfast fad eller på en bageplade."
    },
    {
      "section": "Samling og bagning",
      "text": "Kom halvdelen af kyllingeblandingen og osten udover, og drys med lidt sorte bønner og rødløg."
    },
    {
      "section": "Samling og bagning",
      "text": "Læg endnu et lag på med resten af chipsene, kyllingeblandingen, osten og toppingen."
    },
    {
      "section": "Samling og bagning",
      "text": "Bag i 20 minutter, til osten er smeltet og bobler."
    },
    {
      "section": "Samling og bagning",
      "text": "Strø koriander og de reserverede chiliskiver over. Server med guacamole, salsa og ekstra creme fraiche ved siden af til dypning."
    }
  ],
