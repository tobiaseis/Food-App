  "steps": [
    {
      "section": null,
      "text": "Vend kyllingestrimlerne med limesaft, chili og hvidløg."
    },
    {
      "section": null,
      "text": "Varm olien op på en non-stick pande, og steg kyllingen i et par minutter. Hold øje med den, for den er hurtigt færdig."
    },
    {
      "section": null,
      "text": "Imens opvarmes wrapsene efter anvisningen på pakken. Har du gasblus, kan du i stedet svitse dem over flammen, så de får lidt farve. Lad dem ikke tørre ud, ellers er de svære at rulle."
    },
    {
      "section": null,
      "text": "Mos en halv avocado ud på hver wrap."
    },
    {
      "section": null,
      "text": "Varm peberfrugten igennem på panden sammen med kyllingen, og fordel det over avocadoen."
    },
    {
      "section": null,
      "text": "Drys med koriander, rul wrapsene sammen, del dem på midten, og spis dem med fingrene."
    }
  ],
