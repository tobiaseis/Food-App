  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 200 °C (180 °C varmluft)."
    },
    {
      "section": null,
      "text": "Krydr kyllingestykkerne med salt og peber, og vend dem med en smule af olien. Læg dem i et stort ovnfast fad sammen med hvidløgene, og steg dem i ovnen i 25-30 minutter."
    },
    {
      "section": "Salsa verde",
      "text": "Imens kører du urter, ansjos, kapers, citronsaft og resten af olien i en foodprocessor med salt og peber, til det er fint hakket. Stil det til side."
    },
    {
      "section": null,
      "text": "Tag fadet ud af ovnen. Pres hvidløgsfeddene ud af skallen, og kom risene i fadet. Pil dem fra hinanden med en træske."
    },
    {
      "section": null,
      "text": "Vend spinat og citronskal i, og sæt fadet tilbage i ovnen i 5 minutter."
    },
    {
      "section": null,
      "text": "Fordel retten i skåle, og top med salsa verde."
    }
