  "steps": [
    {
      "section": "Kalkunboller",
      "text": "Kom kalkun, sumak, spidskommen, hvidløg og citronskal i en skål. Krydr med salt og peber, og ælt det hele sammen med hænderne."
    },
    {
      "section": "Kalkunboller",
      "text": "Rul farsen til 10 små boller på ca. 30 g stykket."
    },
    {
      "section": "Kalkunboller",
      "text": "Varm olien op i en pande ved middel varme. Steg bollerne i 8-10 minutter, og ryst panden ind imellem, til de er gyldne og gennemstegte."
    },
    {
      "section": "Kalkunboller",
      "text": "Har du en airfryer, kan du i stedet pensle bollerne med olie og bage dem ved 180 °C i 10-12 minutter. Vend dem undervejs."
    },
    {
      "section": "Salat og servering",
      "text": "Vend hvidkål, mynte, rødløg, agurk og granatæblekerner med citronsaften, og smag til med salt og peber."
    },
    {
      "section": "Salat og servering",
      "text": "Fyld de ristede pitabrød med salaten og kalkunbollerne. Server med yoghurt ved siden af."
    }
  ],
