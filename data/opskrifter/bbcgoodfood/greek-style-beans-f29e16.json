  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en dyb stegepande ved middelhøj varme. Kom løg og en knivspids salt i, og steg dem i 5 minutter, til de bliver bløde og får gyldne kanter."
    },
    {
      "section": null,
      "text": "Rør hvidløg, oregano og tomatpuré i. Skru ned til middel, og steg under omrøring i 3-4 minutter, til puréen er mørkerød."
    },
    {
      "section": null,
      "text": "Hæld hakkede tomater, fond og sukker i. Skyl dåsen med en sjat vand, og hæld det i panden."
    },
    {
      "section": null,
      "text": "Lad saucen simre ved lav til middel varme i 10-12 minutter."
    },
    {
      "section": null,
      "text": "Vend bønnerne i, og lad dem simre med i 2-3 minutter under omrøring."
    },
    {
      "section": null,
      "text": "Smag til med salt, peber og lidt citronsaft."
    },
    {
      "section": null,
      "text": "Drys feta og dild over retten, og server med ristet brød ved siden af."
    }
  ],
