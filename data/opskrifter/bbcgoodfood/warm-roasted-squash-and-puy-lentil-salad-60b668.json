  "steps": [
    {
      "section": "Til squashen",
      "text": "Tænd ovnen på 200 °C (180 °C varmluft)."
    },
    {
      "section": "Til squashen",
      "text": "Vend squashen med olivenolie, hvidløg, timian, salt og peber, og læg den på en bageplade."
    },
    {
      "section": "Til squashen",
      "text": "Bag den i 25-30 minutter, til den er mør."
    },
    {
      "section": "Til dressingen",
      "text": "Rør balsamico, olivenolie, sennep og vand sammen."
    },
    {
      "section": "Til salaten",
      "text": "Hæld væsken fra linserne, og vend dem med dressingen, rødløg, spinat og cherrytomater."
    },
    {
      "section": "Til servering",
      "text": "Fordel linsesalaten på fire tallerkener, og læg den bagte squash ovenpå."
    },
    {
      "section": "Til servering",
      "text": "Smuldr osten ud over, og drys med græskarkerner."
    }
