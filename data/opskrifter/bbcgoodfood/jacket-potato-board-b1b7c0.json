  "steps": [
    {
      "section": "Kartofler",
      "text": "Tænd ovnen på 200 °C (180 °C varmluft). Vælg de mindste kartofler og læg dem på en bageplade."
    },
    {
      "section": "Kartofler",
      "text": "Gnid kartoflerne ind i olie, og drys dem med salt og peber."
    },
    {
      "section": "Kartofler",
      "text": "Bag dem i 50–60 minutter, til de er møre indeni og har sprød skal."
    },
    {
      "section": "Fyld",
      "text": "Rør hvert fyld sammen i sin egen skål, og smag det til med salt og peber."
    },
    {
      "section": "Fyld",
      "text": "Til tunfyldet blandes alle ingredienserne under tunfyldet. Gør det samme med de øvrige tre fyld."
    },
    {
      "section": "Anretning",
      "text": "Skær et kryds i toppen af hver bagt kartoffel, og læg dem på et stort bræt."
    },
    {
      "section": "Anretning",
      "text": "Fyld to kartofler med hvert fyld, og læg dem sammen to og to."
    },
    {
      "section": "Anretning",
      "text": "Top kartoflerne med coronation-kyllingen med lidt mere chutney."
    }
  ],
