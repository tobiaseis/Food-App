  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 200 °C (180 °C varmluft)."
    },
    {
      "section": null,
      "text": "Kom rødløg, kartofler, artiskokker, tomater, forårsløg, pølser, fennikelfrø og citronbåde i en bageplade eller et fad på ca. 20 x 20 cm, og vend det hele sammen."
    },
    {
      "section": null,
      "text": "Dryp olien over, og smag til med peber og lidt salt. Pølserne er ofte salte, så der skal ikke meget til."
    },
    {
      "section": null,
      "text": "Bag i 20 minutter. Tilsæt derefter bønner og fond, og bag videre i 35 minutter."
    },
    {
      "section": null,
      "text": "Tag bakken ud, og rør pestoen let ind. Server med brød, hvis du har lyst."
    }
