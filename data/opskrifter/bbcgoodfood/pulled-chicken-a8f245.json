  "steps": [
    {
      "section": "Kylling",
      "text": "Tænd ovnen på 180 °C (160 °C varmluft)."
    },
    {
      "section": "Kylling",
      "text": "Gnid kyllingelårene ind med halvdelen af chipotlepastaen og krydr med salt og peber."
    },
    {
      "section": "Kylling",
      "text": "Rør resten af chipotlepastaen sammen med passata, barbecuesauce, halvdelen af vandet og halvdelen af løget."
    },
    {
      "section": "Kylling",
      "text": "Hæld saucen i et ovnfast fad, hvor lårene lige akkurat kan ligge i ét lag, og læg kyllingen ned i saucen."
    },
    {
      "section": "Kylling",
      "text": "Dæk fadet tæt med alufolie og bag i 1 time. Tag folien af, skru op på 200 °C (180 °C varmluft), og bag videre i 20 minutter."
    },
    {
      "section": "Avocadosalsa",
      "text": "Vend det resterende løg med limesaft og et nip salt, og lad det trække, mens kyllingen er i ovnen."
    },
    {
      "section": "Bønner",
      "text": "Kom alle bønnerne i en gryde med resten af vandet, og varm dem op ved servering."
    },
    {
      "section": "Kylling",
      "text": "Når kødet er helt mørt, trækkes det af benene med to gafler og blandes i saucen. Kassér benene, og læg folien løst over igen."
    },
    {
      "section": "Bønner",
      "text": "Varm bønnerne i 5-10 minutter, til de er rygende varme og ikke for våde. Varm tacoskallerne efter anvisningen på pakken."
    },
    {
      "section": "Avocadosalsa",
      "text": "Vend avocado og korianderblade i løg-limeblandingen."
    },
    {
      "section": "Til servering",
      "text": "Server pulled chicken og bønner med hjertesalat og tacoskaller eller ris. Top med avocadosalsa, og sæt evt. limebåde på bordet til at klemme over."
    }
  ],
  "changes": [
    "Little Gem er skiftet til hjertesalat.",
