  "steps": [
    {
      "section": "Bulgursalat",
      "text": "Kog bulgur efter anvisningen på posen. Skyl den i en sigte, lad den dryppe godt af, og kom den i en stor skål."
    },
    {
      "section": "Bulgursalat",
      "text": "Vend agurk, tomater, oliven og det meste af persillen i bulguren. Smag til med salt og peber."
    },
    {
      "section": "Harissablanding",
      "text": "Rør harissa, honning, hvidløg, citronsaft og vand sammen i en lille skål. Stil den til side."
    },
    {
      "section": "Fisk",
      "text": "Varm halvdelen af olien i en non-stick pande ved middel varme. Steg rødløget i 4-5 minutter, til det er blødt og let brunet."
    },
    {
      "section": "Fisk",
      "text": "Krydr fisken med salt og peber, og læg den på panden. Steg den i 3 minutter, og hæld så harissablandingen over."
    },
    {
      "section": "Fisk",
      "text": "Vend fisken, og steg den 2-4 minutter mere, afhængigt af tykkelsen. Hæld løbende panden væde over fisken, til den er gennemstegt og kødet er uigennemsigtigt."
    },
    {
      "section": "Servering",
      "text": "Fordel bulgursalaten på to tallerkener. Læg fisk og stegt løg ovenpå, og dryp med pandesaften. Drys med resten af persillen."
    }
  ],
  "changes": [
