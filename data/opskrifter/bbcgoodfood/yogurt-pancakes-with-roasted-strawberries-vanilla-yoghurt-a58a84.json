  "steps": [
    {
      "section": "Ovnbagte jordbær",
      "text": "Forvarm ovnen til 160 °C (140 °C varmluft)."
    },
    {
      "section": "Ovnbagte jordbær",
      "text": "Læg jordbærrene i ét lag i en bageform med bagepapir. Riv citronskallen over, pres saften ud over bærrene, drys med sukker, og vend det hele rundt."
    },
    {
      "section": "Ovnbagte jordbær",
      "text": "Bag i 40-45 minutter, til bærrene er mørke og saftige, men stadig holder formen. Lad dem køle lidt af. De kan holdes 3-4 dage i en lufttæt beholder i køleskabet."
    },
    {
      "section": "Pandekagerne",
      "text": "Mens bærrene bager, pisk yoghurt, æg, sukker og mælk sammen i en stor skål."
    },
    {
      "section": "Pandekagerne",
      "text": "Sigt hvedemel, bagepulver og salt ned i skålen, og vend det forsigtigt sammen til en tyk dej."
    },
    {
      "section": "Pandekagerne",
      "text": "Varm 1-2 tsk olie op i en non-stick pande. Når den er varm, hældes 2-3 spsk dej på panden."
    },
    {
      "section": "Pandekagerne",
      "text": "Steg i 1-2 minutter, til der kommer små bobler på overfladen, og undersiden er gylden. Vend og steg ca. 1 minut mere, til pandekagen er gylden og luftig. Fortsæt med resten af dejen."
    },
    {
      "section": "Vaniljeyoghurt",
      "text": "Rør vaniljeekstrakten ud i yoghurten."
    },
    {
      "section": "Til servering",
      "text": "Anret pandekagerne med en klat vaniljeyoghurt og skefulde af de ovnbagte jordbær med den safte, der er løbet fra dem. Dryp eventuelt lidt honning over."
    }
  ],
  "changes": [
    "Self-raising flour er erstattet med hvedemel og bagepulver (ekstra bagepulver tilføjet)."
  ]
}
