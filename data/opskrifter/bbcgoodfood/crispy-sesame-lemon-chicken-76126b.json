  "steps": [
    {
      "section": "Sauce",
      "text": "Rør maizena ud med citronzest og citronsaft i en skål, til der ikke er klumper."
    },
    {
      "section": "Sauce",
      "text": "Tilsæt honning, sojasauce, sesamfrø og sesamolie, og rør godt. Stil saucen til side."
    },
    {
      "section": "Kylling",
      "text": "Bland maizena, hvedemel, bagepulver, salt, hvid peber, æg og vand til en dej i en stor skål."
    },
    {
      "section": "Kylling",
      "text": "Vend kyllingestykkerne forsigtigt i dejen, så de er dækket hele vejen rundt."
    },
    {
      "section": "Kylling",
      "text": "Varm olien op i en pande ved høj varme. Steg kyllingen i omgange i ca. 6 minutter pr. omgang, til den er gylden og gennemstegt."
    },
    {
      "section": "Kylling",
      "text": "Læg de færdige stykker på en tallerken eller bakke med køkkenrulle."
    },
    {
      "section": "Samling",
      "text": "Kom al kyllingen tilbage på panden ved høj varme. Hæld saucen over og vend rundt, til den tykner og hænger på kyllingen."
    },
    {
      "section": "Samling",
      "text": "Drys med forårsløg, og server evt. med nudler."
    }
  ],
