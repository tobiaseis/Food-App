  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en mellemstor gryde. Svits løg og ingefær ved middel varme i nogle minutter, til løget er blødt."
    },
    {
      "section": null,
      "text": "Rør currypastaen ud i gryden, og lad den stege med i 1 minut."
    },
    {
      "section": null,
      "text": "Hæld de hakkede tomater i, og tilsæt kokoscreme. Bring det i kog, og lad saucen simre i 5 minutter. Tilsæt lidt kogende vand, hvis den bliver for tyk."
    },
    {
      "section": null,
      "text": "Kom rejerne direkte fra frost i saucen, og lad dem simre med i 5-10 minutter, alt efter hvor store de er."
    },
    {
      "section": null,
      "text": "Server curryen med kogte ris, og drys med hakket koriander, hvis du vil."
    }
  ],
