  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en stor gryde med låg ved middel-lav varme. Steg løg, selleri og peberfrugt i 8-10 minutter, til de er møre."
    },
    {
      "section": null,
      "text": "Kom hakket oksekød i gryden, og brun det i 5-6 minutter."
    },
    {
      "section": null,
      "text": "Rør hvidløget i, og steg det i 1 minut. Tilsæt cajun-krydderiet, og lad det stege med i 1 minut. Skru derefter op til middelvarme."
    },
    {
      "section": null,
      "text": "Kom risene i gryden, og hæld fonden over. Læg låg på, og lad retten simre i 15-18 minutter, til risene er møre. Smag på risene efter 10 minutter."
    },
    {
      "section": null,
      "text": "Mangler risene væske, så tilsæt lidt vand eller fond ad gangen."
    },
    {
      "section": null,
      "text": "Drys forårsløg over, og server."
    }
  ],
