  "steps": [
    {
      "section": "Dej",
      "text": "Kom banan, havregryn, æg, mælk, bagepulver, kanel og proteinpulver i en blender."
    },
    {
      "section": "Dej",
      "text": "Blend 1-2 minutter, til dejen er helt glat. Hvis havregrynene ikke er moste, så blend et minut mere."
    },
    {
      "section": "Stegning",
      "text": "Varm lidt olie op på en pande."
    },
    {
      "section": "Stegning",
      "text": "Hæld 2-3 små portioner dej på panden med lidt afstand, så de kan brede sig."
    },
    {
      "section": "Stegning",
      "text": "Steg i 1-2 minutter, til der kommer bobler på overfladen, og undersiden er gylden."
    },
    {
      "section": "Stegning",
      "text": "Vend pandekagerne og steg dem i cirka 1 minut mere, til de er gennemstegte."
    },
    {
      "section": "Stegning",
      "text": "Læg dem i en lun ovn, mens resten af dejen steges på samme måde."
    },
    {
      "section": "Servering",
      "text": "Anret i stakke og top med nøddesmør, lønnesirup og frugt."
    }
  ],
