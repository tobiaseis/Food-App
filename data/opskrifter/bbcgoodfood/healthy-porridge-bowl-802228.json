  "steps": [
    {
      "section": null,
      "text": "Kom halvdelen af hindbærrene og al appelsinsaften i en gryde. Lad det småkoge i ca. 5 minutter, til bærrene er bløde."
    },
    {
      "section": null,
      "text": "Rør imens havregryn, mælk og vand sammen i en anden gryde. Varm det op ved svag varme under omrøring, til grøden er cremet."
    },
    {
      "section": null,
      "text": "Fordel grøden i to skåle. Top med kompot, de resterende hindbær, appelsinskiver, banan, mandelsmør, gojibær og chiafrø."
    }
  ],
