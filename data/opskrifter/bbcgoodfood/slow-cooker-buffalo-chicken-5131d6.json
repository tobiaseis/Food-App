  "steps": [
    {
      "section": null,
      "text": "Hæld hot sauce i slowcookeren og rør hvidløgspulver og løgpulver i."
    },
    {
      "section": null,
      "text": "Læg kyllingelårene ned i saucen. Stik laurbærbladene ind imellem dem, og fordel smørret i små klatter ovenpå."
    },
    {
      "section": null,
      "text": "Sæt slowcookeren på høj varme, og lad kyllingen simre i 3-4 timer, til den er mør og gennemstegt."
    },
    {
      "section": null,
      "text": "Løft lårene op på et skærebræt og pluk kødet i strimler med to gafler."
    },
    {
      "section": null,
      "text": "Kom kødet tilbage i saucen og rør rundt. Fjern laurbærbladene."
    },
    {
      "section": null,
      "text": "Fyld burgerbollerne med kylling og sauce, og server med salat eller coleslaw."
    }
