  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 180 °C (160 °C varmluft). Smør en dyb brødform med rapsolie, og beklæd den med bagepapir."
    },
    {
      "section": "Løgblanding",
      "text": "Varm olien i en stor non-stick pande. Steg løgene i 10 minutter under jævnlig omrøring, til de er gyldne."
    },
    {
      "section": "Løgblanding",
      "text": "Rør hvidløg og krydderier i, og rist dem på panden i 3 minutter. Tilsæt tomatpuréen, og tag halvdelen af blandingen op i en lille skål til toppen."
    },
    {
      "section": "Farsbrød",
      "text": "Kom quinoa og 4 spsk vand på panden med resten af løgblandingen, og lad det simre i 2 minutter. Hæld det i en skål, og lad det køle af i 5 minutter."
    },
    {
      "section": "Farsbrød",
      "text": "Bland gulerod, oregano, spidskommen, kalkun og æg i skålen. Krydr med peber, og ælt det godt sammen."
    },
    {
      "section": "Farsbrød",
      "text": "Pres farsen ned i formen, og bag den uden låg i 35 minutter, til den er fast."
    },
    {
      "section": "Salsa",
      "text": "Vend alle ingredienserne til salsaen sammen i en serveringsskål."
    },
    {
      "section": "Topping",
      "text": "Rør 3 spsk vand og sirup ud i løgblandingen fra den lille skål."
    },
    {
      "section": "Til sidst",
      "text": "Vend farsbrødet forsigtigt ud af formen på et fladt ovnfast fad, og smør løgblandingen ovenpå. Bag det 10 minutter mere, og skær det i skiver. Server med salsaen."
    }
  ],
  "changes": [
