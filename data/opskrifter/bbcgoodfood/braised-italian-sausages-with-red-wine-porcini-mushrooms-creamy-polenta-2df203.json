  "steps": [
    {
      "section": "Pølser og sauce",
      "text": "Læg de tørrede porcini i en varmefast skål, og hæld 150 ml kogende vand over. Lad dem trække, mens du laver resten."
    },
    {
      "section": "Pølser og sauce",
      "text": "Varm halvdelen af olien i en stor, lav gryde eller sauterpande, der tåler ovn og blus, ved middel varme. Brun pølserne i ca. 3 minutter på hver side, og tag dem op på en tallerken."
    },
    {
      "section": "Pølser og sauce",
      "text": "Hæld resten af olien i gryden, og skru op til middelhøj varme. Steg champignon i 5-7 minutter, til det meste af væsken er stegt væk."
    },
    {
      "section": "Pølser og sauce",
      "text": "Tilsæt løg, gulerod, selleri og hvidløg, og steg det under omrøring i 5 minutter."
    },
    {
      "section": "Pølser og sauce",
      "text": "Kom de udblødte porcini med iblødsætningsvæsken, tomater, rosmarin, laurbærblade, rødvin og sukker i gryden. Bring det i kog, og lad det simre i 10 minutter."
    },
    {
      "section": "Pølser og sauce",
      "text": "Læg pølserne tilbage, sæt låg på, og skru ned for varmen. Lad retten simre i 1 time."
    },
    {
      "section": "Polenta",
      "text": "Kog polentaen i mælken efter anvisningen på pakken. Rør parmesan, smør og fløde i, og smag til med salt og peber."
    },
    {
      "section": "Polenta",
      "text": "Anret polentaen med pølserne og saucen. Server med dampede grøntsager, ærter og hakket persille, hvis du vil."
    }
  ],
