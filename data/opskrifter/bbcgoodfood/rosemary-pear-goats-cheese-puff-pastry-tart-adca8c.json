  "steps": [
    {
      "section": "Pærer",
      "text": "Tænd ovnen på 200 °C (180 °C varmluft). Beklæd et ovnfast fad med bagepapir."
    },
    {
      "section": "Pærer",
      "text": "Rør olivenolie, honning, rosmarin og citronsaft sammen i en skål, og smag til med salt og peber."
    },
    {
      "section": "Pærer",
      "text": "Læg pærerne med snitfladen nedad i fadet sammen med hvidløget. Hæld honningblandingen over, og vend pærerne, så de er dækket godt. Læg folie over fadet."
    },
    {
      "section": "Tærten",
      "text": "Rul butterdejen ud med bagepapiret under, og læg den på en bageplade. Rids en kant på ca. ½ cm hele vejen rundt med en skarp kniv, og rids nogle linjer i midten."
    },
    {
      "section": "Tærten",
      "text": "Bag pærer og butterdej sammen i 25-30 minutter. Tag folien af pærerne efter halvdelen af tiden, og hæld stegesaften over dem. Lad både pærer og dej køle af."
    },
    {
      "section": "Tærten",
      "text": "Blend gedeost, creme fraiche, citronskal, salt og peber i en minihakker, til cremen er tyk og glat."
    },
    {
      "section": "Drys og topping",
      "text": "Rist mandler, chili og nigellafrø på en tør pande ved middel varme i nogle minutter. Hæld blandingen i en skål."
    },
    {
      "section": "Samling",
      "text": "Tryk midten af den bagte dej flad med en ske. Smør gedeostcremen ud i midten, og lad kanten være fri."
    },
    {
      "section": "Samling",
      "text": "Fordel det meste af rucolaen over cremen, og læg pærerne ovenpå. Dryp stegesaften over. Top med resten af rucolaen og mandelblandingen, og server."
    }
  ],
