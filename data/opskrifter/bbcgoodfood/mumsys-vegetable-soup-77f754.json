  "steps": [
    {
      "section": "Crutoner",
      "text": "Tænd ovnen på 180 °C (160 °C varmluft)."
    },
    {
      "section": "Crutoner",
      "text": "Vend brødternene på en bageplade med kommenfrø, halvdelen af olien og et nip salt. Bag dem i 10-15 minutter, til de er gyldne og sprøde. Stil dem til side."
    },
    {
      "section": "Suppe",
      "text": "Varm resten af olien op i en stor gryde ved middelvarme, mens crutonerne bager."
    },
    {
      "section": "Suppe",
      "text": "Rør hvidløg, gulerod og kartoffel ned i gryden, og svits under hyppig omrøring i 5 minutter, til de er lidt bløde."
    },
    {
      "section": "Suppe",
      "text": "Hæld fond og hakkede tomater i, og kom cherrytomater, sukker, urtebuketten og selleri i sammen med salt og peber. Bring suppen i et kraftigt kog."
    },
    {
      "section": "Suppe",
      "text": "Skru ned, og lad den simre i 10 minutter. Tilsæt blomkål og hvidkål, og kog videre i 15 minutter, til grøntsagerne er møre."
    },
    {
      "section": "Suppe",
      "text": "Rør worcestershiresauce og sojasauce i. Fjern urtebuketten."
    },
    {
      "section": "Suppe",
      "text": "Øs suppen op i skåle, og top med kommencrutonerne."
    }
  ],
  "changes": [
