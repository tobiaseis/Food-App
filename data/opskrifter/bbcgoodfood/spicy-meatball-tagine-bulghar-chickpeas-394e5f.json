  "steps": [
    {
      "section": "Kødboller",
      "text": "Kør det kvarte løg fint i en foodprocessor. Tilsæt oksekød, tomatpuré, hvidløg, æg og chili, og blend til en nogenlunde jævn farsmasse."
    },
    {
      "section": "Kødboller",
      "text": "Del farsen i 26 lige store stykker og rul dem til kugler."
    },
    {
      "section": "Kødboller",
      "text": "Varm olien i en stor stegepande. Brun kødbollerne let i 5-10 minutter, og læg dem derefter over på en tallerken."
    },
    {
      "section": "Tagine",
      "text": "Svits løgskiverne og gulerødderne kort i stegepanden, til de er lidt bløde."
    },
    {
      "section": "Tagine",
      "text": "Rør spidskommen og koriander i. Hæld tomaterne i sammen med halvanden dåse vand (brug tomatdåsen som mål)."
    },
    {
      "section": "Tagine",
      "text": "Kom citronskal, tomatpuré, oliven og bouillonpulver i, og læg kødbollerne tilbage i panden."
    },
    {
      "section": "Tagine",
      "text": "Læg låg på og lad det simre i 15 minutter, til gulerødderne næsten er møre. Rør frisk koriander i til sidst."
    },
    {
      "section": "Bulgur",
      "text": "Mens tagineen simrer, kommer du bulgur, kikærter med lagen, bouillon og koriander i en gryde. Tilsæt 2 dåser vand (mål med kikærtedåsen)."
    },
    {
      "section": "Bulgur",
      "text": "Læg låg på og kog i 10 minutter, til bulguren er mør, og væsken er optaget. Server bulguren sammen med tagineen."
    }
  ],
