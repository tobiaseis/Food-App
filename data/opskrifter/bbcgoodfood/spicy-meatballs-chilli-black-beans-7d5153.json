  "steps": [
    {
      "section": "Kødbollerne",
      "text": "Kom hakket kalkun i en skål sammen med havregryn, forårsløg, begge krydderier og korianderstilkene. Ælt det let, til det er blandet godt."
    },
    {
      "section": "Kødbollerne",
      "text": "Form 12 kødboller på størrelse med bordtennisbolde."
    },
    {
      "section": "Kødbollerne",
      "text": "Varm olien i en stor pande med slip-let-belægning. Brun kødbollerne ved jævnlig vending, til de er gyldne, og tag dem derefter op af panden."
    },
    {
      "section": "Bønnegryden",
      "text": "Sæt rødløg, hvidløg og peberfrugt på panden, og rør rundt, til grøntsagerne er bløde."
    },
    {
      "section": "Bønnegryden",
      "text": "Rør spidskommen og chipotlepasta ind, og hæld fonden over."
    },
    {
      "section": "Bønnegryden",
      "text": "Læg kødbollerne tilbage i panden. Læg låg på, og lad det simre ved lav varme i 10 minutter."
    },
    {
      "section": "Bønnegryden",
      "text": "Tilsæt tomater og bønner, tag låget af, og lad retten koge et par minutter mere."
    },
    {
      "section": "Servering",
      "text": "Vend avocadostykkerne i limesaften. Anret kødboller og bønner med avocado og korianderblade ovenpå."
    }
  ],
