  "steps": [
    {
      "section": "Dressing",
      "text": "Rør alle ingredienserne til dressingen sammen i en lille skål med 1 spsk vand."
    },
    {
      "section": "Kylling og salat",
      "text": "Vend kyllingebrysterne i 1 spsk af dressingen, så de er dækket hele vejen rundt."
    },
    {
      "section": "Kylling og salat",
      "text": "Varm olien op i en lille non-stick pande med låg. Steg kyllingen under låg i ca. 12 minutter, og vend den undervejs, så den bliver gennemstegt."
    },
    {
      "section": "Kylling og salat",
      "text": "Kog imens kartoflerne i 7 minutter. Kom bønnerne i og kog dem 5 minutter mere, til både kartofler og bønner er møre. Hæld vandet fra."
    },
    {
      "section": "Kylling og salat",
      "text": "Læg kyllingen på en tallerken og lad den hvile."
    },
    {
      "section": "Kylling og salat",
      "text": "Vend kartofler, bønner og resten af salatens ingredienser sammen i en stor skål med halvdelen af dressingen."
    },
    {
      "section": "Kylling og salat",
      "text": "Skær kyllingen i skiver og læg dem ovenpå salaten. Rør saften fra tallerkenen i resten af dressingen og hæld den over."
    }
  ],
