  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en stor pande. Brun bacon og hakket kød i omgange, til det har fået farve."
    },
    {
      "section": null,
      "text": "Kom det brunede kød og baconen over i slowcookeren."
    },
    {
      "section": null,
      "text": "Tilsæt løg, gulerødder, selleri, hvidløg, champignon, hakkede tomater, tomatpuré, krydderurter, laurbærblade, rødvin (hvis du bruger den), eddike og sukker. Smag til med salt og peber, og rør rundt."
    },
    {
      "section": null,
      "text": "Læg låg på, og lad retten simre på lav varme i 6-8 timer."
    },
    {
      "section": null,
      "text": "Tag låget af, skru op på høj varme, og lad sovsen koge ind i en time, til den er tyk."
    },
    {
      "section": null,
      "text": "Server bolognesen over spaghetti, og drys med parmesan."
    }
  ],
  "changes": [
