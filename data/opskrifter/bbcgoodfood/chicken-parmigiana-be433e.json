  "steps": [
    {
      "section": null,
      "text": "Del hvert kyllingebryst i to tynde bøffer ved at skære dem horisontalt. Læg stykkerne mellem to lag film og bank dem med en kagerulle, til de er cirka 3 mm tykke."
    },
    {
      "section": null,
      "text": "Bland rasp med halvdelen af parmesanen. Vend kyllingen først i de piskede æg og derefter i raspblandingen."
    },
    {
      "section": null,
      "text": "Stil den panerede kylling på en tallerken i køleskabet, mens du laver saucen."
    },
    {
      "section": null,
      "text": "Varm olivenolien op i en gryde, og rør hvidløget rundt i 1 minut. Tilsæt passata, sukker og oregano, smag til med salt og peber, og lad saucen simre i 5-10 minutter."
    },
    {
      "section": null,
      "text": "Tænd ovnens grill på høj varme. Grill kyllingen i 5 minutter på hver side, og tag den ud."
    },
    {
      "section": null,
      "text": "Hæld tomatsaucen i et lavt ildfast fad, og læg kyllingen ovenpå."
    },
    {
      "section": null,
      "text": "Fordel mozzarella og resten af parmesanen over kyllingen. Grill retten i 3-4 minutter, til osten er smeltet, og saucen bobler."
    },
    {
      "section": null,
      "text": "Server med grøntsager eller salat og gerne pasta eller kartofler."
    }
  ],
  "changes": []
