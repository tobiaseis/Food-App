  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 180 °C (160 °C varmluft)."
    },
    {
      "section": null,
      "text": "Bland havremel, valleprotein, bagepulver, kanel og mixed spice i en skål."
    },
    {
      "section": null,
      "text": "Tilsæt de mosede bananer, mælken og ægget. Rør, til dejen minder om en kagedej."
    },
    {
      "section": null,
      "text": "Smør en lille ovnfast form eller fire små forme med olie, og fordel dejen i dem."
    },
    {
      "section": null,
      "text": "Træk jordnøddesmørret igennem dejen med en ske, så det danner striber."
    },
    {
      "section": null,
      "text": "Bag i 20-25 minutter, til det er hævet og gyldent."
    },
    {
      "section": null,
      "text": "Tag ud af ovnen, og lad det køle lidt af. Server med yoghurt, bær og ekstra jordnøddesmør."
    }
  ],
  "changes": [
