  "steps": [
    {
      "section": null,
      "text": "Varm olien op på en non-stick pande eller i en wok ved høj varme."
    },
    {
      "section": null,
      "text": "Steg rødløget i 5 minutter."
    },
    {
      "section": null,
      "text": "Tilsæt sukkerærter, babymajs, pak choi og forårsløg, og steg videre i 5 minutter under omrøring."
    },
    {
      "section": null,
      "text": "Kom hvidløg, karry og sojasauce på panden, og steg i 1 minut."
    },
    {
      "section": null,
      "text": "Rør nudlerne i sammen med ingefær og lage, hvis du bruger dem. Tilsæt lidt varmt vand, og varm det hele igennem, til nudlerne er møre."
    },
    {
      "section": null,
      "text": "Fordel i skåle og server med det samme."
