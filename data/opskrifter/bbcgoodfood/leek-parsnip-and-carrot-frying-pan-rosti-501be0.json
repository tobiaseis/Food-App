  "steps": [
    {
      "section": null,
      "text": "Bland porre, gulerødder, pastinakker og hvidløg i en stor skål. Rør det piskede æg i."
    },
    {
      "section": null,
      "text": "Bland mel, løgsalt og peber i en lille skål. Vend det i grøntsagerne, til der ikke er tørt mel tilbage."
    },
    {
      "section": null,
      "text": "Smelt smørret på en non-stick pande ved middel varme. Kom grøntsagsblandingen på panden, og tryk den let ned med en spatel, så den dækker bunden."
    },
    {
      "section": null,
      "text": "Steg i 5-6 minutter, til spatelen let glider ind under kagen."
    },
    {
      "section": null,
      "text": "Vend kagen over på en tallerken, og lad den glide tilbage på panden. Steg den anden side i 5-6 minutter, til den er gylden hele vejen rundt."
    },
    {
      "section": null,
      "text": "Drys med forårsløg og timian. Skær i kvarte eller åttendedele, og server."
    }
  ],
