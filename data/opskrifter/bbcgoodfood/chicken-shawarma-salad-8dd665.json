  "steps": [
    {
      "section": "Kylling og marinade",
      "text": "Rør hvidløg, olie og citronsaft sammen i en skål eller en plastboks med låg."
    },
    {
      "section": "Kylling og marinade",
      "text": "Tilsæt alle krydderierne, oregano, salt og yoghurt, og rør det til en tyk marinade."
    },
    {
      "section": "Kylling og marinade",
      "text": "Vend kyllingen rundt i marinaden, til den er helt dækket. Sæt den tildækket i køleskabet i mindst 1 time – gerne natten over."
    },
    {
      "section": "Tahindressing",
      "text": "Rør tahin, citronsaft, yoghurt og spidskommenfrø sammen i en lille skål. Smag til, dæk til og stil på køl. Dressingen kan laves op til 2 dage i forvejen."
    },
    {
      "section": "Salat",
      "text": "Bland rødkål, rødløg, agurk, tomater og hjertesalat i en stor skål. Den kan stå afdækket på køl i 1-2 timer, inden den skal bruges."
    },
    {
      "section": "Kylling og marinade",
      "text": "Gør grillen klar, eller varm en grillpande op på høj varme. Steg kyllingen i 5 minutter på hver side, til den er let forkullet og gennemstegt. Læg den på et bræt og lad den hvile."
    },
    {
      "section": "Til servering",
      "text": "Hæld citronsaft og olie over salaten, drys med salt og vend det hele rundt. Anret salaten på et stort fad eller i en stor skål."
    },
    {
      "section": "Til servering",
      "text": "Skær kyllingen i skiver og læg den ovenpå salaten. Til vegetarer kan kyllingen serveres ved siden af."
    },
    {
      "section": "Til servering",
      "text": "Server tahindressingen i en skål ved siden af, så den kan drysses over. Tilbehør er ristede pitabrød eller fladbrød til at fylde kyllingen i og syltede jalapeños, hvis man vil."
    }
  ],
  "changes": [
    "Syltede chilier er erstattet af syltede jalapeños.",
    "Little gem-salat er erstattet af hjertesalat."
  ]
