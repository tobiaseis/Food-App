  "steps": [
    {
      "section": "Overnight oats",
      "text": "Kom havregryn, valmuefrø og chiafrø i et glas eller en lufttæt beholder."
    },
    {
      "section": "Overnight oats",
      "text": "Hæld mælken over, og kom yoghurt og lemon curd ovenpå. Rør det hele godt sammen."
    },
    {
      "section": "Overnight oats",
      "text": "Sæt låg på, og stil det i køleskabet natten over. Et par timer er også nok, hvis du har travlt."
    },
    {
      "section": "Til toppen",
      "text": "Tag glasset ud af køleskabet næste morgen."
    },
    {
      "section": "Til toppen",
      "text": "Læg en klat yoghurt øverst, og top med en stribe lemon curd."
    },
    {
      "section": "Til toppen",
      "text": "Drys med valmuefrø og eventuelt hakkede pistaciekerner."
    }
