  "steps": [
    {
      "section": "Dressing",
      "text": "Rør creme fraiche, limeskal, limesaft og sukker sammen i en lille skål. Smag til med salt og peber, og stil dressingen til side."
    },
    {
      "section": "Pasta og rejer",
      "text": "Kog pastaen efter anvisningen på pakken. Kom sukkerærterne i vandet det sidste minut."
    },
    {
      "section": "Pasta og rejer",
      "text": "Varm olien op i en wok eller stor pande. Rør hvidløg og chili rundt på svag til middel varme i ca. 30 sekunder, så hvidløget ikke bliver brunt."
    },
    {
      "section": "Pasta og rejer",
      "text": "Skru op for varmen, og steg rejerne under jævnlig omrøring i ca. 3 minutter, til de er lyserøde."
    },
    {
      "section": "Pasta og rejer",
      "text": "Kom tomaterne på panden, og steg dem i 3 minutter, til de lige begynder at blive bløde."
    },
    {
      "section": "Pasta og rejer",
      "text": "Si pasta og sukkerærter godt af, og vend dem med rejerne på panden."
    },
    {
      "section": "Pasta og rejer",
      "text": "Pluk basilikumbladene over, rør rundt, og smag til med salt og peber."
    },
    {
      "section": "Servering",
      "text": "Anret med salatblandingen, og dryp limedressingen over den. Server med lunt brød ved siden af."
    }
  ],
