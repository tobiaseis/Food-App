  "steps": [
    {
      "section": null,
      "text": "Rør sennep og mayonnaise sammen i en lille skål, og smør blandingen på begge brødskiver."
    },
    {
      "section": null,
      "text": "Læg skinke, kalkun og ost på den ene skive, og læg den anden skive ovenpå."
    },
    {
      "section": null,
      "text": "Pisk æg og mælk sammen i en bred, lav skål eller et fad."
    },
    {
      "section": null,
      "text": "Læg sandwichen i æggeblandingen, og lad den trække nogle minutter på hver side, til brødet har suget det hele til sig."
    },
    {
      "section": null,
      "text": "Smelt smørret på en pande, og læg sandwichen på, når smørret syder."
    },
    {
      "section": null,
      "text": "Steg i 4-5 minutter på hver side, til den er gyldenbrun. Tryk sandwichen ned med en sandwichgrill eller en tung gryde- eller panddelåg, så osten smelter."
    },
    {
      "section": null,
      "text": "Del sandwichen på midten, og server."
    }
  ],
