  "steps": [
    {
      "section": null,
      "text": "Varm olien op på en pande ved middel varme. Svits løget i 5-8 minutter, til det er lysegyldent."
    },
    {
      "section": null,
      "text": "Rør chili, hvidløg og ingefær i og steg dem i ca. 1 minut. Tilsæt gurkemeje, spidskommen og stødt koriander."
    },
    {
      "section": null,
      "text": "Kom cherrytomaterne på panden sammen med en sjat vand. Lad det småkoge i 5 minutter, til tomaterne er sprunget, og saucen er tyknet."
    },
    {
      "section": null,
      "text": "Rør tamarindpasta og rejer i. Lad det simre i 2-3 minutter, til rejerne er gennemvarme og kogte."
    },
    {
      "section": null,
      "text": "Anret curryen over risene og drys med korianderblade."
    }
  ],
