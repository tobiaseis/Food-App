  "steps": [
    {
      "section": null,
      "text": "Varm ovnen op til 190 °C (170 °C varmluft)."
    },
    {
      "section": null,
      "text": "Vend brødstykkerne med 2 spsk af olivenolien samt salt og peber. Læg dem på en bageplade, og bag dem i 12-15 minutter, til de er gyldne og sprøde. Stil dem til side."
    },
    {
      "section": null,
      "text": "Kog imens æggene i letsaltet vand i 7 minutter. Afkøl dem straks i isvand, og pil dem."
    },
    {
      "section": null,
      "text": "Rør yoghurt, citronskal, citronsaft, sesamolie, purløg, den hakkede dild, sesamfrø og resten af olivenolien sammen i en stor skål. Smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Vend agurkeskiverne i dressingen sammen med størstedelen af croutonerne og halvdelen af ørreden."
    },
    {
      "section": null,
      "text": "Hæld salaten ud på et fad. Pil resten af ørreden i stykker, og læg den ovenpå sammen med de resterende croutoner og æggene delt i halve."
    },
    {
      "section": null,
      "text": "Kværn lidt peber over, drys med de gemte dildkviste, og server med det samme."
    }
  ],
  "changes": [
