  "steps": [
    {
      "section": null,
      "text": "Kom rejerne i et fladt fad, og pres halvdelen af limesaften ud over dem. Stil fadet til side."
    },
    {
      "section": null,
      "text": "Skær agurken i små tern, og vend dem med hvidvinseddike og dild i en skål. Lad dem trække."
    },
    {
      "section": null,
      "text": "Halvér avocadoen, fjern stenen, og skræl den. Skær kødet i små tern, og vend dem forsigtigt med resten af limesaften."
    },
    {
      "section": "Cocktailsaucen",
      "text": "Rør mayonnaise, creme fraiche og ketchup sammen. Smag til med tabasco, worcestershiresauce og brandy."
    },
    {
      "section": "Anretning",
      "text": "Fordel lidt af saucen i bunden af fire cocktailglas."
    },
    {
      "section": "Anretning",
      "text": "Hak det meste af karsen groft, og gem et par kviste til pynt. Læg den hakkede karse oven på saucen."
    },
    {
      "section": "Anretning",
      "text": "Si agurkerne godt fra, og fordel dem sammen med avocadoen over karsen."
    },
    {
      "section": "Anretning",
      "text": "Top med rejerne, og hæld resten af saucen over. Stik karsekvistene ned i glassene, og drys med cayennepeber."
    }
  ],
  "changes": [
    "Fromage frais er erstattet af creme fraiche."
