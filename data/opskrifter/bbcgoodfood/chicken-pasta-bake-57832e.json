  "steps": [
    {
      "section": "Tomatsauce",
      "text": "Varm olien i en gryde ved middel varme. Svits løget forsigtigt i 10-12 minutter, til det er blødt."
    },
    {
      "section": "Tomatsauce",
      "text": "Rør hvidløg og chiliflager i og steg i 1 minut."
    },
    {
      "section": "Tomatsauce",
      "text": "Hæld tomater og sukker i, og smag til med salt og peber. Lad saucen simre uden låg i 20 minutter, til den er tyk. Rør mascarpone ind til sidst."
    },
    {
      "section": "Kylling og pasta",
      "text": "Varm olien på en slip-let pande. Krydr kyllingestrimlerne med salt og peber, og steg dem i 5-7 minutter, til de er gennemstegte."
    },
    {
      "section": "Kylling og pasta",
      "text": "Tænd ovnen på 220 °C (varmluft 200 °C)."
    },
    {
      "section": "Kylling og pasta",
      "text": "Kog pastaen efter anvisningen på pakken. Hæld vandet fra, og vend pastaen med olien."
    },
    {
      "section": "Kylling og pasta",
      "text": "Kom pastaen i et mellemstort ovnfast fad. Bland kyllingen i, og dæk med tomatsaucen."
    },
    {
      "section": "Topping",
      "text": "Drys med cheddar, mozzarella og persille."
    },
    {
      "section": "Topping",
      "text": "Bag retten i 20 minutter, til den er gylden og bobler i kanterne."
    }
  ],
