  "steps": [
    {
      "section": null,
      "text": "Tænd ovnens grill på højeste varme."
    },
    {
      "section": null,
      "text": "Pisk æggene sammen i en skål, og smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Smelt smørret på en ovnfast pande ved middel varme. Hæld æggene på panden, og lad dem stege i 2 minutter."
    },
    {
      "section": null,
      "text": "Fordel krabbekød og asparges midt på omeletten. Drys med chili, og tryk spinaten ned i æggemassen."
    },
    {
      "section": null,
      "text": "Sæt panden under grillen i 2-3 minutter, til spinaten er faldet sammen, og omeletten har hævet sig."
