  "steps": [
    {
      "section": null,
      "text": "Varm olien i en stor, lav pande, og svits løg og hvidløg, til de er møre."
    },
    {
      "section": null,
      "text": "Kom lammekødet på panden, og rør rundt i 3-4 minutter, til det er brunet."
    },
    {
      "section": null,
      "text": "Tilsæt hakkede tomater, tomatpuré og kanel, og krydr kraftigt med salt og peber."
    },
    {
      "section": null,
      "text": "Lad det simre i 20 minutter. Vend de hakkede auberginer i midtvejs."
    },
    {
      "section": null,
      "text": "Fordel feta og mynte over kødet, og stil panden på bordet, mens osten blødgør. Server med sprød grøn salat og ristet pitabrød."
    }
