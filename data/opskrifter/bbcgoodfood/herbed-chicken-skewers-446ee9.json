  "steps": [
    {
      "section": "Til spyddene",
      "text": "Brug du træspyd eller bambusspyd, så læg 8 stk. i koldt vand i cirka en halv time."
    },
    {
      "section": "Til spyddene",
      "text": "Kog kartoflerne i letsaltet vand i 10-12 minutter, til de netop er møre. Hæld vandet fra, og lad dem køle af."
    },
    {
      "section": "Til spyddene",
      "text": "Rør urter, olie, citronsaft, salt og peber sammen i en stor skål. Vend kylling og kartofler i marinaden, til alt er dækket af olie."
    },
    {
      "section": "Til spyddene",
      "text": "Del løget i 6 både, og pil lagene fra hinanden. Vend løg og peberfrugt i marinaden."
    },
    {
      "section": "Til tomatrelishen",
      "text": "Halver tomaterne, og fjern kernerne. Hak kødet fint."
    },
    {
      "section": "Til tomatrelishen",
      "text": "Bland tomat med chili, hvidløg, olie, eddike, salt og peber. Kom relishen i en lille skål."
    },
    {
      "section": "Til spyddene",
      "text": "Træk kylling, kartofler, peberfrugt og løg på de 8 spyd, og slut af med en citronbåd på hver."
    },
    {
      "section": "Til spyddene",
      "text": "Grill spyddene direkte over middelhøj varme i 5-6 minutter på hver side, til kyllingen er gennemstegt."
    },
    {
      "section": "Til spyddene",
      "text": "Anret spyddene på et stort fad, og server dem med tomatrelishen."
    }
  ],
  "changes": [
    "Vinaigre af hvid vin er skiftet til hvidvinseddike."
  ]
