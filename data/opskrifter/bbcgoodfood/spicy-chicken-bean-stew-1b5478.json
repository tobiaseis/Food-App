  "steps": [
    {
      "section": null,
      "text": "Træk skindet af kyllingestykkerne og kassér det."
    },
    {
      "section": null,
      "text": "Varm olien op i en stor gryde. Brun kyllingen på alle sider, og tag den op med en hulske."
    },
    {
      "section": null,
      "text": "Kom løg, hvidløg og chili i gryden. Steg dem i ca. 5 minutter, til de begynder at blive bløde og gyldne."
    },
    {
      "section": null,
      "text": "Tilsæt peberfrugt, hakkede tomater, begge slags bønner og den varme fond. Læg kyllingen oven på."
    },
    {
      "section": null,
      "text": "Læg låget halvt på, og lad retten simre i 50 minutter, til kyllingen er mør og gennemstegt."
    },
    {
      "section": null,
      "text": "Rør koriander i lige før servering. Server med creme fraiche og brød."
    }
  ],
