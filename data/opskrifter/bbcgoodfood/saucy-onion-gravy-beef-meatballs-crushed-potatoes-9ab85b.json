  "steps": [
    {
      "section": "Kødboller",
      "text": "Tænd ovnen på 220 °C (200 °C varmluft), og pensl en bageplade med olie."
    },
    {
      "section": "Kødboller",
      "text": "Ælt oksekød, æg, 1 spsk mel, salt og peber sammen i en stor skål."
    },
    {
      "section": "Kødboller",
      "text": "Form så mange kødboller som muligt med en iskugleske, og læg dem på bagepladen."
    },
    {
      "section": "Kødboller",
      "text": "Bag dem i 10-12 minutter, til de er jævnt brune."
    },
    {
      "section": "Sauce",
      "text": "Imens varmes olien i en lille gryde ved middel varme. Brun champignonerne i et par minutter, til de får lidt farve."
    },
    {
      "section": "Sauce",
      "text": "Rør resten af melet, paprika, sennep og tomatpuré ind, så svampene er dækket."
    },
    {
      "section": "Sauce",
      "text": "Hæld fonden i, smag til med salt og peber, og lad det simre i 5-6 minutter, til saucen er lidt tykkere."
    },
    {
      "section": "Sauce",
      "text": "Skru ned på lav varme, rør cremefraichen i, og lad saucen koge 1 minut."
    },
    {
      "section": "Sauce",
      "text": "Kom kødbollerne i gryden, og vend dem rundt i saucen."
    },
    {
      "section": "Til servering",
      "text": "Server kødbollerne og saucen med kartoffelmos og stuvet spinat."
    },
    {
      "section": "Til servering",
      "text": "Rester kan fryses, når de er helt kolde, i op til 3 måneder. Tø dem op i køleskabet natten over, og varm dem igennem, til de er dampende varme."
    }
  ],
