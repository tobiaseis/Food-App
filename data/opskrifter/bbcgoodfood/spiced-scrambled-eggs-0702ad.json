  "steps": [
    {
      "section": null,
      "text": "Smelt smørret på en pande, og svits løg og chili ved middel varme, til de er bløde."
    },
    {
      "section": null,
      "text": "Rør æggene sammen med mælken, hæld dem på panden, og rør forsigtigt rundt."
    },
    {
      "section": null,
      "text": "Vend tomater og koriander i, når æggene næsten er stivnet."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber, og server straks på ristet brød."
