  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 180 °C (160 °C varmluft). Beklæd et ovnfast fad eller en bradepande med bagepapir."
    },
    {
      "section": null,
      "text": "Rør farin, paprika, timian, oregano, hvidløgspulver, salt og peber sammen til en krydderblanding."
    },
    {
      "section": null,
      "text": "Læg kyllingebrysterne i fadet. Har de skind, skal det vende opad."
    },
    {
      "section": null,
      "text": "Fordel krydderblandingen ligeligt på brysterne, og gnid den ind i kødet på alle sider."
    },
    {
      "section": null,
      "text": "Bag kyllingen i 25-30 minutter, til den er gennemstegt. Skorpen bliver mørkere, og sukkeret karamelliserer."
    },
    {
      "section": null,
      "text": "Server med kartoffelbåde og grønt, hvis du vil."
    }
