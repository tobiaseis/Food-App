  "steps": [
    {
      "section": "Salsa",
      "text": "Tænd ovnens grill. Beklæd en bageplade med alufolie."
    },
    {
      "section": "Salsa",
      "text": "Læg tomaterne med snitfladen opad på pladen sammen med løgskiverne, jalapeños og de uskrællede fed hvidløg. Drys med salt."
    },
    {
      "section": "Salsa",
      "text": "Grill i 8 minutter, til det hele er sort i kanterne."
    },
    {
      "section": "Salsa",
      "text": "Kom grøntsagerne i en blender – dog ikke hvidløget. Tilsæt chipotle, vand, salt, limesaft og koriander."
    },
    {
      "section": "Salsa",
      "text": "Pil hvidløget, og kom det i blenderen. Blend til en jævn salsa, og hæld den i en stegepande."
    },
    {
      "section": "Chips og æg",
      "text": "Skru ovnen til 200 °C. Fordel tortillachipsene på en bageplade, og varm dem i 5 minutter."
    },
    {
      "section": "Chips og æg",
      "text": "Imens: Varm olien i en anden stegepande over høj varme, til den er meget varm."
    },
    {
      "section": "Chips og æg",
      "text": "Slå æggene ud i panden, og steg dem som spejlæg, til hviden er stivnet. Smag til med salt og peber, og tag panden af varmen."
    },
    {
      "section": "Chips og æg",
      "text": "Varm salsaen op ved lav varme. Vend de varme chips i, til de er dækket af salsa, og hold dem varme ved lav varme."
    },
    {
      "section": "Servering",
      "text": "Fordel chilaquilesene på fire tallerkener. Læg et spejlæg på hver, og top med feta, koriander, avocado og rødløg."
    }
  ],
  "changes": [
    "Queso fresco er udeladt til fordel for feta, som kilden også nævner.",
    "Lime er skrevet som citron efter varekataloget."
  ]
