  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en stor gryde ved lav til middel varme. Svits gulerødder, selleri, løg og krydderurter i 10-12 minutter under jævnlig omrøring, til grøntsagerne er bløde, men ikke brunede."
    },
    {
      "section": null,
      "text": "Sæt en smule vand til, hvis grøntsagerne begynder at sætte sig fast."
    },
    {
      "section": null,
      "text": "Rør hvidløg og begge peberfrugter i, og lad det stege i 5 minutter, til peberfrugterne begynder at blive møre."
    },
    {
      "section": null,
      "text": "Skru op til middel varme, drys chili og paprika over, og rør rundt i 1 minut. Tilsæt tomatpuréen, og lad den stege med i 1 minut."
    },
    {
      "section": null,
      "text": "Hæld begge slags bønner, de hakkede tomater og fonden i gryden."
    },
    {
      "section": null,
      "text": "Rør godt rundt, og bring det i kog. Skru ned, så det simrer, og lad chilien koge i 25-35 minutter, til bønnerne er møre, og saucen er tyknet til."
    },
    {
      "section": null,
      "text": "Server med ris, revet cheddar og creme fraiche."
    }
  ],
  "changes": [
