  "steps": [
    {
      "section": null,
      "text": "Tænd ovnens grill på høj varme."
    },
    {
      "section": null,
      "text": "Varm olien op i en mellemstor non-stick-pande. Brun svampene på høj varme i 3 minutter."
    },
    {
      "section": null,
      "text": "Pres pølsekødet ud af skindet i små klumper, og kom det på panden. Steg det i yderligere 5 minutter, til det er gyldent."
    },
    {
      "section": null,
      "text": "Tilsæt hvidløg og asparges, og steg i 1 minut mere."
    },
    {
      "section": null,
      "text": "Pisk æg, creme fraiche, sennep og estragon sammen i en kande, og smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Hæld æggeblandingen over indholdet i panden, og lad det stege i 3-4 minutter."
    },
    {
      "section": null,
      "text": "Sæt panden under grillen i 1-2 minutter, til toppen lige er stivnet, men midten stadig er lidt blød."
    },
    {
      "section": null,
      "text": "Server med rucola, hvis du vil."
    }
  ],
