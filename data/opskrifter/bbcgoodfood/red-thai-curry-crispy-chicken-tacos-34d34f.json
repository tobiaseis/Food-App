  "steps": [
    {
      "section": "Kyllingen",
      "text": "Bland panko og paprika på en tallerken med en god knivspids salt."
    },
    {
      "section": "Kyllingen",
      "text": "Vend kyllingestrimlerne i lidt olie, og tryk dem derefter ned i pankoblandingen, så de er dækket hele vejen rundt."
    },
    {
      "section": "Kyllingen",
      "text": "Varm en stor, bred non-stick pande med lidt olie op ved middelhøj varme. Steg strimlerne i 5-6 minutter på hver side, til de er gyldne og gennemstegte."
    },
    {
      "section": "Karrymayo og coleslaw",
      "text": "Rør currypasta, mayonnaise, 1 spsk af vandet, salt og peber sammen i en lille skål, mens kyllingen steger."
    },
    {
      "section": "Karrymayo og coleslaw",
      "text": "Kom halvdelen af karrymayoen i en stor skål sammen med coleslawmixet, og vend det godt rundt."
    },
    {
      "section": "Karrymayo og coleslaw",
      "text": "Rør resten af vandet ud i den resterende karrymayo, så den bliver tyndere."
    },
    {
      "section": "Til servering",
      "text": "Læg tortillaerne på en tallerken, og varm dem i mikroovnen på fuld styrke i 20 sekunder, til de er varme."
    },
    {
      "section": "Til servering",
      "text": "Fyld tortillaerne med coleslaw, sprød kylling og karrymayo. Dryp med sriracha, og drys med koriander."
    },
    {
      "section": "Til servering",
      "text": "Server resten af karrymayoen ved siden af som dip."
    }
  ],
