  "steps": [
    {
      "section": "Den syltede rødkål",
      "text": "Kom rødkålen i en skål med eddike, sukker og salt. Ælt det igennem med fingrene, til kålen er dækket af marinaden. Stil skålen i køleskabet."
    },
    {
      "section": "Koftaerne",
      "text": "Bland lammekød, spidskommen, koriander, za'atar, hvidløg og rødløg i en stor skål. Ælt det godt sammen med hænderne, og form blandingen til 14-15 runde, flade bøffer."
    },
    {
      "section": "Mangoyoghurten",
      "text": "Rør yoghurt, mango chutney og salt sammen, og stil saucen til side."
    },
    {
      "section": "Stegning",
      "text": "Varm en stor pande op med en del af olien på middel varme. Læg bøfferne forsigtigt i den varme olie, og steg dem 2-3 minutter på hver side, til de lige akkurat er gennemstegte, så de forbliver saftige."
    },
    {
      "section": "Servering",
      "text": "Varm fladbrødene. Smør mangoyoghurt på, og læg koftaer, rødkål, dild, syltede rødløg og chili samt oliven ovenpå."
    }
  ],
