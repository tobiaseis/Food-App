  "steps": [
    {
      "section": null,
      "text": "Smelt smør og olie i en stor ovnfast stegepande ved middelhøj varme. Tilsæt løg og salt, og hæld det kogende vand over."
    },
    {
      "section": null,
      "text": "Lad det koge kraftigt i 15-20 minutter, til vandet er helt væk."
    },
    {
      "section": null,
      "text": "Tænd ovnen på 200 °C varmluft (220 °C almindelig ovn)."
    },
    {
      "section": null,
      "text": "Rør farin og grov sennep ind i løgene, og tag dem over i en skål."
    },
    {
      "section": null,
      "text": "Brun pølserne let på alle sider i den samme pande. Kom løgene tilbage, og læg pølserne ovenpå."
    },
    {
      "section": null,
      "text": "Hæld øllet over, og bring det i kog. Sæt panden i ovnen i 45-50 minutter. Vend pølserne nogle gange, til de er mørkebrune, og væsken er kogt ind."
    },
    {
      "section": "Til dijonnaisen",
      "text": "Rør Dijon-sennep og mayonnaise sammen, mens retten står i ovnen. Smag til med salt og peber."
    },
    {
      "section": "Servering",
      "text": "Skær hotdogbrødene op, og smør dijonnaise i bunden af hvert brød. Læg løg og pølse i, og drys eventuelt med ristede løg."
    }
  ],
  "changes": [
    "Crispy onions er skrevet som ristede løg, som kan købes i Danmark.",
    "Pale ale er skrevet som almindelig lys øl."
  ]
