  "steps": [
    {
      "section": "Nihari-masala",
      "text": "Kom alle krydderierne til masalaen i en krydderikværn eller minihakker sammen med det varme vand. Kør det til en helt fin pasta."
    },
    {
      "section": "Nihari-masala",
      "text": "Tag 3 tsk af pastaen fra og gem den til servering."
    },
    {
      "section": "Gryderet",
      "text": "Varm olie og ghee op i en stor, tung gryde ved middelvarme. Steg ingefær og hvidløg i ca. 2 minutter, til det dufter."
    },
    {
      "section": "Gryderet",
      "text": "Læg lammeskankene i gryden og brun dem hele vejen rundt i ca. 10 minutter."
    },
    {
      "section": "Gryderet",
      "text": "Rør chilipulver, resten af masalapastaen og saltet i. Steg i 1-2 minutter, til krydderierne dufter. Tilsæt en sjat vand, hvis det sætter sig fast."
    },
    {
      "section": "Gryderet",
      "text": "Hæld vandet i, så kødet netop er dækket. Bring det i kog, sæt låg på og lad det simre ved middel-lav varme i 45 minutter til 1 time."
    },
    {
      "section": "Gryderet",
      "text": "Tag 150 ml af væsken op, og pisk den sammen med begge slags mel, til der ikke er klumper. Rør blandingen tilbage i gryden."
    },
    {
      "section": "Gryderet",
      "text": "Læg låg på og lad retten simre ved lav varme i 2 timer mere, til kødet er så mørt, at det falder fra hinanden."
    },
    {
      "section": "Servering",
      "text": "Anret nihari med koriander, ingefær, chili, sprøde løg og citronbåde. Drys med den gemte masala, og server naanbrød ved siden af."
    }
  ],
