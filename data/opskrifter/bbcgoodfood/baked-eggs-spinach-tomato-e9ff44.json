  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 200 °C (180 °C varmluft)."
    },
    {
      "section": null,
      "text": "Kom spinaten i et dørslag og hæld kogende vand fra en kedel over, så bladene falder sammen. Pres vandet godt ud, og fordel spinaten i 4 små ovnfaste forme."
    },
    {
      "section": null,
      "text": "Rør de hakkede tomater sammen med chiliflagerne, salt og peber. Hæld blandingen over spinaten."
    },
    {
      "section": null,
      "text": "Lav en lille fordybning midt i hver form, og slå et æg ud i den."
    },
    {
      "section": null,
      "text": "Bag i 12-15 minutter, eller lidt længere, hvis du vil have æggene mere faste."
    },
    {
      "section": null,
      "text": "Server evt. med godt brød."
    }
