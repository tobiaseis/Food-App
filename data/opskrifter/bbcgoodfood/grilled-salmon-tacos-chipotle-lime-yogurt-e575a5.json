  "steps": [
    {
      "section": "Laks",
      "text": "Tænd ovnens grill på høj varme."
    },
    {
      "section": "Laks",
      "text": "Bland hvidløgssalt, paprika, sukker, salt og peber, og gnid blandingen ind i laksens kødside."
    },
    {
      "section": "Chipotleyoghurt",
      "text": "Rør yoghurt, chipotle og limesaft sammen i en skål. Smag til med salt og peber, og stil den til side."
    },
    {
      "section": "Laks",
      "text": "Læg laksen med skindsiden nedad på en bageplade med bagepapir eller folie. Grill den i 7-8 minutter, til den er gennemstegt."
    },
    {
      "section": "Laks",
      "text": "Tag laksen ud, og træk skindet forsigtigt af. Kassér skindet."
    },
    {
      "section": "Til servering",
      "text": "Del laksen i store stykker. Server med de varme tortillas, chipotleyoghurt, kål, koriander, jalapeños og limebåde."
    },
    {
      "section": "Til servering",
      "text": "Dryp med stærk chilisauce, hvis du vil have det skarpt."
    }
  ],
