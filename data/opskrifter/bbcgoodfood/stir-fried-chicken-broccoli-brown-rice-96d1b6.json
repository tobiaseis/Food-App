  "steps": [
    {
      "section": null,
      "text": "Kog vand op i en kedel. Kom broccolien i en mellemstor gryde, hæld det kogende vand over, og lad den koge i 4 minutter."
    },
    {
      "section": null,
      "text": "Varm olien i en non-stick wok. Rør ingefær, hvidløg og rødløg rundt i 2 minutter, og drys med chili. Rør kort."
    },
    {
      "section": null,
      "text": "Kom kyllingen i woken, og steg under omrøring i yderligere 2 minutter."
    },
    {
      "section": null,
      "text": "Si broccolien fra, og gem lidt af kogevandet. Kom broccoli, sojasauce, honning, peberfrugt og 4 spsk af kogevandet i woken. Varm det hele igennem."
    },
    {
      "section": null,
      "text": "Varm imens risene efter anvisningen på posen, og server dem sammen med woken."
    }
