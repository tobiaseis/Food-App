  "steps": [
    {
      "section": null,
      "text": "Kog spaghettien i letsaltet vand efter anvisningen på pakken."
    },
    {
      "section": null,
      "text": "Smelt smørret på en stor pande ved middel varme. Når det skummer, kommer skalotteløg på panden sammen med en knivspids salt og lidt friskkværnet peber."
    },
    {
      "section": null,
      "text": "Steg løgene i 5-6 minutter, til de er møre og let gyldne. Skru derefter ned på lav varme."
    },
    {
      "section": null,
      "text": "Tilsæt hvidløget og rør rundt."
    },
    {
      "section": null,
      "text": "Løft spaghettien direkte fra gryden over på panden. Rør krabbekød, parmesan og en øse pastavand i."
    },
    {
      "section": null,
      "text": "Vend det hele grundigt, og tilsæt mere pastavand efter behov, til saucen er blank."
    },
    {
      "section": null,
      "text": "Server med ekstra parmesan, peber og eventuelt purløg."
    }
  ],
  "changes": [
