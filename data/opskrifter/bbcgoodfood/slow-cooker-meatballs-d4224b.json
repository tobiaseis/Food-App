  "steps": [
    {
      "section": "Tomatsauce",
      "text": "Forvarm slowcookeren, hvis den har brug for det."
    },
    {
      "section": "Tomatsauce",
      "text": "Varm olien op i en non-stick pande. Svits løg, gulerødder, selleri og hvidløg ved svag varme i cirka et minut."
    },
    {
      "section": "Tomatsauce",
      "text": "Hæld passataen over, kom persillen i og rør rundt. Overfør det hele til slowcookeren."
    },
    {
      "section": "Kødboller",
      "text": "Kom kalkunfarsen i en stor skål sammen med havregryn, paprika, hvidløg og rigeligt peber. Ælt det godt sammen med hænderne."
    },
    {
      "section": "Kødboller",
      "text": "Del farsen i 20 stykker på størrelse med en valnød, og rul dem til runde boller."
    },
    {
      "section": "Kødboller",
      "text": "Pensl eller sprøjt en non-stick pande let med olie. Brun bollerne forsigtigt, til de begynder at tage farve."
    },
    {
      "section": "Kødboller",
      "text": "Læg bollerne ned i tomatsaucen, og lad dem simre på lav varme i 5 timer."
    },
    {
      "section": "Kødboller",
      "text": "Server med ris, pasta eller grøn salat."
    }
  ],
