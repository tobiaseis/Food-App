  "steps": [
    {
      "section": null,
      "text": "Varm olien op i en lav gryde med låg. Svits løgene ved middellav varme i 5 minutter, til de er bløde."
    },
    {
      "section": null,
      "text": "Læg kyllingen i gryden, og skru op til middel varme. Rør hvidløg, sukker, oregano, spidskommenfrø, salt og peber i."
    },
    {
      "section": null,
      "text": "Steg i et par minutter. Tilsæt chipotle, og steg et par minutter mere."
    },
    {
      "section": null,
      "text": "Hæld passata og vand i, og opløs bouillonterningen i saucen. Smag til med salt og peber, og bring det i kog."
    },
    {
      "section": null,
      "text": "Læg låg på, og lad retten simre i 40-50 minutter. Rør af og til, til kyllingen er mør."
    },
    {
      "section": null,
      "text": "Træk kødet i stykker med to gafler direkte i saucen. Rør bønnerne i, og lad det simre 5 minutter mere."
    },
    {
      "section": null,
      "text": "Tag gryden af varmen, og pres limesaft i."
    },
    {
      "section": null,
      "text": "Server med ris eller tortillas og kom koriander, feta, limebåde og rødløg ved siden af, hvis du vil. Chilien holder 3 dage i køleskabet og op til 2 måneder i fryseren. Tø den helt op, og varm den igennem."
    }
  ],
  "changes": [
    "Chipotle in adobo er erstattet af chipotlepasta, som er nemmere at få."
  ]
}
