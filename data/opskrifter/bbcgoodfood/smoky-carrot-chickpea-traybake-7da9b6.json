  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 200 °C (180 °C varmluft)."
    },
    {
      "section": null,
      "text": "Kom 1 spsk af olien i en stor bradepande sammen med løg, hvidløg, krydderier, gulerødder, tomater og kikærter, og vend det hele godt rundt."
    },
    {
      "section": null,
      "text": "Skyl tomatdåsen med lidt vand, og hæld skyllevandet i bradepanden. Smag til med salt og peber, og rør en sjat citronsaft i."
    },
    {
      "section": null,
      "text": "Bag i ovnen i 35-40 minutter, til gulerødderne er møre, og saucen er kogt ind."
    },
    {
      "section": null,
      "text": "Rør imens citronskal, feta og krydderurter sammen med resten af olien, og stil blandingen til side."
    },
    {
      "section": null,
      "text": "Smag retten til med salt, peber og citronsaft. Fordel fetablandingen ovenpå, og server med fladbrød, så man kan dyppe i gulerødder og kikærter."
    }
  ],
