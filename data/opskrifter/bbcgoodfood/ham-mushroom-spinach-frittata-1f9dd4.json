  "steps": [
    {
      "section": null,
      "text": "Tænd ovnens grill på højeste varme."
    },
    {
      "section": null,
      "text": "Varm olien op i en ovnfast pande ved middelhøj varme. Steg champignon i 2 minutter, til de næsten er møre."
    },
    {
      "section": null,
      "text": "Vend skinke og spinat i panden, og lad det stege i 1 minut, til spinaten er faldet sammen. Smag til med peber og salt."
    },
    {
      "section": null,
      "text": "Skru ned for varmen, og hæld æggene over. Lad dem stå uden at røre i 3 minutter, til de næsten er stivnet."
    },
    {
      "section": null,
      "text": "Drys med ost, og sæt panden under grillen i 2 minutter. Server frittataen varm eller kold."
    }
