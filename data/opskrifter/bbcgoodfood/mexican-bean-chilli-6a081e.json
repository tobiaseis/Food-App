  "steps": [
    {
      "section": null,
      "text": "Svits løg og peberfrugt i olivenolie ved middelvarme i 10-15 minutter, til de er bløde."
    },
    {
      "section": null,
      "text": "Skru op for varmen, og rist chilipulveret med i et par minutter."
    },
    {
      "section": null,
      "text": "Kom hakket oksekød i panden, og steg det, til det er brunet, og væsken er kogt helt væk."
    },
    {
      "section": null,
      "text": "Rør baked beans, oksefond og chipotle i. Lad det småkoge ved svag varme i 15-20 minutter."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber. Drys med koriander, og server med ris og yoghurt."
    }
