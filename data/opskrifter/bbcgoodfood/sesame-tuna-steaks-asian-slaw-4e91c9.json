  "steps": [
    {
      "section": "Til salaten",
      "text": "Rør sesamolie, limesaft, salt og peber sammen i en stor skål."
    },
    {
      "section": "Til salaten",
      "text": "Vend rødkål, chili, peberfrugt, bønnespirer og peanuts i dressingen."
    },
    {
      "section": "Til tunen",
      "text": "Varm en non-stick-pande op, til den er rygende varm."
    },
    {
      "section": "Til tunen",
      "text": "Krydr tunsteaksene med salt og peber på begge sider, og vend dem derefter i sesamfrøene, så de er dækket hele vejen rundt."
    },
    {
      "section": "Til tunen",
      "text": "Steg tunen i 3 minutter på hver side. Den skal have en brunet sesamskorpe og stadig være lyserød indeni."
    },
    {
      "section": "Til tunen",
      "text": "Lad steaksene hvile et par minutter. Server dem med salaten og limebådene, som man presser over."
    }
  ],
