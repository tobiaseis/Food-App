  "steps": [
    {
      "section": null,
      "text": "Varm olien i en stor gryde. Svits løg og selleri ved svag varme i 10 minutter under jævnlig omrøring, til de er bløde."
    },
    {
      "section": null,
      "text": "Rør spidskommen i og steg den cirka 1 minut."
    },
    {
      "section": null,
      "text": "Skru op for varmen. Hæld fond, tomater og kikærter i, og peb rigeligt. Lad suppen simre i 8 minutter."
    },
    {
      "section": null,
      "text": "Kom de frosne bønner og citronsaften i, og lad suppen koge 2 minutter mere."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber. Hak urterne, og drys dem over sammen med citronskallet. Server med fladbrød."
    }
