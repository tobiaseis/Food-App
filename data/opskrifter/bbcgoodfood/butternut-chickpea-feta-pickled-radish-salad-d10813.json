  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 200 °C (180 °C varmluft)."
    },
    {
      "section": null,
      "text": "Rør olie og harissa sammen i en stor bradepande. Vend butternut squash i blandingen, og krydr med salt og peber."
    },
    {
      "section": null,
      "text": "Bag i ovnen i 30 minutter. Vend kikærterne i panden, og bag videre i 20 minutter."
    },
    {
      "section": "Syltede radiser",
      "text": "Imens bringes eddike, sukker, salt og vand i kog i en lille kasserolle. Lad det simre kort."
    },
    {
      "section": "Syltede radiser",
      "text": "Tag kasserollen af varmen, kom radiserne i, og rør rundt. Stil dem til side."
    },
    {
      "section": "Til anretning",
      "text": "Læg squash og kikærter på et fad. Vend det meste af fetaen og dilden i."
    },
    {
      "section": "Til anretning",
      "text": "Fordel radiserne med væden over. Drys med resten af fetaen og dilden samt græskarkernerne."
    }
  ],
