  "steps": [
    {
      "section": "Patéen",
      "text": "Læg makrelfileterne i en skål og tilsæt resten af ingredienserne til patéen."
    },
    {
      "section": "Patéen",
      "text": "Mos det hele med en gaffel, til det er blandet, men stadig lidt grovkornet. Smag til med peber. Makrellen er salt, så ekstra salt er sjældent nødvendigt."
    },
    {
      "section": "Patéen",
      "text": "Stil patéen på køl. Den kan laves dagen før."
    },
    {
      "section": "Kartoflerne",
      "text": "Tænd ovnen på 220 °C (200 °C varmluft)."
    },
    {
      "section": "Kartoflerne",
      "text": "Kog kartoflerne i letsaltet vand i en stor gryde. Lad dem simre i 20 minutter, til en kniv glider let ind."
    },
    {
      "section": "Kartoflerne",
      "text": "Hæld vandet fra, og lad kartoflerne dampe af i nogle minutter."
    },
    {
      "section": "Kartoflerne",
      "text": "Vend kartoflerne med lidt af olien, og læg dem i ét lag på en stor bageplade."
    },
    {
      "section": "Kartoflerne",
      "text": "Tryk dem let flade med bagsiden af en gaffel eller en kartoffelmoser. De skal revne, men holde formen."
    },
    {
      "section": "Kartoflerne",
      "text": "Dryp det meste af den resterende olie over, krydr med salt, peber og evt. paprika, og vend dem rundt."
    },
    {
      "section": "Kartoflerne",
      "text": "Bag dem i 40 minutter. Vend dem undervejs, og dryp resten af olien over, til de er dybt gyldne og sprøde."
    },
    {
      "section": "Servering",
      "text": "Anret kartoflerne på et fad, og drys med dild. Server patéen i en skål ved siden af, så den kan øses over."
    }
  ],
