  "steps": [
    {
      "section": null,
      "text": "Varm halvdelen af gheen op i en stor wok eller pande ved høj varme."
    },
    {
      "section": null,
      "text": "Brun kyllingen på alle sider i 5-6 minutter. Den skal ikke være gennemstegt. Tag den op på en tallerken med en hulske."
    },
    {
      "section": null,
      "text": "Skru ned til middel varme, og kom resten af gheen i panden. Steg løget i 2-3 minutter."
    },
    {
      "section": null,
      "text": "Tilsæt hvidløg og chili, og steg videre i 7-9 minutter, til løgene er bløde og klare."
    },
    {
      "section": null,
      "text": "Kom kyllingen tilbage i panden sammen med tamarind, garam masala og chaat masala. Smag til med salt og peber, og rør så alt er dækket af krydderiblandingen."
    },
    {
      "section": null,
      "text": "Læg låg på, og lad retten simre i 5 minutter, til kyllingen er gennemstegt."
    },
    {
      "section": null,
      "text": "Tag panden af varmen, og lad den stå i 2 minutter. Vend tomat og agurk i."
    },
    {
      "section": null,
      "text": "Drys med koriander og forårsløg, og server med citronbåde at presse over."
    }
  ],
