  "steps": [
    {
      "section": null,
      "text": "Varm en stor, tør stegepande op ved middel varme. Steg champignonerne, til de har afgivet væde, og det er kogt væk."
    },
    {
      "section": null,
      "text": "Tilsæt olien og steg champignonerne 5-6 minutter længere, til de er gyldne. Tag dem af panden og stil dem til side."
    },
    {
      "section": null,
      "text": "Smelt smørret i samme pande. Svits løg og grøn peberfrugt ved middel-lav varme i 8-10 minutter, til de er møre."
    },
    {
      "section": null,
      "text": "Rør paprika og sennep i, hæld sherryen på, og lad det koge i 2 minutter, så alkoholen fordamper."
    },
    {
      "section": null,
      "text": "Skru op til middel varme. Kom kyllingen og champignonerne tilbage på panden, smag til med salt og peber, og hæld fonden over. Lad det simre i 5 minutter."
    },
    {
      "section": null,
      "text": "Tilsæt fløden og de ristede peberfrugter. Varm det igennem i 2-3 minutter, til det lige akkurat simrer."
    },
    {
      "section": null,
      "text": "Smag til med citronsaft og server med kogte ris."
    }
  ],
  "changes": [
    "Double cream er skiftet til piskefløde."
  ]
}
