  "steps": [
    {
      "section": "Kylling",
      "text": "Kom olie, krydderurter, krydderier og hvidløg i en stor frysepose, der kan lukkes."
    },
    {
      "section": "Kylling",
      "text": "Læg kyllingebrysterne i posen, og vend dem, så de er dækket helt af marinaden."
    },
    {
      "section": "Kylling",
      "text": "Slå brysterne lidt flade med en kagerulle, og lad dem marinere i mindst 15 minutter."
    },
    {
      "section": "Bønnesalat",
      "text": "Vend alle ingredienserne til salaten sammen i en stor skål, og stil den til side."
    },
    {
      "section": "Guacamole",
      "text": "Kom avocadoens frugtkød i en skål, og mos det groft med bagsiden af en ske."
    },
    {
      "section": "Guacamole",
      "text": "Rør de øvrige ingredienser i. Vil du have den mere cremet, så mos avocadoen sammen med olie og limesaft, inden resten røres i."
    },
    {
      "section": "Kylling",
      "text": "Tænd for grillen, og beklæd en grillbakke med folie."
    },
    {
      "section": "Kylling",
      "text": "Læg kyllingen på bakken, og grill den i 5 minutter, mens du kigger til den undervejs."
    },
    {
      "section": "Kylling",
      "text": "Vend brysterne, når de er gyldne, og grill dem 5-7 minutter mere. Tjek midten efter 5 minutter – er kødet gennemstegt, tages det ud."
    },
    {
      "section": null,
      "text": "Gem to bryster og lidt guacamole til en sandwich på rugbrød en anden dag."
    },
    {
      "section": null,
      "text": "Anret et varmt kyllingebryst på hver tallerken, og server med bønnesalat og en klat guacamole ved siden af."
    }
  ],
  "changes": [
    "Sorte øjne-bønner er skiftet til hvide bønner.",
