  "steps": [
    {
      "section": "Kødbrød",
      "text": "Tænd ovnen på 180 °C (160 °C varmluft). Beklæd en brødform på ca. 900 g med bagepapir, og pensl papiret let med olie."
    },
    {
      "section": "Kødbrød",
      "text": "Kom løg, aubergine, ris, tomatpuré, bouillonpulver, dild, kanel, allehånde og lammekød i en stor skål. Ælt det godt sammen med hænderne, tilsæt æggene, og ælt igen."
    },
    {
      "section": "Kødbrød",
      "text": "Hæld de hakkede tomater i bunden af formen. Fordel kødblandingen ovenpå, og tryk den let fast."
    },
    {
      "section": "Kødbrød",
      "text": "Dæk formen med folie, og bag kødbrødet i 1 time og 40 minutter. Tag folien af de sidste 15 minutter."
    },
    {
      "section": "Ovnbagte grøntsager",
      "text": "Når kødbrødet har bagt i 1 time, vendes peberfrugt, squash og rødløg med olien i en bradepande."
    },
    {
      "section": "Ovnbagte grøntsager",
      "text": "Sæt bradepanden i ovnen ved siden af kødbrødet i 40 minutter, til grøntsagerne er møre og lidt svedne."
    },
    {
      "section": "Servering",
      "text": "Tag kødbrød og grøntsager ud af ovnen. Lad kødbrødet hvile i 5 minutter, og vend det derefter ud på et fad eller bræt. Fjern bagepapiret, og drys eventuelt med dild."
    },
    {
      "section": "Servering",
      "text": "Vend de bagte grøntsager med eddike, hvidløg og mynte, og server dem til kødbrødet."
    }
  ],
