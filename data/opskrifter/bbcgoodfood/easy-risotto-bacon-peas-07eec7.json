  "steps": [
    {
      "section": null,
      "text": "Varm olie og smør op i en bred gryde eller pande. Steg løget i cirka 7 minutter, til det er let brunet."
    },
    {
      "section": null,
      "text": "Kom baconen i og steg videre i 5 minutter, til den begynder at blive sprød."
    },
    {
      "section": null,
      "text": "Rør risene og den varme fond ned i gryden, og bring det i kog. Rør godt rundt, skru ned for varmen, og læg låg på."
    },
    {
      "section": null,
      "text": "Lad risottoen simre i 15-20 minutter, til risene næsten er møre."
    },
    {
      "section": null,
      "text": "Vend de frosne ærter i, og smag til med salt og peber. Lad det koge i yderligere 3 minutter, til ærterne er møre."
    },
    {
      "section": null,
      "text": "Server risottoen med parmesan og friskkværnet peber drysset over."
    }
  ],
  "changes": [
    "Streaky bacon er skiftet til bacon i skiver.",
