  "steps": [
    {
      "section": "Fisken",
      "text": "Tænd ovnen på 220 °C (200 °C varmluft). Læg torskefileterne i et lavt ildfast fad, så de ligger tæt i ét lag."
    },
    {
      "section": "Fisken",
      "text": "Rør olie, timian og hvidløg sammen. Fordel blandingen over fisken og riv citronskallen ovenpå."
    },
    {
      "section": "Fisken",
      "text": "Bag i 10-12 minutter, til fisken er saftig og let falder i flager."
    },
    {
      "section": "Saucen",
      "text": "Imens varmes olien på en non-stick-pande. Steg peberfrugt og porre i 5 minutter, til de er møre."
    },
    {
      "section": "Saucen",
      "text": "Kom mandlerne på panden og steg yderligere 5 minutter."
    },
    {
      "section": "Saucen",
      "text": "Rør tomatpuré, vand, bouillonpulver og eddike i. Lad det varme igennem et øjeblik."
    },
    {
      "section": "Saucen",
      "text": "Pres citronsaft i efter smag, op til en halv citron. Blend med en stavblender til en tyk sauce, der minder om pesto."
    },
    {
      "section": "Servering",
      "text": "Server fisken med saucen og den visnede spinat."
    }
  ],
