  "steps": [
    {
      "section": null,
      "text": "Varm olie op i en pande ved middel varme. Steg løgene i 5 minutter."
    },
    {
      "section": null,
      "text": "Hæld lidt vand i panden, og lad løgene simre i 7 minutter, til de lige er brunede. Rør hvidløg og ingefær i."
    },
    {
      "section": null,
      "text": "Bland alle krydderierne og peber med lidt vand i en lille skål. Kom blandingen i panden, og lad den småkoge i 5 minutter."
    },
    {
      "section": null,
      "text": "Vend kikærterne i, og tilsæt derefter fond og mandelsmør under omrøring."
    },
    {
      "section": null,
      "text": "Kom spinaten i, og lad retten koge i 3-5 minutter, til spinaten er faldet sammen."
    },
    {
      "section": null,
      "text": "Anret over de varme ris."
    }
