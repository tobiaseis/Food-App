  "steps": [
    {
      "section": null,
      "text": "Kom løg, selleri og gulerod i slowcookeren. Den skal rumme mindst 3,5 liter – ellers halvér opskriften."
    },
    {
      "section": null,
      "text": "Rør squash og persillestilkene i. Tilsæt bønnerne med lagen, de hakkede tomater og tomatpuréen, og rør rundt."
    },
    {
      "section": null,
      "text": "Hæld fonden over, og krydr med hvidløgspulver, oregano og laurbærblade. Rør igen, og lad det koge på høj varme i 3-4 timer, til grøntsagerne er møre."
    },
    {
      "section": null,
      "text": "Kom spaghettien i 20 minutter før tiden er gået. Læg grønkål og ærter i 10 minutter efter, og lad suppen koge videre, til pasta og ærter er møre."
    },
    {
      "section": null,
      "text": "Dryp med olivenolie, og drys med persilleblade og kerner. Server med sprøde boller, hvis du vil."
    }
  ],
