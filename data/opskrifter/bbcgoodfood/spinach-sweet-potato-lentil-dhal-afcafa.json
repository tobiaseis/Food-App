  "steps": [
    {
      "section": null,
      "text": "Varm sesamolien op i en bred gryde med tætsluttende låg."
    },
    {
      "section": null,
      "text": "Rør løget i olien ved svag varme i 10 minutter, til det er blødt."
    },
    {
      "section": null,
      "text": "Kom hvidløg, ingefær og chili i gryden, og lad det stege i 1 minut. Tilsæt gurkemeje og spidskommen, og steg endnu 1 minut."
    },
    {
      "section": null,
      "text": "Skru op til middel varme. Vend sødkartoffelternes overflade rundt i krydderiblandingen, så de er dækket godt."
    },
    {
      "section": null,
      "text": "Hæld linser og fond i gryden, og smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Bring det i kog, skru ned, og læg låg på. Lad dhalen småkoge i 20 minutter, til linserne er møre, og sødkartoflen netop holder formen."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber. Rør spinaten forsigtigt i, til den falder sammen."
    },
    {
      "section": "Til servering",
      "text": "Drys med forårsløg og revet basilikum, og server."
    },
    {
      "section": "Til servering",
      "text": "Skal dhalen bruges som madpakke, så lad den køle helt af. Fordel den i tætte bokse, og opbevar dem i køleskabet."
    }
  ],
  "changes": [
    "Thai basil er erstattet af almindelig basilikum."
