  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 180 °C varmluft. Smør et ovnfast fad på ca. 30 x 20 cm med lidt fedtstof."
    },
    {
      "section": null,
      "text": "Varm olien i en stor non-stick-pande. Steg løgene i 5-6 minutter, til de er møre og let gyldne."
    },
    {
      "section": null,
      "text": "Vend tomaterne i panden i 1 minut, så de bliver bløde."
    },
    {
      "section": null,
      "text": "Tag panden af varmen. Vend spinat og basilikum i, til bladene falder lidt sammen."
    },
    {
      "section": null,
      "text": "Kom grøntsagerne i fadet, og fordel ricottaen ovenpå i små klatter."
    },
    {
      "section": null,
      "text": "Krydr æggene, og pisk dem godt. Hæld dem over grøntsager og ost."
    },
    {
      "section": null,
      "text": "Bag frittataen i ovnen i 20-25 minutter, til den er lysegylden og stivnet. Server med salat."
    }
