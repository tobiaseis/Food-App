  "steps": [
    {
      "section": null,
      "text": "Sæt en ovnfast pande med slip-let-belægning i airfryeren, og forvarm til 180 °C. En rund pande giver en mere klassisk omeletform."
    },
    {
      "section": null,
      "text": "Kom smørret på panden, og lad det smelte i 30 sekunder."
    },
    {
      "section": null,
      "text": "Pisk æggene sammen med peber. Vend det fyld, du har valgt, i æggemassen. Bruger du ost, så vend kun en håndfuld i og gem resten til toppen."
    },
    {
      "section": null,
      "text": "Hæld æggemassen på panden, og kør omeletten i 8-10 minutter, til den er hævet og gyldenbrun."
    },
    {
      "section": null,
      "text": "Drys eventuelt den sparede ost over, og server med salat."
    }
  ],
