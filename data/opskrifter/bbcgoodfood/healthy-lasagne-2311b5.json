  "steps": [
    {
      "section": "Kødsauce",
      "text": "Tænd ovnen på 180 °C (160 °C varmluft)."
    },
    {
      "section": "Kødsauce",
      "text": "Varm olien i en stor pande ved middel varme. Steg løg, gulerod, selleri og ét laurbærblad i 8-10 minutter, til grøntsagerne er bløde og begynder at tage farve."
    },
    {
      "section": "Kødsauce",
      "text": "Kom oksekød og hvidløg i panden og rør rundt i ca. 5 minutter, til kødet er brunet."
    },
    {
      "section": "Kødsauce",
      "text": "Hæld tomater, vand, tomatpuré og grøntsagsfond i. Bring det i kog, læg låg på og lad det simre i 20 minutter. Tag låget af efter de første 10 minutter, så saucen koger lidt ind."
    },
    {
      "section": "Hvid sauce",
      "text": "Mens kødsaucen simrer, piskes mælk og mel sammen i en mellemstor gryde ved lav varme, til der ikke er klumper."
    },
    {
      "section": "Hvid sauce",
      "text": "Kom det andet laurbærblad og muskatnød i. Lad saucen koge under omrøring i 8-10 minutter, til den er tyk."
    },
    {
      "section": "Samling og bagning",
      "text": "Fjern laurbærbladene fra begge saucer."
    },
    {
      "section": "Samling og bagning",
      "text": "Fordel en tredjedel af kødsaucen i bunden af et ovnfast fad på ca. 19 x 24 cm og læg to lasagneplader ovenpå. Top med halvdelen af resten af kødsaucen og to plader mere. Afslut med den sidste kødsauce og de sidste to plader."
    },
    {
      "section": "Samling og bagning",
      "text": "Hæld den hvide sauce over og drys med parmesan. Bag lasagnen i 40 minutter, til den bobler og er gylden."
    }
  ],
