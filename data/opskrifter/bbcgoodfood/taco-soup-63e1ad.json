  "steps": [
    {
      "section": null,
      "text": "Varm to tredjedele af olien i en stor, høj gryde ved middelhøj varme. Kom oksekødet, alle krydderierne og oreganoen i."
    },
    {
      "section": null,
      "text": "Rør rundt og del kødet i mindre stykker med en grydeske. Steg i 5-7 minutter, til det er brunet. Tag kødet op i en skål."
    },
    {
      "section": null,
      "text": "Sæt varmen ned til middel, og hæld resten af olien i gryden. Svits løget i 6-8 minutter, til det begynder at blive blødt."
    },
    {
      "section": null,
      "text": "Tilsæt hvidløg, korianderstilke og tomatpuré. Steg videre i 3-4 minutter, til hvidløget dufter, og tomatpuréen er blevet mørkere."
    },
    {
      "section": null,
      "text": "Kom kødet tilbage i gryden sammen med jalapeños, fond, hakkede tomater, begge slags bønner, majs og polenta. Rør godt rundt, og bring det i et let kog."
    },
    {
      "section": null,
      "text": "Lad suppen simre i 25-30 minutter, til den er kogt lidt ind. Smag til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Øs suppen op og drys med korianderbladene. Server med chips, creme fraiche, avocado, rødløg og revet cheddar."
    }
  ],
  "changes": [
    "Creme fraiche i stedet for soured cream."
  ],
