  "steps": [
    {
      "section": null,
      "text": "Læg cashewnødderne i blød i det kogende vand, og lad dem stå til senere."
    },
    {
      "section": "Dildyoghurt",
      "text": "Rør yoghurt, citronsaft og dild sammen i en skål. Stil den til side, til retten skal anrettes."
    },
    {
      "section": null,
      "text": "Varm olien i en stegepande, og steg kapersene, til de er sprøde. Tag dem op, og lad olien blive i panden."
    },
    {
      "section": null,
      "text": "Kom porre, kål, hvidløg og en knivspids salt i panden. Læg låg på, og lad det simre ved middelvarme i ca. 5 minutter, til det er næsten mørt."
    },
    {
      "section": null,
      "text": "Vend spinat og bønner i panden, og smag til med salt og peber."
    },
    {
      "section": null,
      "text": "Blend cashewnødderne med deres iblødsætningsvand til en glat creme med en stavblender. Hæld cremen over grøntsagerne, læg låg på, og lad det simre ved lav varme, til spinaten er faldet sammen. Tilsæt lidt vand, hvis det bliver for tørt."
    },
    {
      "section": null,
      "text": "Varm en tør stegepande op ved middel-høj varme. Skær nogle små snit i skindsiden af havbarsfileterne, så de ikke krøller."
    },
    {
      "section": null,
      "text": "Steg fileterne et par minutter på hver side, til de er gennemstegte."
    },
    {
      "section": null,
      "text": "Anret grøntsagerne med en filet ovenpå, og drys med de sprøde kapers. Server dildyoghurten ved siden af."
    }
  ],
  "changes": []
