  "steps": [
    {
      "section": "Kartoffelstave",
      "text": "Forvarm ovnen til 220 °C (200 °C varmluft). Klæd en stor, flad bageplade med bagepapir."
    },
    {
      "section": "Kartoffelstave",
      "text": "Vend kartoffelstavene med olivenolie og salt, og fordel dem i ét jævnt lag på pladen."
    },
    {
      "section": "Kartoffelstave",
      "text": "Bag midt i ovnen i 25 minutter. Rør rundt, og bag videre i 5-10 minutter, til de er gyldne og sprøde."
    },
    {
      "section": "Krydderiblanding",
      "text": "Mens kartoflerne bager, ristes koriander, spidskommen, peberkorn, annatto, bukkehorn og kanelstang på en middelvarm tør pande i 2-3 minutter, til det dufter."
    },
    {
      "section": "Krydderiblanding",
      "text": "Kværn krydderierne groft i en krydderikværn. Lidt struktur er godt. Rør sumak, hvidløgspulver og paprika i."
    },
    {
      "section": "Burgere",
      "text": "Kom rejer, chutney, bacon, krydderiblanding, sesamolie og salt i en foodprocessor. Pulsér til en tyk, klistret farsmasse med lidt struktur."
    },
    {
      "section": "Burgere",
      "text": "Smør hænderne med olie, og del farsen i fire lige store portioner på ca. 100 g."
    },
    {
      "section": "Burgere",
      "text": "Rist bollerne på en stor non-stick-pande ved middelhøj varme, til de er gyldne. Læg dem i den varme ovn, så de holder sig lune."
    },
    {
      "section": "Burgere",
      "text": "Hæld olien på panden, og skru op for varmen. Smør spatelen med olie, så farsen ikke hænger fast."
    },
    {
      "section": "Burgere",
      "text": "Læg to klatter fars på den meget varme pande, og tryk dem flade med spatelen til tynde patties på ca. 10 cm. Steg 2 minutter på den ene side og 3 minutter på den anden, til de er gennemstegte, sprøde og brunede."
    },
    {
      "section": "Burgere",
      "text": "Hold de færdige patties varme i ovnen, mens de to sidste steges på samme måde."
    },
    {
      "section": "Samling",
      "text": "Bland koriander, chili og løg med limesaften."
    },
    {
      "section": "Samling",
      "text": "Smør mayonnaise og chutney på bundene af bollerne. Læg to patties på hver, og top med korianderblandingen og bollens låg."
    },
    {
      "section": "Samling",
      "text": "Server med limebåde og kartoffelstave ved siden af."
    }
  ],
  "changes": [
    "Bacon i tern erstatter pancetta i tern."
  ]
}
