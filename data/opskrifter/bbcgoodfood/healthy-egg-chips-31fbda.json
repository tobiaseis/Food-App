  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 200 °C (varmluft 180 °C)."
    },
    {
      "section": null,
      "text": "Kom kartofler og skalotteløg i en stor bradepande med slip-let-overflade. Dryp med olivenolie, drys med oregano, og vend det hele godt rundt."
    },
    {
      "section": null,
      "text": "Bag i 40-45 minutter, til kartoflerne begynder at få farve. Tilsæt champignon, og bag videre i 10 minutter, til kartoflerne er møre og gyldne."
    },
    {
      "section": null,
      "text": "Lav fire små huller mellem grøntsagerne, og slå et æg ud i hvert hul."
    },
    {
      "section": null,
      "text": "Sæt panden tilbage i ovnen i 3-4 minutter, eller til æggene har den ønskede stivhed."
    }
  ],
