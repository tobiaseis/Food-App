  "steps": [
    {
      "section": null,
      "text": "Skær kernerne af majskolberne, og kom dem i en stor skål."
    },
    {
      "section": null,
      "text": "Bland begge slags peberfrugt, rødløg, tomater og koriander i skålen."
    },
    {
      "section": "Til dressingen",
      "text": "Pisk limesaft, olivenolie, salt og peber sammen i en lille skål. Rør chilien i, hvis du bruger den."
    },
    {
      "section": null,
      "text": "Hæld dressingen over salaten, og vend det hele godt rundt."
    },
    {
      "section": null,
      "text": "Server straks ved stuetemperatur, eller sæt salaten på køl i 15–20 minutter, så smagene når at trække igennem."
