  "steps": [
    {
      "section": null,
      "text": "Tænd en udendørs grill eller ovnens grillfunktion."
    },
    {
      "section": null,
      "text": "Smør mayonnaise ud over majskolberne, og krydr dem med salt og peber."
    },
    {
      "section": null,
      "text": "Grill majsene i 5-8 minutter, til de er gule og har sorte pletter."
    },
    {
      "section": null,
      "text": "Tag dem af varmen, og lad dem køle lidt af. Skær derefter kernerne af kolberne, og kom dem i en skål."
    },
    {
      "section": null,
      "text": "Vend resten af ingredienserne i skålen sammen med 1 tsk salt."
    },
    {
      "section": null,
      "text": "Smag salaten til, og tilsæt mere salt eller lime efter behov."
    }
