  "steps": [
    {
      "section": "Til laksebøfferne",
      "text": "Kom laksen i en foodprocessor sammen med currypasta, ingefær, sojasauce og den hakkede koriander. Kør i korte pulser, til massen er groft hakket."
    },
    {
      "section": "Til laksebøfferne",
      "text": "Form massen til 4 bøffer."
    },
    {
      "section": "Til laksebøfferne",
      "text": "Varm olien op på en non-stick pande. Steg bøfferne i 4-5 minutter på hver side, til de er sprøde ude og gennemstegte."
    },
    {
      "section": "Til salaten",
      "text": "Hyl gulerødder og agurk i lange bånd med en skræller, og læg dem i en skål."
    },
    {
      "section": "Til salaten",
      "text": "Vend båndene med eddike og sukker, til sukkeret er opløst. Vend derefter korianderbladene i."
    },
    {
      "section": "Til salaten",
      "text": "Fordel salaten på 4 tallerkener, og server laksebøfferne ved siden af med citronbåde."
    }
  ],
