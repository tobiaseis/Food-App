  "steps": [
    {
      "section": "Frikadeller",
      "text": "Hak skalotteløget groft i en foodprocessor med nogle korte pulseringer."
    },
    {
      "section": "Frikadeller",
      "text": "Kom kyllingebryst, brød, basilikum og hvidløg i foodprocessoren. Kør det til en blød masse."
    },
    {
      "section": "Frikadeller",
      "text": "Form 24 små frikadeller med våde hænder."
    },
    {
      "section": "Frikadeller",
      "text": "Varm en smule rapsolie på en stor non-stick-pande. Steg halvdelen af frikadellerne i 5 minutter, og vend dem undervejs, så de får jævn farve. Tag dem af panden, og steg resten på samme måde."
    },
    {
      "section": "Frikadeller",
      "text": "Stil frikadellerne på køl, til de skal serveres. De holder sig op til en dag i køleskabet."
    },
    {
      "section": "Til servering",
      "text": "Varm eventuelt frikadellerne i ovnen ved 180 °C (160 °C varmluft) i 10 minutter."
    },
    {
      "section": "Til servering",
      "text": "Læg halvdelen af frikadellerne i cikorieblade. Top med sriracha, forårsløg og peanuts."
    },
    {
      "section": "Peberfrugtversion",
      "text": "Træk de resterende frikadeller på 12 cocktailpinde, to på hver. Sæt et stykke peberfrugt og to basilikumblade på hver side af frikadellerne."
    }
  ],
  "changes": [
    "Kornbrød er skrevet som brød.",
    "Røde peberfrugter fra glas er skrevet som ristet peberfrugt.",
    "Ristet peberfrugt og cikorie er beholdt som i kilden."
  ]
