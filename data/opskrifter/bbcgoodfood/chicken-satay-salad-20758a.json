  "steps": [
    {
      "section": "Marinade",
      "text": "Rør sojasauce, karry, spidskommen, hvidløg og honning sammen i et stort fad."
    },
    {
      "section": "Marinade",
      "text": "Del hvert kyllingebryst i to tynde fileter ved at skære det vandret over. Vend kyllingen i marinaden, og sæt den i køleskabet i mindst 1 time eller natten over."
    },
    {
      "section": "Satay-sauce",
      "text": "Rør jordnøddesmør, sweet chilisauce, limesaft og vand sammen til en sauce, der kan øses."
    },
    {
      "section": "Til stegning",
      "text": "Pensl en stor non-stick-pande let med olie, og varm den op på middel varme."
    },
    {
      "section": "Til stegning",
      "text": "Læg kyllingen på panden, og læg låg på. Steg i 5-6 minutter, og vend filetene det sidste minut, til de er gennemstegte, men stadig saftige."
    },
    {
      "section": "Til stegning",
      "text": "Dæk kyllingen til, og lad den hvile et par minutter."
    },
    {
      "section": "Salat",
      "text": "Vend salat, agurk, skalotteløg, koriander og granatæblekerner sammen, og fordel det på tallerkener."
    },
    {
      "section": "Salat",
      "text": "Drys lidt af saucen over salaten. Skær kyllingen i skiver, læg dem ovenpå, og slut med resten af saucen. Server, mens kyllingen er lun."
    }
  ],
