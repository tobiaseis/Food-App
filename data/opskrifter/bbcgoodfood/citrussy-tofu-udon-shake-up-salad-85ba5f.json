  "steps": [
    {
      "section": null,
      "text": "Vend tofuen i en stor skål med majsstivelse, salt og peber, så alle tern er dækket."
    },
    {
      "section": null,
      "text": "Varm olien op på en lille pande ved middelvarme. Steg tofuen på alle sider i 5-6 minutter, til den er gylden."
    },
    {
      "section": null,
      "text": "Løft tofuen op på køkkenrulle, så fedtet kan sive af, og lad den køle af."
    },
    {
      "section": "Til dressingen",
      "text": "Rør alle ingredienser til dressingen sammen i en stor beholder med låg."
    },
    {
      "section": null,
      "text": "Kog udonnudlerne efter anvisningen på pakken."
    },
    {
      "section": null,
      "text": "Læg lagene i beholderen oven på dressingen i denne rækkefølge: tofu, nudler, grøntsager og til sidst koriander. Så holder grøntsagerne sig sprøde."
    },
    {
      "section": null,
      "text": "Sæt låg på og ryst kraftigt lige før servering, så alt blandes."
    }
  ],
