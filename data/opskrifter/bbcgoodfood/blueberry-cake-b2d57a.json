  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 200 °C (180 °C varmluft). Smør en form på 22 cm og beklæd bunden med bagepapir."
    },
    {
      "section": null,
      "text": "Tag en tredjedel af de frosne blåbær fra til toppen. Vend resten i den ekstra mel, mens de stadig er frosne."
    },
    {
      "section": null,
      "text": "Pisk sukker og æg i en stor skål, til det er glat. Rør olie, citronskal, citronsaft og yoghurt i."
    },
    {
      "section": null,
      "text": "Vend mel, bagepulver og salt i med en piskeris. Det gør ikke noget, at der er enkelte klumper."
    },
    {
      "section": null,
      "text": "Fold de melvendte blåbær i dejen."
    },
    {
      "section": null,
      "text": "Hæld dejen i formen og drys de sidste blåbær ovenpå."
    },
    {
      "section": null,
      "text": "Sæt kagen i ovnen og skru straks ned til 180 °C (160 °C varmluft). Bag i 1 time og 10 minutter til 1 time og 20 minutter, til en spid stukket i midten kommer rent op."
    },
    {
      "section": null,
      "text": "Tag kagen ud og lad den køle af. Løsn den fra formen og drys evt. med flormelis."
    }
  ],
  "changes": [
    "Vegetabilsk olie er skiftet til rapsolie.",
