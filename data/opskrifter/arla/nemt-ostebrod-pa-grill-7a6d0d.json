  "steps": [
    {
      "section": null,
      "text": "Lav tætte snit på kryds og tværs i brødet, så der opstår et rudemønster. Skær dybt, men stop før bunden."
    },
    {
      "section": null,
      "text": "Pres mozzarellaternene og rosmarinen ned i sprækkerne."
    },
    {
      "section": null,
      "text": "Læg brødet på grillen med indirekte varme, og lad det stå i 15-20 minutter, til osten er smeltet, og skorpen er sprød."
    },
    {
      "section": null,
      "text": "Løft brødet af grillen og drys det med salt. Plukk rosmarinen over, og server brødet, mens det er lunt."
    }
  ],
