  "steps": [
    {
      "section": "Chokoladekage",
      "text": "Varm ovnen op til 175 °C (almindelig ovn). Smelt chokoladen i en skål over vandbad."
    },
    {
      "section": "Chokoladekage",
      "text": "Pisk smør og sukker sammen, til det er luftigt. Adskil æggene."
    },
    {
      "section": "Chokoladekage",
      "text": "Rør blommerne og den smeltede chokolade ned i smørblandingen."
    },
    {
      "section": "Chokoladekage",
      "text": "Bland hvedemel, kartoffelmel og bagepulver, og vend blandingen i dejen."
    },
    {
      "section": "Chokoladekage",
      "text": "Pisk hviderne til stive tinder, og vend dem forsigtigt i dejen."
    },
    {
      "section": "Chokoladekage",
      "text": "Smør en springform på 22 cm, og kom dejen i. Bag bunden midt i ovnen i 20-25 minutter. Den skal være lidt underbagt."
    },
    {
      "section": "Chokoladekage",
      "text": "Lad bunden køle af i formen med ringen på i mindst en halv time."
    },
    {
      "section": "Chokoladeis",
      "text": "Smelt chokoladen i en skål over vandbad."
    },
    {
      "section": "Chokoladeis",
      "text": "Pisk blommer og sukker, til det er lyst og luftigt. Pisk den smeltede chokolade i æggemassen med kraftige piskeris."
    },
    {
      "section": "Chokoladeis",
      "text": "Lav fløden til et let skum, og vend det forsigtigt i chokolademassen."
    },
    {
      "section": "Chokoladeis",
      "text": "Fordel isen over den afkølede bund, og læg alufolie over. Frys kagen i ca. 5 timer, eller til isen er helt fast."
    },
    {
      "section": "Salt karamelsauce",
      "text": "Kom fløde, sirup og flormelis i en tykbundet gryde, og bring det i kog. Lad det koge ved jævn varme i 10-15 minutter under omrøring, til der er ca. 1½ dl tilbage."
    },
    {
      "section": "Salt karamelsauce",
      "text": "Rør smør og salt i, til saucen er glat. Tag gryden af varmen, og lad saucen køle af, til den er lillefingervarm."
    },
    {
      "section": "Salt karamelsauce",
      "text": "Hæld saucen over den frosne kage. Pynt med hasselnødder og chokoladespåner."
    }
  ],
  "changes": []
}
