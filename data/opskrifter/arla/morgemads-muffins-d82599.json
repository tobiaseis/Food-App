  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 200 °C varmluft. Smør 12 muffinsforme."
    },
    {
      "section": null,
      "text": "Pisk æg og honning, til det er luftigt. Vend yoghurt, havregryn, natron og salt i, og rør det godt sammen."
    },
    {
      "section": null,
      "text": "Bland æble, tranebær og to tredjedele af mandlerne i dejen."
    },
    {
      "section": null,
      "text": "Del dejen mellem formene, og strø de resterende mandler over."
    },
    {
      "section": null,
      "text": "Bag muffinsene i 20-25 minutter."
