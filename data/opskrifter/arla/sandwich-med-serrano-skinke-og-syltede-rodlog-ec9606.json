  "steps": [
    {
      "section": "Syltede rødløg",
      "text": "Bland eddike og sukker, og lad det stå, indtil sukkeret er opløst."
    },
    {
      "section": "Syltede rødløg",
      "text": "Kom løgringene i væsken, og lad dem stå og trække i cirka 10 minutter."
    },
    {
      "section": "Sandwich",
      "text": "Dæk alle brødskiverne med et lag flødeost."
    },
    {
      "section": "Sandwich",
      "text": "Læg salat, tomat, serranoskinke, de syltede rødløg og basilikumblade på to af skiverne."
    },
    {
      "section": "Sandwich",
      "text": "Læg de to øvrige skiver ovenpå, og pres sandwichene let sammen."
    },
    {
      "section": "Sandwich",
      "text": "Skær sandwichene over på midten, og sæt en halv træspyd gennem hver halvdel. Pynt med frisk basilikum, og server."
    }
