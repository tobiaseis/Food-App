  "steps": [
    {
      "section": null,
      "text": "Varm ovnen op til 175 °C (almindelig ovn)."
    },
    {
      "section": null,
      "text": "Rør mandler, solsikkekerner, hørfrø, krydderurter, bagepulver, salt og mel sammen i en skål."
    },
    {
      "section": null,
      "text": "Del smørret i små stykker, og gnid det ud i de tørre ting, til blandingen minder om revet ost."
    },
    {
      "section": null,
      "text": "Rør ægget i, og æltet hurtigt dejen sammen. Er den for klistret, så drys lidt ekstra mel over."
    },
    {
      "section": null,
      "text": "Placer dejen mellem to stykker bagepapir, og rul den tyndt ud til en firkant på ca. 25 x 30 cm."
    },
    {
      "section": null,
      "text": "Tag det øverste ark papir af, og del dejen i firkanter på ca. 5 x 5 cm med en kniv."
    },
    {
      "section": null,
      "text": "Løft den nederste papirplade over på en bageplade. Bag kiksene midt i ovnen i ca. 20 minutter, til de er gyldne."
    },
    {
      "section": null,
      "text": "Tag kiksene ud, og flyt dem uden papir over på en rist, så de kan køle af. Server dem f.eks. på et tapasbord."
    }
  ],
