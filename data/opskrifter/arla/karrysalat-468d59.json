  "steps": [
    {
      "section": "Karrysalat",
      "text": "Pil æggene, når de er kolde, og skær dem i små tern."
    },
    {
      "section": "Karrysalat",
      "text": "Rør creme fraiche og mayonnaise sammen med karry, salt og peber."
    },
    {
      "section": "Karrysalat",
      "text": "Vend æg, æble, rødløg, kapers og cornichoner i dressingen."
    },
    {
      "section": "Karrysalat",
      "text": "Smag til med salt og peber. Stil salaten tildækket på køl, eller server den med det samme, fx på rugbrød med marineret sild, rødløg, kapers og karse."
    }
