  "steps": [
    {
      "section": "Pærer",
      "text": "Tænd ovnen på 225 °C (almindelig ovn). Læg pærestykkerne i fire ovnfaste forme."
    },
    {
      "section": "Pærer",
      "text": "Drys citronsaft, sukker og ingefær ud over pærerne."
    },
    {
      "section": "Crumble",
      "text": "Rør smørstykkerne sammen med mel, havregryn og flormelis med fingrene, til det bliver til en smuldret dej."
    },
    {
      "section": "Crumble",
      "text": "Kom crumblen oven på pærerne, og sæt formene på midterste rille. Bag dem i 20-25 minutter."
    },
    {
      "section": "Vaniljefløde",
      "text": "Pisk fløden med vaniljesukker, til den er let og luftig."
    },
    {
      "section": "Vaniljefløde",
      "text": "Anret den lune crumble og top med den kolde vaniljefløde."
    }
