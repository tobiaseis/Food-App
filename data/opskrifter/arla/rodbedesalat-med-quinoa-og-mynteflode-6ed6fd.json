  "steps": [
    {
      "section": "Rødbedesalat",
      "text": "Tænd ovnen på 200 °C (almindelig ovn). Vend rødbeder, løg, hvidløg, olie, eddike, salt og peber sammen i en lille bradepande."
    },
    {
      "section": "Rødbedesalat",
      "text": "Læg låg eller alufolie over bradepanden, og bag rødbederne midt i ovnen i ca. 45 minutter, til de er møre."
    },
    {
      "section": "Quinoa",
      "text": "Skyl quinoaen i en sigte. Bring vandet i kog i en gryde med salt, kanelstang og hvidløg, og kom quinoaen i."
    },
    {
      "section": "Quinoa",
      "text": "Lad den koge ved svag varme under tætsluttende låg i ca. 15 minutter. Si den derefter fra."
    },
    {
      "section": "Rødbedesalat",
      "text": "Lad de bagte rødbeder køle lidt af. Vend quinoaen i, så den trækker af saften og marinaden fra bradepanden. Smag til."
    },
    {
      "section": "Myntefløde",
      "text": "Pisk fløden let, og rør mynte, salt og peber i."
    },
    {
      "section": "Til servering",
      "text": "Læg salaten på et fad, dryp med myntefløde og drys med friske mynteblade."
    }
  ],
  "changes": []
