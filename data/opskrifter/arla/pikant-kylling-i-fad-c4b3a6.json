  "steps": [
    {
      "section": null,
      "text": "Varm en pande op, og steg kyllingen gylden i smørret. Læg den derefter i et ovnfast fad."
    },
    {
      "section": null,
      "text": "Brug samme pande til løg, hvidløg, chili og grøntsager, og svits dem i 3-4 minutter."
    },
    {
      "section": null,
      "text": "Rør flåede tomater, flødeost, fløde, timian, salt og peber sammen til en jævn sauce. Brug evt. et piskeris eller en stavblender."
    },
    {
      "section": null,
      "text": "Vend de svitsede grøntsager i saucen, og fordel det hele over kyllingen i fadet."
    },
    {
      "section": null,
      "text": "Bag i ovnen ved 200 °C varmluft i cirka 25 minutter."
    },
    {
      "section": null,
      "text": "Kog perlebyg eller ris, mens retten bager. Server kyllingen med det kogte tilbehør og drys med hakket persille."
    }
  ],
