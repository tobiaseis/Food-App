  "steps": [
    {
      "section": "Farverig salat",
      "text": "Pres saften fra en limebåd over kålen, og ælt kålen med fingrene, til den bliver mør."
    },
    {
      "section": "Farverig salat",
      "text": "Læg kål nederst på et fad eller i skåle. Top med gulerødder, cherrytomater og majs."
    },
    {
      "section": "Chimichanga med bønner",
      "text": "Varm rapsolien i en pande. Svits løg, hvidløg og jalapeños i ca. 2 minutter, og rør spidskommen og salt i."
    },
    {
      "section": "Chimichanga med bønner",
      "text": "Kom bønner og vand på panden, og lad det simre i 2 minutter. Smag fyldet til."
    },
    {
      "section": "Chimichanga med bønner",
      "text": "Drys 1 spsk ost midt på en tortilla, kom 1 spsk bønnefyld ovenpå, og læg lidt mere ost over."
    },
    {
      "section": "Chimichanga med bønner",
      "text": "Slå først tortillaens sider ind mod midten, og fold derefter nederste og øverste kant ind, så der opstår en lukket pakke. Læg den med samlingen nedad. Fyld og fold de øvrige tortillaer på samme måde."
    },
    {
      "section": "Chimichanga med bønner",
      "text": "Varm den smagsneutrale olie i en sauterpande ved middel varme. Steg alle 8 pakker i 2-3 minutter på hver side."
    },
    {
      "section": "Til servering",
      "text": "Anret chimichangas med salaten, og server creme fraiche og syltede jalapeños ved siden af."
    }
  ],
  "changes": []
