  "steps": [
    {
      "section": "Timiankartofler",
      "text": "Læg kartoflerne på en bageplade med bagepapir. Giv dem et tyndt lag smørspray, drys med salt, og vend dem."
    },
    {
      "section": "Timiankartofler",
      "text": "Bag kartoflerne midt i ovnen ved 200 °C varmluft i cirka 40 minutter, til de er gyldne."
    },
    {
      "section": "Kylling og cremet sauce",
      "text": "Varm en sauterpande op ved kraftig varme, og lad smørret smelte, uden at det tager farve."
    },
    {
      "section": "Kylling og cremet sauce",
      "text": "Brun kyllingen på begge sider sammen med løg og gulerødder i cirka 5 minutter."
    },
    {
      "section": "Kylling og cremet sauce",
      "text": "Hæld vand og hvidvin i panden, og drys med salt. Læg låg på, og lad det simre ved svag varme i cirka 15 minutter."
    },
    {
      "section": "Kylling og cremet sauce",
      "text": "Rør fløde og saucejævner i, og lad saucen koge med i cirka 5 minutter mere."
    },
    {
      "section": "Servering",
      "text": "Smag saucen til, og anret med de bagte kartofler. Top med timian og peber."
    }
  ],
