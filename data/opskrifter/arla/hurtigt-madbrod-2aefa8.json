  "steps": [
    {
      "section": null,
      "text": "Varm smørret op i en gryde, til det er smeltet, og tag gryden af varmen. Rør mælken i."
    },
    {
      "section": null,
      "text": "Hæld smør- og mælkeblandingen i en skål, og rør yoghurten i. Opløs gæren i væsken."
    },
    {
      "section": null,
      "text": "Tilsæt sukker, salt, rosmarin og det meste af melet. Gem lidt mel til senere. Arbejd dejen sammen med en grydeske."
    },
    {
      "section": null,
      "text": "Vend dejen ud på et meldrysset bord, og ælt den grundigt. Tilsæt resten af melet, hvis dejen er for klistret."
    },
    {
      "section": null,
      "text": "Træk dejen ud til et fladt, rundt brød på ca. 28 cm på tværs. Læg det på en bageplade med bagepapir."
    },
    {
      "section": null,
      "text": "Skær otte trekanter i overfladen, så snittene næsten går hele vejen igennem. Pensl med mælk, og strø rosmarin over."
    },
    {
      "section": null,
      "text": "Sæt pladen midt i en kold ovn. Tænd for 225 °C almindelig ovn (over- og undervarme), og bag brødet i ca. 20 minutter."
    }
  ],
  "changes": []
