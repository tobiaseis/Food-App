  "steps": [
    {
      "section": "Ingefærmarinade",
      "text": "Rør yoghurt, honning, ingefær, hvidløg, karry og salt sammen i en skål."
    },
    {
      "section": "Ingefærmarinade",
      "text": "Kom halvdelen over i en frysepose. Den anden halvdel bliver i skålen til dressingen."
    },
    {
      "section": "Kylling",
      "text": "Del kyllingeinderfileterne på langs, og læg dem i posen. Masser posen, så al kødet er dækket af marinade."
    },
    {
      "section": "Kylling",
      "text": "Smelt smørret på en pande, til det begynder at få farve. Steg kyllingen over høj varme i ca. 4 minutter, og vend den undervejs. Læg den til side under låg eller folie, så den holder varmen."
    },
    {
      "section": "Kernesalat",
      "text": "Ælt kålen med saltet, til den bliver blød og slipper vand."
    },
    {
      "section": "Kernesalat",
      "text": "Bland kål og perlespelt i et stort fad. Fordel gulerødder, appelsinfileter og hasselnødder over."
    },
    {
      "section": "Ingefærdressing",
      "text": "Rør appelsinjuice ind i den resterende marinade, og smag til. Server dressingen til den lune kylling og salaten."
    }
  ],
  "changes": [
    "Kvark er erstattet af græsk yoghurt."
  ]
