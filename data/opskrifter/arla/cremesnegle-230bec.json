  "steps": [
    {
      "section": "Dej",
      "text": "Kom smørret i en lille gryde og lad det smelte. Tag gryden af varmen, hæld mælken i, og rør gæren ud i væsken."
    },
    {
      "section": "Dej",
      "text": "Bland de resterende ingredienser til dejen i. Gem lidt af melet til sidst, da dejen skal forblive fugtig."
    },
    {
      "section": "Dej",
      "text": "Ælt dejen godt sammen. Dæk den til, og lad den hæve et lunt sted i ca. ½ time."
    },
    {
      "section": "Creme",
      "text": "Pisk mælk og æg let sammen i en tykbundet gryde. Pisk derefter sukker, mel og vaniljekorn i."
    },
    {
      "section": "Creme",
      "text": "Varm under piskning op til kogepunktet. Lad cremen koge ved jævn varme i ca. 3 minutter, mens du rører hele tiden, til den ikke smager af mel."
    },
    {
      "section": "Creme",
      "text": "Hæld cremen i en skål. Læg film direkte ovenpå, så der ikke kommer skind, og lad den køle helt af."
    },
    {
      "section": "Remonce",
      "text": "Rør det bløde smør, farinen og kanelen sammen til en jævn masse."
    },
    {
      "section": "Sådan samler du cremesneglene",
      "text": "Vend dejen ud på et bord med mel på. Udrul den til en firkant på ca. 40 x 40 cm."
    },
    {
      "section": "Sådan samler du cremesneglene",
      "text": "Fordel remoncen over hele dejen. Rul den sammen på langs til en rulle, og skær enderne af."
    },
    {
      "section": "Sådan samler du cremesneglene",
      "text": "Del rullen i 12 stykker på ca. 3 cm. Læg dem på en bageplade med bagepapir, og fold den yderste dejende ind under hver snegl."
    },
    {
      "section": "Sådan samler du cremesneglene",
      "text": "Tryk sneglene let flade. Lad dem hæve tildækket i ca. 30 minutter."
    },
    {
      "section": "Sådan samler du cremesneglene",
      "text": "Tryk en fordybning i midten af hver snegl med fingrene, og fyld den med creme ved hjælp af en ske eller sprøjtepose."
    },
    {
      "section": "Sådan samler du cremesneglene",
      "text": "Pensl med sammenpisket æg. Bag i ovnen ved 200 °C i ca. 15 minutter, til sneglene er gyldne."
    },
    {
      "section": "Sådan samler du cremesneglene",
      "text": "Rør en glasur af flormelis og vand. Lad sneglene køle lidt af, og pynt dem med glasuren."
    }
  ],
