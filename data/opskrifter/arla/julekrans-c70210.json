  "steps": [
    {
      "section": "Dej",
      "text": "Kom det lunkne vand i en skål, og rør gæren ud i det."
    },
    {
      "section": "Dej",
      "text": "Tilsæt de øvrige ingredienser til dejen, og ælt den i fx en røremaskine, til den er blank og smidig."
    },
    {
      "section": "Dej",
      "text": "Dæk skålen til, og lad dejen hæve et lunt sted, til den er dobbelt så stor. Det tager cirka 1 time."
    },
    {
      "section": "Remonce",
      "text": "Rør smør, farin, marcipan og kanel sammen til en jævn remonce."
    },
    {
      "section": "Sukkerlage til pensling",
      "text": "Bring vand og sukker i en lille gryde ved jævn varme, og rør, til sukkeret er helt opløst."
    },
    {
      "section": "Sukkerlage til pensling",
      "text": "Stil sukkerlagen til side, så den køler lidt af."
    },
    {
      "section": "Sådan laver du julekransen",
      "text": "Rul dejen ud til en firkant på cirka 30 x 40 cm, og fordel remoncen over hele fladen."
    },
    {
      "section": "Sådan laver du julekransen",
      "text": "Rul dejen sammen fra den lange side, så du får en roulade."
    },
    {
      "section": "Sådan laver du julekransen",
      "text": "Skær rouladen over på langs, men stop før den ene ende, så de to halvdele hænger sammen. Sno de to strimler om hinanden."
    },
    {
      "section": "Sådan laver du julekransen",
      "text": "Læg snoningen i en rund krans, og tryk enderne godt sammen."
    },
    {
      "section": "Sådan laver du julekransen",
      "text": "Løft kransen over på en bageplade med bagepapir. Dæk til, og lad den hæve igen i cirka en halv time."
    },
    {
      "section": "Sådan laver du julekransen",
      "text": "Bag kransen midt i ovnen ved 200 °C (almindelig ovn) i 25 minutter, til den er gylden og bagt igennem."
    },
    {
      "section": "Sådan laver du julekransen",
      "text": "Pensl kransen med sukkerlagen straks efter bagningen, og drys med perlesukker."
    },
    {
      "section": "Sådan laver du julekransen",
      "text": "Server kransen lun. Pynt evt. med kanelstænger, stjerneanis og friske tranebær."
    }
  ],
