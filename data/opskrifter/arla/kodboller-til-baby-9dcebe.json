  "steps": [
    {
      "section": "Kødboller",
      "text": "Ælt kødet sammen med saltet i cirka 1 minut."
    },
    {
      "section": "Kødboller",
      "text": "Bland løg, hvidløg, citronskal og æg i farsen. Rør mælken i, og tilsæt derefter melet."
    },
    {
      "section": "Kødboller",
      "text": "Dæk farsen til, og lad den hvile i køleskabet i cirka 15 minutter."
    },
    {
      "section": "Kødboller",
      "text": "Smelt smørret i en pande, til det får en gylden farve."
    },
    {
      "section": "Kødboller",
      "text": "Brug en teske til at forme farsen til cirka 40 små kødboller."
    },
    {
      "section": "Kødboller",
      "text": "Steg kødbollerne ved jævn varme i cirka 3 minutter på hver side. Steg dem eventuelt i 2 omgange."
    },
    {
      "section": "Serveringsforslag",
      "text": "Giv 3-4 kødboller til hver portion fuldkornsgrød med ærter ved siden af."
    }
  ],
  "changes": [
    "Hakket grise- og kalvekød er skiftet til hakket svinekød, gerne blandet med kalvekød."
  ]
