  "steps": [
    {
      "section": "Flade boller",
      "text": "Smelt smørret i en gryde, og tag den af varmen. Hæld vandet i, og kom det hele i en skål."
    },
    {
      "section": "Flade boller",
      "text": "Rør gæren ud i væsken. Tilsæt sukker, salt, durummel og det meste af hvedemelet – gem ca. en fjerdedel af hvedemelet til senere. Dejen skal være klæbrig."
    },
    {
      "section": "Flade boller",
      "text": "Læg plastfilm over skålen, og lad dejen hæve et lunt sted i ca. en halv time."
    },
    {
      "section": "Tomatfyld",
      "text": "Lad de hakkede tomater dryppe af i en sigte i ca. 5 minutter, til der er ca. 175 g tomat tilbage."
    },
    {
      "section": "Tomatfyld",
      "text": "Bland de afdryppede tomater med tomatpuré og hvidløg i en skål."
    },
    {
      "section": null,
      "text": "Lad også saltosten dryppe af i sigten."
    },
    {
      "section": null,
      "text": "Vend dejen ud på et meldrysset bord, og ælt den godt. Ælt resten af hvedemelet i, hvis dejen har brug for det."
    },
    {
      "section": null,
      "text": "Del dejen i 8 lige store stykker, og form dem til boller. Rul hver bolle flad til ca. 12 cm i diameter."
    },
    {
      "section": null,
      "text": "Placér de flade boller på en bageplade med bagepapir. Dæk dem til, og lad dem efterhæve i ca. 15 minutter."
    },
    {
      "section": null,
      "text": "Tryk små fordybninger i bollerne med en fingerspids, og pensl dem med olivenolie."
    },
    {
      "section": null,
      "text": "Kom tomatblandingen på først, så oliven og til sidst osten."
    },
    {
      "section": null,
      "text": "Bag bollerne midt i ovnen ved 225 °C i ca. 20 minutter, til osten er gylden."
    }
  ],
  "changes": []
