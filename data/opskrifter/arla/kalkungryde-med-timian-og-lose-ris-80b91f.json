  "steps": [
    {
      "section": null,
      "text": "Kog risene efter anvisningen på pakken, mens gryderetten laves."
    },
    {
      "section": null,
      "text": "Skær kalkunen i tynde strimler på cirka 1 x 5 cm."
    },
    {
      "section": null,
      "text": "Hæld olien på en sauterpande, og varm den op ved kraftig varme. Den må ikke brune."
    },
    {
      "section": null,
      "text": "Svits kalkunstrimlerne i cirka 2 minutter ved kraftig varme."
    },
    {
      "section": null,
      "text": "Tilsæt fløde, vand, fond, gulerødder, porrer og timian."
    },
    {
      "section": null,
      "text": "Bring det i kog, og skru derefter ned på svag varme. Læg låg på, og lad det simre i cirka 3 minutter."
    },
    {
      "section": null,
      "text": "Pisk mel og vand sammen i en skål, til der ikke er klumper."
    },
    {
      "section": null,
      "text": "Rør jævningen i gryden, og krydr med salt og peber."
    },
    {
      "section": null,
      "text": "Lad gryden simre under låg ved svag varme i cirka 5 minutter. Smag til, og server med risene."
    }
