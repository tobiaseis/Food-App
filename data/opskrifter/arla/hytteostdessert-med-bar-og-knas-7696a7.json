  "steps": [
    {
      "section": "Hytteostdessert",
      "text": "Kom vand, perlebyg og salt i en gryde, og bring det i kog. Lad det simre under låg ved svag varme i ca. 25 minutter."
    },
    {
      "section": "Hytteostdessert",
      "text": "Si det overskydende vand fra, og stil perlebyggen tildækket i køleskabet, til den er helt kold."
    },
    {
      "section": "Hytteostdessert",
      "text": "Bland den kolde perlebyg med hytteost og vaniljesukker."
    },
    {
      "section": "Hytteostdessert",
      "text": "Slå fløden til et helt let skum, og vend det forsigtigt ind i blandingen. Smag til, og del desserten ud i 6 glas."
    },
    {
      "section": "Hindbærcoulis",
      "text": "Kom hindbær, sukker og vand i en gryde. Lad det koge ved svag varme i ca. 10 minutter, mens du rører, til det begynder at tykne."
    },
    {
      "section": "Hindbærcoulis",
      "text": "Passér coulisen gennem en fin sigte."
    },
    {
      "section": "Til servering",
      "text": "Top desserten med lun eller kold coulis, mysli, jordbær og blåbær."
    }
  ],
