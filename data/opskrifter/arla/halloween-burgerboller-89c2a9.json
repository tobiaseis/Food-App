  "steps": [
    {
      "section": null,
      "text": "Rør gæren ud i mælken i skålen på røremaskinen, til den er opløst."
    },
    {
      "section": null,
      "text": "Pisk æg og blæksprutteblæk ned i mælkeblandingen. Tilsæt sukker, salt og mel, men gem ca. 50 g af melet til senere."
    },
    {
      "section": null,
      "text": "Ælt dejen med dejkrogen på laveste hastighed i ca. 10 min."
    },
    {
      "section": null,
      "text": "Kom smørret og det sidste mel i skålen, og kør på laveste hastighed i ca. 2 min., til smørret er blandet i dejen."
    },
    {
      "section": null,
      "text": "Skru op på mellemhastighed, og ælt i ca. 10 min., til dejen slipper skålens kanter og samler sig om dejkrogen."
    },
    {
      "section": null,
      "text": "Del dejen i 20 lige store stykker, og rul dem til boller uden at bruge mel på bordet. Tryk dem let flade."
    },
    {
      "section": null,
      "text": "Fordel bollerne på to bageplader med bagepapir. Dæk dem til, og lad dem hæve i køleskabet i 8-24 timer."
    },
    {
      "section": null,
      "text": "Tag pladerne ud af køleskabet, og lad bollerne efterhæve et lunt sted i ca. 1 time."
    },
    {
      "section": null,
      "text": "Varm ovnen op til 200 °C (almindelig ovn). Pensl bollerne med vand, og drys dem med sesamfrø."
    },
    {
      "section": null,
      "text": "Bag én plade ad gangen midt i ovnen i 10-12 min."
    }
  ],
