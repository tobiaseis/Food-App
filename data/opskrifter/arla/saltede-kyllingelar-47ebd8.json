  "steps": [
    {
      "section": "Saltning, dagen før",
      "text": "Skyl underlårene, og dup dem tørre."
    },
    {
      "section": "Saltning, dagen før",
      "text": "Kom salt og sukker i en frysepose, og læg underlårene i. Luk posen tæt, og vend den rundt, så kødet dækkes jævnt."
    },
    {
      "section": "Saltning, dagen før",
      "text": "Sæt posen i køleskabet i cirka 1 døgn."
    },
    {
      "section": "Saltede kyllingelår",
      "text": "Hæld underlårene i et dørslag, og skyl dem med koldt vand. Dup dem grundigt tørre."
    },
    {
      "section": "Saltede kyllingelår",
      "text": "Smelt smørret i en sauterpande, til det bliver gyldent."
    },
    {
      "section": "Saltede kyllingelår",
      "text": "Brun underlårene i to omgange, 6 ad gangen, i cirka 2 minutter i alt, så alle sider får farve. Pas på, for fedtet kan sprøjte."
    },
    {
      "section": "Saltede kyllingelår",
      "text": "Læg alle underlårene tilbage i panden, og tilsæt nellikerne. Læg låg på, og lad dem simre ved svag varme i cirka en halv time."
    },
    {
      "section": "Saltede kyllingelår",
      "text": "Sæt en rist på en plade med bagepapir, og læg underlårene på risten. Steg dem øverst i ovnen ved 220 °C varmluft i cirka 10 minutter, til de er gyldne og sprøde."
    },
    {
      "section": "Saltede kyllingelår",
      "text": "Server lårene lune med rugbrød, rucola og tyttebærsyltetøj."
    }
  ],
