  "steps": [
    {
      "section": "Kylling og kartofler",
      "text": "Sæt ovnen på 225 °C (almindelig ovn). Beklæd en bageplade med bagepapir."
    },
    {
      "section": "Kylling og kartofler",
      "text": "Skær kyllingen over på langs, så den bliver til to halvdele, og læg dem på pladen."
    },
    {
      "section": "Kylling og kartofler",
      "text": "Smelt smørret og rør paprika, salt og peber i. Pensl blandingen over kyllingen."
    },
    {
      "section": "Kylling og kartofler",
      "text": "Skær kartofler, hvidløg og citron over på midten. Fordel dem rundt om kyllingen."
    },
    {
      "section": "Kylling og kartofler",
      "text": "Bag det hele midt i ovnen i ca. 45 minutter."
    },
    {
      "section": "Dressing",
      "text": "Pres saften fra den bagte citron og rør ca. 2 spsk af den sammen med yoghurt og salt."
    },
    {
      "section": "Dressing",
      "text": "Anret kyllingen med dressingen ved siden af. Drys med oregano og peber, og server med salat."
    }
  ],
