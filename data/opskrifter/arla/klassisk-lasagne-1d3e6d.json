  "steps": [
    {
      "section": "Kødsauce",
      "text": "Skær baconskiverne i små strimler. Varm olien op i en stor gryde."
    },
    {
      "section": "Kødsauce",
      "text": "Svits løg, gulerod, selleri og bacon ved middel varme i ca. 5 min."
    },
    {
      "section": "Kødsauce",
      "text": "Tilsæt oksekødet, skru op for varmen og brun det i ca. 2 min. Hæld vinen i og lad den koge ind i ca. 1 min."
    },
    {
      "section": "Kødsauce",
      "text": "Rør bouillon, tomatpuré, laurbærblade, salt og peber i. Bring det i kog, læg låg på og lad saucen simre ved svag varme i ca. 30 min."
    },
    {
      "section": "Kødsauce",
      "text": "Rør mælken i, tag laurbærbladene op, og smag til."
    },
    {
      "section": "Bechamelsauce",
      "text": "Smelt smørret i en gryde ved kraftig varme, så det ikke tager farve."
    },
    {
      "section": "Bechamelsauce",
      "text": "Pisk melet i og rør i ca. 15 sek., så det trækker sammen med smørret."
    },
    {
      "section": "Bechamelsauce",
      "text": "Hæld en tredjedel af mælken i og rør, til saucen er glat. Gentag to gange med resten af mælken, en tredjedel ad gangen."
    },
    {
      "section": "Bechamelsauce",
      "text": "Smag til med muskatnød og salt. Lad saucen simre ved svag varme i ca. 5 min., og rør indimellem."
    },
    {
      "section": "Samling",
      "text": "Hæld en tredjedel af kødsaucen i et ovnfast fad (ca. 18 x 25 cm)."
    },
    {
      "section": "Samling",
      "text": "Læg 4 lasagneplader over, smør en tredjedel af bechamelsaucen ovenpå, og drys med en fjerdedel af parmesanen."
    },
    {
      "section": "Samling",
      "text": "Byg to lag mere på samme måde. Slut med resten af bechamelsaucen og parmesanen øverst."
    },
    {
      "section": "Samling",
      "text": "Bag lasagnen midt i ovnen ved 200 °C (almindelig ovn) i ca. 35 min. Hvis overfladen bliver for mørk, dæk den med bagepapir de sidste 5-10 min."
    },
    {
      "section": "Samling",
      "text": "Lad lasagnen hvile tildækket i ca. 10 min., før den serveres."
    },
    {
      "section": "Til servering",
      "text": "Drys salaten med salt og peber og server den til lasagnen."
    }
  ],
  "changes": [
    "Pancetta er erstattet af bacon i skiver."
  ]
