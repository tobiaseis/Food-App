  "steps": [
    {
      "section": null,
      "text": "Varm en pande op ved kraftig varme, og smelt halvdelen af smørret, så det ikke tager farve."
    },
    {
      "section": null,
      "text": "Læg brødskiverne på panden, og steg dem gyldne på den ene side."
    },
    {
      "section": null,
      "text": "Vend brødskiverne, og læg osten på de gyldne sider. Tilsæt resten af smørret, og steg, til undersiden er gylden, og osten begynder at smelte."
    },
    {
      "section": null,
      "text": "Halvér avocadoen, og fjern sten og skal. Mos kødet groft med en gaffel."
    },
    {
      "section": null,
      "text": "Smør avocadomosen oven på den smeltede ost. Læg mango, forårsløg og skinke ovenpå."
    },
    {
      "section": null,
      "text": "Top med koriander, og server med det samme."
    }
