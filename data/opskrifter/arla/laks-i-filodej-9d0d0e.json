  "steps": [
    {
      "section": "Filopakker",
      "text": "Varm spinaten op i en gryde ved jævn varme, til den er tøet. Krydr med salt og peber."
    },
    {
      "section": "Filopakker",
      "text": "Del laksen i 15 mindre stykker."
    },
    {
      "section": "Filopakker",
      "text": "Læg filodejspladerne i en stak, og dæk dem med et fugtigt viskestykke, så de ikke tørrer ud."
    },
    {
      "section": "Filopakker",
      "text": "Tag to plader ad gangen, og pensl dem med vand, så de hænger sammen. Skær dem i 3 lige brede strimler på ca. 10 x 50 cm."
    },
    {
      "section": "Filopakker",
      "text": "Anbring 5-6 ostetern, noget af spinaten og et stykke laks nederst i højre hjørne af en strimmel. Lad der være lidt afstand til kanten."
    },
    {
      "section": "Filopakker",
      "text": "Fold hjørnet med fyldet på skrå op mod strimlens venstre side, så det danner en trekant. Bliv ved med at folde trekanten op, til hele strimlen er brugt."
    },
    {
      "section": "Filopakker",
      "text": "Anbring pakken med samlingen nedad på en plade med bagepapir. Fyld og fold resten af strimlerne på samme måde."
    },
    {
      "section": "Filopakker",
      "text": "Pensl pakkerne med vand, og drys dem med nigellafrø. Bag dem midt i ovnen ved 225 °C i ca. 15 minutter."
    },
    {
      "section": "Citronsauce",
      "text": "Smelt smørret i en gryde ved kraftig varme, og pas på, at det ikke bruner. Rør forårsløgene i smørret i ca. 1 minut."
    },
    {
      "section": "Citronsauce",
      "text": "Pisk majsstivelse ud i mælken, og hæld det langsomt i gryden, mens du rører."
    },
    {
      "section": "Citronsauce",
      "text": "Lad saucen komme i kog, og lad den simre ved svag varme i ca. 2 minutter under omrøring."
    },
    {
      "section": "Citronsauce",
      "text": "Tag gryden af varmen. Rør fløde, citronsaft, citronskal, sukker, salt og peber i, og smag til."
    },
    {
      "section": "Salat",
      "text": "Vend salatblanding og forårsløg sammen med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Server de varme filopakker med citronsaucen, salaten og de kogte kartofler."
    }
  ],
