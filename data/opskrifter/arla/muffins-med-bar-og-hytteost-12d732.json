  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 175 °C (almindelig ovn). Sæt papirforme i muffinforme eller direkte på en bageplade med bagepapir."
    },
    {
      "section": null,
      "text": "Pisk æg og rørsukker, til massen er lys og luftig."
    },
    {
      "section": null,
      "text": "Bland bagepulver og hvedemel. Sigt det over æggemassen i omgange, og vend det i vekslende med kærnemælk, appelsinsaft og det smeltede smør."
    },
    {
      "section": null,
      "text": "Vend hytteost og bær forsigtigt i dejen."
    },
    {
      "section": null,
      "text": "Fyld papirformene cirka halvt op med dej, så der bliver 16 muffins."
    },
    {
      "section": null,
      "text": "Bag muffinsene midt i ovnen i ca. 30 minutter."
    }
