  "steps": [
    {
      "section": "Kyllingespyd",
      "text": "Skær kyllingen i tern, og træk dem på spyddene skiftevis med stykkerne af peberfrugt."
    },
    {
      "section": "Kyllingespyd",
      "text": "Rør ketchup, oregano, sojasauce, salt og peber sammen, og pensl blandingen over spyddene."
    },
    {
      "section": "Kyllingespyd",
      "text": "Læg spyddene i et ovnfast fad, og sæt dem øverst i ovnen under grillen i ca. 9 minutter. Vend dem midtvejs."
    },
    {
      "section": "Pesto",
      "text": "Kom persille, mozzarella, pinjekerner, salt, hvidløg og bouillon i en foodprocessor eller blender, og kør det i ca. 30 sekunder."
    },
    {
      "section": "Pesto",
      "text": "Tilsæt olien, og smag pestoen til med peber."
    },
    {
      "section": "Til servering",
      "text": "Kog spaghettien, så længe pakken angiver, og vend den med pestoen."
    },
    {
      "section": "Til servering",
      "text": "Bland salaten med tomater, broccoli og rødløg, og dryp med citronsaft. Server spaghettien med det samme sammen med spyd og salat."
    }
  ],
