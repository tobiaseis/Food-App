  "steps": [
    {
      "section": null,
      "text": "Krydr kødet på begge sider med salt og peber."
    },
    {
      "section": null,
      "text": "Varm panden op, og lad smørret tage gylden farve. Steg kødet i panden, og læg det derefter til side under låg eller staniol, så det holder varmen."
    },
    {
      "section": "Smørsauce",
      "text": "Hæld vandet på den samme pande, og lad det koge kraftigt ind, mens du skraber stegeskyen løs fra bunden. Fortsæt, til der kun er cirka 1 dl væske tilbage."
    },
    {
      "section": "Smørsauce",
      "text": "Tag panden af varmen. Rør de kolde smørtern i saucen ét ad gangen med en piskeris. Smørret skal blive cremet og ikke smelte helt ud."
    },
    {
      "section": "Smørsauce",
      "text": "Smag saucen til med sherry og peber."
    },
    {
      "section": "Tilbehør",
      "text": "Server kødet med saucen sammen med kartofler og dampede grøntsager."
