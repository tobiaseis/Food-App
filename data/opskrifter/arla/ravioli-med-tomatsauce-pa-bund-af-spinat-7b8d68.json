  "steps": [
    {
      "section": null,
      "text": "Smelt smørret i en pande på kraftig varme, så det ikke brunes."
    },
    {
      "section": null,
      "text": "Svits løg, hvidløg og svampe i cirka 5 minutter. Krydr med salt og peber."
    },
    {
      "section": null,
      "text": "Imens kommes tomater, bouillon og cheddar i en lille gryde. Gem cirka en fjerdedel af osten til pynt. Bring saucen i kog under omrøring."
    },
    {
      "section": null,
      "text": "Kog raviolien efter anvisningen på pakken, og lad den dryppe af i et dørslag."
    },
    {
      "section": null,
      "text": "Kom den varme ravioli tilbage i gryden, og vend den med spinaten, til bladene falder lidt sammen."
    },
    {
      "section": null,
      "text": "Anret raviolien i et stort fad, og top med tomatsaucen og svampeblandingen."
    },
    {
      "section": null,
      "text": "Drys med parmesan og den gemte ost, og server med brødet."
    }
