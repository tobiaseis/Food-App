  "steps": [
    {
      "section": "Marinade",
      "text": "Pisk sojasauce, æggeblomme og majsstivelse til marinaden sammen i et fad."
    },
    {
      "section": "Marinade",
      "text": "Skær svinemørbraden i skiver på 1 cm, og bank dem tynde. Del dem i stykker på ca. 2 x 3 cm."
    },
    {
      "section": "Marinade",
      "text": "Vend kødet i marinaden, dæk fadet til, og stil det på køl i ca. 1 time."
    },
    {
      "section": "Løse ris",
      "text": "Bring vandet i kog med saltet, og rør risene i. Lad dem koge under låg ved svag varme i ca. 12 minutter."
    },
    {
      "section": "Løse ris",
      "text": "Tag gryden af varmen, og lad risene stå med låg på i ca. 12 minutter."
    },
    {
      "section": "Stegning af kød",
      "text": "Vend kødstykkerne i majsstivelsen."
    },
    {
      "section": "Stegning af kød",
      "text": "Brun smørret i en stegegryde, og steg kødet i portioner i ca. 1 minut ad gangen. Tag kødet op."
    },
    {
      "section": "Stegning af kød",
      "text": "Si ananasringene fra, og gem saften. Skær ananassen i mindre stykker."
    },
    {
      "section": "Stegning af kød",
      "text": "Smelt det andet smør i gryden, og svits hvidløg og løg."
    },
    {
      "section": "Stegning af kød",
      "text": "Hak peberfrugten, og svits den med i ca. 1 minut. Kom ananasstykkerne i."
    },
    {
      "section": "Sur-sød sauce",
      "text": "Rør alle ingredienserne til saucen sammen, og hæld dem i gryden."
    },
    {
      "section": "Sur-sød sauce",
      "text": "Kog saucen op under omrøring. Kom kødet tilbage i, og lad det blive varmt hele vejen igennem. Smag til, og server med risene."
    }
  ],
