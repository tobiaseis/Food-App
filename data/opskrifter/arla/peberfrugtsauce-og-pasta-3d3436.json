  "steps": [
    {
      "section": "Grillede peberfrugter",
      "text": "Halvér peberfrugterne, og fjern kerner og hvide skillevægge. Læg dem med skindet opad på en plade med alufolie."
    },
    {
      "section": "Grillede peberfrugter",
      "text": "Grill pladen øverst i ovnen i ca. 7 min. Tag den ud, og læg bagepapir og et viskestykke over peberfrugterne."
    },
    {
      "section": "Grillede peberfrugter",
      "text": "Lad dem trække i ca. 15 min., så skindet løsner sig. Pil skindet af, og skær kødet i brede strimler."
    },
    {
      "section": "Ristede mandler",
      "text": "Rist mandlerne på en tør pande under jævnlig omrøring: først ca. 2 min. på høj varme, så ca. 5 min. på middel varme. Hak dem groft."
    },
    {
      "section": "Pasta og sauce",
      "text": "Kog pastaen efter pakkens anvisning, så den er mør, men ikke blød. Hæld den i et dørslag, og lad vandet løbe fra."
    },
    {
      "section": "Pasta og sauce",
      "text": "Kom hakkede tomater, chili, fløde, salt og peberfrugtstrimlerne i den tomme gryde. Bring det i kog under omrøring."
    },
    {
      "section": "Pasta og sauce",
      "text": "Vend den varme pasta i saucen, og smag til."
    },
    {
      "section": "Topping",
      "text": "Bland ost, mandler og limeskal til et drys."
    },
    {
      "section": "Topping",
      "text": "Server pastaen med toppingen og limebåde, så hver kan presse lidt limesaft over."
    }
  ],
