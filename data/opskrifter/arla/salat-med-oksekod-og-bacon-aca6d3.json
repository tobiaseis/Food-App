  "steps": [
    {
      "section": "Rød dressing",
      "text": "Pisk alle ingredienserne til dressingen sammen. Dæk til og stil den på køl i mindst en halv time, og smag den til."
    },
    {
      "section": "Salat",
      "text": "Tænd ovnen på 200 °C. Beklæd en bageplade med bagepapir og læg baconskiverne på."
    },
    {
      "section": "Salat",
      "text": "Bag baconen midt i ovnen i ca. 25 minutter, til den er gylden og sprød. Lad den dryppe af på køkkenrulle."
    },
    {
      "section": "Salat",
      "text": "Smelt halvdelen af smørret i en pande, til det får en gylden farve. Brun halvdelen af oksekødet ved høj varme i ca. 6 minutter, mens du rører i det. Tag det af panden, og gentag med resten af smørret og kødet."
    },
    {
      "section": "Salat",
      "text": "Put alt kødet tilbage på panden med citronskal og halvdelen af forårsløgene. Krydr med salt og peber, og lad det stege videre i ca. 1 minut. Smag til."
    },
    {
      "section": "Ved serveringen",
      "text": "Hak den sprøde bacon groft. Bland hjertesalat og babysalatblade med resten af forårsløgene."
    },
    {
      "section": "Ved serveringen",
      "text": "Fyld halvdelen af salaten i 24 glas à ca. 3 dl, så der er to glas pr. person. Fordel det lune kød og baconen i glassene, og dæk med resten af salaten."
    },
    {
      "section": "Ved serveringen",
      "text": "Hæld dressingen i en skål, og pynt med lidt sød chilisauce. Server med flute og pynt evt. med babysalatblade."
    }
  ],
  "changes": []
