  "steps": [
    {
      "section": "Tempuradej",
      "text": "Skil ægget, så blommen og hviden er hver for sig."
    },
    {
      "section": "Tempuradej",
      "text": "Bland mel og salt i en skål."
    },
    {
      "section": "Tempuradej",
      "text": "Visp mælk, øl og æggeblomme sammen. Rør det gradvist ned i melet, og visp til sidst smørret i."
    },
    {
      "section": "Tempuradej",
      "text": "Dæk dejen til, og lad den hvile på køl i omkring 1 time."
    },
    {
      "section": "Tempuradej",
      "text": "Støv hviden til stiv skum, og vend den forsigtigt ned i dejen lige før stegning."
    },
    {
      "section": "Sojadip",
      "text": "Bring soja, honning, ingefær og limesaft i kog i en lille gryde, og lad det simre ved middel varme i ca. 2 minutter."
    },
    {
      "section": "Sojadip",
      "text": "Hæld dippen i en skål, og sæt den tildækket på køl."
    },
    {
      "section": "Til anretning",
      "text": "Bland spidskål og koriander, og fordel det i bunden af et fad."
    },
    {
      "section": "Stegning",
      "text": "Varm olien op ved middel varme i en dyb gryde. Læg et stykke franskbrød i olien: Bliver det gyldent, er olien varm nok."
    },
    {
      "section": "Stegning",
      "text": "Vend 6-8 stykker grøntsager i dejen, og læg dem straks i olien."
    },
    {
      "section": "Stegning",
      "text": "Steg dem i ca. 1½ minut, til de er gyldne og sprøde. Vend dem undervejs, fx med en pincet."
    },
    {
      "section": "Stegning",
      "text": "Løft grøntsagerne op, og lad dem dryppe af på køkkenrulle. Steg resten af grøntsagerne på samme måde."
    },
    {
      "section": "Til servering",
      "text": "Læg de stegte grøntsager på spidskålen, og drys med koriander og chili. Læg limebåde ved siden af."
    },
    {
      "section": "Til servering",
      "text": "Server med det samme med sojadip og sød chilisauce."
    }
  ],
