  "steps": [
    {
      "section": "Pocherede æg",
      "text": "Kom vand, eddike og groft salt i en gryde, og bring det i kog."
    },
    {
      "section": "Pocherede æg",
      "text": "Slå hvert æg ud i en kop, så de er klar ved gryden."
    },
    {
      "section": "Pocherede æg",
      "text": "Rør rundt i det kogende vand med et piskeris, til der er en hvirvel. Tag piskeriset op."
    },
    {
      "section": "Pocherede æg",
      "text": "Lad ét æg ad gangen glide forsigtigt ned i midten af hvirvlen. Lad dem simre i cirka 3 minutter, til hviden er stivnet, og blommen stadig er flydende."
    },
    {
      "section": "Pocherede æg",
      "text": "Tag æggene op med en hulske, og læg dem i iskoldt vand i cirka 30 sekunder, så de ikke koger videre."
    },
    {
      "section": null,
      "text": "Bland yoghurt og hvidløg."
    },
    {
      "section": null,
      "text": "Varm smørret op i en lille pande eller gryde, til det er smeltet, og rør chiliflagerne i."
    },
    {
      "section": null,
      "text": "Fordel yoghurten på tallerkener, og læg de pocherede æg ovenpå. Hæld chilismørret over, og top med dild."
    },
    {
      "section": null,
      "text": "Krydr med flagesalt og peber. Server med brød."
    }
  ],
  "changes": []
