  "steps": [
    {
      "section": "Tærtedej",
      "text": "Bland begge slags mel med saltet i en skål."
    },
    {
      "section": "Tærtedej",
      "text": "Skær smørret i små stykker, og gnid det ud i melet, til det er smuldret."
    },
    {
      "section": "Tærtedej",
      "text": "Tilsæt vandet, og saml dejen let. Pres den derefter ud i en springform eller tærteform på ca. 25 cm i diameter."
    },
    {
      "section": "Tærtedej",
      "text": "Pres dejen godt op ad kanten. Forbag bunden midt i ovnen i 15 minutter ved 200 °C (almindelig ovn)."
    },
    {
      "section": "Fyld",
      "text": "Brun baconen på en pande eller i en gryde ved høj varme i ca. 5 minutter."
    },
    {
      "section": "Fyld",
      "text": "Kom porrerne på, men gem en håndfuld ringe til pynt. Steg ved middelvarme i ca. 5 minutter, til porrerne er klare og faldet sammen."
    },
    {
      "section": "Fyld",
      "text": "Krydr med timian, muskatnød, citronsaft, salt og peber."
    },
    {
      "section": "Fyld",
      "text": "Tag panden af varmen. Rør mælk, æg og halvdelen af osten i."
    },
    {
      "section": "Fyld",
      "text": "Hæld fyldet i den forbagte tærtebund, og fordel resten af osten ovenpå."
    },
    {
      "section": "Fyld",
      "text": "Læg rødløgsskiverne og de reserverede porreringe øverst."
    },
    {
      "section": "Fyld",
      "text": "Bag tærten midt i ovnen i 25-30 minutter ved 200 °C (almindelig ovn)."
    }
  ],
