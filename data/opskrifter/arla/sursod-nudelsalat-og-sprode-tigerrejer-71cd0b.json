  "steps": [
    {
      "section": "Nudelsalat",
      "text": "Bring vandet i en stor gryde i kog, og læg nudlerne i. Kog dem under jævnlig omrøring i 3-4 minutter, til de har løsnet sig fra hinanden og er møre, men ikke bløde."
    },
    {
      "section": "Nudelsalat",
      "text": "Øs en halv deciliter af kogevandet til side. Hæld nudlerne i et dørslag, og lad dem dryppe godt af."
    },
    {
      "section": "Nudelsalat",
      "text": "Rør eddike, det afmålte kogevand, sukker og salt sammen i den tomme gryde. Kom gulerødder og peberfrugt ned i marinaden, og vend nudlerne i."
    },
    {
      "section": "Nudelsalat",
      "text": "Dæk gryden og lad salaten trække ved stuetemperatur i mindst 15 minutter. Smag den til."
    },
    {
      "section": "Nudelsalat",
      "text": "Tip: Lader du salaten køle helt af, så rør en halv deciliter ekstra kogevand i, så den ikke bliver tør."
    },
    {
      "section": "Sprøde tigerrejer",
      "text": "Forvarm ovnen til 225 °C (almindelig ovn)."
    },
    {
      "section": "Sprøde tigerrejer",
      "text": "Slå ægget ud på en dyb tallerken, og pisk det let. Bland rasp, pastaost, tandoorikrydderi og salt på en anden tallerken."
    },
    {
      "section": "Sprøde tigerrejer",
      "text": "Dyp hver reje i ægget, og rul den derefter i osteblandingen. Tryk panaden fast med fingrene."
    },
    {
      "section": "Sprøde tigerrejer",
      "text": "Anbring rejerne på en bageplade med bagepapir, og drys resten af osteblandingen over dem."
    },
    {
      "section": "Sprøde tigerrejer",
      "text": "Bag rejerne øverst i ovnen i cirka 10 minutter, til de er gyldne og sprøde."
    },
    {
      "section": "Til servering",
      "text": "Anret nudelsalaten med rejerne, og server ketjap manis og sød chilisauce ved siden af."
    }
  ],
