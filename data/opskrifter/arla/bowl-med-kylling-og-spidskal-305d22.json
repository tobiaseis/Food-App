  "steps": [
    {
      "section": "Couscous",
      "text": "Put couscous og salt i en skål, og overhæld med det kogende vand."
    },
    {
      "section": "Couscous",
      "text": "Lad den trække i ca. 10 minutter, og luft den et par gange med en gaffel."
    },
    {
      "section": "Kylling og kål",
      "text": "Varm kyllingestykkerne i en pande, og læg dem over på en tallerken."
    },
    {
      "section": "Kylling og kål",
      "text": "Svits spidskål, soltørrede tomater, spidskommen og salt i den samme pande ved høj varme i ca. 1 minut, mens du rører hele tiden."
    },
    {
      "section": "Bowl",
      "text": "Vend ærterne med olie fra tomaterne, hakket mynte og salt."
    },
    {
      "section": "Bowl",
      "text": "Fordel den lune couscous i 4 skåle lige før servering. Anret kylling, spidskål med tomater og ærter ovenpå."
    },
    {
      "section": "Bowl",
      "text": "Læg hytteost i hver skål, og dryp harissa over. Pynt med mynteblade."
    }
