  "steps": [
    {
      "section": null,
      "text": "Brun champignonerne i en stor pande over høj varme i cirka 5 minutter."
    },
    {
      "section": null,
      "text": "Skru ned til middel varme. Kom løg, hvidløg, soltørrede tomater, tomatpuré, timian og chiliflager på panden, og steg i cirka 5 minutter."
    },
    {
      "section": null,
      "text": "Hæld madlavningsfløde og bouillon i, og kom osten ved. Rør, indtil osten er helt smeltet."
    },
    {
      "section": null,
      "text": "Kom bønnerne på panden og krydr med salt og peber. Lad det simre i cirka 5 minutter, og rør af og til. Smag til."
    },
    {
      "section": null,
      "text": "Vend spinaten i, og rør rundt, til den er faldet sammen."
    },
    {
      "section": null,
      "text": "Pynt eventuelt med basilikumblade, og server med den grønne salat."
    }
