  "steps": [
    {
      "section": "Tomatsauce",
      "text": "Varm smørret op i en tykbundet gryde ved høj varme. Det må ikke blive brunt."
    },
    {
      "section": "Tomatsauce",
      "text": "Rør sødkartoflen i gryden og svits den i ca. 5 min."
    },
    {
      "section": "Tomatsauce",
      "text": "Hæld tomaterne i, drys med saltet, og lad saucen simre under låg ved lav varme i ca. 5 min."
    },
    {
      "section": "Stegte rejer",
      "text": "Tør rejerne godt med køkkenrulle."
    },
    {
      "section": "Stegte rejer",
      "text": "Brun smørret let i en pande, til det får en gylden farve."
    },
    {
      "section": "Stegte rejer",
      "text": "Steg rejerne ved høj varme, mens du rører rundt, i ca. 2 min. Kom chili, hvidløg og salt på, sænk varmen, og steg videre i ca. 2 min."
    },
    {
      "section": null,
      "text": "Varm tortillaerne, som det står på pakken."
    },
    {
      "section": null,
      "text": "Stil tomatsauce, rejer, spidskål, koriander, limebåde og creme fraiche på bordet, så alle selv kan fylde deres tortillas."
    }
  ],
