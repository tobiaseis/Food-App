  "steps": [
    {
      "section": null,
      "text": "Rør hvedemel, bagepulver, sukker og salt sammen i en stor skål. Gem en smule af melet til senere."
    },
    {
      "section": null,
      "text": "Kom det revne grønt, vand, yoghurt og olivenolie i skålen, og ælt det hele til en dej. Tilsæt efter behov noget af det resterende mel."
    },
    {
      "section": null,
      "text": "Dæk skålen til, og lad dejen hvile ved stuetemperatur i ca. 10 minutter."
    },
    {
      "section": null,
      "text": "Del dejen i 8 lige store stykker, og rul hvert stykke tyndt ud."
    },
    {
      "section": null,
      "text": "Bag brødene et ad gangen på en tør pande ved middel varme, ca. 2 minutter på hver side. Læg dem under et rent viskestykke, så de holder varmen."
    },
    {
      "section": "Hvidløgssmør",
      "text": "Rør det smeltede smør sammen med hvidløg og persille. Pensl smørret over de varme brød."
    }
  ],
