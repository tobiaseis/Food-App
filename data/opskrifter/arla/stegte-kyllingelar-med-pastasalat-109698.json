  "steps": [
    {
      "section": "Stegte kyllingelår",
      "text": "Tænd ovnen på 200 °C (traditionel ovn). Smør et ovnfast fad på ca. 15 x 25 cm."
    },
    {
      "section": "Stegte kyllingelår",
      "text": "Dup kyllingelårene tørre med køkkenrulle. Pisk ægget løst i en dyb tallerken."
    },
    {
      "section": "Stegte kyllingelår",
      "text": "Rør rasp, paprika, salt og peber sammen. Vend lårene først i ægget og derefter i raspblandingen, så de er dækket hele vejen rundt."
    },
    {
      "section": "Stegte kyllingelår",
      "text": "Læg lårene i fadet, og sæt det midt i ovnen. Steg dem i ca. 50 minutter, til kødet er gennemstegt."
    },
    {
      "section": "Pastasalat",
      "text": "Bring letsaltet vand i kog i en stor gryde. Kog pastaen uden låg i ca. 8 minutter."
    },
    {
      "section": "Pastasalat",
      "text": "Kom bønnerne i gryden, og kog dem med i ca. 3 minutter, stadig uden låg. Hæld pasta og bønner i en sigte, og lad vandet dryppe godt af."
    },
    {
      "section": "Pastasalat",
      "text": "Vend pasta og bønner med squash, forårsløg, tomater, feta, persille, hvidløg, citronsaft, salt og peber."
    },
    {
      "section": "Pastasalat",
      "text": "Kom salaten i en skål, og drys med persille. Server den med kyllingelårene og brødet."
    }
  ],
