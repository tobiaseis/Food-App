  "steps": [
    {
      "section": "Sennepsdressing",
      "text": "Rør sennep, salt, peber og eddike sammen med en piskeris."
    },
    {
      "section": "Sennepsdressing",
      "text": "Pisk olien i en tynd stråle ned i blandingen, og smag dressingen til."
    },
    {
      "section": "Croutoner",
      "text": "Sæt ovnen på 225 °C varmluft."
    },
    {
      "section": "Croutoner",
      "text": "Læg brødternene og smørstykkerne i en lille bradepande, og ristes midt i ovnen i cirka 10 minutter. Vend terningerne 2-3 gange undervejs."
    },
    {
      "section": "Ostesalat",
      "text": "Snit baconen i mindre stykker, og steg dem sprøde på en tør pande ved svag varme."
    },
    {
      "section": "Ostesalat",
      "text": "Læg baconen på køkkenrulle, så fedtet kan sive fra."
    },
    {
      "section": "Ostesalat",
      "text": "Læg salat, ost, bacon og croutoner i et dybt fad."
    },
    {
      "section": "Ostesalat",
      "text": "Sæt dressingen på bordet i en skål, så hver kan hælde selv."
    }
  ],
  "changes": [
    "Sandwichbrød er skiftet til toastbrød."
  ]
