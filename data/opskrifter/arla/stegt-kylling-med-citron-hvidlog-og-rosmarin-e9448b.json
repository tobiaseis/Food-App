  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 175 °C."
    },
    {
      "section": null,
      "text": "Skyl kyllingen og dup den tør. Klip vingespidserne og gumpen af."
    },
    {
      "section": null,
      "text": "Bland det bløde smør med citronskal, hvidløg, rosmarin, salt og peber."
    },
    {
      "section": null,
      "text": "Smør kyllingen med blandingen både ude og inde. Put citronbådene i hulrummet, og sæt en kødnål i åbningen, så den er lukket."
    },
    {
      "section": null,
      "text": "Drys saltet over kyllingen. Læg den med brystet opad i en lille bradepande på ca. 20 x 28 cm."
    },
    {
      "section": null,
      "text": "Sæt bradepanden midt i ovnen og steg kyllingen i ca. 45 min."
    },
    {
      "section": null,
      "text": "Tag panden ud, hæld skyen fra og smid den væk. Sæt kyllingen tilbage og steg den færdig i yderligere ca. 45 min."
    },
    {
      "section": null,
      "text": "Lad kyllingen hvile i ca. 10 min. før servering."
    },
    {
      "section": null,
      "text": "Server den hel, eller skær den i 8 stykker. Tilbehør efter ønske."
    }
  ],
