  "steps": [
    {
      "section": "Lever",
      "text": "Pil eventuelle hinder af leveren, og skær den i skiver på cirka 1 cm."
    },
    {
      "section": "Lever",
      "text": "Brun smørret gyldent på en pande. Steg leverskiverne ved middel varme i cirka 3 minutter på hver side."
    },
    {
      "section": "Lever",
      "text": "Krydr med salt og peber. Læg leveren på et varmt fad, dæk den til, og lad den trække i cirka 10 minutter."
    },
    {
      "section": "Kaperssauce",
      "text": "Rist persillekvistene kort i den samme pande."
    },
    {
      "section": "Kaperssauce",
      "text": "Hæld vandet på, og skrab stegeskyen fri fra panden."
    },
    {
      "section": "Kaperssauce",
      "text": "Kom kapers, citronskal, citronsaft, fløde, salt og peber i. Kog saucen op, og lad den koge kraftigt under omrøring i cirka 1 minut."
    },
    {
      "section": "Kaperssauce",
      "text": "Tyk om nødvendigt saucen med saucejævner, og smag til."
    },
    {
      "section": "Ærter",
      "text": "Skyl de frosne ærter i en sigte under koldt vand, og lad dem dryppe af."
    },
    {
      "section": "Ærter",
      "text": "Smelt smørret i en gryde ved kraftig varme, så det ikke bruner. Svits løgbådene i cirka 3 minutter."
    },
    {
      "section": "Ærter",
      "text": "Kom ærter og salt i gryden, og varm dem godt igennem. Smag til."
    },
    {
      "section": "Til servering",
      "text": "Server leveren med saucen, ærterne og de kogte kartofler."
    }
  ],
