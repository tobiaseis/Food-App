  "steps": [
    {
      "section": null,
      "text": "Rør olivenolie, chili og hvidløg sammen i en skål."
    },
    {
      "section": null,
      "text": "Kom rejerne i marinaden, dæk skålen til og sæt den på køl i cirka 15 minutter."
    },
    {
      "section": null,
      "text": "Varm grillen eller grillpanden godt op i mellemtiden."
    },
    {
      "section": null,
      "text": "Træk rejerne på spyddene, og grill dem cirka 2 minutter på hver side."
    },
    {
      "section": null,
      "text": "Løft spyddene af varmen, og strø citronskal og salt over."
    },
    {
      "section": null,
      "text": "Top med basilikum, og server med det samme."
