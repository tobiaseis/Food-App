  "steps": [
    {
      "section": "Krydret blomkål",
      "text": "Del blomkålsbuketterne i skiver på ca. ½ cm. Rør dem rundt i barbecuesaucen, så de er dækket."
    },
    {
      "section": "Toast",
      "text": "Smør brødskiverne med smør på den ene side."
    },
    {
      "section": "Toast",
      "text": "Bland avocado, løg, hvidløg, salt og peber til en mos."
    },
    {
      "section": "Toast",
      "text": "Fordel avocadomosen på 4 af skiverne, og top med ost og den krydrede blomkål. Læg de sidste 4 skiver ovenpå, så smørsiden vender udad."
    },
    {
      "section": "Toast",
      "text": "Varm toastmaskinen godt op. Rist sandwichene 2 ad gangen i ca. 5 min., til brødet er gyldent og osten smeltet. Server med det samme."
    }
  ],
