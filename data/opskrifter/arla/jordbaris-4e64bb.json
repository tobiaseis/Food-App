  "steps": [
    {
      "section": "Jordbæris",
      "text": "Pisk æggeblommerne med sukkeret i ca. 2 minutter, til massen er lys og luftig."
    },
    {
      "section": "Jordbæris",
      "text": "Kog fløden op sammen med vaniljestangen i en lille gryde med tyk bund. Tag gryden af varmen."
    },
    {
      "section": "Jordbæris",
      "text": "Hæld æggemassen i den varme fløde, mens du pisker."
    },
    {
      "section": "Jordbæris",
      "text": "Sæt gryden på jævn varme igen, og varm cremen op til lige under kogepunktet i ca. 2 minutter. Pisk hele tiden, og se efter, at cremen bliver tykkere. Den må ikke koge."
    },
    {
      "section": "Jordbæris",
      "text": "Si cremen, og lad den køle helt af."
    },
    {
      "section": "Jordbæris",
      "text": "Blend jordbærrene med sukker og limesaft til en glat puré, og rør den ned i den afkølede creme."
    },
    {
      "section": "Jordbæris",
      "text": "Kom blandingen i en form på ca. 1 liter, dæk til, og stil den i fryseren. Rør rundt i isen 4-5 gange, mens den fryser."
    },
    {
      "section": "Limesukker",
      "text": "Bland sukker og limeskal i en lille skål."
    },
    {
      "section": "Limesukker",
      "text": "Server jordbærisen med limesukkeret drysset over."
    }
  ],
  "changes": []
