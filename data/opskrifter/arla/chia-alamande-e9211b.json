  "steps": [
    {
      "section": "Chia alamande",
      "text": "Del vaniljestangen på langs, og skrab kornene ud. Gem selve stangen."
    },
    {
      "section": "Chia alamande",
      "text": "Rør vaniljekorn og sukker sammen i en skål. Tilsæt chiafrø, mælk og skyr, og rør det godt sammen. Læg vaniljestangen i blandingen."
    },
    {
      "section": "Chia alamande",
      "text": "Dæk skålen til, og lad den stå køligt i mindst 4 timer, gerne natten over."
    },
    {
      "section": "Saltkaramelsauce",
      "text": "Kom fløde, flormelis og sirup i en tykbundet gryde, og bring det i kog. Lad det simre ved jævn varme i 6-8 minutter, mens du rører."
    },
    {
      "section": "Saltkaramelsauce",
      "text": "Rør smør og salt i, til saucen er glat. Tag gryden af varmen, og lad saucen køle af."
    },
    {
      "section": "Til færdiggørelse",
      "text": "Fisk vaniljestangen op af chiablandingen, og rør de hakkede mandler i."
    },
    {
      "section": "Til færdiggørelse",
      "text": "Pisk fløden til et let skum, og vend den forsigtigt ind i chiablandingen."
    },
    {
      "section": "Til færdiggørelse",
      "text": "Læg appelsinfileterne i bunden af 6 små glas på ca. 2 dl. Fyld chiacremen over, hæld saltkaramel ovenpå, og drys med appelsinskal."
    }
  ],
  "changes": []
