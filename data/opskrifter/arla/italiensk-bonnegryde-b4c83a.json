  "steps": [
    {
      "section": null,
      "text": "Hæld olien i en gryde og lad den blive varm. Svits champignon, peberfrugt, løg, hvidløg og tomatpuré ved middel varme i cirka 5 minutter."
    },
    {
      "section": null,
      "text": "Rør hakkede tomater, fløde, bønner, ost, paprika og salt i gryden. Lad det koge op og varme helt igennem, til osten er smeltet."
    },
    {
      "section": null,
      "text": "Vend spinaten i, og lad den falde sammen."
    },
    {
      "section": null,
      "text": "Fordel rucola over gryden. Riv skallen af citronen ud over, og dryp med olivenolie."
    },
    {
      "section": null,
      "text": "Placer burrataen i midten på toppen, og server med brød ved siden af."
    }
  ],
