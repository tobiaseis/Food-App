  "steps": [
    {
      "section": "Jordbærkompot",
      "text": "Tænd ovnens grill. Læg jordbærrene i en bradepande på ca. 18 x 25 cm, og drys dem med sukker og peber."
    },
    {
      "section": "Jordbærkompot",
      "text": "Grill jordbærrene øverst i ovnen i ca. 5 min. Vend dem, og stil dem til afkøling, hvis du har tid. Skru derefter ovnen ned til 200 °C (traditionel ovn)."
    },
    {
      "section": "Rødtunger",
      "text": "Skyl rødtungerne grundigt ude og inde, og fjern blodrester. Dup dem tørre, og klip eller træk eventuelle ben langs kanterne af."
    },
    {
      "section": "Rødtunger",
      "text": "Læg bagepapir i en bradepande, og anbring fiskene på det. Drys med salt, og læg alufolie stramt over panden."
    },
    {
      "section": "Rødtunger",
      "text": "Damp rødtungerne midt i ovnen ved 200 °C i ca. 20 min."
    },
    {
      "section": "Tyk fløde med citronmelisse",
      "text": "Hæld fløde, salt og peber i en pande, og bring det i kog under omrøring."
    },
    {
      "section": "Tyk fløde med citronmelisse",
      "text": "Lad fløden simre ved jævn varme i ca. 10 min., mens du rører, til den er tyk og cremet. Si den eventuelt."
    },
    {
      "section": "Tyk fløde med citronmelisse",
      "text": "Rør citronsaft og citronmelisse i, og varm saucen igennem. Smag til med salt og peber."
    },
    {
      "section": "Salat med jordbærkompot",
      "text": "Læg salatblade og agurkeskiver i lag i et fad. Kom jordbærkompotten ovenpå, og drys med salt."
    },
    {
      "section": "Til servering",
      "text": "Server rødtungerne med saucen, salaten og de kogte kartofler."
    }
  ],
  "changes": []
}
