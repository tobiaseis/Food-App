  "steps": [
    {
      "section": null,
      "text": "Sæt en bageplade ind i ovnen, og forvarm ovnen til 250 °C (almindelig ovn)."
    },
    {
      "section": null,
      "text": "Placer pizzabunden på et stykke bagepapir. Smør creme fraiche ud over bunden, og top med mozzarella, valnødder, rosmarin og salt."
    },
    {
      "section": null,
      "text": "Løft pizzaen med bagepapiret over på den varme plade. Bag den midt i ovnen i ca. 10 minutter, til den er gylden og sprød."
    },
    {
      "section": null,
      "text": "Del imens hver figen i 4-6 både. Læg dem på den varme pizza, lad honningen dryppe over, og server med det samme."
    }
