  "steps": [
    {
      "section": null,
      "text": "Skrub sødkartoflen, og del den i to tykke skiver på ca. 1 cm."
    },
    {
      "section": null,
      "text": "Rist skiverne i ca. 8 minutter i brødrister, på pande eller i airfryer, til de er møre."
    },
    {
      "section": null,
      "text": "Halvér avocadoen, tag sten og skal fra, og skær kødet i skiver."
    },
    {
      "section": null,
      "text": "Smelt smørret på en pande, til det holder op med at bruse. Slå æggene ud på panden, og steg dem som spejlæg."
    },
    {
      "section": null,
      "text": "Smør hytteosten ud på de varme kartoffelskiver. Læg avocadoskiver ovenpå, og sæt et spejlæg på toppen."
    },
    {
      "section": null,
      "text": "Krydr med salt og peber eller chiliflager, og pynt med basilikumblade."
    }
