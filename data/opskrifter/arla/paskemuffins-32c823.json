  "steps": [
    {
      "section": "Frosting",
      "text": "Rør flødeosten forsigtigt med en smule gul pastafarve, til farven er jævn."
    },
    {
      "section": "Frosting",
      "text": "Rør citronsaft, flormelis og eventuelt safran i. Bland blidt, til frostingen er ens i konsistens og farve. Sæt den afdækket i køleskabet."
    },
    {
      "section": "Muffins",
      "text": "Tænd ovnen på 175 °C (almindelig ovn)."
    },
    {
      "section": "Muffins",
      "text": "Pisk det smeltede smør med sukker, kakaopulver, vaniljesukker og madlavningsfløde. Pisk æggene i et ad gangen, og pisk grundigt mellem hvert."
    },
    {
      "section": "Muffins",
      "text": "Vend melet i, og rør, til der ikke er klumper."
    },
    {
      "section": "Muffins",
      "text": "Del dejen mellem 10 muffinsforme på ca. 1 dl, så hver form er omkring ⅔ fyldt. Bag midt i ovnen i ca. 18 minutter. Muffinsene skal være en anelse rå i midten, når de kommer ud."
    },
    {
      "section": "Muffins",
      "text": "Lad muffinsene køle af på en bagerist."
    },
    {
      "section": "Pynt",
      "text": "Kom frostingen i en sprøjtepose med stor stjernetud, og sprøjt en top på hver muffin."
    },
    {
      "section": "Pynt",
      "text": "Læg påskeæg på toppen, og sigt flormelis ud over."
    }
  ],
  "changes": []
