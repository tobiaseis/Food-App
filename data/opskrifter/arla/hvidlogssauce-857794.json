  "steps": [
    {
      "section": null,
      "text": "Put melet i en lille tykbundet gryde, og tilsæt en lille smule af mælken. Rør det til en jævn klump uden knolde."
    },
    {
      "section": null,
      "text": "Bland resten af mælken med bouillonen, og pisk det gradvist ned i melblandingen."
    },
    {
      "section": null,
      "text": "Varm gryden op under konstant omrøring, til saucen koger."
    },
    {
      "section": null,
      "text": "Kom hvidløg og oregano i. Lad saucen simre på svag varme i cirka 5 minutter, og rør hele tiden."
    },
    {
      "section": null,
      "text": "Smag til med salt og peber."
    }
