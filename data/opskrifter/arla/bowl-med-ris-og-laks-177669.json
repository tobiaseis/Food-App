  "steps": [
    {
      "section": "Dressing",
      "text": "Rør creme fraiche sammen med peberrod og salt."
    },
    {
      "section": "Dressing",
      "text": "Sæt dressingen i køleskabet under låg eller film, til maden skal på bordet."
    },
    {
      "section": "Bowl",
      "text": "Kog risene, som der står på posen."
    },
    {
      "section": "Bowl",
      "text": "Læg edamamebønnerne i en skål, og hæld kogende vand over. Lad dem trække 1 minut, og si vandet fra."
    },
    {
      "section": "Bowl",
      "text": "Skær rødbederne i tynde skiver, evt. på et mandolinjern. Blend dem med halvdelen af limesaften."
    },
    {
      "section": "Bowl",
      "text": "Lav lange bånd af gulerødderne med en skræller, og vend dem i resten af limesaften."
    },
    {
      "section": "Bowl",
      "text": "Skyl spirerne under koldt vand."
    },
    {
      "section": "Bowl",
      "text": "Smelt smørret på en pande over høj varme, så det ikke tager farve."
    },
    {
      "section": "Bowl",
      "text": "Brun laksetern­ene i ca. 30 sekunder på hver af deres 6 sider ved middel varme. Krydr med salt til sidst."
    },
    {
      "section": "Bowl",
      "text": "Fordel ris, grøntsager, spirer og laks i 4 skåle. Servér med limebåde og dressingen ved siden af."
    }
  ],
