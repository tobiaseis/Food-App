  "steps": [
    {
      "section": "Ovnbagte grøntsager",
      "text": "Forvarm ovnen til 200 °C varmluft."
    },
    {
      "section": "Ovnbagte grøntsager",
      "text": "Gør grøntsagerne rene, og skær dem i mindre stykker. Anret dem på en bageplade."
    },
    {
      "section": "Ovnbagte grøntsager",
      "text": "Rør det smeltede smør sammen med hvidløg, salt og peber."
    },
    {
      "section": "Ovnbagte grøntsager",
      "text": "Hæld smørblandingen over grøntsagerne, tilsæt rosmarinkvistene, og vend det hele grundigt."
    },
    {
      "section": "Ovnbagte grøntsager",
      "text": "Bag grøntsagerne midt i ovnen i cirka 25 minutter."
    },
    {
      "section": "Ovnbagte grøntsager",
      "text": "Smuld salatosten ud over de bagte grøntsager, og drys eventuelt med basilikumblade."
    },
    {
      "section": "Linsedressing",
      "text": "Mens grøntsagerne bager, kan du blande creme fraiche med sambal oelek, salt og de drænede linser. Smag dressingen til."
    },
    {
      "section": "Linsedressing",
      "text": "Server dressingen ved siden af grøntsagerne."
    }
  ],
