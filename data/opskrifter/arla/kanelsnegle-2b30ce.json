  "steps": [
    {
      "section": "Dej",
      "text": "Smelt smørret, og rør det sammen med mælken. Opløs gæren i blandingen."
    },
    {
      "section": "Dej",
      "text": "Bland æg, hvedemel, kardemomme og salt i. Gem lidt af melet til sidst, så dejen bliver fugtig."
    },
    {
      "section": "Dej",
      "text": "Ælt dejen godt sammen. Dæk den til, og lad den hæve et lunt sted i cirka en halv time."
    },
    {
      "section": "Remonce",
      "text": "Rør smør, farin og kanel sammen til en jævn remonce."
    },
    {
      "section": "Samling",
      "text": "Vend dejen ud på et bord med lidt mel, og rul den til en firkant på cirka 30 x 50 cm. Fordel remoncen over hele dejen."
    },
    {
      "section": "Samling",
      "text": "Rul dejen sammen fra den lange side, så der kommer en pølse. Skær den i cirka 25 skiver."
    },
    {
      "section": "Samling",
      "text": "Anbring sneglene på en bradepande med bagepapir, og stik dejenden ind under hver snegl. Dæk til, og lad dem hæve i 15 minutter."
    },
    {
      "section": "Samling",
      "text": "Pensl sneglene med sammenpisket æg. Bag dem midt i ovnen ved 225 °C (almindelig ovn) i 10-12 minutter."
    },
    {
      "section": "Glasur",
      "text": "Rør flormelis og vand sammen til en glasur, og del evt. en del ud med kakao. Pynt kanelsneglene, når de er lidt afkølede."
    }
  ],
  "changes": []
