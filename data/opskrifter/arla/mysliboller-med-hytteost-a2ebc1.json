  "steps": [
    {
      "section": null,
      "text": "Bland vand, gær og hytteost i en skål."
    },
    {
      "section": null,
      "text": "Tilsæt melet og saltet, men gem lidt af melet. Dejen skal blive ved med at være fugtig."
    },
    {
      "section": null,
      "text": "Æl dejen i ca. 10 min., fx i en røremaskine, til den er blank og elastisk."
    },
    {
      "section": null,
      "text": "Vend mysli og tørret frugt forsigtigt ind i dejen."
    },
    {
      "section": null,
      "text": "Læg låg eller et klæde over skålen, og lad dejen hæve et lunt sted i ca. 1 time."
    },
    {
      "section": null,
      "text": "Tænd ovnen på 250 °C varmluft."
    },
    {
      "section": null,
      "text": "Tip dejen ud på et meldrysset bord, og form den til en firkant på ca. 20 x 30 cm. Strø speltflagerne ud over, pres dem let ned, og del dejen i 16 stykker."
    },
    {
      "section": null,
      "text": "Læg bollerne på to bageplader med bagepapir, og bag dem midt i ovnen i ca. 15 min."
    },
    {
      "section": null,
      "text": "Sæt bollerne på en rist, og lad dem køle af."
    }
  ],
