  "steps": [
    {
      "section": "Mørbrad",
      "text": "Smelt smørret i en stor sauterpande, til det får en gylden farve, og kom hvidløgsskiverne i."
    },
    {
      "section": "Mørbrad",
      "text": "Steg mørbradskiverne i ca. 3 minutter i alt, til de er brunet hele vejen rundt."
    },
    {
      "section": "Mørbrad",
      "text": "Løft kød og hvidløg op af panden og stil det til side under låg eller folie, så det holder varmen."
    },
    {
      "section": "Tomat, æble og løg",
      "text": "Steg rødløgene i panden ved middel varme i ca. 1 minut."
    },
    {
      "section": "Tomat, æble og løg",
      "text": "Kom æbler, cherrytomater, hakket rosmarin og salt i panden, og steg det i ca. 3 minutter mere."
    },
    {
      "section": "Tomat, æble og løg",
      "text": "Læg kød og hvidløg tilbage i panden, vend rundt og smag til."
    },
    {
      "section": "Spaghetti og tomatsauce",
      "text": "Bring vand og salt i kog i en stor gryde, mens grøntsagerne simrer."
    },
    {
      "section": "Spaghetti og tomatsauce",
      "text": "Kog spaghettien i 10-11 minutter, til den er mør, men stadig fast i det. Si den og lad vandet løbe fra."
    },
    {
      "section": "Spaghetti og tomatsauce",
      "text": "Hæld hakkede tomater, fløde og bouillonpulver i den tomme gryde, og varm saucen godt igennem."
    },
    {
      "section": "Spaghetti og tomatsauce",
      "text": "Vend spaghettien i saucen, og anret den i en stor, varm skål."
    },
    {
      "section": "Spaghetti og tomatsauce",
      "text": "Læg kødet og grøntsagerne ovenpå, pynt med rosmarinkviste, og server med det samme."
    }
  ],
