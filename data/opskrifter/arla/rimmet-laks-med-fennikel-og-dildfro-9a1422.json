  "steps": [
    {
      "section": "Rimmet laks",
      "text": "Tag laksen ud af fryseren i god tid, og lad den tø halvt op i køleskabet, så den er nem at skære."
    },
    {
      "section": "Rimmet laks",
      "text": "Skær fileten i skiver på ca. 1 cm, og læg dem i et fad."
    },
    {
      "section": "Rimmet laks",
      "text": "Stød fennikelfrø, dild og peberkorn groft i en morter, eller kør dem kort i en hurtighakker."
    },
    {
      "section": "Rimmet laks",
      "text": "Bland krydderierne med sukker og salt."
    },
    {
      "section": "Rimmet laks",
      "text": "Vend lakseskiverne i blandingen. Dæk fadet, og lad laksen trække i køleskabet i mindst 24 timer."
    },
    {
      "section": "Karsedressing",
      "text": "Rør yoghurt, mælk, farin og salt til en glat dressing."
    },
    {
      "section": "Karsedressing",
      "text": "Rør karsen ud i dressingen, dæk til, og sæt den på køl i mindst 15 minutter. Smag til sidst til."
    },
    {
      "section": "Til servering",
      "text": "Læg salatblandingen på et fad, og læg den rimmede laks ovenpå."
    },
    {
      "section": "Til servering",
      "text": "Server med dressingen, stenbiderrogn og ristet flute ved siden af."
    }
  ],
