  "steps": [
    {
      "section": null,
      "text": "Læg edamamebønnerne i en skål, og overhæld dem med så meget kogende vand, at de er dækket. Lad dem stå i ca. 3 minutter."
    },
    {
      "section": null,
      "text": "Si vandet fra, og afkøl bønnerne i koldt vand. Lad dem dryppe godt af."
    },
    {
      "section": null,
      "text": "Læg bønnerne i en minihakker med hvidløg, olivenolie, citronsaft, salt og peber. Kør, til massen er ensartet."
    },
    {
      "section": null,
      "text": "Kom to tredjedele af fetaen i, og blend, til hummusen er helt glat."
    },
    {
      "section": null,
      "text": "Drys med lidt peber. Anret med baconstykkerne og den resterende feta ved siden af."
    }
  ],
  "changes": [
    "Salatost er erstattet af feta."
