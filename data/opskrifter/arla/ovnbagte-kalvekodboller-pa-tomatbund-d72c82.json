  "steps": [
    {
      "section": "Kødboller",
      "text": "Ælt kalvekødet med saltet, og lad det hvile i ca. 2 minutter."
    },
    {
      "section": "Kødboller",
      "text": "Tilsæt æg, mælk, mel, parmesan, rosmarin og peber. Rør farsen godt igennem i ca. 5 minutter."
    },
    {
      "section": "Kødboller",
      "text": "Dæk farsen til, og sæt den i køleskabet i mindst 15 minutter."
    },
    {
      "section": "Tomatbund",
      "text": "Tænd ovnen på 200 °C (almindelig ovn)."
    },
    {
      "section": "Tomatbund",
      "text": "Vend kartofler og tomater i en skål med olie, hvidløg, salt og peber."
    },
    {
      "section": "Tomatbund",
      "text": "Beklæd bradepanden med bagepapir, og læg aubergineskiverne på bunden. Fordel kartoffelblandingen ovenpå."
    },
    {
      "section": "Tomatbund",
      "text": "Form farsen til 12 kødboller, og læg dem oven på grøntsagerne."
    },
    {
      "section": "Tomatbund",
      "text": "Bag retten midt i ovnen i ca. 40 minutter."
    },
    {
      "section": "Til servering",
      "text": "Strø basilikum over, og server med det ristede brød med det samme."
    }
  ],
