  "steps": [
    {
      "section": "Dej",
      "text": "Bland de to slags mel i en skål, og smuldr det kolde smør i, til det ligner grove krummer."
    },
    {
      "section": "Dej",
      "text": "Tilsæt vandet, og samle dejen let – den skal stadig være smuldrende."
    },
    {
      "section": "Dej",
      "text": "Pres dejen ud i bunden og op ad siderne af en tærteform på 22 cm. Stil formen på køl i 30 minutter."
    },
    {
      "section": "Dej",
      "text": "Forbag bunden ved 200 °C (almindelig ovn) i cirka 15 minutter."
    },
    {
      "section": "Fyld",
      "text": "Pisk hytteost, æg og halvdelen af den revne ost sammen. Gem resten af osten til toppen."
    },
    {
      "section": "Fyld",
      "text": "Pres vandet fra spinaten, og hak den evt. lidt. Rør spinat, salt, muskatnød og peber ned i æggeblandingen."
    },
    {
      "section": "Fyld",
      "text": "Hæld fyldet på den forbagte bund, og drys den resterende ost over."
    },
    {
      "section": "Fyld",
      "text": "Bag tærten midt i ovnen ved 175 °C (varmluft) i cirka 30 minutter."
    }
  ],
  "changes": []
