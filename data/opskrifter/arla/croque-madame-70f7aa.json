  "steps": [
    {
      "section": "Mornaysauce",
      "text": "Smelt smørret i en gryde, og rør melet i, til der ikke er klumper."
    },
    {
      "section": "Mornaysauce",
      "text": "Hæld mælken i lidt ad gangen under omrøring. Lad saucen simre på svag varme i ca. 5 min."
    },
    {
      "section": "Mornaysauce",
      "text": "Rør muskatnød, ost og salt i, og lad saucen koge videre på svag varme i ca. 2 min. Smag den til."
    },
    {
      "section": "Croque Madame",
      "text": "Varm en pande op, og brun halvdelen af smørret, til det er gyldent. Rist 2 skiver brød på middelvarme i ca. 2 min. på hver side, til de er gyldne."
    },
    {
      "section": "Croque Madame",
      "text": "Rist de to sidste skiver på samme måde med det resterende smør."
    },
    {
      "section": "Croque Madame",
      "text": "Læg skinke og ost mellem brødskiverne, så du får 2 toast. Anbring dem på en bageplade med bagepapir."
    },
    {
      "section": "Croque Madame",
      "text": "Smør mornaysaucen ud over toastene. Gratinér dem øverst i ovnen ved 225 °C varmluft i ca. 8 min."
    },
    {
      "section": "Croque Madame",
      "text": "Slå æggene ud på panden, mens toastene gratinerer, og steg dem på middelvarme i ca. 5 min., til hviderne er stivnet."
    },
    {
      "section": "Croque Madame",
      "text": "Læg et spejlæg på hver toast. Drys med flagesalt, peber og persille, og server med cherrytomater."
    }
  ],
