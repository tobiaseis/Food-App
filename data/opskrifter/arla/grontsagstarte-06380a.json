  "steps": [
    {
      "section": "Dej",
      "text": "Bland begge slags mel med saltet i en skål."
    },
    {
      "section": "Dej",
      "text": "Del det kolde smør i små stykker, og smuldr dem ud i melblandingen."
    },
    {
      "section": "Dej",
      "text": "Tilsæt vandet, og rør dejen sammen, så den lige hænger. Læg den i en tærteform på ca. 24 cm."
    },
    {
      "section": "Dej",
      "text": "Pres dejen jævnt ud i bunden og helt op ad kanten."
    },
    {
      "section": "Dej",
      "text": "Forbag bunden på midterste rille i ca. 10 minutter ved 200 °C varmluft."
    },
    {
      "section": "Fyld",
      "text": "Pisk æg, hytteost, citronskal, salt, timian og peber grundigt sammen."
    },
    {
      "section": "Fyld",
      "text": "Læg grøntsagerne i den forbagte bund, og slå æggeblandingen over."
    },
    {
      "section": "Fyld",
      "text": "Bag tærten i 30-35 minutter ved 200 °C varmluft, til den er gylden og stivnet."
    },
    {
      "section": "Topping",
      "text": "Vend sukkerærter, forårsløg, krydderurter og citronskal sammen."
    },
    {
      "section": "Topping",
      "text": "Drys toppingen over den varme tærte, og server."
    }
  ],
