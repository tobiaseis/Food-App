  "steps": [
    {
      "section": "Skinkeschnitzler",
      "text": "Kog de brune ris efter anvisningen på pakken, mens resten laves."
    },
    {
      "section": "Skinkeschnitzler",
      "text": "Tør schnitzlerne med køkkenrulle, og krydr dem med salt og peber på begge sider."
    },
    {
      "section": "Skinkeschnitzler",
      "text": "Smelt smørret på en pande, til det får gylden farve."
    },
    {
      "section": "Skinkeschnitzler",
      "text": "Brun schnitzlerne to ad gangen i ca. ½ minut på hver side. Steg dem derefter alle fire ved middelvarme i ca. 1 minut på hver side."
    },
    {
      "section": "Skinkeschnitzler",
      "text": "Læg kødet på et fad, og dæk det til, så det holder varmen."
    },
    {
      "section": "Vindruesauce",
      "text": "Rist karryen i den tomme pande ved kraftig varme i ca. 15 sekunder."
    },
    {
      "section": "Vindruesauce",
      "text": "Kom porre, rødløg og salt i panden, og svits under konstant omrøring ved kraftig varme i ca. 3 minutter."
    },
    {
      "section": "Vindruesauce",
      "text": "Hæld fløden i, tilsæt druerne, og lad saucen koge op."
    },
    {
      "section": "Vindruesauce",
      "text": "Rør det meste af persillen i, og smag saucen til. Gem lidt persille som pynt."
    },
    {
      "section": "Vindruesauce",
      "text": "Anret schnitzlerne med saucen over, drys med resten af persillen, og server med de varme ris."
    }
  ],
