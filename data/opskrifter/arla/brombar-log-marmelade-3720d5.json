  "steps": [
    {
      "section": null,
      "text": "Put brombær, rødløg, balsamico, sukker, rosmarin og salt i en gryde."
    },
    {
      "section": null,
      "text": "Sæt låg på og lad det småkoge ved middel varme i ca. 10 min. Rør forsigtigt rundt en gang imellem."
    },
    {
      "section": null,
      "text": "Fjern låget, skru op for varmen, og lad marmeladen koge ind i ca. 10 min., mens du rører hele tiden."
    },
    {
      "section": null,
      "text": "Lad marmeladen køle af, og smag den til."
    },
    {
      "section": null,
      "text": "Server den med brød og ost – den er især god til lagret ost."
    },
    {
      "section": null,
      "text": "Vil du gemme marmeladen, så fyld den kogende varm i rene, skoldede glas og sæt dem i køleskabet."
    }
