  "steps": [
    {
      "section": "Jordbærsirup",
      "text": "Kom jordbær, glukosesirup, flormelis og citronsaft i en tykbundet gryde, og bring det i kog."
    },
    {
      "section": "Jordbærsirup",
      "text": "Lad det simre uden låg ved middel varme i cirka 10 minutter, mens du rører jævnligt."
    },
    {
      "section": "Jordbærsirup",
      "text": "Blend massen glat, f.eks. med stavblender, og si den. Smag til."
    },
    {
      "section": "Jordbærsirup",
      "text": "Afkøl sirupppen tildækket i køleskabet."
    },
    {
      "section": "Til servering",
      "text": "Fordel vaniljesaucen på fire dybe tallerkener, og gem lidt til at servere ved siden af."
    },
    {
      "section": "Til servering",
      "text": "Træk mønstre i saucen med en tynd stråle kold jordbærsirup."
    },
    {
      "section": "Til servering",
      "text": "Læg de kvartede jordbær ovenpå, og strø pistacienødder og chokolade over."
    },
    {
      "section": "Til servering",
      "text": "Pynt med citronmelisse. Server resten af vaniljesaucen i en lille kande."
    }
  ],
