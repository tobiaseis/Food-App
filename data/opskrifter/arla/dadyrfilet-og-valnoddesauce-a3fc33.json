  "steps": [
    {
      "section": "Dådyrfilet",
      "text": "Varm smørret op på en pande, til det får en gylden farve. Brun fileten på panden ved middelvarme i cirka 25 minutter."
    },
    {
      "section": "Dådyrfilet",
      "text": "Stik et stegetermometer ind i midten af kødet. Det er færdigt ved en kernetemperatur på cirka 55 °C."
    },
    {
      "section": "Dådyrfilet",
      "text": "Krydr kødet med salt og peber, og stil det lunt, mens saucen laves."
    },
    {
      "section": "Valnøddesauce",
      "text": "Kom vand og valnødder i en gryde, og bring det i kog. Lad det koge hårdt i cirka 2 minutter, og si så nødderne fra vandet."
    },
    {
      "section": "Valnøddesauce",
      "text": "Lad smørret få en gylden farve på en pande. Svits skalotteløg og østershatte i cirka 3 minutter, og rør indimellem."
    },
    {
      "section": "Valnøddesauce",
      "text": "Tilsæt nødderne, bouillonen, salt, peber, fløde og ost til svampene. Træk panden væk fra varmen, og pisk saucejævneren i."
    },
    {
      "section": "Valnøddesauce",
      "text": "Bring saucen i kog igen, og lad den simre ved svag varme i cirka 1 minut under jævnlig omrøring. Rør evt. kulør i, og smag saucen til."
    },
    {
      "section": null,
      "text": "Skær fileten i skiver, og server den med saucen og kartoflerne."
    }
  ],
  "changes": []
