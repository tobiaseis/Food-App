  "steps": [
    {
      "section": "Kogt kylling",
      "text": "Læg kyllingen i en stor gryde, og hæld vand over, så den er dækket."
    },
    {
      "section": "Kogt kylling",
      "text": "Bring vandet i kog, og øs skummet og urenhederne af overfladen."
    },
    {
      "section": "Kogt kylling",
      "text": "Put porre, gulerod, løg, dildstilke, timian, laurbærblad og groft salt i gryden. Lad det simre i 1-1½ time, til kødet slipper benene."
    },
    {
      "section": "Kogt kylling",
      "text": "Løft kyllingen op af gryden. Pluk kødet af benene, og kassér skind og knogler."
    },
    {
      "section": "Kogt kylling",
      "text": "Sigt suppen, og hæld 1 liter tilbage i gryden."
    },
    {
      "section": "Frikassé",
      "text": "Kom blomkålen i suppen, og kog den i ca. 3 minutter. Fisk den op med en hulske, og stil den til side."
    },
    {
      "section": "Frikassé",
      "text": "Ælt smør og hvedemel sammen med fingrene til en jævn smørbolle."
    },
    {
      "section": "Frikassé",
      "text": "Pisk smørbollen ud i den varme suppe lidt ad gangen, og lad saucen koge i ca. 5 minutter."
    },
    {
      "section": "Frikassé",
      "text": "Kom kyllingekødet i saucen. Vend blomkål, ærter, hakket dild og fløde i lige før servering, og smag til med salt og peber."
    },
    {
      "section": "Frikassé",
      "text": "Anret i dybe tallerkener sammen med kartoflerne, og drys med ekstra dild."
    }
  ],
  "changes": []
