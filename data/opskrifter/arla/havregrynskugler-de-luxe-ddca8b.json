  "steps": [
    {
      "section": "Ristede hasselnødder",
      "text": "Varm ovnen op til 150 °C (almindelig ovn)."
    },
    {
      "section": "Ristede hasselnødder",
      "text": "Hak nødderne groft, og læg dem i en lille bradepande. Rist dem midt i ovnen i cirka 10 minutter."
    },
    {
      "section": "Ristede hasselnødder",
      "text": "Lad nødderne køle af, og hak dem derefter lidt finere."
    },
    {
      "section": "Havregrynskugler",
      "text": "Kom alle ingredienserne til kuglerne i en skål."
    },
    {
      "section": "Havregrynskugler",
      "text": "Æltes det hele grundigt sammen med en ske eller med hænderne, til dejen er ensartet. Del den i passende stykker."
    },
    {
      "section": "Havregrynskugler",
      "text": "Rul stykkerne til kugler, og vend dem i de hakkede nødder."
    },
    {
      "section": "Havregrynskugler",
      "text": "Opbevar kuglerne koldt, til de skal serveres."
    }
  ],
