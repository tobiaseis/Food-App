  "steps": [
    {
      "section": "Kagebunde",
      "text": "Tænd ovnen på 175 °C (almindelig ovn). Læg et stykke bagepapir over bunden af en springform på ca. 18 cm i diameter, og luk ringen, så papiret sidder fast."
    },
    {
      "section": "Kagebunde",
      "text": "Rør mel, sukker, kakaopulver, vaniljesukker, bagepulver og salt sammen i en stor skål."
    },
    {
      "section": "Kagebunde",
      "text": "Hæld kakaomælken i lidt ad gangen, og pisk undervejs. Pisk til sidst det smeltede smør i dejen."
    },
    {
      "section": "Kagebunde",
      "text": "Hæld dejen i formen, og stryg den ud. Bag kagen midt i ovnen i ca. 1 time og 15 minutter. Stik en træpind i midten – den skal komme ren op."
    },
    {
      "section": "Kagebunde",
      "text": "Lad kagen køle helt af i formen på en rist. Løsn den derefter, og træk bagepapiret af."
    },
    {
      "section": "Kagebunde",
      "text": "Skær om nødvendigt den buede top af. Del kagen i tre lige tykke bunde med en brødkniv."
    },
    {
      "section": "Chokoladefrosting",
      "text": "Pisk det bløde smør og flormelis, til blandingen er lys og luftig."
    },
    {
      "section": "Chokoladefrosting",
      "text": "Hæld den smeltede chokolade i som en tynd stråle, mens du pisker. Pisk fløden i til sidst, indtil frostingen er blød og glat."
    },
    {
      "section": "Samling",
      "text": "Smør ca. to tredjedele af frostingen over to af bundene. Stabl dem på et kagefad, og læg den sidste bund øverst. Tryk let ned."
    },
    {
      "section": "Samling",
      "text": "Smør et tyndt lag frosting rundt om siderne, og skrab det af igen, mens du drejer kagefadet. Fordel resten af frostingen oven på."
    },
    {
      "section": "Samling",
      "text": "Pynt kagen med jordbær, kiks og marengs."
    }
  ],
  "changes": []
}
