  "steps": [
    {
      "section": null,
      "text": "Halvér de hårdkogte æg på langs, og pil blommerne forsigtigt ud med en lille ske. Gem hviderne."
    },
    {
      "section": null,
      "text": "Kom blommerne i en minihakker eller et blenderglas med hytteost, mangochutney, karry, salt og peber. Kør det i cirka 3 minutter, til cremen er helt glat, og smag den til."
    },
    {
      "section": null,
      "text": "Rist rugbrød og franskbrød, og lad skiverne køle helt af."
    },
    {
      "section": null,
      "text": "Halvér 2 af cherrytomaterne, og skær resten i skiver."
    },
    {
      "section": null,
      "text": "Smør cremen på brødskiverne. Læg salatblade, tomatskiver og bacon mellem dem, så der bliver to sandwichs."
    },
    {
      "section": null,
      "text": "Skær hver sandwich over i midten, og pak dem ind i madpakkepapir."
    },
    {
      "section": null,
      "text": "Læg de halve tomater i hullerne i æggehviderne, hvor blommerne sad."
    },
    {
      "section": null,
      "text": "Fordel sandwichs, æggehalvdele og gulerødder i to madkasser."
    }
  ],
