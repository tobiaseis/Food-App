  "steps": [
    {
      "section": "Marinade",
      "text": "Hak to af hvidløgsfeddene fint. Skær de øvrige i tykke skiver og læg dem til side."
    },
    {
      "section": "Marinade",
      "text": "Bland yoghurt, soltørrede tomater, det hakkede hvidløg og saltet i en frysepose."
    },
    {
      "section": "Kylling og grøntsager",
      "text": "Træk skindet af kyllingelårene, og læg dem i posen med marinaden. Vend dem godt, så de er dækket."
    },
    {
      "section": "Kylling og grøntsager",
      "text": "Sæt ovnen på 250 °C (almindelig ovn). Læg kyllingelårene i en bradepande, eventuelt beklædt med bagepapir, og hæld resten af marinaden over."
    },
    {
      "section": "Kylling og grøntsager",
      "text": "Fordel kartoflerne i bradepanden, og bag det hele midt i ovnen i ca. 20 minutter."
    },
    {
      "section": "Kylling og grøntsager",
      "text": "Tag bradepanden ud, og fordel rødløg, squash, peberfrugt, cherrytomater, hvidløgsskiverne og timiankvistene mellem kyllingen."
    },
    {
      "section": "Kylling og grøntsager",
      "text": "Dryp med olien, og krydr med salt og peber."
    },
    {
      "section": "Kylling og grøntsager",
      "text": "Bag retten færdig midt i ovnen ved 250 °C i ca. 45 minutter. Server i bradepanden med lidt frisk timian."
    }
  ],
  "changes": []
