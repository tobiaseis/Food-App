  "steps": [
    {
      "section": "Bagte rødder",
      "text": "Tænd ovnen på 250 °C (almindelig ovn)."
    },
    {
      "section": "Bagte rødder",
      "text": "Vend skiverne i olie, salt og peber, og læg dem på en bageplade. Bag dem i cirka 20 minutter."
    },
    {
      "section": "Quinoasalat",
      "text": "Lad rødderne køle lidt af, og vend dem sammen med quinoa, rødløg, grønkål, feta og abrikoser i en stor skål."
    },
    {
      "section": "Quinoasalat",
      "text": "Rør limeskal, limesaft og olie ud over salaten. Smag til med salt og peber."
    },
    {
      "section": "Quinoasalat",
      "text": "Server salaten alene eller med ristet brød ved siden af."
    }
