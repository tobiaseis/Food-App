  "steps": [
    {
      "section": "Citronkage",
      "text": "Tænd ovnen på 175 °C (traditionel ovn), og smør en rugbrødsform på ca. 1½ liter."
    },
    {
      "section": "Citronkage",
      "text": "Pisk smør og sukker, til blandingen er lys og luftig."
    },
    {
      "section": "Citronkage",
      "text": "Pisk æggene i et ad gangen, og pisk grundigt efter hvert."
    },
    {
      "section": "Citronkage",
      "text": "Rør citronskal og citronsaft i. Bland hvedemel med bagepulver, og vend det forsigtigt ned i dejen."
    },
    {
      "section": "Citronkage",
      "text": "Hæld dejen i formen, og bag kagen midt i ovnen i ca. 45 minutter."
    },
    {
      "section": "Citronkage",
      "text": "Lad kagen hvile i formen i ca. 10 minutter. Vend den ud, og lad den afkøle helt."
    },
    {
      "section": "Glasur",
      "text": "Rør flormelis og citronsaft sammen, og smør glasuren ud over den kolde kage."
    }
  ],
  "changes": []
