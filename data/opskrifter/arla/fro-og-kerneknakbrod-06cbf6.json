  "steps": [
    {
      "section": null,
      "text": "Varm ovnen op til 150 °C (almindelig ovn)."
    },
    {
      "section": null,
      "text": "Hak mandler og hasselnødder groft-fint i en foodprocessor på højeste hastighed i cirka 15 sekunder. Stop, før det bliver til mel."
    },
    {
      "section": null,
      "text": "Rør de hakkede nødder sammen med græskarkerner, sesamfrø, olie, æg, kanel, nellike og salt, til det hænger godt sammen."
    },
    {
      "section": null,
      "text": "Læg dejen mellem to stykker bagepapir, og rul den ud til en jævn plade på cirka 30 x 30 cm. Ret kanterne til, og tag det øverste papir af."
    },
    {
      "section": null,
      "text": "Del pladen med et pizzahjul i 25 små firkanter på cirka 6 x 6 cm."
    },
    {
      "section": null,
      "text": "Løft bagepapiret med dejen over på en bageplade, og bag knækbrødene på midterste rille i cirka en halv time."
    },
    {
      "section": null,
      "text": "Tag knækbrødene ud, flyt dem uden papir over på en bagerist, og lad dem køle helt af."
    },
    {
      "section": null,
      "text": "Server knækbrødene med ost og lønnesirup."
    }
  ],
