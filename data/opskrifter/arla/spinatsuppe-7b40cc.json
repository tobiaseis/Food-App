  "steps": [
    {
      "section": "Ostebrød",
      "text": "Tænd ovnen på 200 °C (almindelig ovn), og beklæd en bageplade med bagepapir."
    },
    {
      "section": "Ostebrød",
      "text": "Læg brødskiverne på pladen, og drys dem med osten og solsikkekernerne."
    },
    {
      "section": "Ostebrød",
      "text": "Bag brødene midt i ovnen i ca. 10 minutter, til osten har smeltet og fået farve."
    },
    {
      "section": "Spinatsuppe",
      "text": "Varm en tykbundet gryde op på høj varme, og smelt smørret, så det ikke tager farve."
    },
    {
      "section": "Spinatsuppe",
      "text": "Rør løg og hvidløg rundt i gryden i ca. 1 minut."
    },
    {
      "section": "Spinatsuppe",
      "text": "Kom spinat, fløde, vand, fond, muskatnød, salt og peber i. Lad suppen koge i ca. 3 minutter, og smag den til."
    },
    {
      "section": "Til servering",
      "text": "Hæld suppen op i skåle, og stil de varme ostebrød og et smilende æg ved siden af."
    }
  ],
