  "steps": [
    {
      "section": "Pizzadej – dagen før",
      "text": "Rør gæren ud i vandet i en skål."
    },
    {
      "section": "Pizzadej – dagen før",
      "text": "Kom olie, salt og begge slags mel i skålen. Gem lidt af hvedemelet til senere."
    },
    {
      "section": "Pizzadej – dagen før",
      "text": "Arbejd dejen sammen med en grydeske. Dæk skålen til og stil den i køleskabet, så dejen kan hæve i mindst 8 timer, gerne et helt døgn."
    },
    {
      "section": "Grill",
      "text": "Fyld grillstarteren med briketter og tænd dem."
    },
    {
      "section": "Grill",
      "text": "Når briketterne er varme, spredes de i en ring langs grillens kant."
    },
    {
      "section": "Grill",
      "text": "Sæt pizzastenen på risten og læg låg på. Lad stenen blive gennemvarm i ca. en halv time. På en gasgrill bruger du højeste indstilling og direkte varme."
    },
    {
      "section": "Hvidløgsmarinerede rejer",
      "text": "Mens grillen varmer op, vendes rejerne med resten af ingredienserne til rejerne. Stil dem tildækket i køleskabet i ca. 15 min."
    },
    {
      "section": "Pizzaer",
      "text": "Læg dejen på et meldrysset bord og ælt den grundigt. Ælt evt. lidt af det sparede mel i."
    },
    {
      "section": "Pizzaer",
      "text": "Del dejen i to og rul hver del til en rund bund på ca. 35 cm. Læg bundene på tilklippet bagepapir, der kun lige dækker under dem."
    },
    {
      "section": "Pizzaer",
      "text": "Smør pizzasaucen over bundene og drys med ost, gerne i små flade bunker."
    },
    {
      "section": "Pizzaer",
      "text": "Bag én pizza ad gangen på den varme sten i ca. 6 min., til bunden er sprød og gylden."
    },
    {
      "section": "Pizzaer",
      "text": "Smag rejerne til, og fordel dem over de bagte pizzaer. Pynt med basilikum og server med det samme."
    }
  ],
  "changes": [
