  "steps": [
    {
      "section": "Gulerodssalat",
      "text": "Pil gulerødderne, og del dem i helt tynde skiver med en mandolin eller en kartoffelskræller."
    },
    {
      "section": "Gulerodssalat",
      "text": "Si olien fra salatosten, og gem den til dressingen."
    },
    {
      "section": "Gulerodssalat",
      "text": "Hak hasselnødderne groft."
    },
    {
      "section": "Dressing",
      "text": "Pisk den afsiede olie med eddike, salt og peber, og smag dressingen til."
    },
    {
      "section": "Dressing",
      "text": "Vend gulerodsskiverne i dressingen, og anret dem på et fad. Fordel salatost og hasselnødder ovenpå."
    },
    {
      "section": "Dressing",
      "text": "Strø basilikumblade over, og server salaten."
