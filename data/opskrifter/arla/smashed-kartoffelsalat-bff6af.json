  "steps": [
    {
      "section": "Kartofler",
      "text": "Læg de kogte kartofler på en bageplade med bagepapir. Tryk hver kartoffel let med bunden af et glas, så den revner, men holder sammen."
    },
    {
      "section": "Kartofler",
      "text": "Pensl med smør og drys med flagesalt og peber."
    },
    {
      "section": "Kartofler",
      "text": "Bag kartoflerne i ca. 20 minutter ved 225 °C varmluft, til de er helt sprøde. Lad dem køle lidt af, og hak dem derefter groft."
    },
    {
      "section": "Dressing og salat",
      "text": "Rør yoghurt, cornichoner, eddike, hvidløg, groft salt og peber sammen til en dressing."
    },
    {
      "section": "Dressing og salat",
      "text": "Vend agurk, rødløg, asparges, persille og de hakkede kartofler i dressingen. Smag til med salt og peber, og server."
    }
  ],
  "changes": [
    "Syltede agurker er skiftet til cornichoner.",
    "Syltelage er skrevet som alternativ i noten til eddike."
