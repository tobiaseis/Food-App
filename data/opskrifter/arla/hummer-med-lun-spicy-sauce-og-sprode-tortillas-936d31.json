  "steps": [
    {
      "section": "Tortillastrimler",
      "text": "Tænd ovnen på 225 °C (almindelig ovn)."
    },
    {
      "section": "Tortillastrimler",
      "text": "Pensl tortillaerne med lidt vand, og drys dem med appelsinskal og salt."
    },
    {
      "section": "Tortillastrimler",
      "text": "Skær dem i lange strimler på ca. 2 cm i bredden, og læg dem på en bageplade med bagepapir."
    },
    {
      "section": "Tortillastrimler",
      "text": "Bag strimlerne midt i ovnen, til de er sprøde, i ca. 7 minutter."
    },
    {
      "section": "Sauce",
      "text": "Kom æggeblommer, fløde, chili, appelsinjuice, eddike og salt i en tykbundet gryde, og pisk det sammen."
    },
    {
      "section": "Sauce",
      "text": "Varm gryden op ved middel til kraftig varme under konstant piskning, til blandingen næsten koger."
    },
    {
      "section": "Sauce",
      "text": "Pisk det kolde smør i, lidt ad gangen. Fortsæt med at piske kraftigt."
    },
    {
      "section": "Sauce",
      "text": "Træk gryden af varmen, så snart de første bobler dukker op, og pisk videre i ca. ½ minut."
    },
    {
      "section": "Sauce",
      "text": "Smag saucen til. Den kan stå lun i et vandbad, til den skal bruges."
    },
    {
      "section": "Hummer",
      "text": "Bring vand og salt i kog i en stor gryde. Læg hummerne i det kogende vand."
    },
    {
      "section": "Hummer",
      "text": "Vent, til vandet koger igen, og lad dem trække i ca. 3 minutter, til de er varme hele vejen igennem."
    },
    {
      "section": "Hummer",
      "text": "Løft hummerne op, og del dem på langs med en kraftig kniv."
    },
    {
      "section": "Servering",
      "text": "Læg salat på seks tallerkener, og anret en lun hummerhalvdel ovenpå hver."
    },
    {
      "section": "Servering",
      "text": "Hæld saucen i små skåle, og sæt en ved hver tallerken. Server med de sprøde tortillastrimler."
    }
  ],
