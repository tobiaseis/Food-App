  "steps": [
    {
      "section": null,
      "text": "Varm en tør pande op ved middelvarme, og rist hasselnødderne i cirka 2 minutter."
    },
    {
      "section": null,
      "text": "Kom en tredjedel af smørret og flagesaltet på panden. Rist nødderne 1-2 minutter mere, til de er gyldne. Sæt panden til side."
    },
    {
      "section": null,
      "text": "Smelt det resterende smør i en tykbundet gryde ved høj varme. Pas på, at smørret ikke bruner."
    },
    {
      "section": null,
      "text": "Svits pastinakker og chili i cirka 2 minutter."
    },
    {
      "section": null,
      "text": "Rør safrantrådene ud i vandet. Hæld det i gryden sammen med fløden og det grove salt."
    },
    {
      "section": null,
      "text": "Lad retten simre ved lav varme i 12-15 minutter, til pastinakkerne er næsten møre."
    },
    {
      "section": null,
      "text": "Rør citronsaften i, og smag til."
    },
    {
      "section": null,
      "text": "Server med hasselnødder og persille drysset over."
    }
  ],
