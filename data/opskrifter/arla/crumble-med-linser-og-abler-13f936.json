  "steps": [
    {
      "section": "Til crumblen",
      "text": "Bland mel, linser, havregryn og sukker i en skål."
    },
    {
      "section": "Til crumblen",
      "text": "Tilsæt det kolde smør, og gnid det ud med fingrene, til massen er grov og smuldret."
    },
    {
      "section": "Til æblerne",
      "text": "Skær æblerne i både, og vend dem med sukker og kanel."
    },
    {
      "section": "Til æblerne",
      "text": "Læg æblerne i et ovnfast fad eller en tærteform."
    },
    {
      "section": "Bagning",
      "text": "Fordel crumblemassen over æblerne, og sæt fadet i ovnen ved 200 °C i 20-25 minutter."
    },
    {
      "section": "Til servering",
      "text": "Anret den lune crumble med creme fraiche ved siden af."
    }
