  "steps": [
    {
      "section": "Pastasalat",
      "text": "Træk squashen i lange, tynde bånd med en kartoffelskræller. Er kernehuset for blødt til at skrælle, så skær resten i små tern."
    },
    {
      "section": "Pastasalat",
      "text": "Bring vandet i kog i en stor gryde, og tilsæt det grove salt til kogevandet."
    },
    {
      "section": "Pastasalat",
      "text": "Kog pastaen uden låg i ca. 3 minutter. Kom asparges, gulerødder og ærter i gryden under det sidste minut."
    },
    {
      "section": "Pastasalat",
      "text": "Si det hele fra og lad det dryppe af. Vend pasta og grøntsager i en skål med squashbånd, dild, salt og peber, og smag til."
    },
    {
      "section": "Grillet lyssej",
      "text": "Tænd ovnens grill. Pil eventuelle hinder og ben af fisken, og læg fileten på en bageplade med alufolie."
    },
    {
      "section": "Grillet lyssej",
      "text": "Pensl fisken med det smeltede smør, og krydr med salt og peber."
    },
    {
      "section": "Grillet lyssej",
      "text": "Grill fisken på øverste rille i ca. 8 minutter."
    },
    {
      "section": "Skyrdip",
      "text": "Rør skyr, sennep og salt sammen, og smag dippen til."
    },
    {
      "section": "Skyrdip",
      "text": "Anret den lune pastasalat med den grillede fisk og skyrdippen ved siden af."
    }
  ],
