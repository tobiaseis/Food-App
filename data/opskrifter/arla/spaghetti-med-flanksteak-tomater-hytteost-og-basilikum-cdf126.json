  "steps": [
    {
      "section": "Flanksteak",
      "text": "Smelt smørret på en pande, til det får en gylden farve."
    },
    {
      "section": "Flanksteak",
      "text": "Brun steaken i ca. 1 minut på hver side, og krydr med salt og peber."
    },
    {
      "section": "Flanksteak",
      "text": "Sænk til middelvarme, og steg kødet i 12-15 minutter, alt efter hvor tykt det er. Vend det en gang imellem."
    },
    {
      "section": "Flanksteak",
      "text": "Læg steaken til side under låg eller folie, så den holder sig varm."
    },
    {
      "section": "Spaghetti og tomater",
      "text": "Kom vand og salt i en stor gryde, og bring det i kog. Kog spaghettien i 10-11 minutter, til den er mør, men stadig har bid."
    },
    {
      "section": "Spaghetti og tomater",
      "text": "Hæld spaghettien i en sigte, og lad vandet løbe fra. Stil den store gryde tilbage på varmen."
    },
    {
      "section": "Spaghetti og tomater",
      "text": "Kom tomater, kapers, sambal oelek og sukker (hvis du bruger det) i gryden, og lad det koge ca. 2 minutter."
    },
    {
      "section": "Spaghetti og tomater",
      "text": "Skær steaken i tynde skiver på tværs af kødets retning."
    },
    {
      "section": "Spaghetti og tomater",
      "text": "Vend spaghettien med de hakkede basilikumblade i en stor, varm skål."
    },
    {
      "section": "Spaghetti og tomater",
      "text": "Top med tomatblandingen, steakskiverne og hytteosten. Pynt med resten af basilikum, og server med det samme."
    }
  ],
