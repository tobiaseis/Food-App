  "steps": [
    {
      "section": "Tomatrisotto",
      "text": "Varm en tykbundet gryde op på høj varme, og rist peberblandingen i cirka 1 minut."
    },
    {
      "section": "Tomatrisotto",
      "text": "Kom smør, ris og løg i gryden, og svits det i cirka 1 minut."
    },
    {
      "section": "Tomatrisotto",
      "text": "Hæld bouillonen i, læg et tætsluttende låg på, og lad risene simre på svag varme i cirka 10 minutter."
    },
    {
      "section": "Tomatrisotto",
      "text": "Rør tomater og salt ned i risottoen, og lad den koge videre i cirka 5 minutter."
    },
    {
      "section": "Svampetopping",
      "text": "Imens: Smelt smørret i en pande, og lad det blive gyldent."
    },
    {
      "section": "Svampetopping",
      "text": "Steg champignonerne på høj varme i cirka 3 minutter, og rør i dem engang imellem."
    },
    {
      "section": "Svampetopping",
      "text": "Kom kantareller, timian og salt på panden, og steg i cirka 3 minutter mere."
    },
    {
      "section": "Til servering",
      "text": "Rør det meste af osten i risottoen, og smag til."
    },
    {
      "section": "Til servering",
      "text": "Anret risottoen i en varm skål med svampene ovenpå og rucola drysset over. Server med resten af osten ved siden af, så hver kan tage efter smag."
    }
  ],
  "changes": [
    "Bøgehatte er skiftet til kantareller."
  ]
}
