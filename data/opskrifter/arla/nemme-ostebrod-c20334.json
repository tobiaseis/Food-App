  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 225 °C (almindelig ovn)."
    },
    {
      "section": null,
      "text": "Snit hver bolle dybt ind på langs og på tværs, men skær ikke helt igennem. Så får bollen et tern-mønster."
    },
    {
      "section": null,
      "text": "Riv osten og bland den med smør, hvidløg og rosmarin til et ensartet ostesmør."
    },
    {
      "section": null,
      "text": "Smør ostesmørret ind i snittene på bollerne."
    },
    {
      "section": null,
      "text": "Sæt bollerne midt i ovnen, og bag dem, til osten er smeltet og gylden, i 4-5 minutter."
    }
