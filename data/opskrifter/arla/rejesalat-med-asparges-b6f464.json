  "steps": [
    {
      "section": "Dressing",
      "text": "Rør creme fraiche, citronsaft, dild, sukker, salt og peber sammen i en skål."
    },
    {
      "section": "Dressing",
      "text": "Dæk skålen og lad dressingen trække i køleskabet i mindst en halv time. Smag den til."
    },
    {
      "section": "Salat",
      "text": "Lad aspargesene og rejerne dryppe af i en si."
    },
    {
      "section": "Salat",
      "text": "Læg begge slags salat på tallerkenerne, og top med asparges, rejer og cherrytomater."
    },
    {
      "section": "Salat",
      "text": "Hæld lidt dressing over og pynt med dildkviste. Server resten af dressingen i en skål ved siden af, og tag det ristede brød med."
    }
