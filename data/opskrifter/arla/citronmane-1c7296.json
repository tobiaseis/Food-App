  "steps": [
    {
      "section": "Citronmåne",
      "text": "Pisk smør, sukker, marcipan og citronskal til en jævn, luftig masse."
    },
    {
      "section": "Citronmåne",
      "text": "Pisk æggene i et ad gangen, og pisk grundigt efter hvert."
    },
    {
      "section": "Citronmåne",
      "text": "Bland hvedemel, kartoffelmel og bagepulver. Vend det i dejen i omgange sammen med citronsaften."
    },
    {
      "section": "Citronmåne",
      "text": "Klip bagepapir til bunden af en springform på ca. 22 cm, og spænd det fast mellem bund og ring. Smør formen, og hæld dejen i."
    },
    {
      "section": "Citronmåne",
      "text": "Bag kagen midt i ovnen ved 175 °C (almindelig ovn) i ca. 45 minutter."
    },
    {
      "section": "Citronmåne",
      "text": "Stil formen på en rist, og lad kagen køle lidt. Tag den ud af formen, og lad den køle helt af på risten."
    },
    {
      "section": "Kandiserede citronstrimler",
      "text": "Mens kagen bager, skræl brede stykker skal af citronerne med en tyndskræller. Undgå den hvide hinde. Skær skallen i tynde strimler med en skarp kniv."
    },
    {
      "section": "Kandiserede citronstrimler",
      "text": "Kog vand og sukker op i en lille, tykbundet gryde, og lad det simre i 2-3 minutter, til sirupen er let tyknet."
    },
    {
      "section": "Kandiserede citronstrimler",
      "text": "Kom strimlerne i, og kog dem ved jævn varme i ca. 1 minut."
    },
    {
      "section": "Kandiserede citronstrimler",
      "text": "Løft strimlerne op med en hulske, og lad dem dryppe af på køkkenrulle. Fordel dem med lidt luft imellem på en bageplade med bagepapir."
    },
    {
      "section": "Kandiserede citronstrimler",
      "text": "Tør strimlerne i ovnen ved 100 °C (almindelig ovn) i ca. en halv time."
    },
    {
      "section": "Citronglasur",
      "text": "Rør flormelis og citronsaft sammen til en glasur. Smør den ud over den kolde kage, og pynt med de kandiserede citronstrimler."
    }
  ],
  "changes": []
}
