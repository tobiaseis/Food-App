  "steps": [
    {
      "section": null,
      "text": "Put kikærter, grøntsager, yoghurt, citronsaft, olie, tahin, hvidløg, spidskommen og salt i en foodprocessor."
    },
    {
      "section": null,
      "text": "Blend, til hummussen er helt glat. Stop et par gange og skrab dejen ned fra siderne."
    },
    {
      "section": null,
      "text": "Rør lidt vand i, hvis hummussen skal være tyndere."
    },
    {
      "section": null,
      "text": "Smag til, og kom hummussen i en skål. Dryp med olie, og drys sesamfrø og pinjekerner over."
    }
