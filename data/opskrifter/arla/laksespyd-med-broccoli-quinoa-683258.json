  "steps": [
    {
      "section": "Broccoli-quinoa",
      "text": "Skyl quinoaen i en sigte. Bring vand og salt i kog, og tilsæt quinoaen."
    },
    {
      "section": "Broccoli-quinoa",
      "text": "Lad quinoaen simre under tæt låg på svag varme i ca. 15 min."
    },
    {
      "section": "Broccoli-quinoa",
      "text": "Hak broccolien helt fint, for eksempel i en foodprocessor."
    },
    {
      "section": "Broccoli-quinoa",
      "text": "Bland broccoli og quinoa, og hæld det i en sigte, så overskydende vand løber fra."
    },
    {
      "section": "Løg og citron",
      "text": "Varm ovnen op til 250 °C. Beklæd en bageplade med bagepapir, og anbring rødløgs- og citronbådene på den ene halvdel. Drys med salt."
    },
    {
      "section": "Løg og citron",
      "text": "Sæt pladen øverst i ovnen, og bag løg og citron i ca. 16 min."
    },
    {
      "section": "Laksespyd",
      "text": "Skær laksen i tern, og træk dem på bambusspyddene. Krydr med salt og peber."
    },
    {
      "section": "Laksespyd",
      "text": "Læg spyddene på pladen ved siden af løg og citron, når der er ca. 6 min. tilbage af bagetiden. Bag dem i 6 min. ved 250 °C."
    },
    {
      "section": "Karrysauce",
      "text": "Varm karrysaucen op i en lille tykbundet gryde, til den koger. Rør undervejs."
    },
    {
      "section": "Karrysauce",
      "text": "Rør rødløgsringene i lige før servering, og smag saucen til."
    },
    {
      "section": null,
      "text": "Server laksespyd og bagte løg og citron med broccoli-quinoa og karrysauce."
    }
  ],
