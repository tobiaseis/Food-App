  "steps": [
    {
      "section": "Rige riddere",
      "text": "Fordel æg, mælk, fløde og salt i en skål og pisk det godt sammen."
    },
    {
      "section": "Rige riddere",
      "text": "Varm smørret op på en pande, til det får en gylden farve."
    },
    {
      "section": "Rige riddere",
      "text": "Træk brødskiverne gennem æggeblandingen, og steg dem på panden i ca. 4 minutter på hver side, til de er gyldne."
    },
    {
      "section": "Karamelliserede æbler",
      "text": "Smelt smør og sukker på en pande over kraftig varme, mens du rører rundt, til blandingen er lysebrun."
    },
    {
      "section": "Karamelliserede æbler",
      "text": "Læg æbleb��dene og timianen i karamellen, og vend dem rundt."
    },
    {
      "section": "Karamelliserede æbler",
      "text": "Lad det simre i ca. 2 minutter, til æblerne er lysebrune, og sukkeret er flydende."
    },
    {
      "section": "Ved serveringen",
      "text": "Anret de stegte brødskiver på et fad, og læg de karamelliserede æbler ovenpå. Pynt med timian, og server med iskold flødeskum ved siden af."
    }
  ],
