  "steps": [
    {
      "section": "Laks og blomkål",
      "text": "Skær laksen i fire ens stykker, og læg dem i et ovnfast fad."
    },
    {
      "section": "Laks og blomkål",
      "text": "Læg blomkålsbuketterne rundt om fisken."
    },
    {
      "section": "Laks og blomkål",
      "text": "Sæt fadet midt i ovnen, og bag det i ca. 10 minutter ved 225 °C (almindelig ovn)."
    },
    {
      "section": "Dildsauce",
      "text": "Rør fløde, dild, citronsaft, salt og peber sammen i en skål."
    },
    {
      "section": "Dildsauce",
      "text": "Tag fadet ud efter de første 10 minutter, og hæld saucen jævnt over laks og blomkål. Sæt det tilbage i ovnen, til retten er færdigbagt."
    },
    {
      "section": "Ved serveringen",
      "text": "Strø peberrod over laksen, pynt med dildkviste, og server med de kogte kartofler."
    }
  ],
