  "steps": [
    {
      "section": null,
      "text": "Put bouillon, pasta, hakkede tomater, soltørrede tomater, hvidløg, salt og peber i en bred gryde. Fløde og bønner skal vente."
    },
    {
      "section": null,
      "text": "Bring det i kog, og lad det koge i cirka 10 minutter, til pastaen er næsten mør."
    },
    {
      "section": null,
      "text": "Rør fløde og bønner i, og lad det simre i cirka 2 minutter mere."
    },
    {
      "section": null,
      "text": "Sæt gryden på bordet med citron, parmesan og et rivejern ved siden af. Hver gæst river parmesan og citronskal over sin portion og drysser basilikumblade på."
    }
