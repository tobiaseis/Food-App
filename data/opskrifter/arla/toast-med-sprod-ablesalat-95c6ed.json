  "steps": [
    {
      "section": "Sprød æblesalat",
      "text": "Rør æbleskiverne sammen med ingefærmarmelade, citronsaft og sesamfrø, så de er dækket af marmeladen."
    },
    {
      "section": "Toast",
      "text": "Skær hver skive figenpålæg i tre lange strimler."
    },
    {
      "section": "Toast",
      "text": "Fordel figenpålæg og blåskimmelost på halvdelen af brødskiverne, og læg de resterende skiver ovenpå, så der bliver 4 toast."
    },
    {
      "section": "Toast",
      "text": "Varm toastmaskinen godt op, og pensl den med smør."
    },
    {
      "section": "Toast",
      "text": "Grill toastene to ad gangen i cirka 3 minutter, til de er gyldne."
    },
    {
      "section": "Toast",
      "text": "Server de varme toast med det samme sammen med æblesalaten."
    }
