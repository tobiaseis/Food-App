  "steps": [
    {
      "section": "Asparges",
      "text": "Bryd de nederste par centimeter af hver asparges og kassér dem."
    },
    {
      "section": "Asparges",
      "text": "Rør olie og farin sammen, og pensl aspargesene med blandingen."
    },
    {
      "section": "Asparges",
      "text": "Grill aspargesene meget kort på en varm grillpande eller en god stegepande. De skal kun lige have farve."
    },
    {
      "section": "Cremefraichedip",
      "text": "Vend creme fraiche med lakserogn, limeskal, salt og peber."
    },
    {
      "section": "Cremefraichedip",
      "text": "Server aspargesene lune eller kolde med dippen ved siden af, så man kan dyppe dem med fingrene."
    }
  ],
