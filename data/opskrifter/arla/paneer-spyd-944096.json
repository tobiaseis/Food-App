  "steps": [
    {
      "section": "Paneer",
      "text": "Varm mælken op til kogepunktet i en tykbundet gryde, mens du rører."
    },
    {
      "section": "Paneer",
      "text": "Sænk varmen, og rør citronsaft og salt i. Rør, til mælken skiller."
    },
    {
      "section": "Paneer",
      "text": "Beklæd en sigte med et rent, tyndt og fugtigt viskestykke, og stil den over en skål."
    },
    {
      "section": "Paneer",
      "text": "Hæld den skilte mælk i sigten. Lad den dryppe af og køle i ca. 15 min."
    },
    {
      "section": "Paneer",
      "text": "Saml viskestykket om osten, og vrid mere væde ud."
    },
    {
      "section": "Paneer",
      "text": "Form osten til en lille, flad firkant i klædet, og læg den på en tallerken."
    },
    {
      "section": "Paneer",
      "text": "Sæt en gryde med koldt vand ovenpå som vægt. Lad paneeren trække i køleskabet under pres i ca. 1 time."
    },
    {
      "section": null,
      "text": "Del paneeren i ca. 18 tern."
    },
    {
      "section": null,
      "text": "Rist krydderierne på en tør pande ved middel til kraftig varme i ca. 1 min."
    },
    {
      "section": null,
      "text": "Tag panden af varmen. Knus krydderierne, fx i en morter, og rør olien i."
    },
    {
      "section": null,
      "text": "Vend ostetern i marinaden i en skål, og lad dem stå i ca. 10 min."
    },
    {
      "section": null,
      "text": "Træk ostetern og grøntsager på spyddene, så de skifter."
    },
    {
      "section": null,
      "text": "Varm den resterende marinade godt op på en pande."
    },
    {
      "section": null,
      "text": "Steg spyddene ved middel varme i ca. 2 min. på hver side, i alt ca. 8 min."
    }
  ],
