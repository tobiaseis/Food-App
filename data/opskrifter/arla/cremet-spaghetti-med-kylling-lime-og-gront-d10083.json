  "steps": [
    {
      "section": "Kylling",
      "text": "Gør kyllingefileterne rene og trim dem om nødvendigt."
    },
    {
      "section": "Kylling",
      "text": "Varm bouillonen op i en gryde med 1 tsk af saltet, til den koger. Læg kyllingen i, sæt låg på, og lad den simre ved middel varme i cirka 8 minutter, til den er gennemkogt."
    },
    {
      "section": "Kylling",
      "text": "Løft kyllingen op af gryden, og bring bouillonen i kog igen."
    },
    {
      "section": "Kylling",
      "text": "Pluk kyllingen i strimler med to gafler. Vend den med limesaft, dild, det resterende salt og peber, og hold den varm."
    },
    {
      "section": "Spaghetti",
      "text": "Kog spaghettien i den kogende bouillon uden låg i cirka 6 minutter."
    },
    {
      "section": "Spaghetti",
      "text": "Kom squash og ærter i gryden, og kog videre uden låg i cirka 3 minutter."
    },
    {
      "section": "Spaghetti",
      "text": "Hæld cirka 1 dl af kogevandet fra til senere. Si derefter spaghetti og grøntsager i et dørslag, og lad dem dryppe godt af."
    },
    {
      "section": "Spaghetti",
      "text": "Kom spaghetti og grøntsager tilbage i gryden med kyllingen, pastaosten og spinaten. Hæld kogevandet i, vend det hele godt, og smag til."
    },
    {
      "section": "Servering",
      "text": "Anret spaghettien i en stor, varm skål. Strø limeskal og peber over, og server med det samme sammen med limebåde."
    }
  ],
