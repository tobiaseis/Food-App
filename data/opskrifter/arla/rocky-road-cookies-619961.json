  "steps": [
    {
      "section": "Mix dejen",
      "text": "Pisk smør, farin, sukker og salt sammen, til det er jævnt."
    },
    {
      "section": "Mix dejen",
      "text": "Tilsæt æg og vand, og rør det ind."
    },
    {
      "section": "Mix dejen",
      "text": "Bland hvedemel, vaniljesukker og bagepulver i en skål, og vend det ned i smørblandingen."
    },
    {
      "section": "Mix dejen",
      "text": "Vend chokolade, karamelstykker og peanuts i dejen."
    },
    {
      "section": "Mix dejen",
      "text": "Rul dejen til 24 kugler, og læg dem fordelt på 3 bageplader med bagepapir. Hold god afstand, for kagerne breder sig meget under bagningen."
    },
    {
      "section": "Bagetid",
      "text": "Bag kagerne ved 160 °C varmluft i ca. 15 minutter, til de er gyldne udenpå og stadig bløde i midten."
    },
    {
      "section": "Tilføj skumfiduser",
      "text": "Tag pladerne ud af ovnen, og tryk straks marshmallows ned i de varme kager."
    },
    {
      "section": "Tilføj skumfiduser",
      "text": "Løft kagerne over på en rist med en paletkniv, og lad dem køle af."
    }
  ],
  "title": "Rocky road cookies",
  "intro": "Bløde cookies med mørk chokolade, karamel, peanuts og smeltede marshmallows. Skumfiduserne trykkes i, lige når kagerne kommer ud af ovnen.",
