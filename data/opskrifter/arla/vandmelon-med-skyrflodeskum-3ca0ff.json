  "steps": [
    {
      "section": null,
      "text": "Del vandmelonen i skiver, og skær dem derefter i trekantede stykker som pizzaslices."
    },
    {
      "section": null,
      "text": "Rør skyr, flormelis og vaniljekorn sammen med en håndmixer i cirka 2 minutter."
    },
    {
      "section": null,
      "text": "Slå fløden til flødeskum i en anden skål."
    },
    {
      "section": null,
      "text": "Vend skyrblandingen forsigtigt i flødeskummet, og smag til."
    },
    {
      "section": null,
      "text": "Fyld skyrflødeskummet i en sprøjtepose, og sprøjt det ud over vandmelonstykkerne."
    },
    {
      "section": null,
      "text": "Top med jordbærskiver, mynteblade og chokolade. Server med det samme."
    }
