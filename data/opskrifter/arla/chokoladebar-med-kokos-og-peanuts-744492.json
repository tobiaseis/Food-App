  "steps": [
    {
      "section": null,
      "text": "Bland havregryn, kokosmel, kakaopulver og brun farin i en skål."
    },
    {
      "section": null,
      "text": "Hæld kokosmælken i, og rør, til det hele hænger godt sammen."
    },
    {
      "section": null,
      "text": "Klæd en rugbrødsform på ca. 10 x 30 cm med bagepapir. Tryk massen jævnt ud i bunden."
    },
    {
      "section": null,
      "text": "Strø peanuts ud over massen, og tryk dem let ned i toppen. Dryp den smeltede chokolade ud over i tynde striber."
    },
    {
      "section": null,
      "text": "Sæt formen i fryseren i ca. en halv time."
    },
    {
      "section": null,
      "text": "Løft barren op af formen, og træk bagepapiret af. Del den i ca. 8 stykker."
    },
    {
      "section": null,
      "text": "Læg stykkerne i en tildækket beholder i køleskabet."
    }
  ],
