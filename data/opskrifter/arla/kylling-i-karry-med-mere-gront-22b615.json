  "steps": [
    {
      "section": null,
      "text": "Kog risene efter anvisningen på posen, mens du laver retten."
    },
    {
      "section": null,
      "text": "Varm en gryde ved middel varme, og lad smørret smelte. Rør karryen rundt i smørret, så den dufter."
    },
    {
      "section": null,
      "text": "Kom løg og kylling i gryden, og steg dem i cirka 2 minutter."
    },
    {
      "section": null,
      "text": "Tilføj grøntsagerne, og steg videre i cirka 2 minutter."
    },
    {
      "section": null,
      "text": "Sigt melet over, og rør det godt ind, så det dækker det hele."
    },
    {
      "section": null,
      "text": "Hæld bouillon og mælk i, og krydr med salt og peber. Lad retten simre ved svag varme i cirka 12 minutter."
    },
    {
      "section": null,
      "text": "Rør æbletern i, og smag til. Server med de kogte ris og gerne naanbrød."
    }
