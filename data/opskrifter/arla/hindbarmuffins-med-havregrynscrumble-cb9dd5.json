  "steps": [
    {
      "section": "Muffins",
      "text": "Sæt ovnen på 200 °C (almindelig ovn). Sæt store papirforme i en fast muffinsform med 12 forme."
    },
    {
      "section": "Muffins",
      "text": "Pisk æg og sukker, til blandingen er lys og luftig. Rør det smeltede smør og mælken i."
    },
    {
      "section": "Muffins",
      "text": "Bland hvedemel, bagepulver og vaniljesukker i en skål. Vend det forsigtigt i æggemassen."
    },
    {
      "section": "Muffins",
      "text": "Fordel dejen i formene, så de er fyldt til ca. ⅔. Læg bærrene ovenpå, og pres dem let ned i dejen."
    },
    {
      "section": "Havregrynscrumble",
      "text": "Smuldr smørret sammen med hvedemel, havregryn og sukker, til det danner en grov crumble."
    },
    {
      "section": "Havregrynscrumble",
      "text": "Strø crumblen over muffinsene. Bag dem midt i ovnen i 20-25 minutter."
    }
  ],
