  "steps": [
    {
      "section": "Tykmælk",
      "text": "Opvarm mælk og fløde i en gryde til cirka 25 °C."
    },
    {
      "section": "Tykmælk",
      "text": "Kom den lune blanding i en skål, og lad den køle af til 22-25 °C."
    },
    {
      "section": "Tykmælk",
      "text": "Rør kærnemælken i."
    },
    {
      "section": "Tykmælk",
      "text": "Fordel massen i serveringsskåle. Dæk dem til, og lad dem stå ved stuetemperatur i cirka 18 timer."
    },
    {
      "section": "Tykmælk",
      "text": "Sæt skålene i køleskabet, til tykmælken er helt kold."
    },
    {
      "section": "Til servering",
      "text": "Server tykmælken med revet rugbrød og brun farin strøet ovenpå."
