  "steps": [
    {
      "section": "Millionbøf",
      "text": "Kog vandet op i en stor gryde med saltet, og kog pastaen i cirka 10 minutter, til den er mør, men ikke blød."
    },
    {
      "section": "Millionbøf",
      "text": "Hæld pastaen af i et dørslag, og vend den i en skål med rødvinssaucen, oksekødet, timianen og saltet til kødblandingen."
    },
    {
      "section": "Millionbøf",
      "text": "Fordel blandingen i 4 ovnfaste skåle på 5-6 dl hver."
    },
    {
      "section": "Millionbøf",
      "text": "Vend løgbådene i olien, og læg dem oven på pastaen. Drys med resten af saltet."
    },
    {
      "section": "Millionbøf",
      "text": "Sæt skålene midt i ovnen, og bag dem i cirka 20 minutter ved 250 °C (almindelig ovn)."
    },
    {
      "section": "Savojkålssalat",
      "text": "Vend kålen med saltet, og lad den stå og trække i cirka 5 minutter."
    },
    {
      "section": "Savojkålssalat",
      "text": "Skyl kålen under koldt vand, og pres den godt tør."
    },
    {
      "section": "Savojkålssalat",
      "text": "Bland kålen med pærerne og olien."
    },
    {
      "section": "Savojkålssalat",
      "text": "Læg salaten i den ene side af 4 flade tallerkener, og strø valnødderne over."
    },
    {
      "section": null,
      "text": "Sæt en skål millionbøf på hver tallerken, og server med salaten ved siden af."
    }
  ],
