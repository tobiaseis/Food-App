  "steps": [
    {
      "section": "Suppe",
      "text": "Kom hyben og vand i en gryde, og bring det i kog. Læg låg på, og lad det simre ved svag varme i ca. 30 minutter."
    },
    {
      "section": "Suppe",
      "text": "Hæld indholdet gennem en sigte over en skål, og pres hybenmosen igennem, så skallerne bliver tilbage. Smid skallerne ud."
    },
    {
      "section": "Suppe",
      "text": "Hæld væsken tilbage i gryden, og rør sukker og citronsaft i."
    },
    {
      "section": "Suppe",
      "text": "Pisk vand og majsstivelse sammen i et glas, og rør det i suppen. Lad suppen simre ved svag varme i ca. 2 minutter, mens du rører. Smag til."
    },
    {
      "section": "Honningristede havregryn",
      "text": "Varm en pande op ved kraftig varme, og smelt smør og honning, til det er flydende men ikke brunt."
    },
    {
      "section": "Honningristede havregryn",
      "text": "Kom havregrynene på panden, og rør rundt i ca. 2 minutter ved kraftig varme."
    },
    {
      "section": "Honningristede havregryn",
      "text": "Sænk til jævn varme, og rist videre under konstant omrøring i ca. 3 minutter, til grynene er lysebrune og sprøde."
    },
    {
      "section": "Honningristede havregryn",
      "text": "Bred havregrynene ud på bagepapir på en bagerist, og lad dem køle helt af."
    },
    {
      "section": "Til servering",
      "text": "Server suppen varm, lun eller kold. Top med flødeskum og de ristede havregryn."
    }
  ],
