  "steps": [
    {
      "section": null,
      "text": "Varm om ønsket tortillaerne let, så de bliver bløde. Smør dem derefter jævnt med flødeost."
    },
    {
      "section": null,
      "text": "Læg salat, laks, peberfrugt og agurk på tværs i den ene ende af hver tortilla."
    },
    {
      "section": null,
      "text": "Rul tortillaerne stramt op fra den fyldte side."
    },
    {
      "section": null,
      "text": "Du kan om ønsket pakke rullerne ind i bagepapir eller madpapir. Del dem i to på midten, inden de serveres."
    }
