  "steps": [
    {
      "section": "Risengrød",
      "text": "Kom vand og grødris i en tykbundet gryde, og varm op til kogepunktet. Lad risene simre ved jævn varme i ca. 2 minutter, mens du rører hele tiden."
    },
    {
      "section": "Risengrød",
      "text": "Hæld mælken i, og lad det koge op igen. Skru ned for varmen, og lad grøden simre i ca. 10 minutter under omrøring."
    },
    {
      "section": "Risengrød",
      "text": "Læg låg på gryden, og lad grøden trække i ca. 30 minutter. Rør jævnligt rundt. Er grøden for tynd, så lad den koge 5-10 minutter mere."
    },
    {
      "section": "Risengrød",
      "text": "Rør saltet i, og smag grøden til."
    },
    {
      "section": "Risengrød",
      "text": "Bland sukker og kanel i en lille skål."
    },
    {
      "section": "Risengrød",
      "text": "Øs grøden op i en forvarmet skål, og top med kanelsukker og smør."
    }
  ],
