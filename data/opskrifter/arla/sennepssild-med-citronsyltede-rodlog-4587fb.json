  "steps": [
    {
      "section": "Sennepssild",
      "text": "Kog vandet op i en gryde, og læg sennepsfrøene i. Lad dem simre under låg ved svag varme i ca. 10 minutter."
    },
    {
      "section": "Sennepssild",
      "text": "Hæld frøene i en sigte, og lad dem dryppe godt af."
    },
    {
      "section": "Sennepssild",
      "text": "Rør skyr, dijonsennep, honning og salt sammen i en skål, og vend frøene i."
    },
    {
      "section": "Sennepssild",
      "text": "Læg sildestykkerne ned i dressingen. Dæk skålen til, og lad den stå koldt i mindst en halv time. Smag til."
    },
    {
      "section": "Citronsyltede rødløg",
      "text": "Bland rødløg, citronsaft og salt, og lad det trække i mindst 15 minutter."
    },
    {
      "section": "Citronsyltede rødløg",
      "text": "Smag til, og sæt løgene i en sigte, så væsken løber fra."
    },
    {
      "section": "Servering",
      "text": "Læg sildene op i en skål, og anret løgene i en anden. Top med karse, og server med rugbrød og smør."
    }
  ],
