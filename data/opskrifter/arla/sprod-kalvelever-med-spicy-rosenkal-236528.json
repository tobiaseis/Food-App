  "steps": [
    {
      "section": "Spicy rosenkål",
      "text": "Trim rosenkålene i bunden, og pil de yderste hårde blade af. Skyl dem."
    },
    {
      "section": "Spicy rosenkål",
      "text": "Pluk et lille læs blade fra til pynt, og læg dem i en skål koldt vand i køleskabet."
    },
    {
      "section": "Spicy rosenkål",
      "text": "Del rosenkålene i halve eller kvarte."
    },
    {
      "section": "Spicy rosenkål",
      "text": "Varm vandet op til kogepunktet i en gryde. Kom rosenkålene i, og lad dem simre uden låg ved middel varme i ca. 3 minutter, til de næsten er møre."
    },
    {
      "section": "Spicy rosenkål",
      "text": "Rør mælkesauce, chili, limeskal, limesaft, salt og peber i. Lad det koge op, og smag til."
    },
    {
      "section": "Sprød kalvelever",
      "text": "Tør-rist kommen, salt og peber på en pande ved middel varme i ca. 3 minutter, mens du rører rundt."
    },
    {
      "section": "Sprød kalvelever",
      "text": "Kom krydderierne på en dyb tallerken, og bland sesamfrøene i."
    },
    {
      "section": "Sprød kalvelever",
      "text": "Klip eller skær eventuelle hinder af leveren, og tør skiverne med køkkenrulle. Pano dem i krydderiblandingen."
    },
    {
      "section": "Sprød kalvelever",
      "text": "Varm halvdelen af olien på en pande, til den er rigtig varm. Steg halvdelen af leveren ved høj varme i ca. 3 minutter, og vend den undervejs."
    },
    {
      "section": "Sprød kalvelever",
      "text": "Steg resten af leveren på samme måde med den sidste olie."
    },
    {
      "section": "Nudler og anretning",
      "text": "Bring vandet i kog med saltet, og kog nudlerne i ca. 2 minutter."
    },
    {
      "section": "Nudler og anretning",
      "text": "Si nudlerne fra, og vend dem med rosenkålene i et stort, varmt fad."
    },
    {
      "section": "Nudler og anretning",
      "text": "Anret leveren ovenpå eller ved siden af, og pynt med de friske rosenkålsblade. Server med det samme."
    }
  ],
  "changes": []
