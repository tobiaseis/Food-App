  "steps": [
    {
      "section": "Tomatdressing",
      "text": "Bland creme fraiche med ketchup, tomatpuré, salt og peber. Sæt dressingen tildækket på køl, til den skal bruges."
    },
    {
      "section": "Tilbehør",
      "text": "Del aspargesene i tynde bånd på langs med en tyndskræller. Læg båndene i isvand sammen med salatbladene, og lad dem ligge dér til servering."
    },
    {
      "section": "Stegte rødspætter",
      "text": "Stil tre skåle frem: Rør rasp, salt og peber sammen i den første, pisk æggene i den anden, og hæld hvedemelet i den tredje."
    },
    {
      "section": "Stegte rødspætter",
      "text": "Vend hver filet i melet, derefter i æggene og til sidst i raspblandingen."
    },
    {
      "section": "Stegte rødspætter",
      "text": "Bruns halvdelen af smørret gyldent på en stor pande. Steg fileterne ved middel varme i ca. 2 minutter."
    },
    {
      "section": "Stegte rødspætter",
      "text": "Kom resten af smørret på panden, og vend fileterne. Steg dem ca. 2 minutter ved middel varme og herefter ca. 2 minutter ved lav varme. Brug to pander, eller steg fisken i to omgange."
    },
    {
      "section": "Servering",
      "text": "Hæld aspargesbåndene og salaten af i et dørslag, så vandet løber fra."
    },
    {
      "section": "Servering",
      "text": "Smør de ristede brødskiver med lidt dressing, og læg dem på tallerkener."
    },
    {
      "section": "Servering",
      "text": "Læg salat på hvert brød, og top med to stegte rødspætter. Fordel dressing, lakserogn og rejer ovenpå."
    },
    {
      "section": "Servering",
      "text": "Pynt med aspargesbånd, cherrytomater, citronbåde og dild, og server straks."
    }
  ],
