  "steps": [
    {
      "section": "Kakaobunde",
      "text": "Tænd ovnen på 175 °C, og smør en springform på ca. 22 cm."
    },
    {
      "section": "Kakaobunde",
      "text": "Rør smør, sukker og vaniljesukker sammen. Tilsæt det ene æg, og pisk grundigt. Pisk derefter det andet æg i, til massen minder om æggesnaps."
    },
    {
      "section": "Kakaobunde",
      "text": "Bland hvedemel, bagepulver og kakaopulver, og si det over æggemassen i omgange. Vend skiftevis mælk i, så dejen bliver jævn."
    },
    {
      "section": "Kakaobunde",
      "text": "Hæld dejen i formen, og bag kagen midt i ovnen i ca. 50 minutter."
    },
    {
      "section": "Kakaobunde",
      "text": "Læg evt. bagepapir over kagen efter ca. 30 minutter, så toppen ikke bliver for mørk."
    },
    {
      "section": "Kakaobunde",
      "text": "Lad kagen køle helt af, og del den forsigtigt i 3 tynde bunde med en lang kniv."
    },
    {
      "section": "Fyld",
      "text": "Pisk fløden til et let skum. Tag 2 dl fra til pynt, og stil det koldt."
    },
    {
      "section": "Fyld",
      "text": "Vend frugt og hakket chokolade forsigtigt i den resterende flødeskum."
    },
    {
      "section": "Fyld",
      "text": "Læg den nederste bund på et fad, og smør halvdelen af fyldet ovenpå. Læg den midterste bund over, og top med resten af fyldet."
    },
    {
      "section": "Fyld",
      "text": "Afslut med den sidste bund. Pynt med det afsatte flødeskum og chokoladespåner."
    }
  ],
  "changes": []
