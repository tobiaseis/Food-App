  "steps": [
    {
      "section": "Kartofler en papillote",
      "text": "Bring vandet i kog med saltet. Kog kartoflerne i ca. 4 minutter, og hæld dem derefter af. Lad dem dampe tørre."
    },
    {
      "section": "Kartofler en papillote",
      "text": "Skyl kikærterne, og lad dem dryppe af i en sigte."
    },
    {
      "section": "Kartofler en papillote",
      "text": "Vend kikærter og de forkogte kartofler med citronpeberen."
    },
    {
      "section": "Kartofler en papillote",
      "text": "Skær 4 stykker bagepapir på ca. 38 x 42 cm. Del kartoffelblandingen, radiser, forårsløg og spinat ligeligt mellem dem. Drys med saltet, og fordel osten ovenpå."
    },
    {
      "section": "Kartofler en papillote",
      "text": "Luk pakkerne ved at folde de to lange sider sammen i små ruller ned mod fyldet. Sno enderne, og bøj dem op, så pakkerne holder tæt."
    },
    {
      "section": "Kartofler en papillote",
      "text": "Sæt pakkerne i en bradepande, og bag dem midt i ovnen ved 225 °C (ikke varmluft) i ca. 20 minutter."
    },
    {
      "section": "Aspargessalat",
      "text": "Varm en grillpande godt op. Vend aspargesene i olien, og grill dem i ca. 3 minutter."
    },
    {
      "section": "Aspargessalat",
      "text": "Vend spidskål, dild og forårsløgstop sammen i et fad. Læg aspargesene ovenpå, og drys med saltet."
    },
    {
      "section": "Aspargessalat",
      "text": "Server salaten til kartoflerne. Gæsterne åbner selv deres pakke ved bordet."
    }
  ],
