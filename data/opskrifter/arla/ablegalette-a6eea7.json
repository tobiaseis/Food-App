  "steps": [
    {
      "section": "Tærtebund",
      "text": "Bland hvedemel, mandelmel og sukker i en skål."
    },
    {
      "section": "Tærtebund",
      "text": "Skær det kolde smør i små tern, og smuldr det ud i melblandingen med fingrene."
    },
    {
      "section": "Tærtebund",
      "text": "Tilsæt ægget, og samle dejen hurtigt, uden at ælte den for meget."
    },
    {
      "section": "Tærtebund",
      "text": "Rul dejen til en rund bund på ca. 40 cm i diameter mellem to stykker bagepapir. Løft bunden med det nederste papir over på en bageplade, og stil den på køl."
    },
    {
      "section": "Fyld",
      "text": "Bland sukker og mandelmel i en lille skål."
    },
    {
      "section": "Sådan samler du æblegaletten",
      "text": "Forvarm ovnen til 200 °C (almindelig ovn)."
    },
    {
      "section": "Sådan samler du æblegaletten",
      "text": "Strø sukkerblandingen over dejen, så der er en kant på ca. 5 cm uden fyld."
    },
    {
      "section": "Sådan samler du æblegaletten",
      "text": "Læg æbleskiverne jævnt ud oven på sukkeret."
    },
    {
      "section": "Sådan samler du æblegaletten",
      "text": "Frigør dejkanten fra papiret med en lille skarp kniv, og fold den ind over æblerne."
    },
    {
      "section": "Sådan samler du æblegaletten",
      "text": "Pensl den foldede kant med sammenpisket æg, og drys perlesukker over."
    },
    {
      "section": "Sådan samler du æblegaletten",
      "text": "Bag galetten midt i ovnen i ca. 15 minutter, til kanten er gylden og sprød. Server den lun med creme fraiche."
    }
  ],
  "changes": [
    "Mandelmel er erstattet med mandler, som males fint, da mandelmel kan være svært at finde."
  ]
}
