  "steps": [
    {
      "section": "Saltning",
      "text": "Pil sener og hinder af mørbradene."
    },
    {
      "section": "Saltning",
      "text": "Rør salt og sukker sammen, og gnid blandingen over kødet. Husk især de tynde steder."
    },
    {
      "section": "Saltning",
      "text": "Dæk kødet til og lad det ligge i køleskabet i cirka 3 timer."
    },
    {
      "section": "Sennepsdressing",
      "text": "Rør alle ingredienserne til dressingen sammen, og stil den tildækket i køleskabet i mindst en halv time."
    },
    {
      "section": "Rødbedesalat",
      "text": "Skyl rødbederne godt. Bring vandet i kog i en gryde med saltet, og læg rødbederne i."
    },
    {
      "section": "Rødbedesalat",
      "text": "Læg låg på, og lad rødbederne simre ved svag varme i cirka 35 minutter, til de er møre."
    },
    {
      "section": "Rødbedesalat",
      "text": "Si kogevandet fra, og afkøl rødbederne kort under koldt vand. Skær top og rodende af, og træk skrællen af."
    },
    {
      "section": "Rødbedesalat",
      "text": "Skær rødbederne i tykke stave. Læg dem i en skål i lag med rødløg og kapers."
    },
    {
      "section": null,
      "text": "Læg kødet i en gryde, og dæk det med koldt vand. Bring det i kog, sæt låg på, og lad det simre ved svag varme i cirka 12 minutter."
    },
    {
      "section": null,
      "text": "Øs skummet af. Mål temperaturen midt i kødet med et stegetermometer – den skal være cirka 60 °C."
    },
    {
      "section": null,
      "text": "Tag gryden af varmen, og lad kødet trække under låg i vandet i cirka 10 minutter."
    },
    {
      "section": null,
      "text": "Er dressingen for tyk, så tynd den med lidt vand. Smag den til."
    },
    {
      "section": null,
      "text": "Skær mørbraden i skiver, og server den med dressingen, rødbedesalaten og de ovnstegte kartofler."
    }
  ],
