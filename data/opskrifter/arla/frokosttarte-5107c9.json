  "steps": [
    {
      "section": "Dej",
      "text": "Kom mel, timianblade og fint salt i en skål."
    },
    {
      "section": "Dej",
      "text": "Del det kolde smør i små stykker, og gnid dem ud i melet med fingrene, indtil blandingen minder om revet ost."
    },
    {
      "section": "Dej",
      "text": "Hæld vandet i, og ælt hurtigt dejen sammen."
    },
    {
      "section": "Dej",
      "text": "Smør en springform på ca. 22 cm, og pres dejen ud i bunden og halvvejs op ad kanten."
    },
    {
      "section": "Dej",
      "text": "Dæk formen til, og lad den hvile i køleskabet i mindst en halv time."
    },
    {
      "section": "Dej",
      "text": "Forbag bunden på ovnens midterste rille i ca. 18 minutter ved 200 °C."
    },
    {
      "section": "Gulerods-porrefyld",
      "text": "Varm smørret op på en pande ved kraftig varme. Pas på, at det ikke bliver brunt."
    },
    {
      "section": "Gulerods-porrefyld",
      "text": "Svits gulerødder og porre på panden i ca. 3 minutter."
    },
    {
      "section": "Gulerods-porrefyld",
      "text": "Pisk æg og mælk sammen i en skål, og bland derefter ost, groft salt og peber i. Vend de svitsede grøntsager i."
    },
    {
      "section": "Gulerods-porrefyld",
      "text": "Hæld fyldet over den forbagte bund, og bag tærten på midterste rille i ca. 40 minutter ved 200 °C."
    },
    {
      "section": "Gulerods-porrefyld",
      "text": "Strø pinjekerner over, og server tærten varm eller kold."
    }
  ],
