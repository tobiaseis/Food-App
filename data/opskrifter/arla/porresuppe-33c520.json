  "steps": [
    {
      "section": "Porresuppe",
      "text": "Smelt smørret i en stor gryde over kraftig varme. Det må ikke tage farve."
    },
    {
      "section": "Porresuppe",
      "text": "Svits porrerne i ca. 4 minutter på kraftig varme, og rør af og til."
    },
    {
      "section": "Porresuppe",
      "text": "Tilsæt hvidløget, og svits med i ca. ½ minut."
    },
    {
      "section": "Porresuppe",
      "text": "Hæld grøntsagsfonden i, og rør miso og salt ud i den. Bring det i kog, og rør, til misoen er helt opløst."
    },
    {
      "section": "Porresuppe",
      "text": "Rør fløden i, og lad suppen blive varm igen. Kom linserne i, og smag suppen til."
    },
    {
      "section": "Salat-topping",
      "text": "Vend babyleaf, chili og porretop sammen i en lille skål."
    },
    {
      "section": "Salat-topping",
      "text": "Anret den varme suppe med salattoppingen, og server med det ristede brød ved siden af."
    }
  ],
