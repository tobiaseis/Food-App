  "steps": [
    {
      "section": "Kartoffelmos",
      "text": "Del kartoflerne i mindre stykker, og kog dem i usaltet vand i cirka 20 minutter, til de er helt møre."
    },
    {
      "section": "Kartoffelmos",
      "text": "Si vandet fra, og mas kartoflerne med en kartoffelmoser eller et piskeris."
    },
    {
      "section": "Kartoffelmos",
      "text": "Rør smørret ud i den varme mos, til det er smeltet."
    },
    {
      "section": "Kartoffelmos",
      "text": "Pisk den varme mælk i lidt ad gangen, til mosen har den konsistens, du bedst kan lide."
    },
    {
      "section": "Kartoffelmos",
      "text": "Krydr med salt, og lad mosen blive gennemvarm. Smag til."
    },
    {
      "section": "Bacon og løg",
      "text": "Smelt smørret i en pande, til det får en gylden farve."
    },
    {
      "section": "Bacon og løg",
      "text": "Kom baconternene på panden, og steg dem ved høj varme i cirka 2 minutter. Skru ned til middel varme, og steg videre i cirka 15 minutter, til de er gyldne og sprøde. Rør i dem ind imellem."
    },
    {
      "section": "Bacon og løg",
      "text": "Tag baconen op, og lad den dryppe af på køkkenrulle."
    },
    {
      "section": "Bacon og løg",
      "text": "Steg løgene i fedtet fra baconen ved høj varme i cirka 5 minutter. Skru ned til middel varme, og steg i yderligere 5 minutter, mens du rører af og til. Smag til med salt og peber."
    },
    {
      "section": "Bacon og løg",
      "text": "Kom baconen tilbage på panden, og rør den sammen med løgene."
    },
    {
      "section": "Til servering",
      "text": "Anret mosen med bacon og løg, og drys med persille eller purløg. Server med rødbeder og rugbrød."
    }
  ],
