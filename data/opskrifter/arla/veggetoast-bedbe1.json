  "steps": [
    {
      "section": "Grillet aubergine",
      "text": "Skyl auberginen og skær den i skiver på 1-1½ cm. Læg dem i en skål, og drys med saltet. Lad dem stå i ca. 10 minutter."
    },
    {
      "section": "Grillet aubergine",
      "text": "Varm en grillpande godt op i ca. 4 minutter."
    },
    {
      "section": "Grillet aubergine",
      "text": "Vend skiverne rundt i olien, og grill dem i ca. 3 minutter på hver side. Læg dem tilbage i skålen, og rør dem sammen med pestoen."
    },
    {
      "section": "Syltede rødløg",
      "text": "Kog eddike, sukker og salt op i en gryde, mens auberginen griller."
    },
    {
      "section": "Syltede rødløg",
      "text": "Kom rødløgene i, og lad dem koge på høj varme uden låg i ca. 3 minutter. Hæld dem i en skål, og lad dem trække, til du skal servere."
    },
    {
      "section": "Til toasten",
      "text": "Dæk en bageplade med alufolie, og læg brødskiverne på. Grill dem øverst i ovnen i ca. 2 minutter, kun på den ene side."
    },
    {
      "section": "Til toasten",
      "text": "Tag pladen ud, og vend brødene. Strø halvdelen af osten over 4 af skiverne. Læg auberginen på de øvrige 4, og top med resten af osten."
    },
    {
      "section": "Til toasten",
      "text": "Grill brødene øverst i ovnen i 3-4 minutter."
    },
    {
      "section": "Til toasten",
      "text": "Sæt sandwichene sammen med syltede løg, lidt af syltelagen og avocado. Server med det samme sammen med salaten og resten af syltelagen."
    }
  ],
