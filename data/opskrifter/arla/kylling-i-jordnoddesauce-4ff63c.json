  "steps": [
    {
      "section": null,
      "text": "Put fløde, vand, løg, peanutbutter, farin, fond, peanuts, chili samt limeskal og limesaft i en gryde. Rør rundt, og bring det i kog."
    },
    {
      "section": null,
      "text": "Skru ned for varmen, og lad saucen simre i ca. 5 minutter. Rør i den ind imellem."
    },
    {
      "section": null,
      "text": "Kog imens risene færdige efter anvisningen på pakken."
    },
    {
      "section": null,
      "text": "Smelt halvdelen af smørret på en pande, til det får en gylden farve. Steg kyllingestrimlerne ved middel varme i 3-4 minutter, og drys dem med saltet. Vend dem derefter ned i saucen."
    },
    {
      "section": null,
      "text": "Brun resten af smørret på panden. Steg æbleskiverne og hvidløget i ca. 1 minut, og kom det i gryden."
    },
    {
      "section": null,
      "text": "Varm retten igennem, og smag den til."
    },
    {
      "section": null,
      "text": "Steg forårsløgene i lidt smør, og server dem med kyllingen og risene."
    }
  ],
