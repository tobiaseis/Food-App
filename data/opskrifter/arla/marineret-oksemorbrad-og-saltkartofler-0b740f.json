  "steps": [
    {
      "section": "Marineret oksemørbrad",
      "text": "Pil hinder og sener af mørbraden, og krydr den med peber."
    },
    {
      "section": "Marineret oksemørbrad",
      "text": "Læg kødet i en frysepose med cognac, appelsinskal og peberkorn. Luk posen og lad den stå i køleskabet i ca. 2 timer. Vend posen et par gange undervejs."
    },
    {
      "section": "Marineret oksemørbrad",
      "text": "Løft kødet op af posen, og dup det tørt. Hæld marinaden i en skål, og gem den til saucen."
    },
    {
      "section": "Marineret oksemørbrad",
      "text": "Varm ovnen op til 100 °C. Brun smørret let gyldent på en pande, drys kødet med salt, og brun det rundt om på alle sider i ca. 3 minutter i alt."
    },
    {
      "section": "Marineret oksemørbrad",
      "text": "Hæld vandet i en bradepande på ca. 22 x 30 cm, og sæt en rist over den. Læg mørbraden på risten, og steg den midt i ovnen i ca. 65 minutter. Hæld lidt mere vand i, hvis bradepanden tørrer ind."
    },
    {
      "section": "Marineret oksemørbrad",
      "text": "Mål kødets kernetemperatur med et stegetermometer efter ca. 1 time. Den skal vise ca. 58 °C. Steg om nødvendigt de sidste 5 minutter."
    },
    {
      "section": "Marineret oksemørbrad",
      "text": "Dæk mørbraden til, og hold den varm. Gem stegesky fra bradepanden, og skru ovnen op på 250 °C."
    },
    {
      "section": "Saltkartofler",
      "text": "Skrub kartoflerne, mens kødet steger."
    },
    {
      "section": "Saltkartofler",
      "text": "Rør vand og salt sammen i en gryde, og bring det i kog, til saltet er opløst. Kom kartoflerne i, læg låg på, og kog dem ved svag varme i ca. 15 minutter."
    },
    {
      "section": "Saltkartofler",
      "text": "Hæld vandet fra, og lad kartoflerne dampe tør. Fordel dem på en plade med bagepapir, og bag dem midt i ovnen ved 250 °C i ca. 15 minutter."
    },
    {
      "section": "Grøntsager",
      "text": "Smelt smørret på en pande ved kraftig varme. Det må ikke tage farve."
    },
    {
      "section": "Grøntsager",
      "text": "Svits løgene i ca. 2 minutter. Kom ærterne på, og svits i ca. 1 minut mere."
    },
    {
      "section": "Grøntsager",
      "text": "Kom sharonfrugt, salt og peber på panden, og varm det hele godt igennem. Smag til."
    },
    {
      "section": "Sauce",
      "text": "Hæld marinaden og stegeskyen i en tykbundet gryde, og kog det op. Lad det koge kraftigt uden låg, til der er ca. 1 dl tilbage."
    },
    {
      "section": "Sauce",
      "text": "Si væsken, og hæld den tilbage i gryden. Rør fløde, salt og peber i, og bring saucen i kog."
    },
    {
      "section": "Sauce",
      "text": "Tag gryden af varmen, og pisk saucejævneren ud i saucen. Lad den simre under omrøring i ca. 2 minutter. Smag til, og farv med kulør."
    },
    {
      "section": "Til servering",
      "text": "Skær mørbraden i skiver, og server den med kartofler, grøntsager og sauce. Pynt med appelsinskal og timian."
    }
  ],
