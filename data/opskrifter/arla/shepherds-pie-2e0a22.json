  "steps": [
    {
      "section": "Kødsauce",
      "text": "Varm smørret op i en gryde, til det får en gylden farve. Rør løgene og hvidløget i det i cirka 1 minut."
    },
    {
      "section": "Kødsauce",
      "text": "Kom lammekødet og saltet i gryden. Brun kødet under omrøring i cirka 10 minutter, til væsken er kogt helt væk."
    },
    {
      "section": "Kødsauce",
      "text": "Drys melet over, og rør rundt. Hæld worcestershiresauce, tomatpuré, oksefond og vand i. Lad saucen koge uden låg ved middel varme i cirka 10 minutter, og rør indimellem. Smag den til."
    },
    {
      "section": "Kødsauce",
      "text": "Kom kødsaucen i et ovnfast fad, og strø gulerødder og ærter ovenpå."
    },
    {
      "section": "Kartoffelmos",
      "text": "Skræl kartoflerne, mens saucen simrer, og skær dem i mindre stykker. Kog dem helt møre i usaltet vand i en tykbundet gryde i cirka 20 minutter."
    },
    {
      "section": "Kartoffelmos",
      "text": "Hæld kogevandet fra, og lad kartoflerne dampe tørre i den varme gryde."
    },
    {
      "section": "Kartoffelmos",
      "text": "Mos kartoflerne med en kartoffelstøder, eller pisk dem med et piskeris. Rør mælken i lidt ad gangen, mens du pisker. Pisk smørret i, og smag mosen til med salt og peber."
    },
    {
      "section": "Kartoffelmos",
      "text": "Smør mosen ud over fadet, så den ser indbydende ud. Bag retten midt i ovnen ved 225 °C i cirka 20 minutter."
    }
  ],
  "changes": []
