  "steps": [
    {
      "section": "Kyllingefond",
      "text": "Læg kyllingen i en stor gryde sammen med krydderurter, løg, gulerødder, porre, peberkorn og groft salt. Fyld op med koldt vand, så kyllingen er dækket."
    },
    {
      "section": "Kyllingefond",
      "text": "Bring det i kog, og skru derefter ned, så det simrer i ca. 1 time. Tag gryden af varmen, og lad kyllingen trække i fonden i ca. 1 time."
    },
    {
      "section": "Kyllingefond",
      "text": "Hæv kyllingen op, og si fonden. Gem fonden. Pil kødet af kyllingen, og del det i trevler."
    },
    {
      "section": "Suppe",
      "text": "Varm olien godt op i en tykbundet gryde. Rør karry, løg, hvidløg, ingefær og salt i gryden, og svits det i ca. 1 minut."
    },
    {
      "section": "Suppe",
      "text": "Hæld 1 liter af fonden i gryden, og bring den i kog. Tilsæt fløde, kyllingekød og det meste af chilien. Gem lidt chili til pynt. Lad suppen koge op igen."
    },
    {
      "section": "Suppe",
      "text": "Smag suppen til. Kog imens risene efter anvisningen på posen."
    },
    {
      "section": "Til servering",
      "text": "Hæld suppen op, og pynt med koriander og resten af chilien. Server med ris og groft brød ved siden af."
    }
  ],
