  "steps": [
    {
      "section": "Rødbeder",
      "text": "Tænd ovnen på 250 °C varmluft."
    },
    {
      "section": "Rødbeder",
      "text": "Læg rødbederne på en bageplade med bagepapir. Vend dem med olie og salt."
    },
    {
      "section": "Rødbeder",
      "text": "Sæt pladen midt i ovnen i ca. 20 min. Vend rødbederne et par gange undervejs."
    },
    {
      "section": "Selleripuré",
      "text": "Kom selleri og vand i en tykbundet gryde, og bring det i kog."
    },
    {
      "section": "Selleripuré",
      "text": "Læg låg på, og lad sellerien simre ved svag varme i 15-20 min., til den er helt mør."
    },
    {
      "section": "Selleripuré",
      "text": "Si vandet fra. Mos sellerien med fløde, salt og peber."
    },
    {
      "section": "Selleripuré",
      "text": "Varm puréen op under omrøring, til den koger. Smag den til."
    },
    {
      "section": "Stegte svampe",
      "text": "Varm olien på en pande. Steg svampene med rosmarin, salt og peber ved høj varme i ca. 6 min., til de er gyldne og tørre."
    },
    {
      "section": "Til servering",
      "text": "Læg salatbladene på fade, og top med de stegte svampe. Server med rødbeder, selleripuré og ristet brød."
    }
  ],
