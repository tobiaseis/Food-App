  "steps": [
    {
      "section": "Til squashfritterne",
      "text": "Tænd ovnen på 200 °C varmluft, så den er varm, når fritterne skal ind."
    },
    {
      "section": "Til squashfritterne",
      "text": "Del squashen i stave på ca. 1 cm i tykkelse."
    },
    {
      "section": "Til squashfritterne",
      "text": "Fordel melet og saltet i en stor skål. Bland pankoraspen med den revne cheddar i en anden stor skål."
    },
    {
      "section": "Til squashfritterne",
      "text": "Slå æggene ud på en dyb tallerken, og pisk dem løse med en gaffel."
    },
    {
      "section": "Til squashfritterne",
      "text": "Vend staverne først i melblandingen, så i æg og til sidst i raspblandingen, så de er dækket hele vejen rundt. Det går nemmest, hvis du tager 2-3 stave ad gangen."
    },
    {
      "section": "Til squashfritterne",
      "text": "Anret staverne på en bageplade med bagepapir, så de ikke rører hinanden."
    },
    {
      "section": "Til squashfritterne",
      "text": "Sæt pladen i ovnen, og bag fritterne i 20-25 minutter."
    },
    {
      "section": "Til dippen",
      "text": "Rør alle ingredienserne til dippen sammen i en skål, og smag den til. Drys evt. lidt hakket purløg over som pynt."
    }
  ],
  "changes": [
    "Grahamsmel er udeladt, og fuldkornshvedemel bruges i stedet.",
