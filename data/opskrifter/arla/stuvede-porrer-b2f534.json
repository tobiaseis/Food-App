  "steps": [
    {
      "section": null,
      "text": "Skær porrerne i stykker på ca. 4 cm. Halvér meget tykke porrer på langs."
    },
    {
      "section": null,
      "text": "Varm smørret op på en pande, til det får en gylden farve."
    },
    {
      "section": null,
      "text": "Steg porrestykkerne i ca. 4 minutter ved middel til høj varme, til de er brunede. Vend dem en gang imellem."
    },
    {
      "section": null,
      "text": "Rør godt rundt i fløden, og hæld den over porrerne. Krydr med salt og peber."
    },
    {
      "section": null,
      "text": "Lad det simre uden låg ved lav varme i 3-4 minutter. Rør citronsaften i, og smag til."
    },
    {
      "section": null,
      "text": "Server med et drys krydderurter, hvis du vil."
    }
  ],
