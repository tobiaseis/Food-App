  "steps": [
    {
      "section": "Salat",
      "text": "Skyl spelten, og kog den i bouillonen i cirka 20 minutter. Si den fra, og lad den køle helt af."
    },
    {
      "section": "Salat",
      "text": "Vend den afkølede spelt med granatæblekerner, æbletern og grønkål."
    },
    {
      "section": "Salat",
      "text": "Rør appelsinjuice, granatæblesaft, olie, salt og peber sammen til en dressing. Vend den i salaten, og smag til."
    },
    {
      "section": "Persilledressing",
      "text": "Rør yoghurten med appelsinskal, persille, salt og peber. Smag til."
    },
    {
      "section": "Fisk",
      "text": "Pisk æggene med persillen i en dyb tallerken. Hæld grahamsmelet på en anden tallerken."
    },
    {
      "section": "Fisk",
      "text": "Vend fiskefileterne først i æggeblandingen og derefter i melet."
    },
    {
      "section": "Fisk",
      "text": "Bruns smørret i en pande ved middelvarme. Steg fileterne i cirka 2 minutter på hver side."
    },
    {
      "section": "Til servering",
      "text": "Læg de varme fileter på et fad med appelsinbåde. Server salaten og dressingen ved siden af."
    }
  ],
