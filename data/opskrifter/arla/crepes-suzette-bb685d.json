  "steps": [
    {
      "section": "Pandekager",
      "text": "Rør hvedemel og citronskal sammen. Tilsæt fløde og vand lidt ad gangen under piskning, indtil dejen er glat. Pisk æggene ned i dejen."
    },
    {
      "section": "Pandekager",
      "text": "Smelt smørret på en pande, og rør det ned i dejen."
    },
    {
      "section": "Pandekager",
      "text": "Varm en lille pande (ca. 14 cm i diameter), og kom ½ dl dej på. Steg pandekagerne ved middel varme, til de er lysebrune på begge sider."
    },
    {
      "section": "Pandekager",
      "text": "Fold hver pandekage to gange, og stil dem på et fad. Steg resten af dejen på samme måde."
    },
    {
      "section": "Appelsinsauce",
      "text": "Smelt smørret på en pande ved høj varme. Lad det ikke brune."
    },
    {
      "section": "Appelsinsauce",
      "text": "Rør flormelis, appelsinjuice, citronsaft og appelsinskal i. Sænk til middel varme, og lad saucen koge ca. 5 minutter, til den er tyknet."
    },
    {
      "section": "Appelsinsauce",
      "text": "Læg de foldede pandekager i saucen, og varm dem igennem i ca. 3 minutter. Saucen skal fortsat småkoge."
    },
    {
      "section": "Flambering",
      "text": "Sluk for emhætten, og hold et låg parat i tilfælde af store flammer. Hæld likøren på panden, og tænd ild i saucen."
    },
    {
      "section": "Flambering",
      "text": "Lad saucen simre ca. 1 minut endnu."
    },
    {
      "section": "Servering",
      "text": "Læg to pandekager på hver tallerken, og øs sauce over. Drys med ristede mandelsplitter, og server med vaniljeis ved siden af."
    }
  ],
  "changes": [
    "Flormelis er skrevet som sukker i varenavnet, med flormelis i noten.",
    "Grand Marnier er skrevet som likør."
  ]
