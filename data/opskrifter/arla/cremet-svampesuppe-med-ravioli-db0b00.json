  "steps": [
    {
      "section": "Suppen",
      "text": "Smelt smørret i en stor gryde på kraftig varme. Det må ikke tage farve."
    },
    {
      "section": "Suppen",
      "text": "Skær de største svampe i mindre stykker. Steg dem med løg, timianblade, salt og peber i ca. 3 minutter på kraftig varme, til al væde er kogt væk."
    },
    {
      "section": "Suppen",
      "text": "Hæld hvidvinen i og lad den koge ind i ca. 5 minutter."
    },
    {
      "section": "Suppen",
      "text": "Rør fond og fløde i, og bring det i kog. Smag suppen til med salt og peber."
    },
    {
      "section": "Til servering",
      "text": "Kog raviolierne, som det står på pakken, og læg dem i fire dybe tallerkener."
    },
    {
      "section": "Til servering",
      "text": "Øs suppen over, og pynt med enokisvampe og timiankviste. Server med brød med det samme."
    }
  ],
