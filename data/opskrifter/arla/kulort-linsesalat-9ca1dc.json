  "steps": [
    {
      "section": "Linser",
      "text": "Kom saltet i vandet i en gryde, og lad det koge op."
    },
    {
      "section": "Linser",
      "text": "Kom linserne i det kogende vand. Læg låg på, og lad dem simre ved svag varme i cirka 14 minutter."
    },
    {
      "section": "Linser",
      "text": "Si linserne fra, skyl dem under koldt vand, og lad vandet løbe godt af."
    },
    {
      "section": "Linsesalat",
      "text": "Skær stokken af blomkålen i små tern, og pil resten ud i helt små buketter."
    },
    {
      "section": "Linsesalat",
      "text": "Vend blomkål, linser, peberfrugt, rødløg, ærter, melon (eller æbler), mandler, salsa og salt sammen. Smag til."
    },
    {
      "section": "Linsesalat",
      "text": "Del salaten ud i fire skåle, og top med en klat hytteost. Server med naanbrød ved siden af."
    }
  ],
