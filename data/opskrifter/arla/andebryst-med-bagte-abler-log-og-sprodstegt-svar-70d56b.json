  "steps": [
    {
      "section": null,
      "text": "Varm ovnen op til 175 °C (almindelig ovn)."
    },
    {
      "section": "Andebryst",
      "text": "Pluk eventuelle fjerrester af andebrystene. Løsn skindet fra kødet med fingrene eller en skarp kniv, og skær det i strimler på ca. 1 cm."
    },
    {
      "section": "Andebryst",
      "text": "Smelt smørret på en pande, til det bliver gyldent. Steg skindstrimlerne i ca. 2 minutter, og vend dem undervejs."
    },
    {
      "section": "Andebryst",
      "text": "Strø halvdelen af saltet over, når strimlerne begynder at få farve. Steg videre ved middelvarme i ca. 3 minutter, til de er gyldne og sprøde."
    },
    {
      "section": "Andebryst",
      "text": "Tag de sprøde svær op på køkkenpapir, og lad fedtet blive på panden."
    },
    {
      "section": "Andebryst",
      "text": "Krydr kødet med resten af saltet og peber. Varm fedtet op, og brun andebrystet ca. 1 minut på hver side ved middelvarme. Læg det til side."
    },
    {
      "section": "Bagte æbler og løg",
      "text": "Svits rødløgene i fedtet på panden i ca. 1 minut ved høj varme."
    },
    {
      "section": "Bagte æbler og løg",
      "text": "Kom løgene i et ovnfast fad, og bland dem med æbleboffer, timian, salt og peber."
    },
    {
      "section": "Bagte æbler og løg",
      "text": "Anbring andebrystene oven på, og bag dem midt i ovnen i ca. 30 minutter."
    },
    {
      "section": "Til servering",
      "text": "Skær andebrystet i skiver. Rør tranebærrene ind i de bagte æbler og løg."
    },
    {
      "section": "Til servering",
      "text": "Læg andeskiver og sprøde svær ovenpå æbler og løg, og server med ristet rugbrød."
    }
