  "steps": [
    {
      "section": "Mojitosirup",
      "text": "Hæld limesaft, sukker og rom i en gryde, og lad det komme i kog."
    },
    {
      "section": "Mojitosirup",
      "text": "Lad det simre ved middel varme i cirka 30 minutter, til det er blevet tykt som en sirup."
    },
    {
      "section": "Mojitosirup",
      "text": "Træk gryden væk fra varmen, og lad siruppen køle helt af."
    },
    {
      "section": "Is",
      "text": "Pisk æggeblommer og sukker i cirka 2 minutter, til massen er lys og luftig."
    },
    {
      "section": "Is",
      "text": "Varm fløden op til kogepunktet i en lille gryde med tyk bund, og tag den af varmen."
    },
    {
      "section": "Is",
      "text": "Pisk æggemassen ned i den varme fløde."
    },
    {
      "section": "Is",
      "text": "Sæt gryden på middel varme igen, og varm cremen lige under kogepunktet i cirka 2 minutter. Pisk hele tiden, og vent, til den bliver tyk. Den må ikke koge. Lad den derefter køle af."
    },
    {
      "section": "Is",
      "text": "Rør sirup, rom, limeskal og hakket mynte i cremen. Hæld den i en form på cirka 1 liter, dæk til, og sæt den i fryseren."
    },
    {
      "section": "Is",
      "text": "Rør godt rundt i isen 4-5 gange, mens den fryser."
    },
    {
      "section": "Ved servering",
      "text": "Tag isen ud af fryseren lige før servering, da alkoholen får den til at smelte hurtigt. Pynt med mynteblade."
    }
  ],
