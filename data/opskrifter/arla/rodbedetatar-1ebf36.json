  "steps": [
    {
      "section": "Rødbedetatar",
      "text": "Læg rødbederne i en gryde, og fyld op med vand, så de er dækket. Bring i kog, og lad dem simre under låg i ca. 1 time, til de er møre."
    },
    {
      "section": "Rødbedetatar",
      "text": "Si kogevandet fra, og skyl rødbederne i koldt vand flere gange, til de er helt kolde. Skær top og rod af, og træk skrællen af."
    },
    {
      "section": "Rødbedetatar",
      "text": "Riv rødbederne på det grove hul. Bland dem med syltede rødbeder, æble, rødløg, kapers, salt og peber."
    },
    {
      "section": "Estragonmayo",
      "text": "Blend estragonbladene med olien i ca. 3 minutter. Si olien fra, og smid bladene ud."
    },
    {
      "section": "Estragonmayo",
      "text": "Pisk æggeblommen med saltet i ca. 1 minut, og rør eddiken i. Pisk estragonolien i en tynd stråle lidt efter lidt, i alt ca. 5 minutter. Dæk mayoen til, og sæt den på køl, til den skal bruges."
    },
    {
      "section": "Jordskokkechips",
      "text": "Varm rapsolien op i en gryde ved middel varme i ca. 5 minutter."
    },
    {
      "section": "Jordskokkechips",
      "text": "Hyvl jordskokkerne i tynde skiver med en skræller. Steg ca. 10 skiver ad gangen i den varme olie i ca. 6 minutter, til de er gyldenbrune."
    },
    {
      "section": "Jordskokkechips",
      "text": "Lad chipsene dryppe af på et dobbelt lag køkkenrulle."
    },
    {
      "section": "Til servering",
      "text": "Fordel tataren på fire tallerkener. Top med estragonmayo, jordskokkechips og fetaen."
    }
  ],
  "changes": [
    "Salatost er erstattet med feta."
