  "steps": [
    {
      "section": "Til wrapbunden",
      "text": "Tænd ovnen på 180 °C varmluft. Kør æg, hytteost, salt og peber i en blender, til det er en tynd dej."
    },
    {
      "section": "Til wrapbunden",
      "text": "Rør spidskål og gulerod ned i dejen. Smag evt. til med chiliflager eller andre krydderier."
    },
    {
      "section": "Til wrapbunden",
      "text": "Smør dejen ud på en bageplade med bagepapir. Bag den gyldne i 15-20 minutter."
    },
    {
      "section": "Til wrapbunden",
      "text": "Lad bunden køle af, og træk bagepapiret forsigtigt af."
    },
    {
      "section": "Green Goddess-dressing",
      "text": "Blend alle dressingens ingredienser, til den er cremet og glat."
    },
    {
      "section": "Fyld",
      "text": "Vend hjertesalaten i dressingen, og læg den på den afkølede bund."
    },
    {
      "section": "Fyld",
      "text": "Læg tomater, kylling og kalkunbacon ovenpå."
    },
    {
      "section": "Fyld",
      "text": "Rul bunden sammen fra den lange side, og skær rullen over på midten."
    }
  ],
