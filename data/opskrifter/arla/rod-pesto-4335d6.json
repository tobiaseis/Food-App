  "steps": [
    {
      "section": null,
      "text": "Læg nødder, soltørrede tomater, ost, hvidløg, salt og olie i en minihakker eller foodprocessor."
    },
    {
      "section": null,
      "text": "Blend, indtil massen er fint hakket."
    },
    {
      "section": null,
      "text": "Smag pestoen til, og justér med salt, hvis det er nødvendigt."
    },
    {
      "section": null,
      "text": "Fyld pestoen på et rent glas, og sæt den i køleskabet."
    },
    {
      "section": null,
      "text": "Drys eventuelt med basilikum, når pestoen skal serveres."
