  "steps": [
    {
      "section": "Sveskekompot",
      "text": "Kom svesker, vand og sukker i en gryde, og bring det i kog."
    },
    {
      "section": "Sveskekompot",
      "text": "Skru ned til svag varme, læg låg på, og lad det simre i ca. 20 minutter. Rør en gang imellem."
    },
    {
      "section": "Sveskekompot",
      "text": "Tag gryden af varmen, rør portvin og citronsaft i, og lad kompotten blive kold. Vend derefter mandlerne i."
    },
    {
      "section": "Creme",
      "text": "Rør æggeblommer, sukker og majsstivelse sammen i en gryde med tykt bund, og tilsæt mælken under omrøring."
    },
    {
      "section": "Creme",
      "text": "Opvarm blandingen ved jævn varme, mens du pisker løbende. Lad den koge i ca. 1 minut, og fortsæt med at piske."
    },
    {
      "section": "Creme",
      "text": "Hæld cremen i en skål, og lad den køle helt af. Rør i den af og til, så der ikke dannes skind."
    },
    {
      "section": "Creme",
      "text": "Pisk fløden let stiv. Vend ca. tre fjerdedele af den i den kolde creme, og sæt resten til side som pynt."
    },
    {
      "section": "Anretning",
      "text": "Byg desserten op i høje glas på ca. 2½ dl: Fordel creme, makroner og sveskekompot i lag."
    },
    {
      "section": "Anretning",
      "text": "Dæk glassene til, og stil dem på køl i ca. 1 time."
    },
    {
      "section": "Anretning",
      "text": "Top med den sparede flødeskum og citronskal, og server med lange skeer."
    }
  ],
