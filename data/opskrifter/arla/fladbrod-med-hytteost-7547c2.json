  "servings": 2,
  "title": "Fladbrød med hytteost og kylling",
  "intro": "Et luftigt fladbrød lavet af hytteost og æg, som fyldes med pesto, kylling og friske grøntsager. Det er nemt og kan sagtens laves i forvejen.",
  "steps": [
    {
      "section": null,
      "text": "Tænd ovnen på 180 °C varmluft og læg bagepapir på en bageplade på cirka 30 x 40 cm."
    },
    {
      "section": null,
      "text": "Kør hytteost, æg, salt og peber sammen i en blender, til massen er helt glat og tyndtflydende."
    },
    {
      "section": null,
      "text": "Hæld massen på bagepapiret og stryg den ud i et jævnt lag. Strø chiliflager over."
    },
    {
      "section": null,
      "text": "Bag fladbrødet i 15-20 minutter, til overfladen er gyldden."
    },
    {
      "section": null,
      "text": "Lad brødet køle helt af på pladen, og træk så bagepapiret forsigtigt af."
    },
    {
      "section": "Fyld",
      "text": "Skær fladbrødet over på midten, så du har to halvdele."
    },
    {
      "section": "Fyld",
      "text": "Smør pesto på begge halvdele, og læg kylling, salat, tomater og syltede rødløg ovenpå."
    }
  ],
  "changes": []
