  "steps": [
    {
      "section": null,
      "text": "Varm en tør pande op ved kraftig varme, og rist solsikkekernerne i ca. 2 minutter."
    },
    {
      "section": null,
      "text": "Sænk varmen til middel, og rist kernerne videre i ca. 5 minutter."
    },
    {
      "section": null,
      "text": "Løft kernerne af panden, og lad dem køle lidt af."
    },
    {
      "section": null,
      "text": "Put kernerne i en blender sammen med pastaost, spinat, vand, olie, hvidløg og salt."
    },
    {
      "section": null,
      "text": "Blend på laveste hastighed i ca. 1 minut, og smag til."
    },
    {
      "section": null,
      "text": "Dæk pestoen til, og sæt den i køleskabet, til den skal bruges."
    }
