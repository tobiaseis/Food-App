  "steps": [
    {
      "section": "Dag 1",
      "text": "Rør alle ingredienserne til fordejen sammen i en stor skål."
    },
    {
      "section": "Dag 1",
      "text": "Læg et fugtigt viskestykke over skålen, og lad fordejen stå ved stuetemperatur i omkring 24 timer."
    },
    {
      "section": "Dag 2",
      "text": "Hæld det kogende vand over rugkernerne, og lad dem trække i ca. 10 min."
    },
    {
      "section": "Dag 2",
      "text": "Si rugkernerne, og lad dem dryppe godt af."
    },
    {
      "section": "Dag 2",
      "text": "Vend de varme rugkerner, linserne og solsikkekernerne ned i fordejen."
    },
    {
      "section": "Dag 2",
      "text": "Opløs gæren i det lunkne vand, og rør det ud i dejen."
    },
    {
      "section": "Dag 2",
      "text": "Smør en rugbrødsform på 2½ liter, og hæld dejen i."
    },
    {
      "section": "Dag 2",
      "text": "Stik 40-50 huller i dejen med en lang pind, f.eks. et grillspyd eller et stegetermometer."
    },
    {
      "section": "Dag 2",
      "text": "Drys kerner ovenpå, dæk med et fugtigt klæde, og lad brødet hæve i ca. 2 timer."
    },
    {
      "section": "Dag 2",
      "text": "Sæt låg eller alufolie på formen, og bag brødet ved 200 °C varmluft i ca. 1 time og 45 min."
    },
    {
      "section": "Dag 2",
      "text": "Tag låget eller folien af de sidste 20 min., så skorpen bliver sprød."
    }
  ],
  "changes": []
