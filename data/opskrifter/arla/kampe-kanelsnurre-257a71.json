  "steps": [
    {
      "section": "Dej",
      "text": "Rør gæren ud i den lune mælk i en stor skål."
    },
    {
      "section": "Dej",
      "text": "Tilsæt sukker, æg, hvedemel, salt og smørtern. Ælt det hele til en blank, smidig dej, gerne i røremaskine."
    },
    {
      "section": "Dej",
      "text": "Dæk skålen til, og lad dejen hæve til dobbelt størrelse, ca. 1 time."
    },
    {
      "section": "Remonce",
      "text": "Rør smør, brun farin og kanel sammen til en jævn remonce."
    },
    {
      "section": "Sukkerlage",
      "text": "Rør sukker i det kogende vand, til det er helt opløst."
    },
    {
      "section": "Sådan laver du kanelsnurren",
      "text": "Rul dejen ud til en firkant på ca. 40 x 40 cm, og fordel remoncen jævnt over hele fladen."
    },
    {
      "section": "Sådan laver du kanelsnurren",
      "text": "Rul dejen sammen til en lang rulle. Skær den på langs midt over, men stop før enden, så de to halvdele stadig hænger sammen foroven."
    },
    {
      "section": "Sådan laver du kanelsnurren",
      "text": "Sno de to strimler om hinanden, og læg snoningen i en snegl. Stik enden ind under."
    },
    {
      "section": "Sådan laver du kanelsnurren",
      "text": "Klem bagepapir fast mellem ring og bund i en springform på ca. 22 cm. Læg sneglen i formen."
    },
    {
      "section": "Sådan laver du kanelsnurren",
      "text": "Bag midt i ovnen ved 175 °C (almindelig ovn) i 1 time, til kanelsnurren er gylden og gennembagt."
    },
    {
      "section": "Sådan laver du kanelsnurren",
      "text": "Pensl straks med sukkerlagen, og drys perlesukker over, mens den er varm. Stil den til afkøling på en rist."
    }
  ],
