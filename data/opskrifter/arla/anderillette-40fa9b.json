  "steps": [
    {
      "section": null,
      "text": "Læg andelårene i en gryde sammen med andefedtet. Varm det op ved lav varme, til fedtet er smeltet."
    },
    {
      "section": null,
      "text": "Lad det simre i 5 minutter, til fedtet er helt flydende."
    },
    {
      "section": null,
      "text": "Løft lårene op af fedtet. Pluk kødet af med fingrene eller to gafler, og kassér skind og ben."
    },
    {
      "section": null,
      "text": "Vend det plukkede kød med eddike, salt og peber. Smag til."
    },
    {
      "section": null,
      "text": "Fyld rillettens kød i et serveringsglas. Pluk bladene af timiankvistene og strø dem over toppen."
    },
    {
      "section": null,
      "text": "Stil glasset på køl i mindst 2 timer, før du serverer."
    }
  ],
  "changes": [
    "Æblecidereddike er skiftet til almindelig eddike."
