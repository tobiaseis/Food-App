  "steps": [
    {
      "section": "Kyllingekødboller",
      "text": "Bland hakket kyllingekød med persille, citronskal, hvidløg og det første salt, så farsen bliver ensartet."
    },
    {
      "section": "Kyllingekødboller",
      "text": "Del farsen i 24 ens, lidt rustikke kugler på ca. 1 spsk hver."
    },
    {
      "section": "Kyllingekødboller",
      "text": "Bring vandet og det sidste salt i kog i en gryde. Læg kødbollerne i og lad dem koge uden låg på kraftig varme i ca. 3 minutter."
    },
    {
      "section": "Kyllingekødboller",
      "text": "Hæld ca. 1 dl af kogevandet fra til senere. Si kødbollerne fra og hold dem varme."
    },
    {
      "section": "Grøn pastasauce",
      "text": "Kog spaghettien efter anvisningen på pakken."
    },
    {
      "section": "Grøn pastasauce",
      "text": "Hæld det afmålte kogevand tilbage i gryden og rør ostesauce og broccoli i. Bring det i kog under omrøring."
    },
    {
      "section": "Grøn pastasauce",
      "text": "Kom squash, edamamebønner, chili og salt i. Lad saucen komme i kog igen, mens du rører, og varm den godt igennem."
    },
    {
      "section": "Grøn pastasauce",
      "text": "Vend persilleblade og kødboller i saucen, og smag til."
    },
    {
      "section": "Til servering",
      "text": "Anret saucen over den nykogte spaghetti, og server med det samme. Stil citronsaften på bordet ved siden af."
    }
  ],
