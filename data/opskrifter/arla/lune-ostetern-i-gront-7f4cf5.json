  "steps": [
    {
      "section": "Croutoner",
      "text": "Varm ovnen op til 200 °C (traditionel ovn)."
    },
    {
      "section": "Croutoner",
      "text": "Skær eller riv brødet i tern på ca. 1½ cm, og læg dem på en bageplade med bagepapir."
    },
    {
      "section": "Croutoner",
      "text": "Rist croutonerne midt i ovnen i ca. 18 minutter. Vend dem undervejs, til de er gyldne og sprøde."
    },
    {
      "section": "Sennepsdressing",
      "text": "Rør sennep, olie og citronsaft sammen i en skål."
    },
    {
      "section": "Sennepsdressing",
      "text": "Rør vandet i, krydr med salt og peber, og smag til."
    },
    {
      "section": "Lune ostetern i grønt",
      "text": "Læg salat, persille og croutoner på et stort fad, og dryp dressingen over."
    },
    {
      "section": "Lune ostetern i grønt",
      "text": "Varm en pande op, til den er rigtig varm."
    },
    {
      "section": "Lune ostetern i grønt",
      "text": "Kom osten og citronskallen på panden, og steg på kraftig varme under omrøring i ca. ½ minut."
    },
    {
      "section": "Lune ostetern i grønt",
      "text": "Hæld de varme ostetern over salaten, og server straks."
    }
  ],
  "changes": [
    "Salatost er skiftet til feta.",
