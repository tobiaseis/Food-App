  "steps": [
    {
      "section": "Skaldyrsfond",
      "text": "Varm olien op i en stor gryde, til den er rigtig varm."
    },
    {
      "section": "Skaldyrsfond",
      "text": "Steg tomatpuré, skaller, løg og gulerod over høj varme i ca. 1 minut, mens du rører rundt."
    },
    {
      "section": "Skaldyrsfond",
      "text": "Kom selleri, persillestilke og de øvrige ingredienser til fonden i gryden."
    },
    {
      "section": "Skaldyrsfond",
      "text": "Bring det i kog, sæt låg på og lad det simre ved lav varme i ca. 20 minutter."
    },
    {
      "section": "Skaldyrsfond",
      "text": "Si fonden gennem en sigte, gerne beklædt med et klæde. Kog den derefter ind ved middelvarme, til der er ca. ½ liter tilbage."
    },
    {
      "section": "Suppefyld",
      "text": "Skær tomaterne i kvarte, fjern kernerne, og hak resten i små tern."
    },
    {
      "section": "Suppefyld",
      "text": "Fordel salat, tomater, karse og rucola mellem 6 små varmefaste skåle på ca. 3 dl, helst af glas."
    },
    {
      "section": "Jomfruhummerspyd",
      "text": "Træk to jomfruhummerhaler på hvert bambusspyd."
    },
    {
      "section": "Jomfruhummerspyd",
      "text": "Smelt smørret i en pande, til det er gyldent. Steg spyddene ved høj varme i ca. 3 minutter, og vend dem undervejs."
    },
    {
      "section": "Jomfruhummerspyd",
      "text": "Krydr med citronskal, salt og peber, og stil ét spyd i hver skål."
    },
    {
      "section": "Færdig suppe",
      "text": "Kog den indkogte fond, fløden og saltet op i en tykbundet gryde, og smag til."
    },
    {
      "section": "Færdig suppe",
      "text": "Hæld den varme suppe over i skålene ved bordet, evt. fra en kande. Server med ristet franskbrød."
    }
  ],
  "changes": [
    "Feldsalat er erstattet af babyleaf.",
