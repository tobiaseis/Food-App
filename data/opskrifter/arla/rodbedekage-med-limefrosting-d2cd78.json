  "steps": [
    {
      "section": "Rødbedekage",
      "text": "Tænd ovnen på 175 °C (almindelig ovn) og smør en springform på ca. 24 cm."
    },
    {
      "section": "Rødbedekage",
      "text": "Kværn smør og brun farin med en piskeris eller en røremaskine, til det er lyst og luftigt."
    },
    {
      "section": "Rødbedekage",
      "text": "Pisk æggene i et ad gangen, og rør godt efter hvert."
    },
    {
      "section": "Rødbedekage",
      "text": "Bland hvedemel, vaniljesukker, bagepulver og salt i en skål. Rør rødbeder, rødbedesaft og æblecidereddike sammen i en anden."
    },
    {
      "section": "Rødbedekage",
      "text": "Vend melblandingen og rødbedeblandingen skiftevis ned i smørblandingen med forsigtige bevægelser."
    },
    {
      "section": "Rødbedekage",
      "text": "Kom dejen i formen, og bag kagen på midterste rille i ca. 1 time."
    },
    {
      "section": "Rødbedekage",
      "text": "Stil kagen på en rist, til den er helt kold. Del den derefter forsigtigt på midten i to bunde."
    },
    {
      "section": "Limefrosting",
      "text": "Rør flødeost, flormelis, limeskal og limesaft glat med et piskeris."
    },
    {
      "section": "Limefrosting",
      "text": "Pisk fløden stiv, og vend den forsigtigt i flødeostcremen."
    },
    {
      "section": "Limefrosting",
      "text": "Anret den ene bund på et fad, og smør en tredjedel af frostingen ud over den. Læg den anden bund ovenpå."
    },
    {
      "section": "Limefrosting",
      "text": "Smør resten af frostingen over toppen og siderne, til kagen er dækket jævnt. Det går lettere, hvis du varmer paletkniven i varmt vand og tørrer den af undervejs."
    },
    {
      "section": "Limefrosting",
      "text": "Klip et stort og et lille hjerte ud af to stykker papir, så der er hjerteformede huller i papiret."
    },
    {
      "section": "Limefrosting",
      "text": "Læg papirskabelonerne på kagen, og sigt blåbærstøv over hullerne. Løft skabelonerne forsigtigt af."
    }
  ],
  "changes": []
}
