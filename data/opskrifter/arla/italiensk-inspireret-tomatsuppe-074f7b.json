  "steps": [
    {
      "section": null,
      "text": "Kog pastaen, som der står på pakken, og hæld vandet fra."
    },
    {
      "section": null,
      "text": "Smelt smørret i en tykbundet gryde, og lad det få en gylden farve."
    },
    {
      "section": null,
      "text": "Rør gulerødder, selleri, rødløg og hvidløg i gryden, og svits dem ved høj varme i ca. 2 minutter."
    },
    {
      "section": null,
      "text": "Kom salt og tomatsuppe i, og rør, mens suppen kommer i kog."
    },
    {
      "section": null,
      "text": "Øs suppen op i fire dybe tallerkener. Læg pasta, parmesan, pinjekerner og basilikum ovenpå."
    },
    {
      "section": null,
      "text": "Krydr med peber og server straks."
    }
