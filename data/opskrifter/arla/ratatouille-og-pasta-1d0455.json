  "steps": [
    {
      "section": "Ratatouille",
      "text": "Varm olien op i en stor, tykbundet gryde."
    },
    {
      "section": "Ratatouille",
      "text": "Svits løg, hvidløg, aubergine og squash i cirka 2 minutter."
    },
    {
      "section": "Ratatouille",
      "text": "Hæld hakkede tomater og tomatterninger i gryden, og krydr med salt og peber. Lad saucen komme i kog, læg låg på, og lad den simre ved svag varme i cirka 7 minutter. Rør i den en gang imellem."
    },
    {
      "section": "Ratatouille",
      "text": "Rør oregano i, og smag til med salt og peber."
    },
    {
      "section": "Pasta",
      "text": "Kog pastaen efter anvisningen på pakken, mens saucen simrer, og si den fra."
    },
    {
      "section": "Pasta",
      "text": "Anret pastaen med ratatouillen ved siden af, og strø oliven over."
    }
  ],
