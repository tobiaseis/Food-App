  "steps": [
    {
      "section": "Perlespeltsalat",
      "text": "Skyl perlespelten grundigt i en sigte."
    },
    {
      "section": "Perlespeltsalat",
      "text": "Kom speltkernerne i en gryde med vand og salt, og bring det i kog. Læg låg på, skru ned på lav varme, og lad dem simre i ca. 16 minutter. Lad dem derefter køle en smule af."
    },
    {
      "section": "Perlespeltsalat",
      "text": "Bring vand og salt til grøntsagerne i kog i en ny gryde. Kog blomkålen under låg i ca. 2 minutter."
    },
    {
      "section": "Perlespeltsalat",
      "text": "Fjern låget, læg asparges og edamamebønner i, og kog videre i ca. 1 minut. Si grøntsagerne fra, og skyl dem med koldt vand."
    },
    {
      "section": "Perlespeltsalat",
      "text": "Bland de lunkne speltkerner med grøntsagerne, persillen og halvdelen af hytteosten."
    },
    {
      "section": "Hvidløgsbrød",
      "text": "Rist eller grill brødskiverne på begge sider, til de er gyldne."
    },
    {
      "section": "Hvidløgsbrød",
      "text": "Gnid skiverne med det halverede hvidløg, og pensl dem med olivenolie."
    },
    {
      "section": "Hvidløgsbrød",
      "text": "Anret salaten med det varme brød og den resterende hytteost ved siden af. Drys evt. med citronskal og peber."
    }
  ],
  "changes": []
