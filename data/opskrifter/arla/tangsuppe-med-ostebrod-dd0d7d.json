  "steps": [
    {
      "section": "Tangsuppe",
      "text": "Lad tangen trække i det kolde vand i cirka 10 minutter. Pres vandet ud af den, og snit den i stykker, der er nemme at spise."
    },
    {
      "section": "Tangsuppe",
      "text": "Varm fiskefond, chili og ingefær op i en gryde, til det koger."
    },
    {
      "section": "Tangsuppe",
      "text": "Kom rejerne i, og lad suppen komme i kog igen."
    },
    {
      "section": "Tangsuppe",
      "text": "Rør tang, forårsløg, salt og peber i. Lad suppen simre uden låg ved middel varme i cirka 1 minut, og smag den til."
    },
    {
      "section": "Ostebrød",
      "text": "Varm ovnen op til 225 °C. Læg flutescivene på en bageplade, og fordel pastaosten ovenpå."
    },
    {
      "section": "Ostebrød",
      "text": "Bag ostebrødene midt i ovnen i cirka 6 minutter, til osten er gylden. Server dem til suppen."
    }
  ],
