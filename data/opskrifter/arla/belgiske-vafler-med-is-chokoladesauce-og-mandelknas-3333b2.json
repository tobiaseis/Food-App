  "steps": [
    {
      "section": null,
      "text": "Tag isen ud af fryseren, og lad den stå i køleskabet i cirka en halv time, så den bliver blød."
    },
    {
      "section": "Chokoladesauce",
      "text": "Varm fløde og sukker op i en lille gryde, til det koger. Rør undervejs."
    },
    {
      "section": "Chokoladesauce",
      "text": "Hak chokoladen groft, og rør den ned i den varme fløde. Lad saucen trække på svag varme, og rør, til chokoladen er helt smeltet."
    },
    {
      "section": "Mandelknas",
      "text": "Rist mandlerne på en tør pande ved middelvarme i cirka 5 minutter, til de får en let gylden farve."
    },
    {
      "section": "Mandelknas",
      "text": "Lad mandlerne køle af, og vend dem med saltet."
    },
    {
      "section": "Til servering",
      "text": "Varm vaflerne efter vejledningen på pakken."
    },
    {
      "section": "Til servering",
      "text": "Pisk den bløde is, til den ligner softice. Du kan fylde den i en sprøjtepose med stjernetylle."
    },
    {
      "section": "Til servering",
      "text": "Læg de lune vafler på tallerkener, og top med softice, varm chokoladesauce og mandelknas."
    }
