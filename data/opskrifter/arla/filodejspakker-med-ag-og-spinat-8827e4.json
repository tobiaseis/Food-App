  "steps": [
    {
      "section": "Filodejspakker",
      "text": "Tænd ovnen på 225 °C (almindelig ovn) og beklæd en bageplade med bagepapir."
    },
    {
      "section": "Filodejspakker",
      "text": "Varm en smule af smørret i en pande, og vend spinaten ved høj varme i 1-2 minutter, til den falder sammen. Krydr med salt og peber."
    },
    {
      "section": "Filodejspakker",
      "text": "Bred hver filodejsplade ud én ad gangen, og pensl den med smør. Stak pladerne, og gem lidt smør til kanterne."
    },
    {
      "section": "Filodejspakker",
      "text": "Skær stakken i 6 ens firkanter, og læg dem på bagepladen."
    },
    {
      "section": "Filodejspakker",
      "text": "Anret spinat og ost i midten af firkanterne. Fold dejens kanter ind mod midten, så der opstår en kant, som holder ægget."
    },
    {
      "section": "Filodejspakker",
      "text": "Knæk et æg ud i hver pakke, og drys med salt og peber."
    },
    {
      "section": "Filodejspakker",
      "text": "Pensl kanterne med det resterende smør. Bag pakkerne midt i ovnen i 12-15 minutter."
    }
  ],
  "changes": [
    "Flagesalt er erstattet af almindeligt salt."
  ]
