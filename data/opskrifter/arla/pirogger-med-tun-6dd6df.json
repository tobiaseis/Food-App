  "steps": [
    {
      "section": "Dej",
      "text": "Opløs gæren i det lune vand. Rør ægget, saltet, purløg, persille, olien og speltmelet i."
    },
    {
      "section": "Dej",
      "text": "Rør hvedemelet i en smule ad gangen, og arbejd dejen godt igennem."
    },
    {
      "section": "Dej",
      "text": "Vend dejen ud på et bord og ælt den til en samlet klump. Dæk den til og lad den hæve i ca. 1 time."
    },
    {
      "section": "Fyld",
      "text": "Skyl spinaten og kog den ca. 2 minutter i letsaltet vand. Si vandet fra, og lad spinaten dryppe godt af."
    },
    {
      "section": "Fyld",
      "text": "Lad tunen løbe af i en sigte, til den er helt tør."
    },
    {
      "section": "Fyld",
      "text": "Pisk ægget i en skål, og kom en lille del i et andet kar til pensling. Rør denne del op med lidt vand."
    },
    {
      "section": "Fyld",
      "text": "Bland det resterende æg med mozzarella, purløg, salt og peber."
    },
    {
      "section": "Samling",
      "text": "Slå luften ud af dejen og del den i 8 stykker (eller 4 større)."
    },
    {
      "section": "Samling",
      "text": "Rul hver klump ud til en tynd rund plade på ca. 20 cm."
    },
    {
      "section": "Samling",
      "text": "Læg spinat, tun og osteblanding på pladerne. Pensl dejkanten med æg."
    },
    {
      "section": "Samling",
      "text": "Fold dejen over fyldet og luk den tæt. Pynt eventuelt kanten ved at klemme små folder med fingrene, så den bølger."
    },
    {
      "section": "Bagning",
      "text": "Lad pirogerne hæve igen i ca. 15 minutter."
    },
    {
      "section": "Bagning",
      "text": "Pensl dem med æggeblandingen og bag dem midt i ovnen i ca. 20 minutter ved 200 °C (almindelig ovn)."
    },
    {
      "section": "Bagning",
      "text": "Servér pirogerne med peberfrugt, gulerødder og salat."
    }
  ],
