  "steps": [
    {
      "section": "Ærtesuppe",
      "text": "Varm smørret op i en stor gryde, til det får en gylden farve."
    },
    {
      "section": "Ærtesuppe",
      "text": "Svits løgene i cirka 1 minut."
    },
    {
      "section": "Ærtesuppe",
      "text": "Kom bouillon, ærter, salt og peber i gryden. Bring det i kog uden låg, og lad suppen simre ved svag varme, stadig uden låg, i cirka 5 minutter."
    },
    {
      "section": "Ærtesuppe",
      "text": "Blend avocadoen med en tredjedel af suppen på højeste hastighed i cirka 40 sekunder."
    },
    {
      "section": "Ærtesuppe",
      "text": "Blend den resterende suppe, og bland det hele i en skål. Lad suppen køle af i køleskabet i mindst 4 timer."
    },
    {
      "section": "Hvidløgscreme",
      "text": "Rør creme fraiche med hvidløg, salt og peber."
    },
    {
      "section": "Hvidløgscreme",
      "text": "Dæk cremen til, og stil den på køl i mindst 15 minutter. Smag den til."
    },
    {
      "section": "Ved serveringen",
      "text": "Vend den mousserende vin forsigtigt i den kolde suppe."
    },
    {
      "section": "Ved serveringen",
      "text": "Anret suppen i kolde glas eller tallerkner med rejer og hvidløgscreme. Pynt med ærter, og server med brødet."
    }
  ],
