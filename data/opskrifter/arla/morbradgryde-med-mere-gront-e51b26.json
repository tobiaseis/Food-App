  "steps": [
    {
      "section": null,
      "text": "Lad smørret smelte i en bred gryde, og brun mørbradstykkerne sammen med baconen ved høj varme i ca. 2 minutter."
    },
    {
      "section": null,
      "text": "Kom champignon og rødløg i gryden. Sænk til middel varme, og steg i ca. 3 minutter."
    },
    {
      "section": null,
      "text": "Rør tomatpuréen ind, og steg i ca. 2 minutter."
    },
    {
      "section": null,
      "text": "Hæld de flåede tomater i, og krydr med salt og røget paprika."
    },
    {
      "section": null,
      "text": "Læg låg på, og lad gryden simre ved svag varme i ca. 10 minutter."
    },
    {
      "section": null,
      "text": "Rør fløde og spinat ned i gryden, og varm igennem, til spinaten har samlet sig. Smag til."
    },
    {
      "section": null,
      "text": "Vend persille i de kogte ris, og server dem ved siden af gryden."
    }
