  "steps": [
    {
      "section": "Kage",
      "text": "Kør havregrynene i en foodprocessor, til de er blevet til fint mel."
    },
    {
      "section": "Kage",
      "text": "Lad bønnerne dryppe af i en sigte. Kom dem i foodprocessoren med sukker, smør, æg, kakaopulver, vaniljesukker, bagepulver og salt."
    },
    {
      "section": "Kage",
      "text": "Blend i ca. 3 minutter, til dejen er tyk og helt glat."
    },
    {
      "section": "Kage",
      "text": "Vend den hakkede chokolade i dejen."
    },
    {
      "section": "Kage",
      "text": "Klem et stykke bagepapir fast mellem bund og ring på en springform på ca. 18 cm i diameter."
    },
    {
      "section": "Kage",
      "text": "Hæld dejen i formen og glat overfladen. Bag kagen midt i ovnen ved 175 °C i ca. 25 minutter (almindelig ovn)."
    },
    {
      "section": "Kage",
      "text": "Lad kagen køle helt af. Løsn den fra formen og vend den, så bunden vender opad, på et fad."
    },
    {
      "section": "Pynt",
      "text": "Smør skyren ovenpå kagen, læg bær eller frugt på, og drys med hakkede pistacienødder."
    }
  ],
  "changes": [
    "Rørsukker er erstattet med almindeligt sukker."
  ]
}
