  "steps": [
    {
      "section": "Chia-hindbærkompot",
      "text": "Læg hindbærrene i en gryde, og varm dem op, til de koger."
    },
    {
      "section": "Chia-hindbærkompot",
      "text": "Lad dem simre uden låg på svag varme i ca. 2 minutter."
    },
    {
      "section": "Chia-hindbærkompot",
      "text": "Træk gryden væk fra blusset, og rør honning og chiafrø ned i bærrene."
    },
    {
      "section": "Chia-hindbærkompot",
      "text": "Hæld kompotten i en skål, og lad den hvile i ca. 10 minutter, så den tykner."
    },
    {
      "section": null,
      "text": "Rist brødet i en brødrister, og fordel flødeosten ovenpå."
    },
    {
      "section": null,
      "text": "Læg kompotten oven på toasten. Den kan serveres både lun og kold."
