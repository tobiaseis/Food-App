  "steps": [
    {
      "section": "Wasabiflødeskum",
      "text": "Bland fløde, limesaft, wasabi og salt. Dæk til og lad blandingen stå køligt i mindst 15 minutter."
    },
    {
      "section": "Wasabiflødeskum",
      "text": "Smag til, og pisk fløden til et meget løst flødeskum."
    },
    {
      "section": "Salat",
      "text": "Fordel salatblade, mango og koriander på 6 tallerkener. Dryp med limesaft, og stru chili og salt over."
    },
    {
      "section": "Hummer",
      "text": "Skær hver hummer over på langs gennem ryg og hale. Tag mave, hjerne og tarm ud."
    },
    {
      "section": "Hummer",
      "text": "Bank let på kløerne, så skallerne revner. Lad skallerne blive på, så gæsterne selv kan trække dem af ved bordet."
    },
    {
      "section": "Hummer",
      "text": "Læg de 6 halve hummere på en bageplade med alufolie. Varm ovnen op til 250 °C."
    },
    {
      "section": "Hummer",
      "text": "Hak brødet fint, f.eks. i en food processor. Bland det med ost, hvidløg og salt."
    },
    {
      "section": "Hummer",
      "text": "Fordel blandingen over hummerne. Gratinér øverst i ovnen i ca. 5 minutter lige før servering."
    },
    {
      "section": "Servering",
      "text": "Pisk wasabiflødeskummet forsigtigt op igen, og kom det i en sprøjtepose. Sprøjt små toppe over salaten."
    },
    {
      "section": "Servering",
      "text": "Anret hummerhalvdelene og limebådene på tallerkenerne, og server med det samme."
    }
  ],
  "changes": [
    "Pastaost er erstattet med ost.",
    "Hurtighakker er erstattet med food processor."
  ]
