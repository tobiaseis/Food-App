  "steps": [
    {
      "section": null,
      "text": "Kog kartoflerne møre i letsaltet vand, mens resten laves."
    },
    {
      "section": "Bøffer",
      "text": "Del mørbraden i 4 lige store stykker, og tryk dem flade med håndfladen eller en kødhammer, til de er ca. 2½ cm tykke."
    },
    {
      "section": "Bøffer",
      "text": "Varm smørret op på en pande, til det får en gylden farve. Brun bøfferne ca. 1 minut på hver side."
    },
    {
      "section": "Bøffer",
      "text": "Skru ned til middel varme, og steg bøfferne i ca. 10 minutter. Vend dem én gang, og brun kanterne de sidste par minutter. Krydr med salt og peber, og hold dem varme."
    },
    {
      "section": "Salattopping",
      "text": "Rør æbletern og citronsaft sammen, så æblerne ikke misfarves. Sigt saften fra lige før servering."
    },
    {
      "section": "Salattopping",
      "text": "Lad fetaternene dryppe af i en sigte. Vend dem med æblerne og de øvrige ingredienser til toppingen, og smag til med peber."
    },
    {
      "section": null,
      "text": "Anret de varme bøffer på et fad, og kom lidt topping oven på hver. Server resten af toppingen i en skål ved siden af, sammen med de nykogte kartofler."
    }
