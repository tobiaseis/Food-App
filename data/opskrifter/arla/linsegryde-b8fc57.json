  "steps": [
    {
      "section": "Dhal",
      "text": "Varm en gryde op ved kraftig varme, og lad smørret smelte uden at brune."
    },
    {
      "section": "Dhal",
      "text": "Skru ned for varmen. Svits løg, hvidløg, ingefær og chili i cirka 4 minutter."
    },
    {
      "section": "Dhal",
      "text": "Rør karry, spidskommen og koriander i, og svits i cirka 1 minut."
    },
    {
      "section": "Dhal",
      "text": "Kom gulerødder, linser, fond, hakkede tomater, cherrytomater, æble og salt i gryden. Læg låg på, og lad det simre ved svag varme i cirka 45 minutter, til konsistensen passer dig. Rør indimellem, og smag til til sidst."
    },
    {
      "section": "Mynte-raita",
      "text": "Rør yoghurt, agurk, mynte og salt sammen, og smag til."
    },
    {
      "section": "Til servering",
      "text": "Anret den varme dhal med raita og naanbrød. Drys med friske blade af koriander og mynte."
    }
  ],
