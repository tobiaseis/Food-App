  "steps": [
    {
      "section": "Spareribs",
      "text": "Læg spareribs og vand i en gryde, og bring det i kog. Fjern skummet fra overfladen."
    },
    {
      "section": "Spareribs",
      "text": "Tilføj laurbærblade, peberkorn og salt. Lad ribsene simre under låg ved svag varme i ca. ½ time, og løft dem derefter op af bouillonen."
    },
    {
      "section": "Marinade til pensling",
      "text": "Blend tomater, løg, chilisauce og salt, til massen er helt glat. Hæld 3 spsk fra til dressingen."
    },
    {
      "section": "Marinade til pensling",
      "text": "Vend de kogte spareribs i den resterende marinade."
    },
    {
      "section": "Dressing",
      "text": "Rør creme fraiche sammen med de 3 spsk marinade, og smag til. Sæt skålen i køleskabet med låg eller film, til maden skal serveres."
    },
    {
      "section": "Kartoffelsalat",
      "text": "Bring vand og salt i kog i en gryde, og læg majskolberne i. Kog dem under låg ved middel varme i ca. 7 min."
    },
    {
      "section": "Kartoffelsalat",
      "text": "Lad kolberne køle lidt af. Skær derefter kernerne af, helst så de sidder sammen i flager."
    },
    {
      "section": "Kartoffelsalat",
      "text": "Bland majs, kartofler, cherrytomater, peberfrugt, olie, salt og peber. Lad salaten stå og trække i mindst 15 min., og smag til."
    },
    {
      "section": "Kartoffelsalat",
      "text": "Pluk salatbladene i mindre stykker, og læg dem i lag sammen med kartoffelsalaten."
    },
    {
      "section": null,
      "text": "Varm grillen godt op. Grill ribsene i 6-8 min., og vend dem undervejs. Pensl med resten af marinaden, mens de griller."
    },
    {
      "section": null,
      "text": "Server spareribs med kartoffel-majssalaten og dressingen."
    }
  ],
