  "steps": [
    {
      "section": null,
      "text": "Smelt den mørke og den hvide chokolade i hver sin skål over vandbad eller i mikroovn."
    },
    {
      "section": null,
      "text": "Læg et ark bagepapir frem, og fordel den mørke chokolade til en firkant på cirka 20 x 20 cm."
    },
    {
      "section": null,
      "text": "Hæld den hvide chokolade i striber over den mørke. Træk evt. en gaffel igennem for at lave et marmoreret mønster."
    },
    {
      "section": null,
      "text": "Strø nødder, græskarkerner, hampefrø og tranebær over, mens chokoladen stadig er flydende."
    },
    {
      "section": null,
      "text": "Lad pladen stå og størkne ved stuetemperatur, og bryd den derefter i stykker."
    }
