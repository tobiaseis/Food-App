  "steps": [
    {
      "section": "Pasta og grøntsagsfløde",
      "text": "Bring vandet i kog med saltet i en stor, tykbundet gryde."
    },
    {
      "section": "Pasta og grøntsagsfløde",
      "text": "Kog pastaen i cirka 7 minutter. Læg broccoli og blomkål i gryden, og kog videre i cirka 4 minutter, til pastaen er mør, men ikke blød."
    },
    {
      "section": "Pasta og grøntsagsfløde",
      "text": "Hæld det hele i et dørslag, og lad det dryppe godt af."
    },
    {
      "section": "Pasta og grøntsagsfløde",
      "text": "Kog fløde og hvidløg op i den tomme gryde. Vend pasta, grøntsager, citronskal og basilikum i fløden."
    },
    {
      "section": "Citronkylling",
      "text": "Varm en pande op, og lad smørret tage en gylden farve, mens pastaen koger."
    },
    {
      "section": "Citronkylling",
      "text": "Steg kyllingen ved kraftig varme i cirka 1 minut på hver side, så den får farve."
    },
    {
      "section": "Citronkylling",
      "text": "Sænk til jævn varme, og steg kødet i cirka 2 minutter. Vend det én gang undervejs."
    },
    {
      "section": "Citronkylling",
      "text": "Skru op til kraftig varme igen. Hæld citronsaft og hvidløg på panden, krydr med salt og peber, og steg i cirka 2 minutter mere."
    },
    {
      "section": "Citronkylling",
      "text": "Vend kyllingen i basilikum lige før servering."
    },
    {
      "section": "Til servering",
      "text": "Anret pastaen på 4 varme, dybe tallerkener, og læg kyllingen ovenpå. Pynt med peber og friske basilikumblade."
    }
  ],
