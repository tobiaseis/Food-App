  "steps": [
    {
      "section": "Æble-sellerisalat",
      "text": "Rør dressingen sammen af creme fraiche, ravigottesauce, hakkede persillestilke, karry og salt. Smag til."
    },
    {
      "section": "Æble-sellerisalat",
      "text": "Bland selleri, æble, rødløg og syltede agurker med dressingen, og læg salaten på et fad."
    },
    {
      "section": "Æble-sellerisalat",
      "text": "Top med persilleblade."
    },
    {
      "section": "Stegt sandart",
      "text": "Smelt smørret på en pande, og lad det få en gylden farve."
    },
    {
      "section": "Stegt sandart",
      "text": "Dup fisken tør, og skær den i 8 ens stykker."
    },
    {
      "section": "Stegt sandart",
      "text": "Steg først stykkerne 2-3 minutter på kødsiden og bagefter 2-3 minutter på skindsiden. Tiden afhænger af, hvor tykke fileterne er."
    },
    {
      "section": "Stegt sandart",
      "text": "Strø salt og hakket persille over fisken, og server med det samme. Tag salaten og de nykogte kartofler med til."
    }
  ],
