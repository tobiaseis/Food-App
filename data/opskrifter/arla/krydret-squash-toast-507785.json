  "steps": [
    {
      "section": null,
      "text": "Vend squash med olie, citronsaft, chili, persille, dild, salt og peber i en skål. Lad det stå og trække i ca. 10 minutter."
    },
    {
      "section": null,
      "text": "Hæld squashblandingen i en si, så væden løber fra."
    },
    {
      "section": null,
      "text": "Smør den ene side af begge brødskiver tyndt med smør."
    },
    {
      "section": null,
      "text": "Læg ost og squashblanding mellem skiverne, så den smørede side vender udad."
    },
    {
      "section": null,
      "text": "Varm toastmaskinen godt op, og riste toasten i ca. 5 minutter, til den er gylden, og osten er smeltet. Server den varm."
    }
  ],
