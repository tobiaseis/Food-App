  "steps": [
    {
      "section": "Carpaccio",
      "text": "Bed slagteren skære fileten i skiver, eller skær den selv så tyndt som muligt. Det er nemmest med et lidt større stykke."
    },
    {
      "section": "Carpaccio",
      "text": "Læg et par skiver ad gangen i en frysepose, og tryk dem ud med håndroden eller med den flade side af en bred kniv, til de er helt tynde."
    },
    {
      "section": "Carpaccio",
      "text": "Fordel kødet på et fad. Dryp med olie og citronsaft, og strø ostens flager ovenpå."
    },
    {
      "section": "Carpaccio",
      "text": "Kværn peber over, og læg salat, brøndkarse og/eller skovsyre ved siden af. Server med det ristede brød."
    }
  ],
