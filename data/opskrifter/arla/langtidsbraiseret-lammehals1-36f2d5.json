  "steps": [
    {
      "section": "Langtidsbraiseret lammehals",
      "text": "Læg lammehalsen på et skærebræt og fold den ud. Skær om nødvendigt nogle længdesnit, så kødet ligger jævnt. Du kan dele den i to mindre stykker."
    },
    {
      "section": "Langtidsbraiseret lammehals",
      "text": "Krydr indersiden med timian, citronskal, salt og peber. Rul kødet sammen, bind det med kødsnor og krydr yderligere med salt og peber udenpå."
    },
    {
      "section": "Langtidsbraiseret lammehals",
      "text": "Varm en pande op og brun smørret let gyldent. Brun lammehalsen på alle sider i alt ca. 3 minutter."
    },
    {
      "section": "Langtidsbraiseret lammehals",
      "text": "Flyt kødet til en lille bradepande og hæld hvidvinen over. Sæt et helt tæt låg på. Braisér midt i ovnen ved 100 °C i ca. 4 timer og 30 minutter."
    },
    {
      "section": "Langtidsbraiseret lammehals",
      "text": "Fjern låget og hæv temperaturen til 160 °C. Steg kødet, til stegetermometeret viser ca. 70 °C i midten."
    },
    {
      "section": "Langtidsbraiseret lammehals",
      "text": "Si væden fra bradepanden over i en gryde og bring den i kog. Fjern skummet, og lad saucen koge kraftigt ind til ca. ½ dl. Smag til."
    },
    {
      "section": "Rabarberkompot",
      "text": "Varm olien op i en gryde. Svits løgene ved middel varme, til de er bløde uden at få farve."
    },
    {
      "section": "Rabarberkompot",
      "text": "Skær rabarberne i stykker på 2-3 cm, og kom dem i gryden sammen med sukkeret. Bring det langsomt i kog ved svag varme, og lad kompotten simre i ca. 3 minutter."
    },
    {
      "section": "Rabarberkompot",
      "text": "Træk gryden af varmen, og lad kompotten køle lidt. Rør timian, salt og peber i, og smag til."
    },
    {
      "section": "Gremolata",
      "text": "Bland persille, hvidløg, citronskal og mandler."
    },
    {
      "section": "Stegt blomkål",
      "text": "Brun smørret gyldent i en pande. Steg blomkål og mandler ved kraftig varme i ca. 4 minutter, mens du rører rundt."
    },
    {
      "section": "Stegt blomkål",
      "text": "Vend fetaen forsigtigt i til sidst."
    },
    {
      "section": "Servering",
      "text": "Fjern kødsnoren og skær lammehalsen i tykke skiver. Vend skiverne i den indkogte sauce."
    },
    {
      "section": "Servering",
      "text": "Anret kødet på tallerkener med rabarberkompot, blomkål og gremolata. Server de kogte kartofler ved siden af."
    }
  ],
