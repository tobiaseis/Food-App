  "steps": [
    {
      "section": null,
      "text": "Gør svampene rene, og pak dem tæt i ét stort sylteglas eller flere små sammen med dild og chili."
    },
    {
      "section": null,
      "text": "Bring eddike, vand, sukker, salt, peberkorn og laurbærblade i kog i en gryde."
    },
    {
      "section": null,
      "text": "Hæld den varme lage over svampene i glassene, så de er dækket."
    },
    {
      "section": null,
      "text": "Sæt glassene et køligt sted hen. Svampene kan holde sig et par måneder."
    }
