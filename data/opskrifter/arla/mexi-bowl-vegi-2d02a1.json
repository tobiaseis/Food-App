  "steps": [
    {
      "section": "Spidskålssalat",
      "text": "Bland agurk og groft salt i en skål. Dæk skålen til og lad agurken trække i køleskabet i ca. 15 min."
    },
    {
      "section": "Spidskålssalat",
      "text": "Rør derefter spidskål og sorte bønner i agurkeblandingen."
    },
    {
      "section": "Tomatsalsa",
      "text": "Varm eddike og honning op i en lille gryde, til det bobler."
    },
    {
      "section": "Tomatsalsa",
      "text": "Kom rødløgene i gryden og lad dem simre ved middel varme i ca. 5 min. Lad blandingen køle af."
    },
    {
      "section": "Tomatsalsa",
      "text": "Vend tomater og mynte i den afkølede løgblanding."
    },
    {
      "section": "Guacamole",
      "text": "Skær avocadoerne over på langs og tag stenene ud. Øs frugtkødet ud med en ske og mas det i en skål."
    },
    {
      "section": "Guacamole",
      "text": "Rør creme fraiche, hvidløg og salt i. Smag guacamolen til."
    },
    {
      "section": null,
      "text": "Bland de kogte ris med peberfrugten og fordel dem i 4 skåle."
    },
    {
      "section": null,
      "text": "Læg spidskålssalat, tomatsalsa og guacamole ved siden af risene, og tilføj tortillachips, majs, koriander og chili. Server med en klat creme fraiche."
    }
  ],
