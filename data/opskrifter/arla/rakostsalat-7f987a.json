  "steps": [
    {
      "section": "Råkostsalat",
      "text": "Rør olie, eddike og peber sammen til en dressing i en stor skål."
    },
    {
      "section": "Råkostsalat",
      "text": "Skær æblerne i tern, og vend dem rundt i dressingen."
    },
    {
      "section": "Råkostsalat",
      "text": "Bland de revne gulerødder og den snittede spidskål i en anden skål."
    },
    {
      "section": "Råkostsalat",
      "text": "Hæld æblerne med dressing ud over gulerødderne og spidskålen. Strø persille over."
    },
    {
      "section": "Sojaristede solsikkekerner",
      "text": "Læg solsikkekernerne på en tør pande, og sæt varmen helt op."
    },
    {
      "section": "Sojaristede solsikkekerner",
      "text": "Rør rundt, mens kernerne rister i ca. 2 minutter."
    },
    {
      "section": "Sojaristede solsikkekerner",
      "text": "Træk panden væk fra varmen, og hæld sojasaucen over med det samme. Rør, til væsken er fordampet."
    },
    {
      "section": "Ved serveringen",
      "text": "Strø en del af de ristede kerner over salaten, og vend den rundt – gerne ved bordet."
    },
    {
      "section": "Ved serveringen",
      "text": "Sæt de resterende kerner frem i en lille skål."
    }
  ],
