  "steps": [
    {
      "section": "Tærtebund",
      "text": "Bland hvedemel, mandelmel, sukker og salt i en skål."
    },
    {
      "section": "Tærtebund",
      "text": "Smuldr det smør, du har skåret i stykker, ned i melblandingen. Ælt hurtigt dejen sammen med ægget. Tilsæt lidt vand, hvis den er for tør."
    },
    {
      "section": "Tærtebund",
      "text": "Del dejen i to: ca. to tredjedele og en tredjedel. Rul den største del ud mellem to stykker bagepapir, så den bliver 2-3 cm bredere end tærteformen (ca. 22 cm i diameter)."
    },
    {
      "section": "Tærtebund",
      "text": "Løft dejen over i formen, og tryk den ind i bunden og helt op ad kanten."
    },
    {
      "section": "Tærtebund",
      "text": "Rul resten af dejen ud i samme tykkelse, og skær den i strimler til gitteret. Lad strimlerne ligge på bagepapiret. Sæt dem og tærtebunden på køl i ca. 30 min."
    },
    {
      "section": "Tærtebund",
      "text": "Stik huller i bunden og kanten med en gaffel. Forbag bunden i ca. 10 min. ved 175 °C i almindelig ovn."
    },
    {
      "section": "Fyld",
      "text": "Pisk smør og sukker luftigt. Tilsæt æggene ét ad gangen, og pisk godt mellem hvert. Vend mandelmel og citronskal i."
    },
    {
      "section": "Fyld",
      "text": "Fordel fyldet i den forbagte bund, og læg rabarbertern ovenpå."
    },
    {
      "section": "Fyld",
      "text": "Læg dejstrimlerne i et gitter over rabarberne, og klip overskydende dej af."
    },
    {
      "section": "Fyld",
      "text": "Bag tærten i ca. 30 min. ved 175 °C i almindelig ovn."
    },
    {
      "section": "Fyld",
      "text": "Lad tærten køle af. Server den lun eller kold med creme fraiche eller fløde."
    }
  ],
  "changes": [
    "Flødeskum er ændret til letpisket fløde."
