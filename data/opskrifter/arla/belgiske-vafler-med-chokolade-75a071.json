  "steps": [
    {
      "section": "Bærflødeskum",
      "text": "Put bær og sukker i en tykbundet gryde, og lad det koge under omrøring i cirka 3 minutter, til sukkeret er smeltet, og massen minder om marmelade."
    },
    {
      "section": "Bærflødeskum",
      "text": "Hæld bærmassen ud på en flad tallerken, og stil den i køleskabet, til den er helt kold."
    },
    {
      "section": "Chokoladevafler",
      "text": "Pisk æg og sukker, til blandingen er lys og luftig."
    },
    {
      "section": "Chokoladevafler",
      "text": "Bland mel, kakao, bagepulver, salt og hakket chokolade i en anden skål."
    },
    {
      "section": "Chokoladevafler",
      "text": "Vend de tørre ingredienser i æggemassen i omgange, og skift med kakaomælken. Rør til sidst det smeltede smør i, til dejen er jævn."
    },
    {
      "section": "Chokoladevafler",
      "text": "Lad vaffeljernet blive rigtig varmt. Hæld en passende portion dej i jernet (cirka ¾ dl), og bag vaflen i 4-5 minutter. Gentag, til dejen er brugt."
    },
    {
      "section": "Bærflødeskum",
      "text": "Pisk fløden til et let skum, og vend den kolde bærmarmelade i."
    },
    {
      "section": "Til servering",
      "text": "Anret de varme vafler med bærflødeskummet og chokoladesauce, og drys med mynteblade."
    }
  ],
  "changes": [
    "Citronmelisseblade er skiftet til mynte."
  ]
