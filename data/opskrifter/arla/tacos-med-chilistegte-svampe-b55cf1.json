  "steps": [
    {
      "section": "Syltede rødløg",
      "text": "Læg rødløgsringene i en skål eller et glas, der kan lukkes tæt."
    },
    {
      "section": "Syltede rødløg",
      "text": "Kog sukker, eddike og vand op i en gryde, og hæld den varme lage straks over løgene."
    },
    {
      "section": "Syltede rødløg",
      "text": "Sæt låg på, og lad løgene stå på køl, indtil de skal bruges."
    },
    {
      "section": "Avocadocreme",
      "text": "Mos avocadoerne groft med en gaffel i en skål."
    },
    {
      "section": "Avocadocreme",
      "text": "Rør creme fraiche, hvidløg, limesaft og salt i, og smag til."
    },
    {
      "section": "Avocadocreme",
      "text": "Dæk cremen til, og stil den i køleskabet, til den skal serveres."
    },
    {
      "section": "Stegte svampe",
      "text": "Del smørret og svampene i fire lige store dele. Smelt en fjerdedel smør på en stor pande ved kraftig varme."
    },
    {
      "section": "Stegte svampe",
      "text": "Steg en fjerdedel af svampene i 3-4 minutter, og vend dem undervejs. Læg dem til side, og steg resten på samme måde i omgange."
    },
    {
      "section": "Stegte svampe",
      "text": "Kom alle svampene tilbage på panden, og vend dem rundt med sambal oelek og salt."
    },
    {
      "section": "Til servering",
      "text": "Varm tortillaerne, og sæt dem på bordet sammen med avocadocreme, svampe, syltede rødløg, grønkål, creme fraiche og korianderblade, så alle kan fylde deres egne."
    }
  ],
  "changes": [
    "Portobello er erstattet af champignon.",
