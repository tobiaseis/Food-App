  "steps": [
    {
      "section": null,
      "text": "Pil de yderste blade af spidskålet, og skyl det. Del det i 4-6 både efter størrelsen."
    },
    {
      "section": null,
      "text": "Skær den tykkeste del af stokken væk på hver båd, men lad bådene hænge sammen."
    },
    {
      "section": null,
      "text": "Grill bådene på middelvarm grill med snitfladen nedad, til de er møre. Hold øje med dem, og vend dem et par gange."
    },
    {
      "section": "Ristede kikærter",
      "text": "Varm olien på en pande, og steg de drænede kikærter ved høj varme, til de er gyldne."
    },
    {
      "section": "Ristede kikærter",
      "text": "Tag kikærterne op på køkkenrulle, og lad dem køle. Drys dem med flagesalt."
    },
    {
      "section": "Yoghurtdressing",
      "text": "Rør yoghurten sammen med sambal oelek og citronsaften. Krydr med groft salt og peber."
    },
    {
      "section": null,
      "text": "Server spidskålen med dressingen og de ristede kikærter."
    }
  ],
