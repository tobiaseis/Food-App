  "steps": [
    {
      "section": null,
      "text": "Bland hvedemel, sukker og vaniljesukker i en skål."
    },
    {
      "section": null,
      "text": "Smuldr smørstykkerne ud i melblandingen med fingrene."
    },
    {
      "section": null,
      "text": "Tilsæt æggeblommen og sirup, og samle det hele til en dej. Ælt den godt."
    },
    {
      "section": null,
      "text": "Stil dejen i køleskabet i cirka en halv time."
    },
    {
      "section": null,
      "text": "Tænd ovnen på 200 °C (almindelig ovn)."
    },
    {
      "section": null,
      "text": "Halvér dejen, og rul hver halvdel til en lang stang. Skær hver stang i 5 ens stykker, så du får 10 i alt."
    },
    {
      "section": null,
      "text": "Rul stykkerne til aflange pølser, der er en anelse tykkere end en finger."
    },
    {
      "section": null,
      "text": "Klem let på begge sider af hver pølse med to fingre, så der dannes en knoglekno."
    },
    {
      "section": null,
      "text": "Tryk dejen flad i den ene ende med spidsen af en teske. Her skal neglen sidde."
    },
    {
      "section": null,
      "text": "Læg lidt syltetøj på det flade stykke, og pres en halv mandel ned i det."
    },
    {
      "section": null,
      "text": "Skær små furer i knoen og lige under neglen med en lille, skarp kniv."
    },
    {
      "section": null,
      "text": "Børst fingrene med lidt kakaopulver, så de ser beskidte ud."
    },
    {
      "section": null,
      "text": "Læg fingrene på en bageplade, og bag dem midt i ovnen i cirka 10 minutter."
    },
    {
      "section": null,
      "text": "Lad dem køle af på en bagerist."
    }
  ],
  "changes": []
}
