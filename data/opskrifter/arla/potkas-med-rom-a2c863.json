  "steps": [
    {
      "section": null,
      "text": "Bland den revne ost med fløde, rom og sukker, til det danner en ensartet masse."
    },
    {
      "section": null,
      "text": "Fyld massen i en skål eller et rent glas, f.eks. et patentglas, og pres den godt ned, så der ikke er luftlommer."
    },
    {
      "section": null,
      "text": "Dæk til og lad osten modne i køleskabet i cirka 5 døgn."
    },
    {
      "section": null,
      "text": "Smag til undervejs et par gange, og rør lidt mere rom i, hvis osten mangler smag."
    },
    {
      "section": null,
      "text": "Server med ristet rugbrød."
    }
