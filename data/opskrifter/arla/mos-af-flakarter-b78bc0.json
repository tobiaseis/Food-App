  "steps": [
    {
      "section": null,
      "text": "Skyl ærterne i en sigte under koldt vand, og læg dem i en gryde med vandet. Bring det i kog."
    },
    {
      "section": null,
      "text": "Læg persillestilke, laurbærblade og peberkorn i et tefilter, og læg det ned i gryden."
    },
    {
      "section": null,
      "text": "Lad ærterne simre ved svag varme i ca. 45 minutter, til de er helt møre."
    },
    {
      "section": null,
      "text": "Tag tefiltret op, og hæld eventuelt overskydende kogevand fra."
    },
    {
      "section": null,
      "text": "Blend de varme ærter groft. Rør yoghurt og salt i, og vend den hakkede persille ned i moset. Smag til."
    }
  ],
