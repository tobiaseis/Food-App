  "steps": [
    {
      "section": null,
      "text": "Kom sukker og eddike i en stor gryde, og lad det koge op."
    },
    {
      "section": null,
      "text": "Put løgene i gryden, og lad dem simre i 2-3 minutter."
    },
    {
      "section": null,
      "text": "Løft løgene op af gryden med en hulske, og læg dem i et rent glas."
    },
    {
      "section": null,
      "text": "Lad væsken koge kraftigt uden låg i ca. 5 minutter, til der er ca. 1 dl tilbage."
    },
    {
      "section": null,
      "text": "Hæld den indkogte væske over løgene, og rør tranebærrene ned i glasset."
    },
    {
      "section": null,
      "text": "Server med skæreost, ristet rugbrød og rosmarinkviste. Kompotten holder sig tildækket i køleskabet i ca. 2 uger."
    },
    {
      "section": null,
      "text": "Til en julet version kan du koge hel allehånde, nelliker, kardemommekapsler og stjerneanis med i væsken."
    }
  ],
