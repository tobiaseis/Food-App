  "steps": [
    {
      "section": "Fyld",
      "text": "Varm olien op på en pande, og steg sødkartoflerne ved kraftig varme i ca. 3 minutter. Rør i dem en gang imellem."
    },
    {
      "section": "Fyld",
      "text": "Kom rødkål, hvidløg, salt og peber på panden. Steg videre ved middelvarme under omrøring i ca. 3 minutter, til kålen er mør."
    },
    {
      "section": "Fyld",
      "text": "Hæld blandingen i en skål, og vend persille og soltørrede tomater i."
    },
    {
      "section": "Dej",
      "text": "Blend rødbeder, smør, vand, æg, salt og 175 g af melet i en foodprocessor på højeste hastighed i ca. 2 minutter, til massen er jævn."
    },
    {
      "section": "Dej",
      "text": "Vend dejen ud på et meldrysset bord, og ælt resten af melet (50 g) grundigt ind i den. Rul den tyndt ud."
    },
    {
      "section": "Dej",
      "text": "Udstik 16 cirkler på ca. 10 cm med et udstikkerglas eller en form. Læg 1 spsk fyld midt på hver cirkel."
    },
    {
      "section": "Dej",
      "text": "Pensl den ene halvdel af hver cirkel med lidt vand, og fold dejen sammen til en halvmåne. Tryk kanten tæt med fingrene."
    },
    {
      "section": "Dej",
      "text": "Bring vand og salt i kog i en stor gryde. Kog dumplings i tre omgange i ca. 2 minutter hver, og rør forsigtigt undervejs. Løft dem op, og hold dem varme i et fad."
    },
    {
      "section": "Gremolata",
      "text": "Mas fetaen med en gaffel, og rør persille og citronskal i. Dæk til, og stil den på køl, til dumplings skal serveres."
    },
    {
      "section": "Gremolata",
      "text": "Anret dumplings, og top dem med gremolata. Dryp med olivenolie, og strø valnødder og persille over."
    }
  ],
  "changes": [
    "Salatost er erstattet med feta.",
    "Søde kartofler er skrevet som sødkartoffel."
  ]
