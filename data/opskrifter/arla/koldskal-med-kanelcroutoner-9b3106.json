  "steps": [
    {
      "section": "Kanelcroutoner",
      "text": "Del rugbrødet i små tern, og læg dem på en tør pande. Rist dem under omrøring i cirka 10 minutter."
    },
    {
      "section": "Kanelcroutoner",
      "text": "Bland kanel, farin og salt i en skål, og strø blandingen over det ristede brød."
    },
    {
      "section": "Kanelcroutoner",
      "text": "Kom smørret på panden, og steg videre i cirka 2 minutter, til croutonerne er gyldne."
    },
    {
      "section": "Servering",
      "text": "Hæld den iskolde koldskål i skåle, og fordel croutonerne ovenpå. Pynt med spiselige blomster."
    }
