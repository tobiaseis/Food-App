  "steps": [
    {
      "section": "Linser og bulgur",
      "text": "Bring vandet i kog med salt, og kom linserne i. Lad dem simre under låg i ca. 4 min."
    },
    {
      "section": "Linser og bulgur",
      "text": "Tilsæt bulgur, kardemomme og stjerneanis, og lad det simre videre i ca. 10 min."
    },
    {
      "section": "Linser og bulgur",
      "text": "Si vandet fra, og lad blandingen køle af. Fisk kardemomme og stjerneanis op."
    },
    {
      "section": "Ingefærdressing",
      "text": "Rør creme fraiche sammen med appelsinjuice, ingefær og salt. Dæk til, og lad dressingen trække i køleskabet i mindst 15 min. Smag til."
    },
    {
      "section": "Rødbeder og samling",
      "text": "Smelt smørret i en pande over kraftig varme, så det ikke tager farve."
    },
    {
      "section": "Rødbeder og samling",
      "text": "Steg rødbederne i ca. 3 min., og drys dem med salt."
    },
    {
      "section": "Rødbeder og samling",
      "text": "Vend rødbeder, appelsinfileter, purløg og peber i bulgur og linser. Pynt med lidt ekstra purløg."
    },
    {
      "section": "Rødbeder og samling",
      "text": "Anret salaten med ristet brød ved siden af og dressingen til."
    },
    {
      "section": "Rødbeder og samling",
      "text": "Tip: Elsker du kardemomme, kan du pille frøene ud af de kogte kapsler og vende dem i salaten for et lille knas."
    }
  ],
