  "steps": [
    {
      "section": "Bagt græskar",
      "text": "Varm ovnen op til 225 °C (almindelig ovn)."
    },
    {
      "section": "Bagt græskar",
      "text": "Skær græskaret over, og skrab kernehuset ud med en ske. Skrællen skal blive på. Skær resten i store stykker."
    },
    {
      "section": "Bagt græskar",
      "text": "Læg stykkerne i et ovnfast fad. Fordel smørternene og græskarkernerne ovenpå, og drys med groft salt."
    },
    {
      "section": "Bagt græskar",
      "text": "Bag på midterste rille i 25-30 minutter."
    },
    {
      "section": "Krondyrmørbrad",
      "text": "Smelt smørret i en sauterpande på høj varme. Det må ikke blive brunt."
    },
    {
      "section": "Krondyrmørbrad",
      "text": "Brun mørbradene rundt om i ca. 2 minutter. Løft dem op på en tallerken, og peber dem."
    },
    {
      "section": "Krondyrmørbrad",
      "text": "Pak hver mørbrad ind i ca. 3 skiver parmaskinke."
    },
    {
      "section": "Krondyrmørbrad",
      "text": "Læg dem tilbage i panden, og steg på middel varme i 4-5 minutter på hver side."
    },
    {
      "section": "Krondyrmørbrad",
      "text": "Tag kødet op, og læg låg eller folie over. Lad det hvile i 10-15 minutter. Lad fedtet blive i panden til saucen."
    },
    {
      "section": "Salat med lune brombær",
      "text": "Bring brombær, sukker og eddike i kog i en gryde under omrøring. Læg låg på, og lad det simre på lav varme i ca. 5 minutter."
    },
    {
      "section": "Salat med lune brombær",
      "text": "Fisk bærrene op med en hulske. Kog væsken ind på høj varme, til den er sirupsagtig."
    },
    {
      "section": "Salat med lune brombær",
      "text": "Tag gryden af varmen, og kom bærrene tilbage i væsken."
    },
    {
      "section": "Salat med lune brombær",
      "text": "Læg salatbladene på et fad. Top med pære, rødløg og de lune brombær."
    },
    {
      "section": "Champignonsauce",
      "text": "Varm fedtet i stegepanden godt op, og svits champignonerne på middel varme i ca. 5 minutter."
    },
    {
      "section": "Champignonsauce",
      "text": "Rør hytteosten i, og lad det svitse med i ca. 2 minutter. Smag til."
    },
    {
      "section": "Servering",
      "text": "Skær mørbradene i skiver på ca. 2 cm. Server med det bagte græskar, champignonsaucen og salaten."
    }
  ],
