  "steps": [
    {
      "section": "Andebryst",
      "text": "Skær skindet på andebrystet i et ternmønster, og krydr med groft salt og peber."
    },
    {
      "section": "Andebryst",
      "text": "Læg andebrystet med skindsiden nedad på en kold pande, og steg det ved jævn varme i ca. 12 min."
    },
    {
      "section": "Andebryst",
      "text": "Vend brystet, og steg det på kødsiden i ca. 15 min., til det er gennemstegt."
    },
    {
      "section": "Andebryst",
      "text": "Løft andebrystet op på et fad, og lad det hvile i ca. 10 min."
    },
    {
      "section": "Aioli",
      "text": "Rør æggeblommen sammen med hvidløg, salt, peber, halvdelen af citronsaften og 1 spsk af rapsolien."
    },
    {
      "section": "Aioli",
      "text": "Hæld resten af olien i en tynd stråle, mens du pisker kraftigt."
    },
    {
      "section": "Aioli",
      "text": "Smag til med resten af citronsaften, salt og peber. Stil aiolien tildækket på køl, til den skal bruges."
    },
    {
      "section": "Aioli",
      "text": "Tip: Æggeblomme, olie og skål skal have samme temperatur, så aioliens emulsion holder. Lad dem stå på køkkenbordet i mindst ½ time før brug."
    },
    {
      "section": "Brød",
      "text": "Varm olien i en pande, og rist fluteskiverne ca. 1 min. på hver side."
    },
    {
      "section": "Brød",
      "text": "Læg brødet over på køkkenrulle, så overskydende olie trækkes af."
    },
    {
      "section": "Karamelliserede forårsløg",
      "text": "Tilsæt olie og sukker til panden, og lad sukkeret smelte ved jævn varme."
    },
    {
      "section": "Karamelliserede forårsløg",
      "text": "Kom forårsløgene i, og steg dem ca. 2 min., til de har fået karamelfarve. Smag til med salt."
    },
    {
      "section": "Anretning",
      "text": "Bred lidt aioli på hver brødskive. Skær andebrystet i tynde skiver, og læg dem på brødet med forårsløgene ovenpå. Server med det samme."
    },
    {
      "section": "Anretning",
      "text": "Overskydende aioli opbevares tildækket i køleskabet."
    }
  ],
