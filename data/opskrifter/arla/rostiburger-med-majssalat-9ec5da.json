  "steps": [
    {
      "section": "Røsti",
      "text": "Lad 2 bageplader varme op i ovnen, mens du laver røstidejen."
    },
    {
      "section": "Røsti",
      "text": "Bland kartofler og squash, og vrid dem et par gange i et rent viskestykke, så de bliver godt tørre."
    },
    {
      "section": "Røsti",
      "text": "Rør ost, æg og salt grundigt ind i grøntsagerne."
    },
    {
      "section": "Røsti",
      "text": "Form dejen til 12 flade runde bunker på ca. 12 cm på 2 stykker bagepapir. Løft papiret med bunkerne over på de varme plader."
    },
    {
      "section": "Røsti",
      "text": "Bag røstierne ved 200 °C varmluft i ca. 25 minutter, til de er gyldne og sprøde."
    },
    {
      "section": "Majssalat",
      "text": "Rør majs, forårsløg, koriander, limesaft og salt sammen, og smag salaten til."
    },
    {
      "section": "Til servering",
      "text": "Byg 4 burgere med 3 lune røstier i hver. Læg salatblade og avocado i det nederste lag og tomater og mandler i det øverste."
    },
    {
      "section": "Til servering",
      "text": "Server med det samme med majssalaten ved siden af."
    }
  ],
