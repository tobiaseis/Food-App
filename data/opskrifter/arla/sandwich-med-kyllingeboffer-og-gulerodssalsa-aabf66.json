  "steps": [
    {
      "section": "Gulerodssalsa",
      "text": "Rør tomatsalsaen sammen med gulerødder, æbler, hakkede syltede agurker og kapers."
    },
    {
      "section": "Gulerodssalsa",
      "text": "Dæk skålen og sæt den på køl i mindst 15 minutter. Smag til med salt og peber, hvis det trænger."
    },
    {
      "section": "Kyllingebøffer",
      "text": "Ælt hakket kylling, hvidløgssmør og salt grundigt sammen."
    },
    {
      "section": "Kyllingebøffer",
      "text": "Del farsen i 4 lige store portioner, og tryk dem til flade bøffer på cirka 10 cm på tværs."
    },
    {
      "section": "Kyllingebøffer",
      "text": "Varm grillpanden op ved kraftig varme i cirka 4 minutter."
    },
    {
      "section": "Kyllingebøffer",
      "text": "Steg bøfferne i cirka 10 minutter, og vend dem undervejs, indtil de er gennemstegte."
    },
    {
      "section": "Til servering",
      "text": "Rist bollerne let, skær dem igennem, og smør snitfladerne med hvidløgssmør."
    },
    {
      "section": "Til servering",
      "text": "Byg burgerne med salatblade, halvdelen af salsaen, en kyllingebøf og skiver af syltede agurker."
    },
    {
      "section": "Til servering",
      "text": "Hæld resten af salsaen i fire små skåle, og sæt en ved hver tallerken, så alle kan tage mere undervejs."
    }
  ],
