  "steps": [
    {
      "section": null,
      "text": "Bring vandet i kog i en stor gryde, og tilsæt det groftkornede salt."
    },
    {
      "section": null,
      "text": "Kog pastaen uden låg i ca. 2 minutter, til den er mør, men ikke blød."
    },
    {
      "section": null,
      "text": "Put selleri, rødløg og ærter i gryden og lad det hele koge med de sidste øjeblikke. Hæld derefter pasta og grøntsager i et dørslag, og lad det dryppe godt af."
    },
    {
      "section": null,
      "text": "Kom det afdryppede tilbage i gryden. Rør fløde, pesto, citronskal, salt og peber i, og vend det grundigt."
    },
    {
      "section": null,
      "text": "Vend tunen forsigtigt i, og smag retten til."
    },
    {
      "section": null,
      "text": "Server straks i en skål, pyntet med sellerblade."
    }
