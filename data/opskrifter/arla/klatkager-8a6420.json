  "steps": [
    {
      "section": null,
      "text": "Slå æggene ud i en skål, og pisk dem med sukker og hvedemel."
    },
    {
      "section": null,
      "text": "Vend grøden i æggeblandingen sammen med vaniljesukker og citronskal."
    },
    {
      "section": null,
      "text": "Dæk skålen til, og lad dejen hvile i ca. 15 minutter. Så er den lettere at stege."
    },
    {
      "section": null,
      "text": "Smelt smørret på en pande ved jævn varme. Kom dejen på panden i 12 små klatter."
    },
    {
      "section": null,
      "text": "Brun klatkagerne i ca. 1½ minut på hver side, til de er gyldne."
    },
    {
      "section": null,
      "text": "Servér dem lune med frisk frugt, syltetøj eller creme fraiche."
    }
  ],
  "changes": [
