  "steps": [
    {
      "section": "Mojitosuppe",
      "text": "Kog vand og sukker op i en gryde over høj varme, og lad det koge ca. 1 minut."
    },
    {
      "section": "Mojitosuppe",
      "text": "Tag gryden af varmen, og lad sukkerlagen køle en smule af. Kom limefileterne og limebådene i."
    },
    {
      "section": "Mojitosuppe",
      "text": "Læg låg på, og stil suppen på køl i mindst 4 timer. Alternativt kan den stå i fryseren i ca. 1 time."
    },
    {
      "section": "Mynteflødeskum",
      "text": "Pisk fløden med den hakkede mynte, til den er let og luftig. Smag den til."
    },
    {
      "section": "Mojitosuppe",
      "text": "Rør rommen i den afkølede suppe."
    },
    {
      "section": "Mojitosuppe",
      "text": "Læg jordbærskiverne i kolde, dybe tallerkener, og øs suppen over. Top med mynteflødeskummet og friske mynteblade."
    }
  ],
