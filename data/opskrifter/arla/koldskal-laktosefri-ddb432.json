  "steps": [
    {
      "section": "Koldskål",
      "text": "Pisk æggeblommerne med sukker og vaniljesukker, til blandingen er lys og luftig."
    },
    {
      "section": "Koldskål",
      "text": "Rør citronskal, citronsaft og kefir ned i æggemassen. Smag til."
    },
    {
      "section": "Koldskål",
      "text": "Dæk koldskålen til og sæt den i køleskabet, til den skal serveres."
    },
    {
      "section": "Topping",
      "text": "Læg nogle få hindbær til side som pynt. Mos resten med en gaffel."
    },
    {
      "section": "Topping",
      "text": "Fordel de moste hindbær i fire store glas, og hæld koldskålen ovenpå."
    },
    {
      "section": "Topping",
      "text": "Drys med ristet boghvede, og pynt med de hele hindbær og eventuelt blomster."
    }
