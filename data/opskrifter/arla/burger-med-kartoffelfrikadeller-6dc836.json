  "steps": [
    {
      "section": "Kartoffelfrikadeller",
      "text": "Læg de soltørrede tomater i en skål, og overhæld dem med det kogende vand. Lad dem trække i ca. 2 minutter."
    },
    {
      "section": "Kartoffelfrikadeller",
      "text": "Mos kartoflerne, og rør dem sammen med tomaterne og vandet fra skålen."
    },
    {
      "section": "Kartoffelfrikadeller",
      "text": "Tilsæt creme fraiche, æg, hvidløg, rasp, salt og peber. Rør farsen godt sammen."
    },
    {
      "section": "Kartoffelfrikadeller",
      "text": "Form farsen til 9 flade frikadeller af halvdelen af farsen. Brun halvdelen af smørret på en pande, og steg frikadellerne ved middel varme i ca. 5 minutter på hver side."
    },
    {
      "section": "Kartoffelfrikadeller",
      "text": "Hold de færdige frikadeller varme. Steg resten af farsen på samme måde med det resterende smør."
    },
    {
      "section": "Ketchupdressing",
      "text": "Rør ketchup og creme fraiche sammen."
    },
    {
      "section": "Til burgerne",
      "text": "Del bollerne på midten, og rist dem på begge sider. Smør dem med ketchupdressingen."
    },
    {
      "section": "Til burgerne",
      "text": "Anret kartoffelfrikadeller, agurk, tomat, rødløg, salat og cornichoner i bollerne, og læg dem sammen."
    }
  ],
