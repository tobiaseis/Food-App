  "steps": [
    {
      "section": null,
      "text": "Gør kyllingen klar ved at rense den og dutte den tør med køkkenrulle."
    },
    {
      "section": null,
      "text": "Smør kyllingen ind i det smeltede smør med en kødpensel, og krydr den med salt og peber."
    },
    {
      "section": null,
      "text": "Sæt kyllingen i airfryeren med brystet nedad. Tilbered den ved 180° i 25 minutter."
    },
    {
      "section": null,
      "text": "Drej kyllingen om, så brystet vender opad, og tilbered den 25 minutter mere."
    },
    {
      "section": null,
      "text": "Løft kyllingen op, og lad den hvile i cirka 10 minutter, hvis du har tid. Skær den i 6-8 stykker, før den kommer på bordet."
    }
