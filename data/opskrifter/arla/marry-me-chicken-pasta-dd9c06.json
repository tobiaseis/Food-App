  "steps": [
    {
      "section": null,
      "text": "Drys kyllingestykkerne med salt og peber, og rul dem i melet."
    },
    {
      "section": null,
      "text": "Varm olien op i en sauterpande ved høj varme. Brun kyllingen, og læg den over på en tallerken."
    },
    {
      "section": null,
      "text": "Steg auberginen på samme pande ved høj varme i ca. 5 min., til den er gyldne."
    },
    {
      "section": null,
      "text": "Kom løg, hvidløg, soltørrede tomater, tomatpuré, timian, chiliflager og cherrytomater på panden. Steg videre ved høj varme i ca. 5 min., og rør jævnligt."
    },
    {
      "section": null,
      "text": "Kom peberfrugt, bouillon, fløde og kyllingen tilbage i panden, og smag til med salt og peber. Lad det simre ved lav varme i ca. 10 min."
    },
    {
      "section": null,
      "text": "Kog pastaen, mens saucen simrer, som det står på pakken, og si vandet fra."
    },
    {
      "section": null,
      "text": "Vend pastaen i saucen sammen med salatbladene, til bladene er faldet sammen. Server straks."
    }
  ],
