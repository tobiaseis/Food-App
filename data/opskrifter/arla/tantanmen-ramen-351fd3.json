  "steps": [
    {
      "section": "Ramen-pasta",
      "text": "Rør sojasauce, peanutbutter, sambal oelek, riseddike og honning sammen til en glat pasta. Del den ligeligt mellem 4 dybe skåle."
    },
    {
      "section": "Stegt kød",
      "text": "Smelt smørret på en pande, og brun svinekødet ved høj varme i 3-5 minutter, til det har fået god farve."
    },
    {
      "section": "Stegt kød",
      "text": "Kom hvidløg og ingefær på panden, og steg i cirka 2 minutter mere. Rør sambal oelek, honning og salt i, og tag panden af varmen."
    },
    {
      "section": "Suppe",
      "text": "Bring bouillon og mælk i kog i en stor gryde. Lad det småkoge, til det skal serveres. Suppen skal være meget varm i skålene."
    },
    {
      "section": "Topping og anretning",
      "text": "Kog æggene i cirka 7 minutter, så blommen er blød. Pil dem, og skær dem over på midten."
    },
    {
      "section": "Topping og anretning",
      "text": "Kog nudlerne efter anvisningen på pakken, og lad dem løbe af i en sigte."
    },
    {
      "section": "Topping og anretning",
      "text": "Læg pak choi i en skål, og overhæld med kogende vand. Lad den stå i 1-2 minutter, og si vandet fra."
    },
    {
      "section": "Topping og anretning",
      "text": "Øs den varme suppe i skålene, og rør rundt, til pastaen er opløst. Læg nudler i suppen."
    },
    {
      "section": "Topping og anretning",
      "text": "Top med svinekød, æg, bønnespirer, pak choi og forårsløg. Dryp eventuelt med chiliolie, og server med det samme."
    }
  ],
