  "steps": [
    {
      "section": "Bønner",
      "text": "Dagen før: Læg bønnerne i en skål med det kolde udblødningsvand og lad dem stå i køleskabet natten over."
    },
    {
      "section": "Bønner",
      "text": "Si bønnerne fra og skyl dem godt under koldt vand."
    },
    {
      "section": "Bønner",
      "text": "Kom dem i en gryde med det nye vand og saltet, og bring det i kog med låg på."
    },
    {
      "section": "Bønner",
      "text": "Sænk varmen og lad bønnerne simre under låg i ca. 50 min. Hæld vandet fra."
    },
    {
      "section": "Tomatsauce",
      "text": "Brun baconternene i en bred gryde: først ca. 6 min. på høj varme, derefter ca. 5 min. på middel varme, til de er gyldne."
    },
    {
      "section": "Tomatsauce",
      "text": "Rør skalotteløg og hvidløg i og steg dem ca. 1 min."
    },
    {
      "section": "Tomatsauce",
      "text": "Hæld rødvinen i og lad den koge ind uden låg på middel varme i ca. 10 min., til den er halveret."
    },
    {
      "section": "Tomatsauce",
      "text": "Rør tomater, bouillonpulver, worcestershiresauce, tomatpuré og vand i."
    },
    {
      "section": "Tomatsauce",
      "text": "Bind rosmarin og timian sammen med snoren og læg bundtet i gryden."
    },
    {
      "section": "Tomatsauce",
      "text": "Lad saucen simre uden låg på lav varme i ca. 10 min. Rør i den ind imellem."
    },
    {
      "section": "Medisterpølse",
      "text": "Bring vandet i kog i en gryde og lad medisteren simre på lav varme i ca. 5 min."
    },
    {
      "section": "Medisterpølse",
      "text": "Løft medisteren op og lad den køle af i ca. 5 min. Del den i stykker på ca. 3 cm."
    },
    {
      "section": "Medisterpølse",
      "text": "Varm olien på en pande og brun medisterstykkerne på høj varme i ca. 6 min. Vend dem engang imellem."
    },
    {
      "section": "Medisterpølse",
      "text": "Kom bønner, tomatsauce og medisterstykker i et ovnfast fad på ca. 4 x 24 x 28 cm og bland det let."
    },
    {
      "section": "Gratineringsrasp",
      "text": "Kør persille og rasp i en blender i ca. 20 sek. og rør osten i."
    },
    {
      "section": "Gratineringsrasp",
      "text": "Fordel raspblandingen over retten og gratiner den midt i ovnen ved 200 °C i ca. 10 min., til toppen er gylden."
    }
  ],
