node_modules/
intercepted_data/*.json
intercepted_data/*
!intercepted_data/*.json

.agents
.claude
# Database (genskabes med: npm run ingest && npm run recipes)
data.db
data.db-wal
data.db-shm
# Rollback-kopier (data.db.pre-items, .pre-amounts, osv.) - samme grund som
# data.db selv, plus at de kan blive store nok til at sprænge et "git add -A".
data.db.*

# Dedikeret testdatabase (genskabes af scripts/seed-test-db.js, kørt som
# pretest) - npm test maa aldrig aabne data.db, se test/helpers/set-test-db.js
test.db
test.db-wal
test.db-shm

# Genereres ved deploy af scripts/build-web.js.
# config.js SKAL med i git med tomme værdier: uden den fejler /config.js med
# 404 ved en frisk klon. Vercel overskriver den i sit eget checkout, så
# nøglerne havner aldrig i repoet.
logs/

# Agent-skills installeret lokalt (.agents ignoreres allerede)
skills-lock.json

# Supabase-nøgler til Android-buildet. Læses af scripts/build-web.js.
.env

# Firebase-tjenestekonto til push (src/push/send.js). Denne ER en hemmelighed.
fcm-service-account.json

# Materiale til Play Console (genskabes med: npm run store)
store/
